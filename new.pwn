CMD:buytoys(playerid, params[])
{
    new stringq[128];
    if(!IsPlayerInRangeOfPoint(playerid, 2, 456.494598,-1809.588378,5.687819343)) return SendClientMessage(playerid, -1, "Anda tidak berada di tempat pembelian aksesoris");
    if(PlayerInfo[playerid][pCash] < harga_toys) return SendClientMessage(playerid, -1, "Uang anda tidak cukup");

    for(new i; i < 10; i++) TextDrawShowForPlayer(playerid, ToysTDBuy[i]);
    TextDrawShowForPlayer(playerid, bt_buy);
    TextDrawShowForPlayer(playerid, bt_next);
    TextDrawShowForPlayer(playerid, bt_back);
    TextDrawShowForPlayer(playerid, bt_exit);
    TextDrawShowForPlayer(playerid, bt_rxp);
    TextDrawShowForPlayer(playerid, bt_rxm);
    TextDrawShowForPlayer(playerid, bt_ryp);
    TextDrawShowForPlayer(playerid, bt_rym);
    PlayerTextDrawSetPreviewModel(playerid, preview_toys[playerid], ItemsToys[0][0]);
    format(stringq, sizeof(stringq), "ID:_%d", ItemsToys[0][0]);
    PlayerTextDrawSetString(playerid, id_toys[playerid], stringq);
    PlayerTextDrawShow(playerid, preview_toys[playerid]);
    PlayerTextDrawShow(playerid, id_toys[playerid]);

    SelectTextDraw(playerid, COLOR_ORANGE);

    player_choose_items_toys[playerid] = 0;
    player_toys_rotx[playerid] = -59.000000;
    player_toys_roty[playerid] = -102.000000;
    return 1;
}

