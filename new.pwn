{
    if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
    if(pData[playerid][pProgress] == 1) return Error(playerid, "Anda masih memiliki activity progress!");
	for(new i = 0; i < 68; i++)
	{
		PlayerTextDrawShow(playerid, PHONEXERP[playerid][i]);
	}
/*    for(new i = 0; i < 21; i++)
    {
        TextDrawShowForPlayer(playerid, PhoneTD[i]);
    }
    TextDrawShowForPlayer(playerid, FINGERPRINT);
    TextDrawShowForPlayer(playerid, TANGGAL);
    TextDrawShowForPlayer(playerid, JAMLOCKSCREEN);
    new dayc, monthc, yearc;
    getdate(yearc,monthc,dayc);
    new string[256];
    format(string, sizeof string, "%02d %s %02d", dayc, GetMonthName(monthc), yearc);
    TextDrawSetString(TANGGAL, string);*/
    SelectTextDraw(playerid, COLOR_BLUE);
    PlayerPlaySound(playerid, 3600, 0,0,0);
    ApplyAnimation(playerid, "PED", "Jetpack_Idle", 4.1, 0, 1, 1, 1, 0, 1);
    SetPlayerAttachedObject(playerid, 1, 18866, 5, 0.074999, 0.010998, -0.026000, -125.400001, -49.700000, -38.500000, 1.299999, 1.200000, 1.000000);
    return 1;
}
CMD:phone(playerid, params[])
{
	if(PlayerInfo[playerid][pInjured] == 1) return ShowError(playerid, "Anda sedang pingsan!!");
	if(PlayerInfo[playerid][pPrison] != 0) return ShowError(playerid, "Tidak digunakan dipenjara");

    // Dialog Utama - Mobile Banking telah dihapus
    ShowPlayerDialog(playerid, 979, DIALOG_STYLE_LIST, "Phone Menu", "{ffffff}- Twitter\n- Bank Transfer\n- Contacts List\n- Call Someone\n- Send SMS\n- GPS Map\n- Settings", "Select", "Close");

    return 1;
}
CMD:fixme(playerid, params[])
{
    // PENGECUALIAN PIN: fixme dilarang selama keypad PIN terbuka
    if (pinIsOpen[playerid])
        return ShowPanjulNotif(playerid, "Fitur fixme tidak tersedia selama verifikasi PIN berlangsung.");

    if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "Turun dari kendaraan terlebih dahulu");
    new str[1024];
    format(str, sizeof(str), "Keluhan\tKeterangan\n"WHITE_E"Bug Visual\t"WHITE_E"Apabila anda tidak dapat melihat object/player apapun (berada di alam baka)\n{8b8989}Karakter Stuck\t"WHITE_E"{8b8989}Apabila anda stuck karena tertimpa object/kendaraan sehingga tidak dapat bergerak\nKarakter Freezing\t"WHITE_E"Apabila karakter anda benar benar tidak dapat bergerak atau berjalan sama sekali");
    ShowPlayerDialog(playerid, DIALOG_FIXME, DIALOG_STYLE_TABLIST_HEADERS, "{ffff00}ReeLife {ffffff}- Fix Me", str, "Pilih", "Tutup");
    return 1;
}
CMD:config(playerid, params[])
{
    ShowPlayerDialog(playerid, DIALOG_STREAMER_CONFIG, DIALOG_STYLE_LIST, "Maximum object Configuration", "High level Configuration\nMedium level Configuration\nLow level Configuration\nPotato level Configuration", "Set", "Close");
    return 1;
}
CMD:togtw(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	new string[128], newTwStatus[128];
	if(!twStatus) {
		newTwStatus = "dibuka";
		twStatus = true;
	}
	else {
		newTwStatus = "ditutup";
		twStatus = false;
	}
	format(string, sizeof string, "[Twitter]: Twitter telah %s!", newTwStatus);
	SendClientMessageToAll(0x00C2ECFF, string);
	return 1;
}

ferchartd(playerid) {
	TextDrawHideForPlayer(playerid, CrateTD[0]);
	TextDrawHideForPlayer(playerid, CrateTD[1]);
	TextDrawHideForPlayer(playerid, CrateTD[2]);
	TextDrawHideForPlayer(playerid, CrateTD[3]);
	TextDrawHideForPlayer(playerid, CrateTD[4]);
	TextDrawHideForPlayer(playerid, CrateTD[5]);
	PlayerTextDrawDestroy(playerid, CratePTD[0]);
	PlayerTextDrawDestroy(playerid, CratePTD[1]);
	IsCrates[playerid] = 0;
    CancelSelectTextDraw(playerid);
    return 1;
}

CMD:rtd(playerid)
{
	LoadingPlayerBar[playerid] = 0;
	ferchartd(playerid);
	return 1;
}

stock NP(playerid)
{
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof( name ));
    return name;
}

stock FIXES_valstr(dest[], value, bool:pack = false)
{
    // format can't handle cellmin properly
    static const cellmin_value[] = !"-2147483648";

    if (value == cellmin)
        pack && strpack(dest, cellmin_value, 12) || strunpack(dest, cellmin_value, 12);
    else
        format(dest, 12, "%d", value) && pack && strpack(dest, dest, 12);
}

stock number_format(number)
{
    new i, string[15];
    FIXES_valstr(string, number);
    if(strfind(string, "-") != -1) i = strlen(string) - 4;
    else i = strlen(string) - 3;
    while (i >= 1)
    {
        if(strfind(string, "-") != -1) strins(string, ",", i + 1);
        else strins(string, ",", i);
        i -= 3;
    }
    return string;
}

