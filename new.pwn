		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pComponent] -= amount; OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
		        PlayerInfo[otherid][pComponent] += amount; OnPlayerUpdateAccountsPer(otherid, "pComponent", PlayerInfo[otherid][pComponent]);
		        ShowItemNotification(playerid, false, "Component", amount); ShowItemNotification(otherid, true, "Component", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Component."); ShowPanjulNotif(otherid, "Menerima Component.");
		        Info(playerid, "Anda telah berhasil memberikan Component kepada %s sejumlah %d.", ReturnName(otherid), amount);
		        Info(otherid, "%s telah berhasil memberikan Component kepada anda sejumlah %d.", ReturnName(playerid), amount);
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "metall", true) == 0)
		    {
		        if(amount > PlayerInfo[playerid][pMetall]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup Metall");
		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pMetall] -= amount; OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
		        PlayerInfo[otherid][pMetall] += amount; OnPlayerUpdateAccountsPer(otherid, "pMetall", PlayerInfo[otherid][pMetall]);
		        ShowItemNotification(playerid, false, "Metal", amount); ShowItemNotification(otherid, true, "Metal", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Metal."); ShowPanjulNotif(otherid, "Menerima Metal.");
		        Info(playerid, "Anda telah berhasil memberikan Metall kepada %s sejumlah %d.", ReturnName(otherid), amount);
		        Info(otherid, "%s telah berhasil memberikan Metall kepada anda sejumlah %d.", ReturnName(playerid), amount);
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "medicine", true) == 0)
		    {
