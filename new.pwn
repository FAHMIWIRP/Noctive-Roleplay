CMD:unwarn(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Enter: /unwarn [id pemain]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Player is offline!");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain tidak login!");//+;
	if(PlayerInfo[params[0]][pWarn] == 0) return Send(playerid, COLOR_GREY, "Pemain ini tidak memiliki peringatan!");
    new str[124], dateban[3][6], count = 0;

    String = "Hari dan waktu\t\tSiapa Anda\t\tPenyebab\n";
    for(new i; i < PlayerInfo[params[0]][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[params[0]][i][wWarnDate],dateban[i][0],dateban[i][1],dateban[i][2],dateban[i][3],dateban[i][4],dateban[i][5], 3);

		format(str, 124, "%02d-%02d-%02d %02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], WarnInfo[params[0]][i][wAdminWarn], WarnInfo[params[0]][i][wReasonWarn]);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, WarnInfo[playerid][i][wID]);
 	}
    SPD(playerid, 193, DIALOG_STYLE_LIST, "Informasi Peringatan", String, "Select", "Exit");
	SetPVarInt(playerid, "SavePlayer", params[0]);
    return 1;
}
CMD:warninfo(playerid, params[])
{
	if(!PlayerInfo[playerid][pWarn]) return Send(playerid, COLOR_GREY, "Anda tidak memiliki peringatan yang valid!");

	String = "";
	strcat(String, "{ffff00}Hari dan waktu\t\tSiapa anda\t\tPenyebab\n\n");
	new str[164];

	new dateban[3][6];
    for(new i; i < PlayerInfo[playerid][pWarn]; i++)
	{
 		TimestampToDate(WarnInfo[playerid][i][wWarnDate],dateban[i][0],dateban[i][1],dateban[i][2],dateban[i][3],dateban[i][4],dateban[i][5], 3);

		format(str, 164, ""W"%02d-%02d-%02d %02d:%02d:%02d\t%s\t%s\n", dateban[i][0], dateban[i][1], dateban[i][2], dateban[i][3], dateban[i][4], dateban[i][5], WarnInfo[playerid][i][wAdminWarn], WarnInfo[playerid][i][wReasonWarn]);
		strcat(String, str);
	}
	if(!GetPVarInt(playerid, "Inform")) Send(playerid, 0x98FB98FF, "Peringatan secara otomatis dihapus dalam 7 hari sejak tanggal terjadi nya warn.");
	SetPVarInt(playerid, "Inform", 1);
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Informasi peringatan", String, "Close", "");
	return 1;
}
CMD:book(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][1] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki buku telepon, Anda dapat membelinya di toko 24/7");

    format(MySQLStr, 144, "SELECT `nName`, `nNumber`, `nID`, `plID` FROM `book` WHERE `plID` = %d", PlayerInfo[playerid][pID]);
	mysql_tquery(mMysql, MySQLStr, "LoadMyNumber", "d", playerid);
	return 1;
}
CMD:offleaders(playerid, params[])
{
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

	format(MySQLStr, 144, "SELECT `pID`, `pName`,`pfWarn`, `pLeader` FROM `accounts` WHERE `pLeader` > '0'");
	mysql_tquery(mMysql, MySQLStr, "ShowPlayerOffLeaders","d", playerid);
	return 1;
}

publics: ShowPlayerOffLeaders(playerid)
{
    new rows;
    cache_get_row_count(rows);

    if(!rows) return Send(playerid, COLOR_GREY, "Leaderboard kosong.");

    new str[128], count = 0;
    String = "";

    new names[MAX_PLAYER_NAME], leader, fwarn, sql_id;

    for(new i = 0; i < rows; i++)
    {
        cache_get_value_int(i, "pID", sql_id);
        cache_get_value_name(i, "pName", names, MAX_PLAYER_NAME);
    	cache_get_value_int(i, "pLeader", leader);
    	cache_get_value_int(i, "pfWarn", fwarn);

        format(str, 128, "%s\t\t%s\t%d/3\n", names, FracInfo[leader][fName], fwarn);
		strcat(String, str);

		SetPlayerListitemValue(playerid, count++, sql_id);
	}
	return SPD(playerid, 195, DIALOG_STYLE_TABLIST, "{ffff00}Offline Leaders Control Panel", String, "Select", "Close");
}

CMD:offsupports(playerid)
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;

    new Cache: result = mysql_query(mMysql, "SELECT s.*, a.`pName`, a.`pOnline` FROM `supports` s, `accounts` a WHERE a.`pID` = s.`user_id`");

    new rows = cache_num_rows();

    if(!rows) return SCM(playerid, COLOR_GREY, "Tidak ada dukungan yang ditemukan.");

    new player_name[MAX_PLAYER_NAME], last_date[16], sql_id, reports_today;

    new count = 0;

    String = "";

    new str[48];

    for(new i; i < rows; i++)
    {
        cache_get_value_int(i, "user_id", sql_id);
        cache_get_value_name(i, "pName", player_name, MAX_PLAYER_NAME);
        cache_get_value_name(i, "pOnline", last_date, 16);
        cache_get_value_int(i, "reports_day", reports_today);

        format(str, 48, "%i. %s\t%i\t%s\n", i + 1, player_name, reports_today, last_date);
        strcat(String, str);

        SetPlayerListitemValue(playerid, count++, sql_id);
    }

    cache_delete(result);

    return SPD(playerid, 9137, DIALOG_STYLE_TABLIST, "Daftar Dukungan", String, "Select", "Close");
}

CMD:offadmins(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;

	format(MySQLStr, 144, "SELECT `Name`, `pAdmin`, `pAdminKey`, `pDataNaz` FROM `admin` WHERE `pAdmin` <= '6'");
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","dd", playerid, 18);
	return 1;
}
CMD:take(playerid, params[])
{
	if(!IsACop(playerid)) return 1;

	if(PlayerInfo[playerid][pRank] < 3) return Send(playerid, COLOR_GREY, "Dimungkinkan untuk memilih lisensi/item hanya dari peringkat 3.");
	if(sscanf(params, "u", params[0])) return Send(playerid, -1,"Enter: /take [id pemain]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Player is offline!");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain tidak login!");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Seorang pemain di AFK.");//+
	if(!ProxDetectorS(3.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Pemain harus berada di dekat Anda.");

	SPD(playerid, 185, DIALOG_STYLE_LIST, "Panel", "{ffffff}1. Cabut SIM\n2. Cabut SIM untuk penerbangan\n3. Singkirkan SIM untuk transportasi air\n4. Singkirkan lisensi untuk senjata\n5. Singkirkan Metall dan amunisi\n6. Singkirkan narkoba\n7. Singkirkan senjata", "Accept", "Exit");
	player_take_player[playerid] = params[0];
	return 1;
}
public ProgressTanam(playerid, type)
{
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);
    SedangKerja[playerid] = false; 
    HideBarAfterDone(playerid); // Menghilangkan TextDraw bar secara bersih dari layar
    
    if(IsPlayerNearAnyPlant(playerid, MIN_PLANT_DISTANCE)) 
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Gagal menanam: Ada tanaman lain terlalu dekat!");

    new id = GetFreePlantID();
    if(id != -1)
    {
        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);
        
        ServerPlant[id][splType] = type;
        ServerPlant[id][splX] = x;
        ServerPlant[id][splY] = y;
        ServerPlant[id][splZ] = z;
        
        // Pengecekan Waktu Tumbuh Berdasarkan Tipe Tanaman
        if(type == PLANT_TYPE_PALEM)
        {
            ServerPlant[id][splTimeLeft] = 60 * 60; // 60 Menit (3600 detik) khusus Sawit
        }
        else
        {
            ServerPlant[id][splTimeLeft] = 20 * 60; // 20 Menit (1200 detik) untuk Padi, Kentang, Ganja
        }
        
        ServerPlant[id][splActive] = 1;
        
        new objid = GetPlantObjectID(type);
        ServerPlant[id][splObject] = CreateObject(objid, x, y, z - 1.0, 0.0, 0.0, 0.0);
        
        UpdatePlantText(id);
        SavePlantt(id); 
        
        // Notifikasi pesan yang disesuaikan dengan tipe tanaman
        if(type == PLANT_TYPE_PALEM)
        {
            SendClientMessage(playerid, -1, "{00D9FF}[TANAM]{FFFFFF} Tanaman Sawit berhasil ditanam .");
        }
        else
        {
            SendClientMessage(playerid, -1, "{00D9FF}[TANAM]{FFFFFF} Tanaman berhasil ditanam! Tunggu {FFD700}20 menit{FFFFFF} untuk panen.");
        }
    }
    return 1;
}

public ProgressPanen(playerid, plantid)
{
    TogglePlayerControllable(playerid, true);
    ClearAnimations(playerid);
    SedangKerja[playerid] = false; 
    HideBarAfterDone(playerid); // Menghilangkan TextDraw progress bar secara bersih dari layar

    if(!ServerPlant[plantid][splActive] || !IsPlayerInRangeOfPoint(playerid, 2.0, ServerPlant[plantid][splX], ServerPlant[plantid][splY], ServerPlant[plantid][splZ]))
    {
        return SendClientMessage(playerid, 0xFF0000AA, "Panen dibatalkan karena kamu terlalu jauh!");
    }
    
    // Membuat angka random dari 1 sampai 4
    new jumlah_panen = random(4) + 1;
    new msg[128];
    
    switch(ServerPlant[plantid][splType])
    {
        case PLANT_TYPE_PADI: 
        {
            PlayerInfo[playerid][pPaddi] += jumlah_panen; 
            format(msg, sizeof(msg), "Kamu berhasil memanen %d Padi!", jumlah_panen);
            ShowItemNotification(playerid, true, "Padi", jumlah_panen);
            SendClientMessage(playerid, 0x00FF00AA, msg);
            
            // Menyimpan data Padi ke database/file
            OnPlayerUpdateAccountsPer(playerid, "pPaddi", PlayerInfo[playerid][pPaddi]);
        }
        case PLANT_TYPE_KENTANG: 
        {
            PlayerInfo[playerid][pKentang] += jumlah_panen; 
            format(msg, sizeof(msg), "Kamu berhasil memanen %d Kentang!", jumlah_panen);
            ShowItemNotification(playerid, true, "Kentang", jumlah_panen);
            SendClientMessage(playerid, 0x00FF00AA, msg);
            
            // Menyimpan data Kentang ke database/file
            OnPlayerUpdateAccountsPer(playerid, "pKentang", PlayerInfo[playerid][pKentang]);
        }
        case PLANT_TYPE_PALEM: 
        {
            PlayerInfo[playerid][pSawit] += 1; 
            format(msg, sizeof(msg), "{00D9FF}[SAWIT]{FFFFFF} Kamu berhasil memanen {FFD700}1 Sawit{FFFFFF}!");
            ShowItemNotification(playerid, true, "Sawit", 1);
            SendClientMessage(playerid, 0x00FF00AA, msg);
            
            // Menyimpan data Kentang ke database/file
            OnPlayerUpdateAccountsPer(playerid, "pSawit", PlayerInfo[playerid][pSawit]);
        }
        case PLANT_TYPE_GANJA: 
        {
            PlayerInfo[playerid][pMicin] += jumlah_panen; 
            format(msg, sizeof(msg), "Kamu berhasil memanen %d Marijuana!", jumlah_panen);
            ShowItemNotification(playerid, true, "Marijuana", jumlah_panen);
            SendClientMessage(playerid, 0x00FF00AA, msg);
            
            // Menyimpan data Marijuana (pMicin) ke database/file
            OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
        }
    }
    
    DestroyObject(ServerPlant[plantid][splObject]);
    
    // Perbaikan fungsi hapus text untuk Streamer
    if(ServerPlant[plantid][splText] != Text3D:INVALID_3DTEXT_ID) 
        DestroyDynamic3DTextLabel(ServerPlant[plantid][splText]);
    
    new filename[64];
    format(filename, sizeof(filename), "plant/%d.ini", plantid);
    if(fexist(filename)) fremove(filename); 
    
    ServerPlant[plantid][splActive] = 0;
    ServerPlant[plantid][splType] = PLANT_TYPE_NONE;
    return 1;
}

// ==========================================
// COMMANDS (ZCMD / PAWN.CMD)
// ==========================================

CMD:tanam(playerid, params[])
{
    if(PlayerInfo[playerid][pSawit] >= 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Masih ada sawit di tas kamu. Muat ke Bobcat dulu sebelum ambil lagi!");
        
    if(IsPlayerNearAnyPlant(playerid, MIN_PLANT_DISTANCE)) 
        return SendClientMessage(playerid, 0xFF0000AA, "Error: Kamu tidak bisa menanam di sini, terlalu dekat dengan tanaman lain!");

    new menuStr[256];
    format(menuStr, sizeof(menuStr), "Padi [ 5 Seeds ]\nKentang [ 10 Seeds ]\nPalem [ 150 Seeds ]\n{FF0000}Marijuana [ 20 Seeds ]");
    ShowPlayerDialog(playerid, DIALOG_PLANT_MENU, DIALOG_STYLE_LIST, "Plant Menu", menuStr, "Tanam", "Batal");
    return 1;
}
CMD:createfamilly(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
    new targetid, famName[32], famType[16];
    if(sscanf(params, "us[32]s[16]", targetid, famName, famType))
        return SendClientMessage(playerid, -1, "Gunakan: /createfamilly [idleader] [namafam] [mc/cartel/mafia/street/gangster]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "Player tidak terhubung.");

    if(strcmp(famType, "mc", true) != 0 && strcmp(famType, "cartel", true) != 0 &&
       strcmp(famType, "mafia", true) != 0 && strcmp(famType, "street", true) != 0 &&
       strcmp(famType, "gangster", true) != 0)
    {
        return SendClientMessage(playerid, -1, "Tipe family harus: mc, cartel, mafia, street, atau gangster.");
    }

    format(PlayerInfo[targetid][pFamName], 32, "%s", famName);
    format(PlayerInfo[targetid][pFamType], 16, "%s", famType);
    PlayerInfo[targetid][pFamlead] = 1;
    PlayerInfo[targetid][pFamnorp] = 1;

    // --- AUTO SAVE ---
    OnPlayerUpdateAccountsPer(targetid, "pFamName", PlayerInfo[targetid][pFamName]);
    OnPlayerUpdateAccountsPer(targetid, "pFamType", PlayerInfo[targetid][pFamType]);
    OnPlayerUpdateAccountsPer(targetid, "pFamlead", PlayerInfo[targetid][pFamlead]);
    OnPlayerUpdateAccountsPer(targetid, "pFamnorp", PlayerInfo[targetid][pFamnorp]);

    new string[128], name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, name, sizeof(name));
    format(string, sizeof(string), "Family \"%s\" (%s) berhasil dibuat. Leader: %s (ID: %d).", famName, famType, name, targetid);
    SendClientMessage(playerid, -1, string);

    format(string, sizeof(string), "Kamu telah diangkat menjadi Leader dari Family \"%s\" (%s).", famName, famType);
    SendClientMessage(targetid, -1, string);
    return 1;
}

CMD:kickafam(playerid, params[])
{
    if(PlayerInfo[playerid][pFamlead] != 1)
        return SendClientMessage(playerid, -1, "Kamu bukan Leader Family!");

    new targetid;
    if(sscanf(params, "u", targetid))
        return SendClientMessage(playerid, -1, "Gunakan: /kickafam [playerid]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "Player tidak terhubung.");

    if(strcmp(PlayerInfo[playerid][pFamName], PlayerInfo[targetid][pFamName], true) != 0 || strlen(PlayerInfo[targetid][pFamName]) == 0)
        return SendClientMessage(playerid, -1, "Player ini bukan anggota Family kamu.");

    if(targetid == playerid)
        return SendClientMessage(playerid, -1, "Kamu tidak bisa mengeluarkan diri sendiri.");

    PlayerInfo[targetid][pFamName][0] = '\0';
    PlayerInfo[targetid][pFamType][0] = '\0';
    PlayerInfo[targetid][pFamlead] = 0;
    PlayerInfo[targetid][pFamnorp] = 0;

    // --- AUTO SAVE ---
    OnPlayerUpdateAccountsPer(targetid, "pFamName", PlayerInfo[targetid][pFamName]);
    OnPlayerUpdateAccountsPer(targetid, "pFamType", PlayerInfo[targetid][pFamType]);
    OnPlayerUpdateAccountsPer(targetid, "pFamlead", PlayerInfo[targetid][pFamlead]);
    OnPlayerUpdateAccountsPer(targetid, "pFamnorp", PlayerInfo[targetid][pFamnorp]);

    SendClientMessage(targetid, -1, "Kamu telah dikeluarkan dari Family.");
    SendClientMessage(playerid, -1, "Anggota berhasil dikeluarkan dari Family.");
    return 1;
}

// CMD: /myfam
CMD:myfam(playerid, params[])
{
    if(strlen(PlayerInfo[playerid][pFamName]) == 0)
        return SendClientMessage(playerid, -1, "Kamu tidak bergabung dalam Family apa pun!");

    new dialogContent[1024], membersOnline[512], count = 0, name[MAX_PLAYER_NAME];

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && strcmp(PlayerInfo[i][pFamName], PlayerInfo[playerid][pFamName], true) == 0)
        {
            GetPlayerName(i, name, sizeof(name));
            format(membersOnline, sizeof(membersOnline), "%s%s (ID: %d) - %s\n", membersOnline, name, i, PlayerInfo[i][pFamlead] ? "Leader" : "Member");
            count++;
        }
    }

    format(dialogContent, sizeof(dialogContent),
        "Nama Family:\t%s\nTipe Family:\t%s\nJabatan Kamu:\t%s\nJumlah Online:\t%d Player\n\n--- Anggota Online ---\n%s",
        PlayerInfo[playerid][pFamName],
        PlayerInfo[playerid][pFamType],
        PlayerInfo[playerid][pFamlead] ? "Leader" : "Member",
        count,
        membersOnline
    );

    ShowPlayerDialog(playerid, DIALOG_MYFAM, DIALOG_STYLE_MSGBOX, "My Family Information", dialogContent, "Tutup", "");
    return 1;
}

// CMD: /listfam
CMD:listfam(playerid, params[])
{
    new dialogContent[1024] = "Nama Family\tTipe\tLeader\n";
    new count = 0, name[MAX_PLAYER_NAME];

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && PlayerInfo[i][pFamlead] == 1 && strlen(PlayerInfo[i][pFamName]) > 0)
        {
            GetPlayerName(i, name, sizeof(name));
            format(dialogContent, sizeof(dialogContent), "%s%s\t%s\t%s\n", dialogContent, PlayerInfo[i][pFamName], PlayerInfo[i][pFamType], name);
            count++;
        }
    }

    if(count == 0)
        return SendClientMessage(playerid, -1, "Tidak ada Family aktif saat ini.");

    ShowPlayerDialog(playerid, DIALOG_LISTFAM, DIALOG_STYLE_TABLIST_HEADERS, "List Family Active", dialogContent, "Tutup", "");
    return 1;
}

// CMD: /aremovefam [id lead]
CMD:aremovefam(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;
    new targetlead;
    if(sscanf(params, "u", targetlead))
        return SendClientMessage(playerid, -1, "Gunakan: /aremovefam [id leader]");

    if(!IsPlayerConnected(targetlead))
        return SendClientMessage(playerid, -1, "Player tidak terhubung.");

    if(PlayerInfo[targetlead][pFamlead] != 1 || strlen(PlayerInfo[targetlead][pFamName]) == 0)
        return SendClientMessage(playerid, -1, "Player tersebut bukan seorang Leader Family!");

    new targetFam[32];
    format(targetFam, sizeof(targetFam), "%s", PlayerInfo[targetlead][pFamName]);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && strcmp(PlayerInfo[i][pFamName], targetFam, true) == 0)
        {
            PlayerInfo[i][pFamName][0] = '\0';
            PlayerInfo[i][pFamType][0] = '\0';
            PlayerInfo[i][pFamlead] = 0;
            PlayerInfo[i][pFamnorp] = 0;

            // --- AUTO SAVE ---
            OnPlayerUpdateAccountsPer(i, "pFamName", PlayerInfo[i][pFamName]);
            OnPlayerUpdateAccountsPer(i, "pFamType", PlayerInfo[i][pFamType]);
            OnPlayerUpdateAccountsPer(i, "pFamlead", PlayerInfo[i][pFamlead]);
            OnPlayerUpdateAccountsPer(i, "pFamnorp", PlayerInfo[i][pFamnorp]);

            SendClientMessage(i, -1, "Family kamu telah dibubarkan oleh Admin.");
        }
    }

    SendClientMessage(playerid, -1, "Family berhasil dihapus dan seluruh anggotanya telah dikeluarkan secara otomatis.");
    return 1;
}
