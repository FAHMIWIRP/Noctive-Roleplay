	return 1;
}
stock PayDay()
{
    new hour, minute, second;
    gettime(hour, minute, second);

    // Siapkan variabel string untuk memformat teks
    new str[128];

    foreach(new i : Player)
    {
        if(!PlayerInfo[i][pLogin]) continue;
        if(IsPlayerNPC(i)) continue;

        new salary = 500;
        new tax = 100 + random(200);
        new total = salary - tax;

        // Menggunakan SendClientMessage bawaan SA-MP
        SendClientMessage(i, -1, "===============================");

        format(str, sizeof(str), " {3399FF}Waktu Saat Ini: %02d:%02d", hour, minute);
        SendClientMessage(i, -1, str);

        format(str, sizeof(str), " {66CC00}Gaji Pokok: $%d", salary);
        SendClientMessage(i, -1, str);

        format(str, sizeof(str), " {FF0000}Pajak Negara: -$%d", tax);
        SendClientMessage(i, -1, str);

        // Memberikan uang ke bank dan EXP ke pemain
        GivePlayerBankEx(i, total, "Gaji PayDay");
        GivePlayerExp(i, 10);

        format(str, sizeof(str), " {FFFFFF}Total Diterima: {66CC00}$%d", total);
        SendClientMessage(i, -1, str);

        // Karena ini teks statis (tidak ada variabel %d, %s, dll), langsung gunakan SendClientMessage
        SendClientMessage(i, -1, " {FFFFFF}EXP Didapatkan: +10");

        format(str, sizeof(str), " {FFFFFF}Saldo Bank Saat Ini: {66CC00}$%d", PlayerInfo[i][pBank]);
        SendClientMessage(i, -1, str);

        SendClientMessage(i, -1, "===============================");

        GameTextForPlayer(i, "~g~PAYDAY TELAH TIBA!", 4000, 1);
        PlayerPlaySound(i, 17803, 0.0, 0.0, 0.0);
    }
    return 1;
}

CMD:testpayday(playerid)
{
    if(!IsPlayerAdmin(playerid)) return SendClientMessage(playerid, 0xFF0000AA, "Hanya admin yang dapat menggunakan perintah ini!");
    PayDay();
    SendClientMessage(playerid, 0x00FF00AA, ">> PayDay telah dijalankan secara manual!");
    return 1;
}
stock CheckGoogleAuthenticator(playerid)
{
    if(PlayerInfo[playerid][pCheckGoogle] == 1)
	{
		if(strcmp(GetPlayerIpEx(playerid), PlayerInfo[playerid][pIp]))
		{
            SetPlayerInterior(playerid, 0);
			SetPlayerFacingAngle(playerid, 179.5547);
			SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
			SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
			TogglePlayerControllableEx(playerid, 0);

            SPD(playerid,137,DIALOG_STYLE_INPUT,"{CC9900}Google Authenticator", ""W"Sistem keamanan meminta kode otentikasi.\n\nBuka aplikasi 'Google Authenticator' di smartphone Anda dan masukkan kode\nIngat bahwa kode tersebut diperbarui di aplikasi setiap 30 detik...", "Masuk", "Exit");
			return 1;
		}
	}
	if(PlayerInfo[playerid][pCheckGoogle] == 2)
	{
 		SetPlayerInterior(playerid, 0);
		SetPlayerFacingAngle(playerid, 179.5547);
		SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
		SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
		TogglePlayerControllableEx(playerid, 0);

		SPD(playerid,137,DIALOG_STYLE_INPUT,"{CC9900}Google Authenticator", ""W"Sistem keamanan meminta kode autentikasi.\n\nBuka aplikasi 'Google Authenticator' di smartphone Anda dan masukkan kode\nIngat bahwa kode diperbarui di aplikasi setiap 30 detik...", "Masuk", "Exit");
		return 1;
	}
	return 1;
}
stock LoadAccounts(playerid)
{
    if(PlayerInfo[playerid][pCheckGoogle] == 1 && GetPVarInt(playerid, "AllowPutCode") == 0)
	{
		if(strcmp(GetPlayerIpEx(playerid), PlayerInfo[playerid][pIp]))
		{
            SetPlayerInterior(playerid, 0);
			SetPlayerFacingAngle(playerid, 179.5547);
			SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
			SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
			TogglePlayerControllableEx(playerid, 0);

            SPD(playerid,137,DIALOG_STYLE_INPUT,"{CC9900}Google Authenticator", ""W"Sistem keamanan meminta kode otentikasi.\n\nBuka aplikasi 'Google Authenticator' di smartphone Anda dan masukkan kode\nIngatlah bahwa waktu smartphone harus menjadi Moskow...", "Masuk", "Exit");
			return 1;
		}
	}
	if(PlayerInfo[playerid][pCheckGoogle] == 2 && GetPVarInt(playerid, "AllowPutCode") == 0)
	{
 		SetPlayerInterior(playerid, 0);
		SetPlayerFacingAngle(playerid, 179.5547);
		SetPlayerCameraPos(playerid, -1817.0808, 1112.9937, 235.4244);
		SetPlayerCameraLookAt(playerid, -1816.5471, 949.6590, 235.4244);
		TogglePlayerControllableEx(playerid, 0);

		SPD(playerid,137,DIALOG_STYLE_INPUT,"{CC9900}Google Authenticator", ""W"Sistem keamanan meminta kode otentikasi.\n\nBuka aplikasi 'Google Authenticator' di smartphone Anda dan masukkan kode\nIngatlah bahwa waktu smartphone harus menjadi Moskow...", "Masuk", "Exit");
		return 1;
	}
    format(MySQLStr, 188, "UPDATE `accounts` SET `pIp` = '%s', `pLogin` = 1 WHERE `pID` = %d", GetPlayerIpEx(playerid), PlayerInfo[playerid][pID]);
	mysql_tquery(mMysql, MySQLStr);

	PlayerInfo[playerid][pLogin] = 1;
	//

	format(MySQLStr, 128, "SELECT * FROM `notifications` WHERE `user_id` = %i", GetPlayerAccountID(playerid));
	mysql_tquery(mMysql, MySQLStr, "ShowPlayerNofitications", "d", playerid);

	format(MySQLStr, 128, "SELECT * FROM `supports` WHERE `user_id` = %i LIMIT 1", GetPlayerAccountID(playerid));
	mysql_tquery(mMysql, MySQLStr, "OnPlayerSupport", "d", playerid);

	format(MySQLStr, 128, "SELECT * FROM `admin` WHERE `Name` = '%s' LIMIT 1", Name(playerid));
	mysql_tquery(mMysql, MySQLStr, "OnPlayerAdminAccounts", "d", playerid);

	if(GetPlayerHouse(playerid) != -1) { if(HouseInfo[GetPlayerHouse(playerid)][hOplata] <= 3 && HouseInfo[GetPlayerHouse(playerid)][hSlet] == 0) Send(playerid, 0xFFE569FF, "Anda memiliki beberapa hari untuk membayar rumah itu."); }
	if(GetPlayerBizz(playerid) != -1) { if(BizzInfo[GetPlayerBizz(playerid)][bOplata] <= 3 && BizzInfo[GetPlayerBizz(playerid)][bSlet] == 0) Send(playerid, 0xFFE569FF, "Anda memiliki beberapa hari pembayaran untuk bisnis Anda."); }
	if(GetPlayerABizz(playerid)) { if(BizzAInfo[GetPlayerABizz(playerid)][aOplata] <= 2 && BizzAInfo[GetPlayerABizz(playerid)][aSlet] == 0) Send(playerid, 0xFFE569FF, "Anda telah membayar sangat sedikit hari di pompa bensin."); }
	if(PlayerInfo[playerid][pText] == 1) PlayerInfo[playerid][pText] = 0, Send(playerid, COLOR_LIGHTRED, "Anda menerima peringatan offline, info lebih lanjut /warninfo");
	if(PlayerInfo[playerid][pText] == 3 && PlayerInfo[playerid][pfWarn] > 0) PlayerInfo[playerid][pText] = 0, SCMF(playerid, COLOR_LIGHTRED, "Anda menerima peringatan sebagai pemimpin faksi %d/3", PlayerInfo[playerid][pfWarn]);
	if(PlayerInfo[playerid][pText] == 4) PlayerInfo[playerid][pText] = 0, Send(playerid, COLOR_LIGHTRED, "Anda telah dihapus dari pemimpin faksi offline.");

	if(PlayerInfo[playerid][pMestoPrison] >= 1 || PlayerInfo[playerid][pPrison] >= 1)
	{
	    if(PlayerInfo[playerid][pMestoPrison] == 1) // LSPD
	    {
			t_SetPlayerPos(playerid, 304.674011, -778.601684, 14.711175);
			SetPlayerInterior(playerid, 6), SetPlayerVirtualWorld(playerid, 1);
		}
		else if(PlayerInfo[playerid][pMestoPrison] == 2) // FBI
		{
			t_SetPlayerPos(playerid, 304.674011, -778.601684, 14.711175);
			SetPlayerInterior(playerid, 6), SetPlayerVirtualWorld(playerid, 1);
		}
		else if(PlayerInfo[playerid][pMestoPrison] == 3) // PRISON
		{
		    t_SetPlayerPos(playerid, 304.674011, -778.601684, 14.711175);
			SetPlayerInterior(playerid, 6), SetPlayerVirtualWorld(playerid, 1);
		}
		SetCameraBehindPlayer(playerid), ResetWeapons(playerid);
	}

    if(PlayerInfo[playerid][pVipTime] > 0)
	{
		new current_date = getdate(year, month, day);
		new time_left = PlayerInfo[playerid][pVipTime] - current_date;
		if(time_left <= 0)
		{
			SendClientMessage(playerid, COLOR_YELLOW, "Status Anda telah kedaluwarsa!");
			PlayerInfo[playerid][pVip] = PlayerInfo[playerid][pVipTime] = 0;
			OnPlayerUpdateAccountsPer(playerid, "pVip", PlayerInfo[playerid][pVip]);
			OnPlayerUpdateAccountsPer(playerid, "pVipTime", PlayerInfo[playerid][pVipTime]);
		}
	}

	SetTimerEx("UpdatePlayerDataAfterLogin", 3000, false, "i", playerid);

	SpawnPlayerEx(playerid);
	return 1;
}
stock GetMonthName(months)
{
    new monthname_str[10];

	switch(months)
	{
		case 1: monthname_str = "January";
		case 2: monthname_str = "February";
		case 3: monthname_str = "March";
		case 4: monthname_str = "April";
		case 5: monthname_str = "May";
		case 6: monthname_str = "June";
		case 7: monthname_str = "July";
		case 8: monthname_str = "August";
		case 9: monthname_str = "September";
		case 10: monthname_str = "October";
		case 11: monthname_str = "November";
		case 12: monthname_str = "December";
	}

	return monthname_str;
}
stock GetWeekDayName(UTC)
{
    new weekday_str[15];
    switch(((gettime()+UTC*3600)/86400)%7)
    {
        case 0: weekday_str = "Thursday";
		case 1: weekday_str = "Friday";
		case 2: weekday_str = "Saturday";
		case 3: weekday_str = "Sunday";
		case 4: weekday_str = "Monday";
		case 5: weekday_str = "Tuesday";
		case 6: weekday_str = "Wednesday";
    }
    return weekday_str;
}
