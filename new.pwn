CMD:gps(playerid, params[])
{
	if(player_search_player[playerid] != -1 ||
 		StartFarm[playerid] == 1 ||
		 player_job[playerid] == 2 ||
		 PlayerInfo[playerid][pJob] == 6 && rent_job_vehicle[playerid] != INVALID_VEHICLE_ID) return Send(playerid, COLOR_GREY, "Anda saat ini tidak dapat menggunakan navigator GPS.");

	if(player_job[playerid] > 0) return Send(playerid, COLOR_GREY,"Jangan gunakan GPS saat sedang bekerja.");
	if(GetPVarInt(playerid, "GPS") != 0)
	{
	    Send(playerid, COLOR_GREY, "Anda telah menonaktifkan GPS. Masukkan perintah lagi...");
		DisablePlayerCheckpoint(playerid);
		return SetPVarInt(playerid, "GPS", 0);
	}
	SPD(playerid, 154, DIALOG_STYLE_LIST, "GPS", "{ffffff}1. Public Location\n2. Job Location\n3. General Location\n4. Dealeship\n5. Bizz Open\n6. Gas Station Open\n7. List Workshop\n- Tandai Bisnis Terdekat\n- Toko 24/7 Tedekat\n- Bar Terdekat\n- Restoran Terdekat\n- Atm Terdekat", "Ya", "Tidak");
	return true;
}

CMD:apagagaha(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Goss tidak dapat diakses. pecahan.");

    if(!PlayerInfo[playerid][pMember]) return Send(playerid, -1, "Untuk menggunakan obrolan organisasi, Anda harus menjadi anggota!");
	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: /f [teks]");

	format(format_string, sizeof(format_string), "* [F] %s: %s", Name(playerid), params[0]);
	foreach(new i : Player) if(PlayerInfo[playerid][pMember] == PlayerInfo[i][pMember]) Send(i, 0x93aa00AA,format_string);

	return 1;
}

CMD:fn(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

    if(!PlayerInfo[playerid][pMember]) return Send(playerid, -1, "Untuk menggunakan obrolan organisasi, Anda harus menjadi anggota!");
	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: /fn [teks]");

	format(format_string, sizeof(format_string), "* [F] %s[%d]: (( %s ))", Name(playerid), playerid, params[0]);
	foreach(new i : Player) if(PlayerInfo[playerid][pMember] == PlayerInfo[i][pMember]) Send(i, 0x93aa00AA,format_string);

	return 1;
}

CMD:setbizprice(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    for(new i; i < MAX_BIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

        if(sscanf(params, "i",params[0])) return Send(playerid, -1, "Masuk: /setbizprice [price]");

		if(!(1 <= params[0] <= 10000000))
		    return SCM(playerid, COLOR_GREY, "Masukkan harga dari 1 hingga 10.000.000");

		BizzInfo[i][bBuyPrice] = params[0];

        SaveBizzPer(i, "bBuyPrice", params[0]);

        return SCMF(playerid, COLOR_GREEN, "Anda telah mengubah nilai bisnis %i pada $%i", i, params[0]);
	}

	return SCM(playerid, COLOR_GREY, "Tidak ada bisnis di dekat Anda.");
}

CMD:setbizname(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    for(new i; i < MAX_BIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

        if(!strlen(params)) return Send(playerid, -1, "Masuk: /setbizname [name]");

	    format(BizzInfo[i][bMessage], 48, params);

        mysql_format(mMysql, format_string, 144, "UPDATE `bizz` SET `bMessage` = '%e' WHERE `bID` = %d", params, i);
        mysql_tquery(mMysql, format_string);

        return SCMF(playerid, COLOR_GREEN, "Anda mengubah nama bisnis %i pada %s", i, params);
	}

	return SCM(playerid, COLOR_GREY, "Tidak ada bisnis di dekat Anda.");
}

CMD:setfuelprice(playerid, params[])
{
	if(admin_level[playerid] == 0) return 1;

    for(new i; i < MAX_aBIZZ; i++)
	{
        if(!PlayerToPoint(10.0, playerid, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ])) continue;

        if(sscanf(params, "i",params[0])) return Send(playerid, -1, "Masuk: /setfuelprice [price]");

		if(!(1 <= params[0] <= 10000000))
		    return SCM(playerid, COLOR_GREY, "Masukkan harga dari 1 hingga 10.000.000");

		BizzAInfo[i][aBuyPrice] = params[0];

        SaveABizzPer(i, "aBuyPrice", params[0]);

        return SCMF(playerid, COLOR_GREEN, "Anda telah mengubah biaya pengisian bahan bakar %i pada $%i", i, params[0]);
	}

	return SCM(playerid, COLOR_GREY, "Tidak ada bisnis di dekat Anda.");
}

CMD:leave(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid)) return Send(playerid, COLOR_GREY, "Fungsi tidak dapat digunakan di dalam mobil!");

    if(player_lecenie[playerid] != -1) return PlayerLeaveHospitalBed(playerid);

	if(player_news_live[playerid])
	{
	    format(format_string, 144, "[R] %s[%i] meninggalkan udara sendirian.", GetPlayerNameEx(playerid), playerid);
        SendFrac(FRACTION_NEWS, COLOR_GREEN, format_string);

	    SCM(playerid, COLOR_WHITE, "Anda meninggalkan siaran sendiri.");
	    player_news_live[playerid] = false;
	}

	if(PlayerInfo[playerid][pJob] != 0)
	{
		format(String, 96, ""W"Apakah Anda yakin ingin meninggalkan pekerjaan '%s'?", NamesJob(playerid));
		SPD(playerid,153,DIALOG_STYLE_MSGBOX, "Pemberhentian kerja", String, "Ya", "Tidak");
	}
	return 1;
}

CMD:time(playerid, params[])
{
	if(PlayerInfo[playerid][pClock] == 0) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki jam tangan, membelinya di toko 24/7");

	SCMF(playerid, COLOR_YELLOW, "Menang dalam satu jam terakhir: %s", ConvertSeconds(PlayerInfo[playerid][pInGameHourSeconds]));

	new game_seconds = PlayerInfo[playerid][pInGameSeconds];

    new hours = floatround(game_seconds / 3600);
	new mins = floatround((game_seconds / 60) - (hours * 60));

 	new hour,minuite,second;
    gettime(hour,minuite,second);

	format(format_string, 64, "%02i %s %i~n~%i:%02i~n~%02i:%02i",
	    year, GetMonthName(month), day, hour, minuite, hours, mins);

	GameTextForPlayer(playerid, format_string, 3000, 1);

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"COP_AMBIENT","Coplook_watch",4.1,0,0,0,0,0,1);
	format(String, 48, "%s Melihat Jam tangan", Name(playerid));
	ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

	if(PlayerInfo[playerid][pPrison] > 0) SCMF(playerid, COLOR_ISPOLZUY, "Anda harus duduk %d detik", PlayerInfo[playerid][pPrison]);
	return 1;
}
CMD:saveall(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
    if(GetPVarInt(playerid, "SaveAll") > gettime()) return Send(playerid, COLOR_GREY, "Anda dapat menyimpan semua informasi server setiap 180 detik!");

	SPD(playerid,0,DIALOG_STYLE_MSGBOX, "Hemat", ""W"Menyimpan Tabel:\n\n- Bisnis\n- SPBU\n- Mobil\n- Di rumah\n\n{60B811}Berhasil menyelamatkan!\n"W"Detail dalam server.log", "Tutup", "");
	SetPVarInt(playerid, "SaveAll", gettime()+180);
	return SaveAllServers();
}
CMD:getip(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d", params[0])) return Send(playerid,-1, "Masuk: /getip [id]");

	SCMF(playerid, -1, "Nick: %s", GetPlayerNameEx(params[0]));
	SCMF(playerid, -1, "L-IP: %s", GetPlayerIpEx(params[0]));
	SCMF(playerid, -1, "R-IP: %s", PlayerInfo[params[0]][pIpReg]);

	return 1;
}
CMD:kick1(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "ds[128]",params[0], params[1])) return Send(playerid, -1, "Masuk: /kick [id] [alasan]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan. / tidak resmi.");
    //if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, COLOR_GREY, "Anda tidak dapat memblokir administrator atas/rekan.");

    SendClientMessageToAll(COLOR_LIGHTRED, "AdmCmd: %s was kicked by admin %s", pData[pName], pData[playerid][pAname], params[1]);
	SendClientMessageToAll(COLOR_LIGHTRED, "AdmCmd: Reason: %s", params[1]);

    PlayerInfo[playerid][pAdmKick] ++;
    OnPlayerUpdateAdminPer(playerid, "pAdmKick", PlayerInfo[playerid][pAdmKick]);

    KickFivem(params[0], params[1]);
    return true;
}
CMD:makequiz(playerid, params[])
{
	    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
	{
		new tmp[128], string[256], str[256], pr;
		if(sscanf(params, "s[128]", tmp))
		{
		    SendClientMessage(playerid, -1, "/makequiz [option]");
		    SendClientMessage(playerid, -1, "question, answer, price, end");
		    SendClientMessage(playerid, -1, "Tolong buat jawabannya dulu.");
		    return 1;
		}
		if(!strcmp(tmp, "question", true, 8))
		{
			if(sscanf(params, "s[128]s[256]", tmp, str))
		    return SendClientMessage(playerid, -1, "/makequiz question [question]");
		if (quiz == 1)
		    return Error(playerid, "Kuis sudah dimulai kamu bisa mengakhirinya dengan /makequiz end.");
		if (answermade == 0)
		    return Error(playerid, "tolong buat jawaban dulu...");
		if (qprs == 0)
		    return Error(playerid, "Tolong tambahkan hadiah terlebih dahulu.");
		format(string, sizeof(string), "{7fffd4}[QUIZ]: {ffff00}%s?, Hadiah {00FF00}$%d.", str, qprs);
		SendClientMessageToAll(0xFFFF00FF, string);
		SendClientMessageToAll(-1,"{ffff00}Anda bisa memberi jawaban dengan menggunakan /answer.");
		quiz = 1;
		}
		else if(!strcmp(tmp, "answer", true, 6))
		{
			if(sscanf(params, "s[128]s[256]", tmp, str))
		    return SendClientMessage(playerid, -1, "/makequiz answer [answer]");
		if (quiz == 1)
		    return SendClientMessage(playerid, -1, "Kuis sudah dimulai kamu bisa mengakhirinya dengan /makequiz end.");
		answers = str;
		answermade = 1;
		format(string, sizeof(string), "Anda telah membuat jawaban, {00FF00}%s.", str);
		SendClientMessage(playerid, 0xFFFFFFFF, string);
		}
		else if(!strcmp(tmp, "price", true, 5))
		{
			if(sscanf(params, "s[128]i", tmp, pr))
    return SendClientMessage(playerid, -1, "/makequiz price [amount]");
			if (quiz == 1) return Error(playerid, "Kuis sudah dimulai kamu bisa mengakhirinya dengan / makequiz end.");
			if (answermade == 0) return Error(playerid, " Membuat jawabannya lebih dulu...");
			if (pr <= 0) return Error(playerid, "buat harga lebih besar dari 0!");
			qprs = pr;
			format(string, sizeof(string), "Anda telah menempatkan {00FF00}%d sebagai jumlah hadiah untuk kuis.", pr);
			SendClientMessage(playerid, 0xFFFFFFFF, string);
		}
		else if(!strcmp(tmp, "end", true, 3))
		{
			if (quiz == 0) return Error(playerid, "Sayangnya tidak ada kuis dari admin server.");
			SendClientMessageToAll(0xFF0000FF, "Sayangnya Admin server telah mengakhiri kuis tersebut.");
			answermade = 0;
			quiz = 0;
			qprs = 0;
			answers = "";
		}
	}
	return 1;
}
// Fungsi untuk memunculkan notifikasi
// =============================================================================
// FUNGSI UTAMA UNTUK MEMUNCULKAN NOTIFIKASI BARANG
// =============================================================================
stock ShowItemNotification(playerid, bool:isAdded, const item_name[], amount)
{
    new slot = -1;

    // 1. Cari slot yang sedang kosong / menganggur
    for(new i = 0; i < MAX_NOTIFS; i++)
    {
        if(ItemNotificationTD[playerid][i] == PlayerText:INVALID_TEXT_DRAW)
        {
            slot = i;
            break;
        }
    }

    // 2. Jika semua 10 slot penuh, paksa timpa slot paling atas (slot 0)
    if(slot == -1)
    {
        if(ItemNotificationTimer[playerid][0] != -1) 
        {
            KillTimer(ItemNotificationTimer[playerid][0]);
        }
        PlayerTextDrawDestroy(playerid, ItemNotificationTD[playerid][0]);
        slot = 0;
    }

    // 3. Format teks tampilan textdraw sesuai request terbaru
    new str[128];
    if(isAdded)
    {
        // Format hasil: [ ADD ] Nama Barang x Jumlah
        format(str, sizeof(str), "~g~[ ADD ] ~w~%s x %d", item_name, amount);
    }
    else
    {
        // Format hasil: [ REMOVE ] Nama Barang x Jumlah
        format(str, sizeof(str), "~r~[ REMOVE ] ~w~%s x %d", item_name, amount);
    }

    // 4. Hitung posisi koordinat Y secara dinamis (makin besar ID slot, makin turun ke bawah)
    // Koordinat bawaan: X = 490.0, Y awal = 140.0
    new Float:posY = 140.0 + (slot * NOTIF_TEXT_SPACING);

    // 5. Buat Player Textdraw baru di slot yang didapatkan
    ItemNotificationTD[playerid][slot] = CreatePlayerTextDraw(playerid, 490.0, posY, str);
    PlayerTextDrawLetterSize(playerid, ItemNotificationTD[playerid][slot], 0.28, 1.15); // Ukuran font pas & rapi
    PlayerTextDrawAlignment(playerid, ItemNotificationTD[playerid][slot], 1);           // Rata kiri
    PlayerTextDrawColor(playerid, ItemNotificationTD[playerid][slot], -1);              // Warna teks putih dasar
    PlayerTextDrawSetShadow(playerid, ItemNotificationTD[playerid][slot], 1);           // Efek bayangan teks
    PlayerTextDrawSetOutline(playerid, ItemNotificationTD[playerid][slot], 0);          // Tanpa garis tepi
    PlayerTextDrawBackgroundColor(playerid, ItemNotificationTD[playerid][slot], 150);   // Warna background hitam transparan
    PlayerTextDrawFont(playerid, ItemNotificationTD[playerid][slot], 1);                // Font standard gta (Font 1)
    PlayerTextDrawSetProportional(playerid, ItemNotificationTD[playerid][slot], 1);     // Proporsi teks seimbang

    // 6. Tampilkan ke layar pemain
    PlayerTextDrawShow(playerid, ItemNotificationTD[playerid][slot]);

    // 7. Jalankan timer otomatis (Notifikasi akan terhapus sendiri dalam 5000 milidetik / 5 detik)
    ItemNotificationTimer[playerid][slot] = SetTimerEx("HideItemNotification", 5000, false, "dd", playerid, slot);
    return 1;
}

// =============================================================================
// CALLBACK TIMER UNTUK MENGHAPUS NOTIFIKASI PER SLOT SECARA BERSIH
// =============================================================================
public HideItemNotification(playerid, slot)
{
    if(slot >= 0 && slot < MAX_NOTIFS)
    {
        if(ItemNotificationTD[playerid][slot] != PlayerText:INVALID_TEXT_DRAW)
        {
            PlayerTextDrawHide(playerid, ItemNotificationTD[playerid][slot]);
            PlayerTextDrawDestroy(playerid, ItemNotificationTD[playerid][slot]);
            ItemNotificationTD[playerid][slot] = PlayerText:INVALID_TEXT_DRAW;
        }
        ItemNotificationTimer[playerid][slot] = -1;
    }
    return 1;
}

CMD:tusuk(playerid, params[])
{
    new targetid;
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} GUNAKAN: /tusuk [playerid]");
    if(targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF} Pemain tidak ditemukan.");
    if(targetid == playerid) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF} Tidak bisa menusuk diri sendiri.");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF} Player tidak connect.");

    // Cek harus pegang pisau
    if(GetPlayerWeapon(playerid)!= 4) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF} Kamu harus memegang pisau!");

    // Cek jarak maksimal 2 meter
    new Float:x, Float:y, Float:z;
    GetPlayerPos(targetid, x, y, z);
    if(!IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z)) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF} Target terlalu jauh.");

    // Cek posisi belakang
    new Float:attackerA, Float:targetA;
    GetPlayerFacingAngle(playerid, attackerA);
    GetPlayerFacingAngle(targetid, targetA);
    if(floatabs(attackerA - targetA) < 90.0) return SendClientMessage(playerid, -1, "{FF0000}[ ERROR ]{FFFFFF}  Kamu Harus Berhadapan Dengan Target.");

    new Float:health, Float:armour;
    GetPlayerHealth(targetid, health);
    GetPlayerArmour(targetid, armour);

    // Terapkan animasi untuk PENYERANG
    ApplyAnimation(playerid, "KNIFE", "KILL_Knife_Player", 4.1, 0, 1, 1, 0, 0, 1);

    // Terapkan animasi untuk KORBAN
    ApplyAnimation(targetid, "KNIFE", "KILL_Knife_Ped_Damage", 4.1, 0, 1, 1, 0, 0, 1);

    // Sistem damage
    if(armour > 0.0)
    {
        // Ada vest/armor putih, kurangin 40
        new Float:newArmour = armour - 40.0;
        if(newArmour < 0.0) newArmour = 0.0;
        SetPlayerArmour(targetid, newArmour);
        SendClientMessage(playerid, -1, "{FF8C00}[INFO]{FFFFFF} Kamu menusuk target, Mengenai Vest.");
        SendClientMessage(targetid, -1, "{FF0000}[INFO]{FFFFFF} Kamu ditusuk dari depan tetapi mengenai vest.");
    }
    else
    {
        // Ga ada vest, langsung mati
        SetPlayerHealth(targetid, 0.0);
        SendClientMessage(playerid, -1, "{FF8C00}[INFO]{FFFFFF} Kamu berhasil membunuh target dari depan!");
        SendClientMessage(targetid, -1, "{FF0000}[INFO]{FFFFFF} Kamu tewas ditusuk dari depan!");
    }
    return 1;
}
CMD:givesamd(playerid, params[])
{
    if(!IsAMedic(playerid) && (admin_level[playerid] < 1 )) return SCM(playerid, COLOR_GREY, "Anda Bukan Samd");
    if(IsPlayerConnected(playerid))
    {
        new name[24], amount, otherid;
        if(sscanf(params, "us[24]d", otherid, name, amount))
        {
            SendClientMessage(playerid, -1, "/give [playerid] [name] [amount]");
            Info(playerid, "Names: medicine, bandage, medkit");
            return 1;
        }
        if(otherid == INVALID_PLAYER_ID || otherid == playerid || !NearPlayer(playerid, otherid, 3.0))
            return Error(playerid, "Invalid playerid!");
        
        if(strcmp(name, "bandage", true) == 0)
        {
            pData[playerid][pHeals] -= amount;
            pData[otherid][pHeals] += amount;

            // --- NOTIFIKASI TEXTDRAW ---
            ShowItemNotification(playerid, false, "Bandage", amount);
            ShowItemNotification(otherid, true, "Bandage", amount);

            Info(playerid, "Anda telah berhasil memberikan perban kepada %s sejumlah %d.", ReturnName(otherid), amount);
            Info(otherid, "%s telah berhasil memberikan perban kepada anda sejumlah %d.", ReturnName(playerid), amount);
            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
            ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
        }
        else if(strcmp(name, "medicine", true) == 0)
        {
            pData[playerid][pMedicine] -= amount;
            pData[otherid][pMedicine] += amount;

            // --- NOTIFIKASI TEXTDRAW ---
            ShowItemNotification(playerid, false, "Medicine", amount);
            ShowItemNotification(otherid, true, "Medicine", amount);

            Info(playerid, "Anda telah berhasil memberikan Medicine kepada %s sejumlah %s.", ReturnName(otherid), FormatMoney(amount));
            Info(otherid, "%s telah berhasil memberikan Medicine kepada anda sejumlah %s.", ReturnName(playerid), FormatMoney(amount));
            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
            ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
        }
        else if(strcmp(name, "medkit", true) == 0)
        {
            pData[playerid][pMedkit] -= amount;
            pData[otherid][pMedkit] += amount;

            // --- NOTIFIKASI TEXTDRAW ---
            ShowItemNotification(playerid, false, "Medkit", amount);
            ShowItemNotification(otherid, true, "Medkit", amount);

            Info(playerid, "Anda telah berhasil memberikan Medkit kepada %s sejumlah %s.", ReturnName(otherid), FormatMoney(amount));
            Info(otherid, "%s telah berhasil memberikan Medkit kepada anda sejumlah %s.", ReturnName(playerid), FormatMoney(amount));
            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
            ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
        }
    }
    return 1;
}
CMD:give(playerid, params[])
{
    if(IsPlayerConnected(playerid))
    {
        new name[24], amount, otherid;
        if(sscanf(params, "us[24]d", otherid, name, amount))
        {
            SendClientMessage(playerid, -1, "/give [playerid] [name] [amount]");
            Info(playerid, "Names: crack ,bandage, metall, marijuana, component, redmoney, snack ,drink, seeds");
            return 1;
        }
        if(otherid == INVALID_PLAYER_ID || otherid == playerid || !NearPlayer(playerid, otherid, 3.0))
            return Error(playerid, "Invalid playerid!");
        
        if(strcmp(name, "bandage", true) == 0)
        {
            if(amount > PlayerInfo[playerid][pHeals])
                return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup bandage");
            if(amount < 1)
                return Error(playerid, "Can't Give below 1");
            
            pData[playerid][pHeals] -= amount;
            pData[otherid][pHeals] += amount;

            // --- NOTIFIKASI TEXTDRAW ---
            ShowItemNotification(playerid, false, "Bandage", amount);
            ShowItemNotification(otherid, true, "Bandage", amount);

            Info(playerid, "Anda telah berhasil memberikan perban kepada %s sejumlah %d.", ReturnName(otherid), amount);
