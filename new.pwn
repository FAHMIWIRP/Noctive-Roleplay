		    if(GetPVarInt(playerid,"pTimePetani") > gettime()) 
		        return Send(playerid, COLOR_GREY, "Cooldown Job 30 Menit");
		        
		    if(PlayerInfo[playerid][pSex] == 1) SetPlayerSkinEx(playerid,158);
		    else SetPlayerSkinEx(playerid,157);
		    
		    DutyGanjos[playerid] = 1;
		    PlayerInfo[playerid][pWorkedOnce] = 1; 
