CMD:getcord(playerid)
{
    new Float: pX,
        Float: pY,
        Float: pZ,
        Float: a;

    new cord[100];
    GetPlayerPos(playerid, pX, pY, pZ);
    GetPlayerFacingAngle(playerid, a);
    format(cord, sizeof cord, "Koordinat : \nx: %f y: %f z: %f a: %f", pX, pY, pZ, a);
    SendClientMessage(playerid, -1, cord);
    printf(cord);
    return 1;
}
