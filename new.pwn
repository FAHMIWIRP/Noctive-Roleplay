stock SavePlayerToys(playerid)
{
    format(MySQLStr, 1200, "UPDATE `accounts` SET `toyModel` = '%d,%d,%d', ",
    ToyInfo[playerid][toyModel][0], ToyInfo[playerid][toyModel][1], ToyInfo[playerid][toyModel][2]);

    format(MySQLStr, 1200, "%s `toyPositionX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionX][0], ToyInfo[playerid][toyPositionX][1], ToyInfo[playerid][toyPositionX][2]);

    format(MySQLStr, 1200, "%s `toyPositionY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionY][0], ToyInfo[playerid][toyPositionY][1], ToyInfo[playerid][toyPositionY][2]);

    format(MySQLStr, 1200, "%s `toyPositionZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyPositionZ][0], ToyInfo[playerid][toyPositionZ][1], ToyInfo[playerid][toyPositionZ][2]);

    format(MySQLStr, 1200, "%s `toyRotationX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationX][0], ToyInfo[playerid][toyRotationX][1], ToyInfo[playerid][toyRotationX][2]);

    format(MySQLStr, 1200, "%s `toyRotationY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationY][0], ToyInfo[playerid][toyRotationY][1], ToyInfo[playerid][toyRotationY][2]);

    format(MySQLStr, 1200, "%s `toyRotationZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyRotationZ][0], ToyInfo[playerid][toyRotationZ][1], ToyInfo[playerid][toyRotationZ][2]);

    format(MySQLStr, 1200, "%s `toyScaleX` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleX][0], ToyInfo[playerid][toyScaleX][1], ToyInfo[playerid][toyScaleX][2]);

    format(MySQLStr, 1200, "%s `toyScaleY` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleY][0], ToyInfo[playerid][toyScaleY][1], ToyInfo[playerid][toyScaleY][2]);

    format(MySQLStr, 1200, "%s `toyScaleZ` = '%f,%f,%f', ", MySQLStr,
    ToyInfo[playerid][toyScaleZ][0], ToyInfo[playerid][toyScaleZ][1], ToyInfo[playerid][toyScaleZ][2]);

    format(MySQLStr, 1200, "%s `toyBone` = '%d,%d,%d', ", MySQLStr,
    ToyInfo[playerid][toyBone][0], ToyInfo[playerid][toyBone][1], ToyInfo[playerid][toyBone][2]);

    format(MySQLStr, 1200, "%s `toyWear` = '%d,%d,%d' WHERE `pID` = %i", MySQLStr,
    ToyInfo[playerid][toyWear][0], ToyInfo[playerid][toyWear][1], ToyInfo[playerid][toyWear][2], PlayerInfo[playerid][pID]);

    mysql_tquery(mMysql, MySQLStr);

    return 1;
}
//END

CMD:hauling(playerid,params[])
{
		if(PlayerInfo[playerid][pLevel] < 5) return ShowWarning(playerid, "fitur ini tersedia dari level 5");
        new dedyvariabel[10000];
       	if(GetPVarInt(playerid,"pTimeHauling") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 menit");
        //if(PlayerInfo[playerid][pJob] == 20 || PlayerInfo[playerid][pJob2] == 20) //ini variabel jobsnya jika mau di masukan ke gm ubah yang ini
	    {
		if(SedangHauling[playerid] >= 1) { SendClientMessage(playerid,COLOR_WHITE,"You Are On Delivery.."); return 1; }
		//if(PlayerInfo[playerid][pTruckingSkill] < 32) { SendClientMessage(playerid,COLOR_WHITE,"Skills anda kurang untuk melakukan Hauling Missions."); return 1; } //hanya skills level tertentu yang bisa
  		if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 514 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 515) SCM(playerid, -1, "Untuk Melakukan Pekerjaan Hauling gunakan /hauling");
	    if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 514 || GetVehicleModel(GetPlayerVehicleID(playerid)) == 515)
		{
			strcat(dedyvariabel, "Order\tPrice\n");
			format(String, sizeof(String), "Ocean Dock Imports\t%s\n", (DialogHauling[0] == true) ? ("{FF0000}Taken") : ("{33AA33}300$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Ocean Dock Imports\t%s\n", (DialogHauling[1] == true) ? ("{FF0000}Taken") : ("{33AA33}500$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Angel Pine Exports\t%s\n", (DialogHauling[2] == true) ? ("{FF0000}Taken") : ("{33AA33}700$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Angel Pine Exports\t%s\n", (DialogHauling[3] == true) ? ("{FF0000}Taken") : ("{33AA33}999$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Chilliad Deport\t%s\n", (DialogHauling[4] == true) ? ("{FF0000}Taken") : ("{33AA33}1000$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Chilliad Deport\t%s\n", (DialogHauling[5] == true) ? ("{FF0000}Taken") : ("{33AA33}1300$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Easter Import\t%s\n", (DialogHauling[6] == true) ? ("{FF0000}Taken") : ("{33AA33}1600$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Blueberry Export\t%s\n", (DialogHauling[7] == true) ? ("{FF0000}Taken") : ("{33AA33}1900$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Las Venturas Deport\t%s\n", (DialogHauling[8] == true) ? ("{FF0000}Taken") : ("{33AA33}2000$"));
			strcat(dedyvariabel, String);
			format(String, sizeof(String), "Las Venturas Fuel & Gas\t%s", (DialogHauling[9] == true) ? ("{FF0000}Taken") : ("{33AA33}5000$"));
			strcat(dedyvariabel, String);
			ShowPlayerDialog(playerid, HAULING, DIALOG_STYLE_TABLIST_HEADERS, "Hauling Missions", dedyvariabel, "Select", "Cancel");
			return 1;
		}
		SendClientMessage(playerid, COLOR_WHITE,"You`re Not In The Truck.");
		return 1;
	}
}
CMD:cancelhauling(playerid, params[])
{
	if(SedangHauling[playerid] == 0)
		return SendClientMessage(playerid, COLOR_GREY, "ERROR: You`re Not Hauling mission");
	SedangHauling[playerid] =0;
	DisablePlayerRaceCheckpoint(playerid);
	/*DialogHauling[0] = false;
 	DialogSaya[playerid][0] = false;
  	DestroyVehicle(GetVehicleTrailer(GetPlayerVehicleID(playerid)));*/
  	for(new i; i <= 9; i++) // 9 = Total Dialog , Jadi kita mau tau kalau Player Ini Apakah Ambil Dialog dari 3 tersebut apa ga !
	{
	    DialogSaya[playerid][i] = false; // Ubah Jadi Dia ga punya dialog lagi Kalau Udah Disconnect (Bukan dia lagi pemilik)
	    DialogHauling[i] = false; // Jadi ga ada yang punya nih dialog
	    DestroyVehicle(TrailerHauling[playerid]);
	}
	return 1;
}
CMD:wedding(playerid, params[])
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	new nama, nama1;
	new cowo[MAX_PLAYER_NAME], cewe[MAX_PLAYER_NAME];
	if(sscanf(params, "uu", nama, nama1)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /wedding [cowok] [cewek]");
	if(!ProxDetectorS(5, playerid, nama)) return SCM(playerid, COLOR_GREY, "Pengantin Pria Terlalu Jauh");
	if(!ProxDetectorS(5, playerid, nama1)) return SCM(playerid, COLOR_GREY, "Pengantin Wanita Terlalu Jauh");
	GetPlayerName(nama1, cowo, sizeof(cowo));
    GetPlayerName(nama, cewe, sizeof(cewe));
	PlayerInfo[nama][pMenikah] = cewe;
	PlayerInfo[nama1][pMenikah] = cowo;
    OnPlayerUpdateAccountsPer(nama, "pMenikah", PlayerInfo[nama][pMenikah]);
    OnPlayerUpdateAccountsPer(nama1, "pMenikah", PlayerInfo[nama1][pMenikah]);
	format(format_string, sizeof(format_string), "{FFFF00}[INFO] {ffffff}Penghulu %s Telah Menikahkan %s Dengan %s", PlayerInfo[playerid][pName], PlayerInfo[nama][pName], PlayerInfo[nama1][pName]);
    SendClientMessageToAll(COLOR_BLUE, format_string);
    SCM(playerid, COLOR_YELLOW,  "[WEDDING] : {FFFFFF}Anda Sudah Tidak Menjadi Penghulu");
	return 1;
}
CMD:buymedicine(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 1355.643432, 1535.186767, 23223.085937))
        return SendClientMessage(playerid, COLOR_RED, "{FF0000}[ERROR]: {FFFFFF}Kamu harus berada di Rumah Sakit untuk membeli medicine!");

    if(PlayerInfo[playerid][pMedicine] >= 5)
        return SendClientMessage(playerid, COLOR_RED, "Perban Anda sudah penuh. Maksimal 5.");

    if(GetPlayerMoney(playerid) < 500)
        return SendClientMessage(playerid, COLOR_RED, "Uang Anda tidak cukup. Biaya: $500");

    // Kurangi uang & tambah medicine
    PlayerInfo[playerid][pMedicine] += 1;
    GivePlayerMoney(playerid, -500);
    PlayerInfo[playerid][pCash] = GetPlayerMoney(playerid); // sync ke var cash lo

    // Save ke DB
    OnPlayerUpdateAccountsPer(playerid, "pMedicine", PlayerInfo[playerid][pMedicine]);
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

    // Animasi & timer
    ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
    SetTimerEx("BeliBandage", 3000, false, "d", playerid);
    ShowProgressbar(playerid, "Sedang Membeli...", 3);
    SetPVarInt(playerid, "pTimeJual", gettime() + 4);

    SendClientMessage(playerid, COLOR_GREEN, "Anda berhasil membeli 1 Medicine seharga $500.");
    return 1;
}
CMD:bukunikah(playerid, params[])
{
    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/bukunikah [id pemain]");
	new nama, nama1;
	new str[116];

	String = "";
	new cowo[MAX_PLAYER_NAME], cewe[MAX_PLAYER_NAME];
	PlayerInfo[nama][pMenikah] = cewe;
	PlayerInfo[nama1][pMenikah] = cowo;
	
	format(str, 116, "{ffffff}Name: {FFFF00}%s\n", PlayerInfo[nama1][pMenikah]);
	strcat(String, str);

	format(str, 116, "{ffffff}Menikah Dengan: {FFFF00}%s\n", PlayerInfo[nama][pMenikah]);
    strcat(String, str);

	format(format_string, 40, "Buku Nikah %s", Name(playerid));
	SPD(to_player, 0000, 0, format_string, String, "Ok", "");
	MeAction(playerid, "Membuka Dompet Dan Menunjukan Buku Nikah Nya");
	return 1;
}
CMD:makegun(playerid)
{
	if(!IsAArmy(playerid))
	    return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk tentara");

	if(PlayerInfo[playerid][pPrison]) return SCM(playerid, COLOR_GREY, "Tidak tersedia saat ini.");

	SPD(playerid, 4558, DIALOG_STYLE_TABLIST, "Penciptaan senjata",
		"Colt 45\t30 Ammo\t100 Metall\t70 Kartid\n\
		Desert Eagle\t14 Ammo\t100 Metall\t150 Kartid\n\
        MP5\t60 Ammo\t250 Metall\t300 Kartid\n\
        Shotgun\t10 Ammo\t200 Metall\t200 Kartid\n\
        AK-47\t60 Ammo\t350 Metall\t300 Kartid", "Buat", "Close");

	return 1;
}
CMD:paytolll(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, 72.1348,-1527.5522,4.6756))
		{
		    if(tollstatus == 1) return SCM(playerid, COLOR_GREY, "Toll ditutup");
			MoveDynamicObject(Toll1, 68.0623, -1530.5416, 4.5654, 1.0, 0.0000, 0.0000, 88.0000);
   			GivePlayerMoneyEx(playerid, -50, "Anda telah membayar tol sebesar 50$");
			SCM(playerid, -1, "TOLL: {FFFFFF}Anda telah membayar tol sebesar 50$.");
			SetTimer("TutupGate1", 2000, 0);
		}
		else if(IsPlayerInRangeOfPoint(playerid, 5.0, 32.3296,-1534.5856,4.8408))
		{
		    if(tollstatus == 1) return SCM(playerid, COLOR_GREY, "Toll ditutup");
			MoveDynamicObject(Toll2, 35.1532, -1532.6484, 4.9854, 1.0, 0.0000, 0.0000, -92.0000);
   			GivePlayerMoneyEx(playerid, -50, "Anda telah membayar tol sebesar 50$");
			SCM(playerid, -1, "TOLL: {FFFFFF}Anda telah membayar tol sebesar 50$.");
			SetTimer("TutupGate2", 2000, 0);
		}
		//else SendClientMessage(playerid, -1, "Anda tidak berada didaerah toll.");
	}
	else SendClientMessage(playerid, -1, "Anda tidak berada didalam kendaraan.");
	return 1;
}
CMD:c(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params,"s[144]",params[0])) return Send(playerid,-1,"Masuk: /c [pesan]");
	if(IsPlayerInAnyVehicle(playerid)) {
		new vehId;
		vehId = GetPlayerVehicleID(playerid);
		format(format_string, 188, "(IN-CAR) %s says: %s", Name(playerid), params[0]);
		SCM(playerid, COLOR_RAZGOVOR3, format_string);
		SetPlayerChatBubble(playerid, "* talking in car *", 0x6495EDFF, 5.0, 5000);
		foreach(new i : Player)
		{
			if(i == playerid) continue;
			if(!IsPlayerInAnyVehicle(i)) continue;
			if(vehId != GetPlayerVehicleID(i)) continue;
			SCM(i, COLOR_RAZGOVOR3, format_string);
		}
		return false;
	}
	return 1;
}
CMD:fixcar(playerid, params[])
{
	if(admin_level[playerid] < 4 || !admin_logged[playerid]) return 1;
	if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
	RepairVehicle(GetPlayerVehicleID(playerid));
	SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
	PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
	return 1;
}
CMD:ambilobat(playerid)
{
   if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
   if(!IsPlayerInRangeOfPoint(playerid, 5, 604.0646,-2093.4761,995.6328)) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Di Tempat Pembelian");
   if(IsPlayerInRangeOfPoint(playerid, 5, 604.0646,-2093.4761,995.6328))
   {
   SPD(playerid, 9497, DIALOG_STYLE_TABLIST, "OBAT",
   "{ffff00}10 Obat"
   ,"Ambil","Keluar");
   }
   return 1;
}
CMD:lockserver(playerid, params[])
{
	//new String[10000];
	if(admin_level[playerid] < 10) return SendClientMessage(playerid, COLOR_GREY, "ERROR: You don't have the privilege to use this command!");
    if(ServerLocked)
    {
        ServerLocked = false;
        SendRconCommand("password 051110");
		SendRconCommand("hostname Noctive Roleplay");
		format(String, sizeof(String), "Admin %s unlocked the server.", PlayerInfo[playerid][pAname]);
		SendClientMessageToAll(COLOR_LIGHTRED, String);
    }
    else
    {
        ServerLocked = true;
        SendRconCommand("password panjulsukanoctive"); //password untuk lockserver nya
    	SendRconCommand("hostname Noctive Roleplay [Maintenance]");
		format(String, sizeof(String), "Admin %s locked the server.", PlayerInfo[playerid][pAname]);
		SendClientMessageToAll(COLOR_LIGHTRED, String);
    }
    return 1;
}
CMD:ondutyfraksi(playerid, params[])
{
    if(!PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Anda Bukan sebuah Fraksi");
    if(form_fraction[playerid] > 0) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah Onduty Fraksi");
    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pFrSkin]);
    form_fraction[playerid] = PlayerInfo[playerid][pMember];
    SetPlayerToTeamColor(playerid);
    SendClientMessage(playerid, 0x20A9FFFF, "Anda Onduty Fraksi");
    return 1;
}
CMD:offdutyfraksi(playerid, params[])
{
    if(!PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Anda Bukan sebuah Fraksi");
    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
    form_fraction[playerid] = 0;
    SetPlayerColor(playerid, 0xFFFFFFFF);
    SendClientMessage(playerid, 0x20A9FFFF, "Anda Offduty Fraksi");
    return 1;
}

CMD:resetgun(playerid, params[]) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new to_player; else return Send(playerid, -1, "USAGE: /resetgun [playerid]");
	if(!IsPlayerConnected(to_player)) return SCM(playerid, -1, "Pemain tidak konek!");
	if(!PlayerInfo[to_player][pLogin]) return SCM(playerid, COLOR_GREY, "Tidak ada pemain yang ditemukan!");
	format(format_string, 96, "[A] Administrator %s mereset senjata %s.", Name(playerid), Name(to_player));
	SendAdminMessage(COLOR_GREY, format_string);
	ResetWeapons(to_player);
	return 1;
}

CMD:checkgun(playerid, params[]) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	extract params -> new to_player; else return Send(playerid, -1, "USAGE: /checkgun [playerid]");
	if(!IsPlayerConnected(to_player)) return SCM(playerid, -1, "Pemain tidak konek!");
	if(!PlayerInfo[to_player][pLogin]) return SCM(playerid, COLOR_GREY, "Tidak ada pemain yang ditemukan!");
	SCMF(playerid, 0xFFFF00FF, "---- %s's guns ----", Name(to_player));
	for(new i; i < 13; i++) {
		GetPlayerWeaponData(to_player, i, PlayerInfo[to_player][pGun][i], PlayerInfo[to_player][pAmmo][i]);
		if(PlayerInfo[to_player][pGun][i] > 0) {
			SCMF(playerid, -1, "%s - %i ammo", GetWeaponNames(PlayerInfo[to_player][pGun][i]), PlayerInfo[to_player][pAmmo][i]);
		}
	}
	return 1;
}
CMD:usee(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 4) return Error(playerid, "Anda harus level 4 untuk akses lemari ini.");
    for(new i = 0; i < sizeof(YogInfo); i++)
	{
		if(PlayerToPoint(3.0, playerid, YogInfo[i][YStoreX],YogInfo[i][YStoreY],YogInfo[i][YStoreZ]) && GetPlayerInterior(playerid) == YogInfo[i][YInt] && GetPlayerVirtualWorld(playerid) == YogInfo[i][YVw])
		{
			Dialog(playerid, 1053,DIALOG_STYLE_MSGBOX,
			"Lemari Barang",
			"{ffff00}PERHATIAN{ffffff}\n\
			Untuk Menyimpan Barang Dilemari Rumah\n\
			Pastikan Pintu Rumah Anda Selalu Terkunci Untuk Menghindari Pencurian",
			"Oke",""
			);
		}
    }
    return 1;
}
CMD:clemari(playerid, params[])
{
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    if(GetPlayerMoney(playerid) < 10000) return SCM(playerid, COLOR_GREY, "Uang anda tidak cukup!");
    PlayerInfo[playerid][pCash] -= 10000;
	GivePlayerMoneyEx(playerid, -10000);
	OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
 	SendClientMessage(playerid, COLOR_YELLOW, "[NORP] Anda Telah Membuat Lemari ");
	GameTextForPlayer(playerid, "-10000", 5000, 1);
	
	// new h_id = player_enter_home[playerid];
	new Float: YPos[3], string[254];
	new id = YogValid();
	GetPlayerPos(playerid, YPos[0], YPos[1], YPos[2]);
	IdYog[id] = 1;
	YogInfo[id][YStoreX] = YPos[0];
	YogInfo[id][YStoreY] = YPos[1];
	YogInfo[id][YStoreZ] = YPos[2];
	YogInfo[id][YVw] = GetPlayerVirtualWorld(playerid);
	YogInfo[id][YInt] = GetPlayerInterior(playerid);

	format(string, sizeof(string), "Lemari ID: %d\n{FFFFFF}Gunakan /use", id);
	YogInfo[id][YLabel] = CreateDynamic3DTextLabel(string, COLOR_YELLOW, YogInfo[id][YStoreX], YogInfo[id][YStoreY], YogInfo[id][YStoreZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, YogInfo[id][YVw], YogInfo[id][YInt]);
	SetPlayerPos(playerid, YPos[0], YPos[1], YPos[2]+1);
	SaveYog();
	return 1;
}
CMD:dlemari(playerid, params[])
{
	if(admin_level[playerid] < 3) return 1;
    if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Usage: /dlemari [id lemari]");
	new file[128];
    IdYog[params[0]] = 0;
    YogInfo[params[0]][YTshirt] = 0;
    YogInfo[params[0]][YDrugs] = 0;
    YogInfo[params[0]][YGun] = 0;
    YogInfo[params[0]][YAmmo] = 0;
    YogInfo[params[0]][YCompo] = 0;
	YogInfo[params[0]][YStoreX] = 0.0;
	YogInfo[params[0]][YStoreY] = 0.0;
	YogInfo[params[0]][YStoreZ] = 0.0;
    YogInfo[params[0]][YVw] = 0;
    YogInfo[params[0]][YInt] = 0;
    DestroyDynamic3DTextLabel(YogInfo[params[0]][YLabel]);
    SendClientMessage(playerid, COLOR_WHITE, "Berhasil Menghapus Lemari");
    SaveYog();
	format(file, sizeof(file), "YogLemari/%d.ini", params[0]);
	if(fexist(file)) fremove(file);
	return 1;
}
CMD:cursor(playerid, params[])
{
	SelectTextDraw(playerid, COLOR_YELLOW);
	return 1;
}
CMD:tasplayer(playerid, params[])
{
    if(admin_level[playerid] < 1 ||!admin_logged[playerid]) return 1;
    new targetid;
    if(sscanf(params, "u", targetid))
    {
        SendClientMessage(playerid, -1, "Penggunaan: /items [id pemain]");
        return 1;
    }
    if(!IsPlayerConnected(targetid))
    {
        SendClientMessage(playerid, -1, "Pemain tidak ditemukan!");
        return 1;
    }
    PlayerPlaySound(playerid, 5202, 0.0, 0.0, 0.0);
    new ilham[2048];
    new szItem[128];
    new String[128];
    strcat(ilham, "Item\tJumlah\n");

    // Uang & KTP
    if (GetPlayerMoney(targetid) > 0) {
    // Ganti %s menjadi %d, dan panggil GetPlayerMoney secara langsung
    format(szItem, sizeof(szItem), "Uang\t{00FF00}$%d\n", GetPlayerMoney(targetid));
    strcat(ilham, szItem);
}
    if (PlayerInfo[targetid][pKtp] > 0) {
        format(szItem, sizeof(szItem), "KTP\t%d\n", PlayerInfo[targetid][pKtp]);
        strcat(ilham, szItem);
    }

    // Item Ilegal
    if (PlayerInfo[targetid][pDrugs] > 0) {
        format(szItem, sizeof(szItem), "{FF0000}Drugs\t{FF0000}%d\n", PlayerInfo[targetid][pDrugs]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pCrack] > 0) {
        format(szItem, sizeof(szItem), "{FF0000}Crack\t{FF0000}%d\n", PlayerInfo[targetid][pCrack]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pMetall] > 0) {
