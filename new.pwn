}
CMD:buattoko(playerid, params[])
{
    if(admin_level[playerid] < 10)
        return SendClientMessage(playerid,-1,"Anda bukan admin!");

    new type[24], price;
    if(sscanf(params,"sd",type,price))
        return SendClientMessage(playerid,-1,"Gunakan: /createbizz [toko/resto/clothes] [harga]");

    new btype, interior;
    new Float:exitx, Float:exity, Float:exitz;
    new Float:barx, Float:bary, Float:barz;
    new message[32];

    if(!strcmp(type,"toko",true))
    {
        btype = 1;
        interior = 17;

        exitx = -25.884;
        exity = -185.868;
        exitz = 1003.546;

        barx = -22.2396;
        bary = -138.626;
        barz = 1003.55;

        format(message,sizeof(message),"24/7 Store");
    }
    else if(!strcmp(type,"resto",true))
    {
        btype = 2;
        interior = 10;

        exitx = -25.9404;
        exity = -141.564;
        exitz = 1003.55;

        barx = -22.2396;
        bary = -138.626;
        barz = 1003.55;

        format(message,sizeof(message),"Restaurant");
    }
    else if(!strcmp(type,"clothes",true))
    {
        btype = 6;
        interior = 15;

        exitx = 207.74;
        exity = -111.26;
        exitz = 1005.13;

        barx = 207.74;
        bary = -109.01;
        barz = 1005.13;

        format(message,sizeof(message),"Clothes Shop");
    }
    else
    {
        return SendClientMessage(playerid,-1,"Type bizz tidak ada! (toko/resto/clothes)");
    }

    new Float:x,Float:y,Float:z;
    GetPlayerPos(playerid,x,y,z);

    new query[1024];
    mysql_format(mMysql,query,sizeof(query),
    "INSERT INTO `bizz` \
    (`bID`,`bOwned`,`bOwner`,`bMessage`,`bEntranceX`,`bEntranceY`,`bEntranceZ`,`bExitX`,`bExitY`,`bExitZ`,`bBuyPrice`,`bEntranceCost`,`bMoney`,`bRaschet`,`bLocked`,`bInterior`,`bProducts`,`bPrice`,`bBarX`,`bBarY`,`bBarZ`,`bMafia`,`bType`,`bVirtualWorld`,`bOplata`,`bSlet`,`bArenda`,`bUpdMusic`,`bUpdHeal`,`bUpdSub`,`bSotrud`,`bSklad`,`bPhone`,`bProcent`) \
    VALUES (%d,0,'None','%s',%f,%f,%f,%f,%f,%f,%d,0,0,0,0,%d,5,500,%f,%f,%f,17,%d,%d,17,0,700,0,0,0,0,1000,0,0)",
    TotalBizz+1,message,x,y,z,exitx,exity,exitz,price,interior,barx,bary,barz,btype,TotalBizz+1);

    mysql_query(mMysql,query);
    LoadBizz();

    SendClientMessage(playerid,-1,"Bisnis berhasil dibuat.");
    return 1;
}
CMD:createtoko(playerid, params[])
{
    if(admin_level[playerid] < 10) return 1;

    new type[16], price;
    if(sscanf(params, "s[16]d", type, price))
    {
        SendClientMessage(playerid,-1,"Gunakan: /createbizz [toko/resto/clothes/tool] [harga]");
        return 1;
    }

    if(!strcmp(type,"clothes",true))
    {
        return callcmd::bizzclothes(playerid,"");
    }

    else if(!strcmp(type,"resto",true))
    {
        return callcmd::bizzresto(playerid,"");
    }

    else if(!strcmp(type,"toko",true))
    {
        return callcmd::bizztoko(playerid,"");
    }

    else if(!strcmp(type,"tool",true))
    {
        return callcmd::bizztool(playerid,"");
    }

    else
    {
        SendClientMessage(playerid,-1,"Type tidak ada! (toko/resto/clothes/tool)");
    }

    return 1;
}

CMD:editbizz(playerid, params[])
{
    if(admin_level[playerid] < 10) return 1;

    new option[16], value[64];

    if(sscanf(params, "s[16]S()[64]", option, value))
        return SendClientMessage(playerid, -1, "/editbizz [nama/harga/tempat/hapus] [value]");

    for(new i; i < MAX_BIZZ; i++)
    {
        if(!IsPlayerNearPoint(playerid, 10.0,
        BizzInfo[i][bEntranceX],
        BizzInfo[i][bEntranceY],
        BizzInfo[i][bEntranceZ])) continue;

        if(!strcmp(option, "nama", true))
        {
            format(BizzInfo[i][bMessage], 64, "%s", value);

            mysql_format(mMysql, MySQLStr, sizeof(MySQLStr),
            "UPDATE `bizz` SET `bMessage`='%e' WHERE `bID`=%d",
            value, i);

            mysql_tquery(mMysql, MySQLStr);

            SendClientMessage(playerid, -1, "Nama bisnis berhasil diubah.");
            return 1;
        }

        if(!strcmp(option, "harga", true))
        {
            new price = strval(value);

            BizzInfo[i][bBuyPrice] = price;

            SaveBizzPer(i, "bBuyPrice", price);

            SendClientMessage(playerid, -1, "Harga bisnis berhasil diubah.");
            return 1;
        }

        if(!strcmp(option, "tempat", true))
        {
            GetPlayerPos(playerid,
            BizzInfo[i][bEntranceX],
            BizzInfo[i][bEntranceY],
            BizzInfo[i][bEntranceZ]);

            SaveBizz(i);

            SendClientMessage(playerid, -1, "Lokasi bisnis dipindah.");
            return 1;
        }

        if(!strcmp(option, "hapus", true))
        {
            BizzInfo[i][bOwned] = 0;
            format(BizzInfo[i][bOwner], 32, "None");

            SaveBizz(i);

            SendClientMessage(playerid, -1, "Bisnis berhasil direset.");
            return 1;
        }
    }

    SendClientMessage(playerid, -1, "Tidak ada bisnis di dekat Anda.");
    return 1;
}
stock IsPlayerNearPoint(playerid, Float:range, Float:x, Float:y, Float:z)
{
    new Float:px, Float:py, Float:pz;
    GetPlayerPos(playerid, px, py, pz);

    if(VectorSize(px - x, py - y, pz - z) <= range)
        return 1;

    return 0;
}
