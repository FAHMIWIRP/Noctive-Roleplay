		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pCrack] -= amount; OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pCrack]);
		        PlayerInfo[otherid][pCrack] += amount; OnPlayerUpdateAccountsPer(otherid, "pCrack", PlayerInfo[otherid][pCrack]);
		        ShowItemNotification(playerid, false, "Crack", amount); ShowItemNotification(otherid, true, "Crack", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Crack."); ShowPanjulNotif(otherid, "Menerima Crack.");
		        Info(playerid, "Anda telah berhasil memberikan Crack kepada %s sejumlah %dGram.", ReturnName(otherid), amount);
		        Info(otherid, "%s telah berhasil memberikan Crack kepada anda sejumlah %dGram.", ReturnName(playerid), amount);
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "marijuana", true) == 0)
		    {
		        if(amount > PlayerInfo[playerid][pMicin]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup marijuana");
		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pMicin] -= amount; OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
		        PlayerInfo[otherid][pMicin] += amount; OnPlayerUpdateAccountsPer(otherid, "pMicin", PlayerInfo[otherid][pMicin]);
		        ShowItemNotification(playerid, false, "Marijuana", amount); ShowItemNotification(otherid, true, "Marijuana", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Marijuana."); ShowPanjulNotif(otherid, "Menerima Marijuana.");
		        Info(playerid, "Anda telah berhasil memberikan marijuana kepada %s sejumlah %d.", ReturnName(otherid), amount);
