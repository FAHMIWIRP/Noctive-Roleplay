    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
	return dialog_anticheat(playerid);
}
CMD:createvoucher(playerid, params[])
{
	if(admin_level[playerid] < 12)
		return PermissionError(playerid);

	new voucid = Iter_Free(Vouchers), query[128];
	if(voucid == -1) return Error(playerid, "You cant create more voucher!");
	new code, vip, viptime, gold;
	if(sscanf(params, "dddd", code, vip, viptime, gold)) return Info(playerid, "/createvoucher [CODE(73821)] [VIP] [VIP-TIME(Days)] [GOLD]");
	if(code < 10000 || code > 99999) return Error(playerid, "Invalid code 10000-99999");
	if(vip < 0 || vip > 3) return Error(playerid, "Invalid vip 0-3.");
	if(viptime < 0 || viptime > 60) return Error(playerid, "Invalid vip time 0 - 60 days.");
	if(gold < 0 || gold > 50) return Error(playerid, "Invalid gold 0-50.");
	foreach(new vo : Vouchers)
	{
		if(VoucData[vo][voucCode] == code)
		{
			return Error(playerid, "Voucher code already registered! try another code!");
		}
	}

	VoucData[voucid][voucCode] = code;
	VoucData[voucid][voucVIP] = vip;
	VoucData[voucid][voucVIPTime] = viptime;
	VoucData[voucid][voucGold] = gold;
	format(VoucData[voucid][voucAdmin], 16, pData[playerid][pAname]);
	format(VoucData[voucid][voucDonature], 16, "None");
	VoucData[voucid][voucClaim] = 0;
	Iter_Add(Vouchers, voucid);

	mysql_format(mMysql, query, sizeof(query), "INSERT INTO vouchers SET id='%d', code='%d', vip='%d', vip_time='%d', gold='%d', admin='%s'", voucid, VoucData[voucid][voucCode], VoucData[voucid][voucVIP], VoucData[voucid][voucVIPTime], VoucData[voucid][voucGold], pData[playerid][pAname]);
	mysql_tquery(mMysql, query, "OnVoucherCreated", "i", voucid);

	Servers(playerid, "Voucher created id: %d | code: %d | vip: %d | vip-time: %d | gold: %d | admin: %s", voucid, VoucData[voucid][voucCode], VoucData[voucid][voucVIP], VoucData[voucid][voucVIPTime], VoucData[voucid][voucGold], pData[playerid][pAname]);
	return 1;
}

epublic: OnVoucherCreated(voucid)
{
	Voucher_Save(voucid);
	return 1;
}

CMD:voucher(playerid, params[])
{
	new code;
	if(sscanf(params, "d", code)) return Info(playerid, "/voucher [CODE]");

	foreach(new vo : Vouchers)
	{
		if(VoucData[vo][voucCode] == code)
		{
			if(VoucData[vo][voucClaim] == 0)
			{
				if(VoucData[vo][voucVIP] == 0)
				{
					pData[playerid][pRouble] += VoucData[vo][voucGold];

					VoucData[vo][voucClaim] = 1;
					format(VoucData[vo][voucDonature], 16, pData[playerid][pName]);
					Voucher_Save(vo);

					Info(playerid, "Voucher claimed. gold: %d | claimby: %s.", VoucData[vo][voucGold], pData[playerid][pName]);
				}
				else
				{
					new dayz = VoucData[vo][voucVIPTime];
					pData[playerid][pRouble] += VoucData[vo][voucGold];
					pData[playerid][pVip] = VoucData[vo][voucVIP];
					pData[playerid][pVipTime] = gettime() + (dayz * 86400);

					VoucData[vo][voucClaim] = 1;
					format(VoucData[vo][voucDonature], 16, pData[playerid][pName]);
					Voucher_Save(vo);

					Info(playerid, "Voucher claimed. VIP: %d | VIP TIME: %d days | gold: %d | claimby: %s.", VoucData[vo][voucVIP], dayz, VoucData[vo][voucGold], pData[playerid][pName]);
				}
			}
			else return Error(playerid, "Voucher has been expired!");
		}
	}
	return 1;
}
CMD:getv(playerid, params[])
{
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

	extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /getv [id pemain]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");

	new u_car = PlayerInfo[to_player][pUseCar];
	new vehicleid = player_home_car[to_player][u_car];
	if(vehicleid == INVALID_VEHICLE_ID)
		return SendClientMessage(playerid, 0xCECECEFF, "Kendaraan pemain belum di spawn");

	new fmt_text[105],
		Float: x,
		Float: y,
		Float: z;

	GetPlayerPos(to_player, x, y, z);

	SetVehiclePos(vehicleid, x + 2.0, y + 2.0, z);

	format(fmt_text, sizeof fmt_text, "Anda teleport %s ke transportasi pribadinya", GetPlayerNameEx(to_player));
	SendClientMessage(playerid, -1, fmt_text);

	format(fmt_text, sizeof(fmt_text), "Admin %s teleport transportasi pribadi Anda", GetPlayerNameEx(playerid));
	SendClientMessage(to_player, -1, fmt_text);

	return 1;
}
CMD:logpay(playerid)
{
    if(admin_level[playerid] < 1) return PermissionError(playerid);

    if(pData[playerid][pLogPay] == 0)
    {
        pData[playerid][pLogPay] = 1;
        Info(playerid, "Anda berhasil menghidupkan logs transfer money");
    }
    else
    {
        pData[playerid][pLogPay] = 0;
        Info(playerid, "Anda berhasil mematikan logs transfer money");
    }
    return 1;
}

CMD:saveme(playerid, params[])
{
    SendClientMessageEx(playerid, COLOR_WHITE," Data anda telah di save ke database");
    OnPlayerLoadAccounts(playerid);
}

CMD:rolldice(playerid, params[]) {
	extract params -> new jml_dadu; else return SCM(playerid, 0xCECECEFF, "Gunakan: /rolldice [1-4]");
	if(jml_dadu < 1 || jml_dadu > 4) return SCM(playerid, 0xCECECEFF, "Gunakan: /rolldice [1-4]");

	new strOne[128];
	new strDadu[20];

	switch(jml_dadu) {
		case 1: format(strDadu, sizeof(strDadu), "%i", random(6) + 1);
		case 2: format(strDadu, sizeof(strDadu), "%i-%i", random(6) + 1, random(6) + 1);
		case 3: format(strDadu, sizeof(strDadu), "%i-%i-%i", random(6) + 1, random(6) + 1, random(6) + 1);
		case 4: format(strDadu, sizeof(strDadu), "%i-%i-%i-%i", random(6) + 1, random(6) + 1, random(6) + 1, random(6) + 1);
	}

	format(strOne, 188, "%s mengocok %i buah dadu", Name(playerid), jml_dadu);
	ProxDetector(20.0, playerid, strOne, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	format(strOne, 188, "Hasil: {FF6347}%s{DD90FF} (%s)", strDadu, Name(playerid));
	ProxDetector(20.0, playerid, strOne, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
	return 1;
}

