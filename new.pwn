CMD:repaintws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                extract params -> new to_player, color_1, color_2, money; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /repaintcar [id pemain] [cat 1] [cat 2] [biaya]");
                if(!(0 <= color_1 <= 255) || !(0 <= color_2 <= 255)) return SendClientMessage(playerid, 0xCECECEFF, "Nomor cat: 0 - 255");
                if(IsAMech(playerid) || PlayerInfo[playerid][pMember])

                if(!ProxDetectorS(5.0, playerid, to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");

                if(!ProxDetectorS(5.0, playerid, to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pemainnya terlalu jauh");

                if(!IsPlayerDriver(to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");

                if(money < 1 || money > 100000) return SendClientMessage(playerid, 0xCECECEFF,"Dari $1 hingga $100.000");

                if(money > PlayerInfo[to_player][pCash]) return SendClientMessage(playerid, 0xCECECEFF, "Pemain tidak memiliki dana yang cukup");

                SendPlayerOffer(playerid, to_player, OFFER_TYPE_PAINTCAR, color_1, color_2, money);

                SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s mengubah warna kendaraan. Tawaran: $%i", GetPlayerNameEx(to_player), money);
                SCMF(to_player, 0x6BB3FFAA, "%s menyarankan untuk mengubah warna kendaraan. Tawaran: $%i", GetPlayerNameEx(playerid), money);
                SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
            }
        }
    }
    return 1;
}

forward OnTuneLoad(playerid, idx);
public OnTuneLoad(playerid, idx)
{
    switch (idx)
    {
        case 0:
        {
            new dialog_info[128], part_name[15];

            for (new i, j = cache_num_rows(); i != j; i++)
            {
                cache_get_value(i, 0, part_name);

                strcat(dialog_info, part_name);
                strcat(dialog_info, "\n");
            }

            ShowPlayerDialog(playerid, DIALOG_TUNE, DIALOG_STYLE_LIST, "Available Parts", dialog_info, "Select", "Cancel");
        }
        case 1:
        {
            if (cache_num_rows())
            {
                new dialog_info[128], part_name[14], num_fields;

                cache_get_field_count(num_fields);

                for (new i; i != num_fields; i++)
                {
                    cache_get_value(0, i, part_name);

                    if (!isnull(part_name))
                    {
                        strcat(dialog_info, part_name);
                        strcat(dialog_info, "\n");
                    }
                }

                ShowPlayerDialog(playerid, DIALOG_TUNE, DIALOG_STYLE_LIST, "Available Parts", dialog_info, "Select", "Cancel");
            }
            else SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
        }
        case 2:
        {
                    static dialog_info[716];
                    new componentid, type[22];

                    // dialog_info = "{FF0000}Component ID\t{FF8000}Type\n";
                    dialog_info = "";

                    for (new i, j = cache_num_rows(); i != j; i++)
                    {
                            cache_get_value_int(i, 0, componentid);
                            cache_get_value(i, 1, type);

                            format(dialog_info, sizeof dialog_info, "%s%i\t%s\n", dialog_info, componentid, type);
                    }

                    if (componentid == 1087) strcat(dialog_info, "D 1087\tRemove Hydraulics");

                    ShowPlayerDialog(playerid, DIALOG_TUNE_2, DIALOG_STYLE_TABLIST, "Available Components", dialog_info, "Install", "Back");
        }
    }
}

CMD:tune(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                extract params -> new to_player; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /tune [playerid]");

				if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))	return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");

                if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, 0xCECECEFF, "Pemain terlalu jauh");

                if(!IsPlayerDriver(to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pemain harus mengemudi");

                new use_car = GetPlayerUseHomeCar(to_player);
                if(use_car == -1) return SendClientMessage(playerid, 0xCECECEFF, "Pemain tidak berada dalam transportasi pribadi");

                SetPVarInt(playerid, "P_MODIF_TO", to_player);

                new modelid = GetVehicleModel(GetPlayerVehicleID(to_player));

                switch (modelid)
                {
                        case 534 .. 536, 558 .. 562, 565, 567, 575, 576:
                        {
                                new Query[76];
                                mysql_format(mMysql, Query, sizeof Query, "SELECT part FROM vehicle_components WHERE cars=%i OR cars=-1 GROUP BY part", modelid);
                                mysql_tquery(mMysql, Query, "OnTuneLoad", "ii", playerid, 0);
                        }
                        default:
                        {
                                static Query[400];

                                mysql_format(mMysql, Query, sizeof Query,
                                "SELECT " \
                                "IF(parts & 1 <> 0,'Exhausts','')," \
                                "IF(parts & 2 <> 0,'Hood','')," \
                                "IF(parts & 4 <> 0,'Hydraulics','')," \
                                "IF(parts & 8 <> 0,'Lights','')," \
                                "IF(parts & 16 <> 0,'Roof','')," \
                                "IF(parts & 32 <> 0,'Side Skirts','')," \
                                "IF(parts & 64 <> 0,'Spoilers','')," \
                                "IF(parts & 128 <> 0,'Vents','')," \
                                "IF(parts & 256 <> 0,'Wheels',''), " \
                                "IF(parts & 4 <> 0,'Nitro','') " \
                                "FROM vehicle_model_parts WHERE modelid=%i", modelid);
                                mysql_tquery(mMysql, Query, "OnTuneLoad", "ii", playerid, 1);
                        }
                }

            }
        }
    }
    return 1;
}

CMD:addnitro(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                new otherid;
                if(sscanf(params, "u", otherid))
                    return Info(playerid, "/addnitro [id player]");

                if(otherid == INVALID_PLAYER_ID)
                    return Error(playerid, "Player disconnect");

                if(!IsPlayerDriver(otherid))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");

                pData[playerid][pTarget] = otherid;
                ShowPlayerDialog(playerid, DIALOG_ADDNITRO, DIALOG_STYLE_LIST, "Nitro Vehicle", "Nitro 2x\nNitro 5x\nNitro 10x", "Select", "Cancel");
            }
        }
    }
    return 1;
}
CMD:modifws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                extract params -> new pembeli, compo; else return SendClientMessage(playerid, -1, "/addcompo [ID Pemain] [ID Component]");

                if(!(1000 <= compo <= 1193)) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFFID Component Salah {FFFF00}(1000 - 1193)");

                if(!ProxDetectorS(5.0, playerid, pembeli))
                    return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemainnya Terlalu Jauh");
                if(!IsPlayerDriver(pembeli))
                    return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Mengemudi");

                new u_car = GetPlayerUseHomeCar(pembeli);

                if(u_car == -1)
                    return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Menggunakan Mobil Pribadi");

                SetPlayerUseListitem(pembeli, u_car);

                new u_car_0 = GetPlayerUseListitem(pembeli);
                new vehicleid = GetPlayerVehicleID(pembeli);

                switch(compo)
                {
                    case 1000..1003,1014..1016,1023,1049,1050,1058,1060,1138,1139,1146,1147,1158,1162..1164: CarInfo[pembeli][cSpoiler][u_car_0] = compo;
                    case 1004,1005,1011,1012: CarInfo[pembeli][cHood][u_car_0] = compo;
                    case 1007,1017,1026,1027,1030,1031,1036,1039..1042,1047,1048,1051,1052,1056,1057,1062,1063,1069,1072,1090,1093..1095,1099,1101,1102,1106..1108,1119..1122,1124,1133,1134,1137: CarInfo[pembeli][cSideskirt][u_car_0] = compo;
                    case 1008..1010: CarInfo[pembeli][cNitro][u_car_0] = compo;
                    case 1013,1024: CarInfo[pembeli][cLamps][u_car_0] = compo;
                    case 1018..1022,1028,1029,1034,1037,1043..1046,1059,1064.1066,1089,1092,1105,1113,1114,1126,1127,1129,1132,1135,1136:CarInfo[pembeli][cExhaust][u_car_0] = compo;
                    case 1025,1073..1085,1096..1098:CarInfo[pembeli][cWheels][u_car_0] = compo;
                    case 1006,1032,1033,1035,1038,1053..1055,1061,1067,1068,1088,1091,1103,1128,1130,1131: CarInfo[pembeli][cRoof][u_car_0] = compo;
                    case 1086: CarInfo[pembeli][cStereo][u_car_0] = compo;
                    case 1087: CarInfo[pembeli][cHydrawlic][u_car_0] = compo;
                    //ashiap
                    case 1117,1152,1153,1155,1157,1160,1165,1166,1169..1174,1176,1179,1181,1182,1185,1188..1191: CarInfo[pembeli][cBumper1][u_car_0] = compo;
                    case 1140,1141,1148..1151,1154,1156,1159,1161,1167,1168,1175,1177,1178,1180,1183,1184,1186,1187,1192,1193: CarInfo[pembeli][cBumper2][u_car_0] = compo;
                    case 1142..1145: CarInfo[pembeli][cVentRight][u_car_0] = compo;

                }
                AddVehicleComponent(vehicleid, compo);

                SaveCars(pembeli);
            }
        }
    }
    return 1;
}

CMD:repairws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                new vehicleid = GetPlayerVehicleID(playerid);
                if(PlayerInfo[playerid][pComponent] < 15) return SCM(playerid, COLOR_GREY, "Component Anda Tidak Cukup");
                if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
                RepairVehicle(GetPlayerVehicleID(playerid));
                SetVehicleHealth(vehicleid, 1000.0);
                SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
                PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
            }
        }
    }
    return 1;
}

CMD:repaintjobws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                if(!PlayerInfo[playerid][pMember]) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

                extract params -> new to_player, repaint_number, money; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /repaintjob [id pemain] [nomor cat] [biaya]");
                if(!(0 <= repaint_number <= 3)) return SendClientMessage(playerid, 0xCECECEFF, "ID Repaint 0 - 3");
                if(money < 1 || money > 5000000) return SendClientMessage(playerid, 0xB4B5B7FF,"dari 1 hingga 5.000.000");
                if(PlayerInfo[playerid][pComponent] < 20) return SCM(playerid, COLOR_GREY, "Component Anda Tidak Cukup");

                if(!ProxDetectorS(5.0, playerid, to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");

                if(!ProxDetectorS(5.0, playerid, to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pemainnya terlalu jauh");

                if(!IsPlayerDriver(to_player))
                    return SendClientMessage(playerid, 0xCECECEFF, "Pelanggan harus mengemudi");

                if(PlayerInfo[to_player][pCash] < money)
                    return SendClientMessage(playerid, 0x999999FF, "Pemain tidak memiliki jumlah uang");

                SendPlayerOffer(playerid, to_player, OFFER_TYPE_PAINTJOB, repaint_number, money);
                return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");

            }
        }
    }
    return 1;
}

CMD:copotpaintjobws(playerid, params[])
{
    foreach(new idx : Workshop)
    {
        if(IsPlayerInRangeOfPoint(playerid, 80.0, wsData[idx][wX], wsData[idx][wY], wsData[idx][wZ]))
        {
            if(IsWorkshopOwner(playerid, idx) || IsWorkshopEmploye(playerid, idx))
            {
                extract params -> new pembeli; else return SendClientMessage(playerid, -1, "/copotpaintjob [ID Pemain]");

                if(PlayerInfo[playerid][pComponent] < 23) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Component Anda Tidak Cukup, Butuh 23");
                //if(sscanf(params, "ddd",params[0],params[1],params[2],params[3])) return SCM(playerid,COLOR_WHITE,"Masukkan: /changecolor [id pemain][id warna 1][id warna 2][slot]");

                if(!IsPlayerDriver(pembeli))
                    return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Mengemudi");

                new u_car = GetPlayerUseHomeCar(pembeli);

                if(u_car == -1)
                    return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Menggunakan Mobil Pribadi");

                SetPlayerUseListitem(pembeli, u_car);

                new u_car_0 = GetPlayerUseListitem(pembeli);
                new vehicleid = GetPlayerVehicleID(pembeli);

                CarInfo[pembeli][cPaintJobs][u_car_0] = 255;

                ChangeVehiclePaintjob(vehicleid, 255);
                SaveCars(pembeli);

                PlayerInfo[playerid][pComponent] -= 23;
                OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
            }
        }
    }
    return 1;
}

CMD:deletepcar(playerid, params[])
{
	if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
	extract params -> new to_player, slot; else return SCM(playerid, -1, "Gunakan: /deletepcar [id pemain] [slot]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
	if(slot < 1 || slot > 5) return SCM(playerid, COLOR_GREY, "Slot dari 1 ke 5");
	slot--;
	if(CarInfo[to_player][cModel][slot] == 0) return SCM(playerid, COLOR_GREY, "Slot ini tidak digunakan..");

	new model = CarInfo[to_player][cModel][slot];

	new u_car = PlayerInfo[to_player][pUseCar];
	new vehicleid = player_home_car[to_player][u_car];
	if(vehicleid != INVALID_VEHICLE_ID && GetVehicleModel(vehicleid) == model) DestroyVehicleEx(vehicleid);

	strmid(VehicleNumberPlate[to_player][slot],"None", 0, strlen("None"), 9);
	CarInfo[to_player][cSost][slot] = 100, CarInfo[to_player][cFuel][slot] = float(100), CarInfo[to_player][cColor1][slot] = 1, CarInfo[to_player][cColor2][slot] = 1;
	CarInfo[to_player][cModel][slot] = 0, CarInfo[to_player][cCost][slot] = 0, CarInfo[to_player][cLock][slot] = 0, CarInfo[to_player][cProbeg][slot] = float(0);

	player_home_car[to_player][slot] = INVALID_VEHICLE_ID;

	for(new i; i < 5; i++) player_engine_tune[to_player][slot][i] = player_brake_tune[to_player][slot][i] = 0;

	SavePlayerPerfomanceTune(to_player);

	CarInfo[to_player][cHeal][slot] = float(1000);
	CarInfo[to_player][cDamagePanel][slot] = 0;
	CarInfo[to_player][cDamageDoors][slot] = 0;
	CarInfo[to_player][cDamageLights][slot] = 0;
	CarInfo[to_player][cDamageTires][slot] = 0;

	CompVehDel(to_player);
	SaveCars(to_player);
	SCMF(playerid, -1, "Kamu menghapus kendaraan %s (%s) (slot: %i)", Name(to_player), VehicleNames[model-400], slot + 1);
	SCMF(to_player, -1, "Kendaraanmu %s (slot: %i) telah dihapus", VehicleNames[model-400], slot + 1);
	return 1;
}
