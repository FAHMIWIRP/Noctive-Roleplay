forward HideNotify(playerid);
public HideNotify(playerid)
{
	if(!IndexNotify[playerid]) return 1;
	--IndexNotify[playerid];
	MaxPlayerNotify[playerid]--;
	for(new i=-1;++i<10;) PlayerTextDrawDestroy(playerid, TextDrawNotifikasi[playerid][(IndexNotify[playerid]*10)+i]);
	return 1;
}

forward LoadHotels();
public LoadHotels()
{
	new rows;
	cache_get_row_count(rows);

	if(!rows) return 1;

	new h_id, floor;

	for(new i = 0; i < MAX_HOTELS; i++)
	{
		cache_get_value_name(i, "hOwner", hotel_info[i][hOwner]);

        cache_get_value_name_int(i, "hOwned", hotel_info[i][hOwned]);
        cache_get_value_name_int(i, "hRentTime", hotel_info[i][hRentTime]);
        cache_get_value_name_int(i, "hLock", hotel_info[i][hLock]);
        cache_get_value_name_int(i, "hPrice", hotel_info[i][hPrice]);

        hotel_info[i][hNumber] = h_id;
        hotel_info[i][hFloor] = floor;

        g_entrance_flat[floor][h_id] = i;

        //printf("HT: [%i] [%i] = %i", floor, h_id, i);

        hotel_info[i][h3D] = CreateDynamic3DTextLabel("-", -1, hotel_enter_pos[h_id][0], hotel_enter_pos[h_id][1], hotel_enter_pos[h_id][2], 3.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, floor, 15);
		UpdateHotel3DTextLabel(i);

        if(h_id == MAX_HOTEL_FLOOR_ROOMS - 1)
		{
			h_id = 0;
			floor++;
		}
		else h_id++;
	}

    for(new i; i < MAX_HOTEL_FLOOR_ROOMS; i++)
	{
        hotel_areas[i] = CreateDynamicSphere(hotel_enter_pos[i][0], hotel_enter_pos[i][1], hotel_enter_pos[i][2], 1.0, -1);
        CreateDynamicPickup(19132, 23, hotel_enter_pos[i][0], hotel_enter_pos[i][1], hotel_enter_pos[i][2], -1);
	}

    hotel_reception_area = CreateDynamicSphere(1650.5531,-162.7109,1208.6240, 1.5, 0);
    CreateDynamicPickup(1239, 23, 1650.5531,-162.7109,1208.6240, 0);
    CreateDynamic3DTextLabel("Penerimaan", -1, 1650.5531,-162.7109,1208.6240, 5.0);

    hotel_lift = CreateDynamicSphere(1653.2905,-184.0163,1208.6240, 1.5, -1);
    CreateDynamicPickup(1239, 23, 1653.2905,-184.0163,1208.6240, -1);

    CreateDynamic3DTextLabel("Lift\nLantai 1", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0);
    CreateDynamic3DTextLabel("Lift\nLantai 2", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 1);
    CreateDynamic3DTextLabel("Lift\nLantai 3", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 2);
    CreateDynamic3DTextLabel("Lift\nLantai 4", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 3);
    CreateDynamic3DTextLabel("Lift\nLantai 5", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 3);
    CreateDynamic3DTextLabel("Lift\nLantai 6", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 3);
    CreateDynamic3DTextLabel("Lift\nLantai 7", -1, 1653.2905,-184.0163,1208.6240, 5.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 3);

    CreateDynamic3DTextLabel("Untuk keluar dari kamar, gunakan:\n/exit",0xFFFFFFFF,1401.1575,-1205.0364,130.1886, 10.0);

	return printf("[MySQL R41-3]: Hotel dimuat: %i pcs.", MAX_HOTELS);
}

publics: LoadHouse()
{
	new rows;
	cache_get_row_count(rows);

	new result_string[96];

	if(rows)
	{
	    for(new i = 0; i < MAX_HOUSES; i++)
		{
		    cache_get_value_name_int(i, "hID", HouseInfo[i][hID]);
		    cache_get_value_name(i, "hOwner", HouseInfo[i][hOwner], 32);
		    cache_get_value_name_int(i, "hOwned", HouseInfo[i][hOwned]);
			cache_get_value_name_float(i, "hEntrancex", HouseInfo[i][hEntrancex]);
			cache_get_value_name_float(i, "hEntrancey", HouseInfo[i][hEntrancey]);
		    cache_get_value_name_float(i, "hEntrancez", HouseInfo[i][hEntrancez]);
			cache_get_value_name_float(i, "hCarx", HouseInfo[i][hCarx]);
			cache_get_value_name_float(i, "hCary", HouseInfo[i][hCary]);
			cache_get_value_name_float(i, "hCarz", HouseInfo[i][hCarz]);
			cache_get_value_name_float(i, "hCarc", HouseInfo[i][hCarc]);
            //
            cache_get_value_name_int(i, "hTakings", HouseInfo[i][hTakings]);
            cache_get_value_name_int(i, "hOplata", HouseInfo[i][hOplata]);
            cache_get_value_name_int(i, "hValue", HouseInfo[i][hValue]);
            cache_get_value_name_int(i, "hHel", HouseInfo[i][hHel]);
            cache_get_value_name_int(i, "hInt", HouseInfo[i][hInt]);
            cache_get_value_name_int(i, "hLock", HouseInfo[i][hLock]);
			cache_get_value_name_int(i, "hKlass", HouseInfo[i][hKlass]);
			cache_get_value_name_int(i, "hUpdAD", HouseInfo[i][hUpdAD]);
            cache_get_value_name_int(i, "hUpdHel", HouseInfo[i][hUpdHel]);
            cache_get_value_name_int(i, "hUpdSub", HouseInfo[i][hUpdSub]);
            cache_get_value_name_int(i, "hUpdStore", HouseInfo[i][hUpdStore]);

            if(HouseInfo[i][hUpdStore])
            {
                new Float: pos[3];

                cache_get_value_name(i, "hUpdStorePos", result_string);
                sscanf(result_string, "p<,>a<f>[3]", pos);

                CreateHouseStore(i, pos[0], pos[1], pos[2]);

                cache_get_value_name(i, "hWeaponID", result_string);
                sscanf(result_string, "p<,>a<i>[3]", HouseInfo[i][hWeaponID]);

                cache_get_value_name(i, "hAmmo", result_string);
                sscanf(result_string, "p<,>a<i>[3]", HouseInfo[i][hAmmo]); 

                cache_get_value_name_int(i, "hDrugs", HouseInfo[i][hDrugs]);
            }

            cache_get_value_name_float(i, "hHealpickX", HouseInfo[i][hHealpickX]);
            cache_get_value_name_float(i, "hHealpickY", HouseInfo[i][hHealpickY]);
            cache_get_value_name_float(i, "hHealpickZ", HouseInfo[i][hHealpickZ]);
           	cache_get_value_name_int(i, "hSlet", HouseInfo[i][hSlet]);

           	cache_get_value_name(i, "hLodgers", result_string);

           	SplitString(result_string, house_lodgers[i], ',');

           	if(HouseInfo[i][hSlet] != 0)
           	{
				format(format_string, 144, "UPDATE `accounts` SET `pBank` = `pBank` + %i WHERE `pName` = '%s'", HouseInfo[i][hValue] / 2, HouseInfo[i][hOwner]);
				mysql_tquery(mMysql, format_string);

				strmid(HouseInfo[i][hOwner], "None", 0, strlen("None"), 64);
			    HouseInfo[i][hOwned] = 0;
				HouseInfo[i][hHel] = 0;
				HouseInfo[i][hLock] = 0;
				HouseInfo[i][hUpdAD] = 0;
				HouseInfo[i][hUpdHel] = 0;
				HouseInfo[i][hUpdSub] = 0;
				HouseInfo[i][hUpdStore] = 0;
				HouseInfo[i][hSlet] = 0;
				HouseInfo[i][hOplata] = 0;

				DestroyHouseStore(i);

				SaveHouse(i);
           	}

           	if(HouseInfo[i][hOwned] == 0)
			{
				if(HouseInfo[i][hKlass] == 5) HouseInfo[i][hPickup] = CreatePickup(1273, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else HouseInfo[i][hPickup] = CreatePickup(1273, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				HouseInfo[i][hMIcon] = CreateDynamicMapIcon(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez], 31, -1, 0, -1, -1);
			}
            if(HouseInfo[i][hOwned] == 1)
			{
	    		if(HouseInfo[i][hSlet] == 2) HouseInfo[i][hPickup] = CreatePickup(1272, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else if(HouseInfo[i][hKlass] == 5) HouseInfo[i][hPickup] = CreatePickup(1272, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				else HouseInfo[i][hPickup] = CreatePickup(1272, 23, HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],-1);
				HouseInfo[i][hMIcon] = CreateDynamicMapIcon(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez], 32, -1, 0, -1, -1);
			}
			if(HouseInfo[i][hUpdHel] == 1)
			{
		 		HouseInfo[i][hAreaHeal] = CreateDynamicPickup(11738, 23, HouseInfo[i][hHealpickX], HouseInfo[i][hHealpickY], HouseInfo[i][hHealpickZ], i);
		 		format(String, 64, "{E5D81E}Kotak P3K: %d pcs.", HouseInfo[i][hHel]);
 				healtext[i] = CreateDynamic3DTextLabel(String,0xFFFFFFFF,HouseInfo[i][hHealpickX],HouseInfo[i][hHealpickY],HouseInfo[i][hHealpickZ]+0.5, 10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1, i);
 			}
 			new h_class = HouseInfo[i][hKlass];
			HouseInfo[i][hAreaExit] = CreateDynamicSphere(house_exit[h_class][0], house_exit[h_class][1], house_exit[h_class][2],3,i);
			HouseInfo[i][hAreaEnter] = CreateDynamicSphere(HouseInfo[i][hEntrancex], HouseInfo[i][hEntrancey], HouseInfo[i][hEntrancez],1.2,0);
		}
		printf("[MySQL R41-3]: Rumah dimuat: %i pcs.", MAX_HOUSES);
	}

	for(new i, z = sizeof house_exit; i < z; i++)
	{
	    CreateDynamic3DTextLabel("Untuk keluar dari rumah, gunakan:\n/exit",0xFFFFFFFF,house_exit[i][0],house_exit[i][1],house_exit[i][2], 10.0);
	}

	return 1;
}
cmd:setpriceh(playerid,params[])
{
	if(admin_level[playerid] < 7) return true;
	if(sscanf(params, "id", params[0], params[1])) return Send(playerid, -1,"/setcena [ID rumah] [harga]");
	HouseInfo[params[0]][hValue] = params[1];
	SaveHouse(params[0]);
	SCMF(playerid,0x27C400FF,"Anda telah berhasil menginstal di rumah: %i biaya negara: %d", params[0], params[1]);
	return true;
}
epublic: LoadABizz()
{
    new rows;
	cache_get_row_count(rows);

	if(rows)
	{
	    for(new i = 1; i <= rows; i++)
		{
		    cache_get_value_name_int(i-1, "aID", BizzAInfo[i][aID]);
		    cache_get_value_name(i-1, "aOwner", BizzAInfo[i][aOwner], 32);
		    cache_get_value_name(i-1, "aMessage", BizzAInfo[i][aMessage], 32);
		    cache_get_value_name_int(i-1, "aOwned", BizzAInfo[i][aOwned]);

		    cache_get_value_name_float(i-1, "aAreaFillX", BizzAInfo[i][aAreaFillX]);
		    cache_get_value_name_float(i-1, "aAreaFillY", BizzAInfo[i][aAreaFillY]);
		    cache_get_value_name_float(i-1, "aAreaFillZ", BizzAInfo[i][aAreaFillZ]);

		    cache_get_value_name_int(i-1, "aBuyPrice", BizzAInfo[i][aBuyPrice]);
		    cache_get_value_name_int(i-1, "aMoney", BizzAInfo[i][aMoney]);
		    cache_get_value_name_int(i-1, "aLocked", BizzAInfo[i][aLocked]);
		    cache_get_value_name_int(i-1, "aProducts", BizzAInfo[i][aProducts]);
		    cache_get_value_name_int(i-1, "aPrice", BizzAInfo[i][aPrice]);
		    cache_get_value_name_int(i-1, "aMafia", BizzAInfo[i][aMafia]);
		    cache_get_value_name_int(i-1, "aArenda", BizzAInfo[i][aArenda]);
		    cache_get_value_name_int(i-1, "aOplata", BizzAInfo[i][aOplata]);
		    cache_get_value_name_int(i-1, "aRaschet", BizzAInfo[i][aRaschet]);
		    cache_get_value_name_int(i-1, "aSklad", BizzAInfo[i][aSklad]);
		    cache_get_value_name_int(i-1, "aSlet", BizzAInfo[i][aSlet]);

            if(BizzAInfo[i][aOwned] == 0)
			{
			    format(String, sizeof(String), "{0099FF}Pesan '%s'\n"W"Harga untuk 1 liter: %d$\n\n{EBBD00}Pompa bensin dijual\nHarga: %d$\n{66CC00}/buyfuelst untuk pembelian",BizzAInfo[i][aMessage], BizzAInfo[i][aPrice], BizzAInfo[i][aBuyPrice]);
				BizzAInfo[i][aLabel] = Create3DTextLabel(String, -1, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ],15.0,0,1);
			}
			else if(BizzAInfo[i][aOwned] == 1)
			{
				format(String, sizeof(String), "{0099FF}Pesan '%s'\n"W"Pemilik: {66CC00}%s\n"W"Harga untuk 1 liter: {EBBD00}%d$\n{66CC00}/fuel - untuk mengisi bahan bakar",BizzAInfo[i][aMessage], BizzAInfo[i][aOwner], BizzAInfo[i][aPrice]);
				BizzAInfo[i][aLabel] = Create3DTextLabel(String,0x00D900FF,BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ],15.0,0,1);
			}
   			CreateDynamicMapIcon(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 47, -1, 0, -1, -1);

   			BizzAInfo[i][aEntranceArea] = CreateDynamicSphere(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 5);
   			TotalABizz++;
   		}
   	}

   	for(new i = 1; i <= rows; i++)
	{
	    if(BizzAInfo[i][aSlet] == 0) continue;

	    new bizz = i;

	    format(MySQLStr, 96, "DELETE FROM `bizz_stats` WHERE `bID` = %d", bizz);
		mysql_tquery(mMysql, MySQLStr); // delete stats bizz

		format(format_string, 144, "UPDATE `accounts` SET `pBank` = `pBank` + %i WHERE `pName` = '%s'", BizzAInfo[bizz][aBuyPrice] / 2, BizzAInfo[i][aOwner]);
		mysql_tquery(mMysql, format_string);

		new sql_id = GetPlayerSqlIDByName(BizzAInfo[i][aOwner]);

	    AddPlayerNotifyBySQL(sql_id, "Pengisian ulang bahan bakar Anda dijual tanpa pembayaran.");

	    BizzAInfo[bizz][aOwned] = 0, BizzAInfo[bizz][aLocked] = 0, BizzAInfo[bizz][aPrice] = 50, BizzAInfo[bizz][aMoney] = 0, BizzAInfo[bizz][aRaschet] = 0, BizzAInfo[bizz][aSklad] = 1000;
		BizzAInfo[bizz][aOplata] = 0, BizzAInfo[bizz][aSlet] = 0;
		strmid(BizzAInfo[bizz][aOwner], "None", 0, strlen("None"), 32);

		SaveABizz(bizz);
   	}

   	return printf("[MySQL R41-3]: SPBU dimuat: %i pcs.", TotalABizz);
}

epublic: LoadTaxiBizz()
{
    new rows;
	cache_get_row_count(rows);

	if(!rows) return 1;

	new b_id, c_id;

    for(new i; i < rows; i++)
	{
	    cache_get_value_name_int(i, "b_id", b_id);
	    cache_get_value_name_int(i, "c_id", c_id);

	    cache_get_value_name_int(i, "model", taxi_bizz_models[b_id][c_id]);
	    //cache_get_value_name_float(i, "fuel", taxi_bizz_fuels[b_id][c_id]);
	    taxi_bizz_fuels[b_id][c_id] = MAX_VEHICLE_FUEL;
	    cache_get_value_name_int(i, "price", taxi_bizz_rent[b_id][c_id]);
	}

	return 1;
}

stock LoadBizz()
{
	new Cache: result = mysql_query(mMysql, "SELECT * FROM `bizz`", true);

    new rows = cache_num_rows();

	if(!rows) return 1;

    for(new i; i < rows; i++)
	{
	    cache_get_value_name(i, "bOwner", BizzInfo[i][bOwner], 32);
	    cache_get_value_name(i, "bMessage", BizzInfo[i][bMessage], 32);
	    cache_get_value_name_int(i, "bOwned", BizzInfo[i][bOwned]);

		cache_get_value_name_float(i, "bEntranceX", BizzInfo[i][bEntranceX]);
		cache_get_value_name_float(i, "bEntranceY", BizzInfo[i][bEntranceY]);
	    cache_get_value_name_float(i, "bEntranceZ", BizzInfo[i][bEntranceZ]);
	    cache_get_value_name_float(i, "bExitX", BizzInfo[i][bExitX]);
	    cache_get_value_name_float(i, "bExitY", BizzInfo[i][bExitY]);
	    cache_get_value_name_float(i, "bExitZ", BizzInfo[i][bExitZ]);
	    cache_get_value_name_float(i, "bBarX", BizzInfo[i][bBarX]);
	    cache_get_value_name_float(i, "bBarY", BizzInfo[i][bBarY]);
	    cache_get_value_name_float(i, "bBarZ", BizzInfo[i][bBarZ]);

	    cache_get_value_name_int(i, "bInterior", BizzInfo[i][bInterior]);
	    cache_get_value_name_int(i, "bProducts", BizzInfo[i][bProducts]);
	    cache_get_value_name_int(i, "bVirtualWorld", BizzInfo[i][bVirtualWorld]);
	    cache_get_value_name_int(i, "bBuyPrice", BizzInfo[i][bBuyPrice]);
	    cache_get_value_name_int(i, "bPrice", BizzInfo[i][bPrice]);
	    cache_get_value_name_int(i, "bEntranceCost", BizzInfo[i][bEntranceCost]);
	    cache_get_value_name_int(i, "bMoney", BizzInfo[i][bMoney]);
	    cache_get_value_name_int(i, "bRaschet", BizzInfo[i][bRaschet]);
	    cache_get_value_name_int(i, "bLocked", BizzInfo[i][bLocked]);
	    cache_get_value_name_int(i, "bMafia", BizzInfo[i][bMafia]);
	    cache_get_value_name_int(i, "bType", BizzInfo[i][bType]);
	    cache_get_value_name_int(i, "bSlet", BizzInfo[i][bSlet]);
	    cache_get_value_name_int(i, "bOplata", BizzInfo[i][bOplata]);
	    cache_get_value_name_int(i, "bArenda", BizzInfo[i][bArenda]);
	    cache_get_value_name_int(i, "bUpdMusic", BizzInfo[i][bUpdMusic]);
	    cache_get_value_name_int(i, "bSotrud", BizzInfo[i][bSotrud]);
	    cache_get_value_name_int(i, "bUpdHeal", BizzInfo[i][bUpdHeal]);
	    cache_get_value_name_int(i, "bUpdSub", BizzInfo[i][bUpdSub]);
	    cache_get_value_name_int(i, "bSklad", BizzInfo[i][bSklad]);
	    cache_get_value_name_int(i, "bPhone", BizzInfo[i][bPhone]);
	    cache_get_value_name_int(i, "bProcent", BizzInfo[i][bProcent]);

		if(BizzInfo[i][bEntranceX] == 0.0) continue;

        if(BizzInfo[i][bOplata] == 0) BizzInfo[i][bOplata] = 15;

		if(BizzInfo[i][bOwned] == 1)
		{
			if(BizzInfo[i][bUpdHeal] != 0) CreateHealsBizz(i);
			if(BizzInfo[i][bSotrud] != 0) CreateActorsBizz(i);
		}

		AddStaticPickup(19132, 23, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ]);
		CreatePickup(19132, 23, BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ],BizzInfo[i][bVirtualWorld]);

		BizzInfo[i][bLabel] = Create3DTextLabel("",0x00D900FF,BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ],10.0,0,1);

		UpdateBizzLabelText(i);

		//
	    switch(BizzInfo[i][bType])
		{
		    case 1:
		    {
		        Create3DTextLabel("Masuk '/drink'", 0xDC900CFF, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5, 10.0, BizzInfo[i][bVirtualWorld], 1);
                BizzInfo[i][bPickup] = CreatePickup(19823, 23, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ], BizzInfo[i][bVirtualWorld]);
                CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], i == 77 ? 43 : i == 79 ? 44 : 49, -1, 0, -1, -1);
		    }
		    case 2:
		    {
		        Create3DTextLabel("Masuk '/eat'", 0xDC900CFF,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
		   		BizzInfo[i][bPickup] = CreateDynamicCP(BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ],1,BizzInfo[i][bVirtualWorld],BizzInfo[i][bInterior], -1, 10.0);
            	CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 10, -1, 0, -1, -1);
		    }
		    case 3:
		    {
		        Create3DTextLabel("Masuk '/buy'", 0xDC900CFF,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
            	BizzInfo[i][bPickup] = CreatePickup(1274, 23, BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ],BizzInfo[i][bVirtualWorld]);
            	CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 8, -1, 0, -1, -1);
		    }
		    case 4:
		    {
				// Biro iklan
				Create3DTextLabel("Masuk '/advert'", 0xDC900CFF,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
            	BizzInfo[i][bPickup] = CreatePickup(1274, 23, BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ],BizzInfo[i][bVirtualWorld]);
				CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 12, -1, 0, -1, -1);

				//Create3DTextLabel("Informasi untuk Pengiklan", 0x1A8FA9FF, 2209.8484,1612.7736,999.9654+0.65, 15.0, BizzInfo[i][bVirtualWorld], 1); // ADVERT LABEL
		    }
		  /*  case 5:
		    {
		        Create3DTextLabel("Penempatan kerja", 0xDC900CFF,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
		        BizzInfo[i][bPickup] = CreatePickup(1275, 23, BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ],BizzInfo[i][bVirtualWorld]);
		        CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 55, -1, 0, -1, -1);

	        	CreateTaxiVehiclesForBizz(i);
   			}*/
   			case 6:
   			{
   			    Create3DTextLabel("/clothes", 0xDC900CFF, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
		        BizzInfo[i][bPickup] = CreatePickup(1275, 23, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ], BizzInfo[i][bVirtualWorld]);
		        CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 45, -1, 0, -1, -1);
   			}
   			case 7:
   			{
   			    Create3DTextLabel("/buy", 0xDC900CFF, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
		        BizzInfo[i][bPickup] = CreatePickup(1274, 23, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ], BizzInfo[i][bVirtualWorld]);
		        CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 20, -1, 0, -1, -1);
			}
			case 8:
			{
                BizzInfo[i][bPickup] = CreatePickup(2061, 23, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ], BizzInfo[i][bVirtualWorld]);
			    CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 6, -1, 0, -1, -1);
			}
			case 9:
			{
			    CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 55, -1, 0, -1, -1);
			}
			case 13:
			{
			    CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 35, -1, 0, -1, -1);
			}
			case 14:
			{
                CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 27, -1, 0, -1, -1);
			}
			case 23:
			{
			    Create3DTextLabel("Daftar untuk\nAcara", 0xDC900CFF, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]+0.5,10.0,BizzInfo[i][bVirtualWorld],1);
		        BizzInfo[i][bPickup] = CreatePickup(1239, 23, BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ], BizzInfo[i][bVirtualWorld]);
		        CreateDynamicMapIcon(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ], 20, -1, 0, -1, -1);
			}
		}
		//
		BizzInfo[i][bEntranceArea] = CreateDynamicSphere(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ],1);
		BizzInfo[i][bExitArea] = CreateDynamicSphere(BizzInfo[i][bExitX], BizzInfo[i][bExitY], BizzInfo[i][bExitZ],1,BizzInfo[i][bVirtualWorld]);
		TotalBizz++;
	}

	cache_delete(result);

    for(new i; i < rows; i++)
	{
	    if(BizzInfo[i][bSlet] != 0)
	    {
	        new bizz = i;

		    format(format_string, 96, "DELETE FROM `bizz_stats` WHERE `bID` = %d", bizz);
			mysql_tquery(mMysql, format_string);

			format(format_string, 144, "UPDATE `accounts` SET `pBank` = `pBank` + %i WHERE `pName` = '%s'", BizzInfo[bizz][bBuyPrice] / 2, BizzInfo[i][bOwner]);
			mysql_tquery(mMysql, format_string);

			new sql_id = GetPlayerSqlIDByName(BizzInfo[i][bOwner]);

		    AddPlayerNotifyBySQL(sql_id, "Bisnis Anda dijual tanpa pembayaran.");

		    BizzInfo[bizz][bOwned] = 0, BizzInfo[bizz][bLocked] = 0, BizzInfo[bizz][bPrice] = 50, BizzInfo[bizz][bMoney] = 0, BizzInfo[bizz][bRaschet] = 0, BizzInfo[bizz][bUpdSub] = 0, BizzInfo[bizz][bUpdMusic] = 0;
			BizzInfo[bizz][bOplata] = 0, BizzInfo[bizz][bEntranceCost] = 0, BizzInfo[bizz][bSlet] = 0, BizzInfo[bizz][bUpdHeal] = 0, BizzInfo[bizz][bSklad] = 1000;
			BizzInfo[bizz][bPhone] = 0, BizzInfo[bizz][bProcent] = 0, BizzInfo[bizz][bSotrud] = 0;

			strmid(BizzInfo[bizz][bOwner], "None", 0, strlen("None"), 32);

			SaveBizz(bizz);
		}
	}

	return printf("[MySQL R41-3]: Bisnis dimuat: %i pcs.", TotalBizz);
}

