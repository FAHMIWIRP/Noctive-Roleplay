		new installed = VehInfo[vehicleid][vEngineTune][i];

		format(line_string,96,"{ffffff}%i. %s\t%i\t%s\n", i + 1, engine_ptune[i],engine_ptune_price[i], installed ? ("{90EE90}Tersedia") : ("{FF0000}Tidak Tersedia"));
