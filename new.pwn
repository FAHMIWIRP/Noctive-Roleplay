	SCM(playerid, -1, "Pergi dan ambil Medkit.");

    pTemp[playerid][pWorkSalary] += 50;
    GivePlayerMoneyEx(playerid, 750, "Medkit rig"); //UJI

	ClearAnimations(playerid);

	TogglePlayerControllable(playerid, true);

	return 1;
}

