CMD:coin(playerid, params[])
{
	if(PlayerInfo[playerid][pCash] < 1) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki koin.");

	new rand = random(2);

	format(String, 128, "%s melemparkan koin dan menjatuhkan sebuah %s",Name(playerid), rand ? ("{33AA33}Eagle") : ("{FF0000}Ekor"));
	ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid, String, 0xDD90FFFF, 20.0, 10000);
	return 1;
}

CMD:delacc(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/delacc [name]");

	mysql_format(mMysql, format_string, 144, "SELECT `pID` FROM `accounts` WHERE `pName` = '%e'", params);
	new Cache: result = mysql_query(mMysql, format_string);

	if(!cache_num_rows()) return SCMF(playerid, COLOR_GREY, "%s pemain tidak ditemukan.", params);

	cache_delete(result);

	if(Getplayerid(params) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain dalam permainan.");

	format(format_string, 144, "DELETE FROM `accounts` WHERE `pName` = '%s'", params);
	mysql_tquery(mMysql, format_string);

	return SCMF(playerid, COLOR_GREEN, "Akun tersebut diambil dari %s.", params);
}
CMD:kasihbatu(playerid, params[])
{
	new to_player, amount, price;

    if(sscanf(params, "uii", to_player, amount, price)) return SCM(playerid,0x00D900AA, "[Petunjuk]: {FFFFFF}/kasihbatu [id] [amount] [price]");

	if(!(1 <= amount <= 500)) return SCM(playerid, COLOR_GREY, "Chuck terjangkau dari 1 sampai 500");

	if(!(1 <= price <= 50000)) return SCM(playerid, COLOR_GREY, "Harga terjangkau dari $1 hingga $50,000");

	if(PlayerInfo[playerid][pBatu] < amount) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki semacam itu pelindung.");

  	if(!ProxDetectorS(5.0, playerid, to_player)) return SCM(playerid, COLOR_GREY, "Kau Yalek dari pemain ini.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan masuk untuk pertukaran!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_BATU, price, amount);

	SCMF(playerid, 0x6BB3FFAA, "Anda telah menawarkan %s untuk membeli dari Anda %i gr. $%i Marijuana.", GetPlayerNameEx(to_player), amount, price);
	SCMF(to_player, 0x6BB3FFAA, "%s menawarkan Anda untuk membeli %i gr. $%i Marijuana.", GetPlayerNameEx(playerid), amount, price);

    return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}
