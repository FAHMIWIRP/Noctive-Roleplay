forward OnCraftingAKUpdate(playerid);
CMD:createak47(playerid, params[])
{
    // 1. Cek status keluarga
    if(PlayerInfo[playerid][pFamily] == -1)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Anda bukan anggota keluarga mana pun!");

    // 2. Cek lokasi crafting
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 291.156524, -106.223526, 1001.515625))
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Anda tidak berada di tempat crafting.");

    // 3. Cek anti-spam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Tunggu proses nya selesai!");

    // 4. Cek ketersediaan bahan pembuatan
    if(PlayerInfo[playerid][pClipak47] < 1)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Anda tidak memiliki Clip AK47.");

    if(PlayerInfo[playerid][pRedmoney] < 20000 || PlayerInfo[playerid][pMetall] < 2000)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Bahan (Uang/Metal) tidak cukup.");

    // 5. Amankan bahan dahulu di awal
    PlayerInfo[playerid][pRedmoney] -= 20000;
    PlayerInfo[playerid][pMetall] -= 2000;
    PlayerInfo[playerid][pClipak47] -= 1;

    // Simpan pengurangan bahan ke database
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    OnPlayerUpdateAccountsPer(playerid, "pClipak47", PlayerInfo[playerid][pClipak47]);

    // 6. Mulai animasi & freeze pemain
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 1, 1, 1, 0, 1);

    // 7. Set Progress Bar (40 Detik = 400ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Creating AK47..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Jalankan timer loop
    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnCraftingAKUpdate", 400, true, "i", playerid);

    SendClientMessage(playerid, -1, "{FFFF00}[CRAFTING]: {FFFFFF}Sedang merakit AK-47, harap tunggu 40 detik...");
    return 1;
}

// Callback loop untuk memperbarui visual loading bar setiap 400ms
public OnCraftingAKUpdate(playerid)
{
    // Jika player terputus, matikan timer agar tidak leak
    if(!IsPlayerConnected(playerid))
    {
        if(PlayerProgressBarTimer[playerid] != -1)
        {
            KillTimer(PlayerProgressBarTimer[playerid]);
            PlayerProgressBarTimer[playerid] = -1;
        }
        return 1;
    }

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");

        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        // Jeda 1 detik saat bar penuh hijau sebelum memberikan senjata
        SetTimerEx("SelesaiCraftingAK", 1000, false, "i", playerid);
    }
    else
    {
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiCraftingAK(playerid);
public SelesaiCraftingAK(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Reset status & unfreeze pemain
    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    // Berikan senjata (ID 30 = AK-47, Ammo = 300 disamakan dengan variabel)
    GivePlayerWeapon(playerid, 30, 300);

    // Update variabel internal & database
    PlayerInfo[playerid][pGun] = 30;
    PlayerInfo[playerid][pAmmo] = 300;
    PlayerInfo[playerid][pDurability] = 100;

    OnPlayerUpdateAccountsPer(playerid, "pGun", PlayerInfo[playerid][pGun]);
    OnPlayerUpdateAccountsPer(playerid, "pDurability", PlayerInfo[playerid][pDurability]);
    OnPlayerUpdateAccountsPer(playerid, "pAmmo", PlayerInfo[playerid][pAmmo]);

    SendClientMessage(playerid, -1, "{00FF00}[INFO]: {FFFFFF}Crafting selesai! Anda berhasil membuat AK-47.");
    return 1;
}

