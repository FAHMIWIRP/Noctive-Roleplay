    new
        name[32] = "San Andreas";

    for (new i = 0; i != sizeof(g_arrZoneData); i ++) if((fX >= g_arrZoneData[i][e_ZoneArea][0] && fX <= g_arrZoneData[i][e_ZoneArea][3]) && (fY >= g_arrZoneData[i][e_ZoneArea][1] && fY <= g_arrZoneData[i][e_ZoneArea][4]) && (fZ >= g_arrZoneData[i][e_ZoneArea][2] && fZ <= g_arrZoneData[i][e_ZoneArea][5])) {
        strunpack(name, g_arrZoneData[i][e_ZoneName]);

        break;
    }
    return name;
}

public StockSpawn(playerid)
{
    new rand = random(4);
    InterpolateCameraPos(playerid, cam_start_pos[rand][0][0], cam_start_pos[rand][0][1], cam_start_pos[rand][0][2], cam_start_pos[rand][0][3], cam_start_pos[rand][0][4], cam_start_pos[rand][0][5], 20000);
    InterpolateCameraLookAt(playerid, cam_start_pos[rand][1][0], cam_start_pos[rand][1][1], cam_start_pos[rand][1][2], cam_start_pos[rand][1][3], cam_start_pos[rand][1][4], cam_start_pos[rand][1][5], 20000);
    SetPlayerPos(playerid,cam_start_pos[rand][2][0],cam_start_pos[rand][2][1],cam_start_pos[rand][2][2]);

    if(PlayerInfo[playerid][pWargaNew] == 0)
    {
        ShowSelectSpawn(playerid);
    }
    else
    {
        PlayerInfo[playerid][pPilihSpawn] = 1;
			   		LoadingObject1(playerid);
			     	SetSaveSpawn(playerid);
			      	SetCameraBehindPlayer(playerid);
    }
    return 1;
}


stock SetSaveSpawn(playerid)
{
   SetPlayerPos(playerid, PlayerInfo[playerid][pPosisiX], PlayerInfo[playerid][pPosisiY], PlayerInfo[playerid][pPosisiZ]);
   SetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosisiAngle]);
   SetPlayerInterior(playerid, PlayerInfo[playerid][pInterior]);
   SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pVirtualWorld]);
   return 1;
}

stock SaveSpawn(playerid)
{
   GetPlayerPos(playerid, Float: PlayerInfo[playerid][pPosisiX], Float: PlayerInfo[playerid][pPosisiY], Float: PlayerInfo[playerid][pPosisiZ]);
   GetPlayerFacingAngle(playerid, Float: PlayerInfo[playerid][pPosisiAngle]);
   PlayerInfo[playerid][pInterior] = GetPlayerInterior(playerid);
   PlayerInfo[playerid][pVirtualWorld] = GetPlayerVirtualWorld(playerid);

   format(MySQLStr, 312, "UPDATE `accounts` SET `pPosisiX` = '%f', `pPosisiY` = '%f', `pPosisiZ` = '%f', `pPosisiAngle` = '%f' WHERE `pID` = %d LIMIT 1",
   PlayerInfo[playerid][pPosisiX],
   PlayerInfo[playerid][pPosisiY],
   PlayerInfo[playerid][pPosisiZ],
   PlayerInfo[playerid][pPosisiAngle],
   PlayerInfo[playerid][pID]);
   mysql_tquery(mMysql, MySQLStr);

   OnPlayerUpdateAccountsPer(playerid, "pInterior", PlayerInfo[playerid][pInterior]);
   OnPlayerUpdateAccountsPer(playerid, "pVirtualWorld", PlayerInfo[playerid][pVirtualWorld]);
   return 1;
}

forward enter(playerid);
public enter(playerid)
{
	TogglePlayerControllable(playerid,1);
	KillTimer(entertimer[playerid]);
}

public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
    // 1. SEKTOR WEAPON ATTACHMENT POSITION SAVER
    if(index == ATTACH_INDEX)
    {
        new wepid = EditingWeaponID[playerid];
        if(wepid >= 22 && wepid <= 34)
        {
            if(response == 1) 
            {
                PlayerWeapon[playerid][wepid][W_X] = fOffsetX;
                PlayerWeapon[playerid][wepid][W_Y] = fOffsetY;
                PlayerWeapon[playerid][wepid][W_Z] = fOffsetZ;
                PlayerWeapon[playerid][wepid][W_RX] = fRotX;
                PlayerWeapon[playerid][wepid][W_RY] = fRotY;
                PlayerWeapon[playerid][wepid][W_RZ] = fRotZ;
                PlayerWeapon[playerid][wepid][W_Bone] = boneid;
                
                SendClientMessage(playerid, 0x00FF00FF, "SISTEM: Posisi baru senjata berhasil disimpan!");
                SaveWeaponConfig(playerid);
            }
            else 
            {
                SendClientMessage(playerid, 0xFF0000FF, "SISTEM: Perubahan posisi senjata dibatalkan.");
            }
            EditingWeaponID[playerid] = 0; 
            CheckAndAttachWeapon(playerid); 
        }
        return 1;
    }
  
    // 2. SEKTOR INTEGRASI TOYS (Langsung baca variabel asli dari gamemode kamu)
    new toyid = player_toys_slot_set[playerid];
    if(toyid != -1)
    {
        new idx = -1;
        if(player_toys_slot_set[playerid] == 0) idx = 6;
        else if(player_toys_slot_set[playerid] == 1) idx = 7;
        else if(player_toys_slot_set[playerid] == 2) idx = 8;

        if(index == idx)
        {
            if(response)
            {
                ToyInfo[playerid][toyPositionX][toyid] = fOffsetX;
                ToyInfo[playerid][toyPositionY][toyid] = fOffsetY;
                ToyInfo[playerid][toyPositionZ][toyid] = fOffsetZ;
                ToyInfo[playerid][toyRotationX][toyid] = fRotX;
                ToyInfo[playerid][toyRotationY][toyid] = fRotY;
                ToyInfo[playerid][toyRotationZ][toyid] = fRotZ;
                ToyInfo[playerid][toyScaleX][toyid] = fScaleX;
                ToyInfo[playerid][toyScaleY][toyid] = fScaleY;
                ToyInfo[playerid][toyScaleZ][toyid] = fScaleZ;

                RemovePlayerAttachedObject(playerid, idx);
                SetPlayerAttachedObject(playerid, idx, ToyInfo[playerid][toyModel][toyid], ToyInfo[playerid][toyBone][toyid], ToyInfo[playerid][toyPositionX][toyid], ToyInfo[playerid][toyPositionY][toyid], ToyInfo[playerid][toyPositionZ][toyid],
                ToyInfo[playerid][toyRotationX][toyid], ToyInfo[playerid][toyRotationY][toyid], ToyInfo[playerid][toyRotationZ][toyid],
                ToyInfo[playerid][toyScaleX][toyid], ToyInfo[playerid][toyScaleY][toyid], ToyInfo[playerid][toyScaleZ][toyid]);

                SavePlayerToys(playerid);
                GameTextForPlayer(playerid, "~w~TOYS SAVED", 1500, 5);
            }
            else 
            {
                RemovePlayerAttachedObject(playerid, idx);
                SetPlayerAttachedObject(playerid, idx, ToyInfo[playerid][toyModel][toyid], ToyInfo[playerid][toyBone][toyid], ToyInfo[playerid][toyPositionX][toyid], ToyInfo[playerid][toyPositionY][toyid], ToyInfo[playerid][toyPositionZ][toyid],
                ToyInfo[playerid][toyRotationX][toyid], ToyInfo[playerid][toyRotationY][toyid], ToyInfo[playerid][toyRotationZ][toyid],
                ToyInfo[playerid][toyScaleX][toyid], ToyInfo[playerid][toyScaleY][toyid], ToyInfo[playerid][toyScaleZ][toyid]);
                GameTextForPlayer(playerid, "~r~EDIT CANCELLED", 1500, 5);
            }
        }
    }
    return 1;
}
