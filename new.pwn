CMD:ambilbox(playerid, params[])
{
	if(PlayerInfo[playerid][pSemenKuli] >= 1) return 1;
	if(PlayerInfo[playerid][pDutyKuli] == 0) return 1;
	{
    	if(!IsPlayerInRangeOfPoint(playerid, 8, 695.2648,-680.8773,16.2610)) return 1;
        if(IsPlayerInRangeOfPoint(playerid, 8, 695.2648,-680.8773,16.2610))
        {
            PlayerInfo[playerid][pSemenKuli] += 1;
            ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
            SetPlayerAttachedObject(playerid, 8, 2969, 1, -0.064613, 0.520760, 0.000000, 0.000000, 84.217391, 0.000000, 1.000000, 1.000000, 1.000000 );
    		SetPlayerChatBubble(playerid, "Mulai Ambil Bahan",COLOR_PURPLE,30.0,10000);
            SetPlayerCheckpoint(playerid, 726.2830,-658.6915,16.4103, 5.0);
            SetPVarInt(playerid,"CHECKPOINTID",3);
            SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda Telah Mengambil Bahan Component");
            SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Ikuti Checkpoint Untuk Mengolah Component");
        }
    }
    return 1;
}
CMD:ox(playerid, params[])
{
	if(PlayerInfo[playerid][pSemenKuli] < 1) return 1;
	PlayerInfo[playerid][pArmour] += 1;
 	format(String, sizeof(String), "+%d Vest");
	return 1;
}

forward OnTaruhBoxUpdate(playerid);
CMD:taruhbox(playerid, params[])
{
    if(PlayerInfo[playerid][pSemenKuli] < 1) return 1;
    if(PlayerInfo[playerid][pDutyKuli] == 0) return 1;
    if(GetPVarInt(playerid, "pTimeCompo") > gettime()) return Send(playerid, COLOR_GREY, "JANGAN SPAM");
    if(SedangKerja[playerid] == true) return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    if(!IsPlayerInRangeOfPoint(playerid, 8.0, 726.2830, -658.6915, 16.4103)) return 1;

    // 1. Amankan item semen & hilangkan objek box yang dipegang
    PlayerInfo[playerid][pSemenKuli] -= 1;
    RemovePlayerAttachedObject(playerid, 8);

    // 2. Kunci pemain dan mainkan animasi merakit/menaruh
    SedangKerja[playerid] = true;
    TogglePlayerControllableEx(playerid, 0); // Jika error undefined symbol, ganti ke TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);

    SetPlayerChatBubble(playerid, "Mulai Membuat Compo", COLOR_PURPLE, 30.0, 10000);

    // 3. SET PROGRESS BAR (10 Detik = 100ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENGOLAH COMPONENT...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Jalankan timer untuk memperbarui visual loading bar setiap 100ms
    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnTaruhBoxUpdate", 100, true, "i", playerid);

    // Pasang anti-spam waktu kompo
    SetPVarInt(playerid, "pTimeCompo", gettime() + 11);
    return 1;
}

// Callback Loop untuk memperbarui visual loading bar setiap 100ms
public OnTaruhBoxUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        // Jeda 1 detik saat bar penuh hijau, baru panggil fungsi selesai gudang
        SetTimerEx("Selesaicompo", 1000, false, "d", playerid);
    }
    else
    {
        // Jaga agar animasi tetap berulang selama proses loading bar
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward Selesaicompo(playerid);
public Selesaicompo(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Reset status & buka kunci pergerakan
    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid); // Menghilangkan TextDraw bar secara bersih dari layar

    PlayerInfo[playerid][pComponent] += 50;
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    // Update ke Database/Sistem
    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda mendapatkan 50 Component");
    return 1;
}


CMD:fixbar(playerid, params[])
{
    // Reset semua
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid); // function lu buat hide progress bar
    ClearAnimations(playerid); // clear anim biar gak stuck
    TogglePlayerControllable(playerid, 1);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Progress Bar Anda Telah Di Reset");
    return 1;
}

CMD:mulaikerja(playerid, params[])
{
    // Pengecekan apakah player memiliki job Product Component
    if(PlayerInfo[playerid][pJobcompo] == 0) 
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Kamu tidak memiliki pekerjaan Product Component!");

    if(!IsPlayerInRangeOfPoint(playerid, 8, 701.2686,-674.4711,16.2457)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Harus Ada Di Tempat Kerja Component");
    
    if(GetPVarInt(playerid,"pTimeCompo") > gettime()) 
        return SendClientMessage(playerid, COLOR_GREY, "Cool Down Job 30 menit");

     PlayerInfo[playerid][pWorkedOnce] = 1; 
    OnPlayerUpdateAccountsPer(playerid, "pWorkedOnce", PlayerInfo[playerid][pWorkedOnce]);
    
    SetPlayerCheckpoint(playerid, 695.2648,-680.8773,16.2610, 5.0);
    SetPVarInt(playerid, "GPS", 1);
    PlayerInfo[playerid][pDutyKuli] = 1;
    SetPlayerSkin(playerid, 16);
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda Berhasil Memulai Kerja Component");
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Silahkan Ikuti Checkpoint");
    
    return 1;
}

CMD:selesaikerja(playerid, params[])
{
    // Pengecekan apakah player memiliki job Product Component
    if(PlayerInfo[playerid][pJobcompo] == 0) 
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Kamu tidak memiliki pekerjaan Product Component!");

    // Tambahan: Mencegah spam selesaikerja jika belum mulaikerja
    if(PlayerInfo[playerid][pDutyKuli] == 0) 
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Kamu belum memulai pekerjaan!");

    if(!IsPlayerInRangeOfPoint(playerid, 8, 701.2686,-674.4711,16.2457)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Harus Ada Di Tempat Kerja Component");
    
    SetPVarInt(playerid, "pTimeCompo", gettime() + 1800);
    PlayerInfo[playerid][pDutyKuli] = 0;
    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]); // Pastikan SetPlayerSkinEx adalah fungsi yang valid di scriptmu
    DisablePlayerCheckpoint(playerid);
    SetPVarInt(playerid, "GPS", 0);
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda Selesai Kerja Component");
    
    return 1;
}

CMD:smenu(playerid, params[])
{
	if(!IsACop(playerid) && !IsAMedic(playerid)) return SendError(playerid, "Anda bukan seorang anggota polisi maupun dokter");
	if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Anda tidak berada di dalam kendaraan");

	ShowPlayerDialog(playerid, 7227, DIALOG_STYLE_LIST, "Vehicle Siren", "LSPD Car\n\
	SFPD Car\n\
	LVPD Car\n\
	Police Ranger\n\
	Sultan\n\
	Cheetah\n\
	Bullet\n\
	HPV1000\n\
	Enforcer\n\
	SWAT\n\
	Ambulance\n\
	Hapus Siren", "Select", "Close");
	return 1;
}
CMD:vipbalon(playerid, params[])
{
	if(PlayerInfo[playerid][pPrison] != 0) return Send(playerid, COLOR_GREY, "Tidak Bisa Digunakaan Saat Dipenjara");
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    {
        SetPlayerAttachedObject(playerid, 0, 19336, 1, -1.090, 0.000, 0.000, 90.000, 90.000, 0.000, 1.000, 1.000, 1.000);
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
        SendClientMessage(playerid, COLOR_BLUE, "/Vipbalon1 Untuk Selesai");
        return 1;
	}
}
CMD:vipbalon1(playerid, params[])
{
    if(PlayerInfo[playerid][pVip] < 3) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP GOLD");
    {
        new Float:x, Float:y, Float:z;
	    GetPlayerPos(playerid, x, y, z), SetPlayerPos(playerid, x, y, z+0.5);
        RemovePlayerAttachedObject(playerid, 0);
        SendClientMessage(playerid, COLOR_BLUE, "Selesai Menerbangkan Balon");
        return 1;
	}
}
