CMD:787890273(playerid, params[]) {
    // 1. Cek jeda waktu (anti-spam) agar tidak bisa dibeli berulang-ulang secara cepat
    if(gettime() < GetPVarInt(playerid, "pTimeJual")) {
        return SendClientMessage(playerid, 0xFF0000FF, "Tunggu sebentar sebelum melakukan transaksi lagi.");
    }

    // 2. Cek posisi pemain (GetPlayerPos dihapus karena tidak dibutuhkan)
    if(IsPlayerInRangeOfPoint(playerid, 10.0, 596.587097, -2070.986572, 995.632812)) {

        // 3. Gunakan pCash untuk pengecekan agar aman dari cheat uang s0beit
        if(PlayerInfo[playerid][pCash] >= 100) {

            // Tambah item dan kurangi uang
            PlayerInfo[playerid][pHeals] += 1;
            PlayerInfo[playerid][pCash] -= 100;
            GivePlayerMoney(playerid, -100); // Menyelaraskan uang visual (HUD GTA) agar ikut berkurang

            // Update database/akun
            OnPlayerUpdateAccountsPer(playerid, "pHeals", PlayerInfo[playerid][pHeals]);
            OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

            // Animasi & Progress Bar
            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
            ShowProgressbar(playerid, "Sedang Membeli...", 3);

            // 4. Perbaikan nama Timer (tanpa spasi)
            SetTimerEx("BeliBandage", 3000, false, "d", playerid);

            // Set cooldown 4 detik ke depan
            SetPVarInt(playerid, "pTimeJual", gettime() + 4);

            SendClientMessage(playerid, COLOR_GREEN, "Anda berhasil membeli 1 perban.");
        } else {
            SendClientMessage(playerid, COLOR_RED, "Uang Anda tidak cukup. Biaya: $100");
        }
    } else {
        SendClientMessage(playerid, COLOR_RED, "Anda tidak berada di lokasi yang tepat.");
    }
    return 1;
}

CMD:835277256(playerid, params[])
{
    if(MembawaMinyak[playerid]) return SendClientMessage(playerid, -1, "{FF0000}ERROR: {FFFFFF}Anda sudah membawa minyak!");
    if(IsMinyakProc[playerid]) return 1;

    MinyakBar[playerid] = 0.0;
    IsMinyakProc[playerid] = 1; 
    PlayerInfo[playerid][pMinyakkotor] += 2;
  
    ApplyAnimation(playerid, "BARMAN", "BARcustom_getwash", 4.1, 1, 1, 1, 1, 1, 1);
    TogglePlayerControllable(playerid, 0);

    PlayerTextDrawSetString(playerid, MinyakTD[playerid][3], "MENGAMBIL MINYAK...");
    PlayerTextDrawTextSize(playerid, MinyakTD[playerid][1], 260.0, 0.0); 
    
    for(new i=0; i<4; i++) PlayerTextDrawShow(playerid, MinyakTD[playerid][i]);
    SelectTextDraw(playerid, 0xFFFF00FF);
    return 1;
}

CMD:792662725(playerid, params[])
{
    if(!MembawaMinyak[playerid]) return SendClientMessage(playerid, -1, "{FF0000}ERROR: {FFFFFF}Bawa minyak mentah dulu!");
    if(IsMinyakProc[playerid]) return 1;

    MinyakBar[playerid] = 30.0; 
    IsMinyakProc[playerid] = 2; 
    PlayerInfo[playerid][pMinyakbersih] += 2;
    OnPlayerUpdateAccountsPer(playerid, "pMinyakbersih", PlayerInfo[playerid][pMinyakbersih]);
  
    ApplyAnimation(playerid, "BARMAN", "BARcustom_getwash", 4.1, 1, 1, 1, 1, 1, 1);
    TogglePlayerControllable(playerid, 0);

    PlayerTextDrawSetString(playerid, MinyakTD[playerid][3], "PENYULINGAN (TAP CEPAT!)");
    
    for(new i=0; i<4; i++) PlayerTextDrawShow(playerid, MinyakTD[playerid][i]);
    SelectTextDraw(playerid, 0xFFFF00FF);
    
    TimerMinyak[playerid] = SetTimerEx("PerlawananMinyak", 200, true, "i", playerid);
    return 1;
}

forward PerlawananMinyak(playerid);
public PerlawananMinyak(playerid)
{
    if(IsMinyakProc[playerid] == 2)
    {
        MinyakBar[playerid] -= 4.5; 
        
        if(MinyakBar[playerid] <= 0.0)
        {
            KillTimer(TimerMinyak[playerid]);
            IsMinyakProc[playerid] = 0;
            MinyakBar[playerid] = 0.0;

            ClearAnimations(playerid);
            TogglePlayerControllable(playerid, 1);
            CancelSelectTextDraw(playerid);
            for(new i=0; i<4; i++) PlayerTextDrawHide(playerid, MinyakTD[playerid][i]);
            
            SendClientMessage(playerid, -1, "{FF0000}GAGAL: {FFFFFF}Tekanan mesin terlalu kuat! Penyulingan gagal.");
            PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
        }
        else 
        {
            new Float:bar_w = (MinyakBar[playerid] / 100.0) * 140.0;
            PlayerTextDrawTextSize(playerid, MinyakTD[playerid][1], 260.0 + bar_w, 0.0);
            PlayerTextDrawShow(playerid, MinyakTD[playerid][1]);
        }
    }
    return 1;
}

CMD:createweapon(playerid, params[])
{
    if(strlen(PlayerInfo[playerid][pFamName]) == 0)
    {
        ShowPanjulNotif(playerid, "Bukan anggota Family.");
        return 1;
    }

    if(PlayerInfo[playerid][pJobbm] == 0)
    {
        ShowPanjulNotif(playerid, "Bukan pekerja ilegal.");
        return 1;
    }

    if(IsPlayerInRangeOfPoint(playerid, 10.0, 291.156524, -106.223526, 1001.515625))
    {
