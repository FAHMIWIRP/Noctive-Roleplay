/* 	for(new i = 0; i < 6; i++)
    {
   	TextDrawShowForPlayer(playerid, TRPRAZZ[0]);
	TextDrawShowForPlayer(playerid, TRPRAZZ[1]);
  	}*/
    for(new i = 0; i < 8; i++)
