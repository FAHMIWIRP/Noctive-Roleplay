CMD:acceptdeath(playerid)
{
	if(GetPlayerData(playerid, pInjured) == 0) return Error(playerid, "Anda Tidak Sedang Pingsan.");
	if(GetPVarInt(playerid,"pTimeDeath") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 10 Menit");
	SetPlayerHealthEx(playerid, 100);
	ClearAnimations(playerid);
	SetPlayerData(playerid, pInjured, 0);
	update_int_mysql(playerid, "pInjured", 0);
 	PlayerTextDrawHide(playerid, TD_DeathLayar[playerid][0]);
    PlayerTextDrawHide(playerid, TD_DeathLayar[playerid][1]);
	SetPVarInt(playerid, "pTimeDeath", gettime() + 600);
	
	// Biaya pengobatan
    if(GetPlayerMoneyEx(playerid) >= 500)
        GivePlayerMoneyEx(playerid, -500);
    else
        GivePlayerMoneyEx(playerid, -GetPlayerMoneyEx(playerid));

    // Sita semua barang ilegal
    PlayerInfo[playerid][pCrack] = 0;
    PlayerInfo[playerid][pGun] = 0;
    PlayerInfo[playerid][pMicin] = 0;
    PlayerInfo[playerid][pPaketrm] = 0;
    PlayerInfo[playerid][pRedmoney] = 0;
    PlayerInfo[playerid][pMetall] = 0;
    PlayerInfo[playerid][pKanabis] = 0;

    // Save ke database
    OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pCrack]);
    OnPlayerUpdateAccountsPer(playerid, "pGun", PlayerInfo[playerid][pGun]);
    OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
    OnPlayerUpdateAccountsPer(playerid, "pPaketrm", PlayerInfo[playerid][pPaketrm]);
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    OnPlayerUpdateAccountsPer(playerid, "pKanabis", PlayerInfo[playerid][pKanabis]);

    // Spawn di RS
    SetPlayerPos(playerid, 1343.695678, 1567.952514, 23223.085937);

    // Text RS warna pink pudar
    SendClientMessage(playerid, 0xFFB6C1FF, "=================================");
    SendClientMessage(playerid, 0xFFB6C1FF, " Rumah Sakit Noctive");
    SendClientMessage(playerid, 0xFFB6C1FF, "=================================");
    SendClientMessage(playerid, 0xFFB6C1FF, "Kamu terbangun di rumah sakit karena koma.");
    SendClientMessage(playerid, 0xFFB6C1FF, "Seluruh barang ilegal kamu telah di sita dan");
    SendClientMessage(playerid, 0xFFB6C1FF, "kamu membayar $500 untuk biaya pengobatan.");
    SendClientMessage(playerid, 0xFFB6C1FF, "Sayangilah nyawa mu bukan harta mu");
    SendClientMessage(playerid, 0xFFB6C1FF, "======================================");

    return 1;
}

CMD:getveh(playerid, params[])
{
    // Cek level admin
    if(admin_level[playerid] < 2) return 1;

    new to_player;
    // Menggunakan 'u' agar bisa mengetik ID atau sebagian Nama player
    if(sscanf(params, "u", to_player)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Gunakan: /getveh [playerid/nama]");

    // Cek apakah player target login
    if(!IsPlayerConnected(to_player)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Player tersebut tidak sedang login.");

    new car_id = GetPlayerUseListitem(to_player);
    new vehicleid = player_home_car[to_player][car_id];

    // Validasi agar admin tidak crash/error jika player belum spawn kendaraan
    if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Player tersebut belum mengeluarkan kendaraan.");

    // Variabel yang lebih rapi dibanding Float:VYog[4]
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    
    // Set posisi, virtual world, dan interior kendaraan agar sama dengan admin
    SetVehiclePos(vehicleid, x, y, z + 1.0);
    SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
    LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));

    // Notifikasi ke player pemilik kendaraan
    new str[128];
    format(str, sizeof(str), "{5996FF}[ INFO ]{FFFFFF} Administrator {FF3838}%s{FFFFFF} telah menarik kendaraan Anda.", Name(playerid));
    SendClientMessage(to_player, -1, str);
    
    SaveCars(playerid);

    // Notifikasi ke sesama Admin
    format(str, sizeof(str), "[A] Administrator %s telah menarik kendaraan %s.", Name(playerid), Name(to_player));
    SendAdminMessage(COLOR_GREY, str);

    return 1;
}

CMD:gotoveh(playerid, params[])
{
    // Cek level admin
    if(admin_level[playerid] < 2) return 1;

    new to_player;
    if(sscanf(params, "u", to_player)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Gunakan: /gotoveh [playerid/nama]");

    // Cek apakah player target login
    if(!IsPlayerConnected(to_player)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Player tersebut tidak sedang login.");

    new car_id = GetPlayerUseListitem(to_player);
    new vehicleid = player_home_car[to_player][car_id];

    // Validasi agar admin tidak teleport ke tempat antah berantah
    if(vehicleid == 0 || vehicleid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Player tersebut belum mengeluarkan kendaraan.");

    new Float:x, Float:y, Float:z;
    GetVehiclePos(vehicleid, x, y, z);
    
    // Set posisi admin, virtual world, dan interior agar sesuai dengan posisi kendaraan
    SetPlayerPos(playerid, x + 1.5, y, z); // Ditambah X agar tidak nyangkut di dalam mobil
    SetPlayerVirtualWorld(playerid, GetVehicleVirtualWorld(vehicleid));    

    // Notifikasi ke sesama Admin
    new str[128];
    format(str, sizeof(str), "{FF38A8}[A] {FFFFFF}Admin %s telah menarik kendaraan %s.", Name(playerid), Name(to_player));
    SendAdminMessage(COLOR_GREY, str);

    return 1;
}

