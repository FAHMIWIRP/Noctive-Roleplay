stock BulletTazer(playerid, suspectid)
{
	if(GetPVarInt(suspectid, "fTazzer") != 0) return Send(playerid, COLOR_GREY, "Pemain sudah dilumpuhn, gunakan /cuff untuk memborgol.") & 0;

	SCMF(playerid, -1, "Anda telah menetralisir pemain %s[%d] selama 15 detik", Name(suspectid), suspectid);
    format(String, 96, "%s dinetralkan %s pistol setrum", Name(playerid), Name(suspectid));
	ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);

	TogglePlayerControllableEx(suspectid, 0);
  	ApplyAnimation(suspectid, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
  	timer_tazer[suspectid] = SetTimerEx("ClearFreeze", 15000, false, "d", suspectid);

	SetPVarInt(suspectid, "fTazzer", 1);
  	SPD(suspectid, 0, DIALOG_STYLE_MSGBOX, "{E5D81E}Anda dinetralkan oleh jijik", ""W"Anda dinetralkan oleh setrum\nAnda tidak dapat bergerak selama 15 detik.", "Tutup", "");
	return 0;
}
