{
	{
	if(IsCrates[playerid] == 1) return true;
	if(CrateTime[playerid] > 0) return true;
	ShowCrates(playerid);
	}
	return true;
}*/
function ShowCrates(playerid) {
	new string[64];
	PlayerTextDrawSetPreviewModel(playerid, CratePTD[0], 18631);
	format(string, sizeof(string), "select action ~n~you have %d crates.", totalcrates(playerid));
	PlayerTextDrawSetString(playerid, CratePTD[1], string);
	for(new i = 0; i < 6; i++) TextDrawShowForPlayer(playerid, CrateTD[i]);
	PlayerTextDrawShow(playerid, CratePTD[1]);
	PlayerTextDrawShow(playerid, CratePTD[0]);
	SelectTextDraw(playerid, 0xCA3ADBFF);
	IsCrates[playerid] = 1;
	return true;
}
function totalcrates(playerid)
{
	new x;
	x = PlayerInfo[playerid][pCrates][0] + PlayerInfo[playerid][pCrates][1] + PlayerInfo[playerid][pCrates][2] + PlayerInfo[playerid][pCrates][3] + PlayerInfo[playerid][pCrates][4];
	return x;
}
function startcrates(playerid)
{
	for(new l = 0; l < 6; l++) TextDrawShowForPlayer(playerid, CrateTD[l]);
	opencrates(playerid);
	PlayerTextDrawShow(playerid, CratePTD[1]);
	TimerCratesEx[playerid] = SetTimerEx("opencrates", 500, true, "d", playerid);
	return true;
}
save_crates(playerid)
{
	new query[128];
	mysql_format(mMysql, query, sizeof(query), "UPDATE `accounts` SET `Crates`='%d|%d|%d|%d|%d' WHERE `id`='%d'", PlayerInfo[playerid][pCrates][0],PlayerInfo[playerid][pCrates][1],PlayerInfo[playerid][pCrates][2],PlayerInfo[playerid][pCrates][3], PlayerInfo[playerid][pCrates][4], PlayerInfo[playerid][pID]);
	mysql_tquery(mMysql, query,  "", "" );
}
function opencrates(i)
{
	gString[0] = EOS;
	CrateTime[i] --;
	new u_car_1 = GetPlayerFreeCarSlot(i);
	new amount, rand = random(100), x = !CrateModel[i] ? 0 : CrateModel[i]-1;
	if(CrateModel[i] != 5)
	{
		switch(rand)
		{
	    	case 0..10:
			{
			    amount = 24;
	            format(gString, 70, "skin %d (%s)~n~~w~~h~you have %d crates.", amount, CrateName[x], totalcrates(i));
	            PlayerTextDrawSetPreviewModel(i, CratePTD[0], amount);
	            PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
	            if(CrateTime[i] == 0)
				{
			    	if(CrateModel[i] <= 0)
					{
			    		format(gString, 100,"%s, he opened a test box and you could skin %d (%s).", GetName(i), amount, CrateName[x]);
			    		SCM(i, COLOR_WHITE, gString);
	            	}
					else
					{
						format(gString, 120,"(( {%s}%s Crate {A9C4E4}- %s he opened a crate and got skin %d [%s]. ))", CrateColors[x], CrateName[x], GetName(i), amount, CrateName[x]);
		    			SCMTA(COLOR_CLIENT, gString);
					    //give_skin(i, amount);
					    PlayerInfo[i][pSkin] = 29;
						SetPlayerSkinEx(i, 29);
					    OnPlayerUpdateAccountsPer(i, "pSkin", 29);
	            	}
	            	KillTimer(TimerCratesEx[i]);
	                CrateModel[i] = -1;
	            }
			}
		    case 11..30:
			{
			    amount = random(5) + x * 4;
	            format(gString, 75, "~y~%s Respect Points~n~~w~~h~you have %d crates.", FormatNumber(amount), totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1275);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
	            if(CrateTime[i] == 0)
				{
			        if(CrateModel[i] <= 0)
					{
					    format(gString, 120,"%s, he opened a test box and you could have won %d Respect Points.", GetName(i),amount);
					    SCM(i, COLOR_WHITE, gString);
					}
					else
					{
						format(gString, 120,"(( {%s}%s Crate {A9C4E4}- %s opened a crate and received %d Respect Points. ))", CrateColors[x], CrateName[x], GetName(i),amount, CrateName[x]);
					    SCMTA(COLOR_CLIENT, gString);
					    PlayerInfo[i][pExp] += amount;
					}
			        KillTimer(TimerCratesEx[i]);
			        CrateModel[i] = -1;
			    }
	        }
	       	case 31..40:
		    {
			    amount = 1 + random(10) + x * 20;
	            format(gString, 75, "~y~%s Premium Points~n~~w~~h~you have %d crates.", FormatNumber(amount), totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1275);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
	            if(CrateTime[i] == 0)
				{
			        if(CrateModel[i] <= 0)
					{
					    format(gString, 120,"%s, he opened a test box and you could win %d Premium Points.", GetName(i),amount);
					    SCM(i, COLOR_WHITE, gString);
					}
					else
					{
						format(gString, 120,"(( {%s}%s Crate {A9C4E4}- %s opened a crate and received %d Premium Points.))", CrateColors[x], CrateName[x], GetName(i),amount);
					    SCMTA(COLOR_CLIENT, gString);
					    PlayerInfo[i][pRouble] += amount;
					}
			        KillTimer(TimerCratesEx[i]);
			        CrateModel[i] = -1;
			    }
	        }
	        default:
			{
	            amount = random(2000000) + x * 2000000;
	            format(gString, 65, "~g~%s~n~~w~~h~you have %d crates.", FormatNumber(amount), totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1274);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
	            if(CrateTime[i] == 0)
				{
			        if(CrateModel[i] <= 0)
					{
					    format(gString, 120,"%s, he opened a test box and you could win $%s.", GetName(i), FormatNumber(amount));
					    SCM(i, COLOR_WHITE, gString);
					}
					else
					{
						format(gString, 120,"(( {%s}%s Crate {A9C4E4}- %s he opened a crate and received {50DB6F}$%s{A9C4E4}. ))", CrateColors[x], CrateName[x], GetName(i), FormatNumber(amount));
					    SCMTA(COLOR_CLIENT, gString);
					    GivePlayerMoneyEx(i, amount,"");
					}
				    KillTimer(TimerCratesEx[i]);
				    CrateModel[i] = -1;
		        }
	        }
	    }
	}
 	else
 	{
		switch(rand)
		{
   			case 0..12:
  			{
                format(gString, 65, "Bullet ~n~~w~~h~you have %d crates.", totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 541);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
                if(CrateTime[i] <= 0)
				{
					if(u_car_1 == -1)
    				{
						PlayerInfo[i][pCrates][4] ++; save_crates(i); SCM(i, COLOR_LIGHTGREEN, "You don't have a free slot");  CrateModel[i] = -1; KillTimer(TimerCratesEx[i]); return true;
					}
					else
					{
						KillTimer(TimerCratesEx[i]);
						CrateModel[i] = -1;
						GiveVehicle(i, 541);
						//GiveVehicle(i, 541, 0, 0, 0, 0, 0);
					    format(gString, 120, "(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Bullet. ))", GetName(i));
					    SCMTA(COLOR_CLIENT, gString);
				    }
				}
			}
           	case 13..22:
   			{
                format(gString, 65, "ticket (RAINBOW)~n~~w~~h~you have %d crates.", totalcrates(i));
                PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1581);
                PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
            	if(CrateTime[i] <= 0)
				{
					KillTimer(TimerCratesEx[i]);
					CrateModel[i] = -1;
					PlayerInfo[i][pRouble] += 1;
				    format(gString, 120,"(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Rainbow Ticket. ))", GetName(i));
				    SCMTA(COLOR_CLIENT, gString);
				}
            }
           	case 23..33:
	   		{
                format(gString, 65, "ticket (VIP)~n~~w~~h~you have %d crates.", totalcrates(i));
                PlayerTextDrawSetPreviewModel(i, CratePTD[0], 1581);
                PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
            	if(CrateTime[i] <= 0)
				{
					KillTimer(TimerCratesEx[i]);
					CrateModel[i] = -1;
					PlayerInfo[i][pRouble] += 1;
				    format(gString, 120,"(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Vip Ticket. ))", GetName(i));
				    SCMTA(COLOR_CLIENT,gString);
				}
            }
   			case 34..46:
	   		{
                format(gString, 65, "Cheetah~n~~w~~h~you have %d crates.", totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 415);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
                if(CrateTime[i] <= 0)
				{
					if(u_car_1 == -1)
					{
						PlayerInfo[i][pCrates][4] ++; save_crates(i); SCM(i, COLOR_LIGHTGREEN, "You don't have a free slot");  CrateModel[i] = -1; KillTimer(TimerCratesEx[i]); return true;
					}
					else
					{
						KillTimer(TimerCratesEx[i]);
						CrateModel[i] = -1;
						GiveVehicle(i, 415);
						//GiveVehicle(i, 415, 0, 0, 0, 0, 0);
					    format(gString, 120, "(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and got Cheetah. ))", GetName(i));
					    SCMTA(COLOR_CLIENT, gString);
				    }
				}
			}
            default:
			{
                format(gString, 65, "Perrenial~n~~w~~h~you have %d crates.", totalcrates(i));
				PlayerTextDrawSetPreviewModel(i, CratePTD[0], 404);
				PlayerTextDrawSetString(i, CratePTD[1], gString);
				PlayerTextDrawShow(i, CratePTD[0]);
            	if(CrateTime[i] <= 0)
				{
					if(u_car_1 == -1)
					{
						PlayerInfo[i][pCrates][4] ++; save_crates(i); SCM(i, COLOR_LIGHTGREEN, "You don't have a free slot");  CrateModel[i] = -1; KillTimer(TimerCratesEx[i]); return true;
					}
					else
					{
						KillTimer(TimerCratesEx[i]);
						CrateModel[i] = -1;
						GiveVehicle(i, 404);
						ShowPlayerDialog(i, 0, DIALOG_STYLE_MSGBOX, "{00FF00}Winner Car", ""W"{33AA33}Selamat Anda Mendapatkan Mobil Perrenial Silahkan Cek /mv", "Tutup", "");
						//GiveVehicle(i, 404, 0, 0, 0, 0, 0);
					    format(gString, 120,"(( {7556ff}Vehicle Crates {A9C4E4}- %s he opened a crate and received Perrenial.))", GetName(i));
					    SCMTA(COLOR_CLIENT, gString);
				    }
				}
            }
		}
    }
	return true;
}
stock GiveVehicle(playerid, model)
{
    new u_car_1 = GetPlayerFreeCarSlot(playerid);

    CarInfo[playerid][cModel][u_car_1] = model;
    CarInfo[playerid][cColor1][u_car_1] = 0;
    CarInfo[playerid][cColor2][u_car_1] = 0;
    CarInfo[playerid][cFuel][u_car_1] = 100.0;
    CarInfo[playerid][cProbeg][u_car_1] = 0.0;
    CarInfo[playerid][cCost][u_car_1] = 100000;
    CarInfo[playerid][cWheels][u_car_1] = 0;
    CarInfo[playerid][cSpoiler][u_car_1] = 0;
    CarInfo[playerid][cBumper1][u_car_1] = 0;
    CarInfo[playerid][cBumper2][u_car_1] = 0;
    CarInfo[playerid][cPaintJobs][u_car_1] = 255;
    CarInfo[playerid][cNitro][u_car_1] = 0;
    CarInfo[playerid][cHydrawlic][u_car_1] = 0;
    CarInfo[playerid][cHood][u_car_1] = 0;
    CarInfo[playerid][cRoof][u_car_1] = 0;
    CarInfo[playerid][cSideskirt][u_car_1] = 0;
    CarInfo[playerid][cLamps][u_car_1] = 0;
    CarInfo[playerid][cExhaust][u_car_1] = 0;
    CarInfo[playerid][cStereo][u_car_1] = 0;
    CarInfo[playerid][cVentRight][u_car_1] = 0;
    CarInfo[playerid][cVentLeft][u_car_1] = 0;
    CarInfo[playerid][cHeal][u_car_1] = 1000.0;
    CarInfo[playerid][cLock][u_car_1] = 0;
    CarInfo[playerid][cDamagePanel][u_car_1] = 0;
    CarInfo[playerid][cDamageDoors][u_car_1] = 0;
    CarInfo[playerid][cDamageLights][u_car_1] = 0;
    CarInfo[playerid][cDamageTires][u_car_1] = 0;

    player_car_park[playerid][u_car_1][0] = 523.1088;
	player_car_park[playerid][u_car_1][1] = -1830.2756;
	player_car_park[playerid][u_car_1][2] = 5.6328;
	player_car_park[playerid][u_car_1][3] = 261.5410;

    SavePlayerCarPark(playerid);
    SaveCars(playerid);
}
FormatNumber( number ) {
   new Str[ 15 ];
   format( Str, 15, "%d", number );
   if( strlen( Str ) < sizeof( Str ) ) {
      if( number >= 1000 && number < 10000 ) strins(  Str, ",", 1, sizeof( Str ) );
      else if( number >= 10000 && number < 100000 ) strins( Str, ",", 2, sizeof( Str ) );
      else if( number >= 100000 && number < 1000000 ) strins( Str, ",", 3, sizeof( Str ) );
      else if( number >= 1000000 && number < 10000000 ) strins( Str, ",", 1, sizeof( Str ) ),strins( Str, ",", 5, sizeof( Str ) );
      else if( number >= 10000000 && number < 100000000 ) strins( Str, ",", 2, sizeof( Str ) ),strins( Str, ",", 6, sizeof( Str ) );
      else if( number >= 100000000 && number < 1000000000 ) strins( Str, ",", 3, sizeof( Str ) ),strins( Str, ",", 7, sizeof( Str ) );
      else if( number >= 1000000000 && number < 10000000000 )
           strins( Str, ",", 1, sizeof( Str ) ),
           strins( Str, ",", 5, sizeof( Str ) ),
           strins( Str, ",", 9, sizeof( Str ) );
      else format( Str, 10, "%d", number );
   }
   return Str;
}
CMD:crateforall(playerid, params[])
{
	new type, value;
	if(sscanf(params, "ii", type, value))
	{
		SCM(playerid, COLOR_GREY, "Syntax: {FFFFFF}/crateforall [crate type] [value]");
		SCM(playerid, COLOR_WHITE, "Rare (0) | Epic (1) | Legendary (2) | Transcendent (3) | Vehicle (4)");
		return true;
	}

	foreach(Player, i) PlayerInfo[i][pCrates][type] += value, save_crates(i);

	gString[0] = EOS;
	format(gString, 75, "Admin %s Memberikan Sejumlah tiket %d gatcha %s.", GetName(playerid), value, CrateName[type]);
	SCMTA(COLOR_YELLOW, gString);
	return true;
}

forward UpdateDamageBar(playerid, Text3D:bar3D, Float:amount, Float:offset, updated, color);
public UpdateDamageBar(playerid, Text3D:bar3D, Float:amount, Float:offset, updated, color) {
    if(!updated--) {
        Delete3DTextLabel(bar3D);
        return 1;
	}
    new damageStr[HEALTH_LENGTH];
    valstr(damageStr, floatround(amount));
    offset += HEALTH_OFFSETADD;
    color -= COLOR_DELETE;
    Update3DTextLabelText(bar3D, color, damageStr);
    #if defined HEALTH_OFFSETADD
        Attach3DTextLabelToPlayer(bar3D, playerid, 0.0, 0.0, offset);
    #endif
    SetTimerEx("UpdateDamageBar", TIME_BLOW, 0, "iiffii", playerid, _:bar3D, amount, offset, updated, color);
    return 1;
}
stock SpawnDeathMatch(const playerid)
{
    GivePlayerWeapon(playerid, 24, 999);//berikan pemain 999 putaran Deagle
    GivePlayerWeapon(playerid, 25, 999);//berikan pemain 999 putaran ShotGun
    GivePlayerWeapon(playerid, 31, 999);//berikan pemain 999 putaran M4
    SetPlayerHealth(playerid, 100);//menempatkan pemain 100 HP
