CMD:hapustoys(playerid)
{
    for(new i=0; i<MAX_PLAYER_ATTACHED_OBJECTS; i++)
    {
    	if(IsPlayerAttachedObjectSlotUsed(playerid, i)) RemovePlayerAttachedObject(playerid, i);
    }
    return 1;
}
CMD:sm(playerid, params[])
{
    new W4YER[500], countpd, countmd;

    new
        begalstr[64],
        perangstr[64],
        robbankstr[64];
        /*warungstr[64],
        perangstr[64];*/

    foreach(new i : Player) if(IsACop(i))
    {
        countpd++;
    }

    foreach(new i : Player) if(IsAMedic(i))
    {
        countmd++;
    }

    if(countpd > 3  && countpd < 10 && countmd > 1 && countmd < 7)
    {
        format(begalstr, sizeof(begalstr), "{00FF00}Boleh");
        format(perangstr, sizeof(perangstr), "{00FF00}Boleh");
        format(robbankstr, sizeof(robbankstr), "{00FF00}Boleh");
        //format(warungstr, sizeof(warungstr), "{00FF00}Boleh");
    }
    else
    {
        format(begalstr, sizeof(begalstr), "Mendung");
        format(perangstr, sizeof(perangstr), "Mendung");
        format(robbankstr, sizeof(robbankstr), "Mendung");
        //format(warungstr, sizeof(warungstr), "Mendung");
    }

    if(countpd > 14 && countmd > 5)
    {
        format(begalstr, sizeof(begalstr), "{00FF00}Boleh");
        format(perangstr, sizeof(perangstr), "{00FF00}Boleh");
        format(robbankstr, sizeof(robbankstr), "{00FF00}Boleh");
        /*format(warungstr, sizeof(warungstr), "{00FF00}Boleh");
        format(perangstr, sizeof(perangstr), "{00FF00}Boleh");*/
    }
    else
    {
        format(perangstr, sizeof(perangstr), "Mendung");
    }


    format(W4YER, sizeof(W4YER), "{FFFFFF}Kegiatan Roleplay\t{FFFFFF}Keperluan\t{FFFFFF}Status\n\
    {FFFFFF}Begal/Copet/Ladang\t4 Police & 2 EMS\t%s\n\
    {FFFFFF}Peperangan\t5 Police & 3 EMS\t%s\n\
	{FFFFFF}Robbery\t8 Police & 5 EMS\t%s\n\
    ", begalstr, perangstr, robbankstr
    );

    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, "{33AAFF}Noctive - {FFFFFF}Status Mendung", W4YER, "Close", "");
    return 1;
}
