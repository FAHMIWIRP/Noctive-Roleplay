				}
				case 4: // Create Nomor Rekening
				{
				    // 1. Cek apakah player sudah memiliki nomor rekening
				    if(PlayerInfo[playerid][pNorek] != 0)
				        return SCM(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda sudah memiliki nomor rekening!");

				    new randNorek;
				    new bool:isUnique = false;

				    // 2. Looping untuk mencari 7 digit angka unik
				    while(!isUnique)
				    {
				        // Generate angka dari 1000000 sampai 9999999 (Pasti 7 digit)
				        randNorek = 1000000 + random(9000000);
				        isUnique = true;

				        // Cek apakah ada player online lain yang memakai nomor ini
				        for(new i = 0; i < MAX_PLAYERS; i++)
				        {
				            if(IsPlayerConnected(i))
				            {
				                if(PlayerInfo[i][pNorek] == randNorek)
				                {
				                    isUnique = false; // Nomor sudah dipakai, ulangi while loop
				                    break;
				                }
				            }
				        }
				    }

				    // 3. Berikan nomor rekening tersebut ke player
				    PlayerInfo[playerid][pNorek] = randNorek;

				    // 4. Kirim notifikasi sukses
				    new str[128];
				    format(str, sizeof(str), "{55FF55}[ BANK ]{FFFFFF} Berhasil membuat rekening! Nomor Rekening Anda: {FFEC00}%d", randNorek);
				    SCM(playerid, -1, str);

				    // CATATAN: Pastikan kamu menjalankan fungsi Save akun/database di sini
				    // Contoh: SavePlayer(playerid); atau UPDATE query MySQL
				}
			}
			ApplyAnimation(playerid, "CRIB", "CRIB_Use_Switch",4.0,0,0,0,0,0), PlayerPlaySound(playerid, 4203, 0,0,0);
		}
