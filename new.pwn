CMD:selesaiberubah(playerid, params[])
{
      if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
    for(new i = 0; i < 9; i++)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, i))
        {
            RemovePlayerAttachedObject(playerid, i);
        }
    }

    SendClientMessage(playerid, -1, "[INFO] Kamu telah selesai berubah dan semua object telah dilepas!");
    return 1;
}
CMD:aduty(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
    {
        if(OnDuty[playerid] == 0)
        {
            new string[217];
            if(admin_level[playerid] < 1) return 1;
           	if(!strcmp(pData[playerid][pAname], "None"))
        		return Error(playerid, "Kamu harus setting Nama Admin mu (/setadminname)!");
            if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
            PlayerInfo[playerid][pDutyAdmin] = 1;
            OnDuty[playerid] = 1;
            SetPlayerName(playerid, PlayerInfo[playerid][pAname]);
        	IsWatchVehLog[playerid] = 1;
         	PlayerData[playerid][pTogTP] = 1;
            SetPlayerColor(playerid, 0xFF0000FF);
            format(string, sizeof(string), "{FFB6C1}[ ADMINS ] {FF0000}%s {FFFFFF}sekarang {00FF00}On Duty{FFFFFF}. Butuh bantuan? Ketik {FFFF00}/ask {FFFFFF}atau {FFFF00}/report", PlayerInfo[playerid][pAname]);
            SendClientMessageToAll(-1, string);

		}
		else
		{

			new string[217];
            if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return 1;
            SetPlayerName(playerid, PlayerInfo[playerid][pName]);
            PlayerInfo[playerid][pDutyAdmin] = 0;
            OnDuty[playerid] = 0;
            PlayerData[playerid][pTogTP] = 0;
            SetPlayerColor(playerid, COLOR_WHITE);
            format(string, sizeof(string), "{FFB6C1}[ ADMINS ] {FF0000}%s {FFFFFF}sekarang {FF0000}Off Duty", PlayerInfo[playerid][pAname]);
            SendClientMessageToAll(-1, string);
        }
    }
    return 1;
}

