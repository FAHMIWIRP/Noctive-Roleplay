	if(dialogid == DIALOG_PHONE_ADDCONTACT) {
		
		if(!response) return 1;
		new numbersid = strval(inputtext);
		static
		    name[32];

		strunpack(name, pData[playerid][pEditingItem]);

	    if(strlen(inputtext) != 6)
	    {
	        format(String, sizeof(String), ""W"Masukkan nomor telepon untuk kontak tersebut %s\n\nAngka hanya dapat memuat 6 karakter", name);
			SPD(playerid,DIALOG_PHONE_ADDCONTACT,DIALOG_STYLE_INPUT,"{a86cfc}Menambahkan kontak baru", String, "Tambah","Batalkan");
			return 1;
		}
	    if(isNum(inputtext))
		{
	 		format(String, sizeof(String), ""W"Masukkan nomor telepon untuk kontak tersebut %s\n\n Angka hanya dapat berisi angka", name);
			SPD(playerid,DIALOG_PHONE_ADDCONTACT,DIALOG_STYLE_INPUT,"{a86cfc}Menambahkan kontak baru", String, "Tambah","Batalkan");
			return 1;
		}
		SCMF(playerid, -1, "{09D6C7}%s "W"telah berhasil ditambahkan ke daftar kontak Anda. Gunakan /book", name);
		format(MySQLStr, 128, "INSERT INTO `book` (`plID`, `nName`, `nNumber`) VALUES (%d,'%s',%d)", PlayerInfo[playerid][pID], name, numbersid), mysql_tquery(mMysql, MySQLStr, "", "");
		return 1;
	}
    switch(dialogid)
	{
	    case HP_SMS:
	    {
	        if(response)
	        {
	        new nomor, text[116];
	        if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor.");
			if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Pulsa Tidak Cukup");
			if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara");

			if(sscanf(inputtext, "p<,>ds[116]", nomor, text)) return SPD(playerid, HP_SMS, DIALOG_STYLE_INPUT, "Sms", "[nomor] [text]\nContoh: 164164, Assalamualaikum", "Kirim", "Batal");

			if(nomor < 0 || nomor > 999999) return Send(playerid, COLOR_GREY,"Nomor ponsel yang ditentukan tidak valid.");
		    if(nomor == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat mengirim pesan kepada diri sendiri.");
		    new full = 0;

		    foreach(new i : Player)
			{
		        if(nomor == PlayerInfo[i][pNumber] && nomor != 0)
				{
		            if(PhoneOnline[i] != 0) return Send(playerid, COLOR_GREY, "Telepon pengirim mati");

		            full++;
		            PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		            SetPlayerChatBubble(playerid, "SMS >>" ,COLOR_YELLOW,10.0,5000), SetPlayerChatBubble(i, "SMS <<",COLOR_YELLOW,10.0,5000);

		            SCMF(i, COLOR_YELLOW, "SMS: %s. Pengirim: %s(%i)[Telp. %d]", text, Name(playerid), playerid, PlayerInfo[playerid][pNumber]);
		            SCMF(playerid, COLOR_YELLOW, "SMS: %s. Penerima: %s(%i)[Telp. %d]", text, Name(i), i, PlayerInfo[i][pNumber]);

		            foreach(new x : admin_list) if(player_admin_sms[x]) SCMF(x, COLOR_YELLOW, "[A][SMS] %s[%i] -> %s[%i]: %s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(i), i, text);

		            if(afk_time[i] > 5) Send(playerid, COLOR_GREY, "Pesan berhasil terkirim. Pemutar SMS dalam AFK.");

					PlayerInfo[playerid][pSummaNumber] -= strlen(text)*2/2;
					format(String, 18, "~y~-$%d", strlen(text)*2/2), GameTextForPlayer(playerid, String, 1500, 1), GameTextForPlayer(i, "~y~SMS", 1500, 1);
					break;
		   		}
			}
			if(full == 0) return Send(playerid, COLOR_GREY,"Nomor ini tidak ada atau pemilik nomor sedang luring.");
			}
	    }
		case HP_CALL:
	    {
	        if(response)
            {
                new number;
                if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor!");
                if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda Sedang Dimute, Mendapatkan Larangan Berbicara");

				if (sscanf(inputtext, "i", number))
				{
					return ShowPlayerDialog(playerid, HP_CALL, DIALOG_STYLE_INPUT, "{6688FF}Telepon", "Masukan Nomer Telepon:", "Call", "Batal");
				}

				PlayerInfo[playerid][pSummaNumber] -= 1000;
				format(String, 18, "~y~-$%d", 1000), GameTextForPlayer(playerid, String, 1500, 1);

				SetPlayerAttachedObject(playerid,0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
			    ApplyAnimation(playerid,"PED","phone_in", 4.1, 0, 1, 1, 1, 1, 1);
			    SetPVarInt(playerid, "UsingAnim", 1);
				if(Mobile[playerid] != -1) return Send(playerid, COLOR_GREY, "Anda sudah berbicara di telepon.");
				if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Pulsa Tidak Cukup");

				format(String, 86, "%s mengeluarkan ponsel",Name(playerid));
				ProxDetector(10.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
				if(number == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat menyebut diri Anda sendiri, salurannya sibuk.");

			    if(number == 911) return SPD(playerid, 8949, DIALOG_STYLE_INPUT, "Panggilan polisi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
				if(number == 03) return SPD(playerid, 8950, DIALOG_STYLE_INPUT, "Panggilan Ambulans", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");

				for(new i = 70; i <= 72; i++)
				{
					if(!BizzInfo[i][bPhone] || number != BizzInfo[i][bPhone]) continue;

					SetPlayerUseListitem(playerid, i);

					return SPD(playerid, 8948, DIALOG_STYLE_INPUT, "Panggilan taksi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
				}

				foreach(new i : Player)
				{
					if(PlayerInfo[i][pNumber] == number && number != 0)
					{
						Mobile[playerid] = i;

						if(PhoneOnline[Mobile[playerid]] > 0) return Send(playerid, COLOR_GREY, "Telepon pemanggil mati...");

						if(Mobile[Mobile[playerid]] == -1)
						{
						    Send(Mobile[playerid], -1, "Ponsel Anda berdering. Masuk {43CC0E}(/p)"W" untuk menjawab.");
			                PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

							format(String, 86, "%s telepon berdering", Name(i)), SetPlayerChatBubble(i, String, COLOR_PURPLE, 10.0, 5000);
							SetPlayerAttachedObject(playerid, 0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
							SetPlayerSpecialAction(playerid, 11);
							CellTime[playerid] = 1;
							break;
						}
					}
				}
			}
		}
