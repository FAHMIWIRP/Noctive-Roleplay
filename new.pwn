stock SavePlayerPerfomanceTune(playerid)
{
	format(command_text, 312, "UPDATE `accounts` SET `engine_tune` = '%i,%i,%i,%i,%i|%i,%i,%i,%i,%i|%i,%i,%i,%i,%i' WHERE `pID` = %i",
	player_engine_tune[playerid][0][0],player_engine_tune[playerid][0][1],player_engine_tune[playerid][0][2],player_engine_tune[playerid][0][3],player_engine_tune[playerid][0][4],
	player_engine_tune[playerid][1][0],player_engine_tune[playerid][1][1],player_engine_tune[playerid][1][2],player_engine_tune[playerid][1][3],player_engine_tune[playerid][1][4],
	player_engine_tune[playerid][2][0],player_engine_tune[playerid][2][1],player_engine_tune[playerid][2][2],player_engine_tune[playerid][2][3],player_engine_tune[playerid][2][4],
	PlayerInfo[playerid][pID]);

	mysql_tquery(mMysql, command_text);

	format(command_text, 312, "UPDATE `accounts` SET `brake_tune` = '%i,%i,%i,%i,%i|%i,%i,%i,%i,%i|%i,%i,%i,%i,%i' WHERE `pID` = %i",
	player_brake_tune[playerid][0][0],player_brake_tune[playerid][0][1],player_brake_tune[playerid][0][2],player_brake_tune[playerid][0][3],player_brake_tune[playerid][0][4],
	player_brake_tune[playerid][1][0],player_brake_tune[playerid][1][1],player_brake_tune[playerid][1][2],player_brake_tune[playerid][1][3],player_brake_tune[playerid][1][4],
	player_brake_tune[playerid][2][0],player_brake_tune[playerid][2][1],player_brake_tune[playerid][2][2],player_brake_tune[playerid][2][3],player_brake_tune[playerid][2][4],
	PlayerInfo[playerid][pID]);

	mysql_tquery(mMysql, command_text);

	return printf("Saved Perfomance Tuning %s", GetPlayerNameEx(playerid));
}

stock SendFamilyMessage(f_id, text[])
{
	format(format_string, 144, "[%s] %s", family_info[f_id][f_name], text);

	foreach(Player, i)
		if(GetPlayerData(i, pFamily) == f_id)
			SCM(i, family_chat_color_big[ family_info[f_id][f_color] ], format_string);
}

stock ShowFamilyInfo(playerid, f_id)
{
	if(family_info[f_id][f_use] == 0) return SCM(playerid, -1, "Keluarga tidak digunakan!");

	new online = 0;

	foreach(Player, i) if(GetPlayerData(i, pFamily) == f_id) online++;

	format(format_string, 144, "SELECT `pName`, `family_rang` FROM `accounts` WHERE `family` = %i ORDER BY `family_rang` DESC", f_id);
	new Cache: result = mysql_query(mMysql, format_string, true);

    new rows = cache_num_rows();

	format(String, 300,
	"{FFFFFF}Keluarga %s[%i] \n\n\
	Komposisi keluarga: %i pemain\n\
	Online: %i pemain\n\
	Tanggal pembuatan: %s\n\n\
	Pencipta keluarga: %s\n",
	family_info[f_id][f_name], f_id, rows, online, family_info[f_id][f_create_date], family_info[f_id][f_owner]);

	//

	new name[MAX_PLAYER_NAME], rang, count = 0;

	new str[64];

	for(new i = 1; i < rows; i++)
	{
	    cache_get_value_int(i, "family_rang", rang);

	    if(rang < 2) continue;

	    cache_get_value_name(i, "pName", name);

	    format(str, 64, "Wakil %i: %s\n", count + 1, name);
	    strcat(String, str);

	    count++;
	}

	cache_delete(result);

	return ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX, "Informasi Keluarga", String, "Tutup", "");
}

stock IsFamilyHaveHouse(f_id)
{
	for(new i; i < MAX_HOUSES; i++) if(HouseInfo[i][hOwned] == 1 && strfind(HouseInfo[i][hOwner], family_info[f_id][f_owner], true) != -1) return i;

	return -1;
}
