    if(_:trash_vehicle_3d[vehicleid] == 0)
		trash_vehicle_3d[vehicleid] = CreateDynamic3DTextLabel(format_string, COLOR_YELLOW, 0.0, 0.0, 0.0, 15.0, INVALID_PLAYER_ID, vehicleid, 0,0,0);
	else
		UpdateDynamic3DTextLabelText(trash_vehicle_3d[vehicleid], COLOR_YELLOW, format_string);

	return 1;
}
