CMD:pldbsbbdbant(playerid, params[])
{
    new f_id = GetPlayerData(playerid, pFamily);
    if(!IsAGang(playerid) && f_id == -1) return SCM(playerid, COLOR_GREY, "{FF0000}Anda Tidak Dapat Menggunakannya.");
    if(IsPlayerInRangeOfPoint(playerid,200.0,-358.9692,-1440.1328,24.4144))
    {
        if(PlayerInfo[playerid][pLevel] < 2) return ShowError(playerid, "Tersedia dari level 2!");
        if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak bisa menggunakan command ini di dalam kendaraan");
        if(PlayerDrugData[playerid][Seeds] < 1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak memiliki seeds drugs");
        if(Player_PlantCount(playerid) >= MAKSIMAL_PLANT_DITANAM) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak bisa menanam drugs seeds lagi max 10 bibit yang ditanam!");
        if(GetClosestPlant(playerid) != -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Tidak bisa plant drugs lagi dikarenakan ada plant lain yang dekat kamu");
        new id = Iter_Free(Plants);
        if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Server drug plant limited telah tercapai!");
        GetPlayerName(playerid, PlantData[id][plantedBy], MAX_PLAYER_NAME);
        GetPlayerPos(playerid, PlantData[id][plantX], PlantData[id][plantY], PlantData[id][plantZ]);
        PlantData[id][plantGrowth] = 0;
        PlantData[id][plantObj] = CreateDynamicObject(3409, PlantData[id][plantX], PlantData[id][plantY], PlantData[id][plantZ] - 1.70, 0.0, 0.0, 0.0);
        SetDynamicObjectMaterial(PlantData[id][plantObj], 2, 19478, "signsurf", "sign", 0xFFFFFFFF);
        new label_string[128];
        format(label_string, sizeof(label_string), "Drug Plant (%d)\n\n{FFFFFF}Placed by %s\nGrowth: {E74C3C}0%%\n\n{FFFFFF}Gunakan /harvest untuk memanen", id, PlantData[id][plantedBy]);
        PlantData[id][plantLabel] = CreateDynamic3DTextLabel(label_string, 0xF1C40FFF, PlantData[id][plantX], PlantData[id][plantY], PlantData[id][plantZ], 5.0);
        PlantData[id][plantTimer] = SetTimerEx("PlantGrowth", LAMA_WAKTU_PANEN * 1000, true, "i", id);
        Iter_Add(Plants, id);
        PlayerDrugData[playerid][Seeds]--;
        PlayerDrugData[playerid][TotalPlanted]++;

        TogglePlayerControllable(playerid, 0);
        TogglePlayerControllableEx(playerid, 0);
        Nanam_Ganjos[playerid] = SetTimerEx("Nanamganjos", 5000, false, "d", playerid);
        SetPVarInt(playerid, "Nanam", 1);
        TogglePlayerControllableEx(playerid, 0);
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
        {
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
        }
    }
    return 1;
}
epublic: Nanamganjos(playerid)

{
    if(GetPVarInt(playerid, "Nanam"))
    {
        TogglePlayerControllableEx(playerid, 1);
        ClearAnimations(playerid);
        DeletePVar(playerid, "Nanam");
        GameTextForPlayer(playerid, "~r~BerhasilNanam", 3000, 0);
        new Randkrang = random(7);
        PlayerInfo[playerid][pSatiety] -= Randkrang;
        PlayerInfo[playerid][pThirst] -= Randkrang;
        PlayerInfo[playerid][pStress] += Randkrang;
    }
    else TogglePlayerControllableEx(playerid, 1);
    return 1;
}

CMD:harvdvvdbdhxest(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid,200.0,-358.9692,-1440.1328,24.4144))
    {
        if(PlayerInfo[playerid][pLevel] < 5) return ShowError(playerid, "Tersedia dari level 2!");
        if(PlayerDrugData[playerid][Drugs] >= MAKSIMAL_GANJA_DI_ITEMS) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak bisa membawa drugs lebih banyak lagi");
        new id = GetClosestPlant(playerid);
        if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak dekat dengan plant drugs kamu");
        new harvested = PlantData[id][plantGrowth], string[128];
        if(PlayerDrugData[playerid][Drugs] + harvested > MAKSIMAL_GANJA_DI_ITEMS) harvested = MAKSIMAL_GANJA_DI_ITEMS - PlayerDrugData[playerid][Drugs];
        format(string, sizeof(string), "MARIJUANA PLANT: {FFFFFF}Kamu telah memanen %d grams drugs", harvested);
        SendClientMessage(playerid, 0x3498DBFF, string);
        format(string, sizeof(string), "MARIJUANA PLANT: {FFFFFF}Dan mendapatkan uang sebesar {FF0000}$500", harvested);
        SendClientMessage(playerid, 0x3498DBFF, string);
        PlayerInfo[playerid][pRedmoney] += 500;
        OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
        PlayerDrugData[playerid][Drugs] += harvested;
        PlayerInfo[playerid][pMicin] += harvested;
        PlayerDrugData[playerid][TotalHarvestedPlants]++;
        PlayerDrugData[playerid][TotalHarvestedGrams] += harvested;
        new owner_id = Plant_GetOwnerID(id);
        if(strcmp(PlantData[id][plantedBy], Player_GetName(playerid), true) && IsPlayerConnected(owner_id)) SendClientMessage(owner_id, 0x3498DBFF, "DRUG PLANT: {FFFFFF}Seseorang telah mengambil plant drugs kamu!");
        Plant_Destroy(id);
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
        Panen_Ganjos[playerid] = SetTimerEx("Panenganjos", 5000, false, "d", playerid);
        SetPVarInt(playerid, "Panen", 1);
        TogglePlayerControllable(playerid, 0);
        TogglePlayerControllableEx(playerid, 0);
        {
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 0, 0, 0, 0, 0);
        }
        ShowItemBox(playerid, "Marijuana", "ADD_1x", 18867, 3);
        new Randkrang = random(5);
        PlayerInfo[playerid][pSatiety] -= Randkrang;
        PlayerInfo[playerid][pThirst] -= Randkrang;
        PlayerInfo[playerid][pStress] += Randkrang;
    }
    return 1;
}
epublic: Panenganjos(playerid)
{
    if(GetPVarInt(playerid, "Panen"))
    {
        TogglePlayerControllableEx(playerid, 1);
        ClearAnimations(playerid);
        DeletePVar(playerid, "Panen");
        ShowInfo(playerid, "BerhasilMemanen");
    }
    else TogglePlayerControllableEx(playerid, 1);
    return 1;
}
stock ShowAzisPhonee(playerid)
{
    for (new i = 0; i < 69; i++)
    {
        TextDrawShowForPlayer(playerid, azisPhonee[i]);
    }
}
stock HideAzisPhonee(playerid)
{
    for (new i = 0; i < 69; i++)
    {
        TextDrawHideForPlayer(playerid, azisPhonee[i]);
    }
    CancelSelectTextDraw(playerid);
}
forward UpdatePhoneClock();
public UpdatePhoneClock()
{
    gettime(ServerHour, ServerMinute, ServerSecond);

    ServerHour += 8;

    if (ServerHour >= 24)
        ServerHour -= 24;

    new str[16];
    format(str, sizeof(str), "%02d:%02d", ServerHour, ServerMinute);
    TextDrawSetString(azisPhonee[18], str);

    return 1;
}
CMD:eprop(playerid, params[]) {
	new eprop[512];
    format(eprop, 512, "X( Hapus Animasi )\nBox\nTv\nBasket\nKursi\nPayung\nBendera\nBunga\nMic\nBan\nBumper\nNintro\nKamera1\nKamera2\nKmaera3\nKursi");
    ShowPlayerDialog(playerid, DIALOG_EMOTEPROPERTY, DIALOG_STYLE_LIST, "{FF7F00} NOCTIVE ROLEPLAY {FFFFFF}- Emote Property", eprop, "Select", "Close");
}
