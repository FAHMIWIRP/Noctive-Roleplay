CMD:givegiok(playerid, params[])
{
    if(admin_level[playerid] < 10 ||!admin_logged[playerid]) return 1;

    new targetid, type[20], jumlah;
    if(sscanf(params, "uds[20]", targetid, jumlah, type))
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} GUNAKAN: /givegiok [playerid] [jumlah] [hijau/putih/bintang/rainbow/permata]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Player tidak online!");

    if(jumlah <= 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Jumlah harus lebih dari 0!");

    if(!strcmp(type, "hijau", true))
    {
        PlayerInfo[targetid][pGiokhijau] += jumlah;
        OnPlayerUpdateAccountsPer(targetid, "pGiokhijau", PlayerInfo[targetid][pGiokhijau]);
        SCMF(playerid, -1, "{5996FF}[ ADMIN ]{FFFFFF} Kamu memberi %d Giok Hijau ke %s | Total: %d", jumlah, ReturnName(targetid), PlayerInfo[targetid][pGiokhijau]);
        SCMF(targetid, -1, "{2ECC71}[ INFO ]{FFFFFF} Admin %s memberi kamu %d Giok Hijau | Total: %d", ReturnName(playerid), jumlah, PlayerInfo[targetid][pGiokhijau]);
    }
    else if(!strcmp(type, "putih", true))
    {
        PlayerInfo[targetid][pGiokputih] += jumlah;
        OnPlayerUpdateAccountsPer(targetid, "pGiokputih", PlayerInfo[targetid][pGiokputih]);
        SCMF(playerid, -1, "{5996FF}[ ADMIN ]{FFFFFF} Kamu memberi %d Giok Putih ke %s | Total: %d", jumlah, ReturnName(targetid), PlayerInfo[targetid][pGiokputih]);
        SCMF(targetid, -1, "{2ECC71}[ INFO ]{FFFFFF} Admin %s memberi kamu %d Giok Putih | Total: %d", ReturnName(playerid), jumlah, PlayerInfo[targetid][pGiokputih]);
    }
    else if(!strcmp(type, "bintang", true))
    {
        PlayerInfo[targetid][pGiokbintang] += jumlah;
        OnPlayerUpdateAccountsPer(targetid, "pGiokbintang", PlayerInfo[targetid][pGiokbintang]);
        SCMF(playerid, -1, "{5996FF}[ ADMIN ]{FFFFFF} Kamu memberi %d Giok Bintang ke %s | Total: %d", jumlah, ReturnName(targetid), PlayerInfo[targetid][pGiokbintang]);
        SCMF(targetid, -1, "{2ECC71}[ INFO ]{FFFFFF} Admin %s memberi kamu %d Giok Bintang | Total: %d", ReturnName(playerid), jumlah, PlayerInfo[targetid][pGiokbintang]);
    }
    else if(!strcmp(type, "permata", true))
    {
        PlayerInfo[targetid][pGiokpermata] += jumlah;
        PlayerInfo[targetid][pGiokCleanliness] = 100;
        OnPlayerUpdateAccountsPer(targetid, "pGiokpermata", PlayerInfo[targetid][pGiokpermata]);
        OnPlayerUpdateAccountsPer(targetid, "pGiokCleanliness", PlayerInfo[targetid][pGiokCleanliness]);
        SCMF(playerid, -1, "{5996FF}[ ADMIN ]{FFFFFF} Kamu memberi %d Giok Permata ke %s | Total: %d", jumlah, ReturnName(targetid), PlayerInfo[targetid][pGiokpermata]);
        SCMF(targetid, -1, "{2ECC71}[ INFO ]{FFFFFF} Admin %s memberi kamu %d Giok Permata | Total: %d", ReturnName(playerid), jumlah, PlayerInfo[targetid][pGiokpermata]);
    }
    else if(!strcmp(type, "rainbow", true))
    {
        PlayerInfo[targetid][pGiokrainbow] += jumlah;
        OnPlayerUpdateAccountsPer(targetid, "pGiokrainbow", PlayerInfo[targetid][pGiokrainbow]);
        SCMF(playerid, -1, "{5996FF}[ ADMIN ]{FFFFFF} Kamu memberi %d Giok Rainbow ke %s | Total: %d", jumlah, ReturnName(targetid), PlayerInfo[targetid][pGiokrainbow]);
        SCMF(targetid, -1, "{2ECC71}[ INFO ]{FFFFFF} Admin %s memberi kamu %d Giok Rainbow | Total: %d", ReturnName(playerid), jumlah, PlayerInfo[targetid][pGiokrainbow]);
    }
    else
    {
        SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Tipe giok tidak valid! Gunakan: hijau, putih, bintang, rainbow, permata");
    }
    return 1;
}
CMD:gunlspd(playerid, params[])
{
    // Cek apakah pemain anggota LSPD (Ganti pMember jika berbeda)
    if(pData[playerid][pMember] != FRACTION_LSPD) 
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Hanya anggota LSPD yang bisa menggunakan perintah ini!");

    // Cek Lokasi Locker Room
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 846.539245, -2116.817871, 1003.500000))
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Anda harus berada di Locker Room LSPD!");

    GivePlayerWeapon(playerid, 31, 500); // M4
    GivePlayerWeapon(playerid, 24, 150); // Desert Eagle
    GivePlayerWeapon(playerid, 25, 150); // Shotgun
    GivePlayerWeapon(playerid, 22, 100); // Silenced Pistol

    SendClientMessage(playerid, -1, "{0000FF}LSPD: {FFFFFF}Senjata telah diambil.");
    return 1;
}
CMD:loadgunlspd(playerid, params[])
{
    if(pData[playerid][pMember] != FRACTION_LSPD) 
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Hanya anggota LSPD!");

    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 846.539245, -2116.817871, 1003.500000))
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Anda harus berada di Locker Room!");

    ResetPlayerWeapons(playerid);
    SendClientMessage(playerid, -1, "{0000FF}LSPD: {FFFFFF}Semua senjata telah direset.");
    return 1;
}
CMD:salaryfraksi(playerid, params[])
{
    // Cek apakah pemain adalah admin level 5
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

    new factionid, amount;
    // Mengambil dua input: ID Fraksi dan Jumlah Gaji
    if(sscanf(params, "dd", factionid, amount)) 
    {
        SendClientMessage(playerid, 0xFFFF00FF, "Gunakan: /salaryfraksi [ID Fraksi] [Jumlah]");
        SendClientMessage(playerid, -1, "{FFFFFF}ID: 1.LSPD | 2.Pedagang | 3.SA News | 4.SAMD");
        return 1;
    }

    if(amount <= 0) 
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Jumlah uang tidak valid!");

    new targetFraction;
    new factionName[32];

    // Menentukan target fraksi berdasarkan input angka
    switch(factionid)
    {
        case 1: { targetFraction = FRACTION_LSPD; factionName = "LSPD"; }
        case 2: { targetFraction = FRACTION_PEDAGANG; factionName = "Pedagang"; }
        case 3: { targetFraction = FRACTION_NEWS; factionName = "SA News"; }
        case 4: { targetFraction = FRACTION_LSMEDICS; factionName = "SAMD"; }
        default: return SendClientMessage(playerid, 0xFF0000FF, "ERROR: ID Fraksi salah (1-4)!");
    }

    new count = 0;
    new str[144];
    new adminName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, adminName, sizeof(adminName));

    // Loop semua player yang online
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(!IsPlayerConnected(i)) continue;

        // Cek apakah player termasuk dalam fraksi yang dipilih
        if(PlayerData[i][pMember] == targetFraction)
        {
            GivePlayerMoneyEx(i, amount); // Memberikan uang
            
            format(str, sizeof(str), "{00FF00}SALARY: {FFFFFF}Admin %s memberikan bonus gaji {00FF00}$%s {FFFFFF}untuk fraksi %s!", adminName, FormatMoney(amount), factionName);
            SendClientMessage(i, -1, str);
            
            count++;
        }
    }

    if(count > 0)
    {
        format(str, sizeof(str), "ADM-INFO: Berhasil memberi $%s kepada %d anggota %s yang online.", FormatMoney(amount), count, factionName);
        SendClientMessage(playerid, 0x00FFFFFF, str);
    }
    else
    {
        format(str, sizeof(str), "ERROR: Tidak ada anggota %s yang sedang online.", factionName);
        SendClientMessage(playerid, 0xFF0000FF, str);
    }
    return 1;
}
CMD:pakaivest(playerid, params[])
{
    if(pData[playerid][pMember] != FRACTION_LSPD) 
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Hanya anggota LSPD!");

    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 846.539245, -2116.817871, 1003.500000))
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Anda harus berada di Locker Room!");

    SetPlayerArmour(playerid, 88.0);
    SendClientMessage(playerid, -1, "{0000FF}LSPD: {FFFFFF}Anda telah memakai Kevlar Vest.");
    return 1;
}
CMD:sendtop(playerid, params[])
{
    // Cek level admin (Level 3)
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

    new targetid, toid;
    
    // Mengambil input: targetid (yang akan dipindah) dan toid (tujuan)
    if(sscanf(params, "uu", targetid, toid)) 
        return SendClientMessage(playerid, -1, "Gunakan: /sendtop [PlayerID] [TujuanID]");

    // Validasi apakah kedua player tersebut online
    if(targetid == INVALID_PLAYER_ID) 
        return SendClientMessage(playerid, -1, "ID Player pertama tidak ditemukan.");
        
    if(toid == INVALID_PLAYER_ID) 
        return SendClientMessage(playerid, -1, "ID Player tujuan tidak ditemukan.");

    // Mengambil posisi player tujuan
    new Float:x, Float:y, Float:z, Float:a;
    new interior = GetPlayerInterior(toid);
    new virtualworld = GetPlayerVirtualWorld(toid);
    
    GetPlayerPos(toid, x, y, z);
    GetPlayerFacingAngle(toid, a);

    // Memindahkan player target ke player tujuan
    SetPlayerPos(targetid, x + 1.0, y, z); // +1.0 agar tidak menumpuk persis di posisi yang sama
    SetPlayerFacingAngle(targetid, a);
    SetPlayerInterior(targetid, interior);
    SetPlayerVirtualWorld(targetid, virtualworld);

    // Notifikasi
    new str[128], nameTarget[MAX_PLAYER_NAME], nameTo[MAX_PLAYER_NAME], nameAdmin[MAX_PLAYER_NAME];
    GetPlayerName(targetid, nameTarget, sizeof(nameTarget));
    GetPlayerName(toid, nameTo, sizeof(nameTo));
    GetPlayerName(playerid, nameAdmin, sizeof(nameAdmin));

    format(str, sizeof(str), "Admin %s telah memindahkan Anda ke %s.", nameAdmin, nameTo);
    SendClientMessage(targetid, -1, str);

    format(str, sizeof(str), "Anda telah memindahkan %s ke %s.", nameTarget, nameTo);
    SendClientMessage(playerid, -1, str);

    return 1;
}


CMD:sendto(playerid, params[])
{
    // Cek level admin (Level 3)
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
    
    new targetid, location[32];
    
    // Mengambil input ID player dan nama lokasi
    if(sscanf(params, "us[32]", targetid, location)) 
        return SendClientMessage(playerid, -1, "{FFFF00}[Usage]: {FFFFFF}/sendto [playerid] [ls / rs / lspd / pulau / karnaval / dealer]");

    if(!IsPlayerConnected(targetid)) 
        return SendClientMessage(playerid, -1, "{FF0000}[Error]: {FFFFFF}Player tidak ditemukan.");

    // Logika pemilihan lokasi
    if(!strcmp(location, "ls", true))
    {
        SetPlayerPos(targetid, 1481.20, -1750.18, 15.44); // Koordinat LS (Contoh standar)
        SetPlayerFacingAngle(targetid, 0.0);
    }
    else if(!strcmp(location, "rs", true))
    {
        SetPlayerPos(targetid, 1178.42, -1323.80, 14.11);
        SetPlayerFacingAngle(targetid, 263.0735);
    }
    else if(!strcmp(location, "lspd", true))
    {
        SetPlayerPos(targetid, 1543.51, -1675.49, 13.55); // Koordinat LSPD (Contoh standar)
        SetPlayerFacingAngle(targetid, 90.0);
    }
    else if(!strcmp(location, "pulau", true))
    {
        SetPlayerPos(targetid, 491.4925, -2589.1567, 9.2064);
        SetPlayerFacingAngle(targetid, 42.0700);
    }
    else if(!strcmp(location, "karnaval", true))
    {
        SetPlayerPos(targetid, 374.7229, -2039.1920, 7.8359);
        SetPlayerFacingAngle(targetid, 58.1671);
    }
    else if(!strcmp(location, "dealer", true))
    {
        SetPlayerPos(targetid, 648.8322, -1512.1442, 15.4026);
        SetPlayerFacingAngle(targetid, 112.2657);
    }
    else 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[Error]: {FFFFFF}Lokasi tidak valid!");
    }

    // Notifikasi
    new str[128], adminname[24], targetname[24];
    GetPlayerName(playerid, adminname, sizeof(adminname));
    GetPlayerName(targetid, targetname, sizeof(targetname));

    format(str, sizeof(str), "{00FF00}[Admin]: {FFFFFF}Anda telah mengirim %s ke lokasi %s.", targetname, location);
    SendClientMessage(playerid, -1, str);

    format(str, sizeof(str), "{00FF00}[Admin]: {FFFFFF}Anda telah dikirim ke %s oleh Admin %s.", location, adminname);
    SendClientMessage(targetid, -1, str);
    
    SetPlayerInterior(targetid, 0);
    SetPlayerVirtualWorld(targetid, 0);
    
    return 1;
}
CMD:vote(playerid, params[]) //vote by : kybar
{
	new string[128];
	if(admin_level[playerid] < 5) return ShowPanjulNotif(playerid, "Khusus Admin Level 5");
	if(sscanf(params, "s[128]", params)) return SendClientMessage(playerid, COLOR_GREEN, "[USAGE]{FFFFFF} /vote [pertanyaan]");
	if(strlen(params) > 128) return SendClientMessage(playerid, COLOR_GREEN, "[VOTE]{FFFFFF} membuat kalimat VOTE harus 128 kata.");
	if(VoteOn) return SendClientMessage(playerid, COLOR_GREY, "[VOTE] Vote telah berlangsung");
	format(string, sizeof(string), "[VOTE]{FFFFFF}{ffff00}[VOTEASK] {FFFFFF} %s.", params);
	SendClientMessageToAll(COLOR_RED, string);
	format(string, sizeof(string), "[VOTE]{FFFFFF} Tekan '{33AA33}Y{FFFFFF}' untuk {33AA33}Yes, {FFFFFF}Tekan '{FF0000}N{FFFFFF}' untuk {FF0000}No.");
	SendClientMessageToAll(COLOR_RED, string);
	format(string, sizeof(string), "[VOTE]{FFFFFF} Vote akan berakhir dalam 1 menit.");
	SendClientMessageToAll(COLOR_RED, string);
	VoteOn = 1;
	VoteN = 0;
	foreach(Player, i)
	{
		VoteVoted[i] = 0;
	}
	VoteY = 0;
	SetTimer("VoteEnd", 60000, false);
	return 1;
}

CMD:togaveh(playerid) {
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if (IsWatchVehLog[playerid]) {
		IsWatchVehLog[playerid] = 0;
		SCM(playerid, -1, "Kamu telah mematikan veh destroy log!");
	}
	else {
		IsWatchVehLog[playerid] = 1;
		SCM(playerid, -1, "Kamu telah menyalakan veh destroy log!");
	}
	return 1;
}

forward GiokSystemTimer();
public GiokSystemTimer()
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && PlayerInfo[i][pGiokpermata] == 1)
        {
            if(PlayerInfo[i][pLevel] < 50) continue;

            // Kebersihan berkurang (100% habis dalam 60 menit = ~1.66% per menit. Kita bulatkan kurangi 2% per 1 menit lebih sedikit)
            // Atau kurangi 1% setiap menit, menit ke 60 akan pas 0%
            PlayerInfo[i][pGiokCleanliness]--;

            // Peringatan jika kebersihan mencapai 10% atau ke bawah
            if(PlayerInfo[i][pGiokCleanliness] <= 10 && PlayerInfo[i][pGiokCleanliness] > 0)
            {
                SendClientMessage(i, -1, "{FFFF00}[WARNING]: Giok Permata anda kotor (%d%%)! Segera cuci dengan /cucigiok sebelum hancur!", PlayerInfo[i][pGiokCleanliness]);
            }

            // Jika kebersihan 0%, giok hancur
            if(PlayerInfo[i][pGiokCleanliness] <= 0)
            {
                PlayerInfo[i][pGiokpermata] = 0;
                PlayerInfo[i][pGiokCleanliness] = 0;
                PlayerInfo[i][pGiokTimer] = 0;
                SendClientMessage(i, -1, "{FF0000}[GIOK]: Giok Permata anda telah hancur menjadi debu karena terlalu kotor (0%)!");
                continue; 
            }

            // Timer reward 20 menit
            PlayerInfo[i][pGiokTimer]++;
            if(PlayerInfo[i][pGiokTimer] >= 20)
            {
                PlayerInfo[i][pGiokTimer] = 0; // Reset timer menit ke 0
                GivePlayerGiokReward(i);
            }
        }
    }
    return 1;
}
stock GivePlayerGiokReward(playerid)
{
    new roll = random(1000); // 0 sampai 999
    new string[144];

    // --- TIER LANGKA (0.5% KEMUNGKINAN = Range 5 Angka) ---
    if(roll < 5) // 0, 1, 2, 3, 4 (0.5%)
    {
        GivePlayerWeapon(playerid, 24, 250);
        SendClientMessage(playerid, -1, "{00FFFF}[GIOK - LEGENDARY]: Kamu mendapatkan Senjata Deagle (ID 24) dengan 250 Ammo!");
    }
    else if(roll >= 5 && roll < 10) // 5, 6, 7, 8, 9 (0.5%)
    {
        GivePlayerWeapon(playerid, 25, 250);
        SendClientMessage(playerid, -1, "{00FFFF}[GIOK - LEGENDARY]: Kamu mendapatkan Senjata Shotgun (ID 25) dengan 250 Ammo!");
    }
    else if(roll >= 10 && roll < 15) // 10, 11, 12, 13, 14 (0.5%)
    {
        new redmoney = 1000 + random(49001); // 1000 - 50000
        PlayerInfo[playerid][pRedmoney] += redmoney; // Sesuaikan variabel redmoney servermu
        OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
        format(string, sizeof(string), "{00FFFF}[GIOK - LEGENDARY]: Kamu mendapatkan Redmoney senilai $%d!", redmoney);
        SendClientMessage(playerid, -1, string);
    }
    // --- TIER MEDIUM / UNCOMMON (Marijuana, Crack, Metal) ---
    else if(roll >= 15 && roll < 100) // ~8.5%
    {
        new metal = 100 + random(901); // 100 - 1000
        PlayerInfo[playerid][pMetall] += metal; // Sesuaikan variabel servermu
        OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
        format(string, sizeof(string), "{FFFF00}[GIOK - UNCOMMON]: Kamu mendapatkan Metal sebanyak %d biji!", metal);
        SendClientMessage(playerid, -1, string);
    }
    else if(roll >= 100 && roll < 200) // 10%
    {
        new mariju = 10 + random(41); // 10 - 50
        PlayerInfo[playerid][pMicin] += mariju; // Sesuaikan variabel servermu
        OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
        format(string, sizeof(string), "{FFFF00}[GIOK - UNCOMMON]: Kamu mendapatkan Marijuana sebanyak %d g!", mariju);
        SendClientMessage(playerid, -1, string);
    }
    else if(roll >= 200 && roll < 300) // 10%
    {
        new crack = 10 + random(41); // 10 - 50
        PlayerInfo[playerid][pCrack] += crack; // Sesuaikan variabel servermu
        OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pCrack]);
        format(string, sizeof(string), "{FFFF00}[GIOK - UNCOMMON]: Kamu mendapatkan Crack sebanyak %d gram!", crack);
        SendClientMessage(playerid, -1, string);
    }
    // --- TIER COMMON / UMUM (Uang, Bandage, Medicine) ---
    else if(roll >= 300 && roll < 500) // 20%
    {
        new bandage = 10 + random(11); // 10 - 20
        PlayerInfo[playerid][pHeals] += bandage; // Sesuaikan variabel servermu
        OnPlayerUpdateAccountsPer(playerid, "pHeals", PlayerInfo[playerid][pHeals]);
        format(string, sizeof(string), "{FFFFFF}[GIOK]: Kamu mendapatkan Bandage sebanyak %d!", bandage);
        SendClientMessage(playerid, -1, string);
    }
    else if(roll >= 500 && roll < 700) // 20%
    {
        new med = 10 + random(11); // 10 - 20
        PlayerInfo[playerid][pMedicine] += med; // Sesuaikan variabel servermu
        OnPlayerUpdateAccountsPer(playerid, "pMedicine", PlayerInfo[playerid][pMedicine]);
        format(string, sizeof(string), "{FFFFFF}[GIOK]: Kamu mendapatkan Medicine sebanyak %d!", med);
        SendClientMessage(playerid, -1, string);
    }
    else // Sisa persentase ke atas (~30%)
	{
	    new uang = 100 + random(4901); // Acak dari 100 - 5000
	    GivePlayerMoneyEx(playerid, uang);
	    
	    PlayerInfo[playerid][pCash] += uang; // PERBAIKAN: Diubah dari 500 menjadi 'uang'
	    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
	    
	    format(string, sizeof(string), "{FFFFFF}[GIOK]: Kamu mendapatkan Uang tunai senilai $%d!", uang);
	    SendClientMessage(playerid, -1, string);
	} 
    return 1;
}
// =============================================================================
// SYSTEM CICI GIOK (DURASI 2 MENIT) - FULL SCRIPT
// =============================================================================

CMD:cucigiok(playerid, params[])
{
    // 1. Cek Level Player (Wajib level 50)
    if(PlayerInfo[playerid][pLevel] < 50) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Level kamu harus 50 untuk menggunakan fitur ini!");
        
    // 2. Cek Kepemilikan Giok
    if(PlayerInfo[playerid][pGiokpermata] == 0) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu tidak memiliki Giok Permata!");

    // 3. Cek Koordinat Tempat Pencucian (Radius 3.0 meter)
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 543.974548, 588.865478, 0.322248))
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu tidak berada di tempat pencucian Giok Permata!");

    // 4. Anti Spam / Lock Status Kerja
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    // 5. Cek Tingkat Kebersihan Giok
    if(PlayerInfo[playerid][pGiokCleanliness] >= 100)
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Giok Permata kamu masih sangat bersih (100%)!");

    // Mulai Kunci Status Kerja
    SedangKerja[playerid] = true;

    // Freeze posisi player & jalankan animasi mencuci
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);

    // Inisialisasi Teks & Nilai Progress Bar
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENCUCI GIOK...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // TIMER LOOP: 1200ms (1.2 Detik) x 100 Tahapan = Tepat 120 Detik (2 Menit)
    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnWashingGiokUpdate", 1200, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu sedang mencuci Giok Permata (Proses memakan waktu 2 menit)...");
    return 1;
}

// Callback Loop Progress Bar (Dipanggil setiap 1.2 detik sekali)
forward OnWashingGiokUpdate(playerid);
public OnWashingGiokUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Tambah nilai progress bar sebesar 1%
    PlayerProgressValue[playerid] += 1;

    // Jika Progress Bar sudah mencapai 100%
    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        
        // Matikan timer loop progress bar
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik saat bar penuh warna hijau, lalu panggil fungsi penyelesaian
        SetTimerEx("SelesaiCuciGiok", 1000, false, "i", playerid);
    }
    else
    {
        // Paksa animasi tetap berjalan looping stabil selama bar belum penuh
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);
        
        // Update tampilan textdraw progress bar di layar player
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

// Callback Ketika Proses Cuci Giok Selesai Penuh
forward SelesaiCuciGiok(playerid);
public SelesaiCuciGiok(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Bersihkan animasi, unfreeze posisi, buka kunci status kerja, dan hapus textdraw progress bar
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid); 

    // Set kebersihan giok kembali penuh ke 100%
    PlayerInfo[playerid][pGiokCleanliness] = 100;
    
    // *Uncomment baris di bawah ini jika skrip kamu menggunakan sistem simpan akun per-variabel:
    OnPlayerUpdateAccountsPer(playerid, "pGiokCleanliness", PlayerInfo[playerid][pGiokCleanliness]);

    // Kirim notifikasi sukses & bunyikan suara tugas selesai (Sound ID: 1058)
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Sukses! Anda berhasil mencuci Giok Permata. Kebersihan kembali ke ( 100% ).");
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    return 1;
}


CMD:cekgiok(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 50) 
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: Fitur ini hanya untuk player Level 50 keatas!");

    if(PlayerInfo[playerid][pGiokpermata] == 0) 
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: Kamu tidak memiliki Giok Permata!");

    new string[144];
    format(string, sizeof(string), "{00FFFF}Kebersihan Giok ( %d%% )", PlayerInfo[playerid][pGiokCleanliness]);
    SendClientMessage(playerid, -1, string);
    
    format(string, sizeof(string), "{FFFFFF}Waktu menuju reward berikutnya: %d/20 Menit.", PlayerInfo[playerid][pGiokTimer]);
    SendClientMessage(playerid, -1, string);
    return 1;
}

forward OnPlantingUpdate(playerid, planttype);
public OnPlantingUpdate(playerid, planttype)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil callback penyelesaian bawaan servermu
        // Menggunakan "ii" untuk meneruskan playerid dan tipe tanaman
        SetTimerEx("ProgressTanam", 1000, false, "ii", playerid, planttype);
    }
    else
    {
        // Memaksa animasi menanam tetap looping teratur selama loading bar berjalan
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 1, 0); 
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward OnHarvestingUpdate(playerid, plantid);
public OnHarvestingUpdate(playerid, plantid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil fungsi hadiah panen asli servermu
        // Menggunakan "ii" untuk meneruskan playerid dan plantid (ID tanaman)
        SetTimerEx("ProgressPanen", 1000, false, "ii", playerid, plantid);
    }
    else
    {
        // Paksa animasi memanen tetap looping teratur selama bar berjalan
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 1, 0); 
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
CMD:rentkart(playerid, params[])
{
    // 1. Cek apakah player berada di salah satu dari dua koordinat sewa (Radius 4.0 meter)
    if(!IsPlayerInRangeOfPoint(playerid, 4.0, 635.471923, -1830.723754, 6.620376) && 
       !IsPlayerInRangeOfPoint(playerid, 4.0, 635.733764, -1839.101440, 6.610128))
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Harus Berada Di Tempat Beli Tiket Bombomcar!");
    }

    // 2. Kunci Sistem: Jika waktu belum habis/belum turun dari Kart, tidak bisa sewa lagi
    if(RentedKart[playerid] != INVALID_VEHICLE_ID)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Waktu Bombomcar Anda Masih Ada!");
    }

    // 3. Cek Uang (Menggunakan pData bawaan GM kamu)
    if(pData[playerid][pCash] < 500)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Tidak Memiliki Uang 500$!");
    }

    // 4. Proses pemotongan uang sebesar $500
    pData[playerid][pCash] -= 500;

    // 5. Spawn Kart (Model ID: 571) di koordinat target spawn
    new carid = CreateVehicle(571, 624.447082, -1833.976440, 6.612178, 112.708374, -1, -1, -1);
    RentedKart[playerid] = carid;

    // --- MENGGUNAKAN SETTINGAN DARI GM KAMU ---
    VehInfo[carid][vSost] = 100;
    VehInfo[carid][vStatus] = 2;
    Fuell[carid] = MAX_VEHICLE_FUEL;
    SetVehicleParamsEx(carid, 1, 0, 0, 0, 0, 0, 0);
    SetVehicleHealth(carid, 1000.0); // Tetap berikan ini agar health engine SA-MP tersinkron 100% mulus
    PutPlayerInVehicle(playerid, carid, 0);
    // ------------------------------------------

    // 6. Mulai hitung mundur sewa selama 20 menit (1.200.000 ms)
    RentalTimer[playerid] = SetTimerEx("HapusKartSewa", 1200000, false, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Berhasil Rental Bombomcar");
    return 1;
}

// =============================================================================
// CALLBACK TIMER (WAKTU HABIS)
// =============================================================================
public HapusKartSewa(playerid)
{
    if(RentedKart[playerid] != INVALID_VEHICLE_ID)
    {
        DestroyVehicle(RentedKart[playerid]);
        RentedKart[playerid] = INVALID_VEHICLE_ID;
        RentalTimer[playerid] = -1;
        
        SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Waktu Bombomcar Kamu Habis!");
    }
    return 1;
}
CMD:pjail(playerid, params[])
{
    new targetid, waktu, denda;

    if(sscanf(params, "uii", targetid, waktu, denda))
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} GUNAKAN: /pjail [playerid] [waktu(menit)] [denda]");

    if(pData[playerid][pMember]!= FRACTION_LSPD)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Hanya anggota LSPD yang bisa menggunakan perintah ini!");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Pemain tidak ditemukan!");

    if(!ProxDetectorS(8.0, playerid, targetid))
        return SendClientMessage(playerid, -1, "{BFC0C2}Anda harus berada di dekat pemain.");

    if(waktu < 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Waktu minimal adalah 1 menit.");

    if(denda < 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Denda tidak boleh minus!");

    if(PlayerInfo[targetid][pJailTime] > 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Player tersebut sudah di penjara!");

    new rand = random(3);

    SetPlayerPos(targetid, RandomJailSpawns[rand][0], RandomJailSpawns[rand][1], RandomJailSpawns[rand][2]);
    SetPlayerFacingAngle(targetid, RandomJailSpawns[rand][3]);
    SetPlayerInterior(targetid, 3);
    SetPlayerVirtualWorld(targetid, 0);

    // Fix denda
    if(denda > 0)
    {
        GivePlayerMoneyEx(targetid, -denda);
        PlayerInfo[targetid][pCash] -= denda;
        OnPlayerUpdateAccountsPer(targetid, "pCash", PlayerInfo[targetid][pCash]);
    }

    PlayerInfo[targetid][pJailTime] = waktu * 60;
    OnPlayerUpdateAccountsPer(targetid, "pJailTime", PlayerInfo[targetid][pJailTime]);

    PlayerTextDrawShow(targetid, JailTD[targetid]);

    if(JailTimer[targetid]) KillTimer(JailTimer[targetid]);
    JailTimer[targetid] = SetTimerEx("OnJailUpdate", 1000, true, "i", targetid);

    new string[128];
    format(string, sizeof(string), "{FF6347}[ INFO ]{FFFFFF} Police memenjarakan Anda selama %d menit dengan denda $%d.", waktu, denda);
    SendClientMessage(targetid, -1, string);

    format(string, sizeof(string), "{5996FF}[ INFO ]{FFFFFF} Kamu memenjarakan %s selama %d menit dengan denda $%d.", ReturnName(targetid), waktu, denda);
    SendClientMessage(playerid, -1, string);

    return 1;
}

CMD:ajaill(playerid, params[])
{
    if(admin_level[playerid] < 1 ||!admin_logged[playerid]) return 1;

    new targetid, waktu, denda;
    if(sscanf(params, "uii", targetid, waktu, denda))
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} GUNAKAN: /ajaill [playerid] [waktu/menit] [denda]");

    if(!IsPlayerConnected(targetid) || targetid == INVALID_PLAYER_ID)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Pemain tidak ditemukan!");
    if(targetid == playerid)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Tidak bisa jail diri sendiri!");
    if(waktu < 1 || waktu > 60)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Waktu 1-60 menit saja.");
    if(denda < 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Denda tidak boleh minus!");
    if(PlayerInfo[targetid][pJailTime] > 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Player tersebut sudah di penjara!");

    new rand = random(3);
    SetPlayerPos(targetid, RandomJailSpawns[rand][0], RandomJailSpawns[rand][1], RandomJailSpawns[rand][2]);
    SetPlayerFacingAngle(targetid, RandomJailSpawns[rand][3]);
    SetPlayerInterior(targetid, 3);
    SetPlayerVirtualWorld(targetid, 0);

    if(denda > 0)
    {
        PlayerInfo[targetid][pCash] -= denda;
        GivePlayerMoney(targetid, -denda);
        OnPlayerUpdateAccountsPer(targetid, "pCash", PlayerInfo[targetid][pCash]);
    }

    PlayerInfo[targetid][pJailTime] = waktu * 60;
    OnPlayerUpdateAccountsPer(targetid, "pJailTime", PlayerInfo[targetid][pJailTime]);

    PlayerTextDrawShow(targetid, JailTD[targetid]);
    if(JailTimer[targetid]) KillTimer(JailTimer[targetid]);
    JailTimer[targetid] = SetTimerEx("OnJailUpdate", 1000, true, "i", targetid);

    new string[144];
    format(string, sizeof(string), "{FF6347}[ JAIL ]{FFFFFF} Admin %s memenjarakan Anda selama %d menit dengan denda $%d.", ReturnName(playerid), waktu, denda);
    SendClientMessage(targetid, -1, string);

    format(string, sizeof(string), "{5996FF}[ INFO ]{FFFFFF} Kamu memenjarakan %s selama %d menit dengan denda $%d.", ReturnName(targetid), waktu, denda);
    SendClientMessage(playerid, -1, string);

    format(string, sizeof(string), "{FFB6C1}[ ADMINS ] {FF0000}%s {FFFFFF}memenjarakan {FFFF00}%s {FFFFFF}selama %d menit | Denda: {00FF00}$%d", ReturnName(playerid), ReturnName(targetid), waktu, denda);
    SendClientMessageToAll(-1, string);
    return 1;
}

CMD:bail(playerid, params[])
{
    if(PlayerInfo[playerid][pJailTime] <= 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Anda sedang tidak berada di dalam penjara.");

    if(GetPlayerMoney(playerid) < 20000)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Uang Anda tidak cukup. Biaya bail adalah $20,000.");

    GivePlayerMoneyEx(playerid, -20000);
    PlayerInfo[playerid][pCash] -= 20000;
    PlayerInfo[playerid][pJailTime] -= 300;

    if(PlayerInfo[playerid][pJailTime] < 0) PlayerInfo[playerid][pJailTime] = 0;

    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    OnPlayerUpdateAccountsPer(playerid, "pJailTime", PlayerInfo[playerid][pJailTime]);

    if(PlayerInfo[playerid][pJailTime] <= 0)
    {
        ReleasePlayerFromJail(playerid);
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda telah membayar bail dan masa tahanan Anda selesai.");
    }
    else
    {
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda telah membayar $20,000. Masa tahanan berkurang 300 detik.");
        new str[64];
        format(str, sizeof(str), "Jail Time : %d detik", PlayerInfo[playerid][pJailTime]);
        PlayerTextDrawSetString(playerid, JailTD[playerid], str);
    }

    return 1;
}

public OnJailUpdate(playerid)
{
    if(!IsPlayerConnected(playerid))
    {
        if(JailTimer[playerid]) KillTimer(JailTimer[playerid]);
        JailTimer[playerid] = 0;
        return 1;
    }

    if(PlayerInfo[playerid][pJailTime] > 0)
    {
        PlayerInfo[playerid][pJailTime]--;
        new str[64];
        format(str, sizeof(str), "Jail Time : %d detik", PlayerInfo[playerid][pJailTime]);
        PlayerTextDrawSetString(playerid, JailTD[playerid], str);
    }

    if(PlayerInfo[playerid][pJailTime] <= 0)
    {
        ReleasePlayerFromJail(playerid); // Timer bakal di kill di dalem stock ini
    }
    return 1;
}

stock ReleasePlayerFromJail(playerid)
{
    // Fix utama ada disini
    if(JailTimer[playerid])
    {
        KillTimer(JailTimer[playerid]);
        JailTimer[playerid] = 0;
    }

    PlayerTextDrawHide(playerid, JailTD[playerid]);
    PlayerInfo[playerid][pJailTime] = 0;

    // Fix: ganti targetid jadi playerid
    OnPlayerUpdateAccountsPer(playerid, "pJailTime", PlayerInfo[playerid][pJailTime]);

    SetPlayerPos(playerid, 1540.118774, -1675.281127, 13.548087);
    SetPlayerFacingAngle(playerid, 85.797546);
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Masa tahanan Anda telah selesai, jangan ulangi kesalahan lagi.");
    return 1;
}
