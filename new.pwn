	{
	    SCM(playerid, COLOR_LIGHTRED, "Nama panggilan game Anda tidak mematuhi aturan server kami (Role Play).");
		SCM(playerid, COLOR_LIGHTRED, "Pergi ke peluncur dan tentukan nama ingame dalam format FirstName LastName");

	    return KickD(playerid, "");
	}
	
