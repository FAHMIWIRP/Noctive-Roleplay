    PlayerTextDrawSetShadow(playerid, PanjulNotif[playerid][0], 0);
    PlayerTextDrawSetOutline(playerid, PanjulNotif[playerid][0], 0);
    PlayerTextDrawBackgroundColor(playerid, PanjulNotif[playerid][0], 255);
    PlayerTextDrawFont(playerid, PanjulNotif[playerid][0], 4);
    PlayerTextDrawSetProportional(playerid, PanjulNotif[playerid][0], 1);

    PanjulNotif[playerid][1] = CreatePlayerTextDraw(playerid, 535.000, 305.000, "LD_SPAC:white");
    PlayerTextDrawTextSize(playerid, PanjulNotif[playerid][1], 108.000, 36.000);
    PlayerTextDrawAlignment(playerid, PanjulNotif[playerid][1], 1);
    PlayerTextDrawColor(playerid, PanjulNotif[playerid][1], 512819199);
    PlayerTextDrawSetShadow(playerid, PanjulNotif[playerid][1], 0);
    PlayerTextDrawSetOutline(playerid, PanjulNotif[playerid][1], 0);
    PlayerTextDrawBackgroundColor(playerid, PanjulNotif[playerid][1], 255);
    PlayerTextDrawFont(playerid, PanjulNotif[playerid][1], 4);
    PlayerTextDrawSetProportional(playerid, PanjulNotif[playerid][1], 1);

    PanjulNotif[playerid][2] = CreatePlayerTextDraw(playerid, 537.000, 307.000, "LD_CHAT:badchat");
    PlayerTextDrawTextSize(playerid, PanjulNotif[playerid][2], 18.000, 14.000);
    PlayerTextDrawAlignment(playerid, PanjulNotif[playerid][2], 1);
    PlayerTextDrawColor(playerid, PanjulNotif[playerid][2], -1);
    PlayerTextDrawSetShadow(playerid, PanjulNotif[playerid][2], 0);
