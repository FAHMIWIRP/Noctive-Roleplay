	return 1;
}

stock ShowPlayerSpeed(playerid)
{
    if (!IsVehicleHaveFuel(GetPlayerVehicleID(playerid))) return 0;
    new vehicleid = GetPlayerVehicleID(playerid);
    if (vehicleid != INVALID_VEHICLE_ID)
    {
        new Float:hp;
        GetVehicleHealth(vehicleid, hp);
        if (hp > 1000.0) hp = 1000.0;
        SetVehicleHealth(vehicleid, hp);
    }

    if (player_jobvehicle_time[playerid] != 0) player_jobvehicle_time[playerid] = 0; // hapus timer
    SetTimerEx("UpdateSpeedometr", 250, false, "d", playerid);
    
    {
        PlayerTextDrawShow(playerid, azisSpeedo1[playerid][0]);
