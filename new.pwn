epublic: WaktuNambang1(playerid)
{
    ClearAnimations(playerid);
	TogglePlayerControllableEx(playerid, 1);
	new rand = RandomEx(1, 10);
    PlayerInfo[playerid][pEmas] += rand;
    OnPlayerUpdateAccountsPer(playerid, "pEmas", PlayerInfo[playerid][pEmas]);
    format(String, sizeof(String), "Anda Melebur Emas Sebanyak %d Gram", rand);
	SendClientMessage(playerid, COLOR_YELLOW, String);
    return 1;
}
epublic: WaktuNambang(playerid)
{
    ClearAnimations(playerid);
	TogglePlayerControllableEx(playerid, 1);
    PlayerInfo[playerid][pThirst] -= 7;
    PlayerInfo[playerid][pSatiety] -= 3;
    PlayerInfo[playerid][pStress] += 1;
	SendClientMessage(playerid, COLOR_YELLOW, "Anda Mendapat Bongkahan Emas");
    return 1;
}

epublic: WaktuMiner(playerid)
{
    ClearAnimations(playerid);
	TogglePlayerControllableEx(playerid, 1);
	new rand = RandomEx(1, 5);
	TaruhMiner[playerid] = 1;
	PlayerInfo[playerid][pPaket] += rand;
	OnPlayerUpdateAccountsPer(playerid, "pPaket", PlayerInfo[playerid][pPaket]);
    PlayerInfo[playerid][pThirst] -= 7;
    PlayerInfo[playerid][pSatiety] -= 3;
    PlayerInfo[playerid][pStress] += 3;
	format(String, sizeof(String), "Anda berhasil mendapatkan %d kg Batu Kotor. cek Inventory.", rand);
	SendClientMessage(playerid, COLOR_WHITE, String);
    return 1;
}
