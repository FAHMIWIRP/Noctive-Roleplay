CMD:reoff(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING)
	{
 		//ShowMenuForPlayer(Admin,playerid);
		StopSpectate(playerid);
	}
	return true;
}

alias:re("sp");
CMD:re(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /re(/sp) [id]");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY, "Anda tidak bisa menonton diri sendiri...");
	if(!IsPlayerConnected(params[0]) || PlayerInfo[params[0]][pLogin] == 0) return Send(playerid,-1,"Pemain tidak resmi/spawn");

	if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid,COLOR_GREY, "Pengawasan administrasi dilarang!");
	if(GetPlayerState(params[0]) == PLAYER_STATE_SPECTATING && gSpectateID[params[0]] != INVALID_PLAYER_ID) return Send(playerid, COLOR_GREY, "Player Observer...");

	if(gSpectateID[playerid] == INVALID_PLAYER_ID)
	{
		new Float: x, Float: y, Float: z;

		GetPlayerPos(playerid, x, y, z);

		SetPVarFloat(playerid, "spec_X", x);
		SetPVarFloat(playerid, "spec_Y", y);
		SetPVarFloat(playerid, "spec_Z", z);
		SetPVarInt(playerid, "spec_int", GetPlayerInterior(playerid));
	    SetPVarInt(playerid, "spec_world", GetPlayerVirtualWorld(playerid));
	}

	StartSpectate(playerid, params[0]);
	return true;
}

CMD:t(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(!(70 <= PlayerInfo[playerid][pJob] <= 72)) return SCM(playerid, COLOR_GREY, "Anda tidak bekerja sebagai sopir taksi.");

	if(sscanf(params, "s[64]",params)) return Send(playerid, -1, "Masuk: /t [teks]");
	format(format_string, sizeof(format_string), "[T] %s[%d]: %s", Name(playerid), playerid, params), SendTaxiMessage(0xF2E800FF, format_string);
	return 1;
}
