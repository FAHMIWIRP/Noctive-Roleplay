}

forward Gun(playerid, count);
public Gun(playerid, count)
{
    if(count <= 20)
    {
        PlayerTextDrawShow(playerid, BAR[playerid][count]);
        SetTimerEx("Gun", 1000, false, "ii", playerid, count+1);
    }
    else
    {
        for(new i = 0; i <= 21; i++)
        {
            PlayerTextDrawHide(playerid, BAR[playerid][i]);
        }
        RemovePlayerAttachedObject(playerid, 8);
                PlayerInfo[playerid][pRedmoney] -= 10000;
            PlayerInfo[playerid][pMetall] -= 800;
            GivePlayerWeapon(playerid, 25, 100);
            TogglePlayerControllable(playerid, 1);
            SendClientMessage(playerid, COLOR_RED, "Anda Berhasil Membuat Senjata Ilegal");
            OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
            OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
                ClearAnimations(playerid);
    }
}
forward OnCreatePacketUpdate(playerid);
CMD:createpacket(playerid, params[])
{
    if(PlayerInfo[playerid][pJobbm] == 0)
        return ShowPanjulNotif(playerid, "Bukan pekerja ilegal.");

    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 33.252960, -2649.920410, 40.728469))
        return ShowPanjulNotif(playerid, "Bukan di lokasi pembuat paket.");

    if(SedangKerja[playerid] == true)
        return ShowPanjulNotif(playerid, "Tunggu proses selesai.");

    if(PlayerInfo[playerid][pComponent] < 100)
        return ShowPanjulNotif(playerid, "Butuh 100 Component.");

    if(PlayerInfo[playerid][pPaketrm] >= 1)
        return ShowPanjulNotif(playerid, "Masih ada Paket Redmoney.");

    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Creating Packet...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnCreatePacketUpdate", 200, true, "i", playerid);

    ShowPanjulNotif(playerid, "Sedang membuat paket...");
    return 1;
}

public OnCreatePacketUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("SelesaiCreatePacket", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiCreatePacket(playerid);
public SelesaiCreatePacket(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    PlayerInfo[playerid][pPaketrm] += 1;
    PlayerInfo[playerid][pComponent] -= 100;

    OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
    OnPlayerUpdateAccountsPer(playerid, "pPaketrm", PlayerInfo[playerid][pPaketrm]);

    ShowPanjulNotif(playerid, "Selesai! Jual paket di pulau.");
    return 1;
}

CMD:packetsell(playerid, params[])
{
    if(PlayerInfo[playerid][pPaketrm] < 1)
        return ShowPanjulNotif(playerid, "Tidak memiliki paket.");

    if(IsPlayerInRangeOfPoint(playerid, 10.0, 484.555694, -2640.143554, 9.401593))
    {
        PlayerInfo[playerid][pRedmoney] += 2000;
        PlayerInfo[playerid][pPaketrm] -= 1;
        PlayerInfo[playerid][pMicin] += 1;
        OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
        OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);

        ShowPanjulNotif(playerid, "+$2.000 Redmoney & 1g Marijuana.");
    }
    else
    {
        ShowPanjulNotif(playerid, "Bukan di lokasi pengiriman.");
    }
    return 1;
}

CMD:createsg(playerid, params[])
{
    new playerName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, playerName, sizeof(playerName));

    if(PlayerInfo[playerid][pFamily] == -1)
        return ShowPanjulNotif(playerid, "Bukan anggota Family.");

    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 291.156524, -106.223526, 1001.515625))
        return ShowPanjulNotif(playerid, "Bukan di tempat crafting.");

    if(SedangKerja[playerid] == true)
        return ShowPanjulNotif(playerid, "Tunggu proses selesai.");

    if(PlayerInfo[playerid][pClipsg] < 1)
        return ShowPanjulNotif(playerid, "Butuh 1 Clip SG.");

    if(PlayerInfo[playerid][pRedmoney] < 10000 || PlayerInfo[playerid][pMetall] < 800)
        return ShowPanjulNotif(playerid, "Redmoney/Metal tidak cukup.");

    PlayerInfo[playerid][pRedmoney] -= 10000;
    PlayerInfo[playerid][pMetall] -= 800;
    PlayerInfo[playerid][pClipsg] -= 1;

    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    OnPlayerUpdateAccountsPer(playerid, "pClipsg", PlayerInfo[playerid][pClipsg]);

    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Merakit Shotgun...");

    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnCraftingSGUpdate", 200, true, "i", playerid);

    ShowPanjulNotif(playerid, "Sedang merakit Shotgun...");
    return 1;
}

