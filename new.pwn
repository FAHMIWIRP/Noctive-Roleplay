        PlayerTextDrawShow(playerid, azisSpeedo1[playerid][13]);
        PlayerTextDrawShow(playerid, azisSpeedo1[playerid][14]);
        PlayerTextDrawShow(playerid, azisSpeedo1[playerid][15]);
        PlayerTextDrawShow(playerid, azisSpeedo1[playerid][16]);
