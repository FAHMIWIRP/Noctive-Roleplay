    for(new i; i < 10; i++) old_ids[i] = cheat_ids[line_id][i];

    cheat_ids[line_id][0] = playerid;

    for(new i = 1; i < 10; i++) cheat_ids[line_id][i] = old_ids[i - 1];

	UpdateCheaterTD();
}

stock UpdateCheaterTD()
{
	for(new x; x < 2; x++)
    	for(new i; i < 10; i++)
			TextDrawSetString(cheat_td[x][i], IntToString(cheat_ids[x][i]));
}
stock SplitString(const source[], dest[][], const delimiter = '|', const maxlength = sizeof(dest[]))
{
    new pos = -1, count, offset;

    while (source[++pos] != EOS)
	{
        if (source[pos] == delimiter)
		{
            strmid(dest[count++], source, offset, pos, maxlength);
            offset = pos + 1;
        }
    }

    if(source[pos] == EOS) strmid(dest[count], source, offset, pos, maxlength);
}

