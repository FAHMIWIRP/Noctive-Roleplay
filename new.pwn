HideProgressBar(playerid)
{
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][0]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][1]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][2]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][3]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][4]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][5]);
	PlayerTextDrawDestroy(playerid, PROGRESSBAR[playerid][6]);
	return 1;
}
