		case HP_TWITTER:
	    {
	        if(response)
            {
                new text[128];

			    if(PlayerInfo[playerid][pPrison] != 0) return Send(playerid, COLOR_GREY, "Tidak Bisa Digunakaan Saat Dipenjara");
				if(PlayerInfo[playerid][pMuted] > 0) return Send(playerid, COLOR_GREY, "Akun Media Diblokir");
			    if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor!");
			    if(PlayerInfo[playerid][pSummaNumber] <= 0) return SCM(playerid, COLOR_GREY, "Anda tidak punya pulsa untuk internetan");
                if(sscanf(inputtext, "s[128]", text))
                {
                    if(gettime() < GetPVarInt(playerid, "pTwitterTime")) return Send(playerid, COLOR_RED, "Harap tunggu 30 detik lagi sebelum menggunakan fitur ini.");
                }
				new fmt_msg[170 + 1];
				new ttext[30];
				if(twStatus) {
    			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
    			SetPlayerChatBubble(playerid, "USE TWITTER >>" ,COLOR_BLUE,10.0,5000);
				format(fmt_msg, sizeof fmt_msg, "{0076B5} @%s[%d]: [Twitter] %s", GetPlayerNameEx(playerid), playerid, text);
				SendClientMessageToAll(-1, fmt_msg);
	        	}
        		else
				{
		 		   return SendClientMessage(playerid, 0xCECECEFF, "Twitter ditutup!");
				}
			}
		}
	    case DIALOG_DMSERVER:
		{
			    if(!response) return 1;
