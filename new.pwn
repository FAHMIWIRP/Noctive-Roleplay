CMD:sethbe(playerid, params[]) {
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	new siapa, jumlah;

	if(sscanf(params, "dd", siapa, jumlah)) return SendClientMessage(playerid, 0xCECECEFF, "/sethbe [playerid] [jumlah]");

	PlayerInfo[siapa][pThirst] = jumlah;
	PlayerInfo[siapa][pSatiety] = jumlah;
	PlayerInfo[siapa][pStress] = jumlah;
	new cgs[128], cgs1[128];
	format(cgs, sizeof(cgs), "Administrator {33AAFF}%s telah merubah hbe anda ke %d", PlayerInfo[playerid][pAname], jumlah);
	format(cgs1, sizeof(cgs1), "Anda telah merubah hbe %s ke %d", GetName(siapa), jumlah);
	SCM(siapa, -1, cgs);
	SCM(playerid, -1, cgs1);
	return 1;
}

CMD:agivecompo(playerid,params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

	new targetid, jumlah;
    if(sscanf(params,"dd", targetid, jumlah)) return SendClientMessage(playerid, 0xafafafff, "/agivecompo [id pemain] [jumlah]");
    if(PlayerInfo[targetid][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!(1 <= jumlah <= 500)) return SCM(playerid, COLOR_GREY, "Dari 1 hingga 500.");

	PlayerInfo[targetid][pComponent] += jumlah;

	OnPlayerUpdateAccountsPer(targetid, "pComponent", PlayerInfo[playerid][pComponent]);

	SCMF(targetid, -1, "- Admin %s give component ke %s", GetName(playerid), GetName(targetid));
	SCMF(playerid, -1, "- Anda memberikan component ke %s.", GetName(targetid));

    return 1;
}

CMD:agivemm(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	{
		new amount;
		if(sscanf(params, "d", amount)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /agivemm [amount]");

		foreach(Player, p)
		{
			PlayerInfo[p][pFood] = amount;
			PlayerInfo[p][pDrink] = amount;
			OnPlayerUpdateAccountsPer(p, "pDrink", PlayerInfo[p][pDrink]);
			OnPlayerUpdateAccountsPer(p, "pFood", PlayerInfo[p][pFood]);
			format(String, sizeof(String), "SERVER: {FFFFFF}Administrator %s telah memberi makan dan minum dengan jumlah %d", PlayerInfo[playerid][pAname],amount);
			SendClientMessage(p,COLOR_LIGHTBLUE,String);
		}
	}
	return 1;
}

CMD:takestock(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 2.0, 2525.7197,-1548.9398,24.2799))
	{
        if(gettime() < GetPVarInt(playerid, "tw_limit")) return SCM(playerid, COLOR_GREY, "Food Drink tersedia dalam 25 detik.");
	    if(PlayerInfo[playerid][pLevel] < 999) SetPVarInt(playerid, "tw_limit", gettime() + 25);
        PlayerInfo[playerid][pFood] += 100;
        PlayerInfo[playerid][pDrink] += 100;
		PlayerInfo[playerid][pCash] -= 10000;
		GivePlayerMoney(playerid, -10000);
		OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
        OnPlayerUpdateAccountsPer(playerid, "pFood", PlayerInfo[playerid][pFood]);
        OnPlayerUpdateAccountsPer(playerid, "pDrink", PlayerInfo[playerid][pFood]);
        SetPlayerChatBubble(playerid, "Mengambil makanan & minuman dipenyimpanan" ,COLOR_PURPLE,10.0,5000);
        SendClientMessage(playerid, COLOR_PURPLE, "Anda Sedang Mengambil Makanan & Minuman");
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 0, 0, 0, 0, 0);
		GameTextForPlayer(playerid, "-10000", 5000, 1);
	 }
    return 1;
}
CMD:jualmakan(playerid, params[])
{
    if(PlayerInfo[playerid][pMember] != FRACTION_PEDAGANG) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk Pedagang.");
    if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /jualmakan [playerid] [jumlah]");
   	if(!(1 <= params[1] <= 10)) return SCM(playerid, COLOR_GREY, "Batas Jual Makan Dari 1 - 10");
   	if(PlayerInfo[playerid][pFood] < params[1]) return SCM(playerid, COLOR_GREY, "Anda Tidak Memiliki Jumlah Makanan Yang Ditentukan");
    {
		PlayerInfo[playerid][pFood] -= params[1];
		PlayerInfo[params[0]][pFood] += params[1];
		OnPlayerUpdateAccountsPer(playerid, "pFood", PlayerInfo[playerid][pFood]);
		OnPlayerUpdateAccountsPer(params[0], "pFood", PlayerInfo[params[0]][pFood]);
		SetPlayerChatBubble(params[0], "Berhasil Menerima Makanan Dari Pedagang", 0xBFF600FF, 20.0, 7000);
		format(String, 188, "%s Menjual Makanan Kepada Orang Didepan",Name(playerid));
		ProxDetector(10.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	return 1;
}
CMD:jualminum(playerid, params[])
