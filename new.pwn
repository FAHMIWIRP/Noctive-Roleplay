CMD:ransel(playerid, params[])
{
	if(IsPlayerConnected(playerid))
	{
		if(ransel[playerid] == 1)//Memerika jika pemain sudah menggunakan ransel
		{
			SendClientMessage(playerid, -1, "Anda berhasil melepas ransel");
			RemovePlayerAttachedObject(playerid, 1); //
			ransel[playerid] = 0;
		}
		else if(ransel[playerid] == 0)//Memeriksa jika pemain belum menggunakan ransel
		{
			SendClientMessage(playerid, -1, "Anda berhasil menggunakan tas");
			SetPlayerAttachedObject(playerid,1,3026,1,-0.176000, -0.066000, 0.0000,0.0000, 0.0000, 0.0000, 1.07600, 1.079999, 1.029000); //
			ransel[playerid] = 1;
		}
	}
	return 1;
}

