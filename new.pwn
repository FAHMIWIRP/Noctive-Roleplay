    if(dialogid == DIALOG_SELECT_ITEMS_SLOT)
    {
        if(response)
        {
            new idx, wkwk = listitem;
            if(listitem == 0) idx = 6;
            else if(listitem == 1) idx = 7;
            else if(listitem == 2) idx = 8;

            if(ToyInfo[playerid][toyModel][listitem] != 0) return SendClientMessage(playerid, -1, "Slot ini sudah ditempati");

            ToyInfo[playerid][toyModel][listitem] = ItemsToys[player_choose_items_toys[playerid]][0];
            SendClientMessage(playerid, -1, "Anda berhasil membeli aksesoris");
            PlayerInfo[playerid][pCash] -= harga_toys;
            OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

            ToyInfo[playerid][toyBone][listitem] = 1;
            ToyInfo[playerid][toyScaleX][listitem] = 1.0;
            ToyInfo[playerid][toyScaleY][listitem] = 1.0;
            ToyInfo[playerid][toyScaleZ][listitem] = 1.0;
            ToyInfo[playerid][toyWear][listitem] = 0;

            SetPlayerAttachedObject(playerid, idx, ToyInfo[playerid][toyModel][wkwk], ToyInfo[playerid][toyBone][wkwk], ToyInfo[playerid][toyPositionX][wkwk], ToyInfo[playerid][toyPositionY][wkwk], ToyInfo[playerid][toyPositionZ][wkwk],
            ToyInfo[playerid][toyRotationX][wkwk], ToyInfo[playerid][toyRotationY][wkwk], ToyInfo[playerid][toyRotationZ][wkwk],
            ToyInfo[playerid][toyScaleX][wkwk], ToyInfo[playerid][toyScaleY][wkwk], ToyInfo[playerid][toyScaleZ][wkwk]);

            SavePlayerToys(playerid);
        }
    }
