	    case DIALOG_BUY_GATCHA://7561//mekabydimas
	    {
     		if(!response) return 1;
			switch(listitem)
			{
   				case 0:
      			{
      			    gString[0] = EOS;
					if(PlayerInfo[playerid][pRouble] < 50) return SCM(playerid,0xafafafff,"Kamu tidak punya cukup Gold.");
     				if(PlayerInfo[playerid][pCrates][0] > 5) return Error(playerid,"Anda tidak bisa membeli tiket melebihi 5");
     				PlayerInfo[playerid][pCrates][0] += 1;
     				save_crates(playerid);
					PlayerInfo[playerid][pRouble] -= 50;
     				SCM(playerid, -1,"Anda Berhasil Membeli 1 Tiket Rare");
				}
				case 1:
				{
  					gString[0] = EOS;
					if(PlayerInfo[playerid][pRouble] < 100) return SCM(playerid,0xafafafff,"Kamu tidak punya cukup Gold.");
     				if(PlayerInfo[playerid][pCrates][1] > 5) return Error(playerid,"Anda tidak bisa membeli tiket melebihi 5");
     				PlayerInfo[playerid][pCrates][1] += 1;
     				save_crates(playerid);
					PlayerInfo[playerid][pRouble] -= 100;
     				SCM(playerid, -1, "Anda Berhasil Membeli 1 Tiket Epic");
				}
				case 2:
				{
  					gString[0] = EOS;
					if(PlayerInfo[playerid][pRouble] < 150) return SCM(playerid,0xafafafff,"Kamu tidak punya cukup Gold.");
     				if(PlayerInfo[playerid][pCrates][2] > 5) return Error(playerid,"Anda tidak bisa membeli tiket melebihi 5");
