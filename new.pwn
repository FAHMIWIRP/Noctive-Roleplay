    case 3827: // Ambil Redmoney
    {
        if(!response) return 1;
        new car_id = GetPlayerUseListitem(playerid);
        new amount = strval(inputtext);
        if(amount <= 0) return Error(playerid, "Jumlah tidak valid!");
        if(CarInfo[playerid][cRedmoney][car_id] < amount) return Error(playerid, "Redmoney di bagasi tidak cukup!");

        CarInfo[playerid][cRedmoney][car_id] -= amount;
        PlayerInfo[playerid][pRedmoney] += amount; // ganti pRedmoney sesuai enum pInfo kamu
        SCMF(playerid, COLOR_GREEN, "Anda mengambil $%d Redmoney dari bagasi.", amount);
        SaveCars(playerid);
    }

    case 3828: // Taruh Redmoney (Max 20.000)
    {
        if(!response) return 1;
        new car_id = GetPlayerUseListitem(playerid);
        new amount = strval(inputtext);
        if(amount <= 0) return Error(playerid, "Jumlah tidak valid!");
        if(PlayerInfo[playerid][pRedmoney] < amount) return Error(playerid, "Anda tidak memiliki Redmoney sebanyak itu!");
        if(CarInfo[playerid][cRedmoney][car_id] + amount > 20000) return Error(playerid, "Kapasitas Redmoney bagasi penuh! (Maksimal $20.000)");

        PlayerInfo[playerid][pRedmoney] -= amount;
        CarInfo[playerid][cRedmoney][car_id] += amount;
        SCMF(playerid, COLOR_GREEN, "Anda menyimpan $%d Redmoney ke bagasi.", amount);
        SaveCars(playerid);
