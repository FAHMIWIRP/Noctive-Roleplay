{
     OnCinematicTimer(playerid);
     SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Telah Skip Tour Location!");
     return 1;
}
CMD:gacha(playerid, params[])
{
