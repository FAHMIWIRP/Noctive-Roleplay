	    if(KlikBatu[playerid] < TargetKlik[playerid])
	    {
	        new str[64];
	        if(JenisBatu[playerid] == 1) {
	            format(str, sizeof(str), "~w~BATU BIASA: ~r~%d/%d", KlikBatu[playerid], TargetKlik[playerid]);
	        } else {
	            format(str, sizeof(str), "~g~BATU GIOK: ~r~%d/%d", KlikBatu[playerid], TargetKlik[playerid]);
	        }
	        PlayerTextDrawSetString(playerid, MinerTD[playerid][2], str);
	        
	        // Panggil fungsi lompat posisi acak baru yang sudah dikunci
	        RefreshStonePosition(playerid);
	    }
	    else 
	    {
	        // SELESAI MINING (Matikan status mining & hilangkan TextDraw)
	        IsMining[playerid] = 0;
