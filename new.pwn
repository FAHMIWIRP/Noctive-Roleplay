    }
    if (PlayerInfo[targetid][pSususapi] > 0) {
        format(szItem, sizeof(szItem), "Susu Sapi\t%d\n", PlayerInfo[targetid][pSususapi]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pKayu] > 0) {
        format(szItem, sizeof(szItem), "Kayu\t%d\n", PlayerInfo[targetid][pKayu]);
        strcat(ilham, szItem);
    }

        // --- Pengecekan Expired secara real-time ---
    if(PlayerInfo[targetid][pFirearms] == 1 && gettime() > PlayerInfo[targetid][pFirearmsExpire]) {
        PlayerInfo[targetid][pFirearms] = 0;       // Cabut status lisensinya karena sudah lewat waktu
        PlayerInfo[targetid][pFirearmsExpire] = 0; // Reset waktu expired
    }

    // Menentukan Warna Teks Dialog Senjata
    new colorStr[16];
    if(PlayerInfo[targetid][pFirearms] == 1) {
        format(colorStr, sizeof(colorStr), "{FFFFFF}"); // Warna PUTIH jika punya lisensi aktif
    } else {
        format(colorStr, sizeof(colorStr), "{FF0000}"); // Warna MERAH jika tidak punya lisensi / expired
    }

    // Loop data senjata target
    new weaponid, ammo;
    for (new slot = 0; slot < 13; slot++) {
        GetPlayerWeaponData(targetid, slot, weaponid, ammo);
        if (weaponid != 0 && ammo > 0) {
            new wname[32];
            GetWeaponName(weaponid, wname, sizeof(wname));
            
            // Format string menggunakan colorStr yang sudah ditentukan di atas
            format(szItem, sizeof(szItem), "%s%s\t%s%d Ammo\n", colorStr, wname, colorStr, ammo);
            strcat(ilham, szItem);
        }
    }

    if (strlen(ilham) <= 20) strcat(ilham, "Tas kosong.\n");

    new name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, name, sizeof(name));
    format(String, sizeof(String), "Isi Tas %s", name);
    ShowPlayerDialog(playerid, DIALOG_INVENTORY, DIALOG_STYLE_TABLIST_HEADERS, String, ilham, "Tutup", "");
    return 1;
}

CMD:frisk(playerid, params[])
{
    new targetid;
    if(sscanf(params, "u", targetid))
    {
        SendClientMessage(playerid, -1, "{E74C3C}[GUNAKAN]{FFFFFF} /frisk [playerid]");
        return 1;
    }
    if(targetid == playerid)
    {
        SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Anda tidak dapat menggeledah diri sendiri.");
        return 1;
    }
    if(!IsPlayerConnected(targetid))
    {
        SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Pemain tidak ditemukan!");
        return 1;
    }
    if(!ProxDetectorS(8.0, playerid, targetid))
    {
        SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Anda harus berada di dekat pemain.");
        return 1;
    }

    new name[MAX_PLAYER_NAME];
    new player[MAX_PLAYER_NAME];
    GetPlayerName(targetid, name, sizeof(name));
    GetPlayerName(playerid, player, sizeof(player));

    // Notifikasi ke pengirim
    new str[128];
    format(str, sizeof(str), "{00D9FF}[FRISK]{FFFFFF} Permintaan geledah dikirim ke {FFD700}%s (%d){FFFFFF}. Menunggu konfirmasi...", name, targetid);
    SendClientMessage(playerid, -1, str);

    // Notifikasi ke target
    format(str, sizeof(str), "{00D9FF}[FRISK]{FFFFFF} {FFD700}%s (%d){FFFFFF} ingin menggeledah Anda. Ketik {FFD700}/acc frisk{FFFFFF}/{FFD700}/deny frisk{FFFFFF}.", player, playerid);
    SendClientMessage(targetid, -1, str);

    // Menyimpan data pengirim di target
    SetPVarInt(targetid, "FriskRequestedBy", playerid + 1);
    return 1;
}

forward FriskTargetDialog(playerid, targetid);
