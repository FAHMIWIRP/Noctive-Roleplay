CMD:buatbizz(playerid, params[])
{
    if(admin_level[playerid] < 10 || !admin_logged[playerid])
        return SendClientMessage(playerid, -1, "Admin level 10 diperlukan.");

    new type, price;
    if(sscanf(params, "dd", type, price))
        return SendClientMessage(playerid, -1, "/createbizz [type] [price]");

    for(new i; i < MAX_BIZZ; i++)
    {
        if(BizzInfo[i][bEntranceX] != 0.0) continue;

        new Float:x, Float:y, Float:z;
        GetPlayerPos(playerid, x, y, z);

        BizzInfo[i][bType] = type;
        BizzInfo[i][bPrice] = price;

        BizzInfo[i][bEntranceX] = x;
        BizzInfo[i][bEntranceY] = y;
        BizzInfo[i][bEntranceZ] = z;

        BizzInfo[i][bVirtualWorld] = 0;

        BizzInfo[i][bExitX] = -27.462099;
        BizzInfo[i][bExitY] = -58.274299;
        BizzInfo[i][bExitZ] = 1003.546875;
        BizzInfo[i][bInterior] = 6;

        BizzInfo[i][bBarX] = -30.0;
        BizzInfo[i][bBarY] = -91.0;
        BizzInfo[i][bBarZ] = 1003.5;

        if(BizzInfo[i][bOplata] == 0)
            BizzInfo[i][bOplata] = 15;

        // entrance pickup
        BizzInfo[i][bPickup] = CreatePickup(19132, 23,
        BizzInfo[i][bEntranceX],
        BizzInfo[i][bEntranceY],
        BizzInfo[i][bEntranceZ],0);

        // exit pickup
        CreatePickup(19132, 23,
        BizzInfo[i][bExitX],
        BizzInfo[i][bExitY],
        BizzInfo[i][bExitZ],
        BizzInfo[i][bVirtualWorld]);

        BizzInfo[i][bLabel] = Create3DTextLabel("",
        0x00D900FF,
        BizzInfo[i][bEntranceX],
        BizzInfo[i][bEntranceY],
        BizzInfo[i][bEntranceZ],
        10.0,0,1);

        UpdateBizzLabelText(i);

        switch(BizzInfo[i][bType])
        {
            case 1: // drink
            {
                Create3DTextLabel("'/drink'",0xDC900CFF,
                BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ]+0.5,
                10.0,BizzInfo[i][bVirtualWorld],1);

                BizzInfo[i][bPickup] = CreatePickup(1484,23,
                BizzInfo[i][bBarX],
                BizzInfo[i][bBarY],
                BizzInfo[i][bBarZ],
                BizzInfo[i][bVirtualWorld]);
            }
            case 2: // eat
            {
                Create3DTextLabel("'/eat'",0xDC900CFF,
                BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ]+0.5,
                10.0,BizzInfo[i][bVirtualWorld],1);

                BizzInfo[i][bPickup] = CreatePickup(2768,23,
                BizzInfo[i][bBarX],
                BizzInfo[i][bBarY],
                BizzInfo[i][bBarZ],
                BizzInfo[i][bVirtualWorld]);
            }
            case 3: // buy
            {
                Create3DTextLabel("'/buy'",0xDC900CFF,
                BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ]+0.5,
                10.0,BizzInfo[i][bVirtualWorld],1);

                BizzInfo[i][bPickup] = CreatePickup(1274,23,
                BizzInfo[i][bBarX],
                BizzInfo[i][bBarY],
                BizzInfo[i][bBarZ],
                BizzInfo[i][bVirtualWorld]);
            }
            case 6: // clothes
            {
                Create3DTextLabel("'/clothes'",0xDC900CFF,
                BizzInfo[i][bBarX],BizzInfo[i][bBarY],BizzInfo[i][bBarZ]+0.5,
                10.0,BizzInfo[i][bVirtualWorld],1);

                BizzInfo[i][bPickup] = CreatePickup(1275,23,
                BizzInfo[i][bBarX],
                BizzInfo[i][bBarY],
                BizzInfo[i][bBarZ],
                BizzInfo[i][bVirtualWorld]);
            }
        }

        BizzInfo[i][bEntranceArea] = CreateDynamicSphere(
        BizzInfo[i][bEntranceX],
        BizzInfo[i][bEntranceY],
        BizzInfo[i][bEntranceZ],
        1);

        BizzInfo[i][bExitArea] = CreateDynamicSphere(
        BizzInfo[i][bExitX],
        BizzInfo[i][bExitY],
        BizzInfo[i][bExitZ],
        1,
        BizzInfo[i][bVirtualWorld]);

        TotalBizz++;

        new msg[128];
        format(msg,sizeof(msg),"Bizz ID %d berhasil dibuat.",i);
        SendClientMessage(playerid,-1,msg);
        return 1;
    }

    SendClientMessage(playerid,-1,"Slot bizz habis.");
    return 1;
}
CMD:rpquiz(playerid, params[])
{
    // 1. Cek apakah player sedang mengerjakan ujian
    if (pInQuiz[playerid])
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Anda masih mengerjakan ujian!");

    // 2. Cek apakah player sudah memiliki status lulus/lisensi (Ubah index pLicenses jika berbeda)
    if (PlayerInfo[playerid][pLicenses][3] == 1)
        return SendClientMessage(playerid, COLOR_GREY, "ERROR: Kamu sudah lulus ujian ini sebelumnya!");

    // 3. Cek apakah player berada di titik ujian
    if (!IsPlayerInRangeOfPoint(playerid, 2.0, 851.5891, -2101.9414, 1003.5))
        return SendClientMessage(playerid, COLOR_GREY, "ERROR: Kamu harus berada di lokasi ujian!");

    // 4. Cek Cooldown TERLEBIH DAHULU sebelum memotong uang
    if (gettime() < pQuizCooldown[playerid])
    {
        new sisa_waktu = pQuizCooldown[playerid] - gettime();
        new menit = sisa_waktu / 60;
        new detik = sisa_waktu % 60;

        new msg_cooldown[128];
        format(msg_cooldown, sizeof(msg_cooldown), "ERROR: Anda gagal sebelumnya. Tunggu %d menit %d detik lagi untuk mencoba kembali.", menit, detik);
        return SendClientMessage(playerid, 0xFF0000FF, msg_cooldown);
    }

    // 5. Cek apakah uang player cukup (Gunakan variabel Server, bukan GetPlayerMoney saja untuk mencegah desync)
    if (PlayerInfo[playerid][pCash] < 10000)
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Uang Anda tidak cukup! Dibutuhkan $10.000 untuk mengikuti ujian ini.");

    // 6. Tarik uang $10.000 (Pastikan hanya dieksekusi 1x)
    PlayerInfo[playerid][pCash] -= 10000;
    GivePlayerMoneyEx(playerid, -10000);
    // Pastikan fungsi OnPlayerUpdateAccountsPer memang ada di gamemode kamu
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

    SendClientMessage(playerid, 0xFFFF00FF, "INFO: Anda telah membayar $10.000 untuk ujian Character Story.");
    SendClientMessage(playerid, 0xFF6600FF, "PERINGATAN: Anda hanya memiliki waktu 20 detik per soal. Salah 4 kali = GAGAL.");

    // 7. Setup Awal Ujian
    pInQuiz[playerid] = true;
    pQuizSoal[playerid] = 0;
    pQuizSalah[playerid] = 0;

    // 8. Tampilkan soal pertama
    ShowRPQuiz(playerid);
    return 1;
}

// ===================== [ FUNGSI MENAMPILKAN SOAL ] =====================
forward ShowRPQuiz(playerid);
public ShowRPQuiz(playerid)
{
    new soal_index = pQuizSoal[playerid];
    new caption[128], info[512]; // Ukuran caption diperbesar agar aman

    // Format header dan pilihan jawaban
    format(caption, sizeof(caption), "Soal CS %d/20: %s", soal_index + 1, QuizData[soal_index][qPertanyaan]);
    format(info, sizeof(info), "A. %s\nB. %s\nC. %s\nD. %s",
        QuizData[soal_index][qA],
        QuizData[soal_index][qB],
        QuizData[soal_index][qC],
        QuizData[soal_index][qD]
    );

    // Tampilkan Dialog
    ShowPlayerDialog(playerid, DIALOG_RPQUIZ, DIALOG_STYLE_LIST, caption, info, "Jawab", "Batal");

    // Hapus timer lama jika ada, supaya tidak terjadi bentrok saat lanjut ke soal berikutnya
    if (pQuizTimer[playerid] != 0)
    {
        KillTimer(pQuizTimer[playerid]);
        pQuizTimer[playerid] = 0;
    }

    // Set Timer 20 detik (20000 ms)
    pQuizTimer[playerid] = SetTimerEx("QuizTimeOut", 20000, false, "i", playerid);
    return 1;
}

// ===================== [ FUNGSI WAKTU HABIS ] =====================
forward QuizTimeOut(playerid);
public QuizTimeOut(playerid)
{
    pQuizTimer[playerid] = 0; // Kosongkan ID Timer

    // Cek jika player masih ada di kuis
    if (pInQuiz[playerid])
    {
        ShowPlayerDialog(playerid, -1, DIALOG_STYLE_MSGBOX, "", "", "", ""); // Tutup dialog secara paksa
        SendClientMessage(playerid, 0xFF0000FF, "[GAGAL] Waktu 20 detik habis! Anda gagal dalam ujian Character Story.");

        // Beri Cooldown 30 Menit (30 * 60 detik = 1800)
        pQuizCooldown[playerid] = gettime() + 1800;

        // Reset Variabel Kuis
        pInQuiz[playerid] = false;
        pQuizSoal[playerid] = 0;
        pQuizSalah[playerid] = 0;
    }
    return 1;
}
CMD:stopevent(playerid, params[])
{
    if(admin_level[playerid] < 1) return PermissionError(playerid);

    g_EventActive = false;
    SendClientMessageToAll(-1, "[EVENT] Event telah berakhir.");

    if(g_EventMode == 2) // TDM
    {
        new msg[64];
        format(msg, sizeof(msg), "[EVENT] Skor Akhir: Tim Merah: %d - Tim Biru: %d", g_TDMScore[0], g_TDMScore[1]);
        SendClientMessageToAll(-1, msg);
    }

    SetPlayerPos(playerid, g_PlayerPosBeforeEvent[playerid][0], g_PlayerPosBeforeEvent[playerid][1], g_PlayerPosBeforeEvent[playerid][2]);
	SetPlayerInterior(playerid, g_PlayerInteriorBeforeEvent[playerid]);
	SetPlayerVirtualWorld(playerid, g_PlayerVWBeforeEvent[playerid]);

    // Hapus senjata event untuk semua player
    foreach(new i : Player)
    {
        if(g_EventWeapons[i] != 0) // Jika player ini pernah dapat senjata event
        {
            // Simpan senjata asli player
            new weapons[13], ammo[13];
            for(new s = 0; s < 13; s++)
            {
                GetPlayerWeaponData(i, s, weapons[s], ammo[s]);
            }

            // Reset senjata
            ResetPlayerWeapons(i);

            // Kembalikan senjata asli (kecuali senjata event)
            for(new s = 0; s < 13; s++)
            {
                if(weapons[s] != 0 && weapons[s] != g_EventWeapons[i])
                {
                    GivePlayerWeapon(i, weapons[s], ammo[s]);
                }
            }

            g_EventWeapons[i] = 0; // Reset status
        }
    }

    // Reset variabel event
    g_EventWeapon = 0;
    g_EventHealth = 100;
    g_EventArmour = 0;
    g_EventMode = 0;
    g_TDMScore[0] = g_TDMScore[1] = 0;

    return 1;
}
CMD:joinevent(playerid, params[])
{
    if (!g_EventActive)
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Event belum dimulai atau sudah berakhir.");

    // Cek apakah player sudah dalam event
    if (g_EventWeapons[playerid] != 0)
        return SendClientMessage(playerid, -1, "{FF0000}Error: {FFFFFF}Kamu sudah berada dalam event!");

    // Simpan data player sebelum event (posisi, senjata, health, armour)
    GetPlayerPos(playerid, g_PlayerPosBeforeEvent[playerid][0], g_PlayerPosBeforeEvent[playerid][1], g_PlayerPosBeforeEvent[playerid][2]);
    g_PlayerInteriorBeforeEvent[playerid] = GetPlayerInterior(playerid);
    g_PlayerVWBeforeEvent[playerid] = GetPlayerVirtualWorld(playerid);
    GetPlayerHealth(playerid, g_PlayerHealthBeforeEvent[playerid]);
    GetPlayerArmour(playerid, g_PlayerArmourBeforeEvent[playerid]);

    // Set ke arena event
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, EVENT_WORLD);
    SetPlayerPos(playerid, 1025.0, 1025.0, 10.0);

    // Simpan dan reset senjata
    for(new s = 0; s < 13; s++) {
        GetPlayerWeaponData(playerid, s, g_PlayerWeaponsBeforeEvent[playerid][s], g_PlayerAmmoBeforeEvent[playerid][s]);
    }
    ResetPlayerWeapons(playerid);

    // Berikan senjata event
    g_EventWeapons[playerid] = g_EventWeapon;
    GivePlayerWeapon(playerid, g_EventWeapon, g_EventAmmo);

    // Set health & armor sesuai setting event
    SetPlayerHealth(playerid, g_EventHealth);
    SetPlayerArmour(playerid, g_EventArmour);

    // Team handling untuk TDM
    if (g_EventMode == 2)
    {
        new team = (g_TDMTeamCount[0] > g_TDMTeamCount[1]) ? 1 : 0;
        g_TDMTeam[playerid] = team;
        g_TDMTeamCount[team]++;

        new teamColor, teamName[12];
        if(team == 0) {
            teamColor = 0xFF0000FF;
            teamName = "MERAH";
        } else {
            teamColor = 0x0000FFFF;
            teamName = "BIRU";
        }

        SetPlayerColor(playerid, teamColor);

        new msg[128];
        format(msg, sizeof(msg), "{FFFFFF}Kamu bergabung dengan {FF0000}Tim %s{FFFFFF}!", teamName);
        SendClientMessage(playerid, -1, msg);
    }
    else // Untuk DM biasa
    {
        SetPlayerColor(playerid, 0xFFFFFFFF);
    }

    SendClientMessage(playerid, -1, "{00FF00}Event: {FFFFFF}Kamu telah bergabung dalam event!");
    return 1;
}
forward EventCountdown();
public EventCountdown()
{
    g_EventCountdown--;

    if(g_EventCountdown <= 0)
    {
        KillTimer(g_EventTimer);
        TextDrawHideForAll(g_CountdownText);
        TextDrawDestroy(g_CountdownText);

        SendClientMessageToAll(-1, "{00FF00}[EVENT] {FFFFFF}Event telah dimulai! Good luck!");
        return;
    }

    new str[32];
    format(str, sizeof(str), "EVENT DIMULAI DALAM: %d", g_EventCountdown);
    TextDrawSetString(g_CountdownText, str);
}
forward Event_RespawnPlayer(playerid);
public Event_RespawnPlayer(playerid)
{
    if (!IsPlayerInEvent(playerid)) return 0; // Pastikan pemain masih dalam event

    // Atur posisi respawn berdasarkan mode event
    switch(g_EventMode)
    {
        case 1: // Deathmatch (random spawn point)
        {
            new rand = random(sizeof(g_DMSpawn));
            SetPlayerPos(playerid, g_DMSpawn[rand][0], g_DMSpawn[rand][1], g_DMSpawn[rand][2]);
        }
        case 2: // Team Deathmatch
        {
            if(g_TDMTeam[playerid] == 0) // Red Team
            {
                new rand = random(sizeof(g_RedSpawn));
                SetPlayerPos(playerid, g_RedSpawn[rand][0], g_RedSpawn[rand][1], g_RedSpawn[rand][2]);
            }
            else // Blue Team
            {
                new rand = random(sizeof(g_BlueSpawn));
                SetPlayerPos(playerid, g_BlueSpawn[rand][0], g_BlueSpawn[rand][1], g_BlueSpawn[rand][2]);
            }
        }
    }

    // Restore atribut pemain
    SetPlayerHealth(playerid, g_EventHealth);
    SetPlayerArmour(playerid, g_EventArmour);
    ResetPlayerWeapons(playerid);
    GivePlayerWeapon(playerid, g_EventWeapon, g_EventAmmo);

    // Anti spawn kill (jika perlu)
    SetPlayerVirtualWorld(playerid, EVENT_WORLD);
    TogglePlayerControllable(playerid, 1);
    SetCameraBehindPlayer(playerid);

    // Pesan info
    GameTextForPlayer(playerid, "~g~RESPAWNED", 3000, 3);
    SendClientMessage(playerid, -1, "{00FF00}[EVENT] Kamu telah respawn!");
    return 1;
}
stock IsPlayerInEvent(playerid)
{
    return (g_EventMode != 0 && GetPlayerVirtualWorld(playerid) == EVENT_WORLD);
}
CMD:mendungfghg(playerid, params[])
{
    if(IsPlayerInAnyVehicle(playerid)) return Send(playerid,-1,"Tidak dapat digunakan di dalam mobil.");
    new W4YER[500], countpd, countmd;

    new
        begalstr[64],
        ladangstr[64],
        carstealstr[64],
        warungstr[64],
        perangstr[64];

    foreach(new i : Player) if(IsACop(i))
    {
        countpd++;
    }

    foreach(new i : Player) if(IsAMedic(i))
    {
        countmd++;
    }

    if(countpd > 3  && countpd < 15 && countmd > 1 && countmd < 6)
    {
        format(begalstr, sizeof(begalstr), "{00FF00}Boleh");
        format(ladangstr, sizeof(ladangstr), "{00FF00}Boleh");
        format(carstealstr, sizeof(carstealstr), "{00FF00}Boleh");
        format(warungstr, sizeof(warungstr), "{00FF00}Boleh");
    }
    else
    {
        format(begalstr, sizeof(begalstr), "Mendung");
        format(ladangstr, sizeof(ladangstr), "Mendung");
        format(carstealstr, sizeof(carstealstr), "Mendung");
        format(warungstr, sizeof(warungstr), "Mendung");
    }

    if(countpd > 14 && countmd > 5)
    {
        format(begalstr, sizeof(begalstr), "{00FF00}Boleh");
        format(ladangstr, sizeof(ladangstr), "{00FF00}Boleh");
        format(carstealstr, sizeof(carstealstr), "{00FF00}Boleh");
        format(warungstr, sizeof(warungstr), "{00FF00}Boleh");
        format(perangstr, sizeof(perangstr), "{00FF00}Boleh");
    }
    else
    {
        format(perangstr, sizeof(perangstr), "Mendung");
    }


    format(W4YER, sizeof(W4YER), "{FFFFFF}Lost Soult Roleplay\t{FFFFFF}Keperluan\t{FFFFFF}Status\n\
    {FFFFFF}Begal/Copet/Scam\t4 Police & 2 EMS\t%s\n\
    {BABABA}Ladang/Crafting/Cuci Uang\t4 Police & 2 EMS\t%s\n\
    {FFFFFF}Carsteal\t4 Police & 2 EMS\t%s\n\
    {BABABA}Rampok Warung\t4 Police & 2 EMS\t%s\n\
    {FFFFFF}Peperangan\t15 Police & 6 EMS\t%s\n\
    ", begalstr, ladangstr, carstealstr, warungstr, perangstr
    );

    ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, "{BABABA}NOCTIVE ROLEPLAY - {FFFFFF}Status Mendung", W4YER, "Close", "");
    return 1;
}
CMD:createbizz(playerid, params[])
{
    if(admin_level[playerid] < 10) return 1;

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z); // Mendapatkan posisi pemain

    // Format query dengan posisi pemain
    new query[2080];
    mysql_format(mMysql, query, sizeof(query), "INSERT INTO `bizz` (`bID`, `bOwned`, `bOwner`, `bMessage`, `bEntranceX`, `bEntranceY`, `bEntranceZ`, `bExitX`, `bExitY`, `bExitZ`, `bBuyPrice`, `bEntranceCost`, `bMoney`, `bRaschet`, `bLocked`, `bInterior`, `bProducts`, `bPrice`, `bBarX`, `bBarY`, `bBarZ`, `bMafia`, `bType`, `bVirtualWorld`, `bOplata`, `bSlet`, `bArenda`, `bUpdMusic`, `bUpdHeal`, `bUpdSub`, `bSotrud`, `bSklad`, `bPhone`, `bProcent`) VALUES (%d, %d, '%s', '%s', %0.3f, %0.3f, %0.3f, %0.3f, %0.3f, %0.3f, %d, %d, %d, %d, %d, %d, %d, %d, %0.3f, %0.3f, %0.3f, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d, %d)", TotalBizz+1, 0, "None", "Shop 24/7", x, y, z, -25.9404, -141.564, 1003.55, 600000, 0, 0, 0, 0, 16, 5, 500, -22.2396, -138.626, 1003.55, 16, 3, TotalBizz+1, 15, 0, 700, 0, 0, 0, 0, 1000, 0, 0);
    mysql_query(mMysql, query);
    LoadBizz();
    SendClientMessage(playerid, 0xFFFFFFFF, "Bisnis berhasil ditambahkan!");
    return 1;
}
