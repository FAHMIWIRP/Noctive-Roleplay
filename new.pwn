        format(colorStr, sizeof(colorStr), "{FFFFFF}");
    } else {
        format(colorStr, sizeof(colorStr), "{FF0000}");
    }

    // Loop senjata
    new weaponid, ammo;
    for (new slot = 0; slot < 13; slot++) {
        GetPlayerWeaponData(targetid, slot, weaponid, ammo);
        if (weaponid!= 0 && ammo > 0) {
            new wname[32];
            GetWeaponName(weaponid, wname, sizeof(wname));

            format(szItem, sizeof(szItem), "%s%s\t%s%d Ammo\n", colorStr, wname, colorStr, ammo);
            strcat(ilham, szItem);
        }
    }

    if (strlen(ilham) <= 20)
        strcat(ilham, "{808080}Tas kosong.\n");

    new name[MAX_PLAYER_NAME];
    GetPlayerName(targetid, name, sizeof(name));
    format(String, sizeof(String), "Isi Tas %s", name);
    ShowPlayerDialog(playerid, DIALOG_INVENTORY, DIALOG_STYLE_TABLIST_HEADERS, String, ilham, "Tutup", "");
    return 1;
}
CMD:acc(playerid, params[])
{
    new type[32];
    if(sscanf(params, "s[32]", type))
    {
        SendClientMessage(playerid, -1, "Penggunaan: /acc frisk");
        return 1;
    }

    if(strcmp(type, "frisk", true) == 0)
    {
        new requesterPlusOne = GetPVarInt(playerid, "FriskRequestedBy");
        if(requesterPlusOne == 0)
        {
            SendClientMessage(playerid, COLOR_GREY, "Tidak ada permintaan geledah untuk Anda.");
            return 1;
        }

        new requesterid = requesterPlusOne - 1;
        DeletePVar(playerid, "FriskRequestedBy"); // Hapus PVar agar tidak disalahgunakan

        if(!IsPlayerConnected(requesterid))
        {
            SendClientMessage(playerid, COLOR_GREY, "Pemain yang meminta geledah sudah terputus dari server.");
            return 1;
        }

        // Panggil fungsi untuk menampilkan isi tas ke pengirim frisk
        FriskTargetDialog(requesterid, playerid);
        
        SendClientMessage(playerid, -1, "Anda menerima permintaan geledah.");
        return 1;
    }
    return 1;
}

CMD:deny(playerid, params[])
{
    new type[32];
    if(sscanf(params, "s[32]", type))
    {
        SendClientMessage(playerid, -1, "Penggunaan: /deny frisk");
        return 1;
    }

    if(strcmp(type, "frisk", true) == 0)
    {
        new requesterPlusOne = GetPVarInt(playerid, "FriskRequestedBy");
        if(requesterPlusOne == 0)
        {
            SendClientMessage(playerid, COLOR_GREY, "Tidak ada permintaan geledah untuk Anda.");
            return 1;
        }

        new requesterid = requesterPlusOne - 1;
        DeletePVar(playerid, "FriskRequestedBy");

        if(IsPlayerConnected(requesterid))
        {
            new name[MAX_PLAYER_NAME], str[128];
            GetPlayerName(playerid, name, sizeof(name));
            format(str, sizeof(str), "%s telah menolak permintaan geledah Anda.", name);
            SendClientMessage(requesterid, -1, str);
        }

        SendClientMessage(playerid, -1, "Anda menolak permintaan geledah.");
        return 1;
    }
    return 1;
}
// Taruh fungsi pembantu ini di luar CMD / paling bawah script agar rapi
stock TambahKeTas(playerid, &count, const name[], const code[], const format_str[], has_use, {Float,_}:...)
{
    new szItem[128];
    numargs(); 
    format(szItem, sizeof(szItem), format_str, numargs() > 5 ? getarg(6) : 0);
    
    new varName[32], varCode[32], varUse[32];
    format(varName, sizeof(varName), "InvName_%d", count);
    format(varCode, sizeof(varCode), "InvCode_%d", count);
    format(varUse, sizeof(varUse), "InvUse_%d", count);
    
    // Perbaikan di sini: Pakai format untuk memasukkan string array ke PVar agar aman dari mismatch
    new tmpName[64], tmpCode[64];
    format(tmpName, sizeof(tmpName), "%s", name);
    format(tmpCode, sizeof(tmpCode), "%s", code);
    
    SetPVarString(playerid, varName, tmpName);
    SetPVarString(playerid, varCode, tmpCode);
    SetPVarInt(playerid, varUse, has_use);
    
    count++; 
    return szItem;
}

CMD:items(playerid)
{
    PlayerPlaySound(playerid, 5202, 0.0, 0.0, 0.0);
    new ilham[10000];
    strcat(ilham, "Item\tJumlah\n");
    new count = 0; 

    if (GetPlayerMoney(playerid) > 0) {
    new uangStr[32];
    format(uangStr, sizeof(uangStr), "Uang\t{00FF00}$%s\n", FormatMoney(GetPlayerMoney(playerid)));
    strcat(ilham, TambahKeTas(playerid, count, "Uang", "money", uangStr, 0, 0));
    }
    if (PlayerInfo[playerid][pKtp] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "KTP", "ktp", "KTP\t%d\n", 0, PlayerInfo[playerid][pKtp]));
    }

    // Item Ilegal
    if (PlayerInfo[playerid][pDrugs] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Drugs", "drugs", "{FF0000}Drugs\t{FF0000}%d\n", 0, PlayerInfo[playerid][pDrugs]));
    }
    if (PlayerInfo[playerid][pCrack] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Crack", "crack", "{FF0000}Crack\t{FF0000}%d\n", 1, PlayerInfo[playerid][pCrack])); // 1 = Bisa Use
    }
    if (PlayerInfo[playerid][pMetall] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Metall", "metall", "{FF0000}Metall\t{FF0000}%d\n", 0, PlayerInfo[playerid][pMetall]));
    }
    if (PlayerInfo[playerid][pKanabis] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Kanabis", "kanabis", "{FF0000}Kanabis\t{FF0000}%d\n", 0, PlayerInfo[playerid][pKanabis]));
    }
    if (PlayerInfo[playerid][pMicin] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Marijuana", "marijuana", "{FF0000}Marijuana\t{FF0000}%d\n", 1, PlayerInfo[playerid][pMicin])); // 1 = Bisa Use
    }
    if (PlayerInfo[playerid][pRedmoney] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Red Money", "redmoney", "{FF0000}Red Money\t{FF0000}%d\n", 0, FormatMoney(PlayerInfo[playerid][pRedmoney])));
    }    
    if (PlayerInfo[playerid][pEmasilegal] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Emas Iegal", "emasilegal", "{FF0000}Emas Iegal\t{FF0000}%d\n", 0, PlayerInfo[playerid][pEmasilegal]));
    }
    if (PlayerInfo[playerid][pTelevisi] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Televisi Iegal", "Televisiilegal", "{FF0000}Televisi Iegal\t{FF0000}%d\n", 0, PlayerInfo[playerid][pTelevisi]));
    }
    if (PlayerInfo[playerid][pLockpick] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Lockpick", "Lockpick", "{FF0000}Lockpick\t{FF0000}%d\n", 0, PlayerInfo[playerid][pLockpick]));
    }

    // Kontraband
    if (PlayerInfo[playerid][pClip] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Lockpick", "lockpick", "{FF0000}Lockpick\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClip]));
    }
    if (PlayerInfo[playerid][pPaketrm] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Packet Redmoney", "paketrm", "{FF0000}Packet Redmoney\t{FF0000}%d\n", 0, PlayerInfo[playerid][pPaketrm]));
    }
    if (PlayerInfo[playerid][pDagingrusa] > 0) {
        strcat(ilham, TambahKeTas(playerid, count, "Daging Rusa", "dagingrusa", "{FF0000}Daging Rusa\t{FF0000}%d\n", 0, PlayerInfo[playerid][pDagingrusa]));
    }

    // Ammo
    if (PlayerInfo[playerid][pClipsg] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Clipsg", "clipsg", "{FF0000}Clipsg\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClipsg])); }
    if (PlayerInfo[playerid][pClipcolt] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Clipcolt", "clipcolt", "{FF0000}Clipcolt\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClipcolt])); }
    if (PlayerInfo[playerid][pClipde] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Clipde", "clipde", "{FF0000}Clipde\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClipde])); }
    if (PlayerInfo[playerid][pClipak47] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Clipak47", "clipak47", "{FF0000}Clipak47\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClipak47])); }
    if (PlayerInfo[playerid][pClipslc] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Clipslc", "clipslc", "{FF0000}Clipslc\t{FF0000}%d\n", 0, PlayerInfo[playerid][pClipslc])); }

    // Sumber Daya
    if (PlayerInfo[playerid][pComponent] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Component", "component", "Component\t%d\n", 0, PlayerInfo[playerid][pComponent])); }
    if (PlayerInfo[playerid][pMinyakkotor] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Minyak Kotor", "minyakkotor", "Minyak Kotor\t%d\n", 0, PlayerInfo[playerid][pMinyakkotor])); }
    if (PlayerInfo[playerid][pMinyakbersih] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Minyak Bersih", "minyakbersih", "Minyak Bersih\t%d\n", 0, PlayerInfo[playerid][pMinyakbersih])); }
    if (PlayerInfo[playerid][pBatu] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Batu", "batu", "Batu\t%d\n", 0, PlayerInfo[playerid][pBatu])); }
    if (PlayerInfo[playerid][pBatuk] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Batu Kotor", "batuk", "Batu Kotor\t%d\n", 0, PlayerInfo[playerid][pBatuk])); }
    if (PlayerInfo[playerid][pEmas] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Emas", "emas", "Emas\t%d\n", 0, PlayerInfo[playerid][pEmas])); }
    if (PlayerInfo[playerid][pPadi] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Padi", "padi", "Padi\t%d\n", 0, PlayerInfo[playerid][pPadi])); }
    if (PlayerInfo[playerid][pSemen] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Semen", "semen", "Semen\t%d\n", 0, PlayerInfo[playerid][pSemen])); }
    if (PlayerInfo[playerid][pSeeds] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Seeds", "seeds", "Seeds\t%d\n", 0, PlayerInfo[playerid][pSeeds])); }
    if (PlayerInfo[playerid][pPaddi] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Padi Mentah", "paddimentah", "Padi Mentah\t%d\n", 0, PlayerInfo[playerid][pPaddi])); }
    if (PlayerInfo[playerid][pKentang] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Kentang", "kentang", "Kentang\t%d\n", 0, PlayerInfo[playerid][pKentang])); }
    if (PlayerInfo[playerid][pSawit] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Sawit", "sawit", "Sawit\t%d\n", 0, PlayerInfo[playerid][pSawit])); }

    // Giok
    if (PlayerInfo[playerid][pGiokhijau] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Giok Hijau", "giokhijau", "{00FF00}Giok Hijau\t{00FF00}%d\n", 0, PlayerInfo[playerid][pGiokhijau])); }
    if (PlayerInfo[playerid][pGiokputih] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Giok Putih", "giokputih", "{FFFFFF}Giok Putih\t{FFFFFF}%d\n", 0, PlayerInfo[playerid][pGiokputih])); }
    if (PlayerInfo[playerid][pGiokbintang] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Giok Bintang", "giokbintang", "{FFFF00}Giok Bintang\t{FFFF00}%d\n", 0, PlayerInfo[playerid][pGiokbintang])); }
    if (PlayerInfo[playerid][pGiokrainbow] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Giok Rainbow", "giokrainbow", "{0000FF}G{FFFF00}I{FF0000}O{FF69B4}K {FFFFFF}R{808080}A{00FFFF}I{FF1493}N{00FF00}B{800080}O{FF69B4}W\t%d\n", 0, PlayerInfo[playerid][pGiokrainbow])); }
    if (PlayerInfo[playerid][pGiokpermata] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Giok Permata", "giokpermata", "{FF3838}G{FF9900}i{FFFF00}o{00FF00}k {00FFFF}P{0099FF}e{9933FF}r{FF00FF}m{FF55BB}a{33FF99}t{FFFF55}a\t{FFFF00}%d\n", 0, PlayerInfo[playerid][pGiokpermata])); }
    if (PlayerInfo[playerid][pGiok] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Batu Giok", "giok", "Batu Giok\t%d\n", 0, PlayerInfo[playerid][pGiok])); }

    // Makanan & Kesehatan
    if (PlayerInfo[playerid][pFood] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Makanan", "snack", "Makanan\t%d\n", 1, PlayerInfo[playerid][pFood])); } // 1 = Bisa Use
    if (PlayerInfo[playerid][pDrink] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Minuman", "drink", "Minuman\t%d\n", 1, PlayerInfo[playerid][pDrink])); } // 1 = Bisa Use
    if (PlayerInfo[playerid][pHeals] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Perban", "bandage", "Perban\t%d\n", 1, PlayerInfo[playerid][pHeals])); } // 1 = Bisa Use
    if (PlayerInfo[playerid][pMedicine] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Medicine", "medicine", "Medicine\t%d\n", 1, PlayerInfo[playerid][pMedicine])); } // 1 = Bisa Use
    if (PlayerInfo[playerid][pMedkit] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Medkit", "medkit", "Medkit\t%d\n", 0, PlayerInfo[playerid][pMedkit])); }

    // Laut & Ternak
    if (PlayerInfo[playerid][pUmpan] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Umpan", "umpan", "Umpan\t%d\n", 0, PlayerInfo[playerid][pUmpan])); }
    if (PlayerInfo[playerid][pPancing] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Pancingan", "pancingan", "Pancingan\t%d\n", 0, PlayerInfo[playerid][pPancing])); }
    if (PlayerInfo[playerid][pIkan] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Fish", "fish", "Fish\t%d\n", 0, PlayerInfo[playerid][pIkan])); }
    if (PlayerInfo[playerid][pAyam] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Ayam Potong", "ayam", "Ayam Potong\t%d\n", 0, PlayerInfo[playerid][pAyam])); }
    if (PlayerInfo[playerid][pSususapi] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Susu Sapi", "sususapi", "Susu Sapi\t%d\n", 0, PlayerInfo[playerid][pSususapi])); }
    if (PlayerInfo[playerid][pKayu] > 0) { strcat(ilham, TambahKeTas(playerid, count, "Kayu", "kayu", "Kayu\t%d\n", 0, PlayerInfo[playerid][pKayu])); }
    // --- Pengecekan Expired Senjata ---
    if(PlayerInfo[playerid][pFirearms] == 1 && gettime() > PlayerInfo[playerid][pFirearmsExpire]) {
        PlayerInfo[playerid][pFirearms] = 0;       
        PlayerInfo[playerid][pFirearmsExpire] = 0; 
    }

    new colorStr[16];
    if(PlayerInfo[playerid][pFirearms] == 1) format(colorStr, sizeof(colorStr), "{FFFFFF}"); 
    else format(colorStr, sizeof(colorStr), "{FF0000}"); 

    new weaponid, ammo;
    for (new slot = 0; slot < 13; slot++) {
        GetPlayerWeaponData(playerid, slot, weaponid, ammo);
        if (weaponid != 0 && ammo > 0) {
            new wname[32], szItem[128];
            GetWeaponName(weaponid, wname, sizeof(wname));
            format(szItem, sizeof(szItem), "%s%s\t%s%d Ammo\n", colorStr, wname, colorStr, ammo);
            strcat(ilham, szItem);
            
            new varName[32], varCode[32], varUse[32];
            format(varName, sizeof(varName), "InvName_%d", count);
            format(varCode, sizeof(varCode), "InvCode_%d", count);
            format(varUse, sizeof(varUse), "InvUse_%d", count);
            SetPVarString(playerid, varName, wname);
            SetPVarString(playerid, varCode, "weapon");
            SetPVarInt(playerid, varUse, 0);
            count++;
        }
    }

    SetPVarInt(playerid, "InvCount", count); 
    if (count == 0) strcat(ilham, "Tas Kosong.\n");

    ShowPlayerDialog(playerid, DIALOG_INVENTORY, DIALOG_STYLE_TABLIST_HEADERS, "Isi Tas", ilham, "Pilih", "Tutup");
    return 1;
}
CMD:citerpan(playerid, params[])
{
    if(admin_level[playerid] < 1)
    return Info(playerid, "Anda Tidak Bisa Menggunakan Command Ini");
    new targetid;
    if(sscanf(params, "u", targetid))
    {
        SendClientMessage(playerid, -1, "Penggunaan: /citerpan [id pemain]");
        return 1;
    }
    for (new i = 0; i < 8; i++)
            {
             PlayerTextDrawShow(targetid, panjulciter[playerid][i]);
            }
            return 1;
}
