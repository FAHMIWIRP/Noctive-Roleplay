CMD:repaint(playerid, params[])
{
    if(!IsAMech(playerid)) return 1;
    extract params -> new pembeli, color1, color2; else return SendClientMessage(playerid, -1, "/repaint [id pemain] [color 1] [color 2]");

    if(PlayerInfo[playerid][pComponent] < 28) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Component Anda Tidak Cukup, Butuh 28");
    //if(sscanf(params, "ddd",params[0],params[1],params[2],params[3])) return SCM(playerid,COLOR_WHITE,"Masukkan: /changecolor [id pemain][id warna 1][id warna 2][slot]");
    if(!(0 <= color1 <= 255)) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}ID Warna 0 - 255");
    if(!(0 <= color2 <= 255)) return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}ID Warna 0 - 255");

    if(!ProxDetectorS(5.0, playerid, pembeli))
        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pemainnya Terlalu Jauh");
    if(!IsPlayerDriver(pembeli))
        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Mengemudi");

    new u_car = GetPlayerUseHomeCar(pembeli);

    if(u_car == -1)
        return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Pelanggan Harus Menggunakan Mobil Pribadi");

    SetPlayerUseListitem(pembeli, u_car);

    new u_car_0 = GetPlayerUseListitem(pembeli);
    new vehicleid = GetPlayerVehicleID(pembeli);

    ChangeVehicleColor(vehicleid, color1, color2);

    CarInfo[pembeli][cColor1][u_car_0] = color1;
    CarInfo[pembeli][cColor2][u_car_0] = color2;

    SaveCars(pembeli);

    PlayerInfo[playerid][pComponent] -= 28;
    OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
    return 1;
}
CMD:buylockpick(playerid, params[])
{
    // 1. Cek apakah pemain berada di koordinat yang tepat (Radius 3.0)
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 287.804656, -109.781715, 1001.515625))
    {
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Anda tidak berada di lokasi pembelian Lockpick!");
    }

    // 2. Cek apakah pemain memiliki minimal 10.000 Red Money
    if(PlayerInfo[playerid][pRedmoney] < 10000)
    {
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Uang Red Money Anda tidak cukup! (Butuh: 10.000$)");
    }

    // 3. Proses potong Red Money dan tambah Lockpick
    PlayerInfo[playerid][pRedmoney] -= 10000;

    // Asumsi nama variabel lockpick kamu adalah 'pLockpick'
    // Silakan ganti pLockpick dengan variabel yang sesuai di gamemode kamu jika berbeda
    PlayerInfo[playerid][pLockpick] += 1;

    // 4. Update data langsung ke database MySQL agar tidak hilang
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pLockpick", PlayerInfo[playerid][pLockpick]); // Sesuaikan juga nama di dalam tanda kutip ini

    // 5. Kirim pesan sukses
    SendClientMessage(playerid, -1, "SERVER: Anda berhasil membeli 1 buah {5996FF}Lockpick{FFFFFF} seharga {FF0000}10.000$ Red Money.");

    return 1;
}
CMD:repair(playerid, params[])
{
	if(!IsAMech(playerid)) return 1;
	if(PlayerInfo[playerid][pComponent] < 15) return SCM(playerid, COLOR_GREY, "Component Anda Tidak Cukup");
    if(GetPlayerState(playerid) != 2) return SendClientMessage(playerid, -1, "Kamu tidak berada di kursi pengemudi!");
    RepairVehicle(GetPlayerVehicleID(playerid));
    PlayerInfo[playerid][pComponent] -= 15;
	OnPlayerUpdateAccountsPer(playerid, "pComponent", PlayerInfo[playerid][pComponent]);
    SendClientMessage(playerid, -1, "Kendaraan berhasil di perbaiki.");
    PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
    return 1;
}
//Drugs
forward PlantGrowth(id);
public PlantGrowth(id)
{
    new label_string[128];
    PlantData[id][plantGrowth] += RandomEx(3, 7);

	if(PlantData[id][plantGrowth] >= HASIL_GANJA_PER_TANAMAN) {
	    PlantData[id][plantGrowth] = HASIL_GANJA_PER_TANAMAN;
	    KillTimer(PlantData[id][plantTimer]);
	    PlantData[id][plantTimer] = SetTimerEx("PlantRot", BATAS_WAKTU_BUSUK * 1000, false, "i", id);

	    new percentage = Plant_GrowthPercentage(id);
        format(label_string, sizeof(label_string), "Rotting Drug Plant (%d)\n\n{FFFFFF}Placed by %s\nGrowth: {%06x}%d%%\n\n{FFFFFF}/plant harvest", id, PlantData[id][plantedBy], (percentage < 25) ? 0xE74C3CFF >>> 8 : 0x2ECC71FF >>> 8, percentage);
		UpdateDynamic3DTextLabelText(PlantData[id][plantLabel], 0xF1C40FFF, label_string);

		SetDynamicObjectMaterial(PlantData[id][plantObj], 2, 2, "plants_TABLETOP", "CJ_PLANT", 0xFFD35400);

		new owner_id = Plant_GetOwnerID(id);
    	if(IsPlayerConnected(owner_id)) SendClientMessage(owner_id, 0x3498DBFF, "DRUG PLANT: {FFFFFF}One of your drug plants growed, harvest it before it rots!");
	}else{
	    new percentage = Plant_GrowthPercentage(id);
	    if(!PlantData[id][gotLeaves] && percentage >= 25)
	    {
	        SetDynamicObjectMaterial(PlantData[id][plantObj], 2, 2, "plants_TABLETOP", "CJ_PLANT", 0xFF2ECC71);
	        PlantData[id][gotLeaves] = true;
		}

	    format(label_string, sizeof(label_string), "Drug Plant (%d)\n\n{FFFFFF}Placed by %s\nGrowth: {%06x}%d%%\n\n{FFFFFF}/plant harvest", id, PlantData[id][plantedBy], (percentage < 25) ? 0xE74C3CFF >>> 8 : 0x2ECC71FF >>> 8, percentage);
		UpdateDynamic3DTextLabelText(PlantData[id][plantLabel], 0xF1C40FFF, label_string);
	}

	return 1;
}

forward PlantRot(id);
public PlantRot(id)
{
    new owner_id = Plant_GetOwnerID(id);
    if(IsPlayerConnected(owner_id)) SendClientMessage(owner_id, 0x3498DBFF, "DRUG PLANT: {FFFFFF}One of your drug plants rotted!");

    Plant_Destroy(id);
	return 1;
}

forward RegenHealth(playerid, amount);
public RegenHealth(playerid, amount)
{
	amount--;

	new Float: health, Float: Armour;
	GetPlayerHealth(playerid, health);
	GetPlayerArmour(playerid, Armour);

	if(health + 3.5 < 125.0) SetPlayerHealth(playerid, health + 3.5);
	if(Armour + 1.5 < 125.0) SetPlayerArmour(playerid, Armour + 1.0);
	if(amount > 0) {
		#if defined EFEK_GANJA
	    SetPlayerDrunkLevel(playerid, 4999);
		#endif

		RegenTimer[playerid] = SetTimerEx("RegenHealth", 500, false, "ii", playerid, amount);
	}else{
	    #if defined EFEK_GANJA
	    SetPlayerDrunkLevel(playerid, 0);
		#endif

	    if(RegenTimer[playerid] != -1)
		{
		    KillTimer(RegenTimer[playerid]);
		    RegenTimer[playerid] = -1;
		}
	}

	return 1;
}

forward RemoveEffects(playerid);
public RemoveEffects(playerid)
{
	#if defined EFEK_GANJA
	SetPlayerDrunkLevel(playerid, 0);
	#endif

	SetPlayerWeather(playerid, 10);

	if(EffectTimer[playerid] != -1)
	{
	    KillTimer(EffectTimer[playerid]);
	    EffectTimer[playerid] = -1;
	}

	return 1;
}

CMD:dealer(playerid, params[])
{
	new id = GetClosestDealer(playerid);
    new f_id = GetPlayerData(playerid, pFamily);
    if(!IsAGang(playerid) && f_id == -1) return SCM(playerid, COLOR_GREY, "{FF0000}Anda Tidak Dapat Menggunakannya.");
	if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Kamu tidak dekat dengan drugs dealer");
	PlayerDrugData[playerid][DealerID] = id;
	ShowDealerMenu(playerid);
	return 1;
}

// Admin Commands - Dealers
CMD:createdealerseeds(playerid, params[])
{
    if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	new skin;
	if(sscanf(params, "i", skin)) return SendClientMessage(playerid, 0xE88732FF, "SYNTAX: {FFFFFF}/createdealer [skin id]");
	if(!(0 <= skin <= 311)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Invalid skin ID.");
	new id = Iter_Free(Dealers);
	if(id == -1) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Can't add any more dealers.");

	GetPlayerPos(playerid, DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ]);
	GetPlayerFacingAngle(playerid, DealerData[id][dealerA]);

    DealerData[id][dealerSkin] = skin;
    DealerData[id][dealerDrugs] = 0;
	DealerData[id][dealerActorID] = CreateActor(skin, DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ], DealerData[id][dealerA]);
	SetActorInvulnerable(DealerData[id][dealerActorID], 1);

	new label[128];
	format(label, sizeof(label), "Drug Dealer (%d)\n\n{FFFFFF}Use {F1C40F}/dealer {FFFFFF}to open dealer menu.", id);
	DealerData[id][dealerLabel] = CreateDynamic3DTextLabel(label, 0xF1C40FFF, DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ] + 0.25, 5.0, .testlos = 1);
	Iter_Add(Dealers, id);

	stmt_bind_value(AddDealer, 0, DB::TYPE_INTEGER, id);
	stmt_bind_value(AddDealer, 1, DB::TYPE_INTEGER, skin);
    stmt_bind_value(AddDealer, 2, DB::TYPE_FLOAT, DealerData[id][dealerX]);
    stmt_bind_value(AddDealer, 3, DB::TYPE_FLOAT, DealerData[id][dealerY]);
    stmt_bind_value(AddDealer, 4, DB::TYPE_FLOAT, DealerData[id][dealerZ]);
    stmt_bind_value(AddDealer, 5, DB::TYPE_FLOAT, DealerData[id][dealerA]);

    if(stmt_execute(AddDealer))
	{
		SendClientMessage(playerid, 0x3498DBFF, "DRUG DEALER: {FFFFFF}Dealer created.");
		SetPlayerPos(playerid, DealerData[id][dealerX] + (1.5 * floatsin(-DealerData[id][dealerA], degrees)), DealerData[id][dealerY] + (1.5 * floatcos(-DealerData[id][dealerA], degrees)), DealerData[id][dealerZ]);
	}

	return 1;
}


CMD:setdealerskin(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	if(isnull(params)) return SendClientMessage(playerid, 0xE88732FF, "SYNTAX: {FFFFFF}/setdealerskin [dealer id] [skin id]");
	new id, skin;
	if(sscanf(params, "ii", id, skin)) return SendClientMessage(playerid, 0xE88732FF, "SYNTAX: {FFFFFF}/setdealerskin [dealer id] [skin id]");
	if(!Iter_Contains(Dealers, id)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Invalid ID.");
	if(!(0 <= skin <= 311)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Invalid skin ID.");
	DealerData[id][dealerSkin] = skin;

	DestroyActor(DealerData[id][dealerActorID]);
	DealerData[id][dealerActorID] = CreateActor(skin, DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ], DealerData[id][dealerA]);
	SetActorInvulnerable(DealerData[id][dealerActorID], 1);

	stmt_bind_value(UpdateDealer, 0, DB::TYPE_INTEGER, skin);
    stmt_bind_value(UpdateDealer, 1, DB::TYPE_FLOAT, DealerData[id][dealerX]);
    stmt_bind_value(UpdateDealer, 2, DB::TYPE_FLOAT, DealerData[id][dealerY]);
    stmt_bind_value(UpdateDealer, 3, DB::TYPE_FLOAT, DealerData[id][dealerZ]);
    stmt_bind_value(UpdateDealer, 4, DB::TYPE_FLOAT, DealerData[id][dealerA]);
    stmt_bind_value(UpdateDealer, 5, DB::TYPE_INTEGER, id);

    if(stmt_execute(UpdateDealer)) SendClientMessage(playerid, 0x3498DBFF, "DRUG DEALER: {FFFFFF}Dealer updated.");
	return 1;
}

CMD:setdealerpos(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	new id;
	if(sscanf(params, "i", id)) return SendClientMessage(playerid, 0xE88732FF, "SYNTAX: {FFFFFF}/setdealerpos [dealer id]");
	if(!Iter_Contains(Dealers, id)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Invalid ID.");
	GetPlayerPos(playerid, DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ]);
	GetPlayerFacingAngle(playerid, DealerData[id][dealerA]);

	DestroyActor(DealerData[id][dealerActorID]);
	DealerData[id][dealerActorID] = CreateActor(DealerData[id][dealerSkin], DealerData[id][dealerX], DealerData[id][dealerY], DealerData[id][dealerZ], DealerData[id][dealerA]);
	SetActorInvulnerable(DealerData[id][dealerActorID], 1);

    Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, DealerData[id][dealerLabel], E_STREAMER_X, DealerData[id][dealerX]);
	Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, DealerData[id][dealerLabel], E_STREAMER_Y, DealerData[id][dealerY]);
	Streamer_SetFloatData(STREAMER_TYPE_3D_TEXT_LABEL, DealerData[id][dealerLabel], E_STREAMER_Z, DealerData[id][dealerZ] + 0.25);

	stmt_bind_value(UpdateDealer, 0, DB::TYPE_INTEGER, DealerData[id][dealerSkin]);
    stmt_bind_value(UpdateDealer, 1, DB::TYPE_FLOAT, DealerData[id][dealerX]);
    stmt_bind_value(UpdateDealer, 2, DB::TYPE_FLOAT, DealerData[id][dealerY]);
    stmt_bind_value(UpdateDealer, 3, DB::TYPE_FLOAT, DealerData[id][dealerZ]);
    stmt_bind_value(UpdateDealer, 4, DB::TYPE_FLOAT, DealerData[id][dealerA]);
    stmt_bind_value(UpdateDealer, 5, DB::TYPE_INTEGER, id);

    if(stmt_execute(UpdateDealer))
	{
		SendClientMessage(playerid, 0x3498DBFF, "DRUG DEALER: {FFFFFF}Dealer updated.");
        SetPlayerPos(playerid, DealerData[id][dealerX] + (1.5 * floatsin(-DealerData[id][dealerA], degrees)), DealerData[id][dealerY] + (1.5 * floatcos(-DealerData[id][dealerA], degrees)), DealerData[id][dealerZ]);
	}

	return 1;
}

CMD:removedealer(playerid, params[])
{
	if(admin_level[playerid] < 8 || !admin_logged[playerid]) return 1;
	new id;
	if(sscanf(params, "i", id)) return SendClientMessage(playerid, 0xE88732FF, "SYNTAX: {FFFFFF}/removedealer [dealer id]");
	if(!Iter_Contains(Dealers, id)) return SendClientMessage(playerid, 0xE74C3CFF, "ERROR: {FFFFFF}Invalid ID.");
	DestroyActor(DealerData[id][dealerActorID]);
	DestroyDynamic3DTextLabel(DealerData[id][dealerLabel]);

	DealerData[id][dealerDrugs] = 0;
	DealerData[id][dealerActorID] = -1;
	DealerData[id][dealerLabel] = Text3D: -1;
	Iter_Remove(Dealers, id);

	stmt_bind_value(RemoveDealer, 0, DB::TYPE_INTEGER, id);
    if(stmt_execute(RemoveDealer)) SendClientMessage(playerid, 0x3498DBFF, "DRUG DEALER: {FFFFFF}Dealer removed.");
	return 1;
}

CMD:selfie(playerid,params[])
{
	if(takingselfie[playerid] == 0)
	{
	    GetPlayerPos(playerid,lX[playerid],lY[playerid],lZ[playerid]);
		static Float: n1X, Float: n1Y;
		if(Degree[playerid] >= 360) Degree[playerid] = 0;
		Degree[playerid] += Speed;
		n1X = lX[playerid] + Radius * floatcos(Degree[playerid], degrees);
		n1Y = lY[playerid] + Radius * floatsin(Degree[playerid], degrees);
		SetPlayerCameraPos(playerid, n1X, n1Y, lZ[playerid] + Height);
		SetPlayerCameraLookAt(playerid, lX[playerid], lY[playerid], lZ[playerid]+1);
		SetPlayerFacingAngle(playerid, Degree[playerid] - 90.0);
		takingselfie[playerid] = 1;
		ApplyAnimation(playerid, "PED", "gang_gunstand", 4.1, 1, 1, 1, 1, 1, 1);
		return 1;
	}
    if(takingselfie[playerid] == 1)
	{
	    TogglePlayerControllable(playerid,1);
		SetCameraBehindPlayer(playerid);
	    takingselfie[playerid] = 0;
	    ApplyAnimation(playerid, "PED", "ATM", 4.1, 0, 1, 1, 0, 1, 1);
	    return 1;
	}
    return 1;
}
CMD:jetpack(playerid, params[])
{
    if(admin_level[playerid] < 2) return 1;
    {
        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USEJETPACK);
        SendClientMessage(playerid, COLOR_LIGHTRED, "Jetpack Aktif");
        return 1;
    }
}

forward CreateGun(playerid, gunid, ammo);
public CreateGun(playerid, gunid, ammo)
{
    if(!IsPlayerConnected(playerid)) return 0;
    if(gunid == 0 || ammo == 0) return 0;

    GivePlayerWeapon(playerid, gunid, ammo);
    TogglePlayerControllable(playerid, 1);
    KillTimer(pData[playerid][pArmsDealer]);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 0, 0, 0, 0, 0, 1);
    return 1;
}
stock Dialog(playerid, dialogid, style, caption[], info[], button1[], button2[])
{
	new fix_style = style;

	/*if(!GetPlayerData(playerid, P_USER_PC) && style == DIALOG_STYLE_LIST)
	{
	    fix_style = DIALOG_STYLE_INPUT;

	    SetPVarInt(playerid, "fix_style", 1);
	}*/

	return ShowPlayerDialog(playerid, dialogid, fix_style, caption, info, button1, button2);
}
CMD:arevive(playerid, params[])
{
    new targetid;
	if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /revive [ID]");

	if (targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Player Tidak Online");
	if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
	
	SetPlayerHealthEx(targetid, 100);
	SetPlayerData(targetid, pInjured, 0);
	update_int_mysql(targetid, "pInjured", 0);
	SetPlayerDrunkLevel(targetid, 0);
	SetPlayerData(targetid, pDelayDeath, 0);
	update_int_mysql(targetid, "pDelayDeath", 0);
	ClearAnimations(targetid);
	SetPlayerHealthEx(targetid, 100);
	TogglePlayerControllable(targetid, 1);
 	PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][0]);
    PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][1]);
  	Info(targetid, "You Have Been Revived By %s", Name(playerid));
    Info(playerid, "You Has Revive %s", Name(targetid));
	return 1;
}
CMD:helpup(playerid, params[])
{
    new targetid;
    
    if(PlayerInfo[playerid][pMedkit] < 1) return SendClientMessage(playerid, COLOR_RED, "Anda Tidak Memiliki Medkit.");
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /helpup [ID]");
    if (targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Player Tidak Online");
    if(!ProxDetectorS(5.0, playerid, targetid)) return SendClientMessage(playerid,COLOR_GREY,"Pemain harus berada di dekat Anda.");
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /revive [ID]");
	
	PlayerInfo[playerid][pMedkit] -= 1;
    OnPlayerUpdateAccountsPer(playerid, "pMedkit", PlayerInfo[playerid][pMedkit]);
	SetPlayerHealthEx(targetid, 40);
	SetPlayerData(targetid, pInjured, 0);
	update_int_mysql(targetid, "pInjured", 0);
	SetPlayerDrunkLevel(targetid, 0);
	SetPlayerData(targetid, pDelayDeath, 0);
	update_int_mysql(targetid, "pDelayDeath", 0);
	ClearAnimations(targetid);
	SetPlayerHealthEx(targetid, 40);
	TogglePlayerControllable(targetid, 1);
 	PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][0]);
    PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][1]);
  	Info(targetid, "You Have Been Revived By %s", Name(playerid));
    Info(playerid, "You Has Revive %s", Name(targetid));
    // Menyimpan waktu cooldown (200 detik) dan set status cooldown
    isRevivedCooldown[targetid] = true;
    SetTimerEx("RemoveCooldown", 200 * 1000, false, "i", targetid);  // 200 detik cooldown, waktu dalam milidetik
	return 1;
}
CMD:revive(playerid, params[])
{
    new targetid;

    if(!IsAMedic(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, COLOR_GREY, "Usage: /revive [ID]");

	if (targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, COLOR_GREY, "Player Tidak Online");

    SetPlayerHealthEx(targetid, 40);
	SetPlayerData(targetid, pInjured, 0);
	update_int_mysql(targetid, "pInjured", 0);
	SetPlayerDrunkLevel(targetid, 0);
	SetPlayerData(targetid, pDelayDeath, 0);
	update_int_mysql(targetid, "pDelayDeath", 0);
	ClearAnimations(targetid);
	SetPlayerHealthEx(targetid, 40);
	TogglePlayerControllable(targetid, 1);
 	PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][0]);
    PlayerTextDrawHide(targetid, TD_DeathLayar[playerid][1]);
  	Info(targetid, "You Have Been Revived By %s", Name(playerid));
    Info(playerid, "You Has Revive %s", Name(targetid));
    // Menyimpan waktu cooldown (200 detik) dan set status cooldown
    isRevivedCooldown[targetid] = true;
    SetTimerEx("RemoveCooldown", 200 * 1000, false, "i", targetid);  // 200 detik cooldown, waktu dalam milidetik
	return 1;
}
forward RemoveCooldown(targetid);
public RemoveCooldown(targetid)
{
    isRevivedCooldown[targetid] = false;
    SendClientMessage(targetid, COLOR_GREEN, "Cooldown selesai. Anda dapat menembak dan menonjok lagi.");
}

CMD:death(playerid, params[])
{
    if(GetPlayerData(playerid, pInjured) == 0) return Error(playerid, "Anda Tidak Sedang Pingsan.");
 	new hour,minuite,second;
    gettime(hour,minuite,second);

	if(PlayerInfo[playerid][pDelayDeath] > 0) SCMF(playerid, COLOR_ISPOLZUY, "Anda Menunggu %d detik untuk menggunakan /death", PlayerInfo[playerid][pDelayDeath]);
	return 1;
}
