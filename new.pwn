CMD:createhouse(playerid, params[])
{
    // Cek level admin
    if(admin_level[playerid] < 10) return 1;

    new price, type;
    // Validasi input
    if(sscanf(params, "dd", price, type)) 
        return Send(playerid, COLOR_WHITE, "USAGE: /createhouse [price] [type, 0.small 1.medium 2.Big]");

    // 1. Cari slot kosong di array (h_id)
    new h_id = -1;
    for(new i = 0; i < MAX_HOUSES; i++)
    {
        // Mengecek apakah slot ini belum terpakai (menggunakan koordinat X sebagai penanda)
        if(HouseInfo[i][hEntrancex] == 0.0) 
        {
            h_id = i;
            break;
        }
    }

    if(h_id == -1) 
        return Send(playerid, COLOR_WHITE, "ERROR: Slot rumah sudah penuh!");

    // 2. Set posisi dan data ke array
    GetPlayerPos(playerid, HouseInfo[h_id][hEntrancex], HouseInfo[h_id][hEntrancey], HouseInfo[h_id][hEntrancez]);
    HouseInfo[h_id][hValue] = price;
    HouseInfo[h_id][hKlass] = type;
    
    // Reset data default
    HouseInfo[h_id][hOwned] = 0;
    HouseInfo[h_id][hHel] = 0;
    HouseInfo[h_id][hLock] = 0;
    HouseInfo[h_id][hUpdAD] = 0;
    HouseInfo[h_id][hUpdHel] = 0;
    HouseInfo[h_id][hUpdSub] = 0;
    HouseInfo[h_id][hUpdStore] = 0;
    HouseInfo[h_id][hSlet] = 0;
    HouseInfo[h_id][hOplata] = 0;
    format(HouseInfo[h_id][hOwner], 24, "None"); // Pastikan hOwner adalah array string

    // 3. Update visual (pickup/label)
    UpdatePickupHouse(h_id);

    // 4. Simpan ke Database
    // Kita gunakan format SQL yang benar. hID tidak perlu di-insert manual jika AUTO_INCREMENT.
    new query[512];
    mysql_format(mMysql, query, sizeof(query), "INSERT INTO `house` (`hEntrancex`, `hEntrancey`, `hEntrancez`, `hValue`, `hKlass`, `hOwner`, `hOwned`) VALUES ('%f', '%f', '%f', '%d', '%d', 'None', '0')", 
        HouseInfo[h_id][hEntrancex], 
        HouseInfo[h_id][hEntrancey], 
        HouseInfo[h_id][hEntrancez], 
        HouseInfo[h_id][hValue], 
        HouseInfo[h_id][hKlass]
    );
    
    // Gunakan tquery agar tidak lag (asynchronous)
    mysql_tquery(mMysql, query, "OnHousesCreated", "i", h_id);

    Send(playerid, COLOR_WHITE, "Rumah berhasil dibuat dan tersimpan di database!");
    return 1;
}

// Tambahkan public ini di bawah script Anda untuk menangkap ID dari database
forward OnHousesCreated(h_id);
public OnHousesCreated(h_id)
{
    // Mengambil ID baru yang dibuat oleh database agar sinkron
    HouseInfo[h_id][hID] = cache_insert_id(); 
    return 1;
}
