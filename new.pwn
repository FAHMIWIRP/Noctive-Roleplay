            {
                ShowPlayerDialog(playerid, DIALOG_MDCPLATE, DIALOG_STYLE_INPUT, "Trace Plate", "Please Input Number Plate of Target Vehicle:", "Trace", "Cancel");
            }
            if(listitem == 1)
            {
                ShowPlayerDialog(playerid, DIALOG_MDCPHONE, DIALOG_STYLE_INPUT, "Trace Phone", "Please Input Number Phone of the Target:", "Trace", "Cancel");
