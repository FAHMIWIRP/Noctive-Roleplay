		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pMedicine] -= amount; OnPlayerUpdateAccountsPer(playerid, "pMedicine", PlayerInfo[playerid][pMedicine]);
		        PlayerInfo[otherid][pMedicine] += amount; OnPlayerUpdateAccountsPer(otherid, "pMedicine", PlayerInfo[otherid][pMedicine]);
		        ShowItemNotification(playerid, false, "Medicine", amount); ShowItemNotification(otherid, true, "Medicine", amount);
