epublic: LoadFractions()
{
	new rows;
	cache_get_row_count(rows);

	new result_string[600];

	for(new i = 1; i < rows; i++)
	{
	    cache_get_value_name(i, "fName", FracInfo[i][fName], 32);
        cache_get_value_name(i, "fTag", FracInfo[i][fTag], 16);

	    cache_get_value_name_float(i, "fSpawnX", FracInfo[i][fSpawn][0]);
	    cache_get_value_name_float(i, "fSpawnY", FracInfo[i][fSpawn][1]);
	    cache_get_value_name_float(i, "fSpawnZ", FracInfo[i][fSpawn][2]);
	    cache_get_value_name_float(i, "fSpawnFA", FracInfo[i][fSpawn][3]);

	    cache_get_value_name_int(i, "fInt", FracInfo[i][fInt]);
	    cache_get_value_name_int(i, "fVw", FracInfo[i][fVw]);
	    cache_get_value_name_int(i, "fSkin1", FracInfo[i][fSkin][0]);
	    cache_get_value_name_int(i, "fSkin2", FracInfo[i][fSkin][1]);
	    cache_get_value_name_int(i, "fSkin3", FracInfo[i][fSkin][2]);
	    cache_get_value_name_int(i, "fSkin4", FracInfo[i][fSkin][3]);
	    cache_get_value_name_int(i, "fSkin5", FracInfo[i][fSkin][4]);
	    cache_get_value_name_int(i, "fSkin6", FracInfo[i][fSkin][5]);
	    cache_get_value_name_int(i, "fSkin7", FracInfo[i][fSkin][6]);
	    cache_get_value_name_int(i, "fSkin8", FracInfo[i][fSkin][7]);
	    cache_get_value_name_int(i, "fSkin9", FracInfo[i][fSkin][8]);
	    cache_get_value_name_int(i, "fSkinKolvo", FracInfo[i][fSkinKolvo]);
	    cache_get_value_name_int(i, "fRankMax", FracInfo[i][fRankMax]);
	    cache_get_value_name_int(i, "fLevel", FracInfo[i][fLevel]);

	    cache_get_value_name_int(i, "fBank0", FracInfo[i][fBank][0]); // Saldo Bank
	    cache_get_value_name_int(i, "fBank1", FracInfo[i][fBank][1]); // Saldo Bank
	    cache_get_value_name_int(i, "fBank2", FracInfo[i][fBank][2]); // Saldo Bank

	    cache_get_value_name(i, "fRankName", result_string, 600);
	    SplitString(result_string, FracRank[i], ',');

	    cache_get_value_name(i, "fSalary",result_string);
		sscanf(result_string, "p<,>a<i>[16]", FracInfo[i][fSalary]);

	    TotalFrac++;
 	}

    UpdateArmyWarehouse3D(FRACTION_ARMY_LS);
    UpdateArmyWarehouse3D(FRACTION_ARMY_SF);
    UpdateArmyWarehouse3D(FRACTION_ARMY_LV);

 	return printf("[MySQL R41-3]: Pecahan dimuat: %i pcs.", TotalFrac);
}

stock LoadVehicles()
{
    for(new i = 1, z = sizeof standart_vehicle; i < z; i++) if(standart_vehicle[i][vSpawnDelay] == 0) standart_vehicle[i][vSpawnDelay] = 600;

 	for(new i = 1, z = sizeof standart_vehicle; i < z; i++)
	{
		CreateVehicle(standart_vehicle[i][vModel], standart_vehicle[i][vX], standart_vehicle[i][vY], standart_vehicle[i][vZ]+0.3, standart_vehicle[i][vFa], standart_vehicle[i][vColors1], standart_vehicle[i][vColors2], standart_vehicle[i][vSpawnDelay]);

		LinkVehicleToInterior(i, standart_vehicle[i][vInt]);
		SetVehicleVirtualWorld(i, standart_vehicle[i][vWorld]);
		SetVehicleParamsEx(i,0,0,0,0,0,0,0);

        DestroyVehicleLabel(i);

		VehInfo[i][vFuel] = standart_vehicle[i][vFuel];
		VehInfo[i][vSost] = standart_vehicle[i][vSost];

		VehInfo[i][vInt] = standart_vehicle[i][vInt];
		VehInfo[i][vWorld] = standart_vehicle[i][vWorld];

		VehInfo[i][vFr] = standart_vehicle[i][vFr];
		VehInfo[i][vStatus] = standart_vehicle[i][vStatus];

		VehInfo[i][vRentCena] = standart_vehicle[i][vRentCena];
		VehInfo[i][vBuyCena] = standart_vehicle[i][vBuyCena];

		if(standart_vehicle[i][vFuel] < float(20)) Fuell[i] = float(50);
		else Fuell[i] = standart_vehicle[i][vFuel];
		SetVehicleParamsEx(i,0,0,0,0,0,0,0);
	}

	//Dealer mobil

	for(new i; i < MAX_VEHICLE_SHOP; i++)
	{
		for(new x, z = MAX_VEHICLE_SHOP_SLOT; x < z; x++)
		{
			new vehicleid = CreateVehicle(as_vehicle_info[i][x][0], as_vehicle_pos[x][0], as_vehicle_pos[x][1], as_vehicle_pos[x][2], as_vehicle_angle, random(128), random(128), 300);
			//LinkVehicleToInterior(vehicleid, 1);
			SetVehicleVirtualWorld(vehicleid, i + 1);
		}
	}

	return printf("Mobil dimuat: %i pcs.", sizeof standart_vehicle);
}

stock LoadGarkot1(playerid, c_id = -1, type = 0)
{
	new car;
	new Float: GPos[4];
	GetPlayerPos(playerid, GPos[0], GPos[1], GPos[2]);
	GetPlayerFacingAngle(playerid, GPos[3]);

	if(c_id == -1) c_id = PlayerInfo[playerid][pUseCar];

	if(player_home_car[playerid][c_id] != INVALID_VEHICLE_ID) DestroyVehicleEx(player_home_car[playerid][c_id]);
	if(CarInfo[playerid][cHeal][c_id] <= 300) CarInfo[playerid][cHeal][c_id] = 300;

	if(type == 0)
	{
 		car = CreateVehicle(CarInfo[playerid][cModel][c_id], GPos[0], GPos[1], GPos[2], GPos[3], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
   		SetVehicleVirtualWorld(car, 0);
    	PutPlayerInVehicle(playerid, car, 0);
 	}
	else
	{
	    car = CreateVehicle(CarInfo[playerid][cModel][c_id], GPos[0], GPos[1], GPos[2], GPos[3], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
    	PutPlayerInVehicle(playerid, car, 0);
	}

	player_spawn_car_slot[playerid] = c_id;

    SetVehicleHealth(car, CarInfo[playerid][cHeal][c_id]);


	Fuell[car] = CarInfo[playerid][cFuel][c_id];
	Milliage[car] = CarInfo[playerid][cProbeg][c_id];
	CompVeh(playerid, car);
	SetVehicleParamsEx(car,engine,lights,alarm,CarInfo[playerid][cLock][c_id],bonnet,boot,objective);

	VehInfo[car][vStatus] = 2;

    VehInfo[car][vEngineTune] = player_engine_tune[playerid][c_id];
  	VehInfo[car][vBrakeTune] = player_brake_tune[playerid][c_id];

	UpdateVehicleDamageStatus(car, CarInfo[playerid][cDamagePanel][c_id], CarInfo[playerid][cDamageDoors][c_id], CarInfo[playerid][cDamageLights][c_id], CarInfo[playerid][cDamageTires][c_id]);

    vehicle_owner_id[car] = playerid;

	player_home_car[playerid][c_id] = car;
	player_car_keys[playerid][c_id] = 1;

	return true;
}
stock LoadMyCar(playerid, c_id = -1, type = 0)
{
	if(CarInfo[playerid][cHeal][c_id] < 350) {
		return 1;
	}
	new hotel_id = PlayerInfo[playerid][pHotel];
    new h = GetPlayerHouse(playerid);
    if(h == -1) h = GetPlayerHouseLodger(playerid);
	new car;

	if(c_id == -1) c_id = PlayerInfo[playerid][pUseCar];
	
    if(player_home_car[playerid][c_id] != INVALID_VEHICLE_ID) DestroyVehicleEx(player_home_car[playerid][c_id]), DestroyVehicleLabel(player_home_car[playerid][c_id]);
	if(CarInfo[playerid][cHeal][c_id] <= 350) CarInfo[playerid][cHeal][c_id] = 350;

	if(type == 0)
	{
	    car = CreateVehicle(CarInfo[playerid][cModel][c_id], player_car_park[playerid][c_id][0], player_car_park[playerid][c_id][1], player_car_park[playerid][c_id][2], player_car_park[playerid][c_id][3], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
	    SetVehicleVirtualWorld(car, 0);
	    LinkVehicleToInterior(car, 0);
	}
	else
	{
	    if(h == -1 && hotel_id == -1) return 1;

		if(hotel_id != -1)
		{
		    car = CreateVehicle(CarInfo[playerid][cModel][c_id], 1304.3055,-1377.3057,13.6739,178.5732, CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
		}
		else car = CreateVehicle(CarInfo[playerid][cModel][c_id], HouseInfo[h][hCarx],HouseInfo[h][hCary],HouseInfo[h][hCarz],HouseInfo[h][hCarc], CarInfo[playerid][cColor1][c_id], CarInfo[playerid][cColor2][c_id], -1);
	}

    player_spawn_car_slot[playerid] = c_id;

    SetVehicleHealth(car, CarInfo[playerid][cHeal][c_id]);

	Fuell[car] = CarInfo[playerid][cFuel][c_id];
	Milliage[car] = CarInfo[playerid][cProbeg][c_id];
	CompVeh(playerid, car);
	SetVehicleParamsEx(car,engine,lights,alarm,CarInfo[playerid][cLock][c_id],bonnet,boot,objective);

	VehInfo[car][vStatus] = 2;

    VehInfo[car][vEngineTune] = player_engine_tune[playerid][c_id];
  	VehInfo[car][vBrakeTune] = player_brake_tune[playerid][c_id];

	UpdateVehicleDamageStatus(car, CarInfo[playerid][cDamagePanel][c_id], CarInfo[playerid][cDamageDoors][c_id], CarInfo[playerid][cDamageLights][c_id], CarInfo[playerid][cDamageTires][c_id]);

    vehicle_owner_id[car] = playerid;

	player_home_car[playerid][c_id] = car;
	player_car_keys[playerid][c_id] = 1;
	
    return true;
}

epublic: LoadMyNumber(playerid)
{
    new rows;
	cache_get_row_count(rows);

    String = "";
    if(!rows) return SPD(playerid,0,DIALOG_STYLE_MSGBOX, "{E5D81E}Nomor telepon!", ""W"Rekaman Pribadi Tidak Ada Rekaman.\n\nUntuk merekam salinan game yang pendek\nGunakan menu TAB atau /addcontac", "Oke", "");

    new satr[124];
	for(new i = 0; i < rows; i++)
	{
	    cache_get_value_name_int(i, "nID", NumberInfo[playerid][i][nID]);
	    cache_get_value_name_int(i, "plID", NumberInfo[playerid][i][plID]);
 		cache_get_value_name(i, "nName", NumberInfo[playerid][i][numName], 64);
 		cache_get_value_name_int(i, "nNumber", NumberInfo[playerid][i][nNumber]);

		format(satr,sizeof(satr),""W"%s - tel. %d\n", NumberInfo[playerid][i][numName], NumberInfo[playerid][i][nNumber]);
		strcat(String,satr);
	}
	SPD(playerid,188,DIALOG_STYLE_INPUT, "Buku telepon", String, "Pilih", "Keluar");
	return 1;
}
stock t_SetPlayerPos(playerid, Float:x,Float:y,Float:z)
{
    pDialog [ playerid ]  = false;
	TogglePlayerControllableEx(playerid, 0);
	SetTimerEx("ClearFreeze", 1000, false, "d", playerid);
	return SetPlayerPos(playerid, x,y,z);
}
stock UpdatePickupHouse(h)
{
	if(HouseInfo[h][hOwned] == 0)
	{
		DestroyDynamicMapIcon(HouseInfo[h][hMIcon]), DestroyPickup(HouseInfo[h][hPickup]);
		if(HouseInfo[h][hKlass] == 5) HouseInfo[h][hPickup] = CreatePickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else HouseInfo[h][hPickup] = CreatePickup(1273, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 31, -1, 0, -1, -1);
	}
	if(HouseInfo[h][hOwned] == 1)
	{
		DestroyDynamicMapIcon(HouseInfo[h][hMIcon]), DestroyPickup(HouseInfo[h][hPickup]);
		if(HouseInfo[h][hSlet] == 2) HouseInfo[h][hPickup] = CreatePickup(1272, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else if(HouseInfo[h][hKlass] == 5) HouseInfo[h][hPickup] = CreatePickup(1272, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		else HouseInfo[h][hPickup] = CreatePickup(1272, 23, HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez],-1);
		HouseInfo[h][hMIcon] = CreateDynamicMapIcon(HouseInfo[h][hEntrancex], HouseInfo[h][hEntrancey], HouseInfo[h][hEntrancez], 32, -1, 0, -1, -1);
	}
	return true;
}
epublic: SaveHouseAll() { for(new i; i < MAX_HOUSES; i++) { if(HouseInfo[i][hOwned] == 1) SaveHouse(i); } } // house
epublic: SaveBizzAll() { for(new b; b < TotalBizz; b++) SaveBizz(b); } // bizz
epublic: SaveABizzAll() { for(new b; b <= TotalABizz; b++) SaveABizz(b); } // azc

stock SaveAllServers()
{
	new time = GetTickCount();

    SaveHouseAll();
    SaveBizzAll();
    SaveABizzAll();
    return printf("[MySQL R41-3]: Semua data server berhasil disimpan untuk %d ms.", GetTickCount()-time);
}
stock CheckTextDay()
{
    new textday[36], year, month, day;
	getdate(year, month, day);
	switch(day)
	{
	    case 0: textday = "hari";
	    case 1,21: textday = "hari";
	    case 2..4,22..24: textday = "hari ini";
	    case 5,25..40: textday = "hari";
	}
	return textday;
}
epublic: ClearFreeze(playerid)
{
    if(GetPVarInt(playerid, "fTazzer"))
	{
		TogglePlayerControllableEx(playerid, 1);
		ClearAnimations(playerid);
		DeletePVar(playerid, "fTazzer");
		Send(playerid, COLOR_GREY, "Anda tersadar...");
	}
    else TogglePlayerControllableEx(playerid, 1);
    return 1;
}
epublic: FillCars(playerid,finbenz,benz)
{
	new b = player_enter_fuel[playerid];
	if(b == 0) return TogglePlayerControllableEx(playerid, true), KillTimer(FillTimer[playerid]), SetPVarInt(playerid, "FillSost", 0);

	Fuell[GetPlayerVehicleID(playerid)] += 5.0;
	if(finbenz <= Fuell[GetPlayerVehicleID(playerid)])
	{
		Fuell[GetPlayerVehicleID(playerid)] = finbenz;

		GivePlayerMoneyEx(playerid, -(BizzAInfo[b][aPrice]*benz), "mesin pengisian bahan bakar");

		GiveFuelMoney(b, BizzAInfo[b][aPrice]*benz, benz / 4);

		KillTimer(FillTimer[playerid]);
		TogglePlayerControllableEx(playerid, true);
		SetPVarInt(playerid, "FillSost", 0);
		PlayerPlaySoundEx(0, BizzAInfo[b][aAreaFillX], BizzAInfo[b][aAreaFillY], BizzAInfo[b][aAreaFillZ]);
		SCMF(playerid, -1, " Anda telah berhasil mengisi bahan bakar transportasi Anda pada %d liter per %d$", benz, BizzAInfo[b][aPrice]*benz);
	}
	return true;
}
stock TextDrawKey(playerid, text[])
{
	for(new y; y < 3; y++) PlayerTextDrawShow(playerid, UseLAlt[playerid][y]);
	PlayerTextDrawSetString(playerid, UseLAlt[playerid][0], text), PlayerTextDrawColor(playerid, UseLAlt[playerid][0], -1);
	PlayerPlaySound(playerid, 45400, 0.0, 0.0, 0.0);
   	return 1;
}

stock GetPlayerHouseLodger(playerid)
{
	for(new i; i < MAX_HOUSES; i++)
	{
	    if(!HouseInfo[i][hOwned]) continue;

	    for(new x; x < MAX_HOUSE_LODGERS; x++) if(!strcmp(house_lodgers[i][x], Name(playerid), true)) return i;
 	}

 	return -1;
}

stock GetPlayerHouse(playerid)
{
	for(new i; i < MAX_HOUSES; i++)
	{
	    if(HouseInfo[i][hOwned] && !strcmp(HouseInfo[i][hOwner],Name(playerid),true)) return i;
 	}

 	return -1;
}
stock GetPlayerBizz(playerid)
{
    if(pData[playerid][pID] == 0) return -1; // Player belum login DB
	
    for(new i = 0; i < MAX_BIZZ; i++)
    {
        if(BizzInfo[i][bOwned]!= 0 && BizzInfo[i][bOwner] == pData[playerid][pID])
        {
            return i;
        }
    }
    return -1;
}

stock GetPlayerABizz(playerid)
{
	new abizz = 0;
	for(new i = 1; i <= TotalABizz; i++)
	{
	    if(BizzAInfo[i][aOwned] && !strcmp(BizzAInfo[i][aOwner],Name(playerid),true)) abizz = i;
 	}
 	return abizz;
}

stock ShowSupportStats(playerid, params)
{
	new str[380];
	String = "";

	format(str, sizeof(str), "\
	"W"Nama Pendukung:\t\t\t{1A8FA9}%s\n\n\
	{B8B2CF}Statistik:\n\
	"W"Membalas laporan:\t\t{BDCF5B}%i (%i) pcs",
	Name(params),
	PlayerInfo[params][pAdmRepDay], PlayerInfo[params][pAdmRep]);
	strcat(String,str);

	format(str, sizeof(str), "\n\n\
	{B8B2CF}Waktu:\n"W"Waktu dalam permainan hari ini:\t\t{FAEC3E}%s\n"W"AFK untuk hari ini:\t\t{F5C327}%s",
 		Convert(PlayerInfo[params][pInGameSeconds]), Convert(PlayerInfo[params][pInGameAFKSeconds]));
	strcat(String,str);
	SPD(playerid,0000,DIALOG_STYLE_MSGBOX,"{E5D81E}Statistik Pendukung", String, "Tutup", "");
	return 1;
}

stock ShowAdminStats(playerid, params)
{
	format(String, sizeof String, "\
	"W"Nama admin:\t\t\t{1A8FA9}%s\n"W"Tingkat administrasi:\t\t%d LVL\nAdministrator Diangkat:\t\t%s\n\n\
	{B8B2CF}Statistik:\n\
	"W"Membalas laporan:\t\t{BDCF5B}%d (%i)\n\
	"W"Gags dikeluarkan:\t\t{BDCF5B}%d pcs\n\
	"W"Dipenjara:\t\t{BDCF5B}%d orang\n\
	"W"Menendang:\t\t\t{BDCF5B}%d orang\n\
	"W"Diresapi:\t\t\t{BDCF5B}%d orang\n\
	"W"Dilarang:\t\t\t{BDCF5B}%d orang",
	Name(params), admin_level[params], PlayerInfo[params][pDataNaz], PlayerInfo[params][pAdmRepDay], PlayerInfo[params][pAdmRep], PlayerInfo[params][pAdmMute], PlayerInfo[params][pAdmPrison], PlayerInfo[params][pAdmKick],
	PlayerInfo[params][pAdmWarn], PlayerInfo[params][pAdmBan]);

	//

	format(String, sizeof String, "%s\n\n\
	{B8B2CF}Waktu:\n"W"Waktu dalam permainan hari ini:\t\t{FAEC3E}%s\n"W"AFK untuk hari ini:\t\t{F5C327}%s",
 		String, ConvertSeconds(PlayerInfo[params][pInGameSeconds]), ConvertSeconds(PlayerInfo[params][pInGameAFKSeconds]));

	return SPD(playerid,0000,DIALOG_STYLE_MSGBOX,"{E5D81E}Statistik Admin", String, "Tutup", "");
}
stock ShowPlayerStats(playerid, params)
{
	if(PlayerInfo[params][pLogin] == 0) return 1;
	new str[324];

	new atext[20], jtext[229];
	if(PlayerInfo[params][pSex] == 1) atext = "Laki-laki", jtext = "Menikah dengan:\t\t\t-\n";
	else atext = "Perempuan", jtext = "Menikah dengan:\t\t\t-\n";

	new htext[32], h_id = GetPlayerHouse(params);
	/*if(GetPlayerHouse(params) != -1) htext = "Tuna wisma";
	else format(htext, sizeof(htext), "Nomor rumah%d", GetPlayerHouse(params));*/
	if(h_id != -1) format(htext, sizeof(htext), "Nomor rumah%d ($%i)", h_id, HouseInfo[h_id][hValue]);
	else if(PlayerInfo[playerid][pHotel] != -1) format(htext, sizeof(htext), "No. hotel%d", PlayerInfo[playerid][pHotel]);
	else htext = "Tuna wisma";

	new btext[64], b_id = GetPlayerBizz(params);
	if(b_id == -1) btext = "Tidak";
	else format(btext, sizeof(btext), "%s ($%i)", BizzInfo[b_id][bMessage], BizzInfo[b_id][bMoney]);

	new azctext[64], a_id = GetPlayerABizz(params);
	if(a_id == 0) azctext = "Tidak";
	else format(azctext, sizeof(azctext), "%s ($%i)", BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aMoney]);

	new drank[20];
	switch(PlayerInfo[params][pLevel])
	{
 		case 1..2: drank = "Pemula";
 		case 3..5: drank = "Pemula";
	 	case 6..11: drank = "Tentu";
	 	case 12..15: drank = "Pemain reguler";
	 	case 16..20: drank = "Dikuasai";
	 	case 21..25: drank = "Kakek";
	 	default: drank = "Veteran";
	}

	if(PlayerInfo[params][pLeader]) drank = "Pemimpin";
	if(admin_level[params]) drank = "Admin";

	new infofrac[32];
	if(PlayerInfo[params][pMember] == 0) infofrac = "-";
	else format(infofrac, sizeof(infofrac), "%s", FracInfo[PlayerInfo[params][pMember]][fName]);

	new infojob[64];
	if(PlayerInfo[params][pJob] == 0 && PlayerInfo[params][pMember] == 0) infojob = "Menganggur";
	else if(PlayerInfo[params][pJob] != 0) format(infojob, sizeof(infojob), "%s", NamesJob(params));
	else if(PlayerInfo[params][pMember] != 0) format(infojob, sizeof(infojob), "%s", FracRank[PlayerInfo[params][pMember]][PlayerInfo[params][pRank]]);

	String = "";
	format(str, sizeof(str), "\
	{ffffff}Nama:\t\t\t\t{1A8FA9}%s\n\
	"W"Level:\t\t\t%d (%d dari %d)\n\
	Uang ada di tangan:\t\t%d$\n\
	Uang di bank:\t\t%d$\n\
	Nomor telepon:\t\t%d\n\
	Di telepon:\t\t%d$\n\
	Ketaatan hukum:\t\t%d\n\
	Tingkat yang diinginkan:\t\t%d\n\
	Obat-obatan:\t\t\t%d gr\n\
	Kartrid:\t\t\t%d pcs\n\
	Metall:\t\t\t%d kg\n\
	Gender:\t\t\t\t%s\n\
	Kecanduan:\t\t\t%i\n",
	Name(params), PlayerInfo[params][pLevel], PlayerInfo[params][pExp], (PlayerInfo[params][pLevel]+1)*4, PlayerInfo[params][pCash], PlayerInfo[params][pBank], PlayerInfo[params][pNumber],
	PlayerInfo[params][pSummaNumber], PlayerInfo[params][pZakon], PlayerInfo[params][pWanted], PlayerInfo[params][pDrugs],
	PlayerInfo[params][pRedmoney], PlayerInfo[params][pMetall], atext, PlayerInfo[playerid][pDrugDep]);
	strcat(String,str);

 	format(str, sizeof(str), "\
	%s\n\
	Organisasi:\t\t\t%s\n\
	WorkshopId:\t\t\t%d\n\
	Pekerjaan / posisi:\t\t%s\n\n\
	Akomodasi:\t\t\t%s\n\
	Perusahaan:\t\t\t%s\n\
    SPBU:\t\t\t\t%s\n\n\
    Status Game:\t\t%s\n\
	Peringatan:\t\t%d dari 3\n\
	Status VIP:\t\t\t%s\n\
	AFK: %s\n",
 		jtext, infofrac, pData[params][pWSid], infojob, htext, btext, azctext, drank, PlayerInfo[params][pWarn], VipNames(params),
 		ConvertSeconds(PlayerInfo[params][pInGameSeconds] - PlayerInfo[params][pInGameAFKSeconds]));

	strcat(String,str);

	if(admin_level[playerid])
	{
	    strcat(String, "\nTransportasi:\n\n");

		for(new i; i < MAX_PLAYER_VEHICLES; i++)
		{
		    new model = CarInfo[params][cModel][i];
		    new price = CarInfo[params][cCost][i];

		    if(model == 0)
		    {
		        format(str, 48, "%i. Kosong\n", i + 1);
			    strcat(String, str);
		    }
		    else
			{
				format(str, 48, "%i. %s ($%i)\n", i + 1, VehicleNames[model - 400], price);
			    strcat(String, str);
			}
		}

     	format(str, 324,
	        "\nDimainkan dalam sehari: %s\n\
			AFK per hari: %s\n\
			Menang dalam satu jam terakhir: %s\n\n\
			Perangkat: %s",
			ConvertSeconds(PlayerInfo[params][pInGameSeconds]),
			ConvertSeconds(PlayerInfo[params][pInGameAFKSeconds]),
			ConvertSeconds(PlayerInfo[params][pInGameHourSeconds]),
			IsPlayerMobile(params) ? ("Android") : ("PC"));

		strcat(String ,str);
	}

	SPD(playerid,0,DIALOG_STYLE_MSGBOX,"{E5D81E}Statistik pemain",String, "Tutup", "");
	return 1;
}
stock DiiName(playerid)
{
    new name[254];
    if(admin_level[playerid] == 1) format(name, sizeof(name), "ADMIN LEVEL 1");
    else if(admin_level[playerid] == 2) format(name, sizeof(name), "ADMIN LEVEL 2");
    else if(admin_level[playerid] == 3) format(name, sizeof(name), "ADMIN GODSIDE/BADSIDE");
    else if(admin_level[playerid] == 200) format(name, sizeof(name), "OWNER");
    else if(admin_level[playerid] == 999999) format(name, sizeof(name), "DEVELOPER");
    else format(name, sizeof(name), "");
    return name;
}

stock ShowStatsBizz(playerid, i)
{
    SetPVarInt(playerid, "CheckStatsBizz",i);
    format(MySQLStr, 96, "SELECT * FROM `bizz_stats` WHERE `bID` = %d", i);
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","dd", playerid, 3);
	return 1;
}
stock ShowStatsABizz(playerid, i)
{
    SetPVarInt(playerid, "CheckStatsABizz",i);
    format(MySQLStr, 96, "SELECT * FROM `bizz_astats` WHERE `aID` = %d", i);
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","dd", playerid, 7);
	return 1;
}
stock DisplayStats(playerid, i)
{
    if(PlayerInfo[i][pLogin] == 0) return 1;

    new mstr[2048], lstr[2048], job1[32], job2[32];

    // --- PENGECEKAN NAMA JOB 1 ---
    if(PlayerInfo[i][pJobchiken] == 1) job1 = "Chicken cutting";
    else if(PlayerInfo[i][pJobconstruction] == 1) job1 = "Construction";
    else if(PlayerInfo[i][pJobminer] == 1) job1 = "Miner";
    else if(PlayerInfo[i][pJoboil] == 1) job1 = "Oil";
    else if(PlayerInfo[i][pJobcompo] == 1) job1 = "Product Component";
    else if(PlayerInfo[i][pJobpadi] == 1) job1 = "Farmer";
    else job1 = "{FF0000}None{ffffff}";

    // --- PENGECEKAN NAMA JOB 2 ---
    if(PlayerInfo[i][pJobchiken] == 2) job2 = "Chicken cutting";
    else if(PlayerInfo[i][pJobconstruction] == 2) job2 = "Construction";
    else if(PlayerInfo[i][pJobminer] == 2) job2 = "Miner";
    else if(PlayerInfo[i][pJoboil] == 2) job2 = "Oil";
    else if(PlayerInfo[i][pJobcompo] == 2) job2 = "Product Component";
    else if(PlayerInfo[i][pJobpadi] == 2) job2 = "Farmer";
    else job2 = "{FF0000}None{ffffff}";

    // --- LOGIKA HITUNG SISA HARI LISENSI SENJATA ---
    new licGunStatus[64];
    if(PlayerInfo[i][pFirearms] == 1 && PlayerInfo[i][pFirearmsExpire] > gettime()) {
        new sisaHari = (PlayerInfo[i][pFirearmsExpire] - gettime()) / 86400;

        if(sisaHari <= 0) format(licGunStatus, sizeof(licGunStatus), "{00FF00}Active (Hari Ini)");
        else format(licGunStatus, sizeof(licGunStatus), "{00FF00}Active (%d Hari)", sisaHari);
    } else {
        PlayerInfo[i][pFirearms] = 0;
        PlayerInfo[i][pFirearmsExpire] = 0;
        format(licGunStatus, sizeof(licGunStatus), "{FF0000}None");
    }

    // --- PENGECEKAN STATUS DAN EXPIRATION VIP ---
    if(PlayerInfo[i][pPanvipExpire] != 0 && gettime() > PlayerInfo[i][pPanvipExpire]) {
        // Cabut status VIP jika sudah expired
        PlayerInfo[i][pVbasic] = 0;
        PlayerInfo[i][pVsilver] = 0;
        PlayerInfo[i][pVgold] = 0;
        PlayerInfo[i][pVpro] = 0;
        PlayerInfo[i][pDonatur] = 0;

        OnPlayerUpdateAccountsPer(i, "pVbasic", 0);
        OnPlayerUpdateAccountsPer(i, "pVsilver", 0);
        OnPlayerUpdateAccountsPer(i, "pVgold", 0);
        OnPlayerUpdateAccountsPer(i, "pVpro", 0);
        OnPlayerUpdateAccountsPer(i, "pDonatur", 0);
    }

    new vipStatus[64];
    new isLifetime = (PlayerInfo[i][pPanvipExpire] == 0) ? 1 : 0;

    // Menentukan teks VIP berdasarkan variabel per-tier
    if(PlayerInfo[i][pVpro] == 1) {
        if(isLifetime) vipStatus = "{FF85F3}Profesional (Lifetime)";
        else vipStatus = "{FF85F3}Profesional";
    }
    else if(PlayerInfo[i][pVgold] == 1) {
        if(isLifetime) vipStatus = "{FFFF00}Gold (Lifetime)";
        else vipStatus = "{FFFF00}Gold";
    }
    else if(PlayerInfo[i][pVsilver] == 1) {
        if(isLifetime) vipStatus = "{BF00FF}Silver (Lifetime)";
        else vipStatus = "{BF00FF}Silver";
    }
    else if(PlayerInfo[i][pVbasic] == 1) {
        if(isLifetime) vipStatus = "{00C4FF}Basic (Lifetime)";
        else vipStatus = "{00C4FF}Basic";
    }
    else {
        vipStatus = "{FF0000}Tidak Ada";
    }

    // --- FORM DIALOG TABLIST ---
    format(mstr, sizeof(mstr), "Statistik Karakter (%s)", GetPlayerNameEx(i));
    format(lstr, sizeof(lstr), "{ffff00}Nama\t{ffff00}Keterangan\n{ffffff}Account ID\t%d\n", PlayerInfo[i][pID]);

    format(lstr, sizeof(lstr), "%sNama Karakter\t%s\n", lstr, GetPlayerNameEx(i));
    format(lstr, sizeof(lstr), "%sAlamat Email\t%s\n", lstr, PlayerInfo[i][pMail]);
    format(lstr, sizeof(lstr), "%sLevel\t%d\n", lstr, PlayerInfo[i][pLevel]);
    format(lstr, sizeof(lstr), "%sExp\t%d/%d\n", lstr, PlayerInfo[i][pExp], (PlayerInfo[i][pLevel]+1)*4);
    format(lstr, sizeof(lstr), "%sUang\t{00ff00}$%d{ffffff}\n", lstr, PlayerInfo[i][pCash]);
    format(lstr, sizeof(lstr), "%sBank\t{00ff00}$%d{ffffff}\n", lstr, PlayerInfo[i][pBank]);
    format(lstr, sizeof(lstr), "%sOnline Dalam 1 Jam\t%d Menit\n", lstr, PlayerInfo[i][pInGameSeconds]/60);
    format(lstr, sizeof(lstr), "%sOnline Dalam Segalanya\t%d Menit\n", lstr, PlayerInfo[i][pInGameHourSeconds]/60);
    format(lstr, sizeof(lstr), "%sAFK\t%d Menit\n", lstr, PlayerInfo[i][pInGameAFKSeconds]/60);
    format(lstr, sizeof(lstr), "%sNomor Ponsel\t%d\n", lstr, PlayerInfo[i][pNumber]);
    format(lstr, sizeof(lstr), "%sNomor Rekening\t%d\n", lstr, PlayerInfo[i][pNorek]);
    format(lstr, sizeof(lstr), "%sSaldo Ponsel\t{00ff00}$%d{ffffff}\n", lstr, PlayerInfo[i][pSummaNumber]);
    format(lstr, sizeof(lstr), "%sRubel\t%d\n", lstr, PlayerInfo[i][pRouble]);

    format(lstr, sizeof(lstr), "%sVIP\t%s{ffffff}\n", lstr, vipStatus);

    format(lstr, sizeof(lstr), "%sID Card\t%s\n", lstr, !PlayerInfo[i][pKtp] ? ("{FF0000}None") : ("{00FF00}Active"));
    format(lstr, sizeof(lstr), "%sCharacter Story\t%s\n", lstr, !PlayerInfo[i][pLicenses][3] ? ("{FF0000}None") : ("{00FF00}Active"));

    // --- FORMAT TAMPILAN LISENSI GUN DAN JOB ---
    format(lstr, sizeof(lstr), "%sFirearms License\t%s\n", lstr, licGunStatus);
    format(lstr, sizeof(lstr), "%sJob 1\t[ %s ]\n", lstr, job1);
    format(lstr, sizeof(lstr), "%sJob 2\t[ %s ]", lstr, job2);

    return ShowPlayerDialog(playerid, 0, DIALOG_STYLE_TABLIST_HEADERS, mstr, lstr, "Tutup","");
}
stock ShowABizz(playerid, i)
{
    new text1[30], tempstring[64];
	if(BizzInfo[i][bLocked]) text1 = "{ff0000}Stasiun ditutup";
	else text1 = "{00CC33}Stasiun terbuka";

    format(String, sizeof(String), "\
    "W"Nomor bisnis:\t\tTidak. %d\n\
    Judul:\t\t\t{CD950C}SPBU '%s'\n\
	"W"Pemilik:\t\t\t%s\n\n\
	Kota / Wilayah:\t\t%s\n\
	Distrik:\t\t\t\t%s\n\
 	Atap:\t\t\t\t%s\n\
 	Sewa wilayah:\t\t%d$ per hari\n\
	Gos. biaya:\t\t%d$\n\n\
	Kuantitas bahan bakar:\t\t%d dari %d l\n\
	Biaya bahan bakar:\t\t%d$ untuk 1 l\n\
	Saldo pengisian bahan bakar:\t\t%d$\n\
	Pendapatan hari ini:\t\t%d$\n\
	Bisnis disewa:\t\t%d/20 hari\n\
	"W"Status:\t\t\t\t%s",
	i, BizzAInfo[i][aMessage], BizzAInfo[i][aOwner], GetTownName(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY]), GetAreaName(BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY]), GetMafiaName(BizzAInfo[i][aMafia]), BizzAInfo[i][aArenda], BizzAInfo[i][aBuyPrice], BizzAInfo[i][aProducts],
	BizzAInfo[i][aSklad], BizzAInfo[i][aPrice], BizzAInfo[i][aMoney], BizzAInfo[i][aRaschet], BizzAInfo[i][aOplata], text1);

	if(BizzInfo[i][bSlet] > 0) format(tempstring,sizeof(tempstring),"\n\n{FFE569}Bisnis Anda dijelaskan dan dapat dijual ke negara bagian.."), strcat(String,tempstring);
	else strcat(String,"\n\n{99FF00}Untuk membuka dasbor bisnis Anda \nklik tombol 'Edit''");
	SPD(playerid,66,DIALOG_STYLE_MSGBOX,"{CC9900}Informasi Pengisian Bahan Bakar", String, "Edit", "Keluar");
	return 1;
}
