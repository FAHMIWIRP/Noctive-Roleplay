    LoadBizz();

	mysql_tquery(mMysql, "SELECT * FROM `taxi_bizz`", "LoadTaxiBizz", "");

	mysql_tquery(mMysql, "SELECT * FROM `fraction` ORDER BY `fID` ASC", "LoadFractions", "");
