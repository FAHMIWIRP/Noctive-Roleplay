stock VipNames(playerid)
{
	new vipname[20+1];
	switch(PlayerInfo[playerid][pVip])
	{
	    case 1: vipname= "{CD853F}BRONZE VIP";
		case 2: vipname= "{afafaf}SILVER VIP";
		case 3: vipname= "{ffff00}GOLD VIP";
		default: vipname= "Tidak";
	}
	return vipname;
}
stock GetNearestBizz(playerid, biztype, Float:distance)
{
	new retElement = -1;

	for(new b; b < TotalBizz; b++)
	{
		if(BizzInfo[b][bType] == biztype)
		{
			new Float:odist = GetPlayerDistanceFromPoint(playerid, BizzInfo[b][bEntranceX], BizzInfo[b][bEntranceY], BizzInfo[b][bEntranceZ]);
			if(retElement == -1) retElement = b, distance = odist;
			else if(odist < distance) retElement = b, distance = odist;
		}
	}
	return retElement;
}
stock GetNearestABizz(playerid, Float:distance)
{
	new retElement = -1;

	for(new b; b <= TotalABizz; b++)
	{
		new Float:odist = GetPlayerDistanceFromPoint(playerid, BizzAInfo[b][aAreaFillX], BizzAInfo[b][aAreaFillY], BizzAInfo[b][aAreaFillZ]);
		if(retElement == -1) retElement = b, distance = odist;
		else if(odist < distance) retElement = b, distance = odist;
	}
	return retElement;
}
stock GetNearestAtms(playerid, Float:distance)
{
	new retElement = -1;

	for(new atm; atm <= TotalAtms; atm++)
	{
		new Float:odist = GetPlayerDistanceFromPoint(playerid, AtmsInfo[atm][aObjectPosX], AtmsInfo[atm][aObjectPosY], AtmsInfo[atm][aObjectPosZ]);
		if(retElement == -1) retElement = atm, distance = odist;
		else if(odist < distance) retElement = atm, distance = odist;
	}
	return retElement;
}

