CMD:vehiclepanel(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, COLOR_RED, "Anda harus berada dalam kendaraan untuk menggunakan perintah ini!");
 
    SPD(playerid, 9887, DIALOG_STYLE_LIST, "VEHICLE PANEL", ""W"1. open/close door depan kiri\n2. open/close door depan kanan\n3. open/close door belakang kiri\n4. open/close door belakang kanan\n5. open/close sunroof car\n6. lock/unlock car", "Pilih", "Tutup");
    return 1;
}
