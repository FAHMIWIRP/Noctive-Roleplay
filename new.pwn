CMD:tie(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SCM(playerid, COLOR_GREY, "Anda harus duduk di kursi pengemudi.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /tie [id pemain]");

    if(GetPlayerVehicleID(playerid) != GetPlayerVehicleID(to_player)) return Send(playerid, COLOR_GREY,"Anda tidak berada di kendaraan yang sama dengan pemain ini.");

    if(!player_tie[to_player])
    {
        SCMF(playerid, -1, "Anda menautkan %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s menghubungkan Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s diikat %s",Name(playerid), GetPlayerNameEx(to_player));
    }
    else
    {
        SCMF(playerid, -1, "Anda melepaskan %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s melepaskan Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s untied %s",Name(playerid), GetPlayerNameEx(to_player));
    }

	TogglePlayerControllable(to_player, player_tie[to_player]);

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_tie[to_player] ? ("Dilepaskan") : ("diikat"),0xDD90FFFF,20.0,10000);

    player_tie[to_player] = !player_tie[to_player];

	return 1;
}

CMD:gag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /gag [id pemain]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Orang itu jauh dari Anda!");

    if(!player_gag[to_player])
    {
		if(!player_tie[to_player]) return SCM(playerid, COLOR_GREY, "Player tidak terhubung.");

        SCMF(playerid, -1, "Anda telah menyumbat %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mencekikmu", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s tersedak %s",Name(playerid), GetPlayerNameEx(to_player));
    }
    else
    {
        SCMF(playerid, -1, "Anda telah menghapus lelucon dari %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mencekikmu", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s Melepas lelucon %s",Name(playerid), GetPlayerNameEx(to_player));
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_gag[to_player] ? ("Menyisipkan lelucon") : ("menghapus lelucon"),0xDD90FFFF,20.0,10000);

    player_gag[to_player] = !player_gag[to_player];

	return 1;
}

CMD:bag(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	new to_player;

    if(sscanf(params, "u", to_player)) return Send(playerid, -1,"Enter: /bag [id pemain]");

    if(!ProxDetectorS(5.0, playerid, to_player)) return Send(playerid, COLOR_GREY,"Orang itu jauh dari Anda!");

    if(!player_bag[to_player])
    {
        if(!player_tie[to_player]) return SCM(playerid, COLOR_GREY, "Player tidak terhubung.");

        SCMF(playerid, -1, "Anda menaruh tas di kepala %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s taruh tas di kepala Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s menaruh tas di kepala %s",Name(playerid), GetPlayerNameEx(to_player));

        TextDrawBoxColor(black_display[to_player], 0x000000ff);
		TextDrawShowForPlayer(playerid, black_display[to_player]);
    }
    else
    {
        SCMF(playerid, -1, "Anda mengeluarkan tas dari kepala %s", GetPlayerNameEx(to_player));
        SCMF(to_player, -1, "%s mengambil tas Anda", GetPlayerNameEx(playerid));

        format(format_string, 188, "%s mengambil tas dari kepala %s",Name(playerid), GetPlayerNameEx(to_player));

        TextDrawHideForPlayer(playerid, black_display[playerid]);
    }

	ProxDetector(20.0, playerid, format_string, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);

	SetPlayerChatBubble(playerid, !player_bag[to_player] ? ("Taruh di tas") : ("melepas tas"),0xDD90FFFF,20.0,10000);

    player_bag[to_player] = !player_bag[to_player];

	return 1;
}

