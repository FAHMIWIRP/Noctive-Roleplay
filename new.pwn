public OnGameModeExit()
{
    	//LEMARI
	SaveYog();
    SaveGarkot();
    SaveMetalStock();
    SaveSeedStock();
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 1) SavePlantt(i);
    }
	//Drugs
	foreach(new i : Player) Player_SaveDrugs(i);
	foreach(new i : Dealers) DestroyActor(DealerData[i][dealerActorID]);
    // if (gstream) SvDeleteStream(gstream);  //sampvoice
	db_close(DrugDB);
	SaveAllServers();
	DOF2_Exit();
    mysql_close(mMysql);
    if (gstream) SvDeleteStream(gstream);
	return 1;
}
public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
    // Jika peluru mengenai pemain (hittype adalah PLAYER)
    if(hittype == BULLET_HIT_TYPE_PLAYER)
    {
        // Menyimpan informasi tentang siapa yang membunuh siapa dan dengan senjata apa
        killer_id[hitid] = playerid;
        killer_weapon[hitid] = weaponid;
        killer_clear[hitid] = 10;  // Menandakan bahwa pembunuhan ini akan memiliki waktu tertentu
    }
    
    if(weaponid == 33 && hittype == BULLET_HIT_TYPE_OBJECT)
    {
        for(new i = 0; i < MAX_DEER; i++)
        {
            if(hitid == DeerData[i][deerObjID] && DeerData[i][deerActive] && DeerData[i][deerHits] < 3)
            {
                DeerData[i][deerHits]++;
                if(DeerData[i][deerHits] >= 1)
                {
                    // Efek Rusa Tergeletak
                    SetObjectRot(DeerData[i][deerObjID], 90.0, 0.0, 0.0);
                    DeerData[i][deerLabel] = Create3DTextLabel("Tekan [ALT] Untuk Ambil Daging Rusa", 0xFFFFFFFF, DeerData[i][deerX], DeerData[i][deerY], DeerData[i][deerZ], 10.0, 0);
                }
                return 1;
            }
        }
    }
    
    // Untuk pemeriksaan cooldown pasca-revive atau sistem lainnya (misalnya menembak dilarang)
    if (isRevivedCooldown[playerid])
    {
        // Kirim pesan jika pemain mencoba menembak selama cooldown
        SendClientMessage(playerid, COLOR_RED, "Anda tidak dapat menembak selama cooldown setelah di-revive.");
        return 0;  // Hentikan tembakan jika sedang dalam cooldown
    }

    return 1;  // Izinkan tembakan jika tidak ada masalah
}
public OnPlayerGiveDamage(playerid, damagedid, Float: amount, weaponid, bodypart)
{
	new kntl[125];
    new mmk[125];
    new Float: ajg;
    new Float: asu;
	GetPlayerHealth(damagedid, ajg);
    GetPlayerArmour(playerid, asu);
	//name target
    if(PlayerInfo[damagedid][pMasked] == 1)
    {
        format(kntl, sizeof(kntl), "Mask_%d", PlayerInfo[damagedid][pMaskID]);
        PlayerTextDrawSetString(playerid, DAMAGETD[playerid][2], kntl);
    }
    else if(PlayerInfo[damagedid][pMasked] == 0)
    {
        format(mmk, sizeof(mmk), "%s", GetPlayerNameEx(damagedid));
        PlayerTextDrawSetString(playerid, DAMAGETD[playerid][2], mmk);
    }
	for(new i = 0; i < 5; i++)
	{
	    PlayerTextDrawShow(playerid, DAMAGETD[playerid][i]);
	}
	if(damagedid != INVALID_PLAYER_ID)
    {
        new name[MAX_PLAYER_NAME], str[128];
        GetPlayerName(damagedid, name, sizeof(name));
        
        format(str, sizeof(str), "~g~you give damage to %s ( -%.1f )", name, amount);
        
        PlayerTextDrawSetString(playerid, DmgNotifyTD[playerid], str);
        PlayerTextDrawShow(playerid, DmgNotifyTD[playerid]);

        // Mengatur ulang timer baru
        if(DmgNotifyTimer[playerid] != -1) KillTimer(DmgNotifyTimer[playerid]);
        DmgNotifyTimer[playerid] = SetTimerEx("HideDmgNotifyTD", 3000, false, "d", playerid);
    }
    new Float: Armous, Float:Healss;
	//darah target
    Armous = asu * 38.0/100;
    PlayerTextDrawTextSize(playerid, DAMAGETD[playerid][3], Armous, 7.0);

	Healss = ajg * 38.0/100;
	PlayerTextDrawTextSize(playerid, DAMAGETD[playerid][4], Healss, 7.0);

    PlayerPlaySound(playerid,17802,0.0,0.0,0.0);
	//untuk nge show nya
    SetTimerEx("HideDamageTD", 1000, false, "i", playerid);
	//
	if(damagedid != INVALID_PLAYER_ID)
	{
	    if(PlayerInfo[playerid][pLevel] < 3)
		{
		    new Float: health, Float: armour;

			GetPlayerHealth(damagedid, health);
		    GetPlayerArmour(damagedid, armour);

		    SetPlayerHealth(damagedid, health);
		    SetPlayerArmour(damagedid, armour);

		    SCM(playerid, COLOR_GREY, "Kerusakan dapat dilakukan dari Level 3.");
		    return 0;
		}

		killer_id[damagedid] = playerid;
		killer_weapon[damagedid] = weaponid;
		killer_clear[damagedid] = 10;
	}

    return 1;
}
