stock UpdatePlayerPizzaMark(playerid)
{
	new try_id = 0;

    find_house:

	new i = pizza_player_house[playerid] == -1 ? random(MAX_HOUSES) : pizza_player_house[playerid];

	new Float: x = HouseInfo[i][hEntrancex],
		Float: y = HouseInfo[i][hEntrancey],
		Float: z = HouseInfo[i][hEntrancez];

	try_id++;

	if(try_id == 1000) return SCM(playerid, COLOR_GREY, "Tidak dapat menemukan rumah.");

	if(HouseInfo[i][hOwned] == 0 || !PlayerToPoint(2000.0, playerid, x, y, z)) goto find_house;

	SetPlayerRaceCheckpoint(playerid, 1, x, y, z, 0.0, 0.0, 0.0, 3.0);

	pizza_player_house[playerid] = i;

	return 1;
}

