public OnGameModeInit()
{
    SvInit(48000);
    SvDebug(true);
    
    LoadYog();
    MapLocal();
    Pickup();
    LoadKanabis();
    
    gstream = SvCreateGStream(0xffff0000, "Global");
    
    print("# ++-------------------------------------------------------++");
    print("# ++--------------------------------------------------------++");
    print("# || ____   _    _   _     _ _   _ _                        ||");
    print("# |||  _ \\ / \\  | \\ | |   | | | | | |                       ||");
    print("# ||| |_) / _ \\ |  \\| |_  | | | | | |                       ||");
    print("# |||  __/ ___ \\| |\\  | |_| | |_| | |___                    ||");
    print("# |||_| /_/   \\_\\_| \\_|\\___/ \\___/|_____|                   ||");
    print("# ||                                                        ||");
    print("# || ____  _______    _______ _     ___  ____  _____ ____   ||");
    print("# |||  _ \\| ____\\ \\   / / ____| |   / _ \\|  _ \\| ____|  _ \\ ||");
    print("# ||| | | |  _|  \\ \\ / /|  _| | |  | | | | |_) |  _| | |_) |||");
    print("# ||| |_| | |___  \\ V / | |___| |__| |_| |  __/| |___|  _ < ||");
    print("# |||____/|_____|  \\_/  |_____|_____\\___/|_|   |_____|_| \\_\\||");
    print("# ||                                                        ||");
    print("# ++--------------------------------------------------------++");
    print("# ++--------------------------------------------------------++");
    print("   _      _      _      _      _      _      _      _      _  ");
    print(" _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_");
    print("(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)");
    print(" (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)");
    print("   _                                                       _  ");
    print(" _( )_     _   _  ___   ____ _____ _____     _______     _( )_");
    print("(_ o _)   | \\ | |/ _ \\ / ___|_   _|_ _\\ \\   / / ____|   (_ o _)");
    print(" (_,_)    |  \\| | | | | |     | |  | | \\ \\ / /|  _|      (_,_)");
    print("   _      | |\\  | |_| | |___  | |  | |  \\ V / | |___       _  ");
    print(" _( )_    |_| \\_|\\___/ \\____| |_| |___|  \\_/  |_____|    _( )_");
    print("(_ o _)                                                 (_ o _)");
    print(" (_,_)                                                   (_,_)");
    print("   _      _      _      _      _      _      _      _      _  ");
    print(" _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_  _( )_");
    print("(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)(_ o _)");
    print(" (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)  (_,_)");
    print(" "); // Memberikan sedikit jarak kosong di console
    
    // Cek jarak rusa setiap 1 detik (Jika < 50m rusa kabur)
    SetTimer("CheckDeerDistance", 1000, true);
    
    // Munculkan semua rusa saat server nyala
    for(new i = 0; i < MAX_DEER; i++)
    {
        SpawnSingleDeer(i);
    }
    
    // 1. Memuat data stok dari scriptfiles
    LoadSeedStock();

    // 2. Membuat Text 3D di koordinat toko benih
    new labelStr[200];
    format(labelStr, sizeof(labelStr), "{FFFFFF}Stock Seeds : {FFFF00}%d\n{FFFFFF}Price : {00FF00}$%d / seed\n{AFAFAF}Gunakan /buyseeds Untuk Membeli Seeds", SeedStock, SeedPrice);
    SeedShopLabel = CreateDynamic3DTextLabel(labelStr, 0xFFFFFFFF, SEEDS_SHOP_X, SEEDS_SHOP_Y, SEEDS_SHOP_Z, 20.0);

    // 3. Timer otomatis setiap 1 jam (3600000 ms) untuk merubah harga secara acak
    SetTimer("OnSeedPriceUpdate", 3600000, true);
    
    SetTimer("GiokSystemTimer", 60000, true);
    
    SetTimer("CheckHouseTax", 86400000, true); 
    
    LoadPlants();
    SetTimer("PlantGlobalTimer", 1000, true);
    
    // Muat data stock dari file
    LoadMetalStock();
    
    // Teks melayang di kantor taxi
    new panjl[128];
    format(panjl, sizeof(panjl), "{FFFF00}[ KANTOR TAXI ]\n{FFFFFF}/getjobtaxi - Untuk bekerja\n/keluartaxi - Untuk berhenti");
    CreateDynamic3DTextLabel(panjl, COLOR_WHITE, TAXI_JOB_X, TAXI_JOB_Y, TAXI_JOB_Z, 5.0);    
    
    // Acak harga awal antara 33 sampai 100
    g_MetalPrice = 33 + random(68); // 33 + (0 hingga 67) = 33 hingga 100

    // Buat 3D Text Label di koordinat
    new string[128];
    format(string, sizeof(string), "{FFFFFF}Stock: {FFFF00}%d\n{FFFFFF}Price: {00FF00}$%d/1\n{FFFFFF}Gunakan {FF0000}/buymetal {FFFFFF}Untuk Membeli", g_MetalStock, g_MetalPrice);
    g_MetalText = Create3DTextLabel(string, 0xFFFFFFFF, METAL_X, METAL_Y, METAL_Z, 20.0, 0, 1);

    // Set Timer untuk ganti harga setiap 1 jam (3600000 milidetik)
    SetTimer("UpdateMetalPrice", 3600000, true);

	//time
	    SetTimer("PayDay", 3600000, true);
    print("[PAYDAY] Sistem PayDay Noctive telah aktif.");
    
    // === [ TEXTDRAW JAM TENGAH BAWAH ] ===
    // X: 320.0 adalah titik tengah layar. Y: 430.0 adalah posisi di bawah.
    BottomClock_TD = TextDrawCreate(320.000000, 430.000000, "00:00:00");
    TextDrawAlignment(BottomClock_TD, 2); // 2 = Rata Tengah (Center Alignment)
    TextDrawBackgroundColor(BottomClock_TD, 255); // Background Hitam Transparan
    TextDrawFont(BottomClock_TD, 3); // Font style 3
    TextDrawLetterSize(BottomClock_TD, 0.500000, 1.500000); // Ukuran Font
    TextDrawColor(BottomClock_TD, -1); // Warna Teks: Putih
