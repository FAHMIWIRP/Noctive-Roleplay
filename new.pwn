CMD:helm(playerid, params[])
{
	new name[MAX_PLAYER_NAME];
	new string[42];
	if(PlayerInfo[playerid][pHelm] == 0)
	{
	    SetPlayerAttachedObject(playerid, 0, 18645, 2, 0.07, 0, 0, 88, 75, 0);
	    PlayerInfo[playerid][pHelm] = 1;
	    GetPlayerName(playerid, name, sizeof(name));
	    format(string, sizeof(string), "%s memakai helm nya.", name);
	    ApplyAnimation(playerid, "goggles", "goggles_put_on", 4.0, 0, 0, 0, 0, 0, 1);
	    ProxDetector(15.0, playerid, string,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
	else  if(PlayerInfo[playerid][pHelm] == 1)
	{
		if(IsPlayerAttachedObjectSlotUsed(playerid, 0)) RemovePlayerAttachedObject(playerid, 0);
		PlayerInfo[playerid][pHelm] = 0;
		GetPlayerName(playerid, name, sizeof(name));
		format(string, sizeof(string), "%s melepas helm nya.", name);
		ApplyAnimation(playerid, "goggles", "goggles_put_on", 4.0, 0, 0, 0, 0, 0, 1);
		ProxDetector(15.0, playerid, string, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	}
  	return 1;
}

stock RemovePlayerMask(playerid)
{
    if(!GetPVarInt(playerid, "use_mask")) return 1;

    SetPlayerToTeamColor(playerid);

    RemovePlayerAttachedObject(playerid, 8);

    DeletePVar(playerid, "use_mask");

    return 1;
}

CMD:checkmask(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 1) return Error(playerid, "Anda harus level 1 atau seterusnya.");
    {
        SendClientMessage(playerid, COLOR_GREY, "Masked User Onlines:");

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(IsPlayerConnected(i))
            {
				if(masked[playerid] == 1)
                {
                    Servers(playerid, "Mask_%d - %s[%d]", maskid[playerid], PlayerInfo[i][pName], i);
                }
            }
        }
    }

    return 1;
}

CMD:mask(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 5) return Error(playerid, "Anda harus level 5 atau seterusnya.");
    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
    if(PlayerInfo[playerid][pMask] == 0) return SCM(playerid, COLOR_GREY, "Anda tidak punya topeng. Segera membelinya di toko terdekat");
	if(masked[playerid] == 0)
	{
	    new str[128];
		masked[playerid] = 1;
		maskid[playerid] = random(99999);
        format(String, 188, "%s Mengambil Mask dari Baju dan memakainya dengan kedua tangan.", GetPlayerNameEx(playerid));
		ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid, "Menggunakan Mask",COLOR_PURPLE,20.0,10000);
		ApplyAnimation(playerid, "shop","ROB_Shifty",4.0,0,0,0,0,0,1);
		format(str, sizeof(str), "Mask_%d", maskid[playerid]);
		SetPlayerName(playerid, str);
	 	SetPVarInt(playerid, "mask_lama", GetPlayerColor(playerid));
	 	SetPlayerColor(playerid, COLOR_WHITE);
		SetPlayerAttachedObject(playerid, 8, 19801, 2, 0.064999, 0.028999, 0.000000, 0.000000, 80.300003, 178.900009, 1.330000, 1.25, 1.125000);
	}
    else if(masked[playerid] == 1)
    {
        masked[playerid] = 0;
        format(String, 188, "%s Melepas Topeng dan menyimpannya ke Jaket dengan kedua tangan.", GetPlayerNameEx(playerid));
		ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
		SetPlayerChatBubble(playerid, "Melepas Mask",COLOR_PURPLE,20.0,10000);
		SetPlayerName(playerid, PlayerInfo[playerid][pName]);
		SetPlayerColor(playerid, GetPVarInt(playerid, "mask_lama"));
        RemovePlayerAttachedObject(playerid, 8);
	}
	return 1;
}

