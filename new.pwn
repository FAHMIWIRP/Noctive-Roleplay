forward StopBlinkNeons(vehicleid);
public StopBlinkNeons(vehicleid)
{
	KillTimer(BlinkTimerT[vehicleid]);
 	DeleteNeons(vehicleid);
	BlinkTimer[vehicleid] = 0;
	AltFlash[vehicleid] = 0;
	return 1;
}

CMD:pay(playerid, params[]) // Transfer uang
{
    new targetid, amount;

    // 1. Ambil input langsung ke variabel targetid dan amount
    if(sscanf(params, "ud", targetid, amount)) return SendClientMessage(playerid, -1, "Gunakan: /pay [id/nama pemain] [jumlah]");

    // 2. Validasi Transaksi
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain offline.");
    if(PlayerInfo[targetid][pLogin] == 0) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain belum login.");
    if(GetPVarInt(targetid, "AFK_Time") > 2) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain ini sedang AFK.");
    if(targetid == playerid) return Send(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya untuk diri sendiri.");
    if(PlayerInfo[playerid][pLevel] < 2) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda harus memiliki minimal level 2.");
    if(amount < 1 || amount > 5000000) return SendClientMessage(playerid, 0xB4B5B7FF, "Transfer minimal $1 hingga $5.000.000.");
    if(!ProxDetectorS(4.0, playerid, targetid)) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain terlalu jauh.");
    if(amount > PlayerInfo[playerid][pCash]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki dana yang cukup.");

    // 3. Eksekusi Uang (Cukup 1 kali)
    GivePlayerMoneyEx(playerid, -amount, "transfer ke pemain");
    GivePlayerMoneyEx(targetid, amount, "transfer dari pemain");

    // 4. Kirim Log ke Discord (Nilai amount & targetid sekarang sudah terisi)
    SendMoneyLog(playerid, targetid, amount);

    // 5. Pesan In-Game & Animasi
    SCMF(playerid, COLOR_GREY, "Kamu memberikan $%i ke pemain %s[%i]", amount, Name(targetid), targetid);
    SCMF(targetid, 0x20A9FFFF, "%s[%i] memberikan uang padamu sebesar $%i", Name(playerid), playerid, amount);

    ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
    ApplyAnimation(targetid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);

    format(format_string, sizeof(format_string), "%s mentransfer $%d ke %s", Name(playerid), amount, Name(targetid));
    SetPlayerChatBubble(playerid, format_string, 0xBFF600FF, 20.0, 7000);

    // 6. Log untuk Admin Online
    foreach(new i: Player)
    {
        if(admin_level[i] > 0 && pData[i][pLogPay] == 1)
        {
            // Kirim ke 'i' (admin), bukan ke 'playerid'
            SendClientMessageEx(i, COLOR_SERVER, "LOGS: "W"%s telah memberikan uang kepada %s sebesar %s", Name(playerid), Name(targetid), FormatMoney(amount));
        }
    }

    return 1;
}
CMD:ahhhhhhhssusvsns(playerid, params[]) {
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
    new targetid, amount;
    if (sscanf(params, "ui", targetid, amount)) {
        SendClientMessage(playerid, -1, "Penggunaan: /agiverm [targetid]");
        return 1;
    }
    PlayerInfo[targetid][pRedmoney] += 10000;
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    return 1;
}

CMD:ah(playerid, params[])
{
    // Cek apakah player adalah admin level 1 dan sudah login admin
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

    ShowPlayerDialog(playerid, DIALOG_ADMIN_HELP, DIALOG_STYLE_LIST, "{0000FF}Command Admin {0000FF}Noctive {FFFF00}Roleplay", 
    "1. Trial Admin\n2. Junior Admin\n3. Senior Admin\n4. Head Admin\n5. Godside Admin\n6. Badside Admin\n7. Owner & Developer", "Pilih", "Tutup");
    return 1;
}
    
CMD:setmoney(playerid, params[])
{
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /setmoney [playerid] [value]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini di AFK");

	GivePlayerMoneyEx(params[0], params[1], "admin yang dikeluarkan");

	SCMF(playerid,-1,"Anda telah berhasil dikreditkan %s[%i] mata uang game dalam jumlah %i",Name(params[0]),params[0],params[1]);
	SCMF(params[0],-1,"Administrator %s[%i] memberimu $%i",Name(playerid),playerid,params[1]);

	format(format_string, sizeof(format_string), "Administrator %s[%d] memberi %s $%d",Name(playerid), playerid,Name(params[0]),params[1]);
	AddAdminLog(playerid, format_string);
	return true;
}
