stock green_zoneTD(playerid)
{
    if(IsPlayerInRangeOfPoint(playerid,50.0,2188.6582,-2261.6140,13.4822)
    || IsPlayerInRangeOfPoint(playerid,50.0,-1074.5400,-1185.5780,129.2188)
    || IsPlayerInRangeOfPoint(playerid,50.0,-465.3294,-64.8822,60.0557)
    || IsPlayerInRangeOfPoint(playerid,50.0,2566.8789,-1299.2484,1044.1250)
    || IsPlayerInRangeOfPoint(playerid,50.0,2579.0994,-3839.0168,13.6421)
    || IsPlayerInRangeOfPoint(playerid,50.0,1483.1418,-1715.2985,14.0469)
    || IsPlayerInRangeOfPoint(playerid,50.0,1391.894287, -30.350280, 999.910888)
    || IsPlayerInRangeOfPoint(playerid,50.0,353.1629,193.1430,1014.1797)
    || IsPlayerInRangeOfPoint(playerid,50.0,-645.0973,-912.4214,1436.1736)
    || IsPlayerInRangeOfPoint(playerid,50.0,1771.8141,-1902.8827,13.5541)
    || IsPlayerInRangeOfPoint(playerid,50.0,403.7906,-1799.5159,7.8281)
    || IsPlayerInRangeOfPoint(playerid,50.0,1971.8313,1340.5493,1516.5916)
