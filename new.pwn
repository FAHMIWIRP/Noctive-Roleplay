			if(PlayerInfo[playerid][pHoe] == 0)
		        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki Cangkul beli dulu di toko tools!");
		
		    PlayerInfo[playerid][pWorkedOnce] = 1; 
		    OnPlayerUpdateAccountsPer(playerid, "pWorkedOnce", PlayerInfo[playerid][pWorkedOnce]);
		    
