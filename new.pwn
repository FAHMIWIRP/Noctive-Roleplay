        {
          callcmd::bukagiok(playerid, "");
        }
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
		{
		    // Cek apakah pemain sedang dalam proses memotong (Anti-Spam diri sendiri)
		    if(SedangKerja[playerid] == true) 
		        return SendClientMessage(playerid, 0xFF0000FF, "Tunggu proses sebelumnya selesai!");
		
		    for(new i = 0; i < MAX_DEER; i++)
		    {
		        // 1. Cek apakah rusa ini aktif dan sudah mati
		        if(DeerData[i][deerActive] && DeerData[i][deerHits] >= 1)
		        {
		            // 2. Cek jarak ke bangkai rusa
		            if(IsPlayerInRangeOfPoint(playerid, 3.0, DeerData[i][deerX], DeerData[i][deerY], DeerData[i][deerZ]))
		            {
		                // Cek apakah rusa ini sedang diambil oleh orang lain
		                if(DeerData[i][deerBeingCut] == true)
		                {
		                    SendClientMessage(playerid, 0xFF0000FF, "Rusa ini sedang dipotong oleh orang lain!");
		                    return 1;
		                }
		
		                // 3. Cek apakah memegang pisau (ID 4)
		                if(GetPlayerWeapon(playerid) != 4) 
		                {
		                    SendClientMessage(playerid, 0xFF0000FF, "Anda membutuhkan pisau untuk mengambil daging!");
		                    return 1;
		                }
		
		                // --- MULAI PROSES ---
		                SedangKerja[playerid] = true; // Tandai pemain sedang bekerja
		                DeerData[i][deerBeingCut] = true; // Kunci status rusa agar tidak bisa diambil orang lain
		                
		                TogglePlayerControllable(playerid, 0); // Freeze
		                ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 0); 
		                
		                // SET PROGRESS BAR (20 Detik = 200ms x 100)
		                PlayerProgressValue[playerid] = 0;
		                format(PlayerActionText[playerid], 32, "CUTTING...");
		                UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);
		
		                // Jalankan timer loop dengan membawa data playerid dan ID rusa (i)
		                if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
		                PlayerProgressBarTimer[playerid] = SetTimerEx("OnCuttingDeerUpdate", 200, true, "ii", playerid, i);
		                
		                SendClientMessage(playerid, 0xFFFF00FF, "Sedang memotong daging, harap tunggu ...");
		                return 1; 
		            }
		        }
		    }
		}
	    //MINYAK
		if(IsPlayerInRangeOfPoint(playerid, 1.0, 415.430664, 1246.865478, 10.307685))
