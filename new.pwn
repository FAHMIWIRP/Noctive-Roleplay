        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda tidak memiliki slot kosong"); 
    } 
    format(VehiclePlate[targetid][u_car], 16, "NoHave"); 
    CarInfo[playerid][cModel][u_car] = 480; 
    CarInfo[playerid][cColor1][u_car] = 0; 
    CarInfo[playerid][cColor2][u_car] = 0; 
    CarInfo[playerid][cFuel][u_car] = 100.0; 
    CarInfo[playerid][cProbeg][u_car] = 0.0; 
    CarInfo[playerid][cCost][u_car] = 1000; 
    CarInfo[playerid][cHeal][u_car] = 1000.0; 
    CarInfo[playerid][cLock][u_car] = 0; 
    CarInfo[playerid][cDamagePanel][u_car] = 0; 
    CarInfo[playerid][cDamageDoors][u_car] = 0; 
    CarInfo[playerid][cDamageLights][u_car] = 0; 
    CarInfo[playerid][cDamageTires][u_car] = 0; 
    CarInfo[playerid][cGun][u_car] = 0; 
    CarInfo[playerid][cAmmo][u_car] = 0; 
    CarInfo[playerid][cFood][u_car] = 0; 
    CarInfo[playerid][cDrink][u_car] = 0; 
    CarInfo[playerid][cBatu][u_car] = 0; 
    CarInfo[playerid][cBatuk][u_car] = 0; 
    CarInfo[playerid][cMetall][u_car] = 0; 
    CarInfo[playerid][cComponent][u_car] = 0; 
    CarInfo[playerid][cGarkot][u_car] = 0; 
    CarInfo[playerid][cInGarkot][u_car] = 0; 

    // Feedback
    new name[MAX_PLAYER_NAME], tname[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));
    GetPlayerName(targetid, tname, sizeof(tname));

    new str[128];
    format(str, sizeof(str), "Admin %s Memberi Kamu Benefit Girl Berupa Uang 50k Vip Gold Selama 7 Hari Dan Kendaraan Comet", name);
    SendClientMessage(targetid, 0xFFFF00, str);

    format(str, sizeof(str), "Kamu Memberi %s Benefit Stremer", tname);
    SendClientMessage(playerid, 0xFFFF00, str);

    return 1;
}

CMD:Pargoy(playerid, params[])
{
    new type;
	if(admin_level[playerid] >= 1)

    if (sscanf(params, "d", type)) return Send(playerid, -1,"/pargoy [1-10]");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    foreach(new ii : Player)
    {
        if(IsPlayerInRangeOfPoint(ii, 10.0, x, y, z))
        {
            switch (type)
            {
                case 0: ApplyAnimation(ii, "DANCING", "dance_loop", 4.1, 1, 0, 0, 0, 0, 1);
                case 1: ApplyAnimation(ii, "DANCING", "DAN_Left_A", 4.1, 1, 0, 0, 0, 0, 1);
                case 2: ApplyAnimation(ii, "DANCING", "DAN_Right_A", 4.1, 1, 0, 0, 0, 0, 1);
                case 3: ApplyAnimation(ii, "DANCING", "DAN_Loop_A", 4.1, 1, 0, 0, 0, 0, 1);
                case 4: ApplyAnimation(ii, "DANCING", "DAN_Up_A", 4.1, 1, 0, 0, 0, 0, 1);
                case 5: ApplyAnimation(ii, "DANCING", "DAN_Down_A", 4.1, 1, 0, 0, 0, 0, 1);
                case 6: ApplyAnimation(ii, "DANCING", "dnce_M_a", 4.1, 1, 0, 0, 0, 0, 1);
                case 7: ApplyAnimation(ii, "DANCING", "dnce_M_e", 4.1, 1, 0, 0, 0, 0, 1);
                case 8: ApplyAnimation(ii, "DANCING", "dnce_M_b", 4.1, 1, 0, 0, 0, 0, 1);
                case 9: ApplyAnimation(ii, "DANCING", "dnce_M_c", 4.1, 1, 0, 0, 0, 0, 1);
            }
        }
    }
    return 1;
}
CMD:agetip(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

    if(sscanf(params, "s[32]", params)) return Send(playerid, -1, "Masuk: /agetip [Alamat IP]");
    //if(!strcmp(params, "109.185.237.81")) return Send(playerid,-1, "Kesalahan! Tidak mungkin melihat akun dari alamat IP ini.");

    format(MySQLStr, 96, "SELECT * FROM `accounts` WHERE `pIp` = '%s'", params);
	mysql_tquery(mMysql, MySQLStr, "OnMySQL_Query","iis", playerid, 9, params);
	return 1;
}
