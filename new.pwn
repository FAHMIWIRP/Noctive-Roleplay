		if(!IsPlayerConnected(id)) return GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~ERROR: Player Isnt Connected", 3000, 3);
    	if(playerid == id) return GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~ Tidak Bisa Sms ke diri sendiri", 3000, 3);
		ShowPlayerDialog(playerid, DIALOG_SMS_NGESEND, DIALOG_STYLE_INPUT, "Sms", "Masukan Teks Yg Anda Ingin Kirim", "Enter", "Quit");
	}

   	if(dialogid == DIALOG_SMS_NGESEND)
	{
	    new str2[128], id;
	    if(!response) return ShowPlayerDialog(playerid, DIALOG_SMS, DIALOG_STYLE_INPUT, "Sms", "Masukan Id player yang ingin anda Kirim Pesan", "Enter", "Quit");
		if(sscanf(inputtext, "us[128]", id, str2)) return ShowPlayerDialog(playerid, DIALOG_NGESEND, DIALOG_STYLE_INPUT, "Sms", "Masukan Teks Yg Anda Ingin Kirim", "Enter", "Quit");
		new Name1[MAX_PLAYER_NAME], Name2[MAX_PLAYER_NAME], str[128];
	    GetPlayerName(playerid, Name1, sizeof(Name1));
	    GetPlayerName(id, Name2, sizeof(Name2));
	    format(str, sizeof(str), "(({00A2D7}[SMS] {FFFFFF}To %s [%d]: %s))", Name2, id, str2);
	    SendClientMessage(playerid, COLOR_YELLOW, str);
	    format(str, sizeof(str), "(({00A2D7}[SMS] {FFFFFF}From %s [%d]: %s))", Name1, playerid, str2);
	    SendClientMessage(id, COLOR_YELLOW, str);
	}
	
	// --- DIALOG 1: INPUT NOMOR REKENING ---
	if(dialogid == DIALOG_TF_NOREK)
	{
	    if(!response) return 1; // Jika pencet Batal
	    if(!inputtext[0]) return ShowPlayerDialog(playerid, DIALOG_TF_NOREK, DIALOG_STYLE_INPUT, "Bank Transfer - Rekening", "Masukkan Nomor Rekening (Norek) player tujuan:\n{FF0000}Input tidak boleh kosong!", "Lanjut", "Batal");

	    new input_norek = strval(inputtext);
	    new targetid = INVALID_PLAYER_ID;

	    // Looping untuk mencari player online yang memiliki Norek sesuai input
	    for(new i = 0; i < MAX_PLAYERS; i++)
	    {
	        if(IsPlayerConnected(i))
	        {
	            // Sesuaikan enum PlayerInfo dengan nama variabel di scriptmu
	            if(PlayerInfo[i][pNorek] == input_norek)
	            {
	                targetid = i;
	                break;
	            }
	        }
	    }

	    // Pengecekan target
	    if(targetid == INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Transaksi gagal: Pemilik rekening tidak ditemukan atau sedang offline.");
	    if(targetid == playerid) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak bisa transfer ke rekening sendiri.");

	    // Simpan targetid sementara menggunakan PVar
	    SetPVarInt(playerid, "TFTarget", targetid);

	    // Lanjut ke dialog input nominal
	    ShowPlayerDialog(playerid, DIALOG_TF_AMOUNT, DIALOG_STYLE_INPUT, "Bank Transfer - Nominal", "Masukkan nominal uang yang ingin ditransfer:", "Lanjut", "Batal");
	    return 1;
	}

	// --- DIALOG 2: INPUT NOMINAL ---
	if(dialogid == DIALOG_TF_AMOUNT)
	{
	    if(!response)
	    {
	        DeletePVar(playerid, "TFTarget"); // Bersihkan data jika batal
	        return 1;
	    }

	    new amount = strval(inputtext);

	    // Pengecekan tidak boleh mines atau nol
	    if(amount <= 0) return ShowPlayerDialog(playerid, DIALOG_TF_AMOUNT, DIALOG_STYLE_INPUT, "Bank Transfer - Nominal", "Masukkan nominal uang yang ingin ditransfer:\n{FF0000}Nominal tidak boleh minus atau nol!", "Lanjut", "Batal");

	    // Pengecekan uang di bank pengirim
	    if(PlayerInfo[playerid][pBank] < amount) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Saldo bank anda tidak mencukupi untuk transfer ini.");

	    new targetid = GetPVarInt(playerid, "TFTarget");

	    // Pastikan target masih online sebelum lanjut
	    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Player tersebut baru saja offline.");

	    // Simpan nominal sementara
	    SetPVarInt(playerid, "TFAmount", amount);

	    // Ambil nama target untuk konfirmasi
	    new targetname[MAX_PLAYER_NAME], str[256];
	    GetPlayerName(targetid, targetname, sizeof(targetname));

	    // Menampilkan dialog konfirmasi sesuai format
	    format(str, sizeof(str), "Nama : %s\nNominal : %d\n\nApakah data transfer di atas sudah betul?", targetname, amount);
	    ShowPlayerDialog(playerid, DIALOG_TF_CONFIRM, DIALOG_STYLE_MSGBOX, "Konfirmasi Transfer", str, "Betul", "Batal");
	    return 1;
	}

	// --- DIALOG 3: KONFIRMASI & EKSEKUSI TRANSFER ---
	if(dialogid == DIALOG_TF_CONFIRM)
	{
	    new targetid = GetPVarInt(playerid, "TFTarget");
	    new amount = GetPVarInt(playerid, "TFAmount");

	    if(!response)
	    {
	        DeletePVar(playerid, "TFTarget");
	        DeletePVar(playerid, "TFAmount");
	        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda membatalkan transaksi transfer.");
	    }

	    // Pengecekan terakhir untuk mencegah exploit jika uang tiba-tiba habis / target DC
	    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Transaksi gagal: Target offline.");
	    if(PlayerInfo[playerid][pBank] < amount) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Transaksi gagal: Saldo bank anda tidak mencukupi.");

	    new sendername[MAX_PLAYER_NAME], targetname[MAX_PLAYER_NAME], str[128];
	    GetPlayerName(playerid, sendername, sizeof(sendername));
	    GetPlayerName(targetid, targetname, sizeof(targetname));

	    // Eksekusi pengurangan uang pengirim
	    PlayerInfo[playerid][pBank] -= amount;

	    // Eksekusi penambahan uang penerima
	    GivePlayerBankEx(targetid, amount);
	    PlayerInfo[targetid][pBank] += amount; // Hapus baris ini jika fungsi GivePlayerBankEx sudah otomatis menambah pBank

	    // Kirim notifikasi ke pengirim
	    format(str, sizeof(str), "{55FF55}[ BANK ]{FFFFFF} Anda berhasil mentransfer uang sebesar $%d ke rekening milik %s.", amount, targetname);
	    SendClientMessage(playerid, -1, str);

	    // Kirim notifikasi ke penerima
	    format(str, sizeof(str), "{55FF55}[ BANK ]{FFFFFF} Anda mendapatkan transfer masuk sebesar $%d dari %s.", amount, sendername);
	    SendClientMessage(targetid, -1, str);

	    // Bersihkan memory PVar
	    DeletePVar(playerid, "TFTarget");
	    DeletePVar(playerid, "TFAmount");

	    return 1;
	}

	if(dialogid == DIALOG_OALAH)
	{
 		new to_player;
	    if(!response) return 1;

		if(sscanf(inputtext, "d", okk)) return ShowPlayerDialog(playerid, DIALOG_OALAH, DIALOG_STYLE_INPUT, "Bank", "Masukan ID player yang ingin anda transfer", "Enter", "Quit");
    	if(playerid == to_player)
	    return SCM(playerid, COLOR_GREY, "Anda menunjukkan diri Anda sendiri.");

		ShowPlayerDialog(playerid, DIALOG_NGESEND, DIALOG_STYLE_INPUT, "Bank", "Masukan Jumlah Transfer", "Enter", "Quit");
	}

	if(dialogid == DIALOG_NGESEND)
	{
	    if(!response) return ShowPlayerDialog(playerid, DIALOG_OALAH, DIALOG_STYLE_INPUT, "Transfer", "Masukan ID player yang ingin anda transfer", "Enter", "Quit");

	    new to_player, price;
		if(sscanf(inputtext, "d", price)) return ShowPlayerDialog(playerid, DIALOG_NGESEND, DIALOG_STYLE_INPUT, "Bank ", "Masukan Jumlah Transfer", "Enter", "Quit");
		GivePlayerBankEx(playerid, -price, "transfer ke pemain");
		GivePlayerBankEx(to_player, price, "transfer ke pemain");
	}
	
