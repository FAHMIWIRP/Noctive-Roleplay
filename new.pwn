CMD:tgak (playerid)
{
	if(GetPVarInt(playerid,"pTimeRp4") > gettime()) return 1;
	format(String, 188, "%s Take a 'Ak-47' and Ready to Shoot Anytime",ReturnName(playerid));
	ProxDetector(25.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPVarInt(playerid, "pTimeRp4", gettime() + 30);
 	return 1;
}
CMD:claimcar(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(VehicleInsurance[vehicleid] == 1)
    {
        if(GetPlayerMoney(playerid) >= 500)
        {
            GivePlayerMoney(playerid, -500);
            VehicleInsurance[vehicleid] = 0;
            SetVehicleParamsEx(vehicleid, 1, 0, 0, 0, 0, 0, 0);
            SendClientMessage(playerid, COLOR_GREEN, "Anda telah mengambil kendaraan dari asuransi!");
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "Anda tidak memiliki uang yang cukup!");
        }
    }
    else
    {
        SendClientMessage(playerid, COLOR_RED, "Kendaraan Anda tidak ada di asuransi!");
    }
    return 1;
}
