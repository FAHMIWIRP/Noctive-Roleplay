				SCMF(playerid, -1, "Anda telah berhasil membeli Marijuana dari %s", GetPlayerNameEx(offer_id));
				SCMF(offer_id, -1, "Anda telah berhasil menjual Marijuana %s", GetPlayerNameEx(playerid));
			}
			case OFFER_TYPE_SELLDRUGS:
