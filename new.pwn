        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pGiokpermata] > 0) {
	    format(szItem, sizeof(szItem), "{FF3838}G{FF9900}i{FFFF00}o{00FF00}k {00FFFF}P{0099FF}e{9933FF}r{FF00FF}m{FF55BB}a{33FF99}t{FFFF55}a\t{FFFF00}%d\n", PlayerInfo[targetid][pGiokpermata]);
	    strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pGiok] > 0) {
