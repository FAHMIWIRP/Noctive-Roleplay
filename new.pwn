        format(String, 392, "{FFFF00}1. {FFFFFF}%s\n{FFFF00}2. {FFFFFF}%s\n{FFFF00}3. {FFFFFF}%s", GetToysName(ToyInfo[playerid][toyModel][0]), GetToysName(ToyInfo[playerid][toyModel][1]), GetToysName(ToyInfo[playerid][toyModel][2]));
        SPD(playerid, DIALOG_SELECT_ITEMS_SLOT, DIALOG_STYLE_LIST, "Toys", String, "Pilih", "Batal");
        /*format(String, 392, "{FFFFFF}1. {FFFFff}%s\n{FFFFff}2. {FFFFff}%s\n{FFFFff}3. {FFFFff}%s\n{FFFFff}4. {FFFFff}%s\n{FFFFff}5. {FFFFff}%s", GetToysName(ToyInfo[playerid][toyModel][0]), GetToysName(ToyInfo[playerid][toyModel][1]), GetToysName(ToyInfo[playerid][toyModel][2]), GetToysName(ToyInfo[playerid][toyModel][3]), GetToysName(ToyInfo[playerid][toyModel][4]));
    	SPD(playerid, DIALOG_ITEMS_TOYS_SLOT, DIALOG_STYLE_LIST, "{FFFFFF}Aksesoris {33AAFF}Noctive", String, "Pilih", "Batal");*/
    }
    
    if(SpectatingTarget[playerid] != -1)
    {
        // Tombol NEXT (Text_Global[16])
        if(clickedid == nextsp[0])
        {
            new nextid = SpectatingTarget[playerid];
            for(new i = 1; i <= MAX_PLAYERS; i++)
            {
                nextid = (nextid + 1) % MAX_PLAYERS;
                if(IsPlayerConnected(nextid) && nextid != playerid)
                {
                    sp(playerid, nextid);
                    break;
                }
            }
            return 1;
        }

        // Tombol BACK (Text_Global[17])
        if(clickedid == backsp[0])
        {
            new previd = SpectatingTarget[playerid];
            for(new i = 1; i <= MAX_PLAYERS; i++)
            {
                previd = (previd - 1 + MAX_PLAYERS) % MAX_PLAYERS;
                if(IsPlayerConnected(previd) && previd != playerid)
                {
                    sp(playerid, previd);
                    break;
                }
            }
            return 1;
        }

        // Tombol CLOSE / X (Text_Global[18])
        if(clickedid == selesaisp[0] || clickedid == Text:INVALID_TEXT_DRAW)
        {
            spoff(playerid);
            return 1;
        }
    }
    if(clickedid == SPWBANDARA)
    {
    	LoadingObject(playerid);
        SetPPos(playerid, 1683.4011, -2244.9191, 13.5435, 179.7106, 0, 0, false);
        ShowInfo(playerid, "Anda Berhasil Spawn");
	    ShowInfo(playerid, "Anda Memilih Lokasi Spawn Bandara");
	    entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
		TogglePlayerControllable(playerid,0);
		SetCameraBehindPlayer(playerid);

	    for(new p = 0; p != 43; p++)
        {
            TextDrawHideForPlayer(playerid, PilihSpawnTD[p]);
        }
        TextDrawHideForPlayer(playerid, SPWPASBEK);
        TextDrawHideForPlayer(playerid, SPWSTASIUN);
        TextDrawHideForPlayer(playerid, SPWBANDARA);
        TextDrawHideForPlayer(playerid, SPWTERAKHIR);
        TextDrawHideForPlayer(playerid, SPWPEKERJAAN);
        TextDrawHideForPlayer(playerid, SPWRUMAH);
        TextDrawHideForPlayer(playerid, SPWBALKOT);
        TextDrawHideForPlayer(playerid, SPWSPAWNALL);
		CancelSelectTextDraw(playerid);
    }
	if(clickedid == SPWTERAKHIR)
    {
        PlayerInfo[playerid][pPilihSpawn] = 1;
		
    }
    if(clickedid == SPWPEKERJAAN)
    {
		PlayerInfo[playerid][pPilihSpawn] = 2;
  		new member = PlayerInfo[playerid][pMember];
		SetPPos(playerid, FracInfo[member][fSpawn][0], FracInfo[member][fSpawn][1], FracInfo[member][fSpawn][2], FracInfo[member][fSpawn][3], FracInfo[member][fInt], FracInfo[member][fVw], true);
		entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
		TogglePlayerControllable(playerid,0);
  		SetCameraBehindPlayer(playerid);

	    ShowInfo(playerid, "Anda Memilih Lokasi Spawn Pekerjaan");
    }
    if(clickedid == SPWRUMAH)
    {
        PlayerInfo[playerid][pPilihSpawn] = 3;
        new f_house = -1;
        if(GetPlayerHouse(playerid) != -1) f_house = GetPlayerHouse(playerid);
		if(GetPlayerHouseLodger(playerid) != -1) f_house = GetPlayerHouseLodger(playerid);
		PlayerEnterToHouse(playerid, f_house, 1);
		entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
  		SetCameraBehindPlayer(playerid);

	    ShowInfo(playerid, "Anda Memilih Lokasi Spawn Rumah");
	}
    if(clickedid == SPWBALKOT)
    {
        PlayerInfo[playerid][pPilihSpawn] = 4;
        new rand = random(4);
		InterpolateCameraPos(playerid, cam_start_pos[rand][0][0], cam_start_pos[rand][0][1], cam_start_pos[rand][0][2], cam_start_pos[rand][0][3], cam_start_pos[rand][0][4], cam_start_pos[rand][0][5], 20000);
		InterpolateCameraLookAt(playerid, cam_start_pos[rand][1][0], cam_start_pos[rand][1][1], cam_start_pos[rand][1][2], cam_start_pos[rand][1][3], cam_start_pos[rand][1][4], cam_start_pos[rand][1][5], 20000);
	    SetPlayerPos(playerid,cam_start_pos[rand][2][0],cam_start_pos[rand][2][1],cam_start_pos[rand][2][2]);

	    ShowInfo(playerid, "Anda Memilih Lokasi Spawn Balkot");
    }
    if(clickedid == SPWSPAWNALL)
    {
        if(PlayerInfo[playerid][pPilihSpawn] == 1)
        {
            LoadingObject1(playerid);
            SetSaveSpawn(playerid);
            SetCameraBehindPlayer(playerid);
            ShowInfo(playerid, "Anda Berhasil Spawn");
		}
        if(PlayerInfo[playerid][pPilihSpawn] == 2)
        {
        	LoadingObject1(playerid);
            new member = PlayerInfo[playerid][pMember];
			SetPPos(playerid, FracInfo[member][fSpawn][0], FracInfo[member][fSpawn][1], FracInfo[member][fSpawn][2], FracInfo[member][fSpawn][3], FracInfo[member][fInt], FracInfo[member][fVw], true);
			entertimer[playerid] = SetTimerEx("enter",3000,false,"i",playerid);
			TogglePlayerControllable(playerid,0);
            SetCameraBehindPlayer(playerid);
            ShowInfo(playerid, "Anda Berhasil Spawn");
		}
        if(PlayerInfo[playerid][pPilihSpawn] == 3)
        {
        	LoadingObject1(playerid);
            new f_house = -1;
            if(GetPlayerHouse(playerid) != -1) f_house = GetPlayerHouse(playerid);
			if(GetPlayerHouseLodger(playerid) != -1) f_house = GetPlayerHouseLodger(playerid);
			PlayerEnterToHouse(playerid, f_house, 1);
			entertimer[playerid] = SetTimerEx("enter",5000,false,"i",playerid);
            SetCameraBehindPlayer(playerid);
            ShowInfo(playerid, "Anda Berhasil Spawn");
		}
        if(PlayerInfo[playerid][pPilihSpawn] == 4)
        {
        	LoadingObject1(playerid);
            SetPPos(playerid, 1147.9119,-2056.2639,69.0124,2.3141, 0, 0, false);
            SetCameraBehindPlayer(playerid);
            ShowInfo(playerid, "Anda Berhasil Spawn");
		}
        for(new p = 0; p != 43; p++)
        {
            TextDrawHideForPlayer(playerid, PilihSpawnTD[p]);
        }
		TextDrawHideForPlayer(playerid, SPWPASBEK);
		TextDrawHideForPlayer(playerid, SPWSTASIUN);
		TextDrawHideForPlayer(playerid, SPWBANDARA);
		TextDrawHideForPlayer(playerid, SPWTERAKHIR);
		TextDrawHideForPlayer(playerid, SPWPEKERJAAN);
		TextDrawHideForPlayer(playerid, SPWRUMAH);
		TextDrawHideForPlayer(playerid, SPWBALKOT);
		TextDrawHideForPlayer(playerid, SPWSPAWNALL);
		CancelSelectTextDraw(playerid);
        SetCameraBehindPlayer(playerid);
	}
    if(_:clickedid == INVALID_TEXT_DRAW && GetPVarInt(playerid, "Register"))
    {
    	for(new td; td < 3; td ++) TextDrawHideForPlayer(playerid, skinTD[td]);
		CancelSelectTextDraw(playerid);
		KickD(playerid,"Anda telah meninggalkan proses pendaftaran, gunakan /q(quit) untuk keluar.");
		return 1;
	}
	else if(_:clickedid == INVALID_TEXT_DRAW && player_bone_table[playerid] != -1)
	{
		SelectTextDraw(playerid, COLOR_WHITE);
	}
	else if(_:clickedid == INVALID_TEXT_DRAW && GetPVarInt(playerid, "VibClothes"))
    {
	  	if(player_use_bizbar[playerid] == 67)
 		{
			TogglePlayerControllableEx(playerid, 1);
			t_SetPlayerPos(playerid, 214.0331,-100.3938,1005.2578), SetPlayerFacingAngle(playerid, 91.4476);
			SetPlayerInterior(playerid, 15), SetPlayerVirtualWorld(playerid, 67);
			SetCameraBehindPlayer(playerid);
		}
		else if(player_use_bizbar[playerid] == 68)
 		{
 		    TogglePlayerControllableEx(playerid, 1);
			t_SetPlayerPos(playerid, 208.7890,-5.2946,1001.2109), SetPlayerFacingAngle(playerid, 269.4451);
			SetPlayerInterior(playerid, 5), SetPlayerVirtualWorld(playerid, 68);
			SetCameraBehindPlayer(playerid);
		}
		else if(player_use_bizbar[playerid] == 69)
 		{
 		    TogglePlayerControllableEx(playerid, 1);
			t_SetPlayerPos(playerid, 167.5934,-81.1919,1001.8047), SetPlayerFacingAngle(playerid, 141.8711);
			SetPlayerInterior(playerid, 18), SetPlayerVirtualWorld(playerid, 69);
			SetCameraBehindPlayer(playerid);
		}
		else if(player_use_bizbar[playerid] == 70)
 		{
 		    TogglePlayerControllableEx(playerid, 1);
			t_SetPlayerPos(playerid, 210.2800,-157.7022,1000.5234), SetPlayerFacingAngle(playerid, 139.7010);
			SetPlayerInterior(playerid, 14), SetPlayerVirtualWorld(playerid, 70);
			SetCameraBehindPlayer(playerid);
		}
		SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]), TogglePlayerControllableEx(playerid, 1);
		for(new y; y < 3; y++) PlayerTextDrawHide(playerid, UseLAlt[playerid][y]);
		for(new td; td < 3; td ++) TextDrawHideForPlayer(playerid, skinTD[td]);
		CancelSelectTextDraw(playerid);
		cskin[playerid] = -1;
		DeletePVar(playerid, "VibClothes");
		return 1;
	}
    if(clickedid == bones_global_td[6]) callcmd::startbet(playerid);
	if(clickedid == bones_global_td[4]) callcmd::setbet(playerid);
    if(clickedid == bones_global_td[3]) callcmd::exit(playerid);

	if(autoshop_global_td[1] <= clickedid <= autoshop_global_td[2])
	{
	    if(GetPVarInt(playerid, "block_click") > GetTickCount()) return 1;

		if(clickedid == autoshop_global_td[1]) //Selanjutnya
		{
		    player_select_old[playerid] = player_select_veh[playerid];
		    player_select_veh[playerid]++;

			if(player_select_veh[playerid] > MAX_VEHICLE_SHOP_SLOT - 1) player_select_veh[playerid] = 0;

	        UpdatePlayerVehicleShop(playerid, true);
		}
		else if(clickedid == autoshop_global_td[2]) //Dulu
		{
		    player_select_old[playerid] = player_select_veh[playerid];
		    player_select_veh[playerid]--;

			if(player_select_veh[playerid] == -1) player_select_veh[playerid] = MAX_VEHICLE_SHOP_SLOT - 1;

	        UpdatePlayerVehicleShop(playerid, true);
		}

		SetPVarInt(playerid, "block_click", GetTickCount() + 2000);
	}

	if(clickedid == autoshop_global_td[5])
	{
	    new shop_id = GetPlayerUseListitem(playerid);
	    new veh_id = player_select_veh[playerid];

	    new model = as_vehicle_info[shop_id][veh_id][0];
	    new price = as_vehicle_info[shop_id][veh_id][1];

	    format(String, sizeof (String), ""W"Judul:\t\t%s\nNomor mobil:\t%d\n"W"Harga pembelian:\t{66CC00}%d$\n\n"W"Untuk membeli mobil ini, klik 'BUY'",
			VehicleNames[model-400], model, price);

		SPD(playerid, 45, DIALOG_STYLE_MSGBOX, "Pasar mobil", String, "Untuk membeli", "Tutup");

		CancelSelectTextDraw(playerid);
	}

	if(clickedid == autoshop_global_td[6]) PlayerLeaveVehicleShop(playerid);

	if(clickedid == skinTD[2])
	{
 		cskin[playerid]--;
 		if(PlayerInfo[playerid][pSex] == 1)
  		{
   			if(cskin[playerid] < 0) cskin[playerid] = sizeof PedMan - 1;
    		SetPlayerSkin(playerid, PedMan[cskin[playerid]]);
		}
		else
		{
			if(cskin[playerid] < 0) cskin[playerid] = sizeof PedMale - 1;
			SetPlayerSkin(playerid, PedMale[cskin[playerid]]);
		}
		return 1;
	}
	else if(clickedid == skinTD[1])
    {
   		cskin[playerid]++;
   		if(PlayerInfo[playerid][pSex] == 1)
    	{
   			if(cskin[playerid] >= sizeof PedMan) cskin[playerid] = 0;
			SetPlayerSkin(playerid, PedMan[cskin[playerid]]);
		}
		else
		{
			if(cskin[playerid] >= sizeof PedMale) cskin[playerid] = 0;
			SetPlayerSkin(playerid, PedMale[cskin[playerid]]);
		}
		return 1;
	}
	else if(clickedid == skinTD[0])
    {
        if(PlayerInfo[playerid][pSkin] != -1) return 1; //Memperbaiki kulit CJ

    	for(new td; td < 3; td ++) TextDrawHideForPlayer(playerid, skinTD[td]);
		CancelSelectTextDraw(playerid);

        PlayerInfo[playerid][pSkin] = GetPlayerSkin(playerid);

		format(format_string, 96, "UPDATE `accounts` SET `pSkin` = %i WHERE `pID` = %i", PlayerInfo[playerid][pSkin], GetPlayerAccountID(playerid));
		mysql_tquery(mMysql, format_string);

		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);

		SpawnPlayerEx(playerid);

		return 1;
   	}

	return 1;
}

public OnPlayerClickPlayer(playerid, clickedplayerid, source)
{
	if(clickedplayerid == playerid) return 1;
	if(PlayerInfo[playerid][pProducts][1] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki buku telepon, Anda dapat membelinya di toko 24/7");

	format(String, 96, ""W"Masukkan nomor telepon untuk kontak tersebut %s", Name(clickedplayerid));
    SPD(playerid,186,DIALOG_STYLE_INPUT,"{a86cfc}Menambahkan kontak baru", String, "Tambah","Batalkan");

    SetPVarInt(playerid, "nName", clickedplayerid);
	return 1;
}
