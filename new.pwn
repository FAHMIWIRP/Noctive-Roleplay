    PlayerTextDrawBackgroundColor(playerid, PanjulNotif[playerid][2], 255);
    PlayerTextDrawFont(playerid, PanjulNotif[playerid][2], 4);
    PlayerTextDrawSetProportional(playerid, PanjulNotif[playerid][2], 1);

    PanjulNotif[playerid][3] = CreatePlayerTextDraw(playerid, 560.000, 309.000, "Notification");
    PlayerTextDrawLetterSize(playerid, PanjulNotif[playerid][3], 0.190, 0.999);
    PlayerTextDrawAlignment(playerid, PanjulNotif[playerid][3], 1);
    PlayerTextDrawColor(playerid, PanjulNotif[playerid][3], -1);
    PlayerTextDrawSetShadow(playerid, PanjulNotif[playerid][3], 1);
    PlayerTextDrawSetOutline(playerid, PanjulNotif[playerid][3], 1);
    PlayerTextDrawBackgroundColor(playerid, PanjulNotif[playerid][3], 150);
    PlayerTextDrawFont(playerid, PanjulNotif[playerid][3], 1);
    PlayerTextDrawSetProportional(playerid, PanjulNotif[playerid][3], 1);

    PanjulNotif[playerid][4] = CreatePlayerTextDraw(playerid, 540.000, 325.000, "kamu tidak punya marijuana");
    PlayerTextDrawLetterSize(playerid, PanjulNotif[playerid][4], 0.190, 0.999);
    PlayerTextDrawAlignment(playerid, PanjulNotif[playerid][4], 1);
    PlayerTextDrawColor(playerid, PanjulNotif[playerid][4], -1);
    PlayerTextDrawSetShadow(playerid, PanjulNotif[playerid][4], 1);
    PlayerTextDrawSetOutline(playerid, PanjulNotif[playerid][4], 1);
    PlayerTextDrawBackgroundColor(playerid, PanjulNotif[playerid][4], 150);
    PlayerTextDrawFont(playerid, PanjulNotif[playerid][4], 1);
    PlayerTextDrawSetProportional(playerid, PanjulNotif[playerid][4], 1);
    return 1;
}
public ShowPanjulNotif(playerid, const text[])
{
    // Kalau notif sebelumnya masih tampil, matikan timernya dulu biar tidak bentrok
    if (PanjulNotifTimer[playerid] != -1)
    {
        KillTimer(PanjulNotifTimer[playerid]);
        PanjulNotifTimer[playerid] = -1;
    }

    // Set teks informasi di index [4]
    PlayerTextDrawSetString(playerid, PanjulNotif[playerid][4], text);

    // Tampilkan semua part textdraw (0-4)
    for (new i = 0; i < 5; i++)
    {
        PlayerTextDrawShow(playerid, PanjulNotif[playerid][i]);
    }

    // Suara notifikasi
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);

    // Timer untuk menghilangkan notifikasi setelah 5 detik
    PanjulNotifTimer[playerid] = SetTimerEx("HidePanjulNotif", 5000, false, "d", playerid);
    return 1;
}
public HidePanjulNotif(playerid)
{
    for (new i = 0; i < 5; i++)
    {
        PlayerTextDrawHide(playerid, PanjulNotif[playerid][i]);
    }
    PanjulNotifTimer[playerid] = -1;
    return 1;
}

////////////////////////////////////////////////////////////////////////////////////////////////
// COMMAND: /tesnotif
// Gaya CMD: (butuh include zcmd/ycmd)
////////////////////////////////////////////////////////////////////////////////////////////////
CMD:tesnotif(playerid, params[])
{
    ShowPanjulNotif(playerid, "Tes Notifikasi");
    return 1;
}
FinishMarijuanaCutMinigame(playerid)
{
    new id = MarijuanaHarvestPlantID[playerid];

    for(new i = 0; i < 35; i++) PlayerTextDrawHide(playerid, TDMARIJUANA[playerid][i]);
    CancelSelectTextDraw(playerid);
    MarijuanaMinigame[playerid] = false;

    // Lanjut ke proses panen (sama seperti CMD:panen)
    SedangKerja[playerid] = true;
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 1, 0);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMANEN...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnHarvestingUpdate", 150, true, "ii", playerid, id);
    return 1;
}

CancelMarijuanaCutMinigame(playerid)
{
    for(new i = 0; i < 35; i++) PlayerTextDrawHide(playerid, TDMARIJUANA[playerid][i]);
    CancelSelectTextDraw(playerid);
    TogglePlayerControllable(playerid, true);
    MarijuanaMinigame[playerid] = false;
    return 1;
}
StartMarijuanaCutMinigame(playerid, id)
{
    if(MarijuanaMinigame[playerid]) return 0;

    MarijuanaMinigame[playerid] = true;
    MarijuanaHarvestPlantID[playerid] = id;

    for(new i = 0; i < MARIJUANA_CUT_COUNT; i++)
    {
        MarijuanaCutClicked[playerid][i] = false;
        PlayerTextDrawColor(playerid, TDMARIJUANA[playerid][MarijuanaCutLabelID[i]], -1); // reset warna teks CUT
    }

    for(new i = 0; i < 35; i++) PlayerTextDrawShow(playerid, TDMARIJUANA[playerid][i]);

    SelectTextDraw(playerid, 0xFFFFFFAA); // aktifkan mode klik textdraw
    TogglePlayerControllable(playerid, false);
    return 1;
}
