// Command untuk mematikan musik
CMD:stopdj(playerid, params[])
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            StopAudioStreamForPlayer(i);
        }
    }
    SendClientMessageToAll(0xFF0000FF, "[DJ NOCTIVE]: Musik telah dimatikan.");
    return 1;
}

CMD:ann(playerid, params[])
{
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

 	if(isnull(params))
    {
	    return 1;
	}
	// Check for special trouble-making input
   	if(strfind(params, "~x~", true) != -1)
		return Error(playerid, "~x~ is not allowed in announce.");
	if(strfind(params, "#k~", true) != -1)
		return Error(playerid, "The constant key is not allowed in announce.");
	if(strfind(params, "/q", true) != -1)
		return Error(playerid, "You are not allowed to type /q in announcement!");

	// Count tildes (uneven number = faulty input)
	new iTemp = 0;
	for(new i = (strlen(params)-1); i != -1; i--)
	{
		if(params[i] == '~')
			iTemp ++;
	}
	if(iTemp % 2 == 1)
		return Error(playerid, "You either have an extra ~ or one is missing in the announcement!");

	new str[512];
	format(str, sizeof(str), "~w~%s", params);
	GameTextForAll(str, 6500, 3);
	return true;
}
CMD:agivegunsg(playerid, params[])
{
 if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
    new targetid;

    // Ambil parameter ID/Name player
    if (sscanf(params, "u", targetid))
        return SendClientMessage(playerid, 0xFF0000FF, "Gunakan: /agivegunsg [ID/Name Player]");

    // Cek koneksi
    if (!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, 0xFF0000FF, "Player tidak terhubung.");

    // Beri senjata (Shotgun ID 25, 50 ammo)
    GivePlayerWeapon(targetid, 25, 50);
    OnPlayerUpdateAccountsPer(playerid, "pGun", PlayerInfo[playerid][pGun]);
    OnPlayerUpdateAccountsPer(playerid, "pAmmo", PlayerInfo[playerid][pAmmo]);

    // Feedback
    new name[MAX_PLAYER_NAME], tname[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));
    GetPlayerName(targetid, tname, sizeof(tname));

    new str[128];
    format(str, sizeof(str), "Admin %s memberi kamu Shotgun (ID 25) dengan 50 ammo.", name);
    SendClientMessage(targetid, 0x00FF00FF, str);

    format(str, sizeof(str), "Kamu memberi %s Shotgun (ID 25), 50 ammo.", tname);
    SendClientMessage(playerid, 0x00FF00FF, str);

    return 1;
}

