stock UpdateDonate(playerid)
{
	MySQLStr[0] = EOS;
	format(MySQLStr,96,"SELECT `pRobleCheck` FROM `accounts` WHERE `pID` = %d", PlayerInfo[playerid][pID]);
	mysql_pquery(mMysql, MySQLStr, "UpdatePlayerDonate","d",playerid);
	return 1;
}

epublic: UpdatePlayerDonate(playerid)
{
	new rows;
    cache_get_row_count(rows);
    if(!rows) return 0;

    new donate;

    cache_get_value_name_int(0, "pRobleCheck", donate);

    if(donate == 0) return 1;

    format(String, 144, "INSERT INTO `donate_log` (`user_id`,`amount`) VALUES (%i,%i)", GetPlayerAccountID(playerid), donate);
	mysql_tquery(mMysql, String);

	if(bonus_donate) donate *= 2;

	PlayerInfo[playerid][pRouble] += donate;

	SCMF(playerid, COLOR_GREY, "Pengisian baru: %i.", donate);

    format(String, 96, "UPDATE `accounts` SET `pRobleCheck` = 0 WHERE `pID` = %i", PlayerInfo[playerid][pID]);
    mysql_tquery(mMysql, String);
	return 1;
}

CMD:sptext(playerid, params[])
{
	if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "ds[128]", params[0], params[1])) return Send(playerid,-1,"Masuk: /sptext [ID pemain] [Teks]");
 	if(!IsPlayerConnected(params[0])) return Send(playerid,-1,"Salah ID");
    if(PlayerInfo[playerid][pLogin] == 0) return Send(playerid,-1,"Pemain belum login");
	OnPlayerText(params[0],params[1]);
	return true;
}
CMD:call(playerid, params[])
{
	if(PhoneOnline[playerid] > 0) return Send(playerid, COLOR_GREY, "Ponsel Anda terputus...");
	if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Handphone!");
    if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor!");
    if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;

	if(sscanf(params, "d",params[0])) {
		Send(playerid, 0xCECECEFF, "Ketik: /call [angka]");
		Send(playerid, 0xCECECEFF, "Police: 911");
		Send(playerid, 0xCECECEFF, "Samd: 03");
		Send(playerid, 0xCECECEFF, "Mekanik: 555");
		Send(playerid, 0xCECECEFF, "Taxi: 123");
		Send(playerid, 0xCECECEFF, "Pedagang: 333");
		return 1;
	}

	if(Mobile[playerid] != -1) return Send(playerid, COLOR_GREY, "Anda sudah berbicara di telepon.");
//	if(PlayerInfo[playerid][pSummaNumber] <= 0) Send(playerid, COLOR_GREY, "Anda tidak punya uang di akun ponsel Anda.");
	format(String, 86, "%s mengeluarkan ponsel",Name(playerid));
	ProxDetector(10.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
	if(params[0] == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat menyebut diri Anda sendiri, salurannya sibuk.");

    if(params[0] == 911) return SPD(playerid, 8949, DIALOG_STYLE_INPUT, "Panggilan polisi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
	if(params[0] == 03) return SPD(playerid, 8950, DIALOG_STYLE_INPUT, "Panggilan Ambulans", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");
	if(params[0] == 555) return SPD(playerid, 8951, DIALOG_STYLE_INPUT, "Telepon MEKANIK", "Ada Yang Bisa Kami Bantu?", "Telepon", "Tutup");
	if(params[0] == 333) return SPD(playerid, 8952, DIALOG_STYLE_INPUT, "Panggilan Vendors", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");
	if(params[0] == 123) return SPD(playerid, 8953, DIALOG_STYLE_INPUT, "Panggilan Taxi", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");

	for(new i = 70; i <= 72; i++)
	{
		if(!BizzInfo[i][bPhone] || params[0] != BizzInfo[i][bPhone]) continue;

		SetPlayerUseListitem(playerid, i);

		return SPD(playerid, 8948, DIALOG_STYLE_INPUT, "Panggilan taksi", "Jelaskan tempat Anda berada:", "Untuk menelepon", "Tutup");
	}

	foreach(new i : Player)
	{
		if(PlayerInfo[i][pNumber] == params[0] && params[0] != 0)
		{
			Mobile[playerid] = i;

			if(PhoneOnline[Mobile[playerid]] > 0) return Send(playerid, COLOR_GREY, "Telepon pemanggil mati...");

			if(Mobile[Mobile[playerid]] == -1)
			{
			    Send(Mobile[playerid], -1, "Ponsel Anda berdering. Masuk {43CC0E}(/p)"W" untuk menjawab.");
			    PlayAudioStreamForPlayer(playerid, "http://f.top4top.io/m_3624i5dyb1.mp3");
                PlayerPlaySound(Mobile[playerid], 20600, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 3600, 0.0, 0.0, 0.0);

				format(String, 86, "%s telepon berdering", Name(i)), SetPlayerChatBubble(i, String, COLOR_PURPLE, 10.0, 5000);
				SetPlayerAttachedObject(playerid, 0, 19513,6,0.101998,0.013999,-0.007999,79.899864,-178.999969,-4.200003,1.000000,1.000000,1.000000);
				SetPlayerSpecialAction(playerid, 11);
				CellTime[playerid] = 1;
				break;
			}
		}
	}
	return 1;
}
CMD:p(playerid, params[])
{
    if(PhoneCallState[playerid] != CALL_STATE_RINGING || PhoneCallTarget[playerid] == INVALID_PLAYER_ID) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Tidak ada panggilan masuk.");
        
    new targetid = PhoneCallTarget[playerid];
    PhoneCallState[playerid] = CALL_STATE_ACTIVE;
    PhoneCallState[targetid] = CALL_STATE_ACTIVE;
    
    // Mengubah warna teks notifikasi menjadi Kuning - Putih
    SendClientMessage(playerid, -1, "{FFFF00}[ CALLPHONE ] {FFFFFF}Panggilan tersambung.");
    SendClientMessage(targetid, -1, "{FFFF00}[ CALLPHONE ] {FFFFFF}Panggilan diangkat.");
    
    ApplyAnimation(playerid, "PED", "phone_in", 4.1, 0, 1, 1, 1, 1, 1);

    return 1;
}

CMD:hu(playerid, params[])
{
    if(PhoneCallState[playerid] == CALL_STATE_NONE) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak sedang dalam panggilan.");
        
    new targetid = PhoneCallTarget[playerid];
    new bool:wasActive = (PhoneCallState[playerid] == CALL_STATE_ACTIVE);
    
    // Mengubah warna teks notifikasi menjadi Kuning - Putih
    SendClientMessage(playerid, -1, "{FFFF00}[ CALLPHONE ] {FFFFFF}Panggilan terputus.");
    ClearAnimations(playerid);
    ClearAnimations(targetid);
    PhoneCallState[playerid] = CALL_STATE_NONE;
    PhoneCallTarget[playerid] = INVALID_PLAYER_ID;
    
    if(targetid != INVALID_PLAYER_ID && IsPlayerConnected(targetid))
    {
        SendClientMessage(targetid, -1, "{FFFF00}[ CALLPHONE ] {FFFFFF}Panggilan terputus.");
        ClearAnimations(targetid);
        PhoneCallState[targetid] = CALL_STATE_NONE;
        PhoneCallTarget[targetid] = INVALID_PLAYER_ID;
    }
    return 1;
}
forward ShowContactList(playerid);
public ShowContactList(playerid)
{
    new rows = cache_num_rows();
    if(rows == 0) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kontak Anda Kosong.");
    
    new name[64], numberStr[32], listStr[2048], statusStr[32];
    listStr[0] = '\0';
    
    for(new i = 0; i < rows; i++)
    {
        cache_get_value_name(i, "nName", name);
        cache_get_value_name(i, "nNumber", numberStr);
        
        new targetid = GetPlayerIdByPhoneNumber(strval(numberStr));
        new isOnline = 0;
        
        // Logika Online: Akun terhubung di server DAN hp menyala (Mengikuti variabel script kamu: 0 = Menyala)
        if(targetid != INVALID_PLAYER_ID && PhoneOnline[targetid] == 0)
        {
            format(statusStr, sizeof(statusStr), "{00FF00}Online{FFFFFF}");
            isOnline = 1;
        }
        else
        {
            format(statusStr, sizeof(statusStr), "{FF0000}Offline{FFFFFF}");
            isOnline = 0;
        }
        
        // Simpan data row ke PVar player untuk di-load saat dipencet nanti
        new pvarStatus[32], pvarNum[32];
        format(pvarStatus, sizeof(pvarStatus), "ContactStatus_%d", i);
        format(pvarNum, sizeof(pvarNum), "ContactNum_%d", i);
        SetPVarInt(playerid, pvarStatus, isOnline);
        SetPVarString(playerid, pvarNum, numberStr);
        
        new item[128];
        format(item, sizeof(item), "%s ( %s ) ( %s )\n", name, numberStr, statusStr);
        strcat(listStr, item);
    }
    ShowPlayerDialog(playerid, DIALOG_CONTACT_LIST, DIALOG_STYLE_LIST, "LIST CONTACT", listStr, "Call", "Close");
    return 1;
}

// Fungsi mencocokkan nomor hp ke player id yang online
stock GetPlayerIdByPhoneNumber(number)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && PlayerInfo[i][pNumber] == number) return i;
    }
    return INVALID_PLAYER_ID;
}
CMD:sms(playerid, params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
	if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor.");
	if(PhoneOnline[playerid] != 0) return Send(playerid,COLOR_GREY, "Ponsel Anda mati.");
	if(PlayerInfo[playerid][pSummaNumber] <= 0) return Send(playerid, COLOR_GREY, "Anda tidak punya uang di akun ponsel Anda.");
	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;

	if(sscanf(params, "ds[80]", params[0], params[1])) return Send(playerid, -1,"Masuk: /sms [angka] [teks]");
	//
    if(params[0] < 0 || params[0] > 999999) return Send(playerid, COLOR_GREY,"Nomor ponsel yang ditentukan tidak valid.");
    if(params[1] == PlayerInfo[playerid][pNumber]) return Send(playerid, COLOR_GREY, "Anda tidak dapat mengirim pesan kepada diri sendiri.");
    new full = 0;

    foreach(new i : Player)
	{
        if(params[0] == PlayerInfo[i][pNumber] && params[0] != 0)
		{
            if(PhoneOnline[i] != 0) return Send(playerid, COLOR_GREY, "Telepon pemanggil mati.");

            full++;
            PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
            SetPlayerChatBubble(playerid, "SMS >>" ,COLOR_YELLOW,10.0,5000), SetPlayerChatBubble(i, "SMS <<",COLOR_YELLOW,10.0,5000);

            SCMF(i, COLOR_YELLOW, "SMS: %s. Pengirim: %s(%i)[Telp. %d]", params[1], Name(playerid), playerid, PlayerInfo[playerid][pNumber]);
            SCMF(playerid, COLOR_YELLOW, "SMS: %s. Penerima: %s(%i)[Telp. %d]", params[1], Name(i), i, PlayerInfo[i][pNumber]);

            foreach(new x : admin_list) if(player_admin_sms[x]) SCMF(x, COLOR_YELLOW, "[A][SMS] %s[%i] -> %s[%i]: %s", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(i), i, params[1]);

            if(afk_time[i] > 5) Send(playerid, COLOR_GREY, "Pesan berhasil terkirim. Pemutar SMS dalam AFK.");

			PlayerInfo[playerid][pSummaNumber] -= strlen(params[1])*2/2;
			format(String, 18, "~y~-%d$", strlen(params[1])*2/2), GameTextForPlayer(playerid, String, 1500, 1), GameTextForPlayer(i, "~y~SMS", 1500, 1);
			break;
   		}
	}
	if(full == 0) return Send(playerid, COLOR_GREY,"Nomor ini tidak ada atau pemilik nomor sedang luring.");
  	return 1;
}
CMD:bukahptutuodn(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][0] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki ponsel.");
	if(PlayerInfo[playerid][pNumber] == 0) return Send(playerid, COLOR_GREY, "Anda Tidak Memiliki Nomor.");

	format
	(
		String, 244,
		""W"1. Untuk menelepon\t-\n\
		2. Kirim SMS\t-\n\
		3. %s\t"W"-\n\
		4. Saldo telepon:\t{A6EB00}%d$\n\
		5. Nomor telepon:\t{00D6B0}%d",
		PhoneOnline[playerid] ? ("{D65502}Putuskan sambungan telepon") : ("{7BC910}Nyalakan telepon"), PlayerInfo[playerid][pSummaNumber], PlayerInfo[playerid][pNumber]
	);

	SPD(playerid,111,DIALOG_STYLE_LIST, "Ponsel", String, "Pilih", "Tutup");
	return 1;
}
CMD:togphone(playerid, params[])
{
    if(PlayerInfo[playerid][pProducts][0] == 0) return 1;
	if(PlayerInfo[playerid][pNumber] == 0) return 1;

    if(!PhoneOnline[playerid]) PhoneOnline[playerid] = 1, format(String, 64, "%s mematikan ponsel", Name(playerid));
    else PhoneOnline[playerid] = 0, format(String, 64, "%s menyalakan ponsel", Name(playerid));
    ProxDetector(15.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    return 1;
}

CMD:sc(playerid, params[])
{
    if(admin_level[playerid] == 0 && PlayerInfo[playerid][pSupport] == 0) return 1;
	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: /sc [teks]");

	format(format_string, sizeof(format_string), "* [SC] %s[%d]: {FFFFFF}%s", Name(playerid), playerid, params[0]);
	SendSupportMessage(COLOR_YELLOW, format_string);
	SendAdminMessage(COLOR_YELLOW, format_string);
	return true;
}

CMD:a(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1, "Masuk: /a [teks]");

	format(format_string, sizeof(format_string), "{FFB6C1}[A-CHAT] {FF0000}%s {AFAFAF}| {FFFFFF}%s: %s", PlayerInfo[playerid][pAname], DiiName(playerid), params[0]);
	SendAdminMessage(COLOR_WHITE, format_string);
	return true;
}
CMD:hp(playerid)
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

	if(IsPlayerInAnyVehicle(playerid))
	{
	    Fuell[GetPlayerVehicleID(playerid)] = MAX_VEHICLE_FUEL;
		RepairVehicle(GetPlayerVehicleID(playerid));
		VehInfo[GetPlayerVehicleID(playerid)][vFuel] = MAX_VEHICLE_FUEL;
		PlayerPlaySound(playerid, 32000, 0.0, 0.0, 0.0);
	}
	SetPlayerHealthEx(playerid, 100);
	PlayerInfo[playerid][pInjured] = 0;
	return true;
}

CMD:priz(playerid)
{
 	player_mysql_page[playerid] = 0;

	return ShowPlayerPrizeList(playerid);
}

stock ShowPlayerPrizeList(playerid)
{
    new page = player_mysql_page[playerid];

    format(format_string, 96, "SELECT * FROM `roulet_prizes` WHERE `user_id` = %i LIMIT %i, 10", GetPlayerAccountID(playerid), page * 10);
	new Cache: result = mysql_query(mMysql, format_string, true);

	new rows = cache_num_rows();

	if(rows == 0) return SCM(playerid, COLOR_GREY, "Anda tidak punya hadiah.");

	static prizes_type[][] = { "EXP", "Ketaatan hukum", "Uang", "Gold", "Transportasi", "VIP", "Pakaian" };
	static prizes_unit[][] = { "unit. ", "unit. ", "$", "DM ", "ID: ", "h. ", "ID: " };

	new str[96];

	command_text = "";

	new item_id, amount;

	for(new i; i < rows; i++)
	{
        cache_get_value_name_int(i, "item_id", item_id);
        cache_get_value_name_int(i, "amount", amount);

		format(str, 96, "[%i] %s\t%s%i\n", i, prizes_type[item_id], prizes_unit[item_id], amount);
		strcat(command_text, str);
	}

	SetPlayerUseListitem(playerid, rows);

	cache_delete(result);

	if(rows == 10) strcat(command_text, "[10] Halaman selanjutnya\t\n");
	if(page != 0) strcat(command_text, "[11] Halaman sebelumnya\t\n");


	return SPD(playerid, 4762, DIALOG_STYLE_INPUT, "Daftar Hadiah", command_text, "Pilih", "Tutup");
}

CMD:supports(playerid, params[])
{
    Send(playerid, 0x33AA33AA, "Dukungan online:");
	foreach(new i : support_list)
	{
		if(afk_time[i] > 5) SCMF(playerid, 0xFFFF00AA, "%s[%d] | {FF0000}AFK: %s",Name(i),i, Convert(afk_time[i]-5));
		else SCMF(playerid, 0xFFFF00AA, "%s[%d] ",Name(i), i);
	}
	return 1;
}

CMD:admins(playerid, params[])
{
    new count = 0, line3[512];
    if(admin_level[playerid] > 0)
    {
        foreach(new i:Player)
        {
            if(admin_level[i] > 0 )
            {
                format(line3, sizeof(line3), "{FFFFFF}%s\n{FF7F00}[%s] {FFFFFF}%s {FF7F00}[%s] {FFFFFF}(ID: %i)", line3, DiiName(i), pData[i][pName], pData[i][pAname], i);
                count++;
            }
        }
        if(count > 0)
        {
            ShowPlayerDialog(playerid, DIALOG_UNUSED, DIALOG_STYLE_MSGBOX, ""RED_E"Staff Online", line3, "Close", "");
        }
        else return ShowPlayerDialog(playerid, DIALOG_UNUSED, DIALOG_STYLE_MSGBOX, ""RED_E"Staff Online", "There are no admin online!", "Close", "");
    }
    else
    {
        foreach(new i:Player)
        {
            if(admin_level[i] > 0 )
            {
                if(OnDuty[i] == 1)
                {
                    format(line3, sizeof(line3), "{FFFFFF}%s\n{FF7F00}[%s] {FF7F00}[%s] {FFFFFF}(ID: %i)", line3, DiiName(i), pData[i][pAname], i);
                    count++;
                }
            }
        }
        if(count > 0)
        {
            ShowPlayerDialog(playerid, DIALOG_UNUSED, DIALOG_STYLE_MSGBOX, ""RED_E"Staff Online", line3, "Close", "");
        }
        else return ShowPlayerDialog(playerid, DIALOG_UNUSED, DIALOG_STYLE_MSGBOX, ""RED_E"Staff Online", "There are no admin online duty!", "Close", "");
    }
    return 1;
}

