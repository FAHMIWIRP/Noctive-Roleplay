public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    new list_id;
	list_id = strval(inputtext);
	
	// Variabel tambahan untuk sistem Bisnis
    new index = GetPVarInt(playerid, "EditingBizz");
    new i = GetPVarInt(playerid, "InsideBizIndex");
    new query[256], price, format_stringz[256];
    
    new varName[32], varCode[32], varUse[32], itemName[32], itemCode[32];

    switch(dialogid)
    {
        case DIALOG_INVENTORY:
        {
            if(!response) return 1;
            
            SetPVarInt(playerid, "SelectedSlot", listitem);
            
            format(varName, sizeof(varName), "InvName_%d", listitem);
            format(varUse, sizeof(varUse), "InvUse_%d", listitem);
            GetPVarString(playerid, varName, itemName, sizeof(itemName));
            
            new menuStr[128];
            if(GetPVarInt(playerid, varUse) == 1) {
                format(menuStr, sizeof(menuStr), "Informasi\nGive\nUse");
            } else {
                format(menuStr, sizeof(menuStr), "Informasi\nGive");
            }
            
            ShowPlayerDialog(playerid, DIALOG_INV_OPTIONS, DIALOG_STYLE_LIST, itemName, menuStr, "Pilih", "Kembali");
            return 1;
        }

        case DIALOG_INV_OPTIONS:
		{
		    if(!response) return callcmd::items(playerid, "");

		    new slot = GetPVarInt(playerid, "SelectedSlot");
		    format(varName, sizeof(varName), "InvName_%d", slot);
		    format(varCode, sizeof(varCode), "InvCode_%d", slot);

		    GetPVarString(playerid, varName, itemName, sizeof(itemName));
		    GetPVarString(playerid, varCode, itemCode, sizeof(itemCode));

		    if(listitem == 0) // Informasi
		    {
		        new infoStr[128];
		        format(infoStr, sizeof(infoStr), "Ini adalah item %s yang ada di dalam tas Anda.", itemName);
		        ShowPlayerDialog(playerid, 8463, DIALOG_STYLE_MSGBOX, "Informasi Items", infoStr, "Oke", "");
		        ShowPanjulNotif(playerid, "Melihat informasi item.");
		    }
		    else if(listitem == 1) // Give
		    {
		        ShowPlayerDialog(playerid, DIALOG_INV_GIVE_AMT, DIALOG_STYLE_INPUT, "Give Item", "Masukkan jumlah item yang ingin diberikan:", "Lanjut", "Batal");
		    }
		    else if(listitem == 2) // Use
		    {
		        if(strcmp(itemCode, "snack", true) == 0)
		        {
		            if(PlayerInfo[playerid][pFood] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Snack.");
		            PlayerInfo[playerid][pFood] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pFood", PlayerInfo[playerid][pFood]);
		            PlayerInfo[playerid][pSatiety] += 10;
		            OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
		            if(pData[playerid][pSatiety] > 100) pData[playerid][pSatiety] = 100;
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MAKAN SNACK...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Snack", 1);
		            ShowPanjulNotif(playerid, "Kamu memakan 1 Snack.");
		            Info(playerid, "Anda sedang memakan 1 Snack. ");
		            ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 1, 1, 0, 0, 1);
		        }
		        else if(strcmp(itemCode, "drink", true) == 0)
		        {
		            if(PlayerInfo[playerid][pDrink] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Minuman.");
		            PlayerInfo[playerid][pDrink] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pDrink", PlayerInfo[playerid][pDrink]);
		            PlayerInfo[playerid][pThirst] += 10;
		            OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
		            if(pData[playerid][pThirst] > 100) pData[playerid][pThirst] = 100;
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MINUM...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Sprunk", 1);
		            ShowPanjulNotif(playerid, "Kamu meminum 1 Drink.");
		            Info(playerid, "Anda sedang meminum 1 Drink.");
		            ApplyAnimation(playerid, "BAR", "dnk_stndm_loop", 4.1, 0, 1, 1, 0, 0, 1);
		        }
		        else if(strcmp(itemCode, "marijuana", true) == 0)
		        {
		            if(PlayerInfo[playerid][pMicin] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Marijuana.");
		            new Float:armour; GetPlayerArmour(playerid, armour);
		            if(armour >= 100.0) return SendClientMessage(playerid, 0xB4B5B7FF, "Armor Anda sudah penuh.");
		            PlayerInfo[playerid][pMicin] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
		            SetPlayerArmour(playerid, (armour + 5.0) > 100.0 ? 100.0 : (armour + 5.0));
		            PlayerInfo[playerid][pArmour] += 5;
		            OnPlayerUpdateAccountsPer(playerid, "pArmour", PlayerInfo[playerid][pArmour]);
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MEROKOK MARIJUANA...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Marijuana", 1);
		            ShowPanjulNotif(playerid, "Kamu merokok Marijuana.");
		            Info(playerid, "Anda sedang menggunakan Marijuana.");
		            ApplyAnimation(playerid, "GANGS", "smk_loop_g", 4.0, 1, 0, 0, 0, 0);
		        }
		        else if(strcmp(itemCode, "crack", true) == 0)
		        {
		            if(PlayerInfo[playerid][pCrack] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Crack.");
		            new Float:armour; GetPlayerArmour(playerid, armour);
		            if(armour >= 100.0) return SendClientMessage(playerid, 0xB4B5B7FF, "Armor Anda sudah penuh.");
		            PlayerInfo[playerid][pCrack] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pCrack]);
		            SetPlayerArmour(playerid, (armour + 15.0) > 100.0 ? 100.0 : (armour + 15.0));
		             PlayerInfo[playerid][pArmour] += 15;
		            OnPlayerUpdateAccountsPer(playerid, "pArmour", PlayerInfo[playerid][pArmour]);
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MENGGUNAKAN CRACK...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Crack", 1);
		            ShowPanjulNotif(playerid, "Kamu menggunakan Crack.");
		            Info(playerid, "Anda sedang menggunakan Crack.");
		            ApplyAnimation(playerid, "GANGS", "smk_loop_g", 4.0, 1, 0, 0, 0, 0);
		        }
		        else if(strcmp(itemCode, "medicine", true) == 0)
		        {
		            if(PlayerInfo[playerid][pMedicine] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Medicine.");
		            if(PlayerInfo[playerid][pSakitcik] == 0) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak sedang sakit.");
		            PlayerInfo[playerid][pMedicine] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pMedicine", PlayerInfo[playerid][pMedicine]);
		            PlayerInfo[playerid][pStress] -= 100;
		            OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);
		            PlayerInfo[playerid][pSakitcik] = 0;
		            OnPlayerUpdateAccountsPer(playerid, "pSakitcik", PlayerInfo[playerid][pSakitcik]);
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MINUM OBAT...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Medicine", 1);
		            ShowPanjulNotif(playerid, "Kamu meminum Medicine.");
		            SetPlayerDrunkLevel(playerid, 0);
		            Info(playerid, "Anda sedang meminum Medicine.");
		            ApplyAnimation(playerid, "VENDORS", "vend_drink2_p", 4.1, 0, 1, 1, 0, 0, 1);
		        }
		        else if(strcmp(itemCode, "bandage", true) == 0)
		        {
		            if(PlayerInfo[playerid][pHeals] < 1) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Bandage.");
		            new Float:health; GetPlayerHealth(playerid, health);
		            if(health >= 100.0) return SendClientMessage(playerid, 0xB4B5B7FF, "Darah Anda sudah penuh.");
		            PlayerInfo[playerid][pHeals] -= 1;
		            OnPlayerUpdateAccountsPer(playerid, "pHeals", PlayerInfo[playerid][pHeals]);
		            SetPlayerHealth(playerid, (health + 5.0) > 100.0 ? 100.0 : (health + 5.0));
		            PlayerUsingItem[playerid] = 1;
		            ShowProgressbar(playerid, "MENGGUNAKAN BANDAGE...", 5);
		            SetTimerEx("ResetPlayerUseStatus", 5000, false, "d", playerid);
		            ShowItemNotification(playerid, false, "Bandage", 1);
		            ShowPanjulNotif(playerid, "Kamu menggunakan Bandage.");
		            Info(playerid, "Anda sedang menggunakan perban/bandage.");
		            ApplyAnimation(playerid, "MISC", "bndg_ply", 4.0, 1, 0, 0, 0, 0);
		        }
		    }
		    return 1;
		}

        // --- KODE BISNIS DIMULAI DI SINI ---
        case DIALOG_BUSINESS_MENU:
        {
            if(!response) return 1;
            switch(listitem) {
                case 0: ShowPlayerDialog(playerid, DIALOG_EDIT_BIZZ_NAME, DIALOG_STYLE_INPUT, "Edit Name", "Masukkan nama baru untuk bisnis kamu:", "Save", "Back");
                case 1: {
                    BisnisData[index][bzLocked] = !BisnisData[index][bzLocked];
                    UpdateBisnisLabel(index);
                    mysql_format(mMysql, query, sizeof(query), "UPDATE bisnis SET locked = %d WHERE id = %d", (BisnisData[index][bzLocked] ? 1 : 0), BisnisData[index][bzID]);
                    mysql_tquery(mMysql, query);
                    SendClientMessage(playerid, -1, BisnisData[index][bzLocked] ? "{ff0000}Bisnis Locked!" : "{2ecc71}Bisnis Unlocked!");
                }
                case 3: ShowPlayerDialog(playerid, DIALOG_VAULT_MENU, DIALOG_STYLE_LIST, "Money Vault", "Deposit Money\nWithdraw Money", "Select", "Back");
            }
        }
        case DIALOG_EDIT_BIZZ_NAME:
        {
            if(!response) return 1;
            if(strlen(inputtext) < 3 || strlen(inputtext) > 32) return SendClientMessage(playerid, -1, "Nama terlalu pendek/panjang!");
            format(BisnisData[index][bzName], 64, inputtext);
            UpdateBisnisLabel(index);
            mysql_format(mMysql, query, sizeof(query), "UPDATE bisnis SET name = '%e' WHERE id = %d", BisnisData[index][bzName], BisnisData[index][bzID]);
            mysql_tquery(mMysql, query);
            SendClientMessage(playerid, -1, "{005DFF}Berhasil: {ffffff}Nama bisnis berhasil diganti.");
        }
        case DIALOG_VAULT_MENU:
        {
            if(!response) return 1;
            if(listitem == 0) {
                new str[256]; format(str, sizeof(str), "{ffffff}Saldo Bisnis: {2ecc71}%s\n{ffffff}Uang di Dompet: {2ecc71}%s\n\n{ffffff}Masukkan jumlah uang yang ingin DISIMPAN:", FormatMoney(BisnisData[index][bzVault]), FormatMoney(GetPlayerMoney(playerid)));
                ShowPlayerDialog(playerid, DIALOG_DEPOSIT_VAULT, DIALOG_STYLE_INPUT, "Vault - Deposit", str, "Deposit", "Back");
            } else {
                new str[256]; format(str, sizeof(str), "{ffffff}Saldo Bisnis: {2ecc71}%s\n\n{ffffff}Masukkan jumlah uang yang ingin DIAMBIL:", FormatMoney(BisnisData[index][bzVault]));
                ShowPlayerDialog(playerid, DIALOG_WITHDRAW_VAULT, DIALOG_STYLE_INPUT, "Vault - Withdraw", str, "Withdraw", "Back");
            }
        }
        case DIALOG_DEPOSIT_VAULT:
        {
            if(!response) return ShowPlayerDialog(playerid, DIALOG_VAULT_MENU, DIALOG_STYLE_LIST, "Money Vault", "Deposit Money\nWithdraw Money", "Select", "Back");
            new amount = strval(inputtext);
            if(amount <= 0 || GetPlayerMoney(playerid) < amount) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Jumlah Tidak Valid/Uang tidak cukup!");
            BisnisData[index][bzVault] += amount;
            GivePlayerMoneyEx(playerid, -amount, "deposit ke bisnis");
            mysql_format(mMysql, query, sizeof(query), "UPDATE bisnis SET vault = %d WHERE id = %d", BisnisData[index][bzVault], BisnisData[index][bzID]);
            mysql_tquery(mMysql, query);
            SendClientMessage(playerid, -1, "{005DFF}Berhasil: {ffffff}Kamu mendepositkan uang ke kas bisnis.");
        }
        case DIALOG_WITHDRAW_VAULT:
        {
            if(!response) return ShowPlayerDialog(playerid, DIALOG_VAULT_MENU, DIALOG_STYLE_LIST, "Money Vault", "Deposit Money\nWithdraw Money", "Select", "Back");
            new amount = strval(inputtext);
            if(amount <= 0 || amount > BisnisData[index][bzVault]) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Jumlah Tidak Valid/Saldo tidak cukup!");
            BisnisData[index][bzVault] -= amount;
            GivePlayerMoneyEx(playerid, amount, "ambil uang bisnis");
            mysql_format(mMysql, query, sizeof(query), "UPDATE bisnis SET vault = %d WHERE id = %d", BisnisData[index][bzVault], BisnisData[index][bzID]);
            mysql_tquery(mMysql, query);
            SendClientMessage(playerid, -1, "{005DFF}Berhasil: {ffffff}Kamu mengambil uang dari kas bisnis.");
        }
		            case DIALOG_ELECTRONIC_MENU:
{
    if(!response) return 1;

    // Ambil ID Bisnis dari variabel player yang sedang berinteraksi
    new i = player_use_bizbar[playerid];

    // Validasi stok bisnis
    if(BisnisData[i][bzStock] <= 0)
        return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Stok barang habis!");

    price = 500;

    switch(listitem)
    {
        case 0: // Beli Telepon
{
    if(PlayerInfo[playerid][pProducts][0] == 1)
        return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu sudah memiliki Handphone!");

    if(GetPlayerMoney(playerid) < price)
        return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

    // Generate nomor awal: random(900000) + 100000 akan menghasilkan angka 100000 sampai 999999 (Pasti 6 digit)
    new test_number = random(900000) + 100000;

    // Cek ke database apakah nomor ini unik
    new format_string[128];
    mysql_format(mMysql, format_string, sizeof(format_string), "SELECT `pID` FROM `accounts` WHERE `pNumber` = %d LIMIT 1", test_number);

    // Lempar ke callback baru untuk di cek. Kita bawa data playerid, price, dan nomor yang mau di tes
    mysql_tquery(mMysql, format_string, "OnBuyPhoneCheck", "iii", playerid, price, test_number);
}
        case 1: // Beli Jam Tangan
        {
            if(PlayerInfo[playerid][pClock]) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu sudah memiliki Jam Tangan!");
            if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

            GivePlayerMoneyEx(playerid, -price, "beli jam");
            PlayerInfo[playerid][pClock] = 1;
            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Jam Tangan");
        }
        case 2: // Beli Buku Telepon
        {
            if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

            PlayerInfo[playerid][pProducts][1] = 1;
            GivePlayerMoneyEx(playerid, -price, "beli phonebook");
            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Buku Telepon");
        }
        case 3: // Beli Walkie Talkie
        {
            if(pData[playerid][pRadio]) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu sudah memiliki Walkie Talkie!");
            if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

            pData[playerid][pRadio] = 1;
            GivePlayerMoneyEx(playerid, -price, "beli wt");
            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Walkie Talkie");
        }
        case 4: // Beli Boombox
        {
            if(PlayerInfo[playerid][pBoombox]) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu sudah memiliki Boombox!");
            if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

            PlayerInfo[playerid][pBoombox] = 1;
            GivePlayerMoneyEx(playerid, -price, "beli boombox");
            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Boombox");
        }
    }

    // Update stok dan keuangan bisnis
    BisnisData[i][bzStock] -= 1;
    GiveMoneyToBusiness(i, price);
    UpdateBisnisLabel(i);
    return 1;
}

    case DIALOG_FASTFOOD_MENU:
	{
	    if(!response) return 1;
	    if(BisnisData[i][bzStock] <= 0) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Stok habis!");
	    price = 500;
	    if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");

	    switch(listitem) {
	        case 0: {
	            PlayerInfo[playerid][pDrink] += 1;
	            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Air Mineral");
	            OnPlayerUpdateAccountsPer(playerid, "pDrink", PlayerInfo[playerid][pDrink]);
	        }
	        case 1: {
	            PlayerInfo[playerid][pDrink] += 1;
	            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Kopi");
	            OnPlayerUpdateAccountsPer(playerid, "pDrink", PlayerInfo[playerid][pDrink]);
	        }
	        case 2: {
	            PlayerInfo[playerid][pFood] += 1;
	            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Nasi Padang");
	            OnPlayerUpdateAccountsPer(playerid, "pFood", PlayerInfo[playerid][pFood]);
	        }
	        case 3: {
	            PlayerInfo[playerid][pFood] += 1;
	            Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Daging Ayam");
	            OnPlayerUpdateAccountsPer(playerid, "pFood", PlayerInfo[playerid][pFood]);
	        }
	    }

	    BisnisData[i][bzStock] -= 1; // MEMPERBAIKI BUG: Stok sekarang berkurang
	    GivePlayerMoneyEx(playerid, -price, "beli makan");
	    GiveMoneyToBusiness(i, price);
	    UpdateBisnisLabel(i);
	}
    case DIALOG_EQUIPMENT_MENU:
    {
        if(!response) return 1;
        if(BisnisData[i][bzStock] <= 0) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Stok habis!");
        price = 500;
        if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");
        switch(listitem) {
            case 0: { GivePlayerWeapon(playerid, 5, 1); Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Baseball Bat"); }
            case 1: { GivePlayerWeapon(playerid, 6, 1); Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Shovel"); }
            case 2: { GivePlayerWeapon(playerid, 4, 1); Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Knife"); }
            case 3: { GivePlayerWeapon(playerid, 9, 1); Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Chainsaw"); }
            case 4:
            {
                if(PlayerInfo[playerid][pHoe] >= 100) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Hoe maksimal hanya boleh membawa 100!");
                PlayerInfo[playerid][pHoe] += 50;
                OnPlayerUpdateAccountsPer(playerid, "pHoe", PlayerInfo[playerid][pHoe]);
                Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}50 Hoe");
            }
        }
        BisnisData[i][bzStock] -= 1;
        GivePlayerMoneyEx(playerid, -price, "beli equipment");
        GiveMoneyToBusiness(i, price);
        UpdateBisnisLabel(i);
    }
    case DIALOG_MARKET_MENU:
    {
        if(!response) return 1;
        if(BisnisData[i][bzStock] <= 0) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Stok habis!");
        price = 500;
        if(GetPlayerMoney(playerid) < price) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup.");
        switch(listitem) {
            case 0: { PlayerInfo[playerid][pHeals] += 1; Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Bandage"); }
            case 1: { if(PlayerInfo[playerid][pMask] >= 2) return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Masker maksimal hanya boleh membawa 2!"); PlayerInfo[playerid][pMask]++; Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Masker"); }
            case 2: { PlayerInfo[playerid][pPancing] += 1; Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Pancingan"); }
            case 3: { PlayerInfo[playerid][pUmpan] += 50; Send(playerid, -1, "{00FFFF}[ Bizz ] {FFFFFF}Kamu Berhasil Membeli {00FF00}Umpan (50x)"); }
        }
        // MEMPERBAIKI BUG: Menghapus duplikasi baris pengurangan stok & uang di bawah ini
        BisnisData[i][bzStock] -= 1;
        GivePlayerMoneyEx(playerid, -price, "beli market");
        GiveMoneyToBusiness(i, price);
        UpdateBisnisLabel(i);
    }

        case DIALOG_INV_GIVE_AMT:
        {
            if(!response) return 1;

            new value = strval(inputtext);
            if(value < 1) return SendClientMessage(playerid, 0xFF0000FF, "Jumlah tidak boleh di bawah 1.");

            SetPVarInt(playerid, "GiveAmount", value);

            new pList[1024], nameTarget[32], countNear = 0;
            format(pList, sizeof(pList), "Player ID\tNama Player\n");

            for(new i = 0; i < MAX_PLAYERS; i++) {
                if(IsPlayerConnected(i) && i != playerid) {
                    new Float:x, Float:y, Float:z;
                    GetPlayerPos(playerid, x, y, z);
                    if(IsPlayerInRangeOfPoint(i, 4.0, x, y, z)) { // Radius dekat 4 meter
                        GetPlayerName(i, nameTarget, sizeof(nameTarget));
                        format(pList, sizeof(pList), "%s%d\t%s\n", pList, i, nameTarget);
                        countNear++;
                    }
                }
            }

            if(countNear == 0) return SendClientMessage(playerid, 0xFF0000FF, "Tidak ada player lain di dekat Anda.");

            ShowPlayerDialog(playerid, DIALOG_INV_GIVE_PLY, DIALOG_STYLE_TABLIST_HEADERS, "Pilih Player Terdekat", pList, "Give", "Batal");
            return 1;
        }

        case DIALOG_INV_GIVE_PLY:
		{
		    if(!response) return 1;

		    // Mengambil ID Player terdekat dari inputtext (kolom pertama)
		    new targetid = strval(inputtext);
		    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, 0xFF0000FF, "Player sudah tidak berada di server.");

		    new slot = GetPVarInt(playerid, "SelectedSlot");
		    format(varCode, sizeof(varCode), "InvCode_%d", slot);
		    GetPVarString(playerid, varCode, itemCode, sizeof(itemCode));

		    new amount = GetPVarInt(playerid, "GiveAmount");
		    new otherid = targetid;

		    // ==================== PROSES GIVE ITEM ====================
		    if(strcmp(itemCode, "bandage", true) == 0)
		    {
		        if(amount > PlayerInfo[playerid][pHeals]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup bandage");
		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pHeals] -= amount; OnPlayerUpdateAccountsPer(playerid, "pHeals", PlayerInfo[playerid][pHeals]);
		        PlayerInfo[otherid][pHeals] += amount; OnPlayerUpdateAccountsPer(otherid, "pHeals", PlayerInfo[otherid][pHeals]);
		        ShowItemNotification(playerid, false, "Bandage", amount); ShowItemNotification(otherid, true, "Bandage", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Bandage."); ShowPanjulNotif(otherid, "Menerima Bandage.");
		        Info(playerid, "Anda telah berhasil memberikan perban kepada %s sejumlah %d.", ReturnName(otherid), amount);
		        Info(otherid, "%s telah berhasil memberikan perban kepada anda sejumlah %d.", ReturnName(playerid), amount);
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "redmoney", true) == 0)
		    {
		        if(amount > PlayerInfo[playerid][pRedmoney]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup Redmoney");
		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pRedmoney] -= amount; OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
		        PlayerInfo[otherid][pRedmoney] += amount; OnPlayerUpdateAccountsPer(otherid, "pRedmoney", PlayerInfo[otherid][pRedmoney]);
		        ShowItemNotification(playerid, false, "Redmoney", amount); ShowItemNotification(otherid, true, "Redmoney", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Redmoney."); ShowPanjulNotif(otherid, "Menerima Redmoney.");
		        Info(playerid, "Anda telah berhasil memberikan redmoney kepada %s sejumlah %s.", ReturnName(otherid), FormatMoney(amount));
		        Info(otherid, "%s telah berhasil memberikan redmoney kepada anda sejumlah %s.", ReturnName(playerid), FormatMoney(amount));
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "seeds", true) == 0)
		    {
		        if(amount > PlayerInfo[playerid][pSeeds]) return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki cukup Seeds");
		        if(amount < 1) return Error(playerid, "Can't Give below 1");
		        PlayerInfo[playerid][pSeeds] -= amount; OnPlayerUpdateAccountsPer(playerid, "pSeeds", PlayerInfo[playerid][pSeeds]);
		        PlayerInfo[otherid][pSeeds] += amount; OnPlayerUpdateAccountsPer(otherid, "pSeeds", PlayerInfo[otherid][pSeeds]);
		        ShowItemNotification(playerid, false, "Seeds", amount); ShowItemNotification(otherid, true, "Seeds", amount);
		        ShowPanjulNotif(playerid, "Berhasil memberikan Seeds."); ShowPanjulNotif(otherid, "Menerima Seeds.");
		        Info(playerid, "Anda telah berhasil memberikan Seeds kepada %s sejumlah %s.", ReturnName(otherid), FormatMoney(amount));
		        Info(otherid, "%s telah berhasil memberikan Seeds kepada anda sejumlah %s.", ReturnName(playerid), FormatMoney(amount));
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
