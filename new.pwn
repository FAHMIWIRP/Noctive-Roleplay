stock DestroyPinTD(playerid)
{
    for (new i = 0; i < 39; i++)
    {
        if (tdpin[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
        {
            PlayerTextDrawHide(playerid, tdpin[playerid][i]);
            PlayerTextDrawDestroy(playerid, tdpin[playerid][i]);
            tdpin[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
        }
    }
    return 1;
}
CMD:spec(playerid, params[])
{
    new id;

    if(sscanf(params, "u", id))
        return SendClientMessage(playerid, -1, "USAGE: /spec [id/nama]");

    if(id == INVALID_PLAYER_ID || !IsPlayerConnected(id))
        return SendClientMessage(playerid, -1, "Player tersebut tidak ditemukan / tidak terhubung.");

    if(id == playerid)
        return SendClientMessage(playerid, -1, "Anda tidak dapat spectate diri sendiri.");
        
        SelectTextDraw(playerid, 0xFFFFFFFF);

    StartSpec(playerid, id);
    return 1;
}

// ----------------------------------------------------------------------------------------------------
// MULAI SPECTATE
// ----------------------------------------------------------------------------------------------------
stock StartSpec(playerid, targetid)
{
    // simpan posisi & world player sebelum spectate
    GetPlayerPos(playerid, pSpecPosX[playerid], pSpecPosY[playerid], pSpecPosZ[playerid]);
    pSpecInterior[playerid] = GetPlayerInterior(playerid);
    pSpecVW[playerid] = GetPlayerVirtualWorld(playerid);

    pSpectating[playerid] = true;
    pSpecTarget[playerid] = targetid;

    TogglePlayerSpectating(playerid, true);
    SetPlayerInterior(playerid, GetPlayerInterior(targetid));
    SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(targetid));
    PlayerSpectatePlayer(playerid, targetid);

    ShowSpecTD(playerid);
    UpdateSpecTD(playerid, targetid);

    new string[64];
    format(string, sizeof(string), "Anda sedang men-spectate %s (ID: %d).", ReturnPlayerName(targetid), targetid);
    SendClientMessage(playerid, -1, string);
    return 1;
}

// ----------------------------------------------------------------------------------------------------
// BERHENTI SPECTATE
// ----------------------------------------------------------------------------------------------------
stock StopSpec(playerid)
{
    pSpectating[playerid] = false;
    pSpecTarget[playerid] = INVALID_PLAYER_ID;

    TogglePlayerSpectating(playerid, false);
    SetPlayerInterior(playerid, pSpecInterior[playerid]);
    SetPlayerVirtualWorld(playerid, pSpecVW[playerid]);
    SetPlayerPos(playerid, pSpecPosX[playerid], pSpecPosY[playerid], pSpecPosZ[playerid]);

    HideSpecTD(playerid);
    SendClientMessage(playerid, -1, "Anda telah berhenti melakukan spectate.");
    return 1;
}

// ----------------------------------------------------------------------------------------------------
// CARI TARGET BERIKUTNYA / SEBELUMNYA (dir = 1 Next, dir = -1 Back)
// ----------------------------------------------------------------------------------------------------
stock GetNextSpecTarget(playerid, current, dir)
{
    new next = current;

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        next += dir;

        if(next >= MAX_PLAYERS) next = 0;
        else if(next < 0) next = MAX_PLAYERS - 1;

        if(next == playerid) continue;
        if(IsPlayerConnected(next)) return next;
    }
    return INVALID_PLAYER_ID;
}

// ----------------------------------------------------------------------------------------------------
// PINDAH KE TARGET LAIN (dipakai oleh tombol Next & Back)
// ----------------------------------------------------------------------------------------------------
stock SwitchSpecTarget(playerid, dir)
{
    new next = GetNextSpecTarget(playerid, pSpecTarget[playerid], dir);

    if(next == INVALID_PLAYER_ID)
    {
        SendClientMessage(playerid, -1, "Tidak ada player lain untuk di-spectate.");
        return 0;
    }

    pSpecTarget[playerid] = next;

    SetPlayerInterior(playerid, GetPlayerInterior(next));
    SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(next));
    PlayerSpectatePlayer(playerid, next);

    UpdateSpecTD(playerid, next);
    return 1;
}

// ----------------------------------------------------------------------------------------------------
// UPDATE ISI TEXTDRAW (Nama, Cash, Bank, Level)
// Sesuaikan PlayerInfo[targetid][pCash] / [pBank] / [pLevel] dengan nama variabel di gamemode Anda.
// ----------------------------------------------------------------------------------------------------
stock UpdateSpecTD(playerid, targetid)
{
    new string[32];

    PlayerTextDrawSetString(playerid, specnorp[playerid][27], ReturnPlayerName(targetid));

    format(string, sizeof(string), "%d", PlayerInfo[targetid][pCash]);
    PlayerTextDrawSetString(playerid, specnorp[playerid][24], string);

    format(string, sizeof(string), "%d", PlayerInfo[targetid][pBank]);
    PlayerTextDrawSetString(playerid, specnorp[playerid][25], string);

    format(string, sizeof(string), "%d", PlayerInfo[targetid][pLevel]);
    PlayerTextDrawSetString(playerid, specnorp[playerid][26], string);

    PlayerTextDrawShow(playerid, specnorp[playerid][27]);
    PlayerTextDrawShow(playerid, specnorp[playerid][24]);
    PlayerTextDrawShow(playerid, specnorp[playerid][25]);
    PlayerTextDrawShow(playerid, specnorp[playerid][26]);
    return 1;
}
stock OnSpecTargetDisconnect(playerid)
{
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && pSpectating[i] && pSpecTarget[i] == playerid)
        {
            new next = GetNextSpecTarget(i, playerid, 1);

            if(next == INVALID_PLAYER_ID)
            {
                StopSpec(i);
            }
            else
            {
                pSpecTarget[i] = next;
                SetPlayerInterior(i, GetPlayerInterior(next));
                SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(next));
                PlayerSpectatePlayer(i, next);
                UpdateSpecTD(i, next);
            }
        }
    }
    return 1;
}

// ----------------------------------------------------------------------------------------------------
// TAMPILKAN / SEMBUNYIKAN SELURUH TEXTDRAW
// ----------------------------------------------------------------------------------------------------
stock ShowSpecTD(playerid)
{
    for(new i = 0; i < 28; i++)
    {
        PlayerTextDrawShow(playerid, specnorp[playerid][i]);
    }
    return 1;
}

stock HideSpecTD(playerid)
{
    for(new i = 0; i < 28; i++)
    {
        PlayerTextDrawHide(playerid, specnorp[playerid][i]);
    }
    return 1;
}

