			if(GetPlayerBizz(to_player) != -1) return SCM(playerid, COLOR_GREY, "Pemain ini sudah memiliki bisnis.");
			if(GetPlayerABizz(to_player) != 0) return SCM(playerid, COLOR_GREY, "Pemain ini sudah memiliki pengisian bahan bakar.");

