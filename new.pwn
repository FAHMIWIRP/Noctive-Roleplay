stock SetPlayerCriminal(playerid, killerid[], reason[])
{
	if(PlayerInfo[playerid][pWanted] > 6) PlayerInfo[playerid][pWanted] = 6;

	SCMF(playerid, 0xF04D0FAA, "Anda melakukan kejahatan: [ %s ]. Pelaporan: %s.", reason, killerid);
	if(PlayerInfo[playerid][pZakon] > 0) PlayerInfo[playerid][pZakon]--;

 	foreach(new i : Player)
	{
		if(IsACop(i)) SCMF(i, 0xFEBC41AA, "Pelaporan: %s. Kejahatan: %s. Tersangka: %s", killerid,reason,Name(playerid)), PlayerPlaySound(i, 21001, 0.0, 0.0, 0.0);
	}
	return 1;
}
