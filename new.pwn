stock SetVehicleLights(vehicleid, playerid)
{
	//new engine,lights,alarm,doors,bonnet,boot,objective;
	GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
	if(lights == VEHICLE_PARAMS_ON)
	{
		SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_OFF,alarm,doors,bonnet,boot,objective);
		SendClientMessage(playerid, COLOR_RED, "Lampu Mobil OFF.");
	}
	else if(lights == VEHICLE_PARAMS_OFF || lights == VEHICLE_PARAMS_UNSET)
	{
		SetVehicleParamsEx(vehicleid,engine,VEHICLE_PARAMS_ON,alarm,doors,bonnet,boot,objective);
		SendClientMessage(playerid, COLOR_GREEN, "Lampu Mobil ON.");
	}
	return 1;
}

forward CBugFreezeOver(playerid);
public CBugFreezeOver(playerid)
{
	TogglePlayerControllable(playerid, true);

	pCBugging[playerid] = false;
	return 1;
}
//paket ilegal
forward TimePaket();
public TimePaket()
{
    new rand = random(5);
    StatusPacket = 1;
    DestroyDynamicPickup(IDPacket);
    DestroyDynamic3DTextLabel(PacketLabel);
    PacketLabel = CreateDynamic3DTextLabel("[PACKET ILEGAL]\n{FFFFFF}/takepacket", COLOR_BLUE, RandomPacket[rand][0], RandomPacket[rand][1], RandomPacket[rand][2], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
    IDPacket = CreateDynamicPickup(1575, 23, RandomPacket[rand][0], RandomPacket[rand][1], RandomPacket[rand][2], 0, 0);
    PosPacket[0] = RandomPacket[rand][0];
    PosPacket[1] = RandomPacket[rand][1];
    PosPacket[2] = RandomPacket[rand][2];
    foreach(Player, i)
    if(IsAGang(i))
	{
    SCM(i, 0x33AAFFFF, "========[ PAKET ILEGAL ]========");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Paket Ilegal telah spawn di map!");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Gunakan {FFFF00}/findpacket {FFFFFF}untuk melacak");
	SCM(i, -1, "{FF0000}>> {FFFFFF}NOTE: Siapa cepat dia dapat!");
	SCM(i, 0x33AAFFFF, "================================");
	}
	else if(IsAMafia(i))
	{
    SCM(i, 0x33AAFFFF, "========[ PAKET ILEGAL ]========");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Paket Ilegal telah spawn di map!");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Gunakan {FFFF00}/findpacket {FFFFFF}untuk melacak");
	SCM(i, -1, "{FF0000}>> {FFFFFF}NOTE: Siapa cepat dia dapat!");
	SCM(i, 0x33AAFFFF, "================================");
	}
	else if(PlayerInfo[i][pFamily] != -1)
	{
    SCM(i, 0x33AAFFFF, "========[ PAKET ILEGAL ]========");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Paket Ilegal telah spawn di map!");
	SCM(i, -1, "{33FF33}>> {FFFFFF}Gunakan {FFFF00}/findpacket {FFFFFF}untuk melacak");
	SCM(i, -1, "{FF0000}>> {FFFFFF}NOTE: Siapa cepat dia dapat!");
	SCM(i, 0x33AAFFFF, "================================");
	}
	KillTimer(TimePacket);
	TimePacket = SetTimer("TimePaket", 600000, 0);
	return 1;
}
