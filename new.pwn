CMD:getipinfo(playerid, params[])
{
    if(admin_level[playerid] < 5) return 1;

    if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/getipinfo [ip address]");

	format(format_string, 144, "stars/geo/index.php?ip=%s", params);
    return HTTP(playerid, HTTP_GET, format_string, "", "GetInfoOfIp");
}

publics: GetInfoOfIp(playerid, response_code, data[])
{
    if(response_code != 200) return SCM(playerid, COLOR_GREY, "Kesalahan selama eksekusi permintaan.");

    new geo_info[4][32];

    SplitString(data, geo_info, ',');

	format(format_string, 144,
		"{FFFFFF}IP: %s\n\n\
		Negara: %s\n\
		Kota: %s\n\
		UTC: %s",
		geo_info[0], geo_info[1], geo_info[2], geo_info[3]);

	return SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Informasi IP", format_string, "Tutup", "");
}

CMD:getfake(playerid, params[])
{
	if(admin_level[playerid] < 5) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/getfake [ip / part of ip]");

    format(g_player_listitem[playerid], 16, params);

 	player_mysql_page[playerid] = 0;

	return ShowPlayerFakeList(playerid);
}

stock ShowPlayerFakeList(playerid)
{
    new page = player_mysql_page[playerid];

	new ip_address[16];

	format(ip_address, 16, g_player_listitem[playerid]);

    format(format_string, 188, "SELECT `pName`, `pLevel`, `pIpReg`, `pIp`, `pDataReg`, `pOnline` FROM `accounts` WHERE `pIp` LIKE '%s%s%s' ORDER BY `pLevel` DESC LIMIT %i, 10", ("%"), ip_address, ("%"), page * 10);
	new Cache: result = mysql_query(mMysql, format_string, true);

	new rows = cache_num_rows();

	if(rows == 0) return SCM(playerid, COLOR_GREY, "Logies IP ditemukan tidak ditemukan.");

	command_text = "";

	new str[188], player_name[MAX_PLAYER_NAME], l_ip[16], r_ip[16], l_date[16], r_date[16], level;

	for(new i; i < rows; i++)
	{
	    cache_get_value_name_int(i, "pLevel", level);
        cache_get_value_name(i, "pName", player_name);

        cache_get_value_name(i, "pIp", l_ip);
        cache_get_value_name(i, "pIpReg", r_ip);

        cache_get_value_name(i, "pOnline", l_date);
        cache_get_value_name(i, "pDataReg", r_date);

		format(str, 188, "[%i] %s (L:%i)\t%s(%s)\t%s(%s)\n", i, player_name, level, l_ip, r_ip, l_date, r_date);
		strcat(command_text, str);
	}

	cache_delete(result);

	if(rows == 10) strcat(command_text, "[10] Hotel Di dekatnya\t\n");
	if(page != 0) strcat(command_text, "[11] Ulasan sebelumnya\t\n");

	format(format_string, 46, "IP: %s", ip_address);
	return SPD(playerid, 4319, DIALOG_STYLE_TABLIST, format_string, command_text, "Select", "Close");
}

CMD:alog(playerid, params[])
{
	if(admin_level[playerid] < 6) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/alog [name]");

    new sql_id = GetPlayerSqlIDByName(params);

	if(sql_id == INVALID_SQL_ID) return SCM(playerid, COLOR_GREY, "Seorang pemain dengan nama panggilan seperti itu belum ditemukan.");

    player_mysql_params[playerid] = sql_id;

 	player_mysql_page[playerid] = 0;

	return ShowPlayerAdminLog(playerid);
}

stock ShowPlayerAdminLog(playerid)
{
    new page = player_mysql_page[playerid];

    format(format_string, 144, "SELECT `action`, `date` FROM `admin_log` WHERE `user_id` = %i ORDER BY `date` DESC LIMIT %i, 10", player_mysql_params[playerid], page * 10);
	new Cache: result = mysql_query(mMysql, format_string, true);

	new rows = cache_num_rows();

	if(rows == 0) return SCM(playerid, COLOR_GREY, "Logies admin tidak ditemukan.");

	command_text = "";

	new str[188], action[144], data[24];

	for(new i; i < rows; i++)
	{
        cache_get_value_name(i, "action", action);
        cache_get_value_name(i, "date", data);

		format(str, 188, "[%i] %s\t%s\n", i, action, data);
		strcat(command_text, str);
	}

	SetPlayerUseListitem(playerid, rows);

	cache_delete(result);

	if(rows == 10) strcat(command_text, "[10] Hotel Di dekatnya\t\n");
	if(page != 0) strcat(command_text, "[11] Ulasan sebelumnya\t\n");

	return SPD(playerid, 4316, DIALOG_STYLE_TABLIST, "Daftar Hadiah", command_text, "Pilih", "Dekat");
}

CMD:lodgerleave(playerid)
{
	new h_id = GetPlayerHouseLodger(playerid);

	if(h_id == -1) return SCM(playerid, COLOR_GREY, "Anda tidak terdaftar di mana saja.");

	for(new i; i < MAX_HOUSE_LODGERS; i++)
	{
	    if(strfind(house_lodgers[h_id][i], GN(playerid), true) == -1) continue;

		format(house_lodgers[h_id][i], 6, "-");

		SaveHouseLodgers(h_id);

		break;
	}

	return SCM(playerid, COLOR_YELLOW, "Anda meninggalkan rumah sendiri.");
}

CMD:dice(playerid, params[])
{
    if(PlayerInfo[playerid][pLevel] < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari Level 2!");

	if(!PlayerToPoint(50.0, playerid, 1996.1062,1165.2214,994.8906) &&
	    !PlayerToPoint(50.0, playerid, 1130.4799,-1.7065,1000.6797)) return SCM(playerid, COLOR_GREY, "Anda tidak di kasino.");

	extract params -> new to_player, money; else return SCM(playerid, 0xCECECEFF, "Menggunakan: /dice [id pemain] [Jumlah]");

	if(!IsPlayerConnected(to_player) || to_player == playerid)
		return SendClientMessage(playerid, 0x999999FF, "Tidak ada pemain seperti itu");

	if(!ProxDetectorS(5.0, playerid, to_player))
		return SendClientMessage(playerid, 0x999999FF, "Pemain terlalu jauh");

    if(PlayerInfo[to_player][pLevel] < 2) return SCM(playerid, COLOR_GREY, "Pemain ini kurang dari Level 2!");

	if(!(1000 <= money <= 100000))
		return SendClientMessage(playerid, 0x999999FF, "Jumlah tidak boleh kurang dari 1.000 atau lebih dari $100,000");

	if(PlayerInfo[playerid][pCash] < money)
		return SendClientMessage(playerid, 0x999999FF, "Anda tidak memiliki jumlah uang");

	if(PlayerInfo[to_player][pCash] < money)
		return SendClientMessage(playerid, 0x999999FF, "Pemain tidak memiliki jumlah uang");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan masuk untuk pertukaran!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_DICE, money);

	SCMF(playerid, 0x6BB3FFAA, "Anda telah menawarkan %s untuk bermain dengan Anda dalam dadu. Tingkat: $%i", GetPlayerNameEx(to_player), money);
	SCMF(to_player, 0x6BB3FFAA, "%s menyarankan Anda bermain dadu. Tingkat: $%i", GetPlayerNameEx(playerid), money);

    return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}

CMD:demote(playerid, params[])
{
	if(PlayerInfo[playerid][pMember] != FRACTION_FBI && PlayerInfo[playerid][pMember] != FRACTION_MAYOR) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil organisasi!");

	new to_player, reason[64];

    if(sscanf(params,"us[64]", to_player, reason)) return SCM(playerid, COLOR_GREY, "/demote [id] [reason]");

    if(PlayerInfo[playerid][pMember] == FRACTION_FBI && !IsACop(to_player) && !IsAArmy(to_player)) return SCM(playerid, COLOR_GREY, "Hanya tersedia di Angkatan Darat dan DD.");

    if(PlayerInfo[playerid][pMember] == FRACTION_MAYOR && !IsACop(to_player) && !IsAArmy(to_player) && PlayerInfo[to_player][pMember] != FRACTION_FBI) return SCM(playerid, COLOR_GREY, "Hanya tersedia di Angkatan Darat, DD dan FBI");

    if(PlayerInfo[to_player][pRank] >= FracInfo[PlayerInfo[to_player][pMember]][fRankMax]-2) return Send(playerid,COLOR_GREY,"Pemain ini memiliki peringkat yang terlalu tinggi.");

    PlayerInfo[to_player][pRank] --;

	if(PlayerInfo[to_player][pRank] > 0)
	{
	    SCMF(playerid, -1, "Anda telah menurunkan peringkat %s ke %i.", GetPlayerNameEx(to_player), PlayerInfo[to_player][pRank], reason);
	    SCMF(to_player, -1, "%s telah menurunkan Anda ke peringkat %i.: %s: %s", GN(playerid), PlayerInfo[to_player][pRank], reason);
    }
    else
    {
        PlayerInfo[to_player][pLeader] = 0;
	    PlayerInfo[to_player][pMember] = 0;
	    PlayerInfo[to_player][pRank] = 0;
	    PlayerInfo[to_player][pfWarn] = 0;
		form_fraction[to_player] = 0;

		SavePlayerFraction(to_player);

		SetPlayerSkinEx(to_player, PlayerInfo[to_player][pSkin]);
		SetPlayerToTeamColor(to_player);

		SCMF(playerid, -1, "Anda telah dipecat dari organisasi %s.", GetPlayerNameEx(to_player), reason);
	    SCMF(to_player, -1, "%s memecat Anda dari organisasi. Pada saat: %s", GN(playerid), reason);
    }

    return SavePlayerFraction(to_player);
}

CMD:addnotify(playerid, params[])
{
	if(admin_level[playerid] < 6) return 1;

	if(sscanf(params,"p< >s[24]s[144]", params[0], params[1])) return SCM(playerid, COLOR_GREY, "/addnotify [name] [text]");

	new sql_id = GetPlayerSqlIDByName(params[0]);

	if(sql_id == INVALID_SQL_ID) return SCM(playerid, COLOR_GREY, "Seorang pemain dengan nama panggilan seperti itu belum ditemukan.");

	mysql_format(mMysql, format_string, 244, "INSERT INTO `notifications` (`user_id`, `text`) VALUES (%i,'%e');", sql_id, params[1]);
	mysql_tquery(mMysql, format_string);

	return SCMF(playerid, COLOR_GREEN, "Anda meninggalkan pesan untuk pemain %s dengan teks: {FFFFFF}%s", params[0], params[1]);
}

CMD:addcontac(playerid, params[]) {
	if(PlayerInfo[playerid][pProducts][1] == 0) return Send(playerid, COLOR_GREY, "Anda tidak memiliki buku telepon, Anda dapat membelinya di toko 24/7");
	format(String, 96, ""W"Masukkan nama buat kontak baru");
    SPD(playerid,DIALOG_NEW_CONTACT,DIALOG_STYLE_INPUT,"{a86cfc}Menambahkan kontak baru", String, "Tambah","Batalkan");
	return 1;
}

CMD:asellbiz(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/asellbiz [bizz id]");

	new b_id = strval(params);

	if(!(0 <= b_id <= MAX_BIZZ-1)) return SCMF(playerid, COLOR_GREY, "ID yang tersedia dari 0 ke %i", MAX_BIZZ - 1);

	BizzInfo[b_id][bOwned] = 0;

	SaveBizzPer(b_id, "bOwned", 0);

    UpdateBizzLabelText(b_id);

    return SCMF(playerid, -1, "Anda telah menjalankan bisnis dari %s[%i], pemilik: %s", BizzInfo[b_id][bMessage], b_id, BizzInfo[b_id][bOwner]);
}

CMD:bsetmafia(playerid, params[])
{
	if(admin_level[playerid] < 7) return 1;

	new b_id, mafia_id;

	if(sscanf(params,"ii", b_id, mafia_id)) return SCM(playerid, COLOR_GREY, "/bsetmafia [id] [mafia(10, 16, 17)]");

	if(!(0 <= b_id <= MAX_BIZZ-1)) return SCMF(playerid, COLOR_GREY, "ID yang tersedia dari 0 ke %i", MAX_BIZZ - 1);

	if(mafia_id != 10 && mafia_id != 16 && mafia_id != 17) return SCM(playerid, COLOR_GREY, "/bsetmafia [id] [mafia(10, 16, 17)]");

	BizzInfo[b_id][bMafia] = mafia_id;

	SaveBizzPer(b_id, "bMafia", mafia_id);

    UpdateBizzLabelText(b_id);

    return SCMF(playerid, -1, "Anda mengubah atap bisnis %s[%i]  Pada %s", BizzInfo[b_id][bMessage], b_id, GetFractionName(mafia_id));
}

CMD:asellfuelst(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;

    if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/asellfuelst [fuel id]");

	new a_id = strval(params);

	if(!(0 <= a_id <= MAX_aBIZZ-1)) return SCMF(playerid, COLOR_GREY, "ID yang tersedia dari 0 ke %i", MAX_aBIZZ - 1);

	BizzAInfo[a_id][aOwned] = 0;

	SaveABizzPer(a_id, "aOwned", 0);

	format(String, 244, "{0099FF}SPBU '%s'\n"W"Harga per liter: %d$\n\n{EBBD00}Pengisian bahan bakar kendaraan\nTidak: %d$\n{66CC00}/buyfuelst untuk membeli",BizzAInfo[a_id][aMessage], BizzAInfo[a_id][aPrice], BizzAInfo[a_id][aBuyPrice]);
	Update3DTextLabelText(BizzAInfo[a_id][aLabel], -1, String);

    return SCMF(playerid, -1, "Anda menjual bahan bakar %s[%i], pemilik: %s", BizzAInfo[a_id][aMessage], a_id, BizzAInfo[a_id][aOwner]);
}

CMD:asellhouse(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;

    if(!strlen(params)) return SCM(playerid, COLOR_GREY, "/asellhouse [house id]");

	new h_id = strval(params);

	if(!(0 <= h_id <= MAX_HOUSES-1)) return SCMF(playerid, COLOR_GREY, "ID yang tersedia dari 0 ke %i", MAX_HOUSES - 1);

	strmid(HouseInfo[h_id][hOwner], "None", 0, strlen("None"), 64);
    HouseInfo[h_id][hOwned] = 0;
	HouseInfo[h_id][hHel] = 0;
	HouseInfo[h_id][hLock] = 0;
	HouseInfo[h_id][hUpdAD] = 0;
	HouseInfo[h_id][hUpdHel] = 0;
	HouseInfo[h_id][hUpdSub] = 0;
	HouseInfo[h_id][hUpdStore] = 0;
	HouseInfo[h_id][hSlet] = 0;
	HouseInfo[h_id][hOplata] = 0;

	DestroyHouseStore(h_id);

	DestroyDynamic3DTextLabel(healtext[h_id]);
	if(HouseInfo[h_id][hAreaHeal] != 0) DestroyDynamicPickup(HouseInfo[h_id][hAreaHeal]);
	UpdatePickupHouse(h_id);
	SaveHouse(h_id);

    return SCMF(playerid, -1, "Anda menjual rumah #%i, pemilik: %s", h_id, HouseInfo[h_id][hOwner]);
}
CMD:asellhouseall(playerid)
{
	if(admin_level[playerid] < 12) return 1;

