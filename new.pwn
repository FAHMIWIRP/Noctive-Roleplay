			Neraca:\t\t%d$\n\
			Pendapatan hari ini:\t\t%d$\n\
			Bisnis disewa:\t%d\n\
			Input suara:\t\t%s\n\
			"W"Status:\t\t\t\t%s",
			i, BizzInfo[i][bMessage], BizzInfo[i][bOwner], GetTownName(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY]), GetAreaName(BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY]), GetMafiaName(BizzInfo[i][bMafia]), BizzInfo[i][bArenda], BizzInfo[i][bBuyPrice], BizzInfo[i][bEntranceCost], BizzInfo[i][bProducts], BizzInfo[i][bSklad],
			BizzInfo[i][bPrice], BizzInfo[i][bMoney], BizzInfo[i][bRaschet], BizzInfo[i][bOplata], text2, text1);

			if(BizzInfo[i][bSlet] > 0) format(tempstring,sizeof(tempstring),"\n\n{FFE569}Bisnis Anda dijelaskan dan dapat dijual ke negara bagian.."), strcat(String,tempstring);
			else strcat(String,"\n\n{99FF00}Untuk membuka dasbor bisnis Anda\nklik tombol 'Ubah''");
			SPD(playerid,53,DIALOG_STYLE_MSGBOX,"{CC9900}Informasi bisnis", String, "Edit", "Keluar");
		}
	}
	return 1;
}

stock IsVehicleOccupiedMode(vehicleid)
{
	foreach(new i : Player)
		if(IsPlayerInVehicle(i,vehicleid)) return i;
	return -1;
}
stock IsVehicleHaveFuel(carid)
{
	if(IsABicycle(carid)) return 1;

	switch(GetVehicleModel(carid)) { case 462, 488, 460: return 0; }

	return 1;
}
stock NoPerfomance(carid)
{
    switch(GetVehicleModel(carid)) { case 448, 461..463, 468, 521..523, 581, 587: return true; }

	return false;
}
stock CloseEngine(carid)// NO DVIG
{
    switch(GetVehicleModel(carid)) { case 460: return true; }

	return false;
}
epublic:CompVehDel(playerid)
{
    new cvp = player_spawn_car_slot[playerid]; // jangan dihapus
    CarInfo[playerid][cWheels][cvp] = 0;
    CarInfo[playerid][cSpoiler][cvp] = 0;
    CarInfo[playerid][cBumper1][cvp] = 0;
    CarInfo[playerid][cBumper2][cvp] = 0;
    CarInfo[playerid][cPaintJobs][cvp] = 255;
    CarInfo[playerid][cNitro][cvp] = 0;
    CarInfo[playerid][cHydrawlic][cvp] = 0;
    CarInfo[playerid][cHood][cvp] = 0;
    CarInfo[playerid][cRoof][cvp] = 0;
    CarInfo[playerid][cSideskirt][cvp] = 0;
    CarInfo[playerid][cLamps][cvp] = 0;
    CarInfo[playerid][cExhaust][cvp] = 0;
    CarInfo[playerid][cStereo][cvp] = 0;
    CarInfo[playerid][cVentRight][cvp] = 0;
    CarInfo[playerid][cVentLeft][cvp] = 0;
    return true;
}
epublic:CompVeh(playerid,vehicleid)
{
    new cvp = player_spawn_car_slot[playerid]; // jangan dihapus
    ChangeVehiclePaintjob(vehicleid,CarInfo[playerid][cPaintJobs][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cBumper1][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cBumper2][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cSpoiler][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cNitro][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cWheels][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cHydrawlic][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cHood][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cRoof][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cSideskirt][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cLamps][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cExhaust][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cStereo][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cVentRight][cvp]);
    AddVehicleComponent(vehicleid,CarInfo[playerid][cVentLeft][cvp]);
    SetVehicleNumberPlate(vehicleid, VehiclePlate[playerid][cvp]);
    CreateVehicleLabel(vehicleid, VehiclePlate[playerid][cvp], 0xFF7F00FF, 0.0, 0.0, 1.3, 20.0);
    return 1;
}

stock CreateVehicleLabel(vehicleid, text[], color, Float:x, Float:y, Float:z, Float:drawdistance)
{
    if(IsValidVehicle(vehicleid))
    {
        VehLabel[vehicleid] = CreateDynamic3DTextLabel(text, color, x, y, z, drawdistance, INVALID_PLAYER_ID, vehicleid);
    }
    return 1;
}
stock UpdateVehicleLabel(vehicleid, color, text[])
{
    if(IsValidVehicle(vehicleid))
    {
        if(IsValidDynamic3DTextLabel(VehLabel[vehicleid]))
        {
            UpdateDynamic3DTextLabelText(VehLabel[vehicleid], color, text);
        }
    }
    return 1;
}

stock DestroyVehicleLabel(vehicleid)
{
    if(IsValidVehicle(vehicleid))
    {
        if(IsValidDynamic3DTextLabel(VehLabel[vehicleid]))
        {
            DestroyDynamic3DTextLabel(VehLabel[vehicleid]);
        }
    }
    return 1;
}

stock DellTune(playerid)
{
	new p_car = GetPlayerVehicleID(playerid);
    RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_FRONT_BUMPER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_REAR_BUMPER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_SPOILER));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_NITRO));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_WHEELS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_HYDRAULICS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_HOOD));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_ROOF));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_SIDESKIRT));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_LAMPS));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_EXHAUST));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_STEREO));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_VENT_RIGHT));
	RemoveVehicleComponent(p_car,GetVehicleComponentInSlot(p_car, CARMODTYPE_VENT_LEFT));

	ChangeVehicleColor(p_car,CarInfo[playerid][cColor1][PlayerInfo[playerid][pUseCar]], CarInfo[playerid][cColor2][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cBumper1][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cBumper2][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cSpoiler][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cNitro][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cWheels][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cHydrawlic][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cHood][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cRoof][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cSideskirt][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cLamps][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cExhaust][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cStereo][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cVentRight][PlayerInfo[playerid][pUseCar]]);
	AddVehicleComponent(p_car,CarInfo[playerid][cVentLeft][PlayerInfo[playerid][pUseCar]]);
	return 1;
}
epublic: LightOff(playerid, vehicleid)
{
    GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
 	SetVehicleParamsEx(vehicleid, engine, !lights, alarm, doors, bonnet, boot, objective);
 	return 1;
}

stock VehiclePlayer(vehicleid)
{
	foreach(new i : Player) for(new x; x < MAX_PLAYER_VEHICLES; x++) if(player_home_car[i][x] == vehicleid) return i;

	return -1;
}
stock VehicleArendaPlayer(vehicleid)
{
	foreach(new i : Player) if(rent_job_vehicle[i] == vehicleid) return i;

	return -1;
