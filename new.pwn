CMD:dgarkot(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;
    if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Usage: /dgarkot [id garkot]");
	new file[128];
    IdGarkot[params[0]] = 0;
	GarkotInfo[params[0]][GposX] = 0.0;
	GarkotInfo[params[0]][GposY] = 0.0;
	GarkotInfo[params[0]][GposZ] = 0.0;
	GarkotInfo[params[0]][GposA] = 0.0;
	DestroyDynamicPickup(GarkotInfo[params[0]][GPickup]);
    DestroyDynamic3DTextLabel(GarkotInfo[params[0]][GLabel]);
    SendClientMessage(playerid, COLOR_WHITE, "Berhasil Menghapus Garkot");
    SaveGarkot();
	format(file, sizeof(file), "Garkot/%d.ini", params[0]);
	if(fexist(file)) fremove(file);
	return 1;
}
CMD:getidcard(playerid, params[])
{
    // Pengecekan apakah player sudah memiliki ID Card
    if(PlayerInfo[playerid][pKtp] != 0) 
        return ShowPanjulNotif(playerid, "Kamu Sudah Punya.");

    // Pengecekan Lokasi
    if(!IsPlayerInRangeOfPoint(playerid, 5, 498.3411,-2248.8833,790.0287)) 
        return ShowPanjulNotif(playerid, "Buat Di Balkot.");
    
    PlayerInfo[playerid][pCreatedID] = 1; 
    OnPlayerUpdateAccountsPer(playerid, "pCreatedID", PlayerInfo[playerid][pCreatedID]);
            
     for(new i = 0; i < 16; i++)
	{
        PlayerTextDrawShow(playerid, TDIDCARD[playerid][i]);
    }
    ShowPanjulNotif(playerid, "/hideidcard Untuk Menutup.");
    return 1;
}
CMD:hideidcard(playerid, params[])
{
   for(new i = 0; i < 16; i++)
	{
        PlayerTextDrawHide(playerid, TDIDCARD[playerid][i]);
    }
    return 1;
}
CMD:balikinktp(playerid, params[])
{
    extract params -> new to_player; else return SendClientMessage(playerid, -1, "/balikinktp [id pemain]");

    format(String, 188, "** %s Mengembalikan Ktp Kepada Orang Didepan",Name(playerid));
  	ProxDetector(20.0, playerid, String, COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE,COLOR_PURPLE);
    PlayerInfo[playerid][pKtp] -= 1;
	OnPlayerUpdateAccountsPer(playerid, "pKtp", PlayerInfo[playerid][pKtp]);
	PlayerInfo[to_player][pKtp] += 1;
	OnPlayerUpdateAccountsPer(to_player, "pKtp", PlayerInfo[to_player][pKtp]);
	SCM(playerid, COLOR_YELLOW, "Anda Telah Mengembalikan Ktp");
    return 1;
}
CMD:flare(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, a);

	if(IsValidDynamicObject(PlayerInfo[playerid][pFlare]))
		DestroyDynamicObject(PlayerInfo[playerid][pFlare]);

	PlayerInfo[playerid][pFlare] = CreateDynamicObject(18728, x, y, z-2.8, 0, 0, a-90);
    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.1,0,0,0,0,0);
	SCM(playerid, COLOR_RED, "Flare: request backup is actived! /hapusflare untuk menghapus flare.");

	format(format_string, 152, "[NOTIFIKASI] Petugas %s telah meminta bantuan di dekat (%s)", GetPlayerNameEx(playerid), GetLocation(x, y, z));
	SendFrac(FRACTION_LSPD, COLOR_YELLOW, format_string);
 	SendFrac(FRACTION_FBI, COLOR_BLUE, format_string);
  	SendFrac(FRACTION_SFPD, COLOR_YELLOW, format_string);
   	SendFrac(FRACTION_LVPD, COLOR_YELLOW, format_string);
    return 1;
}

CMD:hapusflare(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

	if(IsValidDynamicObject(PlayerInfo[playerid][pFlare]))
		DestroyDynamicObject(PlayerInfo[playerid][pFlare]);

    ApplyAnimation(playerid,"BOMBER","BOM_Plant",4.1,0,0,0,0,0);
	SCM(playerid, COLOR_YELLOW, "Server: Your flare is deleted.");
	return 1;
}

