                    AddVehicleComponent(GetPlayerVehicleID(otherid), 1008);
                    CarInfo[otherid][cNitro][UseCar(otherid)] = 1008;
                    SCMF(playerid, -1, "{FFFF00}TUNE: {FFFFFF}Kamu memasangkan komponen {33AAFF}%s %s", VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    SCMF(otherid, -1, "{FFFF00}TUNE: {FFFFFF}%s Telah memasangkan komponen {33AAFF}%s %s", Name(playerid), VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    pData[playerid][pComponent] -= 20;
                    OnPlayerUpdateAccountsPer(playerid, "pComponent", pData[playerid][pComponent]);
                    SaveCars(otherid);
                }
                case 1:
                {
                    new type = 1009;
                    AddVehicleComponent(GetPlayerVehicleID(otherid), 1009);
                    CarInfo[otherid][cNitro][UseCar(otherid)] = 1009;
                    SCMF(playerid, -1, "{FFFF00}TUNE: {FFFFFF}Kamu memasangkan komponen {33AAFF}%s %s", VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    SCMF(otherid, -1, "{FFFF00}TUNE: {FFFFFF}%s Telah memasangkan komponen {33AAFF}%s %s", Name(playerid), VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    pData[playerid][pComponent] -= 20;
                    OnPlayerUpdateAccountsPer(playerid, "pComponent", pData[playerid][pComponent]);
                    SaveCars(otherid);
                }
                case 2:
                {
                    new type = 1010;
                    AddVehicleComponent(GetPlayerVehicleID(otherid), 1010);
                    CarInfo[otherid][cNitro][UseCar(otherid)] = 1010;
                    SCMF(playerid, -1, "{FFFF00}TUNE: {FFFFFF}Kamu memasangkan komponen {33AAFF}%s %s", VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    SCMF(otherid, -1, "{FFFF00}TUNE: {FFFFFF}%s Telah memasangkan komponen {33AAFF}%s %s", Name(playerid), VehicleComponent[type-1000][cType],VehicleComponent[type-1000][cName]);
                    pData[playerid][pComponent] -= 20;
                    OnPlayerUpdateAccountsPer(playerid, "pComponent", pData[playerid][pComponent]);
                    SaveCars(otherid);
                }
            }
        }
