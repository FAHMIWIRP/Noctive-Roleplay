		    SetPlayerCheckpoint(playerid, -1088.1015,-1614.3225,76.3671, 5.0);
		    SendClientMessage(playerid, COLOR_YELLOW, "Mulai Bekerja Sebagai Petani Padi");
		}
		
		if(IsPlayerInRangeOfPoint(playerid, 1.0, -1097.0151,-1617.1059,76.3671))
		{
		    // Cek apakah pemain memiliki job Petani (Farmer)
		    if(PlayerInfo[playerid][pJobpadi] == 0) 
		        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki pekerjaan Petani Padi (Farmer)!");
		
		    // Pengecekan duty dipindah ke ATAS agar pemain tidak terkena cooldown jika belum bekerja
		    if(DutyGanjos[playerid] != 1) 
		        return SendClientMessage(playerid, COLOR_GREY, "Anda Tidak Bekerja Petani Padi");
		
		    // Cooldown diberikan SETELAH dipastikan pemain memang sedang bekerja
		    SetPVarInt(playerid, "pTimePetani", gettime() + 1800);
		    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
		    SendClientMessage(playerid, -1, "{ffff00}Anda Menyelesaikan Pekerjaan");
		    DisablePlayerCheckpoint(playerid);
		    
		    DutyGanjos[playerid] = 0;
		    CPGanjos[playerid] = 0;
		    BibitGanjos[playerid] = 0;
		    PanenGanjos[playerid] = 0;
		}
        if(IsPlayerInRangeOfPoint(playerid, 1.0, -1088.1015,-1614.3225,76.3671)){
            if(DutyGanjos[playerid] != 1) return 1;
            if(BibitGanjos[playerid] == 1) return 1;
            BibitGanjos[playerid] = 1;
            CPGanjos[playerid] = 1;
            SetPlayerAttachedObject(playerid, 5, 11745, 2,-0.499000,-0.208000,0.046999,114.800003,80.700042,-43.300064,0.666000,0.957000,0.828999);
            SetPlayerCheckpoint(playerid, -1073.1682,-1624.3367,76.3671, 1);
            SendClientMessage(playerid,COLOR_YELLOW, "Pergi Ke Tanda Merah Dipeta");
        }
        if(IsPlayerInRangeOfPoint(playerid, 1.0, -1116.1982,-1637.4880,76.3671)){
            if(pData[playerid][pPadi] > 100) return Error(playerid, "Maximal membawa 100 Padi.");
            if(DutyGanjos[playerid] != 1) return 1;
            if(PanenGanjos[playerid] == 0) return 1;
            RemovePlayerAttachedObject(playerid, 5);
            DisablePlayerCheckpoint(playerid);
            BibitGanjos[playerid] = 0;
            PanenGanjos[playerid] = 0;
            SetPlayerCheckpoint(playerid, -1088.1015,-1614.3225,76.3671, 3);
            new rand = RandomEx(10, 80);
            PlayerInfo[playerid][pPadi] += rand;
            OnPlayerUpdateAccountsPer(playerid, "pPadi", PlayerInfo[playerid][pPadi]);
            PlayerInfo[playerid][pThirst] -= 11;
            PlayerInfo[playerid][pSatiety] -= 9;
            PlayerInfo[playerid][pStress] += 3;
            format(String, sizeof(String), "Anda Mendapatkan %d Padi", rand);
            SendClientMessage(playerid,COLOR_YELLOW, String);
        }


