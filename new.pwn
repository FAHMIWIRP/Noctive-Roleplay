		{
		    // Cek apakah pemain memiliki job Miner
		    if(PlayerInfo[playerid][pJobminer] == 0) 
		        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki pekerjaan Penambang Emas (Miner)!");
		
		    // Cek apakah pemain sedang Duty
		    if(PlayerInfo[playerid][pDutynambang] == 0) 
		        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda belum memulai pekerjaan (Duty)!");
		
		    PlayerInfo[playerid][pDutynambang] = 0;
		    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
		    SetPVarInt(playerid, "GPS", 0);
		    ClearAnimations(playerid);
		    SendClientMessage(playerid, COLOR_YELLOW, "Anda Sudah Off Duty Kerja penambang");
		}
        if(IsPlayerInRangeOfPoint(playerid, 3.0, 700.753112, 897.196960, -37.445045) || IsPlayerInRangeOfPoint(playerid, 3.0, 699.648498, 887.328857, -37.498165) || IsPlayerInRangeOfPoint(playerid, 3.0, 700.008117, 892.716003, -38.445304))
