CMD:reviveall(playerid, params[])
{
    if(admin_level[playerid] < 1)
        return Info(playerid, "Anda Tidak Bisa Menggunakan Command Ini");

    foreach(new i : Player)
    {
        if(IsPlayerConnected(i))
        {
            if(PlayerInfo[i][pInjured] == 1)
            {
                update_int_mysql(i, "pInjured", 0);
                OnPlayerUpdateAccountsPer(i, "pInjured", 0);
                SetPlayerData(i, pInjured, 0);
                TogglePlayerControllable(i, 1);
                SetPlayerHealthEx(i, 100.0);
                ClearAnimations(i, 1);
                SetPlayerData(i, pDelayDeath, 0);
                update_int_mysql(i, "pDelayDeath", 0);
                format(String, 213, "Admin %s Telah Me Revive Semua Players", GetPlayerNameEx(playerid));
                PlayerTextDrawHide(i, DEATHTD[i][i]);
            }
        }
    }
    SendClientMessageToAll(COLOR_YELLOW, String);
    return 1;
}
CMD:setblood(playerid, params[])
{
	if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        SetPlayerHealth(i, 100);
    }
    SendClientMessageToAll(-1, "Semua darah player telah diubah oleh staff menjadi 100");
    return 1;
}

CMD:sethbeall(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	{
		new money;
		if(sscanf(params, "d", money)) return SendClientMessage(playerid, COLOR_WHITE, "USAGE: /sethbeall [amount]");

		foreach(Player, p)
		{
			PlayerInfo[p][pSatiety] = money;
			PlayerInfo[p][pThirst] = money;
			format(String, sizeof(String), "SERVER: {FFFFFF}Administrator %s telah mengubah status character kalian menjadi %d", PlayerInfo[playerid][pAname],money);
			SendClientMessage(p,COLOR_LIGHTBLUE,String);
		}
	}
	return 1;
}

epublic: DragUpdate(playerid, targetid)
{
    if(pData[targetid][pDragged] && pData[targetid][pDraggedBy] == playerid)
    {
        static
        Float:fX,
        Float:fY,
        Float:fZ,
        Float:fAngle;

        GetPlayerPos(playerid, fX, fY, fZ);
        GetPlayerFacingAngle(playerid, fAngle);

        fX -= 3.0 * floatsin(-fAngle, degrees);
        fY -= 3.0 * floatcos(-fAngle, degrees);

        SetPlayerPos(targetid, fX, fY, fZ);
        SetPlayerInterior(targetid, GetPlayerInterior(playerid));
        SetPlayerVirtualWorld(targetid, GetPlayerVirtualWorld(playerid));
        ApplyAnimation(targetid, "PED", "BIKE_fall_off", 4.1, 0, 1, 1, 1, 0, 1);
        //ApplyAnimation(targetid,"PED","WALK_civi",4.1,1,1,1,1,1);
    }
    return 1;
}
CMD:drag(playerid, params[])
{
    new otherid;
    if(sscanf(params, "u", otherid))
        return Info(playerid, "/drag [playerid/PartOfName] || /undrag [playerid]");

    if(otherid == INVALID_PLAYER_ID)
        return Error(playerid, "Player itu Disconnect.");

    if(otherid == playerid)
        return Error(playerid, "Kamu tidak bisa menarik diri mu sendiri.");

    if(!NearPlayer(playerid, otherid, 5.0))
        return Error(playerid, "Kamu harus didekat Player.");
        
    if(pData[otherid][pPrison] != 0)
        return Error(playerid, "kamu tidak bisa drag orang yang di penjara.");
        
    if(pData[otherid][pInjured] == 0)
        return Error(playerid, "kamu tidak bisa drag orang yang tidak mati.");
    SendPlayerOffer(playerid, otherid, OFFER_TYPE_DRAG);
    SetPVarInt(otherid, "DragBy", playerid);
    Servers(otherid, "%s Telah menawari drag kepada anda, /accept drag untuk menerimanya /deny drag untuk membatalkannya.", ReturnName(playerid));
    Servers(playerid, "Anda berhasil menawari drag kepada player %s", ReturnName(otherid));
    return 1;
}

CMD:undrag(playerid, params[])
{
    new otherid;
    if(sscanf(params, "u", otherid)) return Info(playerid, "/undrag [playerid]");
    if(pData[otherid][pDragged])
    {
        DeletePVar(playerid, "DragBy");
        DeletePVar(otherid, "DragBy");
        pData[otherid][pDragged] = 0;
        pData[otherid][pDraggedBy] = INVALID_PLAYER_ID;

        KillTimer(pData[otherid][pDragTimer]);
        format(String, 188, "** %s releases %s from their grip.", ReturnName(playerid), ReturnName(otherid));
        ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
    }
    return 1;
}
