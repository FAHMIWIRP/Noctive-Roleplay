					KickD(playerid, "Anda ditendang karena memasukkan password administratif yang salah berkali-kali.");
					format(String, sizeof(String), "~y~<ALogin> ~w~%s[%d], %d leave, was kicked for entering the wrong password.", Name(playerid), playerid, admin_level[playerid]);
    				SendAdminMessage(COLOR_RED, String);
					return 1;
				}
				ALogin(playerid);
				return 1;
			}

			Iter_Add(admin_list, playerid);

			admin_logged[playerid] = 1;

			if(admin_level[playerid] >= 0)
			{
				Info(playerid, "Anda login sebagai administrator {33AAFF}%s", DiiName(playerid));
			}
		}
		
  		case 9:
  		{
  		    if(!response) return 1;

  		    new i = GetPVarInt(playerid, "house_want_enter");

  		    if(GetPlayerHouse(playerid) == i || HouseInfo[i][hLock] == 0)
  		    {
  		        player_enter_home[playerid] = i;
  		        SetPlayerInterior(playerid,HouseInfo[i][hInt]);
		  		SetPlayerVirtualWorld(playerid,i);

  		        if(player_rob_id[playerid] != -1)
  		        {
  		            new rob_id = player_rob_id[playerid],
					  	h_id = rob_info[rob_id][r_house];

  		            if(h_id == i && rob_house_obj[h_id][0] == 0) CreateHouseRobObjects(h_id);
  		        }

  		        return PlayerEnterToHouse(playerid, i);
			}
			else GameTextForPlayer(playerid, "~r~Locked", 5000, 1);
		}
		case 13:
		{
		    if(!response) return Send(playerid, -1, "Anda telah menolak untuk membeli rumah.");

            new i = GetPVarInt(playerid, "house_want_enter");

			if(PlayerInfo[playerid][pLevel] < 3) return SCM(playerid, COLOR_GREY, "Tersedia dari level 3.");
            if(GetPlayerHouse(playerid) != -1) return Send(playerid, -1, "Anda sudah memiliki rumah, menjual rumah Anda untuk membeli yang baru.");
            if(GetPlayerHouseLodger(playerid) != -1) return SCM(playerid, COLOR_GREY, "Anda sudah terdaftar di suatu tempat, gunakan: /leavelodger");

         	if(HouseInfo[i][hOwned] != 0) return SCMF(playerid, -1, "Rumah ini sudah diambil oleh pemain %s", HouseInfo[i][hOwner]);

			if(HouseInfo[i][hKlass] == 5)
			{
				if(PlayerInfo[playerid][pRouble] < HouseInfo[i][hValue]) return Send(playerid,-1,"Anda tidak punya cukup uang untuk membeli rumah ini"), Send(playerid,-1,"Untuk membeli rumah VIP yang Anda butuhkan uang sungguhan, Anda dapat mengisi kembali akun Anda di situs web kami ISCOMMING");
				PlayerInfo[playerid][pRouble] -= HouseInfo[i][hValue];
				format(String, 24, "~y~-%d GOLD", HouseInfo[i][hValue]), GameTextForPlayer(playerid, String, 1500, 1);
			}
			else
			{
			    if(PlayerInfo[playerid][pCash] < HouseInfo[i][hValue]) return Send(playerid,-1,"Anda tidak punya cukup uang untuk membeli rumah ini");
			    GivePlayerMoneyEx(playerid, -HouseInfo[i][hValue], "membeli rumah");
			}

            strmid(HouseInfo[i][hOwner], Name(playerid), 0, strlen(Name(playerid)), 64);
		    HouseInfo[i][hOwned] = 1;
			HouseInfo[i][hHel] = 0;
			HouseInfo[i][hLock] = 0;
			HouseInfo[i][hUpdAD] = 0;
			HouseInfo[i][hUpdHel] = 0;
			HouseInfo[i][hUpdSub] = 0;
			HouseInfo[i][hUpdStore] = 0;
			HouseInfo[i][hSlet] = 0;
			HouseInfo[i][hOplata] = 5; // 5 day

			DestroyHouseStore(i);

			DestroyDynamic3DTextLabel(healtext[i]);
			if(HouseInfo[i][hAreaHeal] != 0) DestroyDynamicPickup(HouseInfo[i][hAreaHeal]);
			UpdatePickupHouse(i);
			SaveHouse(i);
			PlayerEnterToHouse(playerid, i);
			SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Informasi Rumah", ""W"Selamat! Anda telah berhasil membeli rumah!\n\nJangan lupa tentang pembayaran tepat waktu rumah Anda, saat ini rumah dibayar selama 5 hari,\ndalam kasus non-pembayaran layanan utilitas selama hari ini - rumah akan dijelaskan oleh negara.", "Saya melihat", "");
			SCMF(playerid, -1, "Anda telah berhasil membeli rumah (ID: %d). Gunakan {33CCFF}/home"W" untuk manajemen.", i);
			SCMF(playerid, -1, "gunakan /clemari untuk membeli lemari component dan Metall (harga 10.000$ Dolar).", i);
		}
		case 14:
		{
		    if(!response) return Send(playerid, -1, "Anda telah menolak untuk menjual rumah.");
			new i = GetPlayerHouse(playerid);

   			strmid(HouseInfo[i][hOwner], "None", 0, strlen("None"), 64);
		    HouseInfo[i][hOwned] = 0;
			HouseInfo[i][hHel] = 0;
			HouseInfo[i][hLock] = 0;
			HouseInfo[i][hUpdAD] = 0;
