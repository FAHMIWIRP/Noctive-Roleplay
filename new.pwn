	if(dialogid == 97) // Age
    {
        if(isnull(inputtext)) {
            return ShowPlayerDialog(playerid,97,DIALOG_STYLE_INPUT,"Umur","Berapa umurmu? (16 - 50)","Oke","Cancel");
        }
        else {
            new
                Age = strval(inputtext);

            if(Age >= 16 && Age <= 50)
            {
                new szMessage[128], hari[3];

                getdate(hari[0], hari[1], hari[2]);
                format(szMessage, sizeof(szMessage), "{00D9FF}[CHARACTER]{FFFFFF} Umur karakter berhasil diset: {FFD700}%d tahun{FFFFFF}. Lahir pada tahun {FFD700}%d{FFFFFF}.", Age, hari[0] - Age);
                SendClientMessage(playerid, COLOR_YELLOW, szMessage);
                PlayerInfo[playerid][pOrigin] = 0;
                PlayerInfo[playerid][pAge] = Age;
                OnPlayerUpdateAccountsPer(playerid, "pAge", PlayerInfo[playerid][pAge]);
                PlayerInfo[playerid][pTut] = 1;
                TogglePlayerControllable(playerid, 1);
				PlayerInfo[playerid][pKtp] += 1;
				OnPlayerUpdateAccountsPer(playerid, "pKtp", PlayerInfo[playerid][pKtp]);
				SCM(playerid, COLOR_YELLOW, "Anda Berhasil Membuat Idcard");
            }
            else
            {
                SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Umur karakter harus {FFD700}16 - 50 tahun{FFFFFF}!");
                return ShowPlayerDialog(playerid,97,DIALOG_STYLE_INPUT,"Umur","Berapa umurmu? (16 - 50)","Oke","Cancel");
            }
        }
    }
            


