				    new aktivh[4][32];
				    
				    // Menggunakan istilah "Terpasang" / "Belum Terpasang" dengan warna khas LRP
				    if(HouseInfo[i][hUpdAD] == 0) { aktivh[0] = "{E74C3C}Belum Terpasang"; } else { aktivh[0] = "{2ECC71}Terpasang"; }
				    if(HouseInfo[i][hUpdHel] == 0) { aktivh[1] = "{E74C3C}Belum Terpasang"; } else { aktivh[1] = "{2ECC71}Terpasang"; }
				    if(HouseInfo[i][hUpdSub] == 0) { aktivh[2] = "{E74C3C}Belum Terpasang"; } else { aktivh[2] = "{2ECC71}Terpasang"; }
