        format(szItem, sizeof(szItem), "Batu\t%d\n", PlayerInfo[targetid][pBatu]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pBatuk] > 0) {
        format(szItem, sizeof(szItem), "Batu Kotor\t%d\n", PlayerInfo[targetid][pBatuk]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pEmas] > 0) {
        format(szItem, sizeof(szItem), "Emas\t%d\n", PlayerInfo[targetid][pEmas]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pPadi] > 0) {
        format(szItem, sizeof(szItem), "Padi\t%d\n", PlayerInfo[targetid][pPadi]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pSemen] > 0) {
        format(szItem, sizeof(szItem), "Semen\t%d\n", PlayerInfo[targetid][pSemen]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pSeeds] > 0) {
        format(szItem, sizeof(szItem), "Seeds\t%d\n", PlayerInfo[targetid][pSeeds]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pPaddi] > 0) {
