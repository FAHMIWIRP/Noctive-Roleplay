}
stock MeAction(playerid,action[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return true;//PlayerMuted(playerid);
 	format(format_string, 144, "{DD90FF}%s: %s",Name(playerid), action);
	ProxDetector(20.0, playerid, format_string, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid,action,0xDD90FFAA,20.0,10000);
	return 1;
}
stock SetPlayerFaceToPoint(playerid, Float:X, Float:Y)
{
	new Float:angle;
	new Float:misc = 5.0;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	angle = 180.0-atan2(x-X,y-Y);
	angle += misc;
	misc *= -1;
	SetPlayerFacingAngle(playerid, angle+misc);
	return true;
}
stock GoPlayerAnimation(playerid, Float:X, Float:Y, Float:Z)
{
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(IsPlayerInRangeOfPoint(playerid, 2.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "IDLE_STANCE", 4.1, 0, 1, 1, 0, 0, 1);
		return 1;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 4.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "WALK_PLAYER", 4.1, 0, 1, 1, 0, 0, 1);
		return 2;
	}
	else if(IsPlayerInRangeOfPoint(playerid, 7.0, X, Y, Z))
	{
		ApplyAnimation(playerid, "PED", "RUN_GANG1", 4.1, 0, 1, 1, 0, 0, 1);
		return 3;
	}
	ApplyAnimation(playerid, "PED", "SPRINT_PANIC", 4.1, 0, 1, 1, 0, 0, 1);
	return 4;
}
stock ShiftCords(&Float:x, &Float:y,Float:a, Float:distance)
{
	x += (distance * floatsin(-a, degrees));
	y += (distance * floatcos(-a, degrees));
	return 1;
}

stock PlayerExitFromClothesShop(playerid)
{
    SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);

    TogglePlayerControllableEx(playerid, 1);

	new use_bizbar = player_use_bizbar[playerid];

	SetPVarInt(playerid, "next_area", gettime() + 3);

	t_SetPlayerPos(playerid, BizzInfo[use_bizbar][bBarX], BizzInfo[use_bizbar][bBarY], BizzInfo[use_bizbar][bBarZ]);
	SetPlayerInterior(playerid, BizzInfo[use_bizbar][bInterior]);
	SetPlayerVirtualWorld(playerid, BizzInfo[use_bizbar][bVirtualWorld]);

	SetCameraBehindPlayer(playerid);

    DeletePVar(playerid, "VibClothes");
	cskin[playerid] = -1;

	return 1;
}


epublic: PlayerStealFuelFromStation(playerid, fuel_id)
{
	if(player_fuel_steal[playerid] == 100)
	{
	    steal_timer[playerid] = -1;
	    ClearAnimations(playerid);

	    return SendClientMessage(playerid, COLOR_GREEN, "Anda telah melakukan pencurian bahan bakar..");
	}

	format(format_string, 32, "FUEL: %i/100", player_fuel_steal[playerid]);
	GameTextForPlayer(playerid, format_string, 3300, 4);

    SetPlayerFaceToPoint(playerid, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY]);

    ApplyAnimation(playerid,"INT_HOUSE","wash_up",4.0, 0, 0, 0, 0, 0,1);

	player_fuel_steal[playerid] += 5;

	return steal_timer[playerid] = SetTimerEx("PlayerStealFuelFromStation", 3000, false, "ii", playerid, fuel_id);
}
stock SetPlayerSchoolPoint(playerid)
{
	new road_id = player_road_id[playerid];

	new next_id = (road_id + 1) == sizeof school_road ? sizeof school_road - 1 : road_id + 1;

	SetPlayerRaceCheckpoint(playerid,
		road_id != next_id ? 0 : 1,
		school_road[road_id][0],
		school_road[road_id][1],
		school_road[road_id][2] - 1.0,
		school_road[next_id][0],
		school_road[next_id][1],
		school_road[next_id][2],
		3.0);
}
stock GetNearestRadar(areaid)
{
	for(new i=0;i<MAX_RADARS;i++)
	{
		if(areaid == radar_info[i][radar_area]) return i;
	}
	return -1;
}

stock OnPlayerFinishRoll(playerid,item)
{
	new save_amount = -1;

    switch(item)
	{
        case 0:
		{
            new amount = 1 + random(3);
            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}%d Exp.",amount);

            save_amount = amount;
        }
        case 1:
		{
            new amount = 3 + random(5);
            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}%d taat hukum.",amount);

            save_amount = amount;
        }
        case 2:
		{
            new amount = 30000 + random(40000);

            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}%d$.", amount);

            save_amount = amount;
        }
        case 3:
		{
		    new amount = 30 + random(20);

            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}%d donasi Gold.", amount);

			save_amount = amount;
        }
        case 4:
		{
            save_amount = RULETCarsClassic[random(sizeof(RULETCarsClassic))];

            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}transport: %s", VehicleNames[ save_amount - 400 ]);
        }
        case 5:
		{
			new amount = 3 + random(27);

            SCMF(playerid,0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500}%d Hadiah VIP.", amount);

            save_amount = amount;
        }
        case 6:
		{
		    save_amount = RULETSkinsClassic[random(sizeof(RULETSkinsClassic))];

            SCMF(playerid, 0x2eb0ffaa, "Selamat! Anda memenangkan {FF4500} skin: %d.", save_amount);
        }
    }
    Send(playerid, 0x00FF00ff, "? [Petunjuk]: "W"Gunakan perintah: {a86cfc}/priz"W" untuk melihat / mengambil hadiah Anda");

    format(format_string, 144, "INSERT INTO `roulet_prizes` (`user_id`,`item_id`,`amount`) VALUES (%i,%i,%i)", GetPlayerAccountID(playerid), item, save_amount);
    mysql_tquery(mMysql, format_string);

    return true;
}
stock StartRulet(playerid)
{
	RollReplace[playerid] = 50+random(50);
	RollItem[playerid] = 0;

	new prize_id = -1;

	switch(random(100))
	{
	    case 0..19: prize_id = 0;
	    case 20..39: prize_id = 1;
	    case 40..54: prize_id = 2;
	    case 55..59: prize_id = 3;
	    case 60..69: prize_id = 4;
	    case 70..84: prize_id = 5;
	    case 85..99: prize_id = 6;
	}

	SetPVarInt(playerid, "roulet_prize_id", prize_id);

	UPDRulet(playerid);
}

stock RuletGiveCar(playerid,slot,model)
{
	new price = GetVehicleShopPrice(model);

	SCMF(playerid, -1, "Anda telah memenangkan mobil %s yang dimenangkan dalam slot %d.", VehicleNames[model-400],slot+1);
	strmid(VehicleNumberPlate[playerid][slot],"None", 0, strlen("None"), 9);
	CarInfo[playerid][cSost][slot] = 100;
	CarInfo[playerid][cFuel][slot] = float(100);
	CarInfo[playerid][cColor1][slot] = 1;
	CarInfo[playerid][cColor2][slot] = 1;
	CarInfo[playerid][cPaintJobs][slot] = 255;
	CarInfo[playerid][cLock][slot] = 0;
	CarInfo[playerid][cProbeg][slot] = float(0);
	CarInfo[playerid][cHeal][slot] = float(1000);
	CarInfo[playerid][cDamagePanel][slot] = 0;
	CarInfo[playerid][cDamageDoors][slot] = 0;
	CarInfo[playerid][cDamageLights][slot] = 0;
	CarInfo[playerid][cDamageTires][slot] = 0;
	CarInfo[playerid][cModel][slot] = model;

	new rand = random(sizeof default_park_pos);

    player_car_park[playerid][slot][0] = default_park_pos[rand][0];
    player_car_park[playerid][slot][1] = default_park_pos[rand][1];
    player_car_park[playerid][slot][2] = default_park_pos[rand][2];
    player_car_park[playerid][slot][3] = 0.0;

	for(new i; i < 5; i++) player_engine_tune[playerid][slot][i] = player_brake_tune[playerid][slot][i] = 0;

	SavePlayerPerfomanceTune(playerid);

	CarInfo[playerid][cCost][slot] = price;

	CompVehDel(playerid);
	LoadMyCar(playerid, slot);
	SaveCars(playerid);

	return 1;
}
forward UPDRulet(playerid);
public UPDRulet(playerid)
{
	if(!IsPlayerConnected(playerid)) return false;
	new string[120+(sizeof(RULETPrizes)*12)];
	strcat(string,"\t{FFFFFF}Hadiah Anda:\n");
	for(new i, z = sizeof(RULETPrizes); i < z; i++){
		strcat(string,"\n");
		strcat(string,(RollItem[playerid] == i)?("{a86cfc}"):("{ffffff}"));
		strcat(string,"\t\t");
		strcat(string,RULETPrizes[i]);
	}
	ShowPlayerDialog(playerid, ROLL_DIALOG, DIALOG_STYLE_MSGBOX, "Roulette scrolling", string, "Ok", "");
	if(RollReplace[playerid] > 0 || GetPVarInt(playerid, "roulet_prize_id") != RollItem[playerid])
	{
		RollItem[playerid]++;
		if(RollItem[playerid] >= sizeof(RULETPrizes)) RollItem[playerid] = 0;
		RollReplace[playerid]--;
		SetTimerEx("UPDRulet", (500+(-RollReplace[playerid]*ROLL_TIMER))>25?500+(-RollReplace[playerid]*ROLL_TIMER):25, false, "i", playerid);
		return true;
	}
	return OnPlayerFinishRoll(playerid,RollItem[playerid]);

}

stock update_int_mysql(playerid, column[], value)
{
	new query[256];
	mysql_format(mMysql, query, sizeof query, "UPDATE accounts SET %s = '%d' WHERE pID = '%d' LIMIT 1", column, value, PlayerInfo[playerid][pID]);
	mysql_query(mMysql, query);
	return true;
}

stock GetGangZoneColor(g_id)
{
	new zx;

	switch(GZInfo[g_id][gFraction])
	{
		case FRACTION_BALLAS: zx = 0xCC00FFAA;
		case FRACTION_VAGOS: zx = 0xffcd00AA;
		case FRACTION_GROVE: zx = 0x009900AA;
		case FRACTION_AZTEC: zx = 0x00b4e1AA;
		case FRACTION_RIFA: zx = 0x6666ffAA;
		default: zx = 0xFEFEFEAA;
	}

	return zx;
}

stock GetFractionMemberAmount(bandid)
{
	new np;
	foreach (new i : Player) if(PlayerInfo[i][pMember] == bandid) np++;

	return np;
}

stock PlayerToKvadrat(playerid,Float:min_x,Float:min_y,Float:max_x,Float:max_y)
{
	new Float:xxp,Float:yyp,Float:zzp;
	GetPlayerPos(playerid, xxp, yyp, zzp);
	if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return true;
	return false;
}

stock IsGangInWar(gang_id)
{
	foreach(new i : capture_zone_list)
	{
		if(GZInfo[i][gFraction] == gang_id) return true;
		if(GZInfo[i][gAttack] == gang_id) return true;
	}

	return false;
}

stock PlayerEnterToBoneTable(playerid, table_id)
{
    if(player_croupier_job{playerid} == 1)
    {
		if(IsBoneTableHaveCroupie(table_id) != INVALID_PLAYER_ID) return Send(playerid, COLOR_GREY, "Sudah ada dealer di meja.");

        for(new x; x < 7; x++) TextDrawShowForPlayer(playerid, bones_global_td[x]);
    	for(new x; x < 2; x++) TextDrawShowForPlayer(playerid, bones_table_td[table_id][x]);

        SelectTextDraw(playerid, COLOR_WHITE);

        player_bone_table[playerid] = table_id;

    	return TogglePlayerControllable(playerid, false);
    }

	for(new i; i < 4; i++)
	{
	    if(bones_table_players[table_id][i] != INVALID_PLAYER_ID) continue;

	    player_bone_table[playerid] = table_id;
    	player_bone_slot[playerid] = i;

    	bones_table_players[table_id][i] = playerid;
    	bones_player_bet[table_id][i] = false;

    	for(new x; x < 7; x++) TextDrawShowForPlayer(playerid, bones_global_td[x]);
    	for(new x; x < 2; x++) TextDrawShowForPlayer(playerid, bones_table_td[table_id][x]);

		if(!player_croupier_job{playerid}) TextDrawHideForPlayer(playerid, bones_global_td[6]);

    	SelectTextDraw(playerid, COLOR_WHITE);

    	return TogglePlayerControllable(playerid, false);
	}

	return Send(playerid, COLOR_GREY, "Tidak ada kursi kosong di meja.");
}

stock PlayerLeaveBoneTable(playerid)
{
    new table_id = player_bone_table[playerid];
    new slot_id = player_bone_slot[playerid];

    if(table_id == -1) return 0;

    if(player_croupier_job{playerid} == 0)
    {
	    if(bones_table_state[table_id] != 0 && bones_player_bet[table_id][slot_id] == true) return Send(playerid, COLOR_GREY, "Permainan telah dimulai, Anda tidak dapat membatalkan taruhan.");

		if(bones_player_bet[table_id][slot_id] == true)
		{
		    GivePlayerMoneyEx(playerid, bones_table_bet[table_id], "win at the casino");

			bones_player_bet[table_id][slot_id] = false;
		}

	    bones_table_players[table_id][slot_id] = INVALID_PLAYER_ID;
	}

    for(new i; i < 7; i++) TextDrawHideForPlayer(playerid, bones_global_td[i]);
    for(new i; i < 2; i++) TextDrawHideForPlayer(playerid, bones_table_td[table_id][i]);

    CancelSelectTextDraw(playerid);

	TogglePlayerControllable(playerid, true);

	player_bone_table[playerid] = -1;
	player_bone_slot[playerid] = -1;

	return 1;
}

stock IsBoneTableHaveCroupie(table_id)
{
    foreach(Player, i) if(player_croupier_job{i} == 1 && player_bone_table[i] == table_id) return i;

    return INVALID_PLAYER_ID;
}

stock GetBoneTableAmountBet(table_id)
{
	new players = 0;

    for(new i; i < 4; i++)
	{
	    if(bones_table_players[table_id][i] == INVALID_PLAYER_ID) continue;
	    if(bones_player_bet[table_id][i] == true) players++;
	}

	return players;
}

stock SendBoneTableMessage(table_id, text[])
{
	foreach(Player, i) if(player_bone_table[i] == table_id) Send(i, 0xDD90FFFF, text);

	return 1;
}
stock CheckPlayerFlood(playerid, bool:inc = true, max_rate = MAX_FLOOD_RATE, rate_inc = FLOOD_RATE_INC, kick_rate = FLOOD_RATE_KICK)
{
	new tick = GetTickCount();

	AddPlayerAntiFloodData(playerid, AF_RATE, +, inc ? rate_inc : 0);
	AddPlayerAntiFloodData(playerid, AF_RATE, -, (GetTickCount() - GetPlayerAntiFloodData(playerid, AF_LAST_TICK)));
	SetPlayerAntiFloodData(playerid, AF_LAST_TICK, tick);

	if(GetPlayerAntiFloodData(playerid, AF_RATE) < 0)
		SetPlayerAntiFloodData(playerid, AF_RATE, 0);

	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= max_rate)
	{
		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= kick_rate)
		{
			//KickD(playerid, "Kamu ditendang karena banyak bacot.");
		}
		return 1;
	}
	return 0;
}

stock StartRace()
{
    race_state = 1;
    race_time = 301;

    race_finish_id = 0;
}

stock UpdatePlayerRaceMark(playerid)
{
    new mark_id = player_race_mark[playerid];
    if(mark_id >= sizeof(race_mark_pos)) return false;
	new Float: x = race_mark_pos[mark_id][0],
		Float: y = race_mark_pos[mark_id][1],
		Float: z = race_mark_pos[mark_id][2],
		Float: x2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][0] : 0.0,
		Float: y2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][1] : 0.0,
		Float: z2 = mark_id != sizeof race_mark_pos - 1 ? race_mark_pos[mark_id+1][2] : 0.0;

    //SCMF(playerid, -1, "%i(%i) %f %f %f %f %f %f", mark_id, sizeof race_mark_pos, x, y, z, x2, y2, z2);

	SetPlayerRaceCheckpoint(playerid, mark_id != sizeof race_mark_pos - 1 ? 0 : 1, x, y, z, x2, y2, z2, 5.0);
	return true;
}

stock PlayerLeaveRace(playerid)
{
	player_race_reg{playerid} = 0;

	DisablePlayerRaceCheckpoint(playerid);

	if(player_race_vehicle[playerid] != INVALID_VEHICLE_ID) DestroyVehicle(player_race_vehicle[playerid]);
    player_race_vehicle[playerid] = INVALID_VEHICLE_ID;
}

