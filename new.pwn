stock KickD(playerid, message[])
{
	if(strlen(message) > 0) SendClientMessage(playerid, COLOR_LIGHTRED, message);
	SetTimerEx("KickPublic", 200, false, "d", playerid);
	return true;
}
stock MymMysqlonnect()
