cmd:setgold(playerid, params[])
{
	if(admin_level[playerid] < 50 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /setdonate [playerid] [value]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini di AFK");
	PlayerInfo[params[0]][pRouble] += params[1];
    OnPlayerUpdateAccountsPer(params[0], "pRouble", PlayerInfo[params[0]][pRouble]);
	SCMF(playerid,-1,"Anda telah berhasil dikreditkan %s[%i] Gold nyata total: %i",Name(params[0]),params[0],params[1]);
	SCMF(params[0],-1,"Administrator %s[%i] memberimu %i Gold",Name(playerid),playerid,params[1]);
	return true;
}

CMD:setweather(playerid, params[])
{
	if(admin_level[playerid] < 3) return 1;

	extract params -> new weather; else return SendClientMessage(playerid, 0xCECECEFF, "Gunakan: /setweather [cuaca (0-20)]");
	if(!(-1 <= weather <= 20))
	{
		SendClientMessage(playerid, 0xCECECEFF, "Cuaca 0 hingga 20 (-1 - perubahan cuaca acak)");
		SendClientMessage(playerid, 0xCECECEFF, "Direkomendasikan oleh: 1, 3, 8, 9, 18");

		return 1;
	}

	if(weather != -1)
		SetWeather(weather);

	new fmt_text[70];

	if(weather != -1)
		format(fmt_text, sizeof fmt_text, "Anda mengatur cuaca %d", weather);
	else
		format(fmt_text, sizeof fmt_text, "Anda mengatur cuaca acak");

	SendClientMessage(playerid, -1, fmt_text);

 	if(admin_level[playerid] < 1) return 1;
	{
		if(weather != -1)
			format(fmt_text, sizeof fmt_text, "[A] %s[%d] atur cuaca di server ke %d", GetPlayerNameEx(playerid), playerid, weather);
		else
			format(fmt_text, sizeof fmt_text, "[A] %s[%d] atur cuaca acak di server", GetPlayerNameEx(playerid), playerid);

		SendClientMessageToAll(0xCECECEFF, fmt_text);
	}
	format(fmt_text, sizeof fmt_text, "Atur cuaca %d di server", weather);
	return 1;
}
stock ProxDetectorx(Float:radi, playerid, string[], color)
{
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x,y,z);
	foreach(Player, i)
	{
	    if(IsPlayerInRangeOfPoint(i,radi,x,y,z))
	    {
	        SendClientMessage(i,color,string);
	    }
	}
}
CMD:setlevel(playerid, params[])
{
	if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return Send(playerid, -1, "Masuk: /setlevel [playerid] [Level]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain ini di AFK");
	PlayerInfo[params[0]][pLevel] += params[1];
    OnPlayerUpdateAccountsPer(params[0], "pLevel", PlayerInfo[params[0]][pLevel]);
	SCMF(playerid,-1,"Anda telah berhasil dikreditkan %s[%i] Level nyata total: %i",Name(params[0]),params[0],params[1]);
	SCMF(params[0],-1,"Administrator %s[%i] memberimu %i Level",Name(playerid),playerid,params[1]);
	return true;
}
CMD:promo(playerid)
{
    if(admin_level[playerid] < 8 && strfind(GN(playerid), "Robert_Pattinson") == -1) return 1;

    new Cache: result = mysql_query(mMysql, "SELECT * FROM `promocodes` WHERE 1");

    new rows = cache_num_rows();

    String = "";

	new str[64], count = 0;

    new sql_id, code[32], reward, amount;

    for(new i; i < rows; i++)
    {
        cache_get_value_int(i, "id", sql_id);
        cache_get_value(i, "code", code);
        cache_get_value_int(i, "reward", reward);
        cache_get_value_int(i, "amount", amount);

        format(str, 64, "%i. %s\t$%i\t%i\n", i + 1, code, reward, amount);
        strcat(String, str);

        SetPlayerListitemValue(playerid, count++, sql_id);
    }

    cache_delete(result);

    return SPD(playerid, 3288, DIALOG_STYLE_TABLIST, "Daftar Kode Promo", String, "Pilih", "Tutup");
}

CMD:createpromo(playerid, params[])
{
    if(admin_level[playerid] < 8 && strfind(GN(playerid), "Robert_Pattinson") == -1) return 1;

	if(sscanf(params, "is[64]", params[0], params[1])) return Send(playerid, -1, "Masuk: /createpromo [jumlahnya] [kode]");

	mysql_format(mMysql, format_string, 128, "SELECT * FROM `promocodes` WHERE `code` = '%e'", params[1]);
	new Cache: result = mysql_query(mMysql, format_string, true);

	if(cache_num_rows() != 0) return SendClientMessage(playerid, COLOR_GREY, "Kode promosi ini telah dibuat.!");

	cache_delete(result);

	format(format_string, 128, "INSERT INTO `promocodes` (`code`,`reward`) VALUES ('%s',%i)", params[1], params[0]);
	mysql_tquery(mMysql, format_string);

	return SCMF(playerid, COLOR_GREEN, "Anda telah berhasil membuat kode promosi %s, hadiah: $%i", params[1], params[0]);
}

CMD:clothes(playerid, params[])
{
    new i = player_use_bizbar[playerid];
    if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 6 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return SCMF(playerid, COLOR_GREY, "Toko pakaian %s tidak bekerja!", BizzInfo[i][bMessage]);
		SPD(playerid, 125, DIALOG_STYLE_MSGBOX, "Ruang pas", ""W"Apa yang ingin Anda coba?", "Pakaian", "Berubah pikiran");
	}
	return 1;
}

CMD:next(playerid)
{
	if(GetPVarInt(playerid, "VibClothes") == 0) return 1;

	new sex = PlayerInfo[playerid][pSex];

    player_choose_skin[playerid]++;

	if(sex == 1 && player_choose_skin[playerid] >= sizeof SkinMan) player_choose_skin[playerid] = 0;
	if(sex == 2 && player_choose_skin[playerid] >= sizeof SkinMale) player_choose_skin[playerid] = 0;

	new choose_id = player_choose_skin[playerid];

	new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

	SetPlayerSkin(playerid, gSkins[s_id][skinID]);

	return 1;
}

CMD:back(playerid)
{
    if(GetPVarInt(playerid, "VibClothes") == 0) return 1;

    new sex = PlayerInfo[playerid][pSex];

    player_choose_skin[playerid]--;

	if(player_choose_skin[playerid] <= -1) player_choose_skin[playerid] = (sex == 1 ? sizeof SkinMan  : sizeof SkinMale) - 1;

	new choose_id = player_choose_skin[playerid];

	new s_id = sex == 1 ? SkinMan[choose_id] : SkinMale[choose_id];

	SetPlayerSkin(playerid, gSkins[s_id][skinID]);

	return 1;
}

CMD:hshbsbs(playerid)
{
    if(PlayerInfo[playerid][pMember] != 7) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya.");

	if(player_fuel_steal[playerid] == 100) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak dapat mengambil lebih banyak bahan bakar.");

	if(steal_timer[playerid] != -1) return SendClientMessage(playerid, COLOR_GREY, "Anda sudah merampok sebuah pompa bensin.");

	for(new i; i < MAX_aBIZZ; i++)
	{
	    if(GetPlayerDistanceFromPoint(playerid, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ]) > 3.5) continue;
	    if(BizzAInfo[i][aGangAttack] != PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREY, "Geng Anda tidak menyerang pompa bensin ini.");
	    if(BizzAInfo[i][aGangAttackState] != 2) return SendClientMessage(playerid, COLOR_GREY, "Waktu persiapan belum berakhir.");

	    steal_timer[playerid] = -1;

		PlayerStealFuelFromStation(playerid, i);

		SetPlayerAttachedObject(playerid, 3, 1650, 6, 0.1179, 0.0150, 0.0719, 0.0000, -102.2999, 0.0999, 1.0000, 1.0000, 1.0000);

		return SendClientMessage(playerid, COLOR_GREEN, "Anda mulai banyak gas dari pompa bensin!");
	}

	return SendClientMessage(playerid, COLOR_GREY, "Tidak ada pompa bensin di dekat Anda.");
}

CMD:azspos(playerid)
{
	new member = PlayerInfo[playerid][pMember];

    if(member != 7) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak dapat menggunakan ini.");

	for(new i; i < MAX_aBIZZ; i++)
	{
	    if(member != BizzAInfo[i][aGangAttack]) continue;

	    SetPlayerCheckpoint(playerid, BizzAInfo[i][aAreaFillX], BizzAInfo[i][aAreaFillY], BizzAInfo[i][aAreaFillZ], 3);
		PlayerPlaySound(playerid, 1139, 0.0, 0.0, 0.0);

     	SetPVarInt(playerid, "GPS", 1);

		return SCMF(playerid, COLOR_GREEN, "SPBU %s[%i] ditandai di peta.", BizzAInfo[i][aMessage], i);
	}

	return SendClientMessage(playerid, COLOR_GREY, "Geng Anda tidak menyerang pompa bensin mana pun!");
}

CMD:azswar(playerid)
{
	new member = PlayerInfo[playerid][pMember];

	if(fraction_steal_block != 0) return SCMF(playerid, COLOR_GREY, "Akan tersedia melalui %i detik.", fraction_steal_block);

	if(member != 7) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya.");

	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil pemimpin");// return SCMF(playerid, COLOR_GREY, "Tersedia %i+ jajaran.", FracInfo[member][fRankMax] - 2);

	new players = 0;

	foreach(Player, i) if(PlayerInfo[i][pMember] == member) players++;

	if(players < 5) return SendClientMessage(playerid, COLOR_GREY, "Dalam sepersekian kurang dari 5 orang.");

	new try_id = 0;

	SEARCH_ABIZZ:

	new fuel_id = random(TotalABizz);

	try_id++;

	if(try_id == 1000) return SCM(playerid, COLOR_GREY, "Tidak dapat menemukan pom bensin.");

	if(BizzAInfo[fuel_id][aGangAttack] != 0) goto SEARCH_ABIZZ;

	format(format_string, 144, "Klub Biker menyerang pompa bensin #%s[%i]. Gunakan: /azspos untuk tanda", BizzAInfo[fuel_id][aMessage], fuel_id);
	SendFrac(member, 0x42B66FFF, format_string);
    SendFrac(member, 0x42B66FFF, "Apakah kamu punya {FFFFFF}dua{42B66F} menit untuk persiapan.");

	BizzAInfo[fuel_id][aGangAttack] = member;
	BizzAInfo[fuel_id][aGangAttackState] = 1;
	BizzAInfo[fuel_id][aGangAttackTime] = 120;
	fraction_steal_block = 7200;

	return SetTimerEx("CheckFuelAttack", 1000, false, "i", fuel_id);
}

epublic: CheckFuelAttack(fuel_id)
{
	new gang_attack = BizzAInfo[fuel_id][aGangAttack];

	if(BizzAInfo[fuel_id][aGangAttackTime] != 0) BizzAInfo[fuel_id][aGangAttackTime]--;

	//format(format_string, 96, "%i %i %i %i", fuel_id, BizzAInfo[fuel_id][aGangAttackState], BizzAInfo[fuel_id][aGangAttack], BizzAInfo[fuel_id][aGangAttackTime]);
	//SendClientMessageToAll(-1, format_string);

	if(BizzAInfo[fuel_id][aGangAttackState] == 1)
	{
	    new string[48];
	    format(string, 48, "TIME: %i", BizzAInfo[fuel_id][aGangAttackTime]);
		foreach(Player, i) if(PlayerInfo[i][pMember] == gang_attack) GameTextForPlayer(i, string, 1500, 4);

		if(BizzAInfo[fuel_id][aGangAttackTime] == 0)
		{
		    new players = 0;

			foreach(Player, i) if(PlayerInfo[i][pMember] == gang_attack && GetPlayerDistanceFromPoint(i, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY], BizzAInfo[fuel_id][aAreaFillZ]) < 60.0) players++;

			if(players < 1)
			{
			    BizzAInfo[fuel_id][aGangAttack] = 0;

				format(format_string, 144, "Serangan di pompa bensin dihentikan, tidak ada yang tiba di wilayahnya.");
			    return SendFrac(gang_attack, 0x42B66FFF, format_string);
			}

			BizzAInfo[fuel_id][aGangAttackState] = 2;
		}
	}
	else if(BizzAInfo[fuel_id][aGangAttackState] == 2)
	{
	    new players = 0;

		foreach(Player, i) if(PlayerInfo[i][pMember] == gang_attack && GetPlayerDistanceFromPoint(i, BizzAInfo[fuel_id][aAreaFillX], BizzAInfo[fuel_id][aAreaFillY], BizzAInfo[fuel_id][aAreaFillZ]) < 60.0) players++;

		if(players == 0)
		{
		    BizzAInfo[fuel_id][aGangAttack] = 0;

			format(format_string, 144, "Semua anggota geng meninggalkan pompa bensin, serangan berhenti.");
		    return SendFrac(gang_attack, 0x42B66FFF, format_string);
		}
	}

    return SetTimerEx("CheckFuelAttack", 1000, false, "i", fuel_id);
}

CMD:hsbbsbs(playerid, params[])
{
	if(!IsAMafia(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-2) return SCM(playerid, COLOR_GREY, "Peringkat Anda kecil.");

    if(!strlen(params))
	{
		Send(playerid, -1, "/bizwar [place(0-2]");
		Send(playerid, COLOR_GREY, "0 - Desa terbengkalai");
		Send(playerid, COLOR_GREY, "1 - Reruntuhan");
		Send(playerid, COLOR_GREY, "2 - Pelabuhan");
		return 1;
	}

	new place_id = strval(params);

	new attack_id = PlayerInfo[playerid][pMember];

	if(BW_INFO[bw_attack] != 0) return SCM(playerid, COLOR_GREY, "Perang untuk bisnis sudah dimulai.");

	for(new i; i < MAX_BIZZ; i++)
	{
		if(!PlayerToPoint(15.0, playerid, BizzInfo[i][bEntranceX], BizzInfo[i][bEntranceY], BizzInfo[i][bEntranceZ])) continue;

		new owner_id = BizzInfo[i][bMafia];

		if(owner_id == 0)
		{
		    BizzInfo[i][bMafia] = attack_id;

            SaveBizzPer(i, "bMafia", attack_id);

            UpdateBizzLabelText(i);

			return SCM(playerid, COLOR_BLUE, "Bisnis itu tidak memiliki atap, Anda mengendalikannya.");
		}

		if(owner_id == attack_id) return SCM(playerid, COLOR_GREY, "Anda sudah menutupi bisnis ini.");

		BW_INFO[bw_attack] = attack_id;
		BW_INFO[bw_owner] = owner_id;
		BW_INFO[bw_time] = 720;
		BW_INFO[bw_place] = place_id;
		BW_INFO[bw_bizz] = i;
		BW_INFO[bw_doubledraw] = 0;
		for(new x; x < 2; x++) BW_INFO[bw_kills][x] = 0;

		BW_INFO[bw_zone] = GangZoneCreate(bw_place_pos[place_id][0],bw_place_pos[place_id][1],bw_place_pos[place_id][2],bw_place_pos[place_id][3]);

        GangZoneShowForAll(BW_INFO[bw_zone], TEAM_HIT_COLOR);

        CreateBizWarTD();

        TextDrawSetString(BW_INFO[bw_td][3], FracInfo[owner_id][fName]);
        TextDrawSetString(BW_INFO[bw_td][4], FracInfo[attack_id][fName]);

		foreach(Player, x)
		{
			if(PlayerInfo[x][pMember] != attack_id && PlayerInfo[x][pMember] != owner_id) continue;

			for(new j; j < 7; j++) TextDrawShowForPlayer(x, BW_INFO[bw_td][j]);
		}

		SetTimer("checkBW", 1000, false);

        format(format_string, 96, "Anda menyerang bisnis %s[%i], layak %s", BizzInfo[i][bMessage], i, FracInfo[owner_id][fName]);
		SendFrac(attack_id, 0x4682B4AA, format_string);

		format(format_string, 96, "[Perhatian]: Untuk bisnis Anda %s[%i] mafia menyerang %s", BizzInfo[i][bMessage], i, FracInfo[attack_id][fName]);
		SendFrac(owner_id, 0x4682B4AA, format_string);

		format(format_string, 96, "%s memprovokasi perang untuk bisnis.", GN(playerid));
		SendFrac(attack_id, 0x4682B4AA, format_string);
		SendFrac(owner_id, 0x4682B4AA, format_string);

		format_string = "[BIZWAR] Ada zona di peta, pergi ke sana.";
		SendFrac(attack_id, -1, format_string);
		return SendFrac(owner_id, -1, format_string);
	}

	return SCM(playerid, COLOR_GREY, "Anda jauh dari memasuki bisnis apa pun.");
}
forward WaktuServer();
public WaktuServer()
{
    new leviiscript[64];
    new Jambut,
    Minit,
    SecondChoice,
    gooddays,
    monthoks,
    Yeagers;
    new MonthName[12][] =
    {
        "Jan", "Feb", "Mar", "Apr", "Mei", "Jun",
        "Jul", "Agust", "Sept", "Okt", "Nov", "Des"
    };
    getdate(Yeagers, monthoks, gooddays);
    gettime(Jambut, Minit, SecondChoice);
    format(leviiscript, sizeof leviiscript, "%s%d %s %s%d", ((gooddays < 10) ? ("0") : ("")), gooddays, MonthName[monthoks-1], (Yeagers < 10) ? ("0") : (""), Yeagers);
    TextDrawSetString(TextDate, leviiscript);
    format(leviiscript, sizeof leviiscript, "%s%d:%s%d:%s%d", (Jambut < 10) ? ("0") : (""), Jambut, (Minit < 10) ? ("0") : (""), Minit, (SecondChoice < 10) ? ("0") : (""), SecondChoice);
    TextDrawSetString(TextTime, leviiscript);
}

epublic: checkBW()
{
    BW_INFO[bw_time]--;

    GangZoneFlashForAll(BW_INFO[bw_zone], COLOR_RED);

	new place_id = BW_INFO[bw_place];
	new b_id = BW_INFO[bw_bizz];

    new gang_owner = BW_INFO[bw_owner];
	new gang_attack = BW_INFO[bw_attack];

	new str[16];

	format(str, 16, "~n~%s", Convert(BW_INFO[bw_time]));
	TextDrawSetString(BW_INFO[bw_td][2], str);

    new members[2];

    foreach(Player, i)
    {
        if(!PlayerToKvadrat(i,bw_place_pos[place_id][0],bw_place_pos[place_id][1],bw_place_pos[place_id][2],bw_place_pos[place_id][3])) continue;

        if(PlayerInfo[i][pMember] == gang_owner) members[0]++;
        if(PlayerInfo[i][pMember] == gang_attack) members[1]++;
    }

	TextDrawSetString(BW_INFO[bw_td][5], IntToString(members[0]));
	TextDrawSetString(BW_INFO[bw_td][6], IntToString(members[1]));

	if(BW_INFO[bw_time] == 0)
	{
        if(members[0] > members[1]) StopBizWar(1);
        else if(members[0] < members[1]) StopBizWar(2);
        else StopBizWar(0);

	    return printf("Perang untuk bisnis %s[%i] berhenti.", BizzInfo[b_id][bMessage], b_id);
	}

	return SetTimer("checkBW", 1000, false);
}

stock StopBizWar(winner)
{
    new b_id = BW_INFO[bw_bizz];

    new gang_owner = BW_INFO[bw_owner];
	new gang_attack = BW_INFO[bw_attack];

	new winner_id = winner == 2 ? gang_attack : winner == 1 ? gang_owner : 0;

	printf("[BW] %i %i", winner, winner_id);

	if(winner == 1)
	{
	    format(format_string, 96, "Mafia Anda telah melindungi bisnis dari mafia %s", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "Anda tidak dapat menangkap bisnis mafia %s", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);
	}
	else if(winner == 2)
	{
	    format(format_string, 96, "Mafia Anda telah kehilangan bisnis mafia %s", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "Mafia Anda mengambil bisnis dari mafia %s", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);

		BizzInfo[b_id][bMafia] = gang_attack;

        UpdateBizzLabelText(b_id);

        SaveBizzPer(b_id, "bMafia", gang_attack);
	}
	else
	{
	    if(BW_INFO[bw_doubledraw] == 0)
	    {
		    format_string = "Diterbitkan ekstra waktu dalam jumlah 2 menit untuk perang, saat ini skornya sama.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);

			BW_INFO[bw_time] = 120;
			BW_INFO[bw_doubledraw] = 1;

			return SetTimer("checkBW", 1000, false);
		}
		else
		{
		    format_string = "Tambah. waktu habis, skor tetap sama, wilayah tetap dengan pertahanan.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);
		}
	}

	foreach(Player, x)
	{
		if(PlayerInfo[x][pMember] != gang_owner && PlayerInfo[x][pMember] != gang_attack) continue;

		for(new j; j < 7; j++) TextDrawHideForPlayer(x, BW_INFO[bw_td][j]);
	}

	for(new j; j < 7; j++) TextDrawDestroy(BW_INFO[bw_td][j]);

	BW_INFO[bw_attack] = 0;

	GangZoneDestroy(BW_INFO[bw_zone]);

	return 1;
}

CMD:svvsvs(playerid, params[])
{
	for(new i; i < MAX_ZONES; i++)
	{
		if(!PlayerToKvadrat(playerid,GZInfo[i][gPos][0], GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3])) continue;

		SCMF(playerid, -1, "%i", i);
	}

	return 1;
}

CMD:bsbsbsb(playerid, params[])
{
	if(!IsAGang(playerid)) return Send(playerid, COLOR_GREY, "Hanya tersedia untuk geng.");

	if(GetFractionMemberAmount(FRACTION_LSPD) < 6) return Send(playerid, COLOR_GREY, "Polisi kurang dari 6 orang.");
	if(GetFractionMemberAmount(FRACTION_LSMEDICS) < 6) return Send(playerid, COLOR_GREY, "Ems kurang dari 6 orang.");
	new gang_attack = PlayerInfo[playerid][pMember];
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-2) return SCM(playerid, COLOR_GREY, "Luka Anda kecil.");
	if(GetFractionMemberAmount(gang_attack) < 7) return Send(playerid,COLOR_GREY, "Ada kurang dari 7 orang di geng Anda.!");
	if(!strlen(params))
	{
		Send(playerid, -1, "/capture [type(0-1)]");
		return Send(playerid, COLOR_GREY, "Jenis: 0 - daging, 1 - frags");
	}

	new type = strval(params);

	if(!(0 <= type <= 1)) return Send(playerid, COLOR_GREY, "Jenis: 0 - daging, 1 - frags");
	//if(type == 1) return Send(playerid, COLOR_GREY,"Tangkapan untuk pecahan dibekukan sementara");

	if(IsGangInWar(gang_attack)) return Send(playerid, COLOR_GREY, "Geng Anda sedang berkelahi dengan seseorang.");

	for(new i; i < MAX_ZONES; i++)
	{
		if(!PlayerToKvadrat(playerid,GZInfo[i][gPos][0], GZInfo[i][gPos][1],GZInfo[i][gPos][2],GZInfo[i][gPos][3])) continue;

		if(i == 6 || i == 68 || i == 66 || i == 73 || i == 89)
		    return SCM(playerid, COLOR_GREY, "Dilarang menyerang wilayah utama geng.");

		if(GZInfo[i][gAttack] != 0) return Send(playerid, COLOR_GREY, "Perang sudah terjadi di wilayah ini.");

		new gang_owner = GZInfo[i][gFraction];
		
		if(GetFractionMemberAmount(gang_owner) < 5) return Send(playerid, COLOR_GREY, "Dalam geng musuh kurang dari 5 orang.");

		if(gang_owner == gang_attack) return Send(playerid, COLOR_GREY, "Ini adalah wilayah gengmu.");

		if(gang_owner == 0)
		{
		    GZInfo[i][gFraction] = gang_attack;

		    GangZoneHideForAll(GZInfo[i][gID]);
			GangZoneShowForAll(GZInfo[i][gID],GetGangZoneColor(i));

		    return Send(playerid, COLOR_GREY, "Anda telah mengambil kendali atas wilayah tersebut.");
		}

		if(IsGangInWar(gang_owner)) return Send(playerid, COLOR_GREY, "Saat ini, geng Anda berkelahi dengan seseorang.");
		
        GZInfo[i][gAttack] = gang_attack;
        GZInfo[i][gTime] = 420;
		GZInfo[i][gType] = type;
		GZInfo[i][gDoubleDraw] = 0;

		for(new x; x < 2; x++) GZInfo[i][gKills][x] = 0;

        CreateCaptureTD(i);

        TextDrawSetString(GZInfo[i][gTD][3], FracInfo[gang_owner][fName]);
        TextDrawSetString(GZInfo[i][gTD][4], FracInfo[gang_attack][fName]);
        TextDrawSetString(GZInfo[i][gTD][8], IntToString(type));

        foreach(Player, x)
		{
			if(PlayerInfo[x][pMember] != gang_owner && PlayerInfo[x][pMember] != gang_attack) continue;

			for(new j; j < 9; j++) TextDrawShowForPlayer(x, GZInfo[i][gTD][j]);
		}

		Iter_Add(capture_zone_list, i);

		SetTimerEx("CheckGZ", 1000, false, "i", i);

        format(format_string, 96, "Geng Anda telah menyerang wilayah geng %s (Jenis: %s)", FracInfo[gang_owner][fName], type == 0 ? ("Dimiliki") : ("Kosong"));
		SendFrac(gang_attack, 0x4682B4AA, format_string);

		format(format_string, 96, "[Perhatian]: Sebuah geng telah menyerang wilayah Anda %s (Jenis: %s)", FracInfo[gang_attack][fName], type == 0 ? ("Dimiliki") : ("Kosong"));
		SendFrac(GZInfo[i][gFraction], 0x4682B4AA, format_string);

		format(format_string, 96, "%s memprovokasi perang untuk wilayah.", GN(playerid));
		SendFrac(gang_attack, 0x4682B4AA, format_string);
		return SendFrac(GZInfo[i][gFraction], 0x4682B4AA, format_string);
	}

	return Send(playerid, COLOR_GREY, "Anda tidak berada di wilayah geng mana pun.");
}
epublic: CheckGZ(g_id)
{
    GZInfo[g_id][gTime]--;

    GangZoneFlashForAll(GZInfo[g_id][gID], COLOR_RED);

    new gang_owner = GZInfo[g_id][gFraction];
	new gang_attack = GZInfo[g_id][gAttack];

	new type = GZInfo[g_id][gType];

	new str[16];

	format(str, 16, "~n~%s", Convert(GZInfo[g_id][gTime]));
	TextDrawSetString(GZInfo[g_id][gTD][2], str);

	if(type == 0)
	{
	    new members[2];

        foreach(Player, i)
        {
            if(!PlayerToKvadrat(i,GZInfo[g_id][gPos][0], GZInfo[g_id][gPos][1],GZInfo[g_id][gPos][2],GZInfo[g_id][gPos][3])) continue;

            if(PlayerInfo[i][pMember] == gang_owner) members[0]++;
            if(PlayerInfo[i][pMember] == gang_attack) members[1]++;
        }

		TextDrawSetString(GZInfo[g_id][gTD][5], IntToString(members[0]));
		TextDrawSetString(GZInfo[g_id][gTD][6], IntToString(members[1]));
	}

    if(type == 1)
	{
	    TextDrawSetString(GZInfo[g_id][gTD][5], IntToString(GZInfo[g_id][gKills][0]));
		TextDrawSetString(GZInfo[g_id][gTD][6], IntToString(GZInfo[g_id][gKills][1]));
	}

	if(GZInfo[g_id][gTime] == 0)
	{
	    if(type == 0)
	    {
	        new members[2];

	        foreach(Player, i)
	        {
	            if(!PlayerToKvadrat(i,GZInfo[g_id][gPos][0], GZInfo[g_id][gPos][1],GZInfo[g_id][gPos][2],GZInfo[g_id][gPos][3])) continue;

	            if(PlayerInfo[i][pMember] == gang_owner) members[0]++;
	            if(PlayerInfo[i][pMember] == gang_attack) members[1]++;
	        }

	        if(members[0] > members[1]) StopWarGZ(g_id, 1);
	        else if(members[0] < members[1]) StopWarGZ(g_id, 2);
	        else StopWarGZ(g_id, 0);
	    }
	    else
	    {
	        if(GZInfo[g_id][gKills][0] > GZInfo[g_id][gKills][1]) StopWarGZ(g_id, 1);
	        else if(GZInfo[g_id][gKills][0] < GZInfo[g_id][gKills][1]) StopWarGZ(g_id, 2);
	        else StopWarGZ(g_id, 0);
	    }

	    return printf("Perang Wilayah %i berhenti.", g_id);
	}

	return SetTimerEx("CheckGZ", 1000, false, "i", g_id);
}

stock StopWarGZ(g_id, winner)
{
    new gang_owner = GZInfo[g_id][gFraction];
	new gang_attack = GZInfo[g_id][gAttack];

	new winner_id = winner == 2 ? gang_attack : winner == 1 ? gang_owner : 0;

	printf("[GZ] %i %i %i", g_id, winner, winner_id);

	if(winner == 1)
	{
	    format(format_string, 96, "Geng Anda melindungi wilayah dari geng %s", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "Anda tidak dapat menangkap wilayah geng %s", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);
	}
	else if(winner == 2)
	{
	    format(format_string, 96, "Gengmu kehilangan wilayah karena geng %s", FracInfo[gang_attack][fName]);
		SendFrac(gang_owner, 0x4682B4AA, format_string);

		format(format_string, 96, "Gengmu merebut wilayah dari geng %s", FracInfo[gang_owner][fName]);
		SendFrac(gang_attack, 0x4682B4AA, format_string);

		GZInfo[g_id][gFraction] = gang_attack;
	}
	else
	{
	    if(GZInfo[g_id][gDoubleDraw] == 0)
	    {
		    format_string = "Diterbitkan ekstra waktu dalam jumlah 2 menit untuk perang, saat ini skornya sama.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);

			GZInfo[g_id][gTime] = 120;
			GZInfo[g_id][gDoubleDraw] = 1;

			return SetTimerEx("CheckGZ", 1000, false, "i", g_id);
		}
		else
		{
		    format_string = "Tambah. waktu habis, skor tetap sama, wilayah tetap dengan pertahanan.";
			SendFrac(gang_owner, 0x4682B4AA, format_string);
			SendFrac(gang_attack, 0x4682B4AA, format_string);
		}
	}

	foreach(Player, x)
	{
		if(PlayerInfo[x][pMember] != gang_owner && PlayerInfo[x][pMember] != gang_attack) continue;

		for(new j; j < 9; j++) TextDrawHideForPlayer(x, GZInfo[g_id][gTD][j]);
	}

	Iter_Remove(capture_zone_list, g_id);

	for(new j; j < 9; j++) TextDrawDestroy(GZInfo[g_id][gTD][j]);

	GZInfo[g_id][gAttack] = 0;

	GangZoneStopFlashForAll(GZInfo[g_id][gID]);

	GangZoneHideForAll(GZInfo[g_id][gID]);
	GangZoneShowForAll(GZInfo[g_id][gID],GetGangZoneColor(g_id));
	SaveGZ(g_id);

	foreach(Player, idPlayer)
	{
	    if(PlayerInfo[idPlayer][pMember] != winner_id) continue;

	    if(player_quest_info[idPlayer][quest_id] == GQUEST_TYPE_CAPTURE && player_quest_info[idPlayer][quest_status] == 1)
        {
            player_quest_info[idPlayer][quest_progress]++;

            if(player_quest_info[idPlayer][quest_progress] >= 1)
            {
                player_quest_info[idPlayer][quest_status] = 2;

                OnPlayerUpdateAccountsPer(idPlayer, "warehouse_quest_status", 2);

                SetTimerEx("SendPlayerQuestInfoSMS", 15000, false, "ii", idPlayer, 2);
            }
            else SCMF(idPlayer, COLOR_YELLOW, "[QUEST] Perang menang: %i/2", player_quest_info[idPlayer][quest_progress]);
        }
	}

	return 1;
}

CMD:startbet(playerid)
{
	if(PlayerInfo[playerid][pLevel] < 4) return SCM(playerid, COLOR_GREY, "Tersedia dari level 4.");

    if(player_croupier_job{playerid} == 0) return Send(playerid, COLOR_GREY, "Anda bukan croupier.");

    new table_id = player_bone_table[playerid];

	if(table_id == -1) return Send(playerid, COLOR_GREY, "Anda tidak berada di meja apa pun.");

    if(bones_table_state[table_id] != 0) return Send(playerid, COLOR_GREY, "Tunggu sampai permainan berakhir.");

    if(GetBoneTableAmountBet(table_id) < 2) return Send(playerid, COLOR_GREY, "Untuk memulai permainan, 2 pemain atau lebih harus bertaruh.");

	bones_table_state[table_id] = 1;
	bones_table_time[table_id] = 15;

	return SendBoneTableMessage(table_id, "Croupier memulai permainan, hingga 15 detik...");
}

CMD:setbet(playerid)
{
    new table_id = player_bone_table[playerid];
    new slot_id = player_bone_slot[playerid];

	if(table_id == -1) return Send(playerid, COLOR_GREY, "Anda tidak berada di meja apa pun.");

    if(bones_table_state[table_id] != 0) return Send(playerid, COLOR_GREY, "Tunggu hingga game selesai.");

	if(player_croupier_job{playerid} == 1)
	{
	    if(GetBoneTableAmountBet(table_id) != 0) return Send(playerid, COLOR_GREY, "Untuk mengubah taruhan, semua pemain harus membatalkannya.");

	    return SPD(playerid, 3287, DIALOG_STYLE_INPUT, "Ubah jumlah tawaran", "{FFFFFF}Masukkan jumlah taruhan baru:\nDari $1.000 hingga $1.000.000", "Edit", "Tutup");
	}

	if(bones_table_bet[table_id] == 0) return Send(playerid, COLOR_GREY, "Croupier belum memasang taruhan.");

	if(bones_player_bet[table_id][slot_id] == true) return Send(playerid, COLOR_GREY, "Anda sudah bertaruh.");

    if(PlayerInfo[playerid][pCash] < bones_table_bet[table_id]) return Send(playerid, COLOR_GREY, "Anda tidak memiliki jumlah yang diperlukan.");

    PlayerInfo[playerid][pCash] -= bones_table_bet[table_id];

    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

    bones_player_bet[table_id][slot_id] = true;

    format(format_string, 96, "{E79833}%s {FFFFFF}bertaruh", PlayerInfo[playerid][pName]);
    return SendBoneTableMessage(table_id, format_string);
}

CMD:apaint(playerid)
{
    if(admin_level[playerid] < 2) return 1;

	if(pb_state != 0) return SCM(playerid, COLOR_GREY, "PB sudah berjalan.");

    StartPaint();

    return SCM(playerid, -1, "Anda meluncurkan PB.");
}

CMD:arace(playerid)
{
	if(admin_level[playerid] < 2) return 1;

	if(race_state != 0) return SCM(playerid, COLOR_GREY, "Balapan sudah berjalan.");

    StartRace();

    return SCM(playerid, -1, "Anda memulai balapan.");
}

CMD:family(playerid)
{
	if(PlayerInfo[playerid][pFamily] == -1) return SCM(playerid, -1, "Anda bukan anggota keluarga mana pun!");

	ShowPlayerDialog
	(
		playerid,3921,DIALOG_STYLE_LIST,"{EE82EE}Keluarga",
		"1. Informasi Keluarga\n\
		2. Komposisi keluarga (OFFLINE)\n\
		3. Komposisi keluarga (ONLINE)\n\
		4. Tinggalkan keluarga\n\
		5. Perubahan warna keluarga",
		"Selanjutnya", "Tutup"
	);

	return 1;
}

CMD:frang(playerid, params[])
{
	new f_id = GetPlayerData(playerid, pFamily);

	if(f_id == -1) return SCM(playerid, -1, "Anda bukan anggota keluarga!");

	if(GetPlayerData(playerid, pFamilyRang) < 3) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk kepala keluarga.");

    extract params -> new to_player, string:give_rang[2]; else return SendClientMessage(playerid, 0x999999FF, "Gunakan: /frang [id pemain] [+/-]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
	if(GetPlayerData(to_player, pFamily) != GetPlayerData(playerid, pFamily)) return SendClientMessage(playerid, 0xCECECEFF, "Pemain ini tidak ada di keluarga Anda.!");
	if(!ProxDetectorS(5.0, playerid, to_player)) return SendClientMessage(playerid, 0xCECECEFF, "Pemainnya terlalu jauh");

    if(GetPlayerData(to_player, pFamilyRang) >= GetPlayerData(playerid, pFamilyRang)) return SCM(playerid, COLOR_GREY, "Pemain ini lebih tinggi atau sama dengan peringkat Anda!");

	if(give_rang[0] == '+')
	{
        if(GetPlayerData(to_player, pFamilyRang) + 1 == GetPlayerData(playerid, pFamilyRang)) return SCM(playerid, COLOR_GREY, "Tidak dapat meningkatkan ke peringkat Anda!");

		if(GetPlayerData(to_player, pFamilyRang) + 1 == 2)
		{
		    format(format_string, 96, "SELECT `pID` FROM `accounts` WHERE `family` = %i AND `family_rang` = 2", f_id);
		    new Cache: result = mysql_query(mMysql, format_string, true);

			if(cache_num_rows() >= 3) return SCM(playerid, COLOR_GREY, "Tidak mungkin mengambil 2 peringkat lebih dari 3 orang!");

			cache_delete(result);
		}

		AddPlayerData(to_player, pFamilyRang, +, 1);

		SCMF(playerid, 0x3399FFFF, "Anda dibesarkan %s[%i] ke peringkat %i", GetPlayerNameEx(to_player), to_player, GetPlayerData(to_player, pFamilyRang));
		SCMF(to_player, 0x3399FFFF, "%s[%i] meningkatkan Anda ke peringkat %i", GetPlayerNameEx(playerid), playerid, GetPlayerData(to_player, pFamilyRang));
	}
	else
	{
		AddPlayerData(to_player, pFamilyRang, -, 1);

		SCMF(playerid, 0x3399FFFF, "Anda diturunkan peringkatnya %s[%i] ke peringkat %i", GetPlayerNameEx(to_player), to_player, GetPlayerData(to_player, pFamilyRang));
		SCMF(to_player, 0x3399FFFF, "%s[%i] menurunkan Anda ke peringkat %i", GetPlayerNameEx(playerid), playerid, GetPlayerData(to_player, pFamilyRang));
	}

    update_int_mysql(to_player, "family_rang", GetPlayerData(to_player, pFamilyRang));

	return 1;
}

CMD:finvite(playerid, params[])
{
	new f_id = GetPlayerData(playerid, pFamily);

	if(f_id == -1) return SCM(playerid, -1, "Anda bukan anggota keluarga!");

	if(GetPlayerData(playerid, pFamilyRang) < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari peringkat 2!");

    extract params -> new to_player; else return SendClientMessage(playerid, 0x999999FF, "Gunakan: /finvite [id pemain]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
	if(GetPlayerData(to_player, pFamily) != -1) return SendClientMessage(playerid, 0xCECECEFF, "Pemain ini sudah menjadi anggota keluarga.");
	if(!ProxDetectorS(10.0, playerid, to_player)) return SendClientMessage(playerid, 0xCECECEFF, "Pemainnya terlalu jauh");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan pertukaran masuk!");

	SCMF(playerid, 0x3399FFFF, "Anda menyarankan %s[%i] bergabunglah dengan keluarga Anda!", GetPlayerNameEx(to_player), to_player);
	SCMF(to_player, 0x3399FFFF, "%s[%i] mengundang Anda untuk bergabung dengan keluarga {33FF66}''%s''.", GetPlayerNameEx(playerid), playerid, family_info[f_id][f_name]);
	SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");

    SendPlayerOffer(playerid, to_player, OFFER_TYPE_FAMILY);

	return 1;
}

CMD:funinvite(playerid, params[])
{
	new f_id = GetPlayerData(playerid, pFamily);

	if(f_id == -1) return SCM(playerid, -1, "Anda bukan anggota keluarga!");
    if(GetPlayerData(playerid, pFamilyRang) < 2) return SCM(playerid, COLOR_GREY, "Tersedia dari peringkat 2!");

    extract params -> new to_player; else return SendClientMessage(playerid, 0x999999FF, "Gunakan: /funinvite [id pemain]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SendClientMessage(playerid, 0xCECECEFF, "Tidak ada pemain seperti itu");
	if(GetPlayerData(to_player, pFamily) != f_id) return SendClientMessage(playerid, 0xCECECEFF, "Pemain ini tidak ada di keluarga Anda.");

	if(GetPlayerData(to_player, pFamilyRang) >= GetPlayerData(playerid, pFamilyRang)) return SCM(playerid, COLOR_GREY, "Pemain ini lebih tinggi atau sama dengan peringkat Anda!");

	format(format_string, 96, "%s[%i] {FFFFFF}diusir dari keluarga %s[%i]", GetPlayerNameEx(playerid), playerid, GetPlayerNameEx(to_player), to_player);
	SendFamilyMessage(f_id, format_string);

	SetPlayerData(to_player, pFamily, -1);

	DestroyDynamic3DTextLabel(family_player_3d[to_player]);
    family_player_3d[to_player] = Text3D:-1;

	format(format_string, 144, "UPDATE `accounts` SET `family` = -1 WHERE `pName` = '%s'", GetPlayerNameEx(to_player));
	mysql_tquery(mMysql, format_string);

	return 1;
}
CMD:tpcor(playerid,params[])
{
	if(admin_level[playerid] == 0) return 1;

    new Float:x,Float:z,Float:y;
	if(sscanf(params,"p<,>fff",x,y,z)) return SendClientMessage(playerid,-1,"/tpcor [x], [y], [z]");
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		SetPlayerPos(playerid,x,y,z);
		SetPlayerInterior(playerid, 0);
		SetPlayerVirtualWorld(playerid, 0);
	}
	else SetVehiclePos(GetPlayerVehicleID(playerid), x, y, z);
	return SendClientMessage(playerid,-1,"Anda diteleportasi!");
}
