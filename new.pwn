CMD:testpin(playerid, params[])
{
    // Parameter kedua: true = Player baru (disuruh buat PIN), false = Player lama (disuruh masukkan PIN)
    OpenPinPad(playerid, false); 
    
    // Bekukan player agar tidak bisa berjalan saat memasukkan PIN
    TogglePlayerControllable(playerid, false); 
    return 1;
}
