		    {
		        SetPlayerCheckpoint(playerid, 400.467498, 1277.114501, 23.217241, 3.0);
		        SetPVarInt(playerid, "GPS", 1);
		        PlayerInfo[playerid][pDutyminyak] = 1;
		
		        if(PlayerInfo[playerid][pSex] == 1)
		        {
		            SetPlayerSkin(playerid, 27); // Baju kerja laki-laki
		        }
		        else
		        {
		            SetPlayerSkin(playerid, 298); // Baju kerja perempuan
		        }
		
		        PlayerInfo[playerid][pWorkedOnce] = 1; 
		        OnPlayerUpdateAccountsPer(playerid, "pWorkedOnce", PlayerInfo[playerid][pWorkedOnce]);
		        
		        SendClientMessage(playerid, COLOR_YELLOW, "Anda Sudah On Duty Minyak");
		        SendClientMessage(playerid, COLOR_YELLOW, "[NORP] Silakan Mengikuti Checkpoint");
		    }
		    // JIKA PLAYER SUDAH ON DUTY -> MAKA JADI OFF DUTY
		    else 
		    {
		        DisablePlayerCheckpoint(playerid); // Menghapus checkpoint kerja
		        DeletePVar(playerid, "GPS");
		        PlayerInfo[playerid][pDutyminyak] = 0;
		
		        // Mengembalikan skin ke skin asli player (menggunakan variabel pSkin, sesuaikan jika variabel di servermu berbeda)
		        SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]); 
		
		        SendClientMessage(playerid, COLOR_RED, "Anda Telah Off Duty Minyak (Selesai Bekerja)");
		    }
		}
