	if(dialogid == DIALOG_MDCPHONE)
    {
        if(response)
        {
            new number = strval(inputtext);

            if(!number)
                return ShowPlayerDialog(playerid, DIALOG_MDCPHONE, DIALOG_STYLE_INPUT, "Trace Phone", "ERROR: Invalid Phone Number!\nPlease Input Number Phone of the Target:", "Trace", "Cancel");

            if (number == 0)
                return ShowPlayerDialog(playerid, DIALOG_MDCPHONE, DIALOG_STYLE_INPUT, "Trace Phone", "ERROR: There is no Civillian with that Phone Number!\nPlease Input Number Phone of the Target:", "Trace", "Cancel");

            foreach(new i : Player)
            {
                if(PlayerInfo[i][pNumber] == number && number != 0)
                {
                    new Float:pz[3];
                    GetPlayerPos(i, pz[0], pz[1], pz[2]);
                    SetPlayerGPS(i, pz[0], pz[1], pz[2]);
                    Servers(playerid, "The target marker is on your radar.");
                }
            }
        }
    }
    if(dialogid == DIALOG_FINDPERSONID)
    {
        if(response)
        {
            new targetid;
            if(sscanf(inputtext, "u", targetid))
                return ShowPlayerDialog(playerid, DIALOG_FINDPERSONID, DIALOG_STYLE_INPUT, "Citizens Information", "ERROR: MDC Cannot found that person!\nPlease input the ID or Player Name for the Target Information:", "Search", "Close");

            if(targetid == INVALID_PLAYER_ID)
                return ShowPlayerDialog(playerid, DIALOG_FINDPERSONID, DIALOG_STYLE_INPUT, "Citizens Information", "ERROR: MDC Cannot found that person!\nPlease input the ID or Player Name for the Target Information:", "Search", "Close");

            pData[playerid][pTarget] = targetid;
            new title[40];
            format(title, sizeof(title), "%s MDC Informations", Name(targetid));
            ShowPlayerDialog(playerid, DIALOG_FINDPERSON, DIALOG_STYLE_LIST, title, "View Personal Data", "Select", "Close");
            SendClientMessageEx(playerid, ARWIN, "MDC: {FFFFFF}Target Founded with Specifier name {FFFF00}%s", Name(targetid));

        }
        else
        {
            callcmd::trace(playerid, "");
        }
    }
    if(dialogid == DIALOG_FINDPERSON)
    {
        new targetid = pData[playerid][pTarget];
        if(response)
        {
            if(listitem == 0)
            {
                if(targetid == INVALID_PLAYER_ID)
                    Error(playerid, "Failed viewing personal data, reason: That person is no longer valid(Leaving server)");

                ShowPersonalData(playerid, targetid);
            }
        }
        else
        {
            callcmd::trace(playerid, "");
        }
    }
    if(dialogid == DIALOG_MDCPLATE)
    {
        if(response)
        {
            foreach(new i: Player)
            {
                new u_car = pData[i][pUseCar];
                if (!strcmp("None", inputtext) || !strcmp("none", inputtext) || !strcmp("NONE", inputtext))
                    return Error(playerid, "There is no specified vehicle plate 'None' or 'NONE'");

                if(!strcmp(VehiclePlate[i][u_car], inputtext, true))
                {
                    if(IsValidVehicle(player_home_car[i][u_car]))
                    {
                        new Float:pos[3];
                        GetVehiclePos(player_home_car[i][u_car], pos[0], pos[1], pos[2]);
                        SetPlayerGPS(playerid, pos[0], pos[1], pos[2]);
                        SendClientMessage(playerid, ARWIN, "MDC: {FFFFFF}Target founded, red checkpoints has been added on your radar.");
                    }
                }
            }
        }
    }
