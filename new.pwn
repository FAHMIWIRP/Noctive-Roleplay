forward OnPlayerCarTroll(playerid, vehicleid, trolledid, trolltype);
public OnPlayerCarTroll(playerid, vehicleid, trolledid, trolltype)
{
    if(trolledid == INVALID_PLAYER_ID) return 0;
    new code[50];
    code = "car troller";

    SCMF(playerid, COLOR_RED, "[NORP-CHEAT]:{FFFFFF} Kamu tertangkap cheat %s!", code);
    DetectTroll(playerid);
    return 1;
}
forward OnPlayerGunCheat(playerid, weaponid, ammo, hacktype);
public OnPlayerGunCheat(playerid, weaponid, ammo, hacktype)
{
    if(admin_level[playerid] <= 10 && admin_logged[playerid]) return 0;
    if(weaponid == 25 && ammo == 5 && (hacktype == 1 || hacktype == 2)) {
        for (new i = 0; i <= 12; i++)
        {
            new wWepId, aAmmo;
            GetPlayerWeaponData(playerid, i, wWepId, aAmmo);
            if(wWepId == WEAPON_SHOTGUN) {
                if(aAmmo >= 5) SetPlayerAmmoEx(playerid, WEAPON_SHOTGUN, aAmmo - 5);
                else SetPlayerAmmoEx(playerid, WEAPON_SHOTGUN, 0);
            }
        }
        return 0;
    }
    new code[50];
    code = "weapon hack";
    wepHack[playerid] = true;
    ResetWeapons(playerid);
//    DetectSpawnWep(playerid);
    return 1;
}
public OnPlayerTeleport(playerid, Float:distance)
{
    if(!admin_level[playerid])
    {
        if(!IsPlayerInRangeOfPoint(playerid, 4.0, pData[playerid][pPosX], pData[playerid][pPosY], pData[playerid][pPosZ]))
        {
            {
			Kick(playerid);
            }
        }
    }
    return 1;
}
