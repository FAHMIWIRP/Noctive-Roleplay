CMD:createammo(playerid, params[])
{
    // 1. Cek Pekerjaan Ilegal
    if(PlayerInfo[playerid][pJobbm] == 0)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki pekerjaan Ilegal!");
    }

    // 2. Parameter Jumlah Ammo
    new jumlah;
    if(sscanf(params, "d", jumlah)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Gunakan: /createammo [jumlah_ammo]");

    if(jumlah < 1) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Jumlah ammo yang dibuat minimal 1!");

    // 3. Cek Senjata yang Dipegang Saat Ini
    new weaponid = GetPlayerWeapon(playerid);
    
    // Memastikan yang dipegang adalah senjata api (ID 22 sampai 38)
    if(weaponid < 22 || weaponid > 38)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus memegang senjata api untuk mengisi pelurunya!");
    }

    // 4. Hitung Kebutuhan Metal (1 Ammo = 2 Metal)
    new hargaMetal = jumlah * 2;

    // 5. Cek Apakah Metal Pemain Cukup
    if(PlayerInfo[playerid][pMetall] < hargaMetal)
    {
        new failStr[128];
        format(failStr, sizeof(failStr), "{FF3838}[ INFO ]{FFFFFF} Metall anda tidak cukup! Anda butuh %d Metall untuk membuat %d ammo.", hargaMetal, jumlah);
        return SendClientMessage(playerid, -1, failStr);
    }

    // 6. Eksekusi Pengurangan Metal dan Penambahan Ammo
    PlayerInfo[playerid][pMetall] -= hargaMetal;
    GivePlayerWeapon(playerid, weaponid, jumlah); // Menambahkan ammo ke senjata yang sedang dipegang
    
    // 7. Simpan Update Metal ke Database
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    
    // 8. Pesan Berhasil dengan Nama Senjata
    new weaponName[32], successStr[128];
    GetWeaponName(weaponid, weaponName, sizeof(weaponName));
    
    format(successStr, sizeof(successStr), "{5996FF}[ INFO ]{FFFFFF} Anda berhasil membuat %d peluru untuk %s menggunakan %d Metall.", jumlah, weaponName, hargaMetal);
    SendClientMessage(playerid, -1, successStr);

    return 1;
}

CMD:getjob(playerid, params[])
{
    // Pengecekan KTP (ID Card)
    if(PlayerInfo[playerid][pKtp] == 0)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus memiliki KTP untuk mendaftar pekerjaan!");
    }

    // Pengecekan Lokasi
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 497.037872, -2227.982421, 790.026550))
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak berada di tempat pendaftaran kerja (City Hall/Job Center)!");
    }

    new 
        cChicken = 0, 
        cConst = 0, 
        cMiner = 0, 
        cOil = 0,
        cCompo = 0,
        cFarmer = 0, // Variabel baru untuk Farmer
        string[600]; 

    // Menghitung jumlah orang yang join di masing-masing job
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++)
    {
        if(IsPlayerConnected(i))
        {
            if(PlayerInfo[i][pJobchiken] > 0) cChicken++;
            if(PlayerInfo[i][pJobconstruction] > 0) cConst++;
            if(PlayerInfo[i][pJobminer] > 0) cMiner++;
            if(PlayerInfo[i][pJoboil] > 0) cOil++;
            if(PlayerInfo[i][pJobcompo] > 0) cCompo++; 
            if(PlayerInfo[i][pJobpadi] > 0) cFarmer++; // Cek Farmer
        }
    }

    // Format tampilan dialog (Ditambah Farmer)
    format(string, sizeof(string), "Job Chicken cutting (%d orang)\nJob Construction (%d orang)\nJob Miner (%d orang)\nJob Oil (%d orang)\nJob Product Component (%d orang)\nJob Farmer (%d orang)", 
        cChicken, cConst, cMiner, cOil, cCompo, cFarmer);

    // Menampilkan dialog
    ShowPlayerDialog(playerid, DIALOG_GETJOB, DIALOG_STYLE_LIST, "List Job Noctive", string, "Ambil", "Batal");
    return 1;
}
CMD:mission(playerid, params[])
{
    // 1. CEK APALAH HADIAH UTAMA SUDAH DIAMBIL SEBELUMNYA
    // Jika sudah pernah diambil, player tidak bisa membuka dialog misi lagi.
    if(PlayerInfo[playerid][pRewardClaimed] == 1)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu sudah menyelesaikan semua misi pemula dan mengambil hadiah!");
    }

    // 2. CEK OTOMATIS JIKA BARU PERTAMA KALI SELESAI SEMUA
    if(PlayerInfo[playerid][pClaimedSP] == 1 && 
       PlayerInfo[playerid][pCreatedID] == 1 && 
       PlayerInfo[playerid][pTakenJob] == 1 && 
       PlayerInfo[playerid][pWorkedOnce] == 1)
    {
        PlayerInfo[playerid][pRewardClaimed] = 1;
        GivePlayerMoneyEx(playerid, 20000, ""); // Memberikan 20.000 Dolar
        
        // Menyimpan status ke database agar permanen
        OnPlayerUpdateAccountsPer(playerid, "pRewardClaimed", PlayerInfo[playerid][pRewardClaimed]);
        
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Selamat! Kamu menyelesaikan semua misi Pemula dan mendapatkan $20,000.");
        return 1; // Langsung return agar tidak perlu menampilkan dialog lagi
    }

    // 3. TAMPILAN DIALOG JIKA MISI MASIH ADA YANG BELUM SELESAI
    new mainString[512];
    format(mainString, sizeof(mainString), 
        "Ambil Staterpack /claimsp [ %s ]\n\
        Buat ID Card [ %s ]\n\
        Ambil Job [ %s ]\n\
        Coba 1 Pekerjaan [ %s ]\n\n\
        {FFFF00}Note : Selesaikan Semuanya Untuk Mendapatkan 20.000 Dolar",
        (PlayerInfo[playerid][pClaimedSP] == 1) ? ("{00FF00}Sudah{FFFFFF}") : ("{FF0000}Belum{FFFFFF}"),
        (PlayerInfo[playerid][pCreatedID] == 1) ? ("{00FF00}Sudah{FFFFFF}") : ("{FF0000}Belum{FFFFFF}"),
        (PlayerInfo[playerid][pTakenJob] == 1) ? ("{00FF00}Sudah{FFFFFF}") : ("{FF0000}Belum{FFFFFF}"),
        (PlayerInfo[playerid][pWorkedOnce] == 1) ? ("{00FF00}Sudah{FFFFFF}") : ("{FF0000}Belum{FFFFFF}")
    );

    ShowPlayerDialog(playerid, 9845, DIALOG_STYLE_MSGBOX, "Mission List", mainString, "Tutup", "");
    return 1;
}
