CMD:proseskayu(playerid, params[])
{
    // 2. Cek lokasi packing
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, -448.999298, -63.323993, 59.426368) &&
      !IsPlayerInRangeOfPoint(playerid, 3.0, -449.005279, -60.391090, 59.454174))
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Kamu tidak berada di tempat proses kayu!");

     if(PlayerInfo[playerid][pJobPenebang] == 0) 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu harus bekerja sebagai penebang kayu!");
    }
    
    // 2. Validasi minimal jumlah kayu (Harus 100 kayu)
    if(PlayerInfo[playerid][pKayu] < 100) 
    {
        new msgError[128];
        format(msgError, sizeof(msgError), "{FF0000}[ERROR]: {FFFFFF}Kayu tidak cukup! Kamu butuh 100 kayu (Kayu kamu saat ini: %d).", PlayerInfo[playerid][pKayu]);
        return SendClientMessage(playerid, -1, msgError);
    }

    // 4. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    // 5. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 0, 0, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Proses Kayu..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnKayuProses", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu sedang memproses kayu...");
    return 1;
}

forward OnKayuProses(playerid);
