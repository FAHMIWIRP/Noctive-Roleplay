        if(CarInfo[playerid][cMoney][car_id] + amount > 20000) return Error(playerid, "Kapasitas Uang di bagasi penuh! (Maksimal $20.000)");

        GivePlayerMoney(playerid, -amount);
        CarInfo[playerid][cMoney][car_id] += amount;
        SCMF(playerid, COLOR_GREEN, "Anda menyimpan $%d ke bagasi.", amount);
        SaveCars(playerid);
    return 1;
