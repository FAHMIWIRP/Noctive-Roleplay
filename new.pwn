        format(szItem, sizeof(szItem), "Sawit\t%d\n", PlayerInfo[targetid][pSawit]);
        strcat(ilham, szItem);
    }

    // Giok
    if (PlayerInfo[targetid][pGiokhijau] > 0) {
        format(szItem, sizeof(szItem), "{00FF00}Giok Hijau\t{00FF00}%d\n", PlayerInfo[targetid][pGiokhijau]);
