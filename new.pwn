        PlayerTextDrawShow(playerid, tegalpan[playerid][i]);
    }
    for(new i = 0; i < 7; i++)
    {
        PlayerTextDrawHide(playerid, Noctive[playerid][i]);
    }
    for (new i = 0; i < 3; i++)
    {
        PlayerTextDrawShow(playerid, panjul[playerid][i]);
    }
