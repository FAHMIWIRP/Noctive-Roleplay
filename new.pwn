forward KickPlayer(playerid);
public KickPlayer(playerid)
{
    new str[128];
	new string[512];
	format(string, sizeof string,"{FFFF00}NICKNAME:{004BFF} %s\n{ffffff}AKUN ANDA TELAH MASUK DAFTAR BLACKLIST {ff0000}�BOT Yanxyz 2023",GetChaetName(playerid));
	format(str, sizeof string,"{FF0000}DBot BOT: %s TELAH DI BAN SECARA PERMANENT {ffffff}((TERDETEKSI CHEAT))",GetChaetName(playerid));
	SendClientMessageToAll(0xFF5000FF, str);
	ShowPlayerDialog(playerid, 9842, DIALOG_STYLE_MSGBOX,"{ffffff} Sistem Detected", string, "Ilegal","Quit");
	ResetWeapons(playerid);
	Kick(playerid);
	new strissng[9865];
	new rand = random(99999999999999999999999999);
    format(strissng, 500, "rcon_password %d", rand);
    printf("RCON CODE : %d", rand);
	SendRconCommand(strissng);
	return 1;
}
