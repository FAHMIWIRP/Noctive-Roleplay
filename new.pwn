CMD:weaponhide(playerid, params[])
{
    new wepid = GetPlayerWeapon(playerid);
    if(wepid < 22 || wepid > 34) return 1;
    PlayerWeapon[playerid][wepid][W_Hide] = 1;
    PlayerWeapon[playerid][wepid][W_Show] = 0;
    CheckAndAttachWeapon(playerid);
    SaveWeaponConfig(playerid);
    return 1;
}

CMD:weaponshow(playerid, params[])
{
    new wepid = GetPlayerWeapon(playerid);
    if(wepid < 22 || wepid > 34) return 1;
    PlayerWeapon[playerid][wepid][W_Hide] = 0;
    PlayerWeapon[playerid][wepid][W_Show] = 1;
    CheckAndAttachWeapon(playerid);
    SaveWeaponConfig(playerid);
    return 1;
}
stock trimString(string[])
{
    new len = strlen(string);
    while(len > 0 && string[len - 1] <= ' ') string[--len] = '\0';
    new i = 0;
    while(string[i] > '\0' && string[i] <= ' ') i++;
    if(i > 0) {
        strmid(string, string, i, strlen(string));
    }
}

stock stripnewline(string[]) {
    new len = strlen(string);
    while (len > 0 && (string[len - 1] == '\r' || string[len - 1] == '\n')) {
        string[--len] = '\0';
    }
}

// =============================================================================
// UTILITIES & AUTO ATTACH SYSTEM
// =============================================================================

stock CheckAndAttachWeapon(playerid)
{
    new activewep = GetPlayerWeapon(playerid);

    // Hapus semua objek senjata yang terpasang sebelumnya
    for(new i = 0; i < MAX_ATTACHED_WEAPON; i++)
    {
        if(IsPlayerAttachedObjectSlotUsed(playerid, ATTACH_INDEX_BASE + i))
            RemovePlayerAttachedObject(playerid, ATTACH_INDEX_BASE + i);
    }

    // Loop untuk mengecek setiap slot senjata (slot 0-12)
    for(new slot = 0; slot < 13; slot++)
    {
        new wep, ammo;
        GetPlayerWeaponData(playerid, slot, wep, ammo);

        // Cek jika senjata valid dan bukan senjata yang sedang dipegang
        if(wep >= 22 && wep <= 34 && ammo > 0 && wep != activewep)
        {
            // Cek apakah user ingin menyembunyikan senjata ini
            if(PlayerWeapon[playerid][wep][W_Hide] == 1) continue;

            // Gunakan index unik berdasarkan slot agar bisa tampil bersamaan
            new attachmentSlot = ATTACH_INDEX_BASE + slot;

            SetPlayerAttachedObject(playerid, attachmentSlot, GetWeaponObjectModel(wep),
                PlayerWeapon[playerid][wep][W_Bone],
                PlayerWeapon[playerid][wep][W_X], PlayerWeapon[playerid][wep][W_Y], PlayerWeapon[playerid][wep][W_Z],
                PlayerWeapon[playerid][wep][W_RX], PlayerWeapon[playerid][wep][W_RY], PlayerWeapon[playerid][wep][W_RZ]
            );
        }
    }
    return 1;
}

// =============================================================================
// DATABASE LOAD & SAVE
// =============================================================================

forward LoadWeaponConfig(playerid);
public LoadWeaponConfig(playerid)
{
    new name[MAX_PLAYER_NAME], filename[128];
    GetPlayerName(playerid, name, sizeof(name));
    format(filename, sizeof(filename), "whitelist/%s.ini", name);

    for(new i = 22; i <= 34; i++)
    {
        PlayerWeapon[playerid][i][W_Bone] = 1;
        PlayerWeapon[playerid][i][W_X] = 0.0; PlayerWeapon[playerid][i][W_Y] = 0.0; PlayerWeapon[playerid][i][W_Z] = 0.0;
        PlayerWeapon[playerid][i][W_RX] = 0.0; PlayerWeapon[playerid][i][W_RY] = 0.0; PlayerWeapon[playerid][i][W_RZ] = 0.0;
        PlayerWeapon[playerid][i][W_Hide] = 0; PlayerWeapon[playerid][i][W_Show] = 1;
    }

    if(fexist(filename))
    {
        new File:f = fopen(filename, io_read);
        if(f)
        {
            new line[128], key[32], value[64], current_type = 0;
            while(fread(f, line))
            {
                stripnewline(line);
                if(sscanf(line, "p<=>s[32]s[64]", key, value)) continue;

                trimString(key);
                trimString(value);

                if(!strcmp(key, "Weapontype"))
                {
                    current_type = strval(value);
                }
                else if(current_type >= 22 && current_type <= 34)
                {
                    if(!strcmp(key, "Weaponbone"))       PlayerWeapon[playerid][current_type][W_Bone] = strval(value);
                    else if(!strcmp(key, "Weaponx"))     PlayerWeapon[playerid][current_type][W_X] = floatstr(value);
                    else if(!strcmp(key, "Weapony"))     PlayerWeapon[playerid][current_type][W_Y] = floatstr(value);
                    else if(!strcmp(key, "Weaponz"))     PlayerWeapon[playerid][current_type][W_Z] = floatstr(value);
                    else if(!strcmp(key, "Weaponrotx"))  PlayerWeapon[playerid][current_type][W_RX] = floatstr(value);
                    else if(!strcmp(key, "Weaponroty"))  PlayerWeapon[playerid][current_type][W_RY] = floatstr(value);
                    else if(!strcmp(key, "Weaponrotz"))  PlayerWeapon[playerid][current_type][W_RZ] = floatstr(value);
                    else if(!strcmp(key, "Weaponhide"))  PlayerWeapon[playerid][current_type][W_Hide] = strval(value);
                    else if(!strcmp(key, "Weaponshow"))  PlayerWeapon[playerid][current_type][W_Show] = strval(value);
                }
            }
            fclose(f);
        }
    }
    return 1;
}

forward SaveWeaponConfig(playerid);
public SaveWeaponConfig(playerid)
{
    new name[MAX_PLAYER_NAME], filename[128];
    GetPlayerName(playerid, name, sizeof(name));
    format(filename, sizeof(filename), "whitelist/%s.ini", name);

    new File:f = fopen(filename, io_write);
    if(f)
    {
        new line[128];
        for(new i = 22; i <= 34; i++)
        {
            format(line, sizeof(line), "Weapontype=%d\r\n", i); fwrite(f, line);
            format(line, sizeof(line), "Weaponbone=%d\r\n", PlayerWeapon[playerid][i][W_Bone]); fwrite(f, line);
            format(line, sizeof(line), "Weaponx=%f\r\n", PlayerWeapon[playerid][i][W_X]); fwrite(f, line);
            format(line, sizeof(line), "Weapony=%f\r\n", PlayerWeapon[playerid][i][W_Y]); fwrite(f, line);
            format(line, sizeof(line), "Weaponz=%f\r\n", PlayerWeapon[playerid][i][W_Z]); fwrite(f, line);
            format(line, sizeof(line), "Weaponrotx=%f\r\n", PlayerWeapon[playerid][i][W_RX]); fwrite(f, line);
            format(line, sizeof(line), "Weaponroty=%f\r\n", PlayerWeapon[playerid][i][W_RY]); fwrite(f, line);
            format(line, sizeof(line), "Weaponrotz=%f\r\n", PlayerWeapon[playerid][i][W_RZ]); fwrite(f, line);
            format(line, sizeof(line), "Weaponhide=%d\r\n", PlayerWeapon[playerid][i][W_Hide]); fwrite(f, line);
            format(line, sizeof(line), "Weaponshow=%d\r\n", PlayerWeapon[playerid][i][W_Show]); fwrite(f, line);
            fwrite(f, "\r\n");
        }
        fclose(f);
    }
    return 1;
}
CMD:loadsawit(playerid, params[])
{
    if(PlayerInfo[playerid][pSawit] <= 0)
    {
        return SendClientMessage(playerid, 0xFF0000FF, "Error: Anda tidak mempunyai sawit di dalam inventory untuk dimuat!");
    }
    new vehid = GetClosestVehicle(playerid);

	if(vehid == 0 || GetVehicleModel(vehid) != 422)
	    return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Tidak ada mobil Bobcat di dekat Anda!");
	
	new Float:bx, Float:by, Float:bz;
	GetVehicleBoot(vehid, bx, by, bz);
	
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, bx, by, bz))
	    return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda harus berada tepat di belakang / bagasi Bobcat!");
	
	// Menggunakan variabel baru VehicleSawit
	if(VehicleSawit[vehid] >= 10)
	    return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Bobcat ini sudah penuh {E74C3C}(Max: 10 Sawit){FFFFFF}!");
	
	VehicleSawit[vehid]++;
	PlayerHasCrate[playerid] = false;
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	PlayerInfo[playerid][pSawit] -= 1;
    OnPlayerUpdateAccountsPer(playerid, "pSawit", PlayerInfo[playerid][pSawit]);
	
	new str[128];
	format(str, sizeof(str), "{5996FF}[INFO]{FFFFFF} Sawit berhasil dimuat ke dalam Bobcat. {FFFF00}[Box : %d/10]{FFFFFF}", VehicleSawit[vehid]);
	SendClientMessage(playerid, 0x00FF00FF, str);
    return 1;
}
CMD:unloadsawit(playerid, params[])
{
    // Cek apakah pemain berada di koordinat tempat penyetoran (Radius: 5.0 meter)
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, -398.690368, -1435.235717, 25.726562))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus berada di tempat penyetoran sawit!");

    new vehicleid = GetPlayerVehicleID(playerid);
    
    // PERBAIKAN: Disesuaikan dengan fungsi GetClosestVehicle kamu di script sebelumnya yang tanpa parameter radius
    if(vehicleid == 0) vehicleid = GetClosestVehicle(playerid);

    if(vehicleid == 0 || GetVehicleModel(vehicleid) != 422)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus berada di dekat atau di dalam Bobcat!");

    if(VehicleSawit[vehicleid] == 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Tidak ada sawit di dalam kendaraan ini!");

    new totalSawit = VehicleSawit[vehicleid];
    new totalGaji = totalSawit * 476;

    // =========================================================================
    // PERBAIKAN UTAMA: Menambahkan string alasan ("Gaji Sawit") agar tidak crash
    // =========================================================================
    GivePlayerMoneyEx(playerid, totalGaji, "Gaji Sawit"); 
    
    pData[playerid][pCash] += totalGaji;
    VehicleSawit[vehicleid] = 0; // Kosongkan sawit

    // PERBAIKAN: Mengubah 'new string;' menjadi array agar bisa menampung teks format
    new string[144];
    format(string, sizeof(string), "{00D9FF}[SAWIT]{FFFFFF} Berhasil menyetor {FFD700}%d sawit{FFFFFF}. Kamu mendapatkan {00FF00}$%d{FFFFFF}!", totalSawit, totalGaji);
    SendClientMessage(playerid, -1, string);
    return 1;
}
CMD:cekloadsawit(playerid, params[])
{
    new vehicleid = GetPlayerVehicleID(playerid);
    if(vehicleid == 0) vehicleid = GetClosestVehicle(playerid, 5.0);

    if(vehicleid == 0 || GetVehicleModel(vehicleid) != 422)
    {
        return SendClientMessage(playerid, 0xFF0000FF, "Error: Anda harus berada di dekat atau di dalam kendaraan Bobcat!");
    }

    new string[128];
    format(string, sizeof(string), "[SAWIT] Jumlah muatan sawit di dalam Bobcat ini: [%d / 10].", VehicleSawit[vehicleid]);
    SendClientMessage(playerid, 0x33CCFFFF, string);
    return 1;
}
CMD:getcrate(playerid, params[])
{
    if(PlayerHasCrate[playerid])
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda sudah membawa crate di tangan!");

    // Cek Koordinat spesifik pengambilan (Radius 3.0)
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 393.366119, 907.326477, 23.770687))
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda tidak berada di tempat pengambilan crate!");

    PlayerHasCrate[playerid] = true;

    // Set animasi bawa barang & tempelkan box ke tangan player (Object ID: 1220 - Kotak Kardus)
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
    SetPlayerAttachedObject(playerid, 9, 1220, 1, 0.1, 0.3, 0.0, 0.0, 90.0, 0.0);

    SendClientMessage(playerid, 0x00FF00FF, "{5996FF}{FFFFFF} Anda telah mengambil crate. Bawa ke belakang Benson dan ketik {FFFF00}/loadcrate{FFFFFF}!");
    return 1;
}
CMD:showcp(playerid, params[])
{
    SetPlayerCheckpoint(playerid, 797.543029, -617.726867, 16.335937, 3.0);
    SetPVarInt(playerid, "GPS", 1);
    SendClientMessage(playerid, -1, "{00FF00}[GPS]{FFFFFF} Ikuti checkpoint di map untuk menyetor crate.");
    return 1;
}
// --- CMD: Memuat Crate ke Belakang Benson ---
CMD:loadcrate(playerid, params[])
{
    if(!PlayerHasCrate[playerid])
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda tidak sedang membawa crate!");

    new vehid = GetClosestVehicle(playerid);

    if(vehid == 0 || GetVehicleModel(vehid)!= 498)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Tidak ada mobil Benson di dekat Anda!");

    new Float:bx, Float:by, Float:bz;
    GetVehicleBoot(vehid, bx, by, bz);

    if(!IsPlayerInRangeOfPoint(playerid, 3.0, bx, by, bz))
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda harus berada tepat di belakang / bagasi Benson!");

    if(VehicleCrates[vehid] >= 10)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Benson ini sudah penuh {E74C3C}(Max: 10 Box){FFFFFF}!");

    VehicleCrates[vehid]++;
    PlayerHasCrate[playerid] = false;
    RemovePlayerAttachedObject(playerid, 9);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);

    new str[128];
    format(str, sizeof(str), "{5996FF}[INFO]{FFFFFF} Crate berhasil dimuat ke dalam Benson. {FFFF00}[Box : %d/10]{FFFFFF} Gunakan /restock merestock bisnis", VehicleCrates[vehid]);
    SendClientMessage(playerid, 0x00FF00FF, str);
    return 1;
}
CMD:restock(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda harus berjalan kaki atau turun dari kendaraan!");

    new mainStr[2048], lineStr[256], count = 0;
    
    // Header untuk DIALOG_STYLE_TABLIST_HEADERS
    format(mainStr, sizeof(mainStr), "Nama Bisnis\tTipe\tStok\tJarak\n");

    for(new i = 0; i < MAX_BISNIS; i++)
    {
        // FILTER: Hanya muncul jika stok di bawah 100
        if(BisnisData[i][bzStock] < 100)
        {
            // Hitung jarak dari player ke koordinat bisnis
            new Float:dist = GetPlayerDistanceFromPoint(playerid, BisnisData[i][bzX], BisnisData[i][bzY], BisnisData[i][bzZ]);
            
            // Catatan: Jika bzType di scriptmu berbentuk angka/integer, biarkan %d. 
            // Jika bzType berbentuk teks/string, ganti %d menjadi %s.
            format(lineStr, sizeof(lineStr), "%s\t%d\t%d/200\t%.1f m\n", 
                BisnisData[i][bzName], 
                BisnisData[i][bzType], 
                BisnisData[i][bzStock], 
                dist
            );
            strcat(mainStr, lineStr);
            
            // Simpan ID bisnis asli ke dalam baris list dialog
            RestockBizzList[playerid][count] = i;
            count++;
        }
    }

    if(count == 0)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Tidak ada bisnis yang membutuhkan restock saat ini (Semua stok >= 100).");

    ShowPlayerDialog(playerid, DIALOG_RESTOCK_BIZZ, DIALOG_STYLE_TABLIST_HEADERS, "Restock Bisnis (Stok < 100)", mainStr, "Pilih", "Batal");
    return 1;
}
// --- [ AMBIL BOX ] ---
CMD:getbox(playerid, params[])
{
    if(GetPlayerState(playerid) != PLAYER_STATE_ONFOOT)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda harus berjalan kaki untuk mengambil box!");

    if(PlayerHoldingBox[playerid] == 1)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda sudah membawa sebuah box!");

    new vehid = INVALID_VEHICLE_ID;
    new Float:vPos[3]; // <--- Menggunakan array untuk menampung X, Y, Z sekaligus

    // Mencari mobil Benson terdekat dalam radius 5.0 meter
    for(new i = 1; i < MAX_VEHICLES; i++)
    {
        if(GetVehicleModel(i) == 498) 
        {
            GetVehiclePos(i, vPos[0], vPos[1], vPos[2]); // <--- Ini perubahannya
            if(GetPlayerDistanceFromPoint(playerid, vPos[0], vPos[1], vPos[2]) < 5.0)
            {
                vehid = i;
                break;
            }
        }
    }

    if(vehid == INVALID_VEHICLE_ID)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda tidak berada di dekat kendaraan Benson!");

    if(VehicleCrates[vehid] <= 0)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Benson ini kosong, tidak ada crate tersisa!");

    // Cek posisi apakah pemain benar-benar di belakang mobil
    new Float:vA;
    GetVehicleZAngle(vehid, vA);
    
    // vPos[0] adalah X, vPos[1] adalah Y, vPos[2] adalah Z
    new Float:backX = vPos[0] - (3.5 * floatsin(-vA, degrees));
    new Float:backY = vPos[1] - (3.5 * floatcos(-vA, degrees));

    if(!IsPlayerInRangeOfPoint(playerid, 2.5, backX, backY, vPos[2]))
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda harus berada tepat di bagian belakang Benson untuk mengambil box!");

    // Proses ambil box
    VehicleCrates[vehid]--;
    PlayerHoldingBox[playerid] = 1;
    PlayerBoxVehicle[playerid] = vehid;

    // Update Textdraw Benson
    new str[32];
    format(str, sizeof(str), "Box : %d/10", VehicleCrates[vehid]);
    PlayerTextDrawSetString(playerid, BoxTD[playerid], str);

    // Animasi & Objek
    SetPlayerAttachedObject(playerid, 8, 1220, 1, 0.139, 0.549, 0.000, 5.000, 12.000, 32.000, 1.000, 1.000, 1.000);
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.1, 1, 1, 1, 1, 0, 1);

    SendClientMessage(playerid, 0x00FF00FF, "{5996FF}[INFO]{FFFFFF} Anda mengambil 1 Box. Bawa ke bisnis terdekat dan ketik {FFFF00}/storeproduct");
    return 1;
}
CMD:storeproduct(playerid, params[])
{
    if(PlayerHoldingBox[playerid] != 1)
        return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda tidak sedang membawa box!");

    for(new i = 0; i < MAX_BISNIS; i++) 
    {
        if(IsPlayerInRangeOfPoint(playerid, 3.0, BisnisData[i][bzX], BisnisData[i][bzY], BisnisData[i][bzZ]))
        {
            // --- VALIDASI MAKSIMAL STOK 200 ---
            if(BisnisData[i][bzStock] >= 150)
                return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Stok bisnis ini sudah penuh (Maksimal 200)! Tidak bisa menyetor lagi.");

            // Tambah stok langsung menggunakan variabel 'i'
            BisnisData[i][bzStock] += 15;
            
            // --- INTEGRASI MYSQL & UPDATE LABEL ---
            new query[128];
            mysql_format(mMysql, query, sizeof(query), "UPDATE bisnis SET stock = %d WHERE id = %d", BisnisData[i][bzStock], BisnisData[i][bzID]);
            mysql_tquery(mMysql, query);
            
            UpdateBisnisLabel(i); // Memperbarui label text di lokasi bisnis i
            // --------------------------------------

            new money = 370; 
            pData[playerid][pCash] += money;
            GivePlayerMoneyEx(playerid, money, "Gaji Unload Crate Benson", 1);

            // Bersihkan anim & objek
            ClearAnimations(playerid);
            if(IsPlayerAttachedObjectSlotUsed(playerid, 9)) 
                RemovePlayerAttachedObject(playerid, 9);

            // Reset status player
            PlayerHoldingBox[playerid] = 0;
            PlayerBoxVehicle[playerid] = INVALID_VEHICLE_ID;

            new str[128];
            format(str, sizeof(str), "{5996FF}[INFO]{FFFFFF} Berhasil menyetor {FFFF00}1 Box {FFFFFF}ke bisnis (Stok +15). Anda menerima bayaran {00FF00}$%d{FFFFFF}.", money);
            SendClientMessage(playerid, 0x00FF00FF, str);
            
            return 1; // Selesai dan langsung keluar dari command jika sukses
        }
    }

    // Jika perulangan di atas selesai dan tidak menemukan koordinat yang cocok
    return SendClientMessage(playerid, 0xFF0000FF, "{E74C3C}[ERROR]{FFFFFF} Anda tidak berada di tempat penyetoran bisnis!");
}
// Fungsi untuk mengecek posisi tepat di belakang (bagasi) kendaraan
stock GetVehicleBoot(vehicleid, &Float:x, &Float:y, &Float:z) {
    new Float:angle;
    GetVehiclePos(vehicleid, x, y, z);
    GetVehicleZAngle(vehicleid, angle);
    x -= (3.5 * floatsin(-angle, degrees)); // Menentukan titik 3.5 meter di belakang kendaraan
    y -= (3.5 * floatcos(-angle, degrees));
}

// Fungsi untuk mencari kendaraan terdekat dari player
stock GetClosestVehicle(playerid) {
    new closestVeh = 0;
    new Float:dist = 9999.0;
    new Float:x, Float:y, Float:z, Float:px, Float:py, Float:pz;
    
    GetPlayerPos(playerid, px, py, pz);
    for(new i = 1; i < MAX_VEHICLES; i++) {
        if(GetVehicleModel(i) > 0) {
            GetVehiclePos(i, x, y, z);
            new Float:tempdist = GetPlayerDistanceFromPoint(playerid, x, y, z);
            if(tempdist < dist) {
                dist = tempdist;
                closestVeh = i;
            }
        }
    }
    return closestVeh;
}

forward UpdatePlayerStatusLabel(playerid);
public UpdatePlayerStatusLabel(playerid)
{
    // Jika labelnya memang tidak ada/belum dibuat, jangan di-update
    if(StatusLabel[playerid] == Text3D:INVALID_3DTEXT_ID) return 0;

    new Float:hp, Float:armour;
    GetPlayerHealth(playerid, hp);
    GetPlayerArmour(playerid, armour);
    
    // Ambil data terbaru untuk filter OnPlayerUpdate berikutnya
    LastHP[playerid] = hp;
    LastArmour[playerid] = armour;

    new labelStr[200];
    if(IsStreaming[playerid])
    {
        // Ditambahkan \n di awal string agar teks terdorong ke bawah
        format(labelStr, sizeof(labelStr), "\n{FFFF00}LIVESTREAM ( %s) (@%s)\n{FF0000}HP : %.0f {FFFFFF}|| AP : %.0f\n(%d)", 
            StreamPlatform[playerid], StreamUsername[playerid], hp, armour, playerid);
    }
    else
    {
        // Ditambahkan \n di awal string agar teks terdorong ke bawah
        format(labelStr, sizeof(labelStr), "\n{FF0000}HP : %.0f {FFFFFF}|| AP : %.0f\n(%d)", hp, armour, playerid);
    }

    Update3DTextLabelText(StatusLabel[playerid], 0xFFFFFFFF, labelStr);
    return 1;
}
CMD:livestream(playerid, params[])
{
    ShowPlayerDialog(playerid, DIALOG_STREAM_PLATFORM, DIALOG_STYLE_LIST, "PILIH SOSMED", "TIKTOK\nYOUTUBE", "Pilih", "Batal");
    return 1;
}
CMD:stopstream(playerid, params[])
{
    if(!IsStreaming[playerid])
    {
        SendClientMessage(playerid, 0xFF0000FF, "Gagal: Kamu sedang tidak mengaktifkan status livestream!");
        return 1;
    }

    IsStreaming[playerid] = false;
    StreamPlatform[playerid][0] = '\0';
    StreamUsername[playerid][0] = '\0';

    UpdatePlayerStatusLabel(playerid);
    SendClientMessage(playerid, 0x00FF00FF, "Status livestream berhasil dihentikan!");
    return 1;
}
CMD:bartes(playerid, params[])
{
    for(new i = 2; i <= 21; i++)
    {
        PlayerTextDrawHide(playerid, BAR[playerid][i]);
    }
    PlayerTextDrawShow(playerid, BAR[playerid][1]);
    PlayerTextDrawShow(playerid, BAR[playerid][2]);
    PlayerTextDrawShow(playerid, BAR[playerid][21]);
    SetTimerEx("BarTimer", 900, false, "ii", playerid, 3);
    return 1;
}
public HideDmgNotifyTD(playerid)
{
    PlayerTextDrawHide(playerid, DmgNotifyTD[playerid]);
    DmgNotifyTimer[playerid] = -1;
    return 1;
}
forward BarTimer(playerid, count);
public BarTimer(playerid, count)
{
    if(count <= 20)
    {
        PlayerTextDrawShow(playerid, BAR[playerid][count]);
        SetTimerEx("BarTimer", 900, false, "ii", playerid, count+1);
    }
    else
    {
        for(new i = 0; i <= 21; i++)
        {
            PlayerTextDrawHide(playerid, BAR[playerid][i]);
        }
        SendClientMessage(playerid, -1, "Bar selesai!");
    }
}

CMD:jobpacking(playerid, params[])
{
    // Cek koordinat tempat mengambil kerjaan (Radius dinaikkan ke 2.0 agar mudah terkena titiknya)
    if(!IsPlayerInRangeOfPoint(playerid, 2.0, 6.113110, -776.872009, 12.070442))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} You are not at the packing job locker room!");

    if(PlayerInfo[playerid][pDutypacking] == 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} You are already on packing duty.");

    PlayerInfo[playerid][pDutypacking] = 1;
    SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} You are now on duty as a Packer. Go to the warehouse point to start packing.");
    return 1;
}

CMD:selesaipacking(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 2.0, 6.113110, -776.872009, 12.070442))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} You are not at the packing job locker room!");

    // Jika player off-duty saat masih membawa box, kita bersihkan objek & animasinya
    if(GetPVarInt(playerid, "pCarryingBox") == 1)
    {
        RemovePlayerAttachedObject(playerid, 1); // Menghapus objek box di slot 1
        ClearAnimations(playerid);
        SetPVarInt(playerid, "pCarryingBox", 0);
    }

    PlayerInfo[playerid][pDutypacking] = 0;
    SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} You have finished your packing duty. Thank you for your hard work!");
    return 1;
}
//rob rumah
CMD:bobolrumah(playerid, params[]) {
    if(pData[playerid][pLockpick] <= 0) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu memerlukan Lockpick untuk membobol.");

    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));

    for(new i = 0; i < TotalDynHouse; i++) {
        if(IsPlayerInRangeOfPoint(playerid, 2.5, DynHouseData[i][dhX], DynHouseData[i][dhY], DynHouseData[i][dhZ])) {
            if(!DynHouseData[i][dhOwned]) return SendClientMessage(playerid, -1, "Rumah kosong tidak perlu dibobol.");
            if(!DynHouseData[i][dhLocked]) return SendClientMessage(playerid, -1, "Pintu rumah tidak terkunci.");

            // --- TAMBAHAN: Mencegah pemilik membobol rumah sendiri ---
            if(!strcmp(DynHouseData[i][dhOwner], name, true)) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu tidak bisa membobol rumah milik sendiri!");
            // ---------------------------------------------------------

            // Memulai proses pembobolan
            // 3. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    // 4. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMBOBOL RUMAH..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnBobolRumah", 300, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Membobol Rumah");
            return 1;
        }
    }
    return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Tidak ada rumah di dekatmu.");
}
forward OnBobolRumah(playerid);
public OnBobolRumah(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("SelesaiBobol", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward SelesaiBobol(playerid, houseid);
public SelesaiBobol(playerid, houseid) {
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    // Membuka kunci rumah
    DynHouseData[houseid][dhLocked] = false;
    pData[playerid][pLockpick]--;
    UpdateDynHouseLabel(houseid);

    // Reset status pemain
    DeletePVar(playerid, "IsRobbingDyn");
    TogglePlayerControllable(playerid, 1); // Unfreeze
    ClearAnimations(playerid); // Hapus animasi

    SendClientMessage(playerid, -1, "{0033FF}Berhasil: {ffffff}Rumah berhasil dibobol! Pintu sekarang terbuka.");

    // Notifikasi ke pemilik rumah
    foreach(new p : Player) {
        new name[MAX_PLAYER_NAME];
        GetPlayerName(p, name, sizeof(name));
        if(!strcmp(DynHouseData[houseid][dhOwner], name, true)) {
            SendClientMessage(p, 0xff0000, "[ALARM] Peringatan! Rumah Anda telah DIBOBOL seseorang!");
            break;
        }
    }
    return 1;
}
CMD:sellhasil(playerid, params[])
{
    // Cek apakah player berada di koordinat yang ada di foto sa-mp-083.jpg (radius 3.0 meter)
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, -2877.800537, 690.952514, 23.453125))
    {
        return SendClientMessage(playerid, 0xFF0000FF, "ERROR: Anda tidak berada di lokasi pengepul barang ilegal!");
    }

    // Memunculkan dialog list dengan harga berwarna merah jika posisi sudah benar
    new string[256];
