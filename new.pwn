		        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak memiliki pekerjaan Chicken cutting!");
		        
		    if(PlayerInfo[playerid][pDutyAyam] == 0) 
		        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda belum memulai pekerjaan (Duty)!");
		
		    SetPVarInt(playerid, "pTimeAyam", gettime() + 1800);
		    PlayerInfo[playerid][pDutyAyam] = 0;
		    SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);
		    DisablePlayerCheckpoint(playerid);
		    SetPVarInt(playerid, "GPS", 0);
		    SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} Anda telah menyelesaikan job ayam.");
		}
		
		if(IsPlayerInRangeOfPoint(playerid, 1.0, 398.017730, 120.367179, 6.554981) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 401.707946, 119.969856, 6.617377) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 400.648590, 121.493133, 6.626113) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 399.259460, 122.928047, 6.663166) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 398.140075, 124.514999, 6.754801) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 397.275512, 124.581672, 6.776489))
		{
		    // Cek perlindungan tambahan
		    if(PlayerInfo[playerid][pJobchiken] == 0) return 1; // Memblokir aksi diam-diam jika tidak punya job
		    if(PlayerInfo[playerid][pKuliAyam] >= 1) return 1;
		    if(PlayerInfo[playerid][pDutyAyam] == 0) return 1; // Ini sudah aman dari kode bawaanmu
		
		    if(pData[playerid][pAyam] > 100) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Jual dulu semua ayam potong kamu!");
		    if(pData[playerid][pStress] > 100) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Sedang stress!");
		
		    {
		        PlayerInfo[playerid][pKuliAyam] += 1;
		        SetPlayerAttachedObject(playerid, 8, 19137, 1, 0.139, 0.549, 0.000, 5.000, 12.000, 32.000, 1.000, 1.000, 1.000);
		        SetPlayerChatBubble(playerid, "Mengambil Ayam",COLOR_PURPLE,30.0,10000);
		        SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} Kamu berhasil mengambil ayam.");
		        SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} Silahkan ke tempat pemotongan untuk memproses ayam.");
		    }
		    return 1;
		}
        if(IsPlayerInRangeOfPoint(playerid, 1.0, 396.566894, 111.983230, 6.595726) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 398.105407, 110.060409, 6.609105) ||
		   IsPlayerInRangeOfPoint(playerid, 1.0, 399.178558, 108.755386, 6.598413))
		{
		    if(PlayerInfo[playerid][pKuliAyam] < 1) return 1;
		    if(PlayerInfo[playerid][pDutyAyam] == 0) return 1;
		    {
		        PlayerInfo[playerid][pKuliAyam] -= 1;
		        callcmd::82779272(playerid, "");
		    }
		    return 1;
		}
		
		if(IsPlayerInRangeOfPoint(playerid, 1.5, 254.852752, 1139.438598, 11.019128) ||
		   IsPlayerInRangeOfPoint(playerid, 1.5, 247.200607, 1126.874023, 10.971912) ||
		   IsPlayerInRangeOfPoint(playerid, 1.5, 237.432617, 1145.303344, 12.111976) ||
		   IsPlayerInRangeOfPoint(playerid, 1.5, 231.048141, 1131.676147, 12.095624) ||
		   IsPlayerInRangeOfPoint(playerid, 1.5, 255.078155, 1149.986694, 11.391649))
		{
		    // Cek duty pemerah susu
		    if(PlayerInfo[playerid][pDutypemerassusu] == 0)
		        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus ambil job pemeras susu dulu!");
		
		    callcmd::8268362(playerid, "");
		    return 1;
		}
      
        if(IsPlayerInRangeOfPoint(playerid, 2.0, 3.248340, -775.368041, 12.183469))
        {
           if(PlayerInfo[playerid][pDutypacking] < 1) return 1;
            if(GetPVarInt(playerid, "pCarryingBox") == 1)
                return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} You are already carrying a box! Deliver it first.");

