		    if(GetPVarInt(playerid,"pTimeAyam") > gettime()) 
		        return Send(playerid, COLOR_GREY, "Cooldown Job 30 Menit");
		        
		    SetPlayerCheckpoint(playerid, 398.017730, 120.367179, 6.554981, 3.0);
