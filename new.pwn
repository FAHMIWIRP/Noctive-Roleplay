CMD:bukakado(playerid, params[])
{
    if(IsiKado == 0)
    {
    SendClientMessage(playerid, COLOR_WHITE, "Dewa Kprp Belum Membuat Kado");
    }
    else if(IsiKado == 1)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
		{
			f = a;
			break;
		}
	}
	if(f > MAX_KADO) return SendClientMessage(playerid, 0x33AA3300, "ERROR Tidak Ada Kado Disekitar");
	else
	{
		PosKado[f][0] = 0.0;
		PosKado[f][1] = 0.0;
		PosKado[f][2] = 0.0;

		DestroyDynamicObject(IdKado[f]);
		DestroyDynamic3DTextLabel(KadoLabel[f]);
		new rand = RandomEx(100,2000);
	    SetPVarInt(playerid,"IsiKado",GetPVarInt(playerid,"IsiKado")+rand);
	    PlayerInfo[playerid][pCash] += GetPVarInt(playerid,"IsiKado");
	    GivePlayerMoney(playerid, GetPVarInt(playerid,"IsiKado"));
	    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
	    SetPlayerChatBubble(playerid, "Mendapat Hadiah Uang", 0xBFF600FF, 20.0, 7000);
	    format(YogString1, 116, "~g~Mendapat Uang +$%i", GetPVarInt(playerid,"IsiKado")), GameTextForPlayer(playerid,YogString1, 5000, 1);
	    format(YogString1, sizeof(YogString1), "%s[%d] {FFFF00}Telah Membuka Kado Dari Dewa", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogString1);
	    SendClientMessage(playerid, COLOR_YELLOW, "Anda Membuka Kado Dari Dewa");
	}
	}
    else if(IsiKado == 2)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
		{
			f = a;
			break;
		}
	}
	if(f > MAX_KADO) return SendClientMessage(playerid, 0x33AA3300, "ERROR Tidak Ada Kado Disekitar");
	else
	{
		PosKado[f][0] = 0.0;
		PosKado[f][1] = 0.0;
		PosKado[f][2] = 0.0;

		DestroyDynamicObject(IdKado[f]);
		DestroyDynamic3DTextLabel(KadoLabel[f]);
		PlayerInfo[playerid][pRouble] += 50;
	    OnPlayerUpdateAccountsPer(playerid, "pRouble", PlayerInfo[playerid][pRouble]);
	    SetPlayerChatBubble(playerid, "Mendapat Hadiah Gold", 0xBFF600FF, 20.0, 7000);
	    GameTextForPlayer(playerid, "~b~Mendapat Gold +50", 5000, 1);
	    format(YogString1, sizeof(YogString1), "%s[%d] {FFFF00}Telah Membuka Kado Dari Dewa", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogString1);
	    SendClientMessage(playerid, COLOR_YELLOW, "Anda Membuka Kado Dari Dewa");
	}
    }
    else if(IsiKado == 3)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
		{
			f = a;
			break;
		}
	}
	if(f > MAX_KADO) return SendClientMessage(playerid, 0x33AA3300, "ERROR Tidak Ada Kado Disekitar");
	else
	{
		PosKado[f][0] = 0.0;
		PosKado[f][1] = 0.0;
		PosKado[f][2] = 0.0;

		DestroyDynamicObject(IdKado[f]);
		DestroyDynamic3DTextLabel(KadoLabel[f]);
		GivePlayerWeapon(playerid, 24, 10);
	    SetPlayerChatBubble(playerid, "Mendapat Hadiah Senjata", 0xBFF600FF, 20.0, 7000);
	    GameTextForPlayer(playerid, "~r~Mendapat Senjata DE", 5000, 1);
	    format(YogString1, sizeof(YogString1), "%s[%d] {FFFF00}Telah Membuka Kado Dari Dewa", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogString1);
	    SendClientMessage(playerid, COLOR_YELLOW, "Anda Membuka Kado Dari Dewa");
	  }
  	}
    else if(IsiKado == 4)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
		{
			f = a;
			break;
		}
	}
	if(f > MAX_KADO) return SendClientMessage(playerid, 0x33AA3300, "ERROR Tidak Ada Kado Disekitar");
	else
	{
		PosKado[f][0] = 0.0;
		PosKado[f][1] = 0.0;
		PosKado[f][2] = 0.0;

		DestroyDynamicObject(IdKado[f]);
		DestroyDynamic3DTextLabel(KadoLabel[f]);
		new rand = RandomEx(1,230);
		SetPlayerSkinEx(playerid, rand);
	    SetPlayerChatBubble(playerid, "Mendapat Hadiah Skin Trial", 0xBFF600FF, 20.0, 7000);
	    GameTextForPlayer(playerid, "~b~Mendapat Skin Trial", 5000, 1);
	    format(YogString1, sizeof(YogString1), "%s[%d] {FFFF00}Telah Membuka Kado Dari Dewa", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogString1);
	    SendClientMessage(playerid, COLOR_YELLOW, "Anda Membuka Kado Dari Dewa");
	}
    }
    else if(IsiKado == 5)
    {
    new f = MAX_KADO+1;
	for(new a = 0; a < sizeof(PosKado); a++)
	{
		if(IsPlayerInRangeOfPoint(playerid, 5.0, PosKado[a][0], PosKado[a][1], PosKado[a][2]))
		{
			f = a;
			break;
		}
	}
	if(f > MAX_KADO) return SendClientMessage(playerid, 0x33AA3300, "ERROR Tidak Ada Kado Disekitar");
	else
	{
		PosKado[f][0] = 0.0;
		PosKado[f][1] = 0.0;
		PosKado[f][2] = 0.0;

		DestroyDynamicObject(IdKado[f]);
		DestroyDynamic3DTextLabel(KadoLabel[f]);
		new rand = RandomEx(400, 600);
	    new Float:X,Float:Y,Float:Z;
	    GetPlayerPos(playerid, X,Y,Z);
		new carid = AddStaticVehicle(rand, X,Y,Z, 0.0, 3, 3);
		VehInfo[carid][vSost] = 100;
        VehInfo[carid][vStatus] = 2;
		Fuell[carid] = MAX_VEHICLE_FUEL;
		PutPlayerInVehicle(playerid, carid, 0);
		SetVehicleParamsEx(carid,1,0,0,0,0,0,0);
