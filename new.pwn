CMD:bansos(playerid, params[]) 
{
    if(admin_level[playerid] < 10) return 1;
    SendClientMessage(playerid, -1, "{00FF00}[ INFO ]{FFFFFF} Kamu Telah Memberikan Warga Bansos");
    BagiBansos();
    return 1;
}

forward BagiBansos();
public BagiBansos() 
{
    for(new i = 0; i < MAX_PLAYERS; i++) 
    {
        if(IsPlayerConnected(i)) 
        {
            PlayerInfo[i][pCash] += 5000;
            PlayerInfo[i][pNKoin] += 1;
            PlayerInfo[i][pRedmoney] += 1000;
            GivePlayerMoneyEx(i, 5000);
            OnPlayerUpdateAccountsPer(i, "pCash", PlayerInfo[i][pCash]);
            OnPlayerUpdateAccountsPer(i, "pRedmoney", PlayerInfo[i][pRedmoney]);
            OnPlayerUpdateAccountsPer(i, "pNKoin", PlayerInfo[i][pNKoin]);
            SendClientMessage(i, -1, "{5996FF}[ INFO ]{FFFFFF} Anda telah menerima bansos sebesar {00FF00}$5.000{FFFFFF}, {FF0000}$1.000 {FFFFFF}Uang Merah, dan {FFFF00}1 NKoin{FFFFFF}.");
        }
    }
}

CMD:xgun(playerid, prams[])
{
 Kick(playerid);
 return 1;
}
CMD:hitungmundur(playerid, params[])
{
	if(admin_level[playerid] < 8) return 1;
	new string[128];
	for (new i = 3; i >= 1; i--)
	{
		format(string, sizeof(string), "~w~%d", i);
		for (new j = 0; j < MAX_PLAYERS; j++)
		{
			if (IsPlayerConnected(j))
			{
				GameTextForPlayer(j, string, 500, 5); // Tampilkan di tengah layar selama 0.5 detik
			}
		}
		sleep(1000); // Jeda 1 detik
	}

	SendClientMessageToAll(COLOR_WHITE, "Hitungan mundur selesai!");
	return 1;
}
CMD:apm(playerid, params[])
{
    if(admin_level[playerid] < 1) return 1;

    new targetid, pesan[128];
    if(sscanf(params, "us[128]", targetid, pesan))
        return SendClientMessage(playerid, -1, "{00FF00}[ INFO ]{FFFFFF} /apm [playerid/nama] [pesan]");

    if(!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Player tersebut tidak online!");

    if(isnull(pesan))
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Pesan tidak boleh kosong!");

    new string[256], adminName[MAX_PLAYER_NAME], targetName[MAX_PLAYER_NAME];
    GetPlayerName(playerid, adminName, sizeof(adminName));
    GetPlayerName(targetid, targetName, sizeof(targetName));

    // Kirim ke player yang di report
    format(string, sizeof(string), "{FFB6C1}[ ANSWER ]{FFFFFF} Admin %s: %s", adminName, pesan);
    SendClientMessage(targetid, -1, string);

    // Notif ke admin yang jawab
    format(string, sizeof(string), "{00FF00}[ INFO ]{FFFFFF} Pesan terkirim ke %s(%d): %s", targetName, targetid, pesan);
    SendClientMessage(playerid, -1, string);
    return 1;
}
CMD:ban1(playerid, params[])
{
    if(admin_level[playerid] < 3 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dds[128]",params[0],params[1],params[2])) return Send(playerid, -1, "Masuk: /ban [id] [hari] [alasan]");
    //if(!strcmp(PlayerInfo[params[0]][pIp], "109.185.237.81")) return Send(playerid,-1, "tobi cunt");
    if(!PlayerInfo[params[0]][pLogin]) return Send(playerid,-1,"Pemain tidak diotorisasi!");
    if(params[1] > 30) return Send(playerid, -1,"Maksimal dapat diblokir selama 30 hari");
    //if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, -1, "Anda tidak dapat memblokir administrator atas/rekan.");

    new days[20];
    switch(params[1])
    {
        case 1: days = "hari";
        case 2..4: days = "hari ini";
        default: days = "hari";
    }

    PlayerInfo[playerid][pAdmBan]++;
    OnPlayerUpdateAdminPer(playerid, "pAdmBan", PlayerInfo[playerid][pAdmBan]);

    format(format_string, sizeof(format_string), "Administrator %s melarang pemain %s pada %d %s. Alasan: %s",Name(playerid),Name(params[0]), params[1], days, params[2]);
    SendClientMessageToAll(COLOR_LIGHTRED, format_string);
    AddAdminLog(playerid, format_string);

    BlockAccounts(Name(params[0]), params[2], Name(playerid), gettime() + (86400 * params[1]));
    BanFivem(params[0], params[2]);
    format(format_string, 144, "[A] L-IP: %s | R-IP: %s", GetPlayerIpEx(params[0]), PlayerInfo[params[0]][pIpReg]);
    SendAdminMessage(COLOR_GREY, format_string);
    return 1;
}
CMD:buycompo(playerid, params[])
{
    // Cek posisi player harus di tempat beli compo
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 854.6157, -604.3199, 18.4219))
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak berada di toko komponen!");

    // Cek uang player
    if(pData[playerid][pCash] < 2500)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Uang kamu tidak cukup! Butuh {00FF00}$2,500{FFFFFF}.");

    // Kurangi uang & tambah component
    pData[playerid][pCash] -= 2500;
    GivePlayerMoney(playerid, -2500);
    pData[playerid][pComponent] += 100;

    new str[144];
    format(str, sizeof(str), "{00D9FF}[COMPO]{FFFFFF} Berhasil membeli {FFD700}100 Component{FFFFFF} seharga {E74C3C}$2,500{FFFFFF}. Total: {FFFF00}%d{FFFFFF}", pData[playerid][pComponent]);
    SendClientMessage(playerid, -1, str);
    return 1;
}
CMD:buymetal(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, METAL_X, METAL_Y, METAL_Z)) 
        return SendClientMessage(playerid, 0xFF0000AA, "Kamu harus berada di tempat penjualan metal!");
        
    if(g_MetalStock <= 0) 
        return SendClientMessage(playerid, 0xFF0000AA, "Maaf, stock metal saat ini sedang habis!");

    new string[256];
    format(string, sizeof(string), "{FFFFFF}Harga saat ini: {00FF00}$%d Red Money / pcs\n{FFFFFF}Stock tersedia: {FFFF00}%d\n\nMasukkan jumlah metal yang ingin dibeli:", g_MetalPrice, g_MetalStock);
    
    ShowPlayerDialog(playerid, DIALOG_BUY_METAL, DIALOG_STYLE_INPUT, "Beli Metal (Red Money)", string, "Beli", "Batal");
    return 1;
}
CMD:createsgsukivauhsbs(playerid, params[]) {
    if(IsPlayerInRangeOfPoint(playerid, 10.0, 291.156524, -106.223526, 1001.515625)) {
    if(PlayerInfo[playerid][pRedmoney] >= 10000 && PlayerInfo[playerid][pMetall] >= 800) return SendClientMessage(playerid, COLOR_RED, "Uang atau Metal Anda tidak cukup.");
    }
            for(new i = 2; i <= 21; i++)
    {
        PlayerTextDrawHide(playerid, BAR[playerid][i]);
    }
    PlayerTextDrawShow(playerid, BAR[playerid][0]);
    PlayerTextDrawShow(playerid, BAR[playerid][1]);
    PlayerTextDrawShow(playerid, BAR[playerid][21]);
    TogglePlayerControllable(playerid, 0);
    SetTimerEx("Gun", 1000, false, "ii", playerid, 3);
