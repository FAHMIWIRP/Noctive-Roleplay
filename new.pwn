CMD:tutuppjehwjwhbwwj(playerid, params[])
{
    new amount, id;
    if(sscanf(params, "ii", amount, id))
        return SendClientMessage(playerid, COLOR_GREY, "Gunakan: /payrm [jumlah] [id]");
    if(amount < 1)
        return SendClientMessage(playerid, COLOR_GREY, "Jumlah harus lebih dari 0!");
    if(pData[playerid][pRedmoney] < amount)
        return SendClientMessage(playerid, COLOR_GREY, "Anda tidak memiliki cukup Redmoney!");
    
    pData[id][pRedmoney] += amount;
    
    SendClientMessage(playerid, COLOR_GREEN, "Anda Telah Memberikan Redmoney Kepada Orang Lain!");
    SendClientMessage(id, COLOR_GREEN, "Anda Telah Menerima Redmoney dari Orang Lain!");
    
    // Update database atau simpan data
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    
    return 1;
}

CMD:jdlek(playerid, params[])
{
    new amount, id;
    if(sscanf(params, "ii", amount, id))
        return SendClientMessage(playerid, COLOR_GREY, "Gunakan: /givemetal [jumlah] [id]");
    if(amount < 1)
        return SendClientMessage(playerid, COLOR_GREY, "Jumlah harus lebih dari 0!");
    if(pData[playerid][pMetall] < amount)
        return SendClientMessage(playerid, COLOR_GREY, "Anda tidak memiliki cukup Metall!");
    
    pData[id][pMetall] += amount;
    
    SendClientMessage(playerid, COLOR_GREEN, "Anda telah memberikan Metall ke pemain lain!");
    SendClientMessage(id, COLOR_GREEN, "Anda telah menerima Metall dari pemain lain!");
    
    // Update database atau simpan data
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    
    return 1;
}

CMD:dweb(playerid, params[]) 
{ 
    if (!IsPlayerConnected(playerid)) return SendClientMessage(playerid, 0xFFFFFF, "Anda tidak terhubung ke server!");
    new string[128];
    format(string, sizeof(string), "{666666}[DARKWEB] {FFFFFF}Unknown: %s", params);
    SendClientMessageToAll(-1, string);
    return 1;
}
CMD:rules(playerid, params[])
{
	SPD(playerid, 28367, DIALOG_STYLE_LIST, "Arti Break Rules", ""W"1. IC - In Character Artinya segala sesuatu yang ada dikarakter kita. Contoh : - Uang - Kendaraan - Senjata, DLL.\n\
	2. OOC - Out Of Character Artinya segala sesuatu yang ada diluar karakter kita. Contoh : Ya, kalian tau sendiri lah hal yang ada diluar game.\n\
	3. MG - MetaGaming Artinya adalah kalian menggunakan saran / informasi OOC untuk keperluan IC Contoh : Kalian menggunakan /pm untuk menanyakan lokasi. /pm itu kan sifatnya OOC.\n\
	4. PG - Power Gaming Artinya adalah kalian melakukan hal mustahil yang tidak akan pernah bisa kalian lakukan di kehidupan nyata namun dapat dilakukan didalam game. Contoh : Kalian melakukan Roleplay mengambil RPG dari saku celana.\n\
	5. Mixxing Artinya adalah kalian mencampurkan hal berbau OOC kedalam IC atau sebaliknya. Contoh : Nanyain alamat menggunakan /b\n\
	6. Chicken Running Artinya kalian berlari zig-zag untuk menghindari tembakan. Contoh? kayaknya nggak perlu deh, kan udah dijelasin Smile\n\
	7. CR - Car Ramming Artinya kalian menabrakkan kendaraan kalian keorang tanpa alasan atau bermaksud untuk trolling.\n\
	8. Olympic Swimming - OS Artinya kalian menceburkan / melarikan diri ke air dan menyelam untuk menghindari tembakan / shootout\n\
	9. Refusing RP Artinya kalian menolak ajakkan roleplay dari seseorang. Contoh : Kalian lagi mancing, terus ada orang dateng dan RP memukul kalian. tapi kalian tidak membalas RP'nya sama sekali.\n\
	10. Logging to Avoid Artinya kalian melarikan diri dari situasi roleplay menggunakan /q Contoh : Lagi dikejar polisi terus /q\n\
    11. Retard RP Artinya kalian memperlambat roleplay. Contoh : Ada lawan rp kalian menulis * /do Conditions * tapi kalian sengaja dilama lamain.\n\
	12. Car Jacking Car Jacking artinya kalo membajak atau mencuri kendaraan orang ditempat umum Contoh : Ada orang baru markir mobil, terus kalian langsung ngemaling tuh mobil.\n\
	13. Ninja Jacking NJ artinya kalian mencuri mobil orang dengan menekan tombol * F * atau * ENTER *.\n\
	14. Death Matching DM artinya kalian membunuh orang tanpa alasan yang jelas.\n\
	15. KOS - Killing On Sight KOS artinya kalian membunuh orang tanpa diketahui orang itu, untuk menghindari OOC Jail oleh admin. Contoh : Membunuh orang menggunakan Sniper padahal orang itu tidak punya salah.\n\
	16. Happy Triggering HT artinya kalian menembak nembakkan senjata kalian tanpa alasan / sesuka hati.\n\
	17. Ramboing Ramboing artinya kalian membawa senjata yang sangat banyak.\n\
	18. Money Farming MF artinya kalian membuat account baru dan men-transfer uangnya ke account utama kalian\n\
	19. Money Machine MM artinya adalah kalian lebih mementingkan uang daripada ber-roleplay Contoh : Bekerja terus menerus tanpa adanya roleplay sedikitpun.\n\
	20. Account Sharing Acc Share artinya kalian memberikan username dan password kalian kepada orang lain.\n\
	21. OOC lie OOC lie artinya kalian berbohong di channel OOC. Contoh : saat ditanya lewat /b kalian malah berbohong\n\
	22. Terorsm Action Terorsm Action artinya kalian melakukan aksi terorisme. Contoh : Menyandra Gubernur Melakukan penge-boman\n\
	23. Ban Evading Artinya Jika account kalian dibanned, kalian malah membuat account baru dan meminta unban kepada admin.\n\
	24. OOC Insult OOC Insult artinya kalian menghina player di OOC Channel Contoh : kalian menggunakan /b untuk menghina orang.\n\
	25. Flamming Flamming artinya kalian menyindir orang di OOC Channel Contohnya sama seperti OOC Insult namun yang ini menyindir, bukan menghina.\n\
	26. Exploiting Server Bug. Artinya kalian memanfaatkan BUG yang ada diserver untuk kepentingan kalian.\n\
	27. Looting / Robbing after killing. Artinya kalian merampok harta orang yang kalian bunuh.\n\
	28. Refill at War Artinya kalian mengisi ulang darah kalian menggunakan pot atau first aid kit saat berperang / shootout.\n\
	29. Revenge Kill Artinya kalian membunuh orang yang baru saja membunuh kalian. * Harus menunggu 30 menit sebelum melakukan RP Shootout dengan orang yang membunuh kalian\n\
	30. Provoking LEO Artinya kalian menghina LEO agar mengejar kalian.","","Tutup");
	return 1;
}
