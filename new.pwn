stock FormatMoney(amount)
{
    new txt[16];
    format(txt, sizeof(txt), "%d", amount);
    new l = strlen(txt);
    for (new i = l - 3; i > 0; i -= 3)
    {
        strins(txt, ".", i);
    }
    return txt;
}




//lemari
enum YInfo
{
	YTshirt,
	YDrugs,
	YGun,
	YAmmo,
	YCompo,
	Float: YStoreX,
	Float: YStoreY,
	Float: YStoreZ,
	Text3D: YLabel,
	YVw,
	YInt
}
new YogInfo[MAX_LEMARI][YInfo];
new IdYog[MAX_LEMARI];

SaveYog()
{
    new file[128];
	for(new i= 1; i < MAX_LEMARI; i++)
	{
        if(IdYog[i] == 0) continue;
	    format(file, sizeof(file), "YogLemari/%d.ini", i);
	    if(INI_Open(file))
	    {
	        INI_WriteInt("Tshirt",YogInfo[i][YTshirt]);
	        INI_WriteInt("Drugs",YogInfo[i][YDrugs]);
	        INI_WriteInt("Gun",YogInfo[i][YGun]);
	        INI_WriteInt("Ammo",YogInfo[i][YAmmo]);
	        INI_WriteInt("Compo",YogInfo[i][YCompo]);
	        INI_WriteFloat("StoreX",YogInfo[i][YStoreX]);
        	INI_WriteFloat("StoreY",YogInfo[i][YStoreY]);
        	INI_WriteFloat("StoreZ",YogInfo[i][YStoreZ]);
        	INI_WriteInt("Vw",YogInfo[i][YVw]);
        	INI_WriteInt("Int",YogInfo[i][YInt]);
			INI_Save();
			INI_Close();
		}
	}
	return 1;
}
stock GetPlayerFps(playerid)
{
    SetPVarInt(playerid, "DrunkL", GetPlayerDrunkLevel(playerid));
    if(GetPVarInt(playerid, "DrunkL") < 100) SetPlayerDrunkLevel(playerid, 2000);
    else
    {
        if(GetPVarInt(playerid, "LDrunkL") != GetPVarInt(playerid, "DrunkL"))
        {
            SetPVarInt(playerid, "FPS", (GetPVarInt(playerid, "LDrunkL") - GetPVarInt(playerid, "DrunkL")));
            SetPVarInt(playerid, "LDrunkL", GetPVarInt(playerid, "DrunkL"));
            if((GetPVarInt(playerid, "FPS") > 0) && (GetPVarInt(playerid, "FPS") < 256)) return GetPVarInt(playerid, "FPS") - 1;
        }
    }
    return 0;
}
stock GetPlayerNameEx(playerid)
{
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, MAX_PLAYER_NAME);
    return name;
}
stock GetAllPlayer()
{
    new count = 0;
    foreach(new i : Player)
    {
        count++;
    }
    return count;
}
stock GetName(playerid)
{
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, MAX_PLAYER_NAME);
    return name;
}
stock GetIDName(playerid)
{
    new name[64];
    GetPlayerName(playerid, name, MAX_PLAYER_NAME);
    return name;
}
stock GetPlayerSpeed(playerid)
{
	new Float: x, Float: y, Float: z;
	if(IsPlayerInAnyVehicle(playerid))
	{
		GetVehicleVelocity(GetPlayerVehicleID(playerid), x, y, z);
	}
	else GetPlayerVelocity(playerid, x, y, z);

	return floatround(floatsqroot(x*x+y*y+z*z)*100);
}
SetPlayerPosition(playerid, Float:X, Float:Y, Float:Z, Float:a, inter = 0)
{
    SetPlayerInterior(playerid, inter);
    SetPlayerPos(playerid, X, Y, Z);
	SetPlayerFacingAngle(playerid, a);
	SetCameraBehindPlayer(playerid);
	//SetPlayerWorldBounds(playerid, 20000, -20000, 20000, -20000);
}

Everyone(color, const text[], {Float, _}:...)
{
    static
        args,
            str[144];

    if((args = numargs()) == 2)
    {
            SendClientMessageToAll(color, text);
    }
    else
    {
        while (--args >= 2)
        {
            #emit LCTRL 5
            #emit LOAD.alt args
            #emit SHL.C.alt 2
            #emit ADD.C 12
            #emit ADD
            #emit LOAD.I
            #emit PUSH.pri
        }
        #emit PUSH.S text
        #emit PUSH.C 144
        #emit PUSH.C str
        #emit LOAD.S.pri 8
        #emit ADD.C 4
        #emit PUSH.pri
        #emit SYSREQ.C format
        #emit LCTRL 5
        #emit SCTRL 4

        SendClientMessageToAll(color, str);

        #emit RETN
    }
    return 1;
}

SendClientMessageEx(playerid, color, const text[], {Float, _}:...)
{
    static
        args,
            str[144];

    if((args = numargs()) == 3)
    {
            SendClientMessage(playerid, color, text);
    }
    else
    {
        while (--args >= 3)
        {
            #emit LCTRL 5
            #emit LOAD.alt args
            #emit SHL.C.alt 2
            #emit ADD.C 12
            #emit ADD
            #emit LOAD.I
            #emit PUSH.pri
        }
        #emit PUSH.S text
        #emit PUSH.C 144
        #emit PUSH.C str
        #emit PUSH.S 8
        #emit SYSREQ.C format
        #emit LCTRL 5
        #emit SCTRL 4

        SendClientMessage(playerid, color, str);

        #emit RETN
    }
    return 1;
}
stock LoadYog()
{
    new dStr[128];
    new file[128];
	for(new idx=1; idx<MAX_LEMARI; idx++)
	{
		format(file, sizeof(file), "YogLemari/%d.ini", idx);
	    if(fexist(file) && INI_Open(file))
	    {
            YogInfo[idx][YTshirt] = INI_ReadInt("Tshirt");
            YogInfo[idx][YDrugs] = INI_ReadInt("Drugs");
            YogInfo[idx][YGun] = INI_ReadInt("Gun");
            YogInfo[idx][YAmmo] = INI_ReadInt("Ammo");
            YogInfo[idx][YCompo] = INI_ReadInt("Compo");
            YogInfo[idx][YStoreX] = INI_ReadFloat("StoreX");
            YogInfo[idx][YStoreY] = INI_ReadFloat("StoreY");
            YogInfo[idx][YStoreZ] = INI_ReadFloat("StoreZ");
            YogInfo[idx][YVw] = INI_ReadInt("Vw");
            YogInfo[idx][YInt] = INI_ReadInt("Int");
            format(dStr, sizeof(dStr), "Lemari ID: %d\n{FFFFFF}Gunakan /use", idx);
            YogInfo[idx][YLabel] = CreateDynamic3DTextLabel(dStr, COLOR_YELLOW, YogInfo[idx][YStoreX], YogInfo[idx][YStoreY], YogInfo[idx][YStoreZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, YogInfo[idx][YVw], YogInfo[idx][YInt]);

			IdYog[idx] = 1;

			INI_Close();
		}
	}
	return 1;
}
stock YogValid()
{
	for(new i = 1; i<MAX_LEMARI; i++)
	{
	    if(IdYog[i] == 0) return i;
	}
	return -1;
}
