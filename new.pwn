stock DialogAvtorizatia(playerid)
{
    format(String, 244, ""W"Selamat datang di {ff7f00}Noctive{ffffff}\n\
	Untuk memasuki permainan, Anda harus memasukkan kata sandi\n\n\
	Nama Karakter Kamu: {a86cfc}%s\n\n\
	"W"Masukkan kata sandi:",Name(playerid));

	SPD(playerid,1,DIALOG_STYLE_INPUT, !"Login",String,
	!"Masuk", !"Batalkan");
	return true;
}

stock PromoReg(playerid)
{
	SPD(playerid,4,DIALOG_STYLE_INPUT, !"Sistem rujukan",
	!""W"\t\t\tJika Anda mengetahui tentang server kami dari teman Anda\n\
	\t\t\tyang bermain di sini, tunjukkan julukannya di bidang di bawah ini\n\
	\t\t{ffffff}Ketika Anda mencapai {a86cfc}4{ffffff} level dia akan menerima hadiah\n\n\
	{ffffff}Jika sudah {FF0000}kode promosi{ffffff}, masukkan di kotak di bawah ini.\n\n{a86cfc}Fitur Kode Promosi:\n\
	{a86cfc}-{ffffff} x2 EXP selama level pertama.\n\
	{a86cfc}-{ffffff} Setelah mencapai level 4, Anda akan menerima bonus dalam bentuk mata uang karena memasukkan kode promosi.\n\
	{a86cfc}-{ffffff} Anda dapat memasukkan kode promosi secara eksklusif melalui *{FF0000}#{ffffff}* {afafaf}(Contoh: promo)",
	!"Masuk", !"Lewati");
	return true;
}
stock ShowRouleteInfo(playerid)
{
	String = "\n{ffffff}Cobalah keberuntungan Anda dan menjadi keberuntungan!\n\
	Hanya dengan roulette {ffff00}Azino777{ffffff}\n\
	Anda dapat mencoba keberuntungan Anda untuk kekuatan! \n\
	{FA8072}Hadiah yang mungkin jatuh: \n\
	{ffffff}- Exp\n\
	- Ketaatan hukum\n\
	- Uang\n\
	- Gold\n\
	- Mobil unik\n\
	- VIP\n\
	- Kulit yang unik\n\n\
	Biaya satu gulungan adalah: {ffff00}40{ffffff} Gold";
	return SPD(playerid, 238, DIALOG_STYLE_MSGBOX, "Lucky Spin", String, "Setuju", "Batal");
}

