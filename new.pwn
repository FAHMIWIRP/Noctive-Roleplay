CMD:wt(playerid, params[])
{
    if(PlayerInfo[playerid][pInjured] >= 1) return 1;
    if(pData[playerid][pRadio] == 0)
    {
        if(isnull(params))
        {
            Send(playerid, COLOR_WHITE, "{B0C4DE}SYNTAX:{FFFFFF} /wt [chat]");
            Send(playerid, COLOR_WHITE, "[Hint] Type /setfreq to set the frequency of your portable radio.");
            return 1;
        }

        if(pData[playerid][pRadioFreq] >= 1 || pData[playerid][pRadioFreq] <= -1)
        {
            RadioBroadCast(playerid, COLOR_GREY, params);
            return 1;
        }
        else
        {
            Send(playerid, COLOR_WHITE, "The frequency of your radio is set to 0, you can not broadcast over that frequency.");
        }
    }
    return 1;
}

CMD:setfreq(playerid, params[])
{
    new string[128], frequency;
    if(sscanf(params, "d", frequency))
    {
        Send(playerid, COLOR_WHITE, "{B0C4DE}INFO:{FFFFFF} /setfreq [frequency]");
        Send(playerid, COLOR_WHITE, "[Hint] Set the frequency of your radio to 0 if you don't want to hear anything.");
        return 1;
    }

    if(frequency > 9999999 || frequency < -9999999) { Send(playerid, COLOR_GREY, "Frequency can not be lower than -9999999 or higher than 9999999!"); return 1; }
    if (pData[playerid][pRadio] == 0)
    {
        pData[playerid][pRadioFreq] = frequency;
        format(string, sizeof(string), "You have set the frequency of your portable radio to %d khz.",frequency);
        Send(playerid, COLOR_WHITE, string);
    }
    // simpan frekuensi lama
    new oldFreq = RadioFreq[playerid];
     new freq;
    // NOTIF KELUAR CHANNEL LAMA
    if(oldFreq != 0)
    {
        new name[MAX_PLAYER_NAME], text[128];
        GetPlayerName(playerid, name, sizeof name);
        format(text, sizeof text, "[RADIO] %s keluar dari channel.", name);

        for(new i = 0; i < MAX_PLAYERS; i++)
        {
            if(IsPlayerConnected(i) && RadioFreq[i] == oldFreq && i != playerid)
            {
                SendClientMessage(i, 0xA9A9A9FF, text); // abu-abu gelap
            }
        }
    }

    // detach dari frekuensi lama
    if(PlayerRadioStream[playerid] != SV_NULL)
    {
        SvDetachListenerFromStream(PlayerRadioStream[playerid], playerid);
        PlayerRadioStream[playerid] = SV_NULL;
    }

    if(freq == 0)
    {
        RadioFreq[playerid] = 0;
        SendClientMessage(playerid, -1, "Radio dimatikan (frekuensi 0).");
        return 1;
    }

    if(freq < 0 || freq >= 1000)
        return SendClientMessage(playerid, -1, "Frequency tidak valid.");

    RadioFreq[playerid] = freq;

	PlayerInfo[playerid][pRadioFreq] = freq;
	update_int_mysql(playerid, "pRadioFreq", freq);

    // NOTIF MASUK CHANNEL BARU
    new name[MAX_PLAYER_NAME], text[128];
    GetPlayerName(playerid, name, sizeof name);
    format(text, sizeof text, "[RADIO] %s masuk ke dalam channel.", name);

    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && RadioFreq[i] == freq && i != playerid)
        {
            SendClientMessage(i, 0xA9A9A9FF, text); // abu-abu gelap
        }
    }
    return 1;
}
CMD:treatment(playerid, params[])
{
    new targetid;

    if(!IsAMedic(playerid) && (admin_level[playerid] < 1 )) return SCM(playerid, COLOR_GREY, "Anda Bukan Profesi Medis");

    if(sscanf(params, "u", targetid))
    {
        return Info(playerid, "/treatment [playerid]");
    }

    if(!ProxDetectorS(4.0, playerid, targetid)) return SendClientMessage(playerid, 0xB4B5B7FF,"Pemain terlalu jauh");

    if(!IsPlayerConnected(targetid))
    {
        return Info(playerid, "Tidak Ada Player ID Seperti Itu");
    }

    PlayerInfo[playerid][pStress] -= 0;

    SetPlayerDrunkLevel(targetid, 0);

    Info(targetid, "You Have Been Treatment By %s", Name(playerid));
    Info(playerid, "You Has Treatment %s", Name(targetid));
    return 1;
}
