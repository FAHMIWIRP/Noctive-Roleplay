    if(PlayerInfo[playerid][pFamily]!= -1)
        return SCM(playerid, 0xFF0000FF, "ERROR: {FFFFFF}Kamu sudah tergabung dalam sebuah family!");

    // Cek gold/rouble cukup
    if(PlayerInfo[playerid][pRouble] < 1000)
        return SCM(playerid, 0xAFAFAFFF, "Kamu tidak punya cukup Gold. {FFD700}[Butuh: 1000 Gold]");

    // Kalau semua lolos, tampilin dialog
    ShowPlayerCreateFamilyDialog(playerid, 1);
    return 1;
