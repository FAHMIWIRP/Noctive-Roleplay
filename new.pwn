CMD:setrm(playerid, params[])
{
    // 1. Cek apakah yang mengetik perintah adalah Admin (Sesuaikan variabel admin servermu)
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

    new targetid, jumlah;
    // 2. Gunakan sscanf untuk mengambil parameter ID target dan Jumlah uang
    if(sscanf(params, "ui", targetid, jumlah))
        return SendClientMessage(playerid, -1, "{FFFF00}[USAGE]: {FFFFFF}/setrm [PlayerID] [Jumlah]");

    // 3. Cek apakah pemain target sedang online
    if(targetid == INVALID_PLAYER_ID)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Pemain tersebut tidak online.");

    // 4. Kalkulasi penambahan atau pengurangan uang merah
    new uangLama = PlayerInfo[targetid][pRedmoney];
    new uangBaru = uangLama + jumlah;

    // Antisipasi agar uang merah tidak minus di bawah 0
    if(uangBaru < 0) uangBaru = 0;

    // 5. Terapkan nilai baru ke variabel pemain
    PlayerInfo[targetid][pRedmoney] = uangBaru;

    // 6. Simpan langsung ke database/file akun menggunakan fungsi bawaan servermu
    OnPlayerUpdateAccountsPer(targetid, "pRedmoney", PlayerInfo[targetid][pRedmoney]);

    // 7. Kirim notifikasi ke Admin dan ke Pemain Target
    new strAdmin[128], strTarget[128], nameAdmin[MAX_PLAYER_NAME], nameTarget[MAX_PLAYER_NAME];
    GetPlayerName(playerid, nameAdmin, sizeof(nameAdmin));
    GetPlayerName(targetid, nameTarget, sizeof(nameTarget));

    if(jumlah >= 0)
    {
        format(strAdmin, sizeof(strAdmin), "{00FF00}[ADMIN]: {FFFFFF}Anda berhasil memberikan %s uang merah sebanyak {FF0000}$%d{FFFFFF}.", nameTarget, jumlah);
        format(strTarget, sizeof(strTarget), "{00FF00}[ADMIN]: {FFFFFF}Admin %s memberikan Anda uang merah sebanyak {FF0000}$%d{FFFFFF}.", nameAdmin, jumlah);
    }
    else
    {
        format(strAdmin, sizeof(strAdmin), "{00FF00}[ADMIN]: {FFFFFF}Anda berhasil mengambil uang merah %s sebanyak {FF0000}$%d{FFFFFF}.", nameTarget, -jumlah);
        format(strTarget, sizeof(strTarget), "{FF0000}[ADMIN]: {FFFFFF}Admin %s mengambil uang merah Anda sebanyak {FF0000}$%d{FFFFFF}.", nameAdmin, -jumlah);
    }

    SendClientMessage(playerid, -1, strAdmin);
    SendClientMessage(targetid, -1, strTarget);
    return 1;
}
