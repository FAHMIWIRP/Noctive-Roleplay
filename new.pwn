new PinWatchdog[MAX_PLAYERS];

forward PinWatchdogCB(playerid);
public PinWatchdogCB(playerid)
{
    if (!IsPlayerConnected(playerid) || !pinIsOpen[playerid])
    {
        PinWatchdog[playerid] = 0;
        return 0;
    }
    TogglePlayerControllable(playerid, false); // tegakkan ulang pembekuan
    return 1;
}

stock PinMulaiWatchdog(playerid)
{
    if (PinWatchdog[playerid]) KillTimer(PinWatchdog[playerid]);
    PinWatchdog[playerid] = SetTimerEx("PinWatchdogCB", 1500, true, "i", playerid);
}

stock PinHentikanWatchdog(playerid)
{
    if (PinWatchdog[playerid]) { KillTimer(PinWatchdog[playerid]); PinWatchdog[playerid] = 0; }
}
stock PinShowHeaderSekali(playerid)
{
    for (new i = 0; i < 5; i++)
    {
        PlayerTextDrawShow(playerid, PINHEADER[playerid][i]);
        PlayerTextDrawShow(playerid, PlayerText:(8 + i));
    }
}
stock PinProbe(playerid)
{
    // Huruf BESAR = handle tdpin/PINHEADER (index 8-12)
    // Huruf kecil  = slot mentah 8-12
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][0], "A"); PlayerTextDrawShow(playerid, PINHEADER[playerid][0]);
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][1], "B"); PlayerTextDrawShow(playerid, PINHEADER[playerid][1]);
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][2], "C"); PlayerTextDrawShow(playerid, PINHEADER[playerid][2]);
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][3], "D"); PlayerTextDrawShow(playerid, PINHEADER[playerid][3]);
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][4], "E"); PlayerTextDrawShow(playerid, PINHEADER[playerid][4]);

    PlayerTextDrawSetString(playerid, PlayerText:8,  "a"); PlayerTextDrawShow(playerid, PlayerText:8);
    PlayerTextDrawSetString(playerid, PlayerText:9,  "b"); PlayerTextDrawShow(playerid, PlayerText:9);
    PlayerTextDrawSetString(playerid, PlayerText:10, "c"); PlayerTextDrawShow(playerid, PlayerText:10);
    PlayerTextDrawSetString(playerid, PlayerText:11, "d"); PlayerTextDrawShow(playerid, PlayerText:11);
    PlayerTextDrawSetString(playerid, PlayerText:12, "e"); PlayerTextDrawShow(playerid, PlayerText:12);
}
stock PinBangunHeader(playerid)
{
    new Float:hx[5] = { 281.000, 291.000, 301.000, 312.000, 323.000 };

    for (new i = 0; i < 5; i++)
    {
        // buang slot lama yang rusak/tersembunyi
        if (tdpin[playerid][8 + i] != PlayerText:INVALID_TEXT_DRAW)
            PlayerTextDrawDestroy(playerid, tdpin[playerid][8 + i]);

        // buat ulang slot header sesuai desain asli
        PINHEADER[playerid][i] = tdpin[playerid][8 + i] = CreatePlayerTextDraw(playerid, hx[i], 154.000, "_");
        PlayerTextDrawLetterSize(playerid, tdpin[playerid][8 + i], 0.349, 1.899);
        PlayerTextDrawAlignment(playerid, tdpin[playerid][8 + i], 1);
        PlayerTextDrawColor(playerid, tdpin[playerid][8 + i], -1);
        PlayerTextDrawSetShadow(playerid, tdpin[playerid][8 + i], 1);
        PlayerTextDrawSetOutline(playerid, tdpin[playerid][8 + i], 1);
        PlayerTextDrawBackgroundColor(playerid, tdpin[playerid][8 + i], 150);
        PlayerTextDrawFont(playerid, tdpin[playerid][8 + i], 1);
        PlayerTextDrawSetProportional(playerid, tdpin[playerid][8 + i], 1);
        PlayerTextDrawShow(playerid, tdpin[playerid][8 + i]);
    }
} 	
stock PinTulisHeader(playerid, pos, const teks[])
{
    PlayerTextDrawSetString(playerid, PINHEADER[playerid][pos], teks);
}

stock PinResetVisible(playerid)
{
    for (new i = 0; i < 5; i++) PinTulisHeader(playerid, i, "_");
}

stock PinSaveToDB(playerid)
{
    new q[192];
    mysql_format(mMysql, q, sizeof(q),
        "UPDATE `accounts` SET `has_pin` = 1, `pin` = '%e' WHERE `pID` = %d",
        pAccountPIN[playerid], PlayerInfo[playerid][pID]);
    mysql_tquery(mMysql, q);
}
public PinBukaTerlambat(playerid)
{
    if (!IsPlayerConnected(playerid)) return 0;
    if (pinIsOpen[playerid]) return 0;
    if (!PinSelesai[playerid]) return 0;

    TogglePlayerControllable(playerid, false);
    OpenPinPad(playerid, !pAccountHasPIN[playerid]);
    PinBuatDisplay(playerid);
    PinMulaiWatchdog(playerid);
    return 1;
}
stock PinBuatDisplay(playerid)
{
    for (new i = 8; i <= 12; i++) // sembunyikan slot lama yang bermasalah
    {
        if (tdpin[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            PlayerTextDrawHide(playerid, tdpin[playerid][i]);
    }

    if (PinDisplay[playerid] != PlayerText:INVALID_TEXT_DRAW)
        PlayerTextDrawDestroy(playerid, PinDisplay[playerid]);

    PinDisplay[playerid] = CreatePlayerTextDraw(playerid, 281.000, 154.000, "_ _ _ _ _");
    PlayerTextDrawLetterSize(playerid, PinDisplay[playerid], 0.349, 1.899);
    PlayerTextDrawAlignment(playerid, PinDisplay[playerid], 1);
    PlayerTextDrawColor(playerid, PinDisplay[playerid], -1);
    PlayerTextDrawSetShadow(playerid, PinDisplay[playerid], 1);
    PlayerTextDrawSetOutline(playerid, PinDisplay[playerid], 1);
    PlayerTextDrawBackgroundColor(playerid, PinDisplay[playerid], 150);
    PlayerTextDrawFont(playerid, PinDisplay[playerid], 1);
    PlayerTextDrawSetProportional(playerid, PinDisplay[playerid], 1);
    PlayerTextDrawShow(playerid, PinDisplay[playerid]);
}

stock PinDisplayRefresh(playerid)
{
    new str[24];
    for (new i = 0; i < 5; i++)
    {
        if (i > 0) strcat(str, " ");
        if (i < pinBufferLen[playerid])
        {
            new tmp[4];
            format(tmp, sizeof(tmp), "%d", PinDigits[playerid][i]);
            strcat(str, tmp);
        }
        else strcat(str, "_");
    }
    PlayerTextDrawSetString(playerid, PinDisplay[playerid], str);
}

stock PinBufferReset(playerid)
{
    pinBufferLen[playerid] = 0;
    pinBuffer[playerid][0] = '\0';
    PinDisplayRefresh(playerid);
}

stock PinClickDigit(playerid, digit)
{
    if (pinBufferLen[playerid] >= PIN_LENGTH) return 0;
    new pos = pinBufferLen[playerid];
    PinDigits[playerid][pos] = digit;
    pinBuffer[playerid][pos] = pinDigitChar[digit];
    pinBufferLen[playerid]++;
    pinBuffer[playerid][pinBufferLen[playerid]] = '\0';
    PinDisplayRefresh(playerid);
    return 1;
}

stock PinClickX(playerid)
{
    if (pinBufferLen[playerid] <= 0) return 0;
    pinBufferLen[playerid]--;
    pinBuffer[playerid][pinBufferLen[playerid]] = '\0';
    PinDisplayRefresh(playerid);
    return 1;
}

stock PinCloseSafe(playerid)
{
    PinHentikanWatchdog(playerid);
    if (pinTimer[playerid] != 0) { KillTimer(pinTimer[playerid]); pinTimer[playerid] = 0; }
    CancelSelectTextDraw(playerid);
    for (new i = 0; i < 39; i++) PlayerTextDrawHide(playerid, tdpin[playerid][i]);
    if (PinDisplay[playerid] != PlayerText:INVALID_TEXT_DRAW)
    {
        PlayerTextDrawHide(playerid, PinDisplay[playerid]);
        PlayerTextDrawDestroy(playerid, PinDisplay[playerid]);
        PinDisplay[playerid] = PlayerText:INVALID_TEXT_DRAW;
    }
    pinIsOpen[playerid] = false;
    pinAwaitingConfirm[playerid] = false;
}

stock PinClickDone(playerid)
{
    if (pinBufferLen[playerid] < PIN_LENGTH)
    {
        ShowPanjulNotif(playerid, "PIN belum lengkap!");
        return 0;
    }

    if (pinIsCreating[playerid])
    {
        if (!pinAwaitingConfirm[playerid])
        {
            format(pinFirstEntry[playerid], sizeof(pinFirstEntry[]), "%s", pinBuffer[playerid]);
            pinAwaitingConfirm[playerid] = true;
            PinBufferReset(playerid);
            ShowPanjulNotif(playerid, "Masukkan ulang PIN yang sama untuk konfirmasi.");
        }
        else
        {
            if (!strcmp(pinFirstEntry[playerid], pinBuffer[playerid]))
            {
                format(pAccountPIN[playerid], sizeof(pAccountPIN[]), "%s", pinBuffer[playerid]);
                pAccountHasPIN[playerid] = true;
                PinSaveToDB(playerid);
                ShowPanjulNotif(playerid, "PIN berhasil dibuat dan disimpan!");
                CallLocalFunction("OnPinCreated", "is", playerid, pAccountPIN[playerid]);
                PinCloseSafe(playerid);
                TogglePlayerControllable(playerid, true);
            }
            else
            {
                ShowPanjulNotif(playerid, "Konfirmasi tidak cocok. Silakan ulangi dari awal.");
                pinAwaitingConfirm[playerid] = false;
                PinBufferReset(playerid);
            }
        }
        return 1;
    }

    if (!strcmp(pAccountPIN[playerid], pinBuffer[playerid]))
    {
        ShowPanjulNotif(playerid, "PIN benar!");
        CallLocalFunction("OnPinVerifySuccess", "i", playerid);
        PinCloseSafe(playerid);
        TogglePlayerControllable(playerid, true);
    }
    else
    {
        pinAttemptsLeft[playerid]--;
        PinBufferReset(playerid);
        GameTextForPlayer(playerid, "~r~PIN SALAH!", 3000, 3);
        if (pinAttemptsLeft[playerid] <= 0)
        {
            ShowPanjulNotif(playerid, "PIN salah 3 kali. Kamu akan di-kick.");
            CallLocalFunction("OnPinLockedOut", "i", playerid);
            PinCloseSafe(playerid);
            SetTimerEx("PinKickCB", 2000, false, "i", playerid);
        }
        else
        {
            new msg[64];
            format(msg, sizeof(msg), "PIN salah! Sisa percobaan: %d", pinAttemptsLeft[playerid]);
            ShowPanjulNotif(playerid, msg);
            CallLocalFunction("OnPinVerifyFail", "ii", playerid, pinAttemptsLeft[playerid]);
        }
    }
    return 1;
}
public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if (!pinIsOpen[playerid]) return 0;
    if (playertextid == PlayerText:INVALID_TEXT_DRAW) return 1;

    if (playertextid == PlayerText:25 || playertextid == tdpin[playerid][25]) { PinClickDone(playerid); return 1; }
    if (playertextid == PlayerText:16 || playertextid == tdpin[playerid][16]) { PinClickX(playerid); return 1; }
    if (playertextid == PlayerText:17 || playertextid == tdpin[playerid][17]) { PinClickDigit(playerid, 1); return 1; }
    if (playertextid == PlayerText:18 || playertextid == tdpin[playerid][18]) { PinClickDigit(playerid, 2); return 1; }
    if (playertextid == PlayerText:19 || playertextid == tdpin[playerid][19]) { PinClickDigit(playerid, 3); return 1; }
    if (playertextid == PlayerText:20 || playertextid == tdpin[playerid][20]) { PinClickDigit(playerid, 4); return 1; }
    if (playertextid == PlayerText:21 || playertextid == tdpin[playerid][21]) { PinClickDigit(playerid, 5); return 1; }
    if (playertextid == PlayerText:22 || playertextid == tdpin[playerid][22]) { PinClickDigit(playerid, 6); return 1; }
    if (playertextid == PlayerText:23 || playertextid == tdpin[playerid][23]) { PinClickDigit(playerid, 7); return 1; }
    if (playertextid == PlayerText:24 || playertextid == tdpin[playerid][24]) { PinClickDigit(playerid, 8); return 1; }
    if (playertextid == PlayerText:13 || playertextid == tdpin[playerid][13]) { PinClickDigit(playerid, 9); return 1; }
    if (playertextid == PlayerText:14 || playertextid == tdpin[playerid][14]) { PinClickDigit(playerid, 0); return 1; }
    return 1;
}
