    //if(!mysql_errno()) print("Koneksi basis data aktif!");
	//else return print("Koneksi basis data tidak aktif!");

    //mysql_log(ALL);

    LoadVehicles();

	//mysql_tquery(mMysql, "SET NAMES 'cp1251'", "", "");
