        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pGiokrainbow] > 0) {
        format(szItem, sizeof(szItem), "{0000FF}G{FFFF00}I{FF0000}O{FF69B4}K {FFFFFF}R{808080}A{00FFFF}I{FF1493}N{00FF00}B{800080}O{FF69B4}W\t%d\n", PlayerInfo[targetid][pGiokrainbow]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pGiokpermata] > 0) {
	    format(szItem, sizeof(szItem), "{FF3838}G{FF9900}i{FFFF00}o{00FF00}k {00FFFF}P{0099FF}e{9933FF}r{FF00FF}m{FF55BB}a{33FF99}t{FFFF55}a\t{FFFF00}%d\n", PlayerInfo[targetid][pGiokpermata]);
	    strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pGiok] > 0) {
        format(szItem, sizeof(szItem), "Batu Giok\t%d\n", PlayerInfo[targetid][pGiok]);
        strcat(ilham, szItem);
    }

    // Makanan & Kesehatan
    if (PlayerInfo[targetid][pFood] > 0) {
        format(szItem, sizeof(szItem), "Makanan\t%d\n", PlayerInfo[targetid][pFood]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pDrink] > 0) {
        format(szItem, sizeof(szItem), "Minuman\t%d\n", PlayerInfo[targetid][pDrink]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pHeals] > 0) {
        format(szItem, sizeof(szItem), "Perban\t%d\n", PlayerInfo[targetid][pHeals]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pMedicine] > 0) {
        format(szItem, sizeof(szItem), "Medicine\t%d\n", PlayerInfo[targetid][pMedicine]);
        strcat(ilham, szItem);
    }
    if (PlayerInfo[targetid][pMedkit] > 0) {
        format(szItem, sizeof(szItem), "Medkit\t%d\n", PlayerInfo[targetid][pMedkit]);
        strcat(ilham, szItem);
    }

    // Laut & Ternak
    if (PlayerInfo[targetid][pUmpan] > 0) {
        format(szItem, sizeof(szItem), "Umpan\t%d\n", PlayerInfo[targetid][pUmpan]);
