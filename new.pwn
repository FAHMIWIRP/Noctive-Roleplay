CMD:gevjsbsjdbd(playerid)
{
    if(PlayerInfo[playerid][pJob] != 4) return 1;

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return true;

    new vehicleid = GetPlayerVehicleID(playerid);

    if(VehInfo[vehicleid][vFr] != 4) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak berada di truk sampah!");

    if(trash_vehicle_amount[vehicleid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "Sampah kosong!");

    new salary = trash_vehicle_amount[vehicleid] * 10;
    new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
    if(partner_id != INVALID_PLAYER_ID && PlayerInfo[partner_id][pJob] == 4)
    {
        new partner_salary = salary / 2;

		GivePlayerPayCheck(partner_id, partner_salary);

		SCMF(partner_id, -1, "Anda menurunkan truk sampah, menerima: {91d29a}$%i", partner_salary);

		salary /= 2;
    }

    GivePlayerPayCheck(playerid, salary);

	SCMF(playerid, -1, "Anda menurunkan truk sampah, menerima: {91d29a}$%i", salary);

	if(partner_id != INVALID_PLAYER_ID)
	{
	    SendClientMessage(playerid, -1, "Pembayaran dibagi antara Anda dan mitra Anda!");
	    SendClientMessage(partner_id, -1, "Pembayaran dibagi antara Anda dan mitra Anda!");
	}
	DisablePlayerCheckpoint(playerid);
	UpdateVehicleTrashInfo(vehicleid, -trash_vehicle_amount[vehicleid]);
	return true;
}
CMD:gsdjndbdhxbd(playerid)
{
    if(admin_level[playerid] < 7 || !admin_logged[playerid]) return 1;
    if(PlayerInfo[playerid][pJob] != 5) return 1;

    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return true;

    new vehicleid = GetPlayerVehicleID(playerid);
    if(VehInfo[vehicleid][vFr] != 5) return SendClientMessage(playerid, COLOR_GREY, "You are not in the collector!");

    if(collector_vehicle_amount[vehicleid] <= 0) return SendClientMessage(playerid, COLOR_GREY, "Kolektor kosong!");

    new salary = collector_vehicle_amount[vehicleid] * 36;
    new partner_id = GetPlayerInVehicleSeat(vehicleid, 1);
    if(partner_id != INVALID_PLAYER_ID && PlayerInfo[partner_id][pJob] == 5)
    {
        new partner_salary = salary / 2;

		GivePlayerPayCheck(partner_id, partner_salary);

		SCMF(partner_id, -1, "Anda menurunkan kendaraan pengumpul, memperoleh: {91d29a}$%i", partner_salary);

		salary /= 2;
    }

    GivePlayerPayCheck(playerid, salary);

	SCMF(playerid, -1, "Anda telah menurunkan kendaraan pengumpul, memperoleh: {91d29a}$%i", salary);

	if(partner_id != INVALID_PLAYER_ID)
	{
	    SendClientMessage(playerid, -1, "Pembayaran dibagi antara Anda dan mitra Anda!");
	    SendClientMessage(partner_id, -1, "Pembayaran dibagi antara Anda dan mitra Anda!");
	}
	DisablePlayerCheckpoint(playerid);
	UpdateVehicleCollectorInfo(vehicleid, -collector_vehicle_amount[vehicleid]);
	return true;
}
CMD:mapstealer(playerid, params[])
{
	new str[128];
	format(str, sizeof(str), "[AntiCheat] %s(%d) telah ditendang dari server karena diduga menggunakan Mapstealer.luac", ReturnName(playerid), playerid);
	SendStaffMessage(COLOR_RED, str);
	SendClientMessageEx(playerid, COLOR_RED, str);
	Kick(playerid);
	return 1;
}
CMD:srestart(playerid)
{
	if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
	foreach(new i : Player)
	{
		KickD(i, "");
	}
	SetTimer("GMXRes", 5000, 0);
	return true;
}
CMD:buyobat(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 5.0, 597.218750,2084.289550,995.632812)) return SendClientMessage(playerid, 0xFFFF00FF, "Kamu Tidak Berada Di Hospital!");
    if(GetFractionMemberAmount(FRACTION_LSMEDICS) < 0) return Info(playerid, "Medis sedang berada dikota jadi Kamu Tidak Bisa Membeli Obat");
	if(pData[playerid][pCash] < 300000) return Info(playerid, "Uang Anda Tidak Cukup");
	SetPlayerHealth(playerid, 100);
	pData[playerid][pCash] -= 5000;
	Info(playerid, "Anda Berhasil Membeli Obat Seharga 5000$");
	return 1;
}
CMD:restart(playerid)
{
    if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
    SendClientMessageToAll(-1, "Server dimulai ulang. Server akan kembali bekerja sebentar lagi...");
	foreach(new i : Player)
	{
	    GameTextForPlayer(i, "~r~R~g~restaring", 9000, 0);
        SetPlayerInterior(i,0);
		TogglePlayerControllable(i, 0);
		InterpolateCameraPos(i, 1294.263549, -1337.225830, 278.767089, 1337.283325, -1430.924926, 68.419837, 10000);
		InterpolateCameraLookAt(i, 1291.685546, -1333.435791, 276.769744, 1339.189086, -1435.458740, 67.518539, 10000);
		KickD(i, "");
	}
	SetTimer("GMXRes", 5000, 0);
	return true;
}

CMD:mt(playerid)
{
    if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
    SendClientMessageToAll(-1, "Server Maintenance Sampai Pemberitahuan Lebih Lanjut...");
	foreach(new i : Player)
	{
	    GameTextForPlayer(i, "~r~R~g~SERVER MAINTENANCE", 9000, 0);
        SetPlayerInterior(i,0);
		TogglePlayerControllable(i, 0);
		InterpolateCameraPos(i, 1294.263549, -1337.225830, 278.767089, 1337.283325, -1430.924926, 68.419837, 10000);
		InterpolateCameraLookAt(i, 1291.685546, -1333.435791, 276.769744, 1339.189086, -1435.458740, 67.518539, 10000);
		KickD(i, "");
	}
	SetTimer("GMXRes", 5000, 0);
	return true;
}

CMD:setskin(playerid, params[])
{
    if(admin_level[playerid] < 12 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dd", params[0],params[1])) return Send(playerid, -1, "Enter: /setskin [id] [id skin]");
	if(params[1] > 311 || params[1] < 0 || params[1] == 74) return Send(playerid, COLOR_GREY, "ID kulit tidak valid, 2 hingga 311");

	SCMF(params[0], 0x6495EDFF, "Administrator %s[%d] memberi Anda ID pakaian(%d)", Name(playerid), playerid, params[1]);
	SCMF(playerid, 0x6495EDFF, "Anda memberi pemain %s[%d] ID pakaian(%d)", Name(params[0]), params[0], params[1]);

	if(GetPlayerSkin(params[0]) == PlayerInfo[params[0]][pSkin]) SetPlayerSkinEx(params[0], params[1]);

    PlayerInfo[params[0]][pSkin] = params[1];

    OnPlayerUpdateAccountsPer(params[0], "pSkin", PlayerInfo[params[0]][pSkin]);

	return 1;
}

CMD:skin(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    if(sscanf(params, "dd", params[0],params[1])) return Send(playerid, -1, "Enter: /setskin [id] [id skin]");
	if(params[1] > 300 || params[1] < 2 || params[1] == 74) return Send(playerid, COLOR_GREY, "ID kulit tidak valid, 2 hingga 311");

	SCMF(params[0], 0x6495EDFF, "Administrator %s[%d] memberi Anda ID pakaian sementara(%d)", Name(playerid), playerid, params[1]);
	SCMF(playerid, 0x6495EDFF, "Anda memberi pemain %s[%d] ID pakaian sementara(%d)", Name(params[0]), params[0], params[1]);

    SetPlayerSkinEx(params[0], params[1]);
	return 1;
}
CMD:slap(playerid, params[])
{
//    if(PlayerInfo[playerid][pDutyAdmin] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Tidak Sedang Onduty Admin!");
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;
	if(sscanf(params, "d",params[0])) return Send(playerid, -1, "Masuk: /slap [id]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan / tidak resmi.");
	new Float:shealth;
	new Float:slx, Float:sly, Float:slz;

	GetPlayerHealth(params[0], shealth);
	SetPVarFloat(playerid, "oldHP", shealth);
	SetPVarInt(playerid, "HpIds", params[0]);
	//SetPlayerHealth(params[0], shealth-5);
	GetPlayerPos(params[0], slx, sly, slz), SetPlayerPos(params[0], slx, sly, slz+10);
	PlayerPlaySound(params[0], 1190, 0.0, 0.0, 0.0), PlayerPlaySound(playerid, 1190, 0.0, 0.0, 0.0);
	format(format_string, sizeof(format_string), "[A] Administrator %s[%d] pemain yang dipukul %s[%d]",PlayerInfo[playerid][pAname], playerid, Name(params[0]), params[0]), SendAdminMessage(COLOR_GREY, format_string);

	return 1;
}

