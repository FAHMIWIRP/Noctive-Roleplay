CMD:damagelogs(playerid, params[])
{
    new DialogMessage[1024];
    format(DialogMessage, sizeof(DialogMessage), "===== DAMAGE LOGS =====\n");
    for(new i = 0; i < MAX_DAMAGE_LOGS; i++)
    {
        if(strlen(damageLogs[i]) > 0)
        {
            format(DialogMessage, sizeof(DialogMessage), "%s%s\n", DialogMessage, damageLogs[i]);
        }
    }
    
    ShowPlayerDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Damage Logs", DialogMessage, "Tutup", "");
    return 1;
}
