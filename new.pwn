CMD:rheal(playerid)
{
	if(PlayerInfo[playerid][pRepairKit] == 0) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki kit perbaikan.");

	new vehicleid = GetNearestVehicle(playerid);

	if(!vehicleid) return SCM(playerid, COLOR_GREY, "Tidak ada kendaraan di sekitar.");

	new Float: health;
	GetVehicleHealth(vehicleid, health);

	if(health == 1000.0) return SCM(playerid, COLOR_GREY, "Transportasi ini utuh.");

    PlayerInfo[playerid][pRepairKit]--;

    OnPlayerUpdateAccountsPer(playerid, "pRepairKit", PlayerInfo[playerid][pRepairKit]);

	RepairVehicle(vehicleid);

	return SCM(playerid, COLOR_YELLOW, "Anda telah memperbaiki kendaraan.");
}

CMD:referals(playerid)
{
	mysql_format(mMysql, format_string, 144, "SELECT `pName`, `pLevel` FROM `accounts` WHERE `pReferal` = %i", GetPlayerAccountID(playerid));
	new Cache: result = mysql_query(mMysql, format_string);

	new rows = cache_num_rows();

	if(!rows) return SCM(playerid, COLOR_GREY, "Tidak ada yang menunjukkan Anda sebagai referral.");

	String = "";

	new str[64], name[MAX_PLAYER_NAME], level;

	for(new i; i < rows; i++)
	{
	    cache_get_value(i, "pName", name);
	    cache_get_value_int(i, "pLevel", level);

	    format(str, 64, "%i. %s\t%i\n", i + 1, name, level);
	    strcat(String, str);
	}

	cache_delete(result);

	return SPD(playerid, 0000, DIALOG_STYLE_TABLIST, "Daftar pemain yang diundang", String, "Tutup", "");
}

