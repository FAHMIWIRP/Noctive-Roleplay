stock UpdateGangWH3DTextLabel(gang_id)
{
	new f_id = GangWarehouseIDToFracID(gang_id);

	if(0 <= gang_id <= 4)
	{
		format(format_string, 244, "Gudang Geng\n%s\n\nTeritori: %i\nMetall: %i\nJumlah: %i\nUang: %i\nObat: %i\n\nGrafiti Dicat: %i/49",
			GetFractionName(f_id), wh_zones_gang[gang_id], wh_weapon_gang[gang_id], wh_ammo_gang[gang_id], wh_money_gang[gang_id], wh_drugs_gang[gang_id], wh_graffiti_gang[gang_id]);
	}
	else if(5 <= gang_id <= 7)
	{
	    format(format_string, 244, "Gudang Mafia\n%s\n\nBisnis: %i\nSenjata: %i\nKereta: %i\nUang: %i\nObat: %i",
			GetFractionName(f_id), wh_zones_gang[gang_id], wh_weapon_gang[gang_id], wh_ammo_gang[gang_id], wh_money_gang[gang_id], wh_drugs_gang[gang_id]);
	}
	else
	{
	    format(format_string, 244, "Biker Depot\n\nSenjata: %i\nKereta: %i\nUang: %i\nObat: %i",
			wh_weapon_gang[gang_id], wh_ammo_gang[gang_id], wh_money_gang[gang_id], wh_drugs_gang[gang_id]);
	}

	return UpdateDynamic3DTextLabelText(wh_3d[gang_id], COLOR_WHITE, format_string);
}

stock GangWarehouseIDToFracID(g_id)
{
	switch(g_id)
	{
	    case 0: return FRACTION_BALLAS;
		case 1: return FRACTION_VAGOS;
		case 2: return FRACTION_GROVE;
		case 3: return FRACTION_AZTEC;
		case 4: return FRACTION_RIFA;

		case 5: return FRACTION_YAKUZA;
		case 6: return FRACTION_COLUMBIA;
		case 7: return FRACTION_RUMAFIA;

		case 8: return FRACTION_BIKER;
	}

	return -1;
}

stock IsRpNickname(nickname[])
{
    new Regex:r = Regex_New("[A-Z][a-z]+_[A-Z][a-z]+");

    new check = Regex_Check(nickname, r);

    Regex_Delete(r);

    return check;
}

stock UpdatePlayerVehicleShop(playerid, bool: update_camera = false)
{
	new shop_id = GetPlayerUseListitem(playerid);

	new veh_id = player_select_veh[playerid];
	new old_veh_id = player_select_old[playerid];

	new str[32];
    new model = as_vehicle_info[shop_id][veh_id][0];
    new price = as_vehicle_info[shop_id][veh_id][1];

	PlayerTextDrawSetString(playerid, autoshop_player_td[playerid][0], VehicleNames[model-400]);

	format(str, 16, "%i$", price);
	PlayerTextDrawSetString(playerid, autoshop_player_td[playerid][1], str);

	format(str, 16, "%i", VehStats[model - 400][vMaxSpeed]);
	PlayerTextDrawSetString(playerid, autoshop_player_td[playerid][2], str);

	format(str, 16, "%.0f", VehStats[model - 400][vMaxFuel]);
	PlayerTextDrawSetString(playerid, autoshop_player_td[playerid][3], str);

	if(update_camera)
	{
	    //Cari tahu posisi mobil masa depan

	    new Float: next_x = as_vehicle_pos[veh_id][0],
            Float: next_y = as_vehicle_pos[veh_id][1];

        GetXYInFront(next_x, next_y, as_vehicle_angle, 7.0);

        //Cari tahu posisi mobil sebelumnya

        new Float: old_x = as_vehicle_pos[old_veh_id][0],
            Float: old_y = as_vehicle_pos[old_veh_id][1];

        GetXYInFront(old_x, old_y, as_vehicle_angle, 7.0);

        //Buat kamera bergerak

        new Float: from_x = old_x,
            Float: from_y = old_y,
            Float: to_x = next_x,
            Float: to_y = next_y;

        InterpolateCameraPos(playerid, from_x, from_y, as_vehicle_pos[old_veh_id][2] + 2.5, to_x, to_y, as_vehicle_pos[veh_id][2] + 2.5, 2000, CAMERA_MOVE);

		InterpolateCameraLookAt
		(
			playerid,
			as_vehicle_pos[old_veh_id][0], as_vehicle_pos[old_veh_id][1], as_vehicle_pos[old_veh_id][2],
			as_vehicle_pos[veh_id][0], as_vehicle_pos[veh_id][1], as_vehicle_pos[veh_id][2],
			2000
		);

		as_player_camera[playerid] = SetTimerEx("SetAutoShopPlayerCamera", 2000, false, "ii", playerid, veh_id);

    }
}

forward SetAutoShopPlayerCamera(playerid, veh_id);
public SetAutoShopPlayerCamera(playerid, veh_id)
{
    new Float: x = as_vehicle_pos[veh_id][0],
            Float: y = as_vehicle_pos[veh_id][1];

    GetXYInFront(x, y, as_vehicle_angle, 7.0);

	SetPlayerCameraPos(playerid, x, y, as_vehicle_pos[veh_id][2] + 2.5);
    SetPlayerCameraLookAt(playerid, as_vehicle_pos[veh_id][0], as_vehicle_pos[veh_id][1], as_vehicle_pos[veh_id][2]);

    as_player_camera[playerid] = 0;

	return 1;
}

