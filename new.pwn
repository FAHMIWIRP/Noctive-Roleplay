stock SpawnSingleDeer(i)
{
    DeerData[i][deerActive] = true;
    DeerData[i][deerHits] = 0;
    DeerData[i][deerX] = DeerSpawnPos[i][0];
    DeerData[i][deerY] = DeerSpawnPos[i][1];
    DeerData[i][deerZ] = DeerSpawnPos[i][2];
    
    DeerData[i][deerObjID] = CreateObject(DEER_OBJECT_ID, DeerData[i][deerX], DeerData[i][deerY], DeerData[i][deerZ], 0.0, 0.0, DeerSpawnPos[i][3]);
}
stock SetNextCP(playerid,pos)
{
	if(pos < 0) return false;
	new type = 0;
	if(PlayerInfo[playerid][pJob] == 2)
	{
	    new route = player_route_id[playerid];
		GivePlayerPayCheck(playerid, 15);
		if(gBusCPs[route][pos][0] == gBusCPs[route][pos+1][0] && gBusCPs[route][pos][1] == gBusCPs[route][pos+1][1]) type = 1;
		SetPlayerRaceCheckpoint(playerid,type,gBusCPs[route][pos][0],gBusCPs[route][pos][1],gBusCPs[route][pos][2],gBusCPs[route][pos+1][0],gBusCPs[route][pos+1][1],gBusCPs[route][pos+1][2],4.0);
	}
	else if(PlayerInfo[playerid][pJob] == 3) {
	    new route = player_route_id[playerid];
		GivePlayerPayCheck(playerid, 20);
		if(gUborkaCPs[route][pos][0] == gUborkaCPs[route][pos+1][0] && gUborkaCPs[route][pos][1] == gUborkaCPs[route][pos+1][1]) type = 1;
		SetPlayerRaceCheckpoint(playerid,type,gUborkaCPs[route][pos][0],gUborkaCPs[route][pos][1],gUborkaCPs[route][pos][2],gUborkaCPs[route][pos+1][0],gUborkaCPs[route][pos+1][1],gUborkaCPs[route][pos+1][2],4.0);
	}
	return true;
}
stock spawned_bus(playerid)
{
    DisablePlayerRaceCheckpoint(playerid);
    SetVehicleToRespawn(pTemp[playerid][pBusID]);
    player_route_id[playerid] = 0;
    SCM(playerid, -1, "Anda telah menyelesaikan hari kerja Anda. Gaji Anda akan diterima pada Jam baru.");//GetPVarInt(playerid, #busMoney));
    Send(playerid,0xafafafff,"Gaji Anda akan dikreditkan ke akun Anda pada saat gaji Anda(PayDay).");
    busPos{playerid} = 0;
    if(pTemp[playerid][bus_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(pTemp[playerid][bus_text]);
		pTemp[playerid][bus_text] = Text3D:INVALID_3DTEXT_ID;
	}
	pTemp[playerid][pBusID] = 0;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
    return 1;
}
stock spawned_uborka(playerid)
{
    DisablePlayerRaceCheckpoint(playerid);
    SetVehicleToRespawn(pTemp[playerid][puborkacar]);
    player_route_id[playerid] = 0;
    SCMF(playerid, -1, "Anda menyelesaikan hari kerja Anda. Diperoleh: {3399FF}$%i", pTemp[playerid][pWorkSalary]);//GetPVarInt(playerid, #busMoney));
    Send(playerid,0xafafafff,"Gaji Anda akan dikreditkan ke akun Anda selama hari gajian(PayDay).");
    uborkaPos{playerid} = 0;

	if(pTemp[playerid][uborka_text] != Text3D:INVALID_3DTEXT_ID)
	{
		DestroyDynamic3DTextLabel(pTemp[playerid][uborka_text]);
		pTemp[playerid][uborka_text] = Text3D:INVALID_3DTEXT_ID;
	}

    pTemp[playerid][puborkacar] = 0;

    GivePlayerPayCheck(playerid, pTemp[playerid][pWorkSalary]);

    pTemp[playerid][pWorkSalary] = 0;
	rent_job_vehicle[playerid] = INVALID_VEHICLE_ID;
    return 1;
}
