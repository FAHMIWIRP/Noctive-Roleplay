CMD:asuransikel(playerid, params[]) 
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    if(asuransiTimer != 0) return SendClientMessage(playerid, 0xAFAFAFAA, "Pembersihan sedang berjalan!");
    asuransiCount = 10;
    asuransiTimer = SetTimer("AsuransiCount", 1000, true);
    SendClientMessageToAll(0xFFFF00, "Pembersihan Kendaraan Akan Dimulai Segera Naiki Kendaraan Anda");
    return 1;
}

forward AsuransiCount();
public AsuransiCount() 
{
    asuransiCount--;
    new str[512];
    format(str, sizeof(str), "~w~Pembersihan Akan Dimulai Dalam %d Detik", asuransiCount);
    GameTextForAll(str, 1000, 4);
    if(asuransiCount == 0) 
    {
        KillTimer(asuransiTimer);
        asuransiTimer = 0;
        AsuransiKendaraan();
    }
}

AsuransiKendaraan() 
{
    new Float:x, Float:y, Float:z;
    for(new i = 0; i < MAX_VEHICLES; i++) 
    {
        if(GetVehicleModel(i) != 0) 
        {
            new bool:isOccupied = false;
            for(new j = 0; j < MAX_PLAYERS; j++) 
            {
                if(IsPlayerInVehicle(j, i)) 
                {
                    isOccupied = true;
                    break;
                }
            }
            if(!isOccupied) 
            {
                GetVehiclePos(i, x, y, z);
                SetVehiclePos(i, 2109.1763, -1978.4441, 13.5469); // garkot
            }
        }
    }
    SendClientMessageToAll(0xFFFF00, "Pembersihan Selesai!");
}
CMD:hbemode(playerid, params[])
{
    ShowPlayerDialog(playerid, DIALOG_HBE_MODE, DIALOG_STYLE_LIST, "HBE Mode Menu", "Hide Hbe\nSimpel v1\nSimpel v2", "Pilih", "Keluar");
    return 1;
}

CMD:gendong2(playerid, params[])
{
    new yangdigendong;
    if(GetDistanceBetweenPlayers(playerid, yangdigendong) < 2)
    {
        if(Targetgendong[yangdigendong] == 1 && Yangmenggendong[playerid] == 1)
        {
            Targetgendong[yangdigendong] = 0;
            Yangmenggendong[playerid] = 0;
            ClearAnimations(playerid);
            KillTimer(gendongtimer[yangdigendong]);
        }
        else
        {
        	SendClientMessage(playerid, -1, "{FF0000}>> [ERROR] {FFFFFF}Anda tidak sedang digendong.");
		}
    }
    return 1;
}

CMD:mulai(playerid, params[])
{
    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi");
	{
	    if(IsPlayerInRangeOfPoint(playerid, 5, 1257.2253, -1265.5963, 13.3644))
		{
			if(GetPVarInt(playerid,"pTimeKuli") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down Job 30 Menit");
			SetPlayerCheckpoint(playerid, 1281.2595, -1256.7521, 13.6413, 5.0);
			SetPVarInt(playerid, "GPS", 1);
			PlayerInfo[playerid][pKuli1] = 1;
			SetPlayerSkin(playerid, 16);
			SendClientMessage(playerid, COLOR_YELLOW, "Anda Memulai Pekerjaan");
			SendClientMessage(playerid, COLOR_YELLOW, "[ NORP ] Silakan Mengikuti Checkpoint");
	    }
    }
    return 1;
}
CMD:selesai(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 5, 1257.2253, -1265.5963, 13.3644))
	{
		SetPVarInt(playerid, "pTimeKuli", gettime() + 1800);
		PlayerInfo[playerid][pKuli1] = 0;
		SetPlayerSkinEx(playerid,PlayerInfo[playerid][pSkin]);
		DisablePlayerCheckpoint(playerid);
		SetPVarInt(playerid, "GPS", 0);
		SendClientMessage(playerid, COLOR_YELLOW, "Anda Menyelesaikan Pekerjaan");
	}
	return 1;
}

CMD:ambilsemen(playerid, params[])
{
	if(PlayerInfo[playerid][pKuli3] >= 1) return 1;
	if(PlayerInfo[playerid][pKuli1] == 0) return 1;
	if(pData[playerid][pStress] > 100) return Error(playerid, "Anda Sedang Stress!");
	if(pData[playerid][pSemen] > 100) return Error(playerid, "Semen Sudah melewati Batas!(Max: 100).");
	{
		if(!IsPlayerInRangeOfPoint(playerid, 5, 1281.2595, -1256.7521, 13.6413)) return 1;
	    if(IsPlayerInRangeOfPoint(playerid, 5, 1281.2595, -1256.7521, 13.6413))
	    {
	        PlayerInfo[playerid][pKuli3] += 1;
	        ApplyAnimation(playerid, "GHANDS", "gsign3LH", 4.1, 0, 1, 1, 1, 2250, 1);
	        SetPlayerAttachedObject(playerid, 0, 1458, 1, -0.9, 0.7, 0.02, 0.0, 90.0, 0.0, 0.58, 0.6, 0.4, 0);
			SetPlayerAttachedObject(playerid, 0 +1, 2060, 1, -0.699, 1.500, 0.000, 90.000, 90.000, 90.000, 1.000, 1.000, 1.000, 0);
	        SetPlayerCheckpoint(playerid, 1257.0094,-1239.9985,18.1160, 1.0);
	        SendClientMessage(playerid, COLOR_YELLOW, "[ NORP ] Anda Telah Mengambil Semen");
	        SendClientMessage(playerid, COLOR_YELLOW, "[ NORP ] Silakan Ke Bangunan Atas Untuk Meletakan Semen");
	    }
    }
    return 1;
}
CMD:taruhsemen(playerid, params[])
{
	if(PlayerInfo[playerid][pKuli3] < 1) return 1;
	if(PlayerInfo[playerid][pKuli1] == 0) return 1;
	{
		if(!IsPlayerInRangeOfPoint(playerid, 5, 1257.0094,-1239.9985,18.1160)) return 1;
	    if(IsPlayerInRangeOfPoint(playerid, 5, 1257.0094,-1239.9985,18.1160))
	    {
	        PlayerInfo[playerid][pKuli3] -= 1;
			RemovePlayerAttachedObject(playerid, 0);
	  	    RemovePlayerAttachedObject(playerid, 0+1);
	        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
	        new rand = RandomEx(1, 10);
	        PlayerInfo[playerid][pSemen] += rand;
            PlayerInfo[playerid][pThirst] -= 7;
            PlayerInfo[playerid][pSatiety] -= 3;
            PlayerInfo[playerid][pStress] += 1;
	        OnPlayerUpdateAccountsPer(playerid, "pSemen", PlayerInfo[playerid][pSemen]);
	        SetPlayerCheckpoint(playerid, 1281.2595, -1256.7521, 13.6413, 1.0);
	        SetPVarInt(playerid,"CHECKPOINTID",3);
	        SendClientMessage(playerid, COLOR_YELLOW, "Anda Mendapatkan Semen 10gram");
	        SendClientMessage(playerid, COLOR_YELLOW, "[ NORP ] Silakan Ke Checkpoint Untuk Melanjutkan Pekerjaan");
        }
    }
    return 1;
}
