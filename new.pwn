//JOB SUSU
CMD:8268362(playerid, params[])
{
    // 0. Cek duty pemerah susu
    if(PlayerInfo[playerid][pDutypemerassusu]!= 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus ambil job pemeras susu dulu!");
        
    // 2. Cek stok susu sapi udah penuh belum
    if(PlayerInfo[playerid][pSususapi] >= 50)
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Susu sapi kamu sudah penuh! Packing dulu pake /packingsusu");

    // 3. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    // 4. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMERAS SUSU SAPI..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnSapiUpdate", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Memeras Susu Sapi");
    return 1;
}

forward OnSapiUpdate(playerid);
public OnSapiUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("SelesaiSapi", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiSapi(playerid);
public SelesaiSapi(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    PlayerInfo[playerid][pSususapi] += 5;
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pSususapi", PlayerInfo[playerid][pSususapi]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda mendapatkan 5 Susu Sapi.", PlayerInfo[playerid]);
    return 1;
}

CMD:packingsusu(playerid, params[])
{
    // 1. Cek duty pemerah susu
    if(PlayerInfo[playerid][pDutypemerassusu]!= 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus duty job pemeras susu dulu! /dutypemerahsusu");

    // 2. Cek lokasi packing
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 312.712341, 1154.375854, 8.595958) &&
      !IsPlayerInRangeOfPoint(playerid, 3.0, 317.520690, 1154.375122, 8.595958))
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Kamu tidak berada di tempat packing susu!");

    // 3. Cek stok susu sapi minimal 5
    if(PlayerInfo[playerid][pSususapi] < 5)
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Kamu butuh minimal 5 Susu Sapi untuk packing!");

    // 4. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    // 5. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 0, 0, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Packing Susu..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnSapiPackingUpdate", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu sedang packing susu sapi...");
    return 1;
}

forward OnSapiPackingUpdate(playerid);
public OnSapiPackingUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("SelesaiPackingSapi", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiPackingSapi(playerid);
public SelesaiPackingSapi(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    PlayerInfo[playerid][pSususapi] -= 5;
    PlayerInfo[playerid][pCash] += 500;
    GivePlayerMoneyEx(playerid, 500);
    OnPlayerUpdateAccountsPer(playerid, "pSususapi", PlayerInfo[playerid][pSususapi]);
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pSususapi", PlayerInfo[playerid][pSususapi]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda berhasil packing susu dan mendapatkan {00FF26} 500$ ", PlayerInfo[playerid]);
    return 1;
}
CMD:jobpemerassusu(playerid, params[])
{
    // Koordinat ON DUTY
    if(!IsPlayerInRangeOfPoint(playerid, 2.0, 313.687316, 1146.108032, 8.595958))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu tidak berada di tempat ambil job Pemerah Susu!");

    if(PlayerInfo[playerid][pDutypemerassusu] == 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu sudah dalam duty Pemerah Susu.");

    PlayerInfo[playerid][pDutypemerassusu] = 1;
    SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} Kamu sekarang duty sebagai Pemerah Susu. Pergi ke kandang sapi untuk mulai memeras.");
    return 1;
}

CMD:selesaijobsusu(playerid, params[])
{
    // Koordinat OFF DUTY
    if(!IsPlayerInRangeOfPoint(playerid, 2.0, 313.687316, 1146.108032, 8.595958))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu tidak berada di tempat ambil job Pemerah Susu!");

    if(PlayerInfo[playerid][pDutypemerassusu] == 0)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu tidak sedang duty Pemerah Susu.");

    // Jika player off-duty saat masih proses memeras, hentikan
    if(SedangKerja[playerid] == true)
    {
        SedangKerja[playerid] = false;
        TogglePlayerControllable(playerid, 1);
        ClearAnimations(playerid);
        HideBarAfterDone(playerid);
        if(PlayerProgressBarTimer[playerid]!= -1)
        {
            KillTimer(PlayerProgressBarTimer[playerid]);
            PlayerProgressBarTimer[playerid] = -1;
        }
    }

    PlayerInfo[playerid][pDutypemerassusu] = 0;
    SendClientMessage(playerid, -1, "{5996FF}[INFO]{FFFFFF} Kamu telah selesai duty Pemerah Susu. Terima kasih sudah bekerja!");
    return 1;
}

CMD:82779272(playerid, params[])
{
    // 1. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true) 
        return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    // 2. Mulai proses kerja
    SedangKerja[playerid] = true; // Kunci status
    TogglePlayerControllable(playerid, 0); // Bekukan agar tidak kabur
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1); 

    // SET PROGRESS BAR (25 Detik = 250ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMOTONG AYAM..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Jalankan timer untuk memperbarui visual loading bar setiap 250ms
    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnPotongAyanUpdate", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Memotong Ayam");
    return 1;
}

// Callback Loop khusus memotong ayam yang dipanggil otomatis oleh timer loading global
forward OnPotongAyanUpdate(playerid);
public OnPotongAyanUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda halus 1 detik pas bar penuh hijau, baru panggil fungsi selesai hadiah
        SetTimerEx("SelesaiPotongAyam", 1000, false, "i", playerid);
    }
    else
    {
        // Tetap mainkan animasi agar tidak patah atau berhenti di tengah proses
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward SelesaiPotongAyam(playerid);
public SelesaiPotongAyam(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Reset status & buka kunci pergerakan
    SedangKerja[playerid] = false; 
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid); // Menghilangkan TextDraw bar secara bersih dari layar

    PlayerInfo[playerid][pAyam] += 2;
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    // Update ke Database/Sistem
    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pAyam", PlayerInfo[playerid][pAyam]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    // Berikan Checkpoint tujuan berikutnya
    SetPlayerCheckpoint(playerid, 272.8714, 1446.0522, 10.5859, 5.0);
    SetPVarInt(playerid, "CHECKPOINTID", 3);
    
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda mendapatkan 2 Ayam Potong");
    return 1;
}

CMD:6552726(playerid, params[])
{
    if(SedangKerja[playerid] == true) 
        return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    if(PlayerInfo[playerid][pDutypacking] == 0 || GetPVarInt(playerid, "pCarryingBox") == 0)
        return 1;

    SedangKerja[playerid] = true; 
    TogglePlayerControllable(playerid, 0); 
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1); 

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENGEMAS PACKET..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    
    ShowItemNotification(playerid, false, "Box", 1);
    
    // DIPERBAIKI: Nama timer dicocokkan menjadi "OnPackingUpdate"
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnPackingUpdate", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Memacking Packet");
    return 1;
}

// DIPERBAIKI: Menambahkan forward untuk callback timer
forward OnPackingUpdate(playerid);
public OnPackingUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        SetTimerEx("SesaiPacking", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SesaiPacking(playerid);
public SesaiPacking(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false; 
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    
    // DIPERBAIKI: Menghapus objek di slot 1 (sesuai saat pemasangan), bukan slot 8
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid); 

    // DIPERBAIKI: Reset pCarryingBox agar pemain bisa mengambil box lagi
    SetPVarInt(playerid, "pCarryingBox", 0);

    GivePlayerMoney(playerid, 250); 
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;
    PlayerInfo[playerid][pCash] += 250;

    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[JOB]{FFFFFF} Package successfully processed! You received {2ECC71}$250{FFFFFF}.");
    return 1;
}

CMD:bar(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "Animasi tidak dapat digunakan di dalam kendaraan");
	switch(strval(params))
	{
	case 1: ApplyAnimation(playerid, "BAR", "Barcustom_get", 4.0, 0, 1, 0, 0, 0, 1);
	case 2: ApplyAnimation(playerid, "BAR", "Barserve_bottle", 4.0, 0, 0, 0, 0, 0, 1);
	case 3: ApplyAnimation(playerid, "BAR", "Barserve_give", 4.0, 0, 0, 0, 0, 0, 1);
	case 4: ApplyAnimation(playerid, "BAR", "dnk_stndM_loop", 4.0, 0, 0, 0, 0, 0, 1);
	case 5: ApplyAnimation(playerid, "BAR", "BARman_idle", 4.0, 1, 0, 0, 0, 0, 1);
	default: SendClientMessage(playerid, COLOR_WHITE, "USAGE: /bar [1-5]");
	}
	return 1;
}

CMD:bobolkasir(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 2520.877929, -1541.666992, 24.279996)) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak berada di lokasi yang tepat");
    if(PlayerInfo[playerid][pLevel] < 5) return SendClientMessage(playerid, COLOR_GREY, "level anda belum cukup");
    if(GetFractionMemberAmount(FRACTION_LSPD) < 5) return SendClientMessage(playerid, COLOR_GREY, "Polisi kurang dari 5 orang");
    if(PlayerInfo[playerid][pClip] < 1) return SendClientMessage(playerid, COLOR_GREY, "Anda tidak memiliki Lockpick");
    for(new i = 2; i <= 21; i++)
    {
        PlayerTextDrawHide(playerid, BAR[playerid][i]);
    }
    PlayerTextDrawShow(playerid, BAR[playerid][0]);
    PlayerTextDrawShow(playerid, BAR[playerid][1]);
    PlayerTextDrawShow(playerid, BAR[playerid][21]);
    SetTimerEx("Rob", 2000, false, "ii", playerid, 3);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0,1,0,0,0,0,1);
    TogglePlayerControllable(playerid, 0);
    SetPlayerChatBubble(playerid, "Mulai Membobol Kasir Dan Menganbil Uang Nya",COLOR_PURPLE,30.0,10000);

    SendClientMessageToAll(COLOR_LIGHTRED, "||----------------PERINGATAN----------------||");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " PEDAGANG SEDANG DI RAMPOK");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " UNTUK POLICE SEGERA DATANG KE LOKASI. ");
    SendClientMessageToAll(COLOR_LIGHTGREEN, " SEMUA ANGGOTA POLICE SEGERA DATANG KE LOKASI");
    SendClientMessageToAll(COLOR_LIGHTRED, "||----------------PERINGATAN----------------||");

    return 1;
}

forward Rob(playerid, count);
public Rob(playerid, count)
{
    if(count <= 20)
    {
        PlayerTextDrawShow(playerid, BAR[playerid][count]);
        SetTimerEx("Rob", 2000, false, "ii", playerid, count+1);
    }
    else
    {
        for(new i = 0; i <= 21; i++)
        {
            PlayerTextDrawHide(playerid, BAR[playerid][i]);
        }
        RemovePlayerAttachedObject(playerid, 8);
        new rand = RandomEx(1000, 10000);
        PlayerInfo[playerid][pCash] += rand;
        new rand2 = RandomEx(1000, 50000);
        PlayerInfo[playerid][pRedmoney] += rand2;
        PlayerInfo[playerid][pThirst] -= 10;
        PlayerInfo[playerid][pSatiety] -= 10;
        PlayerInfo[playerid][pStress] += 3;
        PlayerInfo[playerid][pClip] -= 1;
        TogglePlayerControllable(playerid, 1);
        OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
        OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
        OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
        OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
        OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);
        OnPlayerUpdateAccountsPer(playerid, "pClip", PlayerInfo[playerid][pClip]);
        SendClientMessage(playerid, COLOR_YELLOW, "Anda Berhasil Membobol Kasir Mengambil Uang Nya");
        SendClientMessage(playerid, COLOR_YELLOW, "Lari Segera Karena Ada Polisi");
        new string[128];
        format(string, sizeof(string), "Anda Mendapatkan %d Dolar Dan %d Redmoney", rand, rand2);
        SendClientMessage(playerid, COLOR_YELLOW, string);
        ClearAnimations(playerid);
    }
}

CMD:dance(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
		return SendClientMessage(playerid, 0xCECECEFF, "Animasi tidak dapat digunakan di dalam kendaraan");
	if(GetPlayerAnimationIndex(playerid) != 0) ClearAnimations(playerid);
	switch(strval(params))
	{
		case 1: SetPlayerSpecialAction(playerid, 5);
		case 2: SetPlayerSpecialAction(playerid, 6);
		case 3: SetPlayerSpecialAction(playerid, 7);
		case 4: SetPlayerSpecialAction(playerid, 8);
		default: SendClientMessage(playerid, COLOR_WHITE, "USAGE: /dance [1-4]");
	}
	return 1;
}

