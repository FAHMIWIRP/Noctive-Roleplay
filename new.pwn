            Info(playerid, "Anda telah berhasil memberikan marijuana kepada %s sejumlah %d.", ReturnName(otherid), amount);
            Info(otherid, "%s telah berhasil memberikan marijuana kepada anda sejumlah %d.", ReturnName(playerid), amount);
            ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
            ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
        }
    }
    return 1;
}
CMD:buyclipsg(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 505.100463, -2637.634521, 9.401593))
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak berada di tempat yang tepat.");

    if(PlayerInfo[playerid][pClipsg] > 1)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda masih memiliki Clipsg, tidak bisa membeli lagi.");

    if(PlayerInfo[playerid][pRedmoney] < 15000)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Uang Redmoney Anda tidak cukup.");

    PlayerInfo[playerid][pRedmoney] -= 15000;
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);

    PlayerInfo[playerid][pClipsg] += 1;
    OnPlayerUpdateAccountsPer(playerid, "pClipsg", PlayerInfo[playerid][pClipsg]);
    
    // --- NOTIFIKASI ---
    ShowItemNotification(playerid, true, "Clip SG", 1);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda telah membeli 1 Clipsg dengan Redmoney 15.000.");
    return 1;
}

