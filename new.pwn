public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	if(PlayerInfo[playerid][gEditID] != -1 && Iter_Contains(Gates, PlayerInfo[playerid][gEditID]))
	{
		new id = PlayerInfo[playerid][gEditID];
		if(response == EDIT_RESPONSE_UPDATE)
		{
			SetDynamicObjectPos(objectid, x, y, z);
			SetDynamicObjectRot(objectid, rx, ry, rz);
		}
		else if(response == EDIT_RESPONSE_CANCEL)
		{
			SetDynamicObjectPos(objectid, gPosX[playerid], gPosY[playerid], gPosZ[playerid]);
			SetDynamicObjectRot(objectid, gRotX[playerid], gRotY[playerid], gRotZ[playerid]);
			gPosX[playerid] = 0; gPosY[playerid] = 0; gPosZ[playerid] = 0;
			gRotX[playerid] = 0; gRotY[playerid] = 0; gRotZ[playerid] = 0;
			Servers(playerid, " You have canceled editing gate.");
			Gate_Save(id);
		}
		else if(response == EDIT_RESPONSE_FINAL)
		{
			SetDynamicObjectPos(objectid, x, y, z);
			SetDynamicObjectRot(objectid, rx, ry, rz);
			if(PlayerInfo[playerid][gEdit] == 1)
			{
				gData[id][gCX] = x;
				gData[id][gCY] = y;
				gData[id][gCZ] = z;
				gData[id][gCRX] = rx;
				gData[id][gCRY] = ry;
				gData[id][gCRZ] = rz;
				if(IsValidDynamic3DTextLabel(gData[id][gText])) DestroyDynamic3DTextLabel(gData[id][gText]);
				new str[64];
				format(str, sizeof(str), "Gate ID: %d", id);
				gData[id][gText] = CreateDynamic3DTextLabel(str, COLOR_WHITE, gData[id][gCX], gData[id][gCY], gData[id][gCZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, 10.0);

				PlayerInfo[playerid][gEditID] = -1;
				PlayerInfo[playerid][gEdit] = 0;
				Servers(playerid, " You have finished editing gate closing position.");
				gData[id][gStatus] = 0;
				Gate_Save(id);
			}
			else if(PlayerInfo[playerid][gEdit] == 2)
			{
				gData[id][gOX] = x;
				gData[id][gOY] = y;
				gData[id][gOZ] = z;
				gData[id][gORX] = rx;
				gData[id][gORY] = ry;
				gData[id][gORZ] = rz;

				PlayerInfo[playerid][gEditID] = -1;
				PlayerInfo[playerid][gEdit] = 0;
				Servers(playerid, " You have finished editing gate opening position.");

				gData[id][gStatus] = 1;
				Gate_Save(id);
			}
		}
	}
	return 1;
}
public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
   	new vehicleid = GetPlayerVehicleID(playerid);
    new seat0 = GetPlayerInVehicleSeat(vehicleid, 0);
    new seat1 = GetPlayerInVehicleSeat(vehicleid, 1);
    new seat2 = GetPlayerInVehicleSeat(vehicleid, 2);
    new seat3 = GetPlayerInVehicleSeat(vehicleid, 3);

    if(IsPlayerInAnyVehicle(playerid))
    {
        SetPlayerCheckpoint(seat0, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat1, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat2, fX, fY, fZ, 3);
        SetPlayerCheckpoint(seat3, fX, fY, fZ, 3);
        SendClientMessage(playerid,COLOR_YELLOW, "Waypoint sharing active");
    }
    if(PlayerData[playerid][pTogTP] == 1)
    {
        SetPVarFloat(playerid,"teleportX",fX), SetPVarFloat(playerid,"teleportY",fY), SetPVarFloat(playerid,"teleportZ",fZ);
        SetPlayerInterior(playerid,0), SetPlayerVirtualWorld(playerid, 0);
        if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) t_SetPlayerPos(playerid, GetPVarFloat(playerid,"teleportX"), GetPVarFloat(playerid,"teleportY"), GetPVarFloat(playerid,"teleportZ"));
        else SetVehiclePos(GetPlayerVehicleID(playerid), GetPVarFloat(playerid,"teleportX"), GetPVarFloat(playerid,"teleportY"), GetPVarFloat(playerid,"teleportZ"));
        GameTextForPlayer(playerid, "~g~BERHASIL", 3000, 1);
    }
    return 1;
}
forward Kicked(playerid);
public Kicked(playerid)
{
	new string[512];
	format(string, sizeof string,"{ffffff}Nama:{7fffd4} %s\n\n{ffffff}Nama Character Anda Belum Di Whitelist Oleh Administrator Noctive\nJika Anda Ingin Di Whitelist Di Kota Noctive, Silahkan Verifikasi Di Whatsapp Kami :\n{ff7f00}https://linktr.ee/NoctiveRoleplayBeta",GetName(playerid));
	ShowPlayerDialog(playerid, 0000, DIALOG_STYLE_MSGBOX,"{7fff00}INFO WHITELIST NOCTIVE", string, "Oke","Keluar");
	SetTimerEx("KickPlayer1", 1000, 0, "i", playerid);
	return 1;
}

forward KickPlayer1(playerid);
public KickPlayer1(playerid)
{
	Kick(playerid);
	return 1;
}

public OnPlayerClickDynamicTextdraw(playerid, PlayerText:playertextid)
{
    //panjul login
	if(playertextid == tdloginnewvoice[playerid][12])
	{
		DialogAvtorizatia(playerid);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][0]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][1]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][2]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][3]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][4]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][5]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][6]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][7]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][8]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][9]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][10]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][11]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][12]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][13]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][14]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][15]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][16]);
		PlayerTextDrawDestroy(playerid, tdloginnewvoice[playerid][17]);
		CancelSelectTextDraw(playerid);
	}
    for(new i = 0; i < MAX_INVENTORY; i++)
    {
        if(playertextid == MODELTD[playerid][i])
        {
            if(InventoryData[playerid][i][invExists])
            {
                MenuStore_UnselectRow(playerid);
                MenuStore_SelectRow(playerid, i);
                new name[48];
                strunpack(name, InventoryData[playerid][pData[playerid][pSelectItem]][invItem]);
            }
        }
    }
    if(!MarijuanaMinigame[playerid]) return 1; // biarkan callback lain (kalau ada) jalan normal

    // Tombol ESC / batal (index 33)
    if(playertextid == TDMARIJUANA[playerid][33])
    {
        CancelMarijuanaCutMinigame(playerid);
        return 1;
    }

    for(new i = 0; i < MARIJUANA_CUT_COUNT; i++)
    {
        if(playertextid == TDMARIJUANA[playerid][MarijuanaCutBtnID[i]])
        {
            if(MarijuanaCutClicked[playerid][i]) return 1; // sudah dipencet, skip

            MarijuanaCutClicked[playerid][i] = true;
            PlayerTextDrawColor(playerid, TDMARIJUANA[playerid][MarijuanaCutLabelID[i]], 0x00FF00FF);
            PlayerTextDrawShow(playerid, TDMARIJUANA[playerid][MarijuanaCutLabelID[i]]);

            new bool:allDone = true;
            for(new j = 0; j < MARIJUANA_CUT_COUNT; j++)
            {
                if(!MarijuanaCutClicked[playerid][j]) { allDone = false; break; }
            }

            if(allDone) FinishMarijuanaCutMinigame(playerid);
            return 1;
        }
    }
    if(playertextid == INVINFO[playerid][2])
    {
        new id = pData[playerid][pSelectItem];

        if(id == -1)
        {
            Error(playerid,"[Inventory] Tidak Ada Barang Di Slot Tersebut");
        }
        else
        {
            if(pData[playerid][pProgress] == 1) return Error(playerid, "Anda masih memiliki activity progress!");
            new string[64];
            strunpack(string, InventoryData[playerid][id][invItem]);

            if(!PlayerHasItem(playerid, string))
            {
                Error(playerid,"[Inventory] Kamu Tidak Memiliki Barang Tersebut");
                Inventory_Show(playerid);
            }
            else
            {
                CallLocalFunction("OnPlayerUseItem", "dds", playerid, id, string);
            }
        }
    }
    if(playertextid == INVINFO[playerid][4])
    {
        new id = pData[playerid][pSelectItem];

        if(id == -1)
        {
            Error(playerid,"Pilih Barang Terlebih Dahulu");
        }
        else
        {
            if(pData[playerid][pGiveAmount] < 1)
                return Error(playerid,"Masukan Jumlah Terlebih Dahulu!");

            new itemid = pData[playerid][pSelectItem];
            new value = pData[playerid][pGiveAmount];

            CallLocalFunction("DropPlayerItem", "ddsd", playerid, itemid, InventoryData[playerid][itemid][invItem], value);
        }
    }
    if(playertextid == INVINFO[playerid][5])
    {
        Inventory_Close(playerid);
        SetPlayerChatBubble(playerid, "Menutup Tas",COLOR_PURPLE,30.0,10000);
    }
    if(playertextid == INVINFO[playerid][3])
    {
        new id = pData[playerid][pSelectItem], count =0, str[500], strr[500];
        if(id == -1)
        {
            Error(playerid,"[Inventory] Pilih Barang Terlebih Dahulu");
        }
        else
        {
            if (pData[playerid][pGiveAmount] < 1)
                return Error(playerid,"[Inventory] Masukan Jumlah Terlebih Dahulu");

           // new count =0, str[500], strr[500];
            foreach(new i : Player) if(IsPlayerConnected(i) && NearPlayer(playerid, i, 5) && i != playerid)
            {
                format(str, sizeof(str), "Kantong - %s (%d)\n", pData[i][pName], i);
                strcat(strr, str);
                SetPlayerListitemValue(playerid, count++, i);
            }
            if(!count) Error(playerid, "Tidak ada player lain didekat mu!");
            else ShowPlayerDialog(playerid, DIALOG_GIVE, DIALOG_STYLE_LIST, "Liberal JUNIOR - Inventory", strr, "Pilih", "Tutup");
