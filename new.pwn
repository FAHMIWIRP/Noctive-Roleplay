public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
    if(!pCBugging[playerid] && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		if(PRESSED(KEY_FIRE))
		{
			switch(GetPlayerWeapon(playerid))
			{
				case WEAPON_DEAGLE, WEAPON_SHOTGUN, WEAPON_SNIPER:
				{
					ptsLastFiredWeapon[playerid] = gettime();
				}
			}
		}
		else if(PRESSED(KEY_CROUCH))
		{
			if((gettime() - ptsLastFiredWeapon[playerid]) < 1)
			{
				TogglePlayerControllable(playerid, false);

				pCBugging[playerid] = true;

				GameTextForPlayer(playerid, "~r~~h~DON'T C-BUG!", 3000, 4);

				KillTimer(ptmCBugFreezeOver[playerid]);
				ptmCBugFreezeOver[playerid] = SetTimerEx("CBugFreezeOver", 1500, false, "i", playerid);
			}
		}
	}
if(newkeys & KEY_SECONDARY_ATTACK)
{
    // MASUK BIZZ
    if(PlayerBizz[playerid] == -1)
    {
        for(new i = 0; i < MAX_BIZZ; i++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.0,
            BizzInfo[i][bEntranceX],
            BizzInfo[i][bEntranceY],
            BizzInfo[i][bEntranceZ]))
            {
                PlayerBizz[playerid] = i;

                SetPlayerInterior(playerid, BizzInfo[i][bInterior]);
                SetPlayerVirtualWorld(playerid, BizzInfo[i][bVirtualWorld]);

                SetPlayerPos(playerid,
                BizzInfo[i][bExitX],
                BizzInfo[i][bExitY],
                BizzInfo[i][bExitZ]);

                SetPlayerFacingAngle(playerid, 0.0);
                return 1;
            }
        }
    }
    // KELUAR BIZZ
    else
    {
        new i = PlayerBizz[playerid];

        if(IsPlayerInRangeOfPoint(playerid, 2.0,
        BizzInfo[i][bExitX],
        BizzInfo[i][bExitY],
        BizzInfo[i][bExitZ]))
        {
            SetPlayerInterior(playerid, 0);
            SetPlayerVirtualWorld(playerid, 0);

            SetPlayerPos(playerid,
            BizzInfo[i][bEntranceX],
            BizzInfo[i][bEntranceY],
            BizzInfo[i][bEntranceZ]);

            SetPlayerFacingAngle(playerid, 0.0);

            PlayerBizz[playerid] = -1;
            return 1;
        }
    }
}
	if(PRESSED(KEY_ACTION))
	{
		static vehicleid;

		if(IsPlayerInAnyVehicle(playerid) && ((vehicleid = GetPlayerVehicleID(playerid)) != INVALID_VEHICLE_ID))
		{
			if(GetVehicleModel(vehicleid) == 509 || GetVehicleModel(vehicleid) == 481 || GetVehicleModel(vehicleid) == 510) {
				new Float:x, Float:y, Float:z;
				GetPlayerPos(playerid, x, y, z);
				SetPlayerPos(playerid, x, y, z);

				ApplyAnimation(playerid, "PED", "BIKE_fall_off", 4.1, 0, 0, 0, 0, 0, 1);
			}
		}
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && pDialog [ playerid ] == false)
	{
	    new vehicleid = GetPlayerVehicleID(playerid);

	    if(vehicleid && (PRESSED(KEY_SPRINT) || PRESSED(KEY_JUMP)))
	    {
	        new Float: health;
		    GetVehicleHealth(vehicleid, health);

	        GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);

			if(!engine)
				SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Perhatikan", "{FFFFFF}Mesin Transportasi Belum Di Nyalakan.", "Tutup", "");

        	if(engine && Fuell[vehicleid] < 1.0 && IsVehicleHaveFuel(vehicleid))
				SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Perhatikan", "{FFFFFF}Tidak ada bahan bakar dalam transportasi.", "Tutup", "");

            if(vehicle_owner_id[vehicleid] != INVALID_PLAYER_ID)
			{
			    new owner_id = vehicle_owner_id[vehicleid];

		        for(new x; x < MAX_PLAYER_VEHICLES; x++)
					if(vehicleid == player_home_car[owner_id][x] && player_car_keys[owner_id][x] == 0)
						SPD(playerid, 0000, DIALOG_STYLE_MSGBOX, "Perhatikan", "{FFFFFF}Tidak ada kunci kontak, gunakan: /key atau /car.", "Tutup", "");
		    }
		}
	}
	if(PRESSED( KEY_FIRE ))
	{
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && IsPlayerInAnyVehicle(playerid))
			{
				foreach(new did : Doors)
				{
					if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]))
					{
						if(dData[did][dGarage] == 1)
						{
							if(dData[did][dIntposX] == 0.0 && dData[did][dIntposY] == 0.0 && dData[did][dIntposZ] == 0.0)
								return Error(playerid, "Interior entrance masih kosong, atau tidak memiliki interior.");

							if(dData[did][dLocked])
								return Error(playerid, "This entrance is locked at the moment.");

							if(dData[did][dFaction] > 0)
							{
								if(dData[did][dFaction] != pData[playerid][pMember])
									return Error(playerid, "This door only for faction.");
							}
							if(dData[did][dFamily] > 0)
							{
								if(dData[did][dFamily] != pData[playerid][pFamily])
									return Error(playerid, "This door only for family.");
							}

							if(dData[did][dVip] > pData[playerid][pVip])
								return Error(playerid, "Your VIP level not enough to enter this door.");

							if(dData[did][dAdmin] > admin_level[playerid])
								return Error(playerid, "Your admin level not enough to enter this door.");

							if(strlen(dData[did][dPass]))
							{
								new params[256];
								if(sscanf(params, "s[256]", params)) return Info(playerid, "/enter [password]");
								if(strcmp(params, dData[did][dPass])) return Error(playerid, "Invalid door password.");

								if(dData[did][dCustom])
								{
									SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
									LoadingObject(playerid);
								}
								else
								{
									SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
									LoadingObject(playerid);
								}
								pData[playerid][pInDoor] = did;
								LoadingObject(playerid);
								SetPlayerInterior(playerid, dData[did][dIntint]);
								SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
								SetCameraBehindPlayer(playerid);
								SetTimerEx("DrugEffectGone", 3000, false, "i", playerid);
							}
							else
							{
								if(dData[did][dCustom])
								{
									SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
									LoadingObject(playerid);
								}
								else
								{
									SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
									LoadingObject(playerid);
								}
								pData[playerid][pInDoor] = did;
								LoadingObject(playerid);
								SetPlayerInterior(playerid, dData[did][dIntint]);
								SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
								SetCameraBehindPlayer(playerid);
								SetTimerEx("DrugEffectGone", 3000, false, "i", playerid);
							}
						}
					}
					if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ]))
					{
						if(dData[did][dGarage] == 1)
						{
							if(dData[did][dFaction] > 0)
							{
								if(dData[did][dFaction] != pData[playerid][pMember])
									return Error(playerid, "This door only for faction.");
							}

							if(dData[did][dCustom])
							{
								SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
							}
							else
							{
								SetVehiclePosition(playerid, GetPlayerVehicleID(playerid), dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
							}
							pData[playerid][pInDoor] = -1;
							SetPlayerInterior(playerid, dData[did][dExtint]);
							SetPlayerVirtualWorld(playerid, dData[did][dExtvw]);
							SetCameraBehindPlayer(playerid);
						}
					}
				}
			}
	}
	if(PRESSED(KEY_SECONDARY_ATTACK))
	{
		    foreach(new did : Doors)
			{
				if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ]))
				{
					if(dData[did][dIntposX] == 0.0 && dData[did][dIntposY] == 0.0 && dData[did][dIntposZ] == 0.0)
						return Error(playerid, "Interior entrance masih kosong, atau tidak memiliki interior.");

					if(dData[did][dLocked])
						return Error(playerid, "This entrance is locked at the moment.");

					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != pData[playerid][pMember])
							return Error(playerid, "This door only for faction.");
					}
					if(dData[did][dFamily] > 0)
					{
						if(dData[did][dFamily] != pData[playerid][pFamily])
							return Error(playerid, "This door only for family.");
					}

					if(dData[did][dVip] > pData[playerid][pVip])
						return Error(playerid, "Your VIP level not enough to enter this door.");

					if(dData[did][dAdmin] > admin_level[playerid])
						return Error(playerid, "Your admin level not enough to enter this door.");

					if(strlen(dData[did][dPass]))
					{
						new params[256];
						if(sscanf(params, "s[256]", params)) return Info(playerid, "/enter [password]");
						if(strcmp(params, dData[did][dPass])) return Error(playerid, "Invalid door password.");

						if(dData[did][dCustom])
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						pData[playerid][pInDoor] = did;
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetTimerEx("DrugEffectGone", 3000, false, "i", playerid);
						LoadingObject(playerid);
					}
					else
					{
						if(dData[did][dCustom])
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						else
						{
							SetPlayerPosition(playerid, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ], dData[did][dIntposA]);
							LoadingObject(playerid);
						}
						pData[playerid][pInDoor] = did;
						LoadingObject(playerid);
						SetPlayerInterior(playerid, dData[did][dIntint]);
						SetPlayerVirtualWorld(playerid, dData[did][dIntvw]);
						SetCameraBehindPlayer(playerid);
						SetTimerEx("DrugEffectGone", 3000, false, "i", playerid);
					}
				}
				if(IsPlayerInRangeOfPoint(playerid, 2.8, dData[did][dIntposX], dData[did][dIntposY], dData[did][dIntposZ]))
				{
					if(dData[did][dFaction] > 0)
					{
						if(dData[did][dFaction] != pData[playerid][pMember])
							return Error(playerid, "This door only for faction.");
					}

					if(dData[did][dCustom])
					{
						SetPlayerPosition(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
						LoadingObject(playerid);
					}
					else
					{
						SetPlayerPosition(playerid, dData[did][dExtposX], dData[did][dExtposY], dData[did][dExtposZ], dData[did][dExtposA]);
						LoadingObject(playerid);
					}
					pData[playerid][pInDoor] = -1;
					LoadingObject(playerid);
					SetPlayerInterior(playerid, dData[did][dExtint]);
					SetPlayerVirtualWorld(playerid, dData[did][dExtvw]);
					SetCameraBehindPlayer(playerid);
				}
	        }
    }


    if(PRESSED(KEY_JUMP))
	{
	    if(GetPVarInt(playerid,"UseAnim"))
		{
			ClearAnim(playerid);
			SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			GameTextForPlayer(playerid, "~r~Cancel the Animation", 1500, 1);
			DeletePVar(playerid,"UseAnim");
		}
	}

    if(GetPlayerWeapon(playerid) == 41 && IsAGang(playerid))
	{
	    if(PRESSED(KEY_FIRE)) SetPVarInt(playerid,"ColorFire", 1);
	    if(RELEASED(KEY_FIRE)) DeletePVar(playerid,"ColorFire");
	}

    if(GetPVarInt(playerid,"AntiSbiv") > gettime()) return true;

	if(steal_timer[playerid] != -1)
	{
		KillTimer(steal_timer[playerid]);
		steal_timer[playerid] = -1;

		ClearAnimations(playerid);

		SendClientMessage(playerid, COLOR_GREY, "Anda mengganggu pencurian bahan bakar!");
	}

	if(RELEASED(KEY_SPRINT))
	{
	    if(player_rob_id[playerid] != -1)
		{
		    if(player_rob_progress[playerid] > 0)
		    {
		        player_rob_progress[playerid] = 0;

		        PlayerStopTryOpenDoor(playerid);

		        SCM(playerid, COLOR_RED, "Anda memecahkan klip kertas, persetan dengan yang baru.");
		    }
		}
	}
	if(newkeys & KEY_YES)
    {
        for(new i = 0; i < TotalBisnis; i++)
        {
            // Cek apakah player di VW bisnis tersebut
            if(GetPlayerVirtualWorld(playerid) == BisnisData[i][bzVW])
		{
		    // Cek jarak ke point belanja
		    if(IsPlayerInRangeOfPoint(playerid, 2.0, BisnisData[i][bzPointX], BisnisData[i][bzPointY], BisnisData[i][bzPointZ]))
		    {
		        // --- VALIDASI TIPE DISINI ---
		        if(BisnisData[i][bzType] == 1) // 1 adalah Electronic
		        {
		            SetPVarInt(playerid, "InsideBizIndex", i);
		            ShowPlayerDialog(playerid, DIALOG_ELECTRONIC_MENU, DIALOG_STYLE_LIST, "Electronic Store",
		                "Handphone\t500$\nJam Tangan\t500$\nBuku Telepon\t500$\nWalkie Talkie\t500$\nBoombox\t500$",
		                "Buy", "Close");
		            return 1;
		        }
		        else if(BisnisData[i][bzType] == 2) // Fastfood
		        {
		            SetPVarInt(playerid, "InsideBizIndex", i);
		            ShowPlayerDialog(playerid, DIALOG_FASTFOOD_MENU, DIALOG_STYLE_LIST, "Food Shop",
		                "Air Mineral\t500$\nCoffe\t500$\nNasi Padang\t500$\nDaging Ayam\t500$",
		                "Buy", "Close");
		            return 1;
		        }
		        else if(BisnisData[i][bzType] == 3) // Equipment
		        {
		            SetPVarInt(playerid, "InsideBizIndex", i);
		            ShowPlayerDialog(playerid, DIALOG_EQUIPMENT_MENU, DIALOG_STYLE_LIST, "Equipment Shop",
		                "Baseball Bat\t500$\nShovel\t500$\nKnife\t500$\nChainsaw\t500$\nCangkul\t500$",
		                "Buy", "Close");
		            return 1;
		        }
		        else if(BisnisData[i][bzType] == 4) // Market
		        {
		            SetPVarInt(playerid, "InsideBizIndex", i);
		            ShowPlayerDialog(playerid, DIALOG_MARKET_MENU, DIALOG_STYLE_LIST, "Market 24/7",
		                "Bandage\t500$\nMasker\t500$\nPancingan\t500$\nUmpan\t500$",
		                "Buy", "Close");
		            return 1;
		        }
		        else
		        {
		            SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Bisnis ini tidak menjual barang elektronik.");
		            return 1;
                    }
                }
            }
        }
    }
    
    if((newkeys & KEY_YES) && !(oldkeys & KEY_YES)) // Deteksi Tombol Y
    {
        for(new i = 0; i < TotalVending; i++)
        {
            if(IsPlayerInRangeOfPoint(playerid, 2.0, VendingData[i][vmX], VendingData[i][vmY], VendingData[i][vmZ]))
            {
                if(VendingData[i][vmLocked]) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Vending machine sedang terkunci.");
                if(VendingData[i][vmStock] <= 0) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Stok vending machine habis.");
                
                SetPVarInt(playerid, "InsideVendingID", i);
                ShowPlayerDialog(playerid, DIALOG_VENDING_BUY, DIALOG_STYLE_LIST, "Vending Machine - Belanja", 
                    "Cake ($15)\nSprunk ($10)\nCitato ($12)\nCoffee ($10)", "Beli", "Batal");
                return 1;
            }
        }
    }
    
      if (newkeys & KEY_YES)
    {
        // ---------------------------------------------------------------------
        // 1. LOGIKA UNTUK KELUAR DARI INTERIOR (SAAT DI DALAM)
        // ---------------------------------------------------------------------
        if (GetPVarInt(playerid, "InJourneyID") > 0)
        {
            // Cek apakah player berada tepat di dekat koordinat pintu keluar interior
            if (IsPlayerInRangeOfPoint(playerid, 3.0, 245.2307, 304.7632, 999.1484))
            {
                new vehid = GetPVarInt(playerid, "InJourneyID");
                
                if (GetVehicleModel(vehid) == 508) // Memastikan mobilnya masih ada & bertipe Journey
                {
                    new Float:vPos[3]; // Menggunakan array Float untuk menampung posisi X, Y, Z
                    GetVehiclePos(vehid, vPos[0], vPos[1], vPos[2]);
                    
                    // Teleport ke luar lokasi mobil terbaru (+2.0 di sumbu X agar tidak sangkut di badan mobil)
                    SetPlayerPos(playerid, vPos[0] + 2.0, vPos[1], vPos[2] + 1.0);
                    SetPlayerInterior(playerid, 0); 
                    SetPlayerVirtualWorld(playerid, 0); 
                    
                    DeletePVar(playerid, "InJourneyID"); // Hapus status interior player
                    SendClientMessage(playerid, -1, "Anda keluar dari kendaraan Journey.");
                    return 1;
                }
                else
                {
                    SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Kendaraan Journey ini sudah hancur atau hilang!");
                }
            }
        }
        
        // ---------------------------------------------------------------------
        // 2. LOGIKA UNTUK MASUK KE DALAM INTERIOR (SAAT DI LUAR)
        // ---------------------------------------------------------------------
        else if (GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
        {
            new vehid = INVALID_VEHICLE_ID;
            new Float:vPos[3]; 

            // Mencari mobil Journey terdekat dalam radius 5.0 meter
            for(new i = 1; i < MAX_VEHICLES; i++)
            {
                if(GetVehicleModel(i) == 508) 
                {
                    GetVehiclePos(i, vPos[0], vPos[1], vPos[2]); 
                    
                    // Deteksi jarak antara posisi player dengan posisi mobil i
                    if(GetPlayerDistanceFromPoint(playerid, vPos[0], vPos[1], vPos[2]) < 5.0)
                    {
                        vehid = i;
                        break; // Hentikan perulangan jika sudah ketemu yang terdekat
                    }
                }
            }

            // Jika mobil Journey ditemukan di dekat player
            if(vehid != INVALID_VEHICLE_ID)
            {
                // Teleport ke dalam interior Journey
                SetPlayerPos(playerid, 245.2307, 304.7632, 999.1484);
                SetPlayerInterior(playerid, 1);
                
                // Virtual World unik (ID Kendaraan + 5000) agar interior antar mobil tidak bercampur
                SetPlayerVirtualWorld(playerid, vehid + 5000); 
                SetPVarInt(playerid, "InJourneyID", vehid); // Kunci ID mobil di data player
                
                SendClientMessage(playerid, -1, "Anda masuk ke dalam kendaraan Journey.");
                return 1;
            }
        }
    }
    
      if((newkeys & KEY_SECONDARY_ATTACK) && !(oldkeys & KEY_SECONDARY_ATTACK)) // Tombol ENTER
    {
        // Masuk Rumah
        for(new i = 0; i < TotalDynHouse; i++) {
            if(IsPlayerInRangeOfPoint(playerid, 2.0, DynHouseData[i][dhX], DynHouseData[i][dhY], DynHouseData[i][dhZ])) {
                if(DynHouseData[i][dhLocked]) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Pintu rumah terkunci rapat!");
                
                if(DynHouseData[i][dhType] == 1) SetPlayerPos(playerid, 2196.85, -1204.25, 1049.02), SetPlayerInterior(playerid, 6);
                else if(DynHouseData[i][dhType] == 2) SetPlayerPos(playerid, 491.07, 1398.50, 1080.26), SetPlayerInterior(playerid, 2);
                else if(DynHouseData[i][dhType] == 3) SetPlayerPos(playerid, 140.17, 1366.07, 1083.65), SetPlayerInterior(playerid, 5);
                
                SetPlayerVirtualWorld(playerid, DynHouseData[i][dhID]); 
                return 1;
            }
        }
        // Keluar Rumah
        new currentVW = GetPlayerVirtualWorld(playerid);
        if(currentVW > 0) {
            for(new i = 0; i < TotalDynHouse; i++) {
                if(currentVW == DynHouseData[i][dhID]) {
                    if(IsPlayerInRangeOfPoint(playerid, 3.0, 2196.85, -1204.25, 1049.02) || 
                       IsPlayerInRangeOfPoint(playerid, 3.0, 491.07, 1398.50, 1080.26) || 
                       IsPlayerInRangeOfPoint(playerid, 3.0, 140.17, 1366.07, 1083.65)) 
                    {
                        SetPlayerPos(playerid, DynHouseData[i][dhX], DynHouseData[i][dhY], DynHouseData[i][dhZ]);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);
                        return 1;
                    }
                }
            }
        }
    }

	if(newkeys & KEY_SECONDARY_ATTACK)
    {
        // --- PROSES MASUK ---
        if(GetPlayerVirtualWorld(playerid) == 0)
        {
            for(new i = 0; i < TotalBisnis; i++)
            {
                if(IsPlayerInRangeOfPoint(playerid, 2.0, BisnisData[i][bzX], BisnisData[i][bzY], BisnisData[i][bzZ]))
                {
                    if(BisnisData[i][bzLocked]) return GameTextForPlayer(playerid, "~r~LOCKED", 2000, 3);

					if(BisnisData[i][bzType] != 1 && BisnisData[i][bzType] != 2 && BisnisData[i][bzType] != 3 && BisnisData[i][bzType] != 4)
					{
					    return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Bisnis ini tidak memiliki interior.");
					}
                    SetPlayerPos(playerid, BisnisData[i][bzIntX], BisnisData[i][bzIntY], BisnisData[i][bzZIntZ]);
                    SetPlayerInterior(playerid, BisnisData[i][bzInt]);
                    SetPlayerVirtualWorld(playerid, BisnisData[i][bzVW]);

                    // Efek Loading
                    LoadingObject(playerid);
                    TogglePlayerControllable(playerid, 0);
                    return 1;
                }
            }
        }
        // --- PROSES KELUAR ---
        else
        {
            for(new i = 0; i < TotalBisnis; i++)
            {
                if(GetPlayerVirtualWorld(playerid) == BisnisData[i][bzVW])
                {
                    if(IsPlayerInRangeOfPoint(playerid, 2.5, BisnisData[i][bzIntX], BisnisData[i][bzIntY], BisnisData[i][bzZIntZ]))
                    {
                        SetPlayerPos(playerid, BisnisData[i][bzX], BisnisData[i][bzY], BisnisData[i][bzZ]);
                        SetPlayerInterior(playerid, 0);
                        SetPlayerVirtualWorld(playerid, 0);

                        // Efek Loading
                        LoadingObject(playerid);
                        TogglePlayerControllable(playerid, 0);
                        return 1;
                    }
                }
            }
        }
    }
	//toll
    if(newkeys & KEY_CROUCH && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
     	callcmd::paytolll(playerid, "");
		return 1;
    }
    if(newkeys == KEY_NO)
    {
        if(PlayerInfo[playerid][pInjured] == 1)
        {
            callcmd::acceptdeath(playerid);
        }
		else
		{
            callcmd::radialbsvbs(playerid, "");
            callcmd::stopanim(playerid, "");
		}

    }
    if(newkeys == KEY_LOOK_BEHIND)
    {
        if(PlayerInfo[playerid][pInjured] == 1)
        {
            SPD(playerid, 8950, DIALOG_STYLE_INPUT, "Panggilan Ambulans", "Jelaskan tempat Anda berjalan:", "Untuk menelepon", "Tutup");
        }
    }
    if(newkeys == KEY_YES)
    {
        if(IsPlayerInRangeOfPoint(playerid, 8.0, 1189.2201, -1308.3878, 13.5547) && GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)

        {
            if(PlayerInfo[playerid][pMember] != FRACTION_LSMEDICS)
            {
                return Error(playerid, "You must be at ems officer faction!");
            }
            else
            {
                if(pData[playerid][pSpawnSapd] == 1)
                {
                    return Error(playerid, "Anda sudah mengeluarkan 1 kendaraan!");
                }

                new a = 586;
                new b = 442;
                new c = 416;
                new d = 487;

                new ZENN[250];
                strcat(ZENN, "Vehicles Name\tType\n");
                format(String, sizeof(String), "%s\tMotor\n", GetVehicleModelName(a));
                strcat(ZENN, String);
                format(String, sizeof(String), "%s\tMobil\n", GetVehicleModelName(b));
                strcat(ZENN, String);
                format(String, sizeof(String), "%s\tMobil\n", GetVehicleModelName(c));
                strcat(ZENN, String);
                format(String, sizeof(String), "%s\tHelicopter\n", GetVehicleModelName(d));
                strcat(ZENN, String);
                ShowPlayerDialog(playerid, DIALOG_EMS_GARAGE, DIALOG_STYLE_TABLIST_HEADERS, "Static Vehicles EMS", ZENN, "Spawn", "Cancel");
            }
        }
        else if(IsPlayerInRangeOfPoint(playerid, 2.5, 942.403259, -1668.839721, 14.079086)) //Layanan Perbankan
        {
            SetPlayerUseListitem(playerid, 0);
            MenuAtms(playerid);
        }
        else if(IsPlayerInRangeOfPoint(playerid, 2.5, 942.397521, -1665.556640, 14.079086)) //Pembayaran Properti
        {
            new text[32], text1[36], text2[32];
            if(GetPlayerHouse(playerid) == -1) text = "{FF6C00}Tidak di rumah";
            else format(text, sizeof(text), "{36DE00}Nomor rumah%d", GetPlayerHouse(playerid));

            if(GetPlayerBizz(playerid) == -1) text1 = "{FF6C00}Tidak ada bisnis";
            else format(text1, sizeof(text1), "{36DE00}%s (No%d)", BizzInfo[GetPlayerBizz(playerid)][bMessage], GetPlayerBizz(playerid));

            if(GetPlayerABizz(playerid) == 0) text2 = "{FF6C00}Tidak ada pom bensin";
            else format(text2, sizeof(text2), "{36DE00}%s (No%d)", BizzAInfo[GetPlayerABizz(playerid)][aMessage], GetPlayerABizz(playerid));

            format(String, 244, "{ffffff}1. Pembayaran rumah\t%s\n{ffffff}2. Pembayaran bisnis\t%s\n{ffffff}3. Pembayaran untuk pom bensin\t%s", text, text1, text2);
            SPD(playerid,107, DIALOG_STYLE_LIST,"Pembayaran Properti", String, "Pilih", "Keluar");
        }
        else if(IsPlayerInRangeOfPoint(playerid, 8.0, 1189.2201, -1308.3878, 13.5547) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
        {
            new vehicleid = GetPlayerVehicleID(playerid);
            if(PlayerInfo[playerid][pMember] != FRACTION_LSMEDICS)
            {
                return Error(playerid, "You must be at ems officer faction!");
            }

            if(!IsEMSCar(vehicleid))
            {
                return Error(playerid, "Anda tidak berada di kendaraan EMS.");
            }

            DestroyVehicle(EMSVehicles[playerid]);
            pData[playerid][pSpawnSapd] = 0;
            GameTextForPlayer(playerid, "~w~EMS Vehicles ~r~Despawned", 3500, 3);
        }
    }
	if(PRESSED(KEY_WALK))
    {
        //BALKOT
        //LIC
        if(IsPlayerInRangeOfPoint(playerid, 1.0, 497.4321,-2225.4348,790.0256)){
            if(GetPlayerMoney(playerid) < 1000) return SCM(playerid, COLOR_GREY, "Uang anda tidak cukup! minimal Rp. 10000");
            SPD(playerid, 619,DIALOG_STYLE_LIST, "Lisensi(Rp. 10000)", ""W"1. Lisensi Penerbangan\n2. Izin Transportasi Air", "Beli", "Tutup");
            return 1;
        }

        //MENUPAN
        if(IsPlayerInRangeOfPoint(playerid, 1.0, 2522.683105, -1536.496948, 24.279996))
        for (new i = 0; i < 10; i++)
        {
        PlayerTextDrawShow(playerid, Menupan[playerid][i]);
