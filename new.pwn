    if(!rows) return Send(playerid, -1,"Nama panggilan yang Anda tentukan tidak ada atau akun tidak diblokir!");

    mysql_format(mMysql, MySQLStr, 128, "DELETE FROM `banlog` WHERE `nameplayer` = '%e' AND `lockstate` = '1'", name);
