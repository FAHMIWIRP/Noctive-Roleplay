        SetPlayerFacingAngle(playerid, RandomJailSpawns[rand][3]);
        
        // Atur Interior 3 karena berada di koordinat Z 1003.5
        SetPlayerInterior(playerid, 3); 
        SetPlayerVirtualWorld(playerid, 0);

        // Memunculkan TextDraw dan mengatur timer kembali
