    {
        GameTextForPlayer(playerid, "~r~Butuh 1 NKoin!", 3000, 3);
        return 1;
    }

    new dialogStr[750];
    format(dialogStr, sizeof(dialogStr), "{FFFFFF}Koin Kamu: {FFFF00}%d NKoin\n\n", PlayerInfo[playerid][pNKoin]);
    strcat(dialogStr, "{FFFFFF}Hadiah yang bisa kamu dapatkan:\n");
    strcat(dialogStr, "{FF00FF}[DIVINE] {FFFFFF}Giok Permata\n");
    strcat(dialogStr, "{FF00FF}[DIVINE] {FFFFFF}Pesawat Shamal\n");
    strcat(dialogStr, "{FF0000}[MYTHIC] {FFFFFF}Mobil Patriot\n");
    strcat(dialogStr, "{FF0000}[MYTHIC] {FFFFFF}Giok Bintang\n");
    strcat(dialogStr, "{9933FF}[RARE] {FFFFFF}Skin ID 284\n");
    strcat(dialogStr, "{9933FF}[RARE] {FFFFFF}50 Gold\n");
    strcat(dialogStr, "{33AA33}[UNCOMMON] {FFFFFF}Uang Tunai ($10.000)\n\n");
    strcat(dialogStr, "{FFFFFF}Gacha Membutuhkan {FF0000}1 NKoin{FFFFFF}. Lanjutkan?");

    ShowPlayerDialog(playerid, DIALOG_GACHA, DIALOG_STYLE_MSGBOX, "{FF9900}Gacha Noctive Roleplay", dialogStr, "Gacha", "Batal");
    return 1;
}
forward EfekShufflingGacha(playerid, code, count);
public EfekShufflingGacha(playerid, code, count)
{
    if(!IsPlayerConnected(playerid)) return 1;

    new msg[64];

    // JIKA MASIH DALAM PROSES MENGACAK (Diulang sampai 15 kali)
    if(count < 15)
    {
        // Acak teks palsu secara random biar kelihatan gerak cepat
        new teksAcak = random(7);
        switch(teksAcak)
        {
            case 0: GameTextForPlayer(playerid, "~r~DIVINE:~n~~w~GIOK PERMATA?", 200, 3);
            case 1: GameTextForPlayer(playerid, "~r~DIVINE:~n~~w~PESAWAT SHAMAL?", 200, 3);
            case 2: GameTextForPlayer(playerid, "~r~MYTHIC:~n~~w~MOBIL PATRIOT?", 200, 3);
            case 3: GameTextForPlayer(playerid, "~r~MYTHIC:~n~~w~GIOK BINTANG?", 200, 3);
            case 4: GameTextForPlayer(playerid, "~p~RARE:~n~~w~SKIN ID 284?", 200, 3);
            case 5: GameTextForPlayer(playerid, "~p~RARE:~n~~w~50 GOLD?", 200, 3);
            case 6: GameTextForPlayer(playerid, "~g~UNCOMMON:~n~~w~UANG TUNAI?", 200, 3);
        }

        // Panggil timer ini lagi, naikkan count + 1
        SetTimerEx("EfekShufflingGacha", 150, false, "ddd", playerid, code, count + 1);
    }
    else // JIKA SUDAH SELESAI MENGACAK (Hitungan ke-16, Munculkan HADIAH ASLI)
    {
        PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0); // Bunyi sound dapet hadiah

        if(code == 1) // Peluang 0.01%
        {
            // [DIVINE] - GIOK PERMATA
             PlayerInfo[playerid][pGiokpermata] += 1;
             OnPlayerUpdateAccountsPer(playerid, "pGiokpermata", PlayerInfo[playerid][pGiokpermata]);

            GameTextForPlayer(playerid, "~r~D~g~I~b~V~y~I~p~N~w~E!~n~~p~GIOK PERMATA!!!", 6000, 5);
        }
        else if(code >= 2 && code <= 11) // Peluang 0.1%
        {
            // [DIVINE] - PESAWAT SHAMAL
            new u_car = -1;
            for(new i = 0; i < 5; i++) { 
                if(CarInfo[playerid][cModel][i] == 0) { u_car = i; break; }
            }
            if(u_car == -1) 
            {
                PlayerInfo[playerid][pNKoin] += 1; // Balikin koin kalau garasi penuh
                OnPlayerUpdateAccountsPer(playerid, "pNKoin", PlayerInfo[playerid][pNKoin]);
                GameTextForPlayer(playerid, "~r~Garasi Penuh! NKoin Dikembalikan.", 4000, 3);
                return 1;
            }
            format(VehiclePlate[playerid][u_car], 16, "GachaShamal"); 
            CarInfo[playerid][cModel][u_car] = 519; 
            CarInfo[playerid][cColor1][u_car] = 1; CarInfo[playerid][cColor2][u_car] = 1; 
            CarInfo[playerid][cFuel][u_car] = 100.0; CarInfo[playerid][cProbeg][u_car] = 0.0; 
            CarInfo[playerid][cCost][u_car] = 500000; CarInfo[playerid][cHeal][u_car] = 1000.0; 
            CarInfo[playerid][cLock][u_car] = 0; CarInfo[playerid][cDamagePanel][u_car] = 0;
            CarInfo[playerid][cDamageDoors][u_car] = 0; CarInfo[playerid][cDamageLights][u_car] = 0;
            CarInfo[playerid][cDamageTires][u_car] = 0;

            GameTextForPlayer(playerid, "~r~D~g~I~b~V~y~I~p~N~w~E!~n~~y~PESAWAT SHAMAL!!!", 6000, 5);
        }
        else if(code >= 12 && code <= 21) // Peluang 0.1%
        {
            // [MYTHIC] - MOBIL PATRIOT
            new u_car = -1;
            for(new i = 0; i < 5; i++) {
                if(CarInfo[playerid][cModel][i] == 0) { u_car = i; break; }
            }
            if(u_car == -1) 
            {
                PlayerInfo[playerid][pNKoin] += 1; 
                OnPlayerUpdateAccountsPer(playerid, "pNKoin", PlayerInfo[playerid][pNKoin]);
                GameTextForPlayer(playerid, "~r~Garasi Penuh! NKoin Dikembalikan.", 4000, 3);
                return 1;
            }
            format(VehiclePlate[playerid][u_car], 16, "GachaPatriot"); 
            CarInfo[playerid][cModel][u_car] = 470; 
            CarInfo[playerid][cColor1][u_car] = 0; CarInfo[playerid][cColor2][u_car] = 0; 
            CarInfo[playerid][cFuel][u_car] = 100.0; CarInfo[playerid][cProbeg][u_car] = 0.0; 
            CarInfo[playerid][cCost][u_car] = 150000; CarInfo[playerid][cHeal][u_car] = 1000.0; 
            CarInfo[playerid][cLock][u_car] = 0; CarInfo[playerid][cDamagePanel][u_car] = 0;
            CarInfo[playerid][cDamageDoors][u_car] = 0; CarInfo[playerid][cDamageLights][u_car] = 0;
            CarInfo[playerid][cDamageTires][u_car] = 0;

            GameTextForPlayer(playerid, "~r~MYTHIC:~n~~w~MOBIL PATRIOT!", 4000, 3);
        }
        else if(code >= 22 && code <= 41) // Peluang 0.2%
        {
            // [MYTHIC] - GIOK BINTANG
            GameTextForPlayer(playerid, "~r~MYTHIC:~n~~w~GIOK BINTANG!", 4000, 3);
            PlayerInfo[playerid][pGiokbintang] += 1;
             OnPlayerUpdateAccountsPer(playerid, "pGiokbintang", PlayerInfo[playerid][pGiokbintang]);
        }
        else if(code >= 42 && code <= 141) // Peluang 1.0%
        {
            // [RARE] - SKIN ID 284
            SetPlayerSkin(playerid, 284);
            PlayerInfo[playerid][pSkin] = 284; 
            OnPlayerUpdateAccountsPer(playerid, "pSkin", PlayerInfo[playerid][pSkin]);

            GameTextForPlayer(playerid, "~p~RARE:~n~~w~SKIN ID 284!", 4000, 3);
        }
        else if(code >= 142 && code <= 501) // Peluang 3.6%
        {
            // [RARE] - 50 GOLD
            GameTextForPlayer(playerid, "~p~RARE:~n~~w~50 GOLD!", 4000, 3);
            PlayerInfo[playerid][pRouble] += 50;
            OnPlayerUpdateAccountsPer(playerid,"pRouble",PlayerInfo[playerid][pRouble]);
        }
        else // Sisa angka (Peluang 94.99%)
        {
            // [UNCOMMON] - UANG TUNAI
            GivePlayerMoneyEx(playerid, 1000, "");
		
		    GameTextForPlayer(playerid, "~g~UNCOMMON:~n~~w~10.000$!", 4000, 3);
        }
    }
    return 1;
}
CMD:testour(playerid)
{
    StartCinematicTour(playerid);
    PlayAudioStreamForPlayer(playerid, "http://i.top4top.io/m_381203o001.mp3");
    return 1;
}
CMD:specc(playerid, params[])
{
    if(admin_level[playerid] < 1) return 1;
    new targetid;
    if(sscanf(params, "u", targetid)) return SendClientMessage(playerid, -1, "USAGE: /spec [playerid/Name]");
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, -1, "Player tidak ditemukan/offline.");
    if(targetid == playerid) return SendClientMessage(playerid, -1, "Kamu tidak bisa spectate diri sendiri.");

    sp(playerid, targetid);
    return 1;
}

stock sp(playerid, targetid)
{
    SpectatingTarget[playerid] = targetid;
    TogglePlayerSpectating(playerid, 1);

    if(IsPlayerInAnyVehicle(targetid))
        PlayerSpectateVehicle(playerid, GetPlayerVehicleID(targetid));
    else
        PlayerSpectatePlayer(playerid, targetid);

    UpdateSpecTD(playerid, targetid);

    for(new i = 0; i < 16; i++)
{
    PlayerTextDrawShow(playerid, tssppanjulll[playerid][i]);
}
    SelectTextDraw(playerid, 0xFF0000FF);
    return 1;
}

stock spoff(playerid)
{
    SpectatingTarget[playerid] = -1;
    TogglePlayerSpectating(playerid, 0);
    CancelSelectTextDraw(playerid);

    for(new i = 0; i < 16; i++)
    {
        TextDrawHideForPlayer(playerid, spnew[i]);
    }
    return 1;
}
CMD:claimsp(playerid)
{
    // Pengecekan ditaruh paling atas agar tidak bug
    if(PlayerInfo[playerid][pWargaNew] == 1) 
        return SCM(playerid, COLOR_GREEN, "Kamu sudah mengambil Staterpack Jangan Maruk");
    
    new u_car = GetPlayerFreeCarSlot(playerid); 
    if(u_car == -1) 
    { 
        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda tidak memiliki slot kosong"); 
    } 
    
    // Menampilkan dialog konfirmasi pertama
    ShowPlayerDialog(playerid, DIALOG_CLAIM_SP, DIALOG_STYLE_MSGBOX, 
        "{00FF00}Starterpack Warga Baru", 
        "{FFFFFF}Apakah kamu ingin mengambil Starterpack khusus warga baru sekarang?", 
        "Ambil", "Nanti"
    );
    
    return 1;
}
// =============================================================================
public StartCinematicTour(playerid)
{
    PlayerCinematicStep[playerid] = 0;
    TogglePlayerControllable(playerid, false); // Freeze player agar tidak jatuh/kabur

    // Simpan posisi asli tempat player mengetik /claimsp agar bisa dikembalikan nanti
    GetPlayerPos(playerid, OrigPlayerPos[playerid][0], OrigPlayerPos[playerid][1], OrigPlayerPos[playerid][2]);
    OrigPlayerInt[playerid] = GetPlayerInterior(playerid);
    OrigPlayerVW[playerid] = GetPlayerVirtualWorld(playerid);

    // ================= BUAT SEMUA TEXTDRAW SCREEN (7 elemen) =================

    // [0] Bar putih kiri (frame vertikal kiri)
    SCREEN[playerid][0] = CreatePlayerTextDraw(playerid, 0.000, -1.000, "LD_SPAC:white");
    PlayerTextDrawTextSize(playerid, SCREEN[playerid][0], 63.000, 452.000);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][0], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][0], 255);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][0], 0);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][0], 0);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][0], 255);
    PlayerTextDrawFont(playerid, SCREEN[playerid][0], 4);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][0], 1);

    // [1] Bar putih kanan (frame vertikal kanan)
    SCREEN[playerid][1] = CreatePlayerTextDraw(playerid, 578.000, -1.000, "LD_SPAC:white");
    PlayerTextDrawTextSize(playerid, SCREEN[playerid][1], 63.000, 452.000);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][1], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][1], 255);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][1], 0);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][1], 0);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][1], 255);
    PlayerTextDrawFont(playerid, SCREEN[playerid][1], 4);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][1], 1);

    // [2] Bar horizontal atas (top strip)
    SCREEN[playerid][2] = CreatePlayerTextDraw(playerid, 578.000, -1.000, "LD_SPAC:white");
    PlayerTextDrawTextSize(playerid, SCREEN[playerid][2], -544.000, 28.000);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][2], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][2], 255);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][2], 0);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][2], 0);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][2], 255);
    PlayerTextDrawFont(playerid, SCREEN[playerid][2], 4);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][2], 1);

    // [3] Bar horizontal bawah (kotak dialog subtitle)
    SCREEN[playerid][3] = CreatePlayerTextDraw(playerid, 578.000, 405.000, "LD_SPAC:white");
    PlayerTextDrawTextSize(playerid, SCREEN[playerid][3], -544.000, 45.000);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][3], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][3], 255);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][3], 0);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][3], 0);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][3], 255);
    PlayerTextDrawFont(playerid, SCREEN[playerid][3], 4);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][3], 1);

    // [4] Preview model (ikon/avatar "Panjul" di pojok kiri bawah kotak dialog)
    SCREEN[playerid][4] = CreatePlayerTextDraw(playerid, 84.000, 322.000, "_");
    PlayerTextDrawTextSize(playerid, SCREEN[playerid][4], 90.000, 90.000);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][4], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][4], -1);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][4], 0);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][4], 0);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][4], -256);
    PlayerTextDrawFont(playerid, SCREEN[playerid][4], 5);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][4], 0);
    PlayerTextDrawSetPreviewModel(playerid, SCREEN[playerid][4], 264);
    PlayerTextDrawSetPreviewRot(playerid, SCREEN[playerid][4], 0.000, -1.000, 3.000, 1.000);
    PlayerTextDrawSetPreviewVehCol(playerid, SCREEN[playerid][4], 0, 0);

    // [5] Teks subtitle (isi dialog, berubah tiap step)
    SCREEN[playerid][5] = CreatePlayerTextDraw(playerid, 189.000, 366.000, "_");
    PlayerTextDrawLetterSize(playerid, SCREEN[playerid][5], 0.270, 1.099);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][5], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][5], -1);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][5], 1);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][5], 1);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][5], 150);
    PlayerTextDrawFont(playerid, SCREEN[playerid][5], 1);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][5], 1);

    // [6] Nama pembicara ("Panjul :"), statis
    SCREEN[playerid][6] = CreatePlayerTextDraw(playerid, 151.000, 366.000, "Panjul :");
    PlayerTextDrawLetterSize(playerid, SCREEN[playerid][6], 0.270, 1.099);
    PlayerTextDrawAlignment(playerid, SCREEN[playerid][6], 1);
    PlayerTextDrawColor(playerid, SCREEN[playerid][6], -1);
    PlayerTextDrawSetShadow(playerid, SCREEN[playerid][6], 1);
    PlayerTextDrawSetOutline(playerid, SCREEN[playerid][6], 1);
    PlayerTextDrawBackgroundColor(playerid, SCREEN[playerid][6], 150);
    PlayerTextDrawFont(playerid, SCREEN[playerid][6], 1);
    PlayerTextDrawSetProportional(playerid, SCREEN[playerid][6], 1);

    // Tampilkan semua textdraw ke player
    for(new i = 0; i < 7; i++)
    {
        PlayerTextDrawShow(playerid, SCREEN[playerid][i]);
    }
    for(new i = 0; i < 51; i++)
	{
        PlayerTextDrawHide(playerid, infop[playerid][i]);
    }
    for(new i = 0; i < 20; i++)
    {
        PlayerTextDrawHide(playerid, wbaru[playerid][i]);
    }
     for(new i = 0; i < 18; i++)
	{
        PlayerTextDrawHide(playerid, hbepanjulnoctive[playerid][i]);
    }

    // Jalankan step 0 (Intro) langsung tanpa delay
    UpdateCinematicStep(playerid);

    // Set timer otomatis berulang setiap 15 detik (15000 ms)
    PlayerCinematicTimer[playerid] = SetTimerEx("OnCinematicTimer", 15000, true, "i", playerid);
    return 1;
}

// =============================================================================
// CALLBACK TIMER (Berpindah Setiap 15 Detik)
// =============================================================================
public OnCinematicTimer(playerid)
{
    PlayerCinematicStep[playerid]++;

    // Jika semua lokasi sudah selesai dikunjungi (Total 8 Step: 0 sampai 7)
    if(PlayerCinematicStep[playerid] > 7)
    {
        KillTimer(PlayerCinematicTimer[playerid]);
        PlayerCinematicTimer[playerid] = 0;

        // Kembalikan tubuh player ke posisi asli saat mengetik /claimsp tadi
        SetPlayerPos(playerid, OrigPlayerPos[playerid][0], OrigPlayerPos[playerid][1], OrigPlayerPos[playerid][2]);
        SetPlayerInterior(playerid, OrigPlayerInt[playerid]);
        SetPlayerVirtualWorld(playerid, OrigPlayerVW[playerid]);

        TogglePlayerControllable(playerid, true); // Unfreeze player kembali normal
        SetCameraBehindPlayer(playerid); // Kembalikan kamera ke belakang player
        StopAudioStreamForPlayer(playerid);

        // Hancurkan semua textdraw SCREEN
        for(new i = 0; i < 7; i++)
        {
            if(SCREEN[playerid][i] != PlayerText:INVALID_TEXT_DRAW)
            {
                PlayerTextDrawHide(playerid, SCREEN[playerid][i]);
                PlayerTextDrawDestroy(playerid, SCREEN[playerid][i]);
                SCREEN[playerid][i] = PlayerText:INVALID_TEXT_DRAW;
            }
        }
        // Tampilkan semua textdraw ke player
    for(new i = 0; i < 51; i++)
	{
        PlayerTextDrawShow(playerid, infop[playerid][i]);
    }
    for(new i = 0; i < 20; i++)
    {
        PlayerTextDrawShow(playerid, wbaru[playerid][i]);
    }
     for(new i = 0; i < 18; i++)
	{
        PlayerTextDrawShow(playerid, hbepanjulnoctive[playerid][i]);
    }
        

        SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Tour Location Sudah Selesai Gunakan /mission Untuk Melihat Misi Anda!");
        return 1;
    }

    UpdateCinematicStep(playerid);
    return 1;
}

// =============================================================================
// CORE SCRIPT: PENGATUR GERAKAN KAMERA & TEKS DIALOG (PAKAI SCREEN TD BARU)
// =============================================================================
stock UpdateCinematicStep(playerid)
{
    new str[256];

    switch(PlayerCinematicStep[playerid])
    {
        case 0: // INTRO
        {
            SetCameraBehindPlayer(playerid);
            format(str, sizeof(str), "Selamat datang di tour location Noctive Roleplay, ikuti terus ya!");
        }
        case 1: // City Hall
        {
            SetPlayerPos(playerid, 1202.565307, -2036.496704, 69.007812);
            SetPlayerCameraPos(playerid, 1202.565307, -2036.496704, 69.007812);
            SetPlayerCameraLookAt(playerid, 1202.565307 + (20 * floatsin(-91.903945, degrees)), -2036.496704 + (20 * floatcos(-91.903945, degrees)), 69.007812);
            format(str, sizeof(str), "Ini adalah City Hall, kamu bisa mengambil idcard di sini");
        }
        case 2: // LSPD
        {
            SetPlayerPos(playerid, 1515.812622, -1675.203491, 14.046875);
            SetPlayerCameraPos(playerid, 1515.812622, -1675.203491, 14.046875);
            SetPlayerCameraLookAt(playerid, 1515.812622 + (20 * floatsin(-267.041442, degrees)), -1675.203491 + (20 * floatcos(-267.041442, degrees)), 14.046875);
            format(str, sizeof(str), "Ini adalah kantor departemen Police, kamu bisa membuat SIM di sini");
        }
        case 3: // SAMD
        {
            SetPlayerPos(playerid, 1210.833129, -1324.829223, 13.398437);
            SetPlayerCameraPos(playerid, 1210.833129, -1324.829223, 13.398437);
            SetPlayerCameraLookAt(playerid, 1210.833129 + (20 * floatsin(-88.884490, degrees)), -1324.829223 + (20 * floatcos(-88.884490, degrees)), 13.398437);
            format(str, sizeof(str), "Ini adalah Rumah Sakit, kamu bisa membeli obat atau treatment di sini");
        }
        case 4: // Bank
        {
            SetPlayerPos(playerid, 912.390808, -1691.349853, 13.369023);
            SetPlayerCameraPos(playerid, 912.390808, -1691.349853, 13.369023);
            SetPlayerCameraLookAt(playerid, 912.390808 + (20 * floatsin(-319.506378, degrees)), -1691.349853 + (20 * floatcos(-319.506378, degrees)), 13.369023);
            format(str, sizeof(str), "Ini adalah Bank, kamu bisa mengambil uang atau menabung di sini");
        }
        case 5: // Pedagang
        {
            SetPlayerPos(playerid, 2514.915527, -1506.101928, 23.828125);
            SetPlayerCameraPos(playerid, 2514.915527, -1506.101928, 23.828125);
            SetPlayerCameraLookAt(playerid, 2514.915527 + (20 * floatsin(-182.148223, degrees)), -1506.101928 + (20 * floatcos(-182.148223, degrees)), 23.828125);
            format(str, sizeof(str), "Ini adalah Pedagang, kamu bisa membeli makanan atau minuman di sini");
        }
        case 6: // Dealer
        {
            SetPlayerPos(playerid, 624.775695, -1512.299560, 14.829710);
            SetPlayerCameraPos(playerid, 624.775695, -1512.299560, 14.829710);
            SetPlayerCameraLookAt(playerid, 624.775695 + (20 * floatsin(-267.634429, degrees)), -1512.299560 + (20 * floatcos(-267.634429, degrees)), 14.829710);
            format(str, sizeof(str), "Ini adalah Dealer, kamu bisa membeli kendaraan di sini");
        }
        case 7: // SA News
        {
            SetPlayerPos(playerid, 1656.416015, -1669.139282, 21.437500);
            SetPlayerCameraPos(playerid, 1656.416015, -1669.139282, 21.437500);
            SetPlayerCameraLookAt(playerid, 1656.416015 + (20 * floatsin(-263.571350, degrees)), -1669.139282 + (20 * floatcos(-263.571350, degrees)), 21.437500);
            format(str, sizeof(str), "Ini adalah SA News, kamu bisa mengiklankan sesuatu di sini");
        }
    }

    // Update teks subtitle di SCREEN[playerid][5], bukan lagi CinematicText
    PlayerTextDrawSetString(playerid, SCREEN[playerid][5], str);
    return 1;
}

CMD:salaryjobs(playerid, params[])
{
    new line3[1500]; // 1500 sudah sangat cukup untuk teks ini
    line3[0] = '\0'; // Memastikan string kosong di awal

    format(line3, sizeof(line3), "{ffffff}_________[{00FFFC}Noctive Salary Job{ffffff}]_________\n\n");
    
    strcat(line3, "{007bff}Job salary:\n"); // Mengganti SBLUE_E ke hex jika define bermasalah
    strcat(line3, "{ffffff}-Job Chicken Cutter: {ffff00}$500 / 3Paket\n");
    strcat(line3, "{ffffff}-Job Miner Gold: {ffff00}$975-100.000$\n");
    strcat(line3, "{ffffff}-Job Create Component: {ffff00}$555 / 20 Compo\n");
    strcat(line3, "{ffffff}-Job Farmer: {ffff00}$500 / 20 Padi\n");
    strcat(line3, "{ffffff}-Job Driver Restock: {ffff00}$400 - $1,000\n");
    strcat(line3, "{ffffff}-Job Hauling: {ffff00}$1,000 - $2,000\n");
    strcat(line3, "{ffffff}-Job Minyak: {ffff00}$500 / 10 Minyak\n");
    strcat(line3, "{ffffff}-Job Packet Ilegal: {ffff00}2k Redmoney & 1g Marijuana\n");
    strcat(line3, "{ffffff}-Job Merchant Filler: {ffff00}$220\n");
    strcat(line3, "{ffffff}-Job Production: {ffff00}$250\n");
    strcat(line3, "{ffffff}-Job Fishing: {ffff00}$70 - 5.000 / ikan\n");
    strcat(line3, "{ffffff}-Job Pemeras Susu: {ffff00}$500-1.000-\n");
    
    // Gunakan ID Dialog yang lebih kecil/aman, misal: 9988
    ShowPlayerDialog(playerid, 9988, DIALOG_STYLE_MSGBOX, "{ffffff}Noctive Roleplay | Salary Jobs", line3, "Close", "");
    return 1;
}
public BottomClock_Update()
{
    new hours, minutes, seconds;
    new bClockStr[32];
    
    // Mengambil waktu asli server
    gettime(hours, minutes, seconds);
    
    // Ganti menjadi 6 karena selisihnya tepat 6 jam
    new timeOffset = 6; 
    
    hours = hours + timeOffset;
    
    // Logika agar jam tidak melebihi 24 atau menjadi minus
    if(hours > 23) {
        hours = hours - 24;
    } 
    else if(hours < 0) {
        hours = hours + 24;
    }
    
    // Memformat waktu menjadi HH:MM:SS
    format(bClockStr, sizeof(bClockStr), "%02d:%02d:%02d", hours, minutes, seconds);
    
    // Menerapkan ke TextDraw
    TextDrawSetString(BottomClock_TD, bClockStr);
    return 1;
}

CMD:buyboat(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 132.767730, -1832.211181, 4.405970))
        return SendClientMessage(playerid, COLOR_RED, "Kamu harus di dealer kapal.");

    if(PlayerInfo[playerid][pCash] < 10000)
        return SendClientMessage(playerid, COLOR_RED, " Uang kamu kurang. Butuh $10.000.");

    new u_car = GetPlayerFreeCarSlot(playerid);
    if(u_car == -1)
        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda tidak memiliki slot kosong");

    // ATAU pake model lain yang kamu inginkan
    // new vehicleid = AddStaticVehicle(MODEL_ID, x, y, z, a, 0, 0);

    PlayerInfo[playerid][pCash] -= 10000;
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);

    format(VehiclePlate[playerid][u_car], 16, "NoHave"); 
    CarInfo[playerid][cModel][u_car] = 454; 
    CarInfo[playerid][cColor1][u_car] = 0; 
    CarInfo[playerid][cColor2][u_car] = 0; 
    CarInfo[playerid][cFuel][u_car] = 100.0; 
    CarInfo[playerid][cProbeg][u_car] = 0.0; 
    CarInfo[playerid][cCost][u_car] = 1000; 
    CarInfo[playerid][cHeal][u_car] = 1000.0; 
    CarInfo[playerid][cLock][u_car] = 0; 
    CarInfo[playerid][cDamagePanel][u_car] = 0; 
    CarInfo[playerid][cDamageDoors][u_car] = 0; 
    CarInfo[playerid][cDamageLights][u_car] = 0; 
    CarInfo[playerid][cDamageTires][u_car] = 0; 
    CarInfo[playerid][cGun][u_car] = 0; 
    CarInfo[playerid][cAmmo][u_car] = 0; 
    CarInfo[playerid][cFood][u_car] = 0; 
    CarInfo[playerid][cDrink][u_car] = 0; 
    CarInfo[playerid][cBatu][u_car] = 0; 
    CarInfo[playerid][cBatuk][u_car] = 0; 
    CarInfo[playerid][cMetall][u_car] = 0; 
    CarInfo[playerid][cComponent][u_car] = 0; 
    CarInfo[playerid][cGarkot][u_car] = 0; 
    CarInfo[playerid][cInGarkot][u_car] = 0; 

    new str[128];
    format(str, sizeof(str), " Anda Membeli Kapal Silahkan Spawn Di Garkot Sebelah Dealership Kapal", CarInfo[playerid][cModel][u_car], u_car);
    SendClientMessage(playerid, COLOR_YELLOW, str);

    return 1;
}

