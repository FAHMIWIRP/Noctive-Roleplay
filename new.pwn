    return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}
CMD:selldrugs(playerid, params[])
{
	new to_player, amount, price;

    if(sscanf(params, "uii", to_player, amount, price)) return SCM(playerid,0x00D900AA, "[Petunjuk]: {FFFFFF}/selldrugs [id] [amount] [price]");

	if(!(1 <= amount <= 500)) return SCM(playerid, COLOR_GREY, "Chuck terjangkau dari 1 sampai 500");

	if(!(1 <= price <= 50000)) return SCM(playerid, COLOR_GREY, "Harga terjangkau dari $1 hingga $50,000");

	if(PlayerInfo[playerid][pDrugs] < amount) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki semacam itu pelindung.");

  	if(!ProxDetectorS(5.0, playerid, to_player)) return SCM(playerid, COLOR_GREY, "Kau Yalek dari pemain ini.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan masuk untuk pertukaran!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLDRUGS, price, amount);

	SCMF(playerid, 0x6BB3FFAA, "Anda telah menawarkan %s untuk membeli dari Anda %i gr. $%i obat.", GetPlayerNameEx(to_player), amount, price);
	SCMF(to_player, 0x6BB3FFAA, "%s menawarkan Anda untuk membeli %i gr. $%i obat.", GetPlayerNameEx(playerid), amount, price);

    return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}
CMD:sellgun(playerid, params[])
{
    new to_player, ammo, price;
	if(sscanf(params, "uii", to_player, ammo, price)) return SCM(playerid,0x00D900AA, "[Petunjuk]: {FFFFFF}/sellgun [id] [ammo] [price]");

 	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "Anda mengirim senjata di level 5");

	if(params[0] == playerid) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menjual ke diri sendiri.");

	new weapon_id = GetPlayerWeapon(playerid);

	if(weapon_id == 0) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki pistol di tangan Anda.");

	if(!(1 <= ammo <= 1000)) return SCM(playerid, COLOR_GREY, "Chuck terjangkau dari 1 sampai 1000");

	if(!(1 <= price <= 50000)) return SCM(playerid, COLOR_GREY, "Harga terjangkau dari $1 hingga $50,000");

	if(GetPlayerAmmo(playerid) < ammo) return SCM(playerid, COLOR_GREY, "Anda tidak memiliki peluru sebanyak itu.");
	if(GetPlayerAmmo(playerid) == ammo) return SCM(playerid, COLOR_GREY, "Anda tidak bisa menjual semua yang ada di tangan.");

	if(!ProxDetectorS(5.0, playerid, to_player)) return SCM(playerid, COLOR_GREY, "Kamu jauh dari pemain ini.");

	if(GetPlayerOfferInfo(to_player, O_INCOMING_PLAYER) != INVALID_PLAYER_ID) return SCM(playerid, COLOR_GREY, "Pemain sudah memiliki permintaan masuk untuk pertukaran!");

	SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLGUN, price, weapon_id, ammo);

	SCMF(playerid, -1, "Anda menawarkan %s untuk membeli senjata dari Anda %s (%i Fri) seharga $%i.", GetPlayerNameEx(to_player), GetWeaponNames(weapon_id), ammo, price);
	SCMF(to_player, -1, "%s menawarkan Anda untuk membeli senjata %s (%i fri) seharga $%i.", GetPlayerNameEx(playerid), GetWeaponNames(weapon_id), ammo, price);

	return SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}

CMD:gotomp(playerid)
{
	if(mp_status == 0) return SCM(playerid, COLOR_GREY, "Pada One Point, koleksi pada MP berhenti.");

	if(PlayerCuffed[playerid]) return SCM(playerid, COLOR_GREY, "Anda berada di belakang dunia.");

	if(player_tie[playerid]) return SCM(playerid, COLOR_GREY, "Anda berada di belakang dunia.");

	SetPPos(playerid, mp_X, mp_Y, mp_Z, 0.0, mp_int, mp_world, true);

	return SCM(playerid, COLOR_YELLOW, "Anda diteleportasi ke MP.");
}
CMD:ochat(playerid, params[]) //buat ngechatnya
{
	if(!admin_logged[playerid] && (PlayerInfo[playerid][pVip] < 1)) return 1;

    if(sscanf(params, "s[213]", params[0])) return SCM(playerid, -1, "USAGE: /ochat [Text]");

    new levelstats[128];
   	if(PlayerInfo[playerid][pVip]   ==1)    levelstats = "Low";
	if(PlayerInfo[playerid][pVip]   ==2)    levelstats = "Medium";
	if(PlayerInfo[playerid][pVip]   ==3)    levelstats = "High";
   	if(GetPVarInt(playerid,"pTimeOchat") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
    format(String, 213, "(( {00EFFF}[%s] {FFFFFF}%s: %s ))", levelstats, GetPlayerNameEx(playerid), params[0]);
    SendClientMessageToAll(-1, String);
   	SetPVarInt(playerid, "pTimeOchat", gettime() + 300);
    return 1;
}
CMD:oochat(playerid, params[]) //buat ngechatnya
{
	if(!admin_logged[playerid] && (PlayerInfo[playerid][pVip] < 1)) return 1;

    if(sscanf(params, "s[213]", params[0])) return SCM(playerid, -1, "USAGE: /ochat [Text]");

    new levelstats[128];
   	if(admin_level[playerid]        <=4)    levelstats = "BabuServer";
	if(admin_level[playerid]        ==7)    levelstats = "KepalaBabu";
	if(admin_level[playerid]        ==8)    levelstats = "Admins";
	if(admin_level[playerid]        ==10)    levelstats = "Management";
   	if(GetPVarInt(playerid,"pTimeOchat1") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
    format(String, 213, "(( {FF0000}[%s Server] {FFFFFF}%s: %s ))", levelstats, GetPlayerNameEx(playerid), params[0]);
    SendClientMessageToAll(-1, String);
   	SetPVarInt(playerid, "pTimeOchat1", gettime() + 300);
    return 1;
}
CMD:oc(playerid, params[]) //buat ngechatnya
{
   	if(oocon < 1 ) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Saat Ini, Tidak Bisa Menggunakan OOC Global Chat");
    new levelstats[128];
    if(PlayerInfo[playerid][pLevel] >= 3) levelstats = "Newbie"; //ini kalo level di bawah 3
    if(PlayerInfo[playerid][pLevel] >= 6) levelstats = "Noob"; //ini kalo level di atas 5
    if(PlayerInfo[playerid][pLevel] >= 10) levelstats = "Medium"; //ini kalo level di atas 3
    if(PlayerInfo[playerid][pLevel] >= 15) levelstats = "Pro"; //ini kalo level di atas 10
	
    if(sscanf(params, "s[213]", params[0])) return SCM(playerid, -1, "USAGE: /oc [Text]");
    format(String, 213, "(( {00EFFF}[%s Player] {FFFFFF}%s: %s ))", levelstats, GetPlayerNameEx(playerid), params[0]);
    SendClientMessageToAll(-1, String);
   	if(oocon < 1 ) return SCM(playerid, COLOR_RED, "ERROR: {FFFFFF}Saat Ini, Tidak Bisa Menggunakan OOC Global Chat");
    return 1;
}
CMD:ooc(playerid, params[]) //buat nyalain dan matiin
{
    //if(GetPlayerAdminEx(playerid) < 1) return 1; //gunakan ini jika gm kalian inferno nirp
    if(admin_level[playerid] == 0) return 1;

    switch(oocon)
    {
        case 0:
        {
            oocon = 1;
            format(String, 213, "Admin %s Menyalakan Chat Global OOC", GetPlayerNameEx(playerid));
        }
        case 1:
        {
            oocon = 0;
            format(String, 213, "Admin %s Mematikan Chat Gobal OOC", GetPlayerNameEx(playerid));
        }
    }
    SendClientMessageToAll(COLOR_YELLOW, String);
    return 1;
}

CMD:mpmenu(playerid)
{
	if(admin_level[playerid] < 999999) return 1;

	format(format_string, 244, "- Bagikan senjata\n- Ambil senjata\n- Bagikan kesehatan\n- Bagikan baju besi\n- Beri warna nama panggilan\n- Tandai teleportasi\n- Tandai status: %s",
	    mp_status ? ("Aktif") : ("Tidak Aktif"));

	return SPD(playerid, 3488, DIALOG_STYLE_LIST, "MP", format_string, "Select", "Close");
}

CMD:usedrugs(playerid, params[])
{
    if(IsPlayerGovermentWork(playerid)) return SendClientMessage(playerid, COLOR_GREY,"Anda adalah sebuah organisasi Pemerintah");
	if(PlayerInfo[playerid][pLevel] < 5) return ShowWarning(playerid, "fitur ini tersedia dari level 5");
 	if(sscanf(params, "i", params[0])) return SCM(playerid,0x00D900AA, "[Petunjuk]: {FFFFFF}/usedrugs [gram(1-6)]");
	if(params[0] < 1 || params[0] > 6) return SCM(playerid,0x00D900AA, "Dimungkinkan untuk menggunakan 1 - 6 gram");
	if(PlayerInfo[playerid][pDrugs] < params[0]) return SCM(playerid,COLOR_GREY,"Kamu tidak punya banyak obat!");

	if(GetPVarInt(playerid,"Drug_Time")) return SCMF(playerid,COLOR_GREY,"Ini akan memungkinkan untuk digunakan dalam %i detik.", GetPVarInt(playerid,"Drug_Time"));

	new Float: armour;

	GetPlayerArmour(playerid, armour);

	armour += params[0] * 2.0;

	if(armour > 100.0) armour = 100.0;

	SetPlayerArmourEx(playerid, armour);

	PlayerInfo[playerid][pDrugs] -= params[0];
	PlayerInfo[playerid][pDrugDep] += params[0];

	GameTextForPlayer(playerid, "~r~cie mabuk", 4000, 4);
    SetPlayerChatBubble(playerid,"menggunakan obat",COLOR_PURPLE,10.0,10000);
    SetPlayerWeather(playerid, -68);

    SetPVarInt(playerid,"Drug_Time", 120);

    format(format_string, 144, "UPDATE `accounts` SET `pDrugs` = %i, `pDrugDep` = %i WHERE `pID` = %i", PlayerInfo[playerid][pDrugs], PlayerInfo[playerid][pDrugDep], GetPlayerAccountID(playerid));
    mysql_tquery(mMysql, format_string);

    if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
    return SCMF(playerid,0x0099FFAA,"You use drugs! ( %.0f/100 )", armour);
}

CMD:graffiti(playerid)
{
	if(!IsAGang(playerid)) return SCM(playerid, COLOR_GREY, "Hanya tersedia untuk geng.");

	String = "";
	new str[48], count;

	for(new i; i < MAX_GRAFFITI; i++)
	{
	    if(graffiti_fraction[i] == PlayerInfo[playerid][pMember]) continue;

		new Float: dist = GetPlayerDistanceFromPoint(playerid, graffiti_obj_pos[i][0], graffiti_obj_pos[i][1], graffiti_obj_pos[i][2]);

	    format(str, 48, "%i\t%s\t%.1f\n", i, GetFractionName(graffiti_fraction[i]), dist);
	    strcat(String, str);

	    SetPlayerListitemValue(playerid, count++, i);
	}

	if(!count) return SCM(playerid, COLOR_GREY, "Geng Anda telah melukis semua grafiti.");

	return SPD(playerid, 7647, DIALOG_STYLE_TABLIST, "Daftar grafiti yang tersedia", String, "Pilih", "Tutup");
}

CMD:alldonate(playerid)
{
	if(admin_level[playerid] < 12) return 1;

    new amount_all;
    new amount_day;

	//

	new Cache: result = mysql_query(mMysql, "SELECT sum(amount) as `count` FROM `donate_log` WHERE 1");

	if(!cache_num_rows()) return SCM(playerid, COLOR_GREY, "Donate is completely empty.");

	cache_get_value_int(0, "count", amount_all);

    cache_delete(result);

    SCMF(playerid, -1, "All time: %i Gosok.", amount_all);

	//

	result = mysql_query(mMysql, "SELECT sum(amount) as `count` FROM `donate_log` WHERE UNIX_TIMESTAMP(`date`) > (UNIX_TIMESTAMP(NOW()) - 86400)");

	if(!cache_num_rows()) return SCM(playerid, COLOR_GREY, "Donate dalam 24 jam");

	cache_get_value_int(0, "count", amount_day);

	cache_delete(result);

	//

	return SCMF(playerid, -1, "Last 24 hour's: %i.", amount_day);
}

