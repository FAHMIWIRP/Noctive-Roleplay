	format(format_string, sizeof(format_string), "[A] Admin %s[%d] akun yang tidak dicekal %s", Name(playerid), playerid, name);
	SendAdminMessage(COLOR_GREY, format_string);
    AddAdminLog(playerid, format_string);

	return true;
}
