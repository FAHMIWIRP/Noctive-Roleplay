CMD:sellplant(playerid, params[])
{
    // Cek apakah player berada di radius 3.0 meter dari koordinat tempat jualan
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, -407.217987, -1426.373413, 26.316394))
    {
        SendClientMessage(playerid, -1, "SERVER: Anda harus berada di tempat penjualan tanaman!");
        return 1;
    }

    new dialogStr[512];
    // Membuat tampilan list menu dialog beserta jumlah tanaman yang dimiliki player saat ini
    format(dialogStr, sizeof(dialogStr), 
        "Jenis Tanaman\tHarga Satuan\tMilik Anda\n\
        Padi\t$100\t%d kg\n\
        Kentang\t$250\t%d kg", 
        PlayerInfo[playerid][pPadi], 
        PlayerInfo[playerid][pKentang]
    );

    // Menampilkan dialog dengan gaya LIST / TABLIST
    ShowPlayerDialog(playerid, DIALOG_SELL_PLANT, DIALOG_STYLE_TABLIST_HEADERS, "Sell Plant Menu", dialogStr, "Jual", "Batal");
    return 1;
}

CMD:panen(playerid, params[])
{
    if(PlayerInfo[playerid][pSawit] >= 1)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Masih ada sawit di tas kamu. Muat ke Bobcat dulu sebelum ambil lagi!");

    if(GetPlayerWeapon(playerid) != 4)
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu harus memegang Knife untuk memanen!");

    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "Tunggu proses nya selesai!");

    new id = -1;
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 1 && IsPlayerInRangeOfPoint(playerid, 2.0, ServerPlant[i][splX], ServerPlant[i][splY], ServerPlant[i][splZ]))
        {
            id = i;
            break;
        }
    }

    if(id == -1) return SendClientMessage(playerid, 0xFF0000AA, "Error: Kamu tidak berada di dekat tanaman apapun.");
    if(ServerPlant[id][splTimeLeft] > 0) return SendClientMessage(playerid, 0xFF0000AA, "Error: Tanaman ini belum siap dipanen!");

    // === Cek jenis tanaman: marijuana masuk minigame CUT dulu ===
    if(ServerPlant[id][splType] == PLANT_TYPE_GANJA) // sesuaikan nama konstanta/field tipe tanamanmu
    {
        StartMarijuanaCutMinigame(playerid, id);
        return 1;
    }

    // === Proses panen biasa (sawit, dll) ===
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, false);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 1, 0);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMANEN...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnHarvestingUpdate", 150, true, "ii", playerid, id);

    return 1;
}
public PlantGlobalTimer()
{
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 1 && ServerPlant[i][splTimeLeft] > 0)
        {
            ServerPlant[i][splTimeLeft]--;
            UpdatePlantText(i);
            
            // Auto-save cadangan ke file .ini setiap 60 detik sekali
            if(ServerPlant[i][splTimeLeft] % 60 == 0 || ServerPlant[i][splTimeLeft] == 0)
            {
                SavePlantt(i);
            }
        }
    }
    return 1;
}
forward LoadPlants();
public LoadPlants()
{
    new filename[64];
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        format(filename, sizeof(filename), "plant/%d.ini", i);
        if(fexist(filename))
        {
            ServerPlant[i][splActive] = dini_Int(filename, "Active");
            
            // Jika status tanaman aktif di file, load data lainnya
            if(ServerPlant[i][splActive] == 1)
            {
                ServerPlant[i][splType] = dini_Int(filename, "Type");
                ServerPlant[i][splX] = dini_Float(filename, "PosX");
                ServerPlant[i][splY] = dini_Float(filename, "PosY");
                ServerPlant[i][splZ] = dini_Float(filename, "PosZ");
                ServerPlant[i][splTimeLeft] = dini_Int(filename, "TimeLeft");
                
                // Spawn kembali objek dan teksnya
                new objid = GetPlantObjectID(ServerPlant[i][splType]);
                ServerPlant[i][splObject] = CreateObject(objid, ServerPlant[i][splX], ServerPlant[i][splY], ServerPlant[i][splZ] - 1.0, 0.0, 0.0, 0.0);
                UpdatePlantText(i);
            }
        }
    }
    printf("[PLANT SYSTEM] Berhasil memuat data tanaman menggunakan Dini dari scriptfiles/plant/");
    return 1;
}

stock SavePlantt(id)
{
    new filename[64];
    format(filename, sizeof(filename), "plant/%d.ini", id);
    
    // Jika file belum ada, Dini akan membuatnya secara otomatis
    if(!fexist(filename)) dini_Create(filename);
    
    dini_IntSet(filename, "Type", ServerPlant[id][splType]);
    dini_FloatSet(filename, "PosX", ServerPlant[id][splX]);
    dini_FloatSet(filename, "PosY", ServerPlant[id][splY]);
    dini_FloatSet(filename, "PosZ", ServerPlant[id][splZ]);
    dini_IntSet(filename, "TimeLeft", ServerPlant[id][splTimeLeft]);
    dini_IntSet(filename, "Active", ServerPlant[id][splActive]);
    return 1;
}

// ==========================================
// HELPER FUNCTIONS
// ==========================================

stock GetPlantObjectID(type)
{
    switch(type)
    {
        case PLANT_TYPE_PADI: return 19838;
        case PLANT_TYPE_KENTANG: return 760;
        case PLANT_TYPE_PALEM: return 904;
        case PLANT_TYPE_GANJA: return 19473;
    }
    return 0;
}

stock GetPlantName(type)
{
    new name[32];
    switch(type)
    {
        case PLANT_TYPE_PADI: format(name, sizeof(name), "PADI");
        case PLANT_TYPE_KENTANG: format(name, sizeof(name), "KENTANG");
        case PLANT_TYPE_PALEM: format(name, sizeof(name), "SAWIT");
        case PLANT_TYPE_GANJA: format(name, sizeof(name), "{FF0000}MARIJUANA{FFFFFF}");
    }
    return name;
}

stock GetFreePlantID()
{
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 0) return i;
    }
    return -1;
}

stock IsPlayerNearAnyPlant(playerid, Float:distance)
{
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 1)
        {
            if(IsPlayerInRangeOfPoint(playerid, distance, ServerPlant[i][splX], ServerPlant[i][splY], ServerPlant[i][splZ]))
            {
                return 1; 
            }
        }
    }
    return 0; 
}

// ==========================================
// FIX UPDATE TEXT & STREAMER OVERRIDE
// ==========================================

stock UpdatePlantText(id)
{
    // Memperbaiki error IsValid3DTextLabel menggunakan fungsi Streamer
    if(ServerPlant[id][splText] != Text3D:INVALID_3DTEXT_ID) 
        DestroyDynamic3DTextLabel(ServerPlant[id][splText]);
    
    new str[128];
    if(ServerPlant[id][splTimeLeft] > 0)
    {
        new minutes = ServerPlant[id][splTimeLeft] / 60;
        new seconds = ServerPlant[id][splTimeLeft] % 60;
        format(str, sizeof(str), "[%s]\n{FFFFFF}Status : {FFFF00}%02d:%02d\nGunakan /panen Untuk Mengambil Nya", GetPlantName(ServerPlant[id][splType]), minutes, seconds);
    }
    else
    {
        format(str, sizeof(str), "[%s]\n{FFFFFF}Status : {00FF00}Ready\nGunakan /panen Untuk Mengambil Nya", GetPlantName(ServerPlant[id][splType]));
    }
    // Menggunakan CreateDynamic3DTextLabel agar mendukung streamer gamemode kamu
    ServerPlant[id][splText] = CreateDynamic3DTextLabel(str, 0xFFFFFFFF, ServerPlant[id][splX], ServerPlant[id][splY], ServerPlant[id][splZ] + 0.5, 20.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, -1, -1, 100.0);
    return 1;
}
CMD:friskTUTUP(playerid, params[])
{
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /frisk [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(PlayerInfo[params[0]][pLevel] < 3) return Send(playerid, -1,"Pemain masih level 2");//+;
	if(GetPVarInt(params[0], "AFK_Time") > 2) return SendClientMessage(playerid, 0xB4B5B7FF, "Pemain ini ada di AFK.");
	if(!ProxDetectorS(8.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Anda harus berada di dekat pemain.");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY,"Anda tidak dapat menggeledah diri sendiri.");

	SendPlayerOffer(playerid, params[0], OFFER_TYPE_FRISK);

	return SCM(params[0], COLOR_GREY, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");
}
CMD:chat(playerid, params[])
{
    if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;
    if(!admin_global_chat[playerid]) admin_global_chat[playerid] = 1, Send(playerid, COLOR_GREY, "Anda telah mengaktifkan mendengarkan Obrolan global!");
	else admin_global_chat[playerid] = 0, Send(playerid, COLOR_GREY, "Anda mematikan penyadapan Obrolan global!");
	return 1;
}

CMD:arep(playerid)
{
	if(admin_level[playerid] == 0 && PlayerInfo[playerid][pSupport] == 0) return 1;

	String = "";

	new str[64], to_player = -1;

	new count = 0;

	for(new i; i < MAX_REPORTS; i++)
	{
	    to_player = report_info[i][r_id];

	    if(to_player == INVALID_PLAYER_ID) continue;

		if(report_info[i][r_type] == 0 && admin_level[playerid] == 0) continue;

	    format(str, 64, "%s\t%s[%i]\t%i\n", report_info[i][r_type] ? ("Question") : ("Complaint"), GetPlayerNameEx(to_player), to_player, report_info[i][r_time] / 60);
	    strcat(String, str);

	    SetPlayerListitemValue(playerid, count++, i);
	}

	if(count == 0) return SCM(playerid, COLOR_GREY, "Tidak ada pertanyaan.");

	return SPD(playerid, 9947, DIALOG_STYLE_TABLIST, "Daftar Pertanyaan", String, "Select", "Close");
}

alias:report("rep");
CMD:report(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

    if(sscanf(params, "s[144]", params[0])) return Send(playerid,-1,"Enter: /report(/rep) [komplain]");

    PlayerSendMessageToReport(playerid, 0, params);

    return 1;
}

CMD:ask(playerid, params[])
{
    if(GetPVarInt(playerid, "pAskCooldown") > gettime())
    {
        new sisaWaktu = GetPVarInt(playerid, "pAskCooldown") - gettime();
        new errorStr[128];
        format(errorStr, sizeof(errorStr), "{E74C3C}[ERROR]{FFFFFF} Anda harus menunggu %d menit %d detik lagi.", sisaWaktu / 60, sisaWaktu % 60);
        return SendClientMessage(playerid, -1, errorStr);
    }

    if(isnull(params)) return SendClientMessage(playerid, -1, "{95A5A6}Gunakan: /ask [pertanyaan]");

    new slot = -1;
    for(new i = 0; i < MAX_PENDING_ASKS; i++) {
        if(!PendingAsks[i][aActive]) {
            slot = i;
            break;
        }
    }
    if(slot == -1) return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Antrean pertanyaan penuh, harap tunggu admin merespons.");

    // Menggunakan format yang kamu minta
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));

    g_AskTicketID++;

    PendingAsks[slot][aTicketID] = g_AskTicketID;
    PendingAsks[slot][aPlayerID] = playerid;
    format(PendingAsks[slot][aQuestion], 128, "%s", params);
    PendingAsks[slot][aActive] = true;

    new str1[256], str2[256];
    format(str1, sizeof(str1), "{1E90FF}[Pertanyaan #%d]: {FFFF00}%s {FFFFFF}(( %s ))", g_AskTicketID, name, params);
    format(str2, sizeof(str2), "{FFFFFF}Gunakan: {00FFFF}/ans %d {FFFFFF}atau {00FFFF}/asks {FFFFFF}untuk menjawab", g_AskTicketID);

    SendClientMessageToAll(-1, str1);
    SendClientMessageToAll(-1, str2);

    SetPVarInt(playerid, "pAskCooldown", gettime() + 300);
    return 1;
}

CMD:ans(playerid, params[])
{
    new ticketid, jawaban[128];
    if(sscanf(params, "ds[128]", ticketid, jawaban)) return SendClientMessage(playerid, -1, "{95A5A6}Gunakan: /ans [ID Tiket] [Jawaban]");

    new slot = -1;
    for(new i = 0; i < MAX_PENDING_ASKS; i++)
    {
        if(PendingAsks[i][aActive] && PendingAsks[i][aTicketID] == ticketid)
        {
            slot = i;
            break;
        }
    }

    if(slot == -1) return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} ID Tiket Pertanyaan tidak ditemukan atau sudah dijawab.");

    // Mengambil nama Staff yang menjawab (seperti Suprianto_Harahap di foto)
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));

    // [DIPERBAIKI] Format satu baris presisi sesuai Screenshot_20260601-101243.jpg
    new ansStr[256];
    format(ansStr, sizeof(ansStr), "{1E90FF}[Jawaban #%d]: {FFFFFF}dari {FFFF00}%s {FFFFFF}(( %s ))", ticketid, name, jawaban);

    // Kirim ke semua player
    SendClientMessageToAll(-1, ansStr);

    // Hapus pertanyaan dari daftar /asks karena sudah selesai dijawab
    PendingAsks[slot][aActive] = false;
    PendingAsks[slot][aTicketID] = 0;
    PendingAsks[slot][aPlayerID] = INVALID_PLAYER_ID;
    return 1;
}

CMD:todo(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[128]", params[0])) return Send(playerid,-1,"Masuk: /todo [teks] * [tindakan]");
	if(strfind(params, "*", true) == -1) return SendClientMessage(playerid,-1,"Masuk: /todo [teks] * [tindakan]");

 	new arrCoords[2][128];
  	sscanf(params[0],"p<*>s[128]s[128]",arrCoords[0],arrCoords[1]);

   	if(PlayerInfo[playerid][pSex] == 1) format(String, 244, "- %s {DD90FF}- ceritanya %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    else format(String, 244, "- %s {DD90FF}kata %s, %s",arrCoords[0], Name(playerid), arrCoords[1]);
    ProxDetector(20.0, playerid, String, COLOR_RAZGOVOR1,COLOR_RAZGOVOR2,COLOR_RAZGOVOR3,COLOR_RAZGOVOR4,COLOR_RAZGOVOR5);
	return 1;
}
CMD:try(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[128]", params[0])) return Send(playerid, -1, "Masuk: /try [tindakan]");
	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		return 1;
	}
	new randomchik = RandomEx(0,2);
	format(String, 188, "{DD90FF}%s %s %s", Name(playerid), params[0], (!randomchik)?("{63C600}| Semoga beruntung") : ("{FF6600}| Gagal"));
	ProxDetector(20.0, playerid, String, 0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFA);
	return 1;
}
CMD:ado(playerid, params[])
{
    new result[100], string[140];
    if(sscanf(params, "s[200]", result))
    {
        SendClientMessage(playerid, 0xCECECEFF, "Gunakan:/ado [teks]");
        SendClientMessage(playerid, 0xCECECEFF, "[Petunjuk]: Gunakan:/ado off Untuk Menghapus!");
        return 1;
    }
    if(strlen(result) >100) return SendClientMessage(playerid, 0xCECECEFF, "Informasi: Maksimal Text 100 Huruf!");
    if(strcmp(result, "off", true) == 0)
    {
        if(adostatus[playerid] == 0) return Error(playerid, "kamu sedang tidak menggunakan cmd (/ado)!");
        DestroyDynamic3DTextLabel(PlayerInfo[playerid][pAdo]);
        SendClientMessage(playerid, 0xCECECEFF, "ADO dihapus!");
        adostatus[playerid] = 0;
        return 1;
    }
    if(adostatus[playerid] == 0)
    {
        new Float:AdoX, Float:AdoY, Float:AdoZ;
        GetPlayerPos(playerid, AdoX, AdoY, AdoZ);
        format(string, sizeof(string), "* %s *\n(( %s ))", result, GetPlayerNameEx(playerid));
        PlayerInfo[playerid][pAdo] = CreateDynamic3DTextLabel(string, 0xC2A2DAFF, AdoX, AdoY, AdoZ, 40.0);
        SendClientMessage(playerid, 0xCECECEFF, "Anda telah melampirkan ADO di tempat Anda saat ini!");
        adostatus[playerid] = 1;
    }
    else
    {
        format(string, sizeof(string), "* %s * \n(( %s ))", result, GetPlayerNameEx(playerid));
        UpdateDynamic3DTextLabelText(PlayerInfo[playerid][pAdo], 0xC2A2DAFF, string);
        return 1;
    }
    return 1;
}
CMD:ame(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
    if(sscanf(params, "s[144]", params[0])) return Send(playerid, -1,"Enter: /me [tindakan]");
    if(CheckIP(params[0]))
    {
        PlayerInfo[playerid][pMuted] = 600;
        Send(playerid, COLOR_LIGHTRED, "Anda dilarang oleh Hat karena dicurigai mengiklankan.");
        format(format_string, sizeof(format_string), "[A] %s[%d] || Kecurigaan iklan: [ %s ]", Name(playerid),playerid,params[0]);
        SendAdminMessage(COLOR_LIGHTRED, format_string);
        return 1;
    }
    format(String, 188, "{FFFFFF}ACTION : {DD90FF}%s", params[0]);
    ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
    SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
    return 1;
}
CMD:me(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return Send(playerid, -1,"Masuk: /me [tindakan]");
	if(masked[playerid] == 1)
	{
 		format(String, sizeof(String), "Mask_%d %s", maskid[playerid], params);
		ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
		return 1;
	}
	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		return 1;
	}
	format(String, 188, "%s %s",Name(playerid), params[0]);
	ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA,0xDD90FFAA);
	SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
	return 1;
}
CMD:do(playerid, params[])
{
    if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return Send(playerid, -1,"Masuk: /do [tindakan]");
	if(masked[playerid] == 1)
	{
 		format(String, sizeof(String), "%s (Mask_%d)", params, maskid[playerid]);
		ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
 		return 1;
	}
	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		return 1;
	}
	format(String, 188, "%s (%s)", params[0], Name(playerid));
  	ProxDetector(20.0, playerid, String, 0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF,0xDD90FFFF);
  	SetPlayerChatBubble(playerid,params[0],0xDD90FFFF,20.0,10000);
	return 1;
}

CMD:w(playerid,params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params,"s[144]",params[0])) return Send(playerid,-1,"Masuk: /w [pesan]");

	if(masked[playerid] == 1)
	{
	 	if(GetPlayerData(playerid, pInjured) == 1) return Error(playerid, "Anda Tidak Bisa Melakukan Ini saat Pingsan");
 		format(String, sizeof(String), "Mask_%d berbisik: %s", maskid[playerid], params);
		ProxDetector(5.0, playerid, String, 0xACCE90FF,0xACCE90FF,0xACCE90FF,0xACCE90FF,0xACCE90FF);
		return 1;
	}
 	if(GetPlayerData(playerid, pInjured) == 1) return Error(playerid, "Anda Tidak Bisa Melakukan Ini saat Pingsan");
    format(String, 188, "%s low: %s", Name(playerid), params[0]);
	ProxDetector(40.0,playerid, String,-1,-1,-1,-1,-1);
 	SetPlayerChatBubble(playerid, params[0], 0xACCE90FF, 5.0, 10000);
	return 1;
}
CMD:s(playerid, params[])
{
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);
	if(sscanf(params, "s[144]", params[0])) return Send(playerid, -1,"Masuk: /s [teks]");
	if(masked[playerid] == 1)
    {
     	if(GetPlayerData(playerid, pInjured) == 1) return Error(playerid, "Anda Tidak Bisa Melakukan Ini saat Pingsan");
        format(String, sizeof(String), "Mask_%d shouts: %s!", maskid[playerid], params);
        ProxDetector(40.0, playerid, String,-1,-1,-1,-1,-1);
        return 1;
    }
	if(CheckIP(params[0]))
	{
		PlayerInfo[playerid][pMuted] = 600;
		Send(playerid, COLOR_LIGHTRED, "Anda menerima larangan ngobrol tentang iklan yang dicurigai.");
		format(format_string, sizeof(format_string), "[A] %s[%d] || Iklan yang Dicurigai: [ %s ]", Name(playerid),playerid,params[0]);
		SendAdminMessage(COLOR_LIGHTRED, format_string);
		return 1;
	}
 	if(GetPlayerData(playerid, pInjured) == 1) return Error(playerid, "Anda Tidak Bisa Melakukan Ini saat Pingsan");
	format(String, 188, "%s shouts: %s!", Name(playerid), params[0]);
	ProxDetector(40.0,playerid, String,-1,-1,-1,-1,-1);
	SetPlayerChatBubble(playerid, params[0],-1,40.0,10000);
	return 1;
}
CMD:voff(playerid,params[])
{
	if(!PlayerInfo[playerid][pVip]) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP.");
	if(GetPVarInt(playerid,"vroff"))
	{
		DeletePVar(playerid,"vroff");
		Send(playerid,-1,"Anda telah mengaktifkan VIP-Chat");
	}
	else
	{
		SetPVarInt(playerid,"vroff",true);
		Send(playerid,-1,"Anda telah menonaktifkan VIP-Chat");
	}
	return 1;
}
stock SendVipMessage(color, str[])
{
	foreach(new i : Player)
	{
		if(!PlayerInfo[i][pVip]) continue;
		if(GetPVarInt(i,"vroff")) continue;
		SendClientMessage(i, color, str);
	}
	return 1;
}
CMD:v(playerid,params[])
{
	if(!PlayerInfo[playerid][pVip]) return Send(playerid,0xafafafff,"Fungsi ini hanya tersedia untuk pemain VIP.");
	if(PlayerInfo[playerid][pMuted] > 0) return Send(playerid,0xafafafff,"Chat Anda dilarang");
	if(isnull(params) || strlen(params) > 144) return Send(playerid,0xafafafff,"/v [Text]");
	if(admin_level[playerid] == 0) format(format_string, 128, "[VIP] %s[%d]: {ffffff}%s",Name(playerid),playerid,params);
	else if(admin_level[playerid] >= 1) format(format_string, 128, "[VIP] Admin %s[%d]: {ffffff}%s",Name(playerid),playerid,params);
	SendVipMessage(0x1E90FFff, format_string);
	return 1;
}
CMD:unfwarn(playerid, params[])
{
	if(!PlayerInfo[playerid][pMember]) return 1;
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Enter: /unfwarn [playerid]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Player is offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain tidak login");//+;
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]) return Send(playerid,COLOR_GREY,"Hanya pemimpin organisasi yang dapat menghapus teguran.");
	if(PlayerInfo[playerid][pMember] != PlayerInfo[params[0]][pMember]) return Send(playerid,COLOR_GREY,"Pemain tidak ada dalam organisasi Anda!");
	if(PlayerInfo[params[0]][pfWarn] <= 0) return Send(playerid, COLOR_GREY,"Pemain ini tidak memiliki teguran!");
	PlayerInfo[params[0]][pfWarn] -= 1;

	SCMF(params[0], 0x56FB4EFF, "Pemimpin %s(%i) menegurmu (%d/3)", Name(playerid), playerid, PlayerInfo[params[0]][pfWarn]);
	SCMF(playerid, 0x56FB4EFF, "Anda menghapus %s(%i) teguran (%d/3)", Name(params[0]), params[0], PlayerInfo[params[0]][pfWarn]);
	return 1;
}
CMD:gov(playerid, params[])
{
    if(!IsACop(playerid) && !IsAArmy(playerid) && !IsAMedic(playerid) && PlayerInfo[playerid][pMember] != FRACTION_MAYOR && PlayerInfo[playerid][pMember] != FRACTION_PEDAGANG) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakannya.");

	if(player_gag[playerid]) return SCM(playerid, COLOR_GREY, "Anda mendapat lelucon, Anda tidak bisa bicara.") & 0;
	if(PlayerInfo[playerid][pMuted] > 0) return PlayerMuted(playerid);

	if(sscanf(params, "s[128]",params[0])) return Send(playerid, -1,"Masuk: /gov [teks]");
    if(CheckIP(params[0]))
	{
	    format(format_string, sizeof(format_string), "[A] Pemimpin fraksi %s (%s) dihapus dari jabatannya karena dicurigai beriklan.",Name(playerid), FracInfo[PlayerInfo[playerid][pMember]][fName]);
		SendAdminMessage(COLOR_GREY, format_string);
		PlayerInfo[playerid][pMember] = 0;
    	PlayerInfo[playerid][pRank] = 0, PlayerInfo[playerid][pfWarn] = 0;
		form_fraction[playerid] = 0, SetPlayerToTeamColor(playerid);
		SetPlayerSkinEx(playerid, PlayerInfo[playerid][pSkin]);

		SavePlayerFraction(playerid);

		format(String, 322, ""W"Anda telah dihapus dari jabatan administrator untuk mengiklankan proyek pihak ketiga.\nJika terjadi kesalahan - ambil tangkapan layar kotak dialog ini\ndan kirimkan ke administrasi.\n\nTeks dikirim ke /gov: %s", params[0]);
		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Kecurigaan dalam iklan", String, "Tutup", "");
		return 1;
	}
    format(format_string, sizeof(format_string), "Gov. berita: %s: [%s] %s", Name(playerid), FracInfo[PlayerInfo[playerid][pMember]][fTag], params[0]);
	SendClientMessageToAll(0x3A5FCDFF, format_string);
	return 1;
}
CMD:fwarn(playerid, params[])
{
	if(!PlayerInfo[playerid][pMember]) return 1;
	if(sscanf(params, "us[128]",params[0],params[1])) return Send(playerid, -1,"Masuk: /fwarn [playerid] [alasan]");
    if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
 	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(params[0] == playerid) return Send(playerid, -1,"Anda tidak bisa menegur diri sendiri!");
	if(PlayerInfo[playerid][pRank] < FracInfo[PlayerInfo[playerid][pMember]][fRankMax]-1) return Send(playerid,COLOR_GREY,"Anda bukan pemimpin/wakil pemimpin!");
	if(PlayerInfo[playerid][pMember] != PlayerInfo[params[0]][pMember]) return Send(playerid,COLOR_GREY,"Pemain tidak ada di organisasi Anda.!");
	if(PlayerInfo[playerid][pRank] <= PlayerInfo[params[0]][pRank] || PlayerInfo[params[0]][pLeader] > 0) return Send(playerid,COLOR_GREY,"Anda tidak dapat menegur pemain ini!");

	if(PlayerInfo[params[0]][pfWarn] == 2)
	{
	    SCMF(params[0], 0xB4B5B7FF, "%s(%i) memecatmu dari organisasi (%s). Alasan: %s(3 teguran)", Name(playerid), playerid, FracInfo[PlayerInfo[playerid][pMember]][fName], params[1]);
		SCMF(playerid, 0xB4B5B7FF, "Anda dipecat %s(%i) dari organisasi (%s). Alasan: Satu set 3 teguran", Name(params[0]), params[0], FracInfo[PlayerInfo[playerid][pMember]][fName]);
		PlayerInfo[params[0]][pMember] = 0, PlayerInfo[params[0]][pRank] = 0, PlayerInfo[params[0]][pfWarn] = 0;
		form_fraction[params[0]] = 0;
		SetPlayerArmour(playerid, 0), ResetWeapons(params[0]);
		SetPlayerSkinEx(params[0], PlayerInfo[params[0]][pSkin]);
		SetPlayerToTeamColor(params[0]);

		SavePlayerFraction(params[0]);
	}
	else
	{
		PlayerInfo[params[0]][pfWarn] += 1;
		SCMF(params[0], 0xB4B5B7FF, "%s(%i) menegurmu (%d/3). Alasan: %s", Name(playerid), playerid, PlayerInfo[params[0]][pfWarn], params[1]);
        SCMF(playerid, 0xB4B5B7FF, "Anda memberi tahu %s(%i) teguran (%d/3). Alasan: %s", Name(params[0]), params[0], PlayerInfo[params[0]][pfWarn], params[1]);
	}
	return 1;
}
CMD:clear(playerid, params[])
{
	if(!IsACop(playerid)) return 1;
	if(sscanf(params, "us[32]", params[0], params[1])) return  Send(playerid, -1,"Masuk: /clear [playerid] [alasan]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, -1,"Pemain AFC ini.");//+
	if(!ProxDetectorS(5.0, playerid, params[0]) || params[0] == playerid) return Send(playerid, COLOR_GREY,"Pemain harus berada di dekat Anda");

	MeAction(playerid,"membuka komputer genggam dan memasuki pangkalan yang diinginkan");
	MeAction(playerid,"menghapus kasus tersangka dari basis data");
	SCMF(params[0], 0x20A9FFFF, "%s menghapus Anda dari daftar yang diinginkan. Alasan: %s", Name(playerid), params[1]);

	PlayerInfo[params[0]][pWanted] = 0;
	SetPlayerWantedLevel(params[0], 0);

	foreach(new i : Player)
	{
		if(IsACop(i)) SCMF(i, 0xFEBC41AA, "Menginformasikan: %s. Tersangka %s dihapus dari daftar orang yang dicari. Alasan: %s", Name(playerid), Name(params[0]), params[1]), PlayerPlaySound(i, 41603, 0.0, 0.0, 0.0);
	}
	return true;
}
CMD:break(playerid, params[])
{
    if(!IsACop(playerid) || !IsAArmy(playerid)) return 1;
 	if(IsPlayerInAnyVehicle(playerid)) return Send(playerid,COLOR_GREY, "Keluar dari mobil untuk mengatur objek.!");
   	if(GetPlayerInterior(playerid) != 0) return Send(playerid,COLOR_GREY, "Anda tidak dapat menginstal objek di interior!");

	if(PlayerInfo[playerid][pObject] > 0)
	{
	    DestroyDynamic3DTextLabel(PlayerInfo[playerid][pDText]);
	    DestroyDynamicObject(PlayerInfo[playerid][pObject]);
	    PlayerInfo[playerid][pObject] = 0;
	    return Send(playerid, -1, "Objek berhasil dibersihkan.!");
 	}
    SPD(playerid,184,DIALOG_STYLE_LIST,"Daftar benda",""W"1. Penghalang No1\n2. Penghalang No2\n3. Penghalang No3\n4. Penghalang No4", "Pilih","Tutup");
    return 1;
}
CMD:find(playerid,params[])
{
	if(!IsACop(playerid)) return 1;
	if(sscanf(params,"d",params[0])) return Send(playerid,-1,"Masuk: /find [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Kesalahan: Pemain belum login");//+;
	if(params[0] == playerid) return SendClientMessage(playerid,-1,"Anda telah memasukkan ID Anda");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");

	if(player_search_player[playerid] != -1) return SCMF(playerid, COLOR_GREY, "Pelacakan Pemain %s[%d] dihentikan!", Name(player_search_player[playerid]), player_search_player[playerid]), player_search_player[playerid] = -1;
	if(GetPlayerVirtualWorld(params[0]) != 0) return Send(playerid,COLOR_GREY,"Wanted ada di interior atau di acara itu!");
	if(GetPlayerInterior(params[0]) != 0) return Send(playerid,COLOR_GREY,"Dicari ada di interior");

	player_search_player[playerid] = params[0];
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Menggabungkan dengan status...", ""W"Anda mulai melacak penjahat.\nTag GPS akan diperbarui setiap detik\n\nUntuk mematikan satelit, masukkan perintah lagi...", "Tutup", "");
	return true;
}

CMD:aeject(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /aeject [playerid]");
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Man jauh darimu!");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY,"Anda tidak dapat menyeret diri Anda ke dalam mobil!");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");

	if(GetPlayerState(params[0]) == PLAYER_STATE_ONFOOT) return SCM(playerid, COLOR_GREY, "Pemain tidak di dalam mobil.");

	RemovePlayerFromVehicle(params[0]);

	SCMF(playerid, -1, "Anda secara paksa menarik {AFEEEE}%s[%d]"W" dari transportasi.", Name(params[0]), params[0]);
	SCMF(params[0], 0xFF4500ff, "%s[%d] menarik Anda keluar dari transportasi", Name(playerid), playerid);

	format(String, 64, "%s ditarik keluar %s dari transportasi");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);

	MeAction(playerid, "menarik pelaku dari kendaraan");
	return 1;
}

CMD:ceject(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /ceject [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, COLOR_GREY,"Pemain ini ada di AFC.");//+
	if(!ProxDetectorS(5.0, playerid, params[0])) return Send(playerid, COLOR_GREY,"Seseorang yang jauh dari Anda atau sudah di dalam mobil!");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY,"Anda tidak dapat menyeret diri Anda ke dalam mobil!");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");

	if(GetPlayerVehicleID(params[0]) != GetPlayerVehicleID(playerid)) return SCM(playerid, COLOR_GREY, "Pemain ini bukan penumpang.");

	if(PlayerToPoint(15.0, playerid, 1568.4247,-1694.7701,5.8906)) SetPPos(params[0],255.0321,86.6862,1002.4453, 4.2000, 6, 1, false); //LSPD
	else if(PlayerToPoint(15.0, playerid, -303.6902,1533.2164,75.3594)) SetPPos(params[0],200.0141,158.2397,1003.0234, 92.4368, 3, 2, false); //FBI
	else if(PlayerToPoint(15.0, playerid, -1594.2098,716.1427,-4.9063)) SetPPos(params[0],216.4706,120.8032,999.0156,271.5949, 10, 2, false); //SFPD
	else if(PlayerToPoint(15.0, playerid, 2296.9668,2451.5178,10.8203)) SetPPos(params[0],200.0141,158.2397,1003.0234, 92.4368, 3, 8, false); //LVPD
	else return SCM(playerid, COLOR_GREY, "Anda jauh dari pintu masuk ke bagian mana pun atau FBI.");

	SCMF(playerid, -1, "Anda menyeret penjahat secara paksa {AFEEEE}%s[%d]"W" ke situs", Name(params[0]), params[0]);
	SCMF(params[0], 0xFF4500ff, "%s[%d] menyeret Anda ke stasiun dengan paksa", Name(playerid), playerid);
	format(String, 64, "%s diseret secara paksa) %s ke situs");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);
	MeAction(playerid, "menyeret pelaku dengan paksa ke stasiun");
	return 1;
}
CMD:cput(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");
	if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /cput [playerid]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, -1,"Pemain sedang offline");//+
	if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, -1,"Pemain belum login");//+;
	if(afk_time[params[0]] > 2) return Send(playerid, COLOR_GREY,"Pemain AFC ini.");//+
	if(!ProxDetectorS(5.0, playerid, params[0]) || GetPlayerState(params[0]) != PLAYER_STATE_ONFOOT) return Send(playerid, COLOR_GREY,"Seseorang yang jauh dari Anda atau sudah di dalam mobil!");
	if(params[0] == playerid) return Send(playerid, COLOR_GREY,"Anda tidak dapat menyeret diri Anda ke dalam mobil!");
	if(!PlayerInfo[params[0]][pWanted]) return Send(playerid, COLOR_GREY,"Manusia bukan penjahat");
	if(follow_id[params[0]] != INVALID_PLAYER_ID)
	{
		ClearAnimations(params[0], true);
        follow_id[params[0]] = INVALID_PLAYER_ID;
	}
	foreach(new i : Player)
	{
		if(IsPlayerInVehicle(i, GetPlayerVehicleID(playerid)) && GetPlayerVehicleSeat(i) == 1) return Send(playerid, COLOR_GREY,"Tempat di dalam mobil sudah diambil!");
	}
	PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), 2);
	SetPlayerArmedWeapon(params[0], 0);
	SCMF(playerid, -1, "Anda menyeret penjahat secara paksa {AFEEEE}%s[%d]"W" ke dalam mobil", Name(params[0]), params[0]);
	MeAction(playerid, "Perbaikan Otomatis");
	SCMF(params[0], 0xFF4500ff, "%s[%d] menyeret Anda dengan paksa ke dalam mobil", Name(playerid), playerid);
	format(String, 64, "%s diseret secara paksa %s ke dalam mobil");
	SetPlayerChatBubble(playerid, String, COLOR_PURPLE,15.0,10000);
	MeAction(playerid, "menyeret pelaku dengan paksa ke dalam mobil");
	return 1;
}
