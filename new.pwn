				if(PlayerInfo[offer_id][pMicin] < amount) return SCM(playerid, COLOR_GREY, "Penjual tidak memiliki jumlah obat yang ditentukan.");

				if(PlayerInfo[playerid][pMicin] + amount > GetPlayerBackpackLimit(playerid)) return SCMF(playerid, COLOR_GREY, "Anda tidak dapat membawa lebih banyak %i gram.", GetPlayerBackpackLimit(playerid));

				PlayerInfo[offer_id][pMicin] -= amount;
				PlayerInfo[playerid][pMicin] += amount;

