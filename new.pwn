CMD:denyjob1(playerid, params[])
{
    new bool:found = false;

    // Cari job bernilai 1 (Ditambah pJobpadi)
    if(PlayerInfo[playerid][pJobchiken] == 1) { PlayerInfo[playerid][pJobchiken] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobconstruction] == 1) { PlayerInfo[playerid][pJobconstruction] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobminer] == 1) { PlayerInfo[playerid][pJobminer] = 0; found = true; }
    else if(PlayerInfo[playerid][pJoboil] == 1) { PlayerInfo[playerid][pJoboil] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobcompo] == 1) { PlayerInfo[playerid][pJobcompo] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobpadi] == 1) { PlayerInfo[playerid][pJobpadi] = 0; found = true; } // BARU

    if(found)
    {
        SendClientMessage(playerid, -1, "INFO: Anda telah keluar dari Job Pertama.");
        
        // Auto-Shift untuk VIP (Ditambah pJobpadi)
        if(PlayerInfo[playerid][pJobchiken] == 2) PlayerInfo[playerid][pJobchiken] = 1;
        else if(PlayerInfo[playerid][pJobconstruction] == 2) PlayerInfo[playerid][pJobconstruction] = 1;
        else if(PlayerInfo[playerid][pJobminer] == 2) PlayerInfo[playerid][pJobminer] = 1;
        else if(PlayerInfo[playerid][pJoboil] == 2) PlayerInfo[playerid][pJoboil] = 1;
        else if(PlayerInfo[playerid][pJobcompo] == 2) PlayerInfo[playerid][pJobcompo] = 1;
        else if(PlayerInfo[playerid][pJobpadi] == 2) PlayerInfo[playerid][pJobpadi] = 1; // BARU
    }
    else
    {
        SendClientMessage(playerid, -1, "ERROR: Anda tidak memiliki Job Pertama.");
    }
    return 1;
}

CMD:denyjob2(playerid, params[])
{
    new bool:found = false;

    // Cari job bernilai 2 (Ditambah pJobpadi)
    if(PlayerInfo[playerid][pJobchiken] == 2) { PlayerInfo[playerid][pJobchiken] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobconstruction] == 2) { PlayerInfo[playerid][pJobconstruction] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobminer] == 2) { PlayerInfo[playerid][pJobminer] = 0; found = true; }
    else if(PlayerInfo[playerid][pJoboil] == 2) { PlayerInfo[playerid][pJoboil] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobcompo] == 2) { PlayerInfo[playerid][pJobcompo] = 0; found = true; }
    else if(PlayerInfo[playerid][pJobpadi] == 2) { PlayerInfo[playerid][pJobpadi] = 0; found = true; } // BARU

