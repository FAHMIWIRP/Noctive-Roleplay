CMD:savepos(playerid, params[])
{
    if(admin_level[playerid] < 1) return 1;
    if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Gunakan: /savepos [judul]");

    GetPlayerVehicleID(playerid);
    new Float:PPos[5];
    new msg[500];
    GetPlayerPos(playerid, PPos[0], PPos[1], PPos[2]);
    GetPlayerFacingAngle(playerid, PPos[3]);
    format(msg, sizeof(msg), "\nSetPlayerPos(playerid, %f,%f,%f);\nSetPlayerFacingAngle(playerid, %f);\nJudul : %s", PPos[0], PPos[1], PPos[2], PPos[3], msg);
    new File:fhandle;
    fhandle = fopen("coordinates.txt",io_append);
    fwrite(fhandle, msg);
    fclose(fhandle);
    Info(playerid, "Coordinat Posisi Kamu Berhasil Di Save!");

    return 1;
}
CMD:shareloc(playerid, params[])
{
    new otherid;

    if(sscanf(params, "u", otherid))
    {
        ShowPlayerDialog(playerid, DIALOG_SHARELOC, DIALOG_STYLE_INPUT, "Share Location", "Masukkan ID pemain yang ingin Anda bagikan lokasi:", "OK", "Batal");
        return 1;
    }

    return 1;
}   

IsEMSCar(carid)
{
    for(new v = 0; v < sizeof(EMSVehicles); v++)
    {
        if(carid == EMSVehicles[v]) return 1;
    }
    return 0;
}

CMD:buyplate(playerid)
{
    if(!IsPlayerInRangeOfPoint(playerid, 5.0, 845.734008, -2101.949951, 1003.500000))
        return Error(playerid, "Anda harus di area kantor polisi");

    if(CarInfo[playerid][cModel][0] == 0 && CarInfo[playerid][cModel][1] == 0 && CarInfo[playerid][cModel][2] == 0 && CarInfo[playerid][cModel][3] == 0 && CarInfo[playerid][cModel][4] == 0)
        return Error(playerid, "Anda tidak memiliki transportasi yang tersedia.");

    if(GetPlayerMoney(playerid) < 200)
        return Error(playerid, "Anda tidak memiliki uang 200$");

    for(new i; i < MAX_PLAYER_VEHICLES; i++)
    {
        new vehicleid = player_home_car[playerid][i];

        if(vehicleid == INVALID_VEHICLE_ID) continue;
        GivePlayerMoneyEx(playerid, -200, "BeliPlate");
        new rand = RandomEx(1111, 9999);
        format(VehiclePlate[playerid][i], 32, "HT %d AVRP", rand);

        UpdateVehicleLabel(vehicleid, 0xFF7F00FF, VehiclePlate[playerid][i]);
        SetVehicleNumberPlate(vehicleid, VehiclePlate[playerid][i]);
        Info(playerid, "Anda berhasil membeli plate vehicle. (%s)", VehiclePlate[playerid][i]);

        new query[1280];
        mysql_format(mMysql, query, sizeof(query), "UPDATE `accounts` SET `VehPlate%d` = '%s' WHERE `pID` = '%d' LIMIT 1", i, VehiclePlate[playerid][i], pData[playerid][pID]);
        mysql_tquery(mMysql, query);
    }
    return 1;
}



#define KickEx(%0) SetTimerEx("KickP2", 6000, false, "d", %0)
