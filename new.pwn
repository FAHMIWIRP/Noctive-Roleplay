		        Info(otherid, "%s telah berhasil memberikan Medicine kepada anda sejumlah %s.", ReturnName(playerid), FormatMoney(amount));
		        ApplyAnimation(playerid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0); ApplyAnimation(otherid, "DEALER", "shop_pay", 4.0, 0, 0, 0, 0, 0);
		    }
		    else if(strcmp(itemCode, "crack", true) == 0)
		    {
