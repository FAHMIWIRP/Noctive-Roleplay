	    return SPD(playerid, 3871, DIALOG_STYLE_MSGBOX, "Car Dealership", "{ffffff}Apakah Anda ingin masuk?", "Ya", "Tidak");
    }

	if(b == 77 || b == 79) SCM(playerid, COLOR_YELLOW, "Untuk penggunaan dadu: {FFFFFF}/dice");

