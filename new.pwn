// Helper untuk mencari player yang menjadi supir kendaraan food truck
stock GetVehicleDriver(vehicleid) {
    for(new i = 0; i < MAX_PLAYERS; i++) {
        if(IsPlayerConnected(i) && GetPlayerVehicleID(i) == vehicleid && GetPlayerVehicleSeat(i) == 0) {
            return i;
        }
    }
    return INVALID_PLAYER_ID;
}

// Callback khusus saat data stok selesai diambil dari database MySQL
forward OnLoadVehicleFoodStock(vehicleid);
public OnLoadVehicleFoodStock(vehicleid) {
    if(cache_num_rows() > 0) {
        new l_stock;
        cache_get_value_name_int(0, "stock", l_stock);
        VehicleFoodStock[vehicleid] = l_stock; 
    } else {
        VehicleFoodStock[vehicleid] = 0; 
    }
    return 1;
}
forward LoadAllFoodTrucks();
public LoadAllFoodTrucks()
{
    new rows = cache_num_rows();
    if(rows > 0)
    {
        new db_veh_id, stock_val;
        for(new i = 0; i < rows; i++)
        {
            // Ambil data dari baris database
            cache_get_value_name_int(i, "veh_id", db_veh_id);
            cache_get_value_name_int(i, "stock", stock_val);
            
            // Loopping untuk mencari kendaraan di server yang cocok dengan ID database ini
            for(new v = 1; v < MAX_VEHICLES; v++)
            {
                if(VehicleSQLID[v] == db_veh_id && GetVehicleModel(v) == 423)
                {
                    VehicleFoodStock[v] = stock_val; // Pasang stoknya ke kendaraan aktif
                    break; // Keluar dari loop v jika sudah ketemu, lanjut ke baris database berikutnya
                }
            }
        }
        printf("[MySQL] Berhasil memuat %d data stok kendaraan Food Truck ke server.", rows);
    }
    return 1;
}
forward OnBuyPhoneCheck(playerid, price, test_number);
public OnBuyPhoneCheck(playerid, price, test_number)
{
    // Jika cache_num_rows > 0, berarti nomor tersebut SUDAH ADA di database milik orang lain
    if(cache_num_rows() > 0)
    {
        // Bikin nomor baru lagi
        new new_number = random(900000) + 100000;

        // Cek lagi ke database (Looping callback ini sampai dapat nomor yang benar-benar unik)
        new format_string[128];
        mysql_format(mMysql, format_string, sizeof(format_string), "SELECT `pID` FROM `accounts` WHERE `pNumber` = %d LIMIT 1", new_number);
        mysql_tquery(mMysql, format_string, "OnBuyPhoneCheck", "iii", playerid, price, new_number);
        return 1;
    }

    // --- JIKA KITA SAMPAI KE BARIS INI, BERARTI NOMORNYA UNIK (BELUM ADA YANG PAKAI) ---

    // Cek uang lagi untuk menghindari bug (player membuang/transfer uang saat delay query MySQL)
    if(GetPlayerMoney(playerid) < price)
        return Send(playerid, -1, "{ff0000}ERROR: {ffffff}Uang tidak cukup saat memproses transaksi.");

    // Deduct uang & set status produk
    GivePlayerMoneyEx(playerid, -price, "beli telepon");
    PlayerInfo[playerid][pProducts][0] = 1;

    // Masukkan nomor hp baru ke variabel player (Sesuaikan variabel pNumber dengan yang ada di scriptmu)
    PlayerInfo[playerid][pNumber] = test_number;

    // Save status pProducts & pNumber ke Database
    new format_string[256];
    mysql_format(mMysql, format_string, sizeof(format_string), "UPDATE `accounts` SET `pProducts` = '%i,%i,%i', `pNumber` = %d WHERE `pID` = %i",
        PlayerInfo[playerid][pProducts][0],
        PlayerInfo[playerid][pProducts][1],
        PlayerInfo[playerid][pProducts][2],
        PlayerInfo[playerid][pNumber],
        GetPlayerAccountID(playerid)
    );
    mysql_tquery(mMysql, format_string);

    // Kirim pesan sukses
    new str_msg[128];
    format(str_msg, sizeof(str_msg), "{00ff00}SUKSES: {ffffff}Kamu berhasil membeli Handphone! Nomor barumu: {ffff00}%d", test_number);
    Send(playerid, -1, str_msg);

    return 1;
}

stock OpenPinPad(playerid, bool:creating)
{
    pinIsOpen[playerid]          = true;
    pinIsCreating[playerid]      = creating;
    pinAwaitingConfirm[playerid] = false;
    pinBufferLen[playerid]       = 0;
    pinBuffer[playerid][0]       = '\0';
    pinAttemptsLeft[playerid]    = MAX_PIN_ATTEMPTS;

    CreatePinTD(playerid);
    ResetPinDisplay(playerid);

    for (new i = 0; i < 39; i++)
        PlayerTextDrawShow(playerid, tdpin[playerid][i]);

    SelectTextDraw(playerid, 0x00FF00AA); // warna highlight saat hover

    if (creating)
        ShowPanjulNotif(playerid, "Buat PIN baru kamu ("#PIN_LENGTH" digit).");
    else
        ShowPanjulNotif(playerid, "Masukkan PIN kamu.");

    pinTimer[playerid] = SetTimerEx("PinTimeoutCB", PIN_TIME_LIMIT, false, "i", playerid);
    return 1;
}

stock ClosePinPad(playerid)
{
    if (pinTimer[playerid] != 0)
    {
        KillTimer(pinTimer[playerid]);
        pinTimer[playerid] = 0;
    }
    CancelSelectTextDraw(playerid);
    DestroyPinTD(playerid);
    pinIsOpen[playerid] = false;
    pinAwaitingConfirm[playerid] = false;
    return 1;
}

public PinTimeoutCB(playerid)
{
    if (pinIsOpen[playerid])
    {
        SendClientMessage(playerid, -1, "Waktu memasukkan PIN telah habis.");
        pinTimer[playerid] = 0; // sudah terbakar sendiri
        ClosePinPad(playerid);
		Kick(playerid);
        CallLocalFunction("OnPinTimeout", "i", playerid);
    }
    return 1;
}

public PinKickCB(playerid)
{
    Kick(playerid);
    return 1;
}
// ======================================================================
//  LOGIKA INPUT
// ======================================================================
stock PinInputDigit(playerid, digit)
{
    if (pinBufferLen[playerid] >= PIN_LENGTH)
        return 0; // sudah penuh, tunggu DONE atau HAPUS

    // Substitusi tetap: tombol digit -> huruf yang benar-benar disimpan
    pinBuffer[playerid][pinBufferLen[playerid]] = pinDigitChar[digit];

    // Tampilkan urutan tombol yang ditekan di slot index 8-12
    new str[2];
    format(str, sizeof(str), "%d", digit);
    PlayerTextDrawSetString(playerid, tdpin[playerid][pinDisplayTD[pinBufferLen[playerid]]], str);
    PlayerTextDrawShow(playerid, tdpin[playerid][pinDisplayTD[pinBufferLen[playerid]]]); // paksa refresh

    pinBufferLen[playerid]++;
    pinBuffer[playerid][pinBufferLen[playerid]] = '\0';
    return 1;
}

stock PinRemoveDigit(playerid)
{
    if (pinBufferLen[playerid] <= 0)
        return 0;

    pinBufferLen[playerid]--;
    pinBuffer[playerid][pinBufferLen[playerid]] = '\0';

    // Kosongkan tampilan slot terakhir
    PlayerTextDrawSetString(playerid, tdpin[playerid][pinDisplayTD[pinBufferLen[playerid]]], "_");
    PlayerTextDrawShow(playerid, tdpin[playerid][pinDisplayTD[pinBufferLen[playerid]]]); // paksa refresh
    return 1;
}

stock ResetPinDisplay(playerid)
{
    for (new i = 0; i < PIN_LENGTH; i++)
    {
        PlayerTextDrawSetString(playerid, tdpin[playerid][pinDisplayTD[i]], "_");
        PlayerTextDrawShow(playerid, tdpin[playerid][pinDisplayTD[i]]); // paksa refresh
    }
    return 1;
}

stock PinSubmit(playerid)
{
    if (pinBufferLen[playerid] < PIN_LENGTH)
    {
        SendClientMessage(playerid, -1, "PIN belum lengkap!");
        return 0;
    }

    if (pinIsCreating[playerid])
    {
        if (!pinAwaitingConfirm[playerid])
        {
            // simpan input pertama, minta konfirmasi ulang
            format(pinFirstEntry[playerid], sizeof(pinFirstEntry[]), "%s", pinBuffer[playerid]);
            pinAwaitingConfirm[playerid] = true;
            pinBufferLen[playerid] = 0;
            pinBuffer[playerid][0] = '\0';
            ResetPinDisplay(playerid);
            SendClientMessage(playerid, -1, "Masukkan ulang PIN yang sama untuk konfirmasi.");
        }
        else
        {
            if (!strcmp(pinFirstEntry[playerid], pinBuffer[playerid]))
            {
                format(pAccountPIN[playerid], sizeof(pAccountPIN[]), "%s", pinBuffer[playerid]);
                pAccountHasPIN[playerid] = true;
                // TODO: simpan pAccountPIN[playerid] ke database akun kamu di sini

                SendClientMessage(playerid, -1, "PIN berhasil dibuat!");
                CallLocalFunction("OnPinCreated", "is", playerid, pAccountPIN[playerid]);
                ClosePinPad(playerid);
            }
            else
            {
                SendClientMessage(playerid, -1, "Konfirmasi tidak cocok. Silakan ulangi dari awal.");
                pinAwaitingConfirm[playerid] = false;
                pinBufferLen[playerid] = 0;
                pinBuffer[playerid][0] = '\0';
                ResetPinDisplay(playerid);
            }
        }
        return 1;
    }

    // ---- Mode verifikasi ----
    if (!strcmp(pAccountPIN[playerid], pinBuffer[playerid]))
    {
        SendClientMessage(playerid, -1, "PIN benar!");
        CallLocalFunction("OnPinVerifySuccess", "i", playerid);
        ClosePinPad(playerid);
    }
    else
    {
        pinAttemptsLeft[playerid]--;
        pinBufferLen[playerid] = 0;
        pinBuffer[playerid][0] = '\0';
        ResetPinDisplay(playerid);


        if (pinAttemptsLeft[playerid] <= 0)
        {
            SendClientMessage(playerid, -1, "PIN salah 3 kali. Kamu akan di-kick.");
            //GameTextForPlayer(playerid, "~r~PIN SALAH 3X~n~~w~ANDA AKAN DIKICK", 3000, 3);
            CallLocalFunction("OnPinLockedOut", "i", playerid);
            ClosePinPad(playerid);
            SetTimerEx("PinKickCB", PIN_KICK_DELAY, false, "i", playerid);
        }
        else
        {
            new msg[48];
            format(msg, sizeof(msg), "PIN salah! Sisa percobaan: %d", pinAttemptsLeft[playerid]);
            SendClientMessage(playerid, -1, msg);
            CallLocalFunction("OnPinVerifyFail", "ii", playerid, pinAttemptsLeft[playerid]);
        }
    }
    return 1;
}

