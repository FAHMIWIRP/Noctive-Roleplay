forward SelesaiKayu(playerid);
public SelesaiKayu(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    PlayerInfo[playerid][pKayu] -= 100;
    PlayerInfo[playerid][pCash] += 1000;
    GivePlayerMoneyEx(playerid, 1000);
    OnPlayerUpdateAccountsPer(playerid, "pKayu", PlayerInfo[playerid][pKayu]);
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pKayu", PlayerInfo[playerid][pKayu]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda berhasil proses kayu dan mendapatkan {00FF26} 1.000$ ", PlayerInfo[playerid]);
    ShowPanjulNotif(playerid, "Berhasil Proses Kayu");
    return 1;
}
stock GetWeaponNameByID(weaponid, weaponname[], len) {
    format(weaponname, len, "Unknown");
    switch(weaponid) {
        case 1: format(weaponname, len, "Brass Knuckles");
        case 2: format(weaponname, len, "Golf Club");
        case 3: format(weaponname, len, "Nitestick");
        case 4: format(weaponname, len, "Knife");
        case 5: format(weaponname, len, "Baseball Bat");
        case 9: format(weaponname, len, "Chainsaw");
        case 22: format(weaponname, len, "Colt 45");
        case 23: format(weaponname, len, "Silenced Pistol");
        case 24: format(weaponname, len, "Desert Eagle");
        case 25: format(weaponname, len, "Shotgun");
        case 26: format(weaponname, len, "Sawnoff Shotgun");
        case 27: format(weaponname, len, "Combat Shotgun");
        case 28: format(weaponname, len, "Micro SMG (Uzi)");
        case 29: format(weaponname, len, "MP5");
        case 30: format(weaponname, len, "AK-47");
        case 31: format(weaponname, len, "M4");
        case 32: format(weaponname, len, "Tec-9");
        case 33: format(weaponname, len, "Country Rifle");
        case 34: format(weaponname, len, "Sniper Rifle");
        // Kamu bisa tambah sendiri sesuai ID senjata SA-MP
    }
    return 1;
}

// Fungsi untuk mendapatkan ID Object Model Senjata dari ID Senjatanya
stock GetWeaponObjectModel(weaponid) {
    switch(weaponid) {
        case 1: return 331; // Brass Knuckles
        case 2: return 333; // Golf Club
        case 3: return 334; // Nitestick
        case 4: return 335; // Knife
        case 5: return 336; // Baseball Bat
        case 9: return 341; // Chainsaw
        case 22: return 346; // Colt 45
        case 23: return 347; // Silenced
        case 24: return 348; // Desert Eagle
        case 25: return 349; // Shotgun
        case 26: return 350; // Sawnoff
        case 27: return 351; // Combat Shotgun
        case 28: return 352; // Micro SMG
        case 29: return 353; // MP5
        case 30: return 355; // AK-47
        case 31: return 356; // M4
        case 32: return 372; // Tec-9
        case 33: return 357; // Country Rifle
        case 34: return 358; // Sniper Rifle
    }
    return 1239; // Default pickup info icon jika model tidak ketemu
}

// Forward untuk Timer hapus senjata otomatis
forward RemoveDroppedGun(id);
public RemoveDroppedGun(id) {
    if(DroppedGuns[id][dg_Active]) {
        // Hapus Object dan Text
        DestroyDynamicObject(DroppedGuns[id][dg_ObjectID]);
        DestroyDynamic3DTextLabel(DroppedGuns[id][dg_TextID]);
        
        // Hapus file simpanan di scriptfiles/dropgun/
        new filename[64];
        format(filename, sizeof(filename), "dropgun/%d.ini", id);
        if(fexist(filename)) fremove(filename);
        
        DroppedGuns[id][dg_Active] = false;
    }
    return 1;
}

// ==================== COMMAND: DROP GUN ====================
CMD:dropweapon(playerid, params[]) {
    new weaponid = GetPlayerWeapon(playerid);
    new ammo = GetPlayerAmmo(playerid);
    
    if(weaponid == 0 || ammo <= 0) return SendClientMessage(playerid, -1, "Anda tidak sedang memegang senjata!");
    
    new slot = -1;
    for(new i = 0; i < MAX_DROPPED_GUNS; i++) {
        if(!DroppedGuns[i][dg_Active]) {
            slot = i;
            break;
        }
    }
    
    if(slot == -1) return SendClientMessage(playerid, -1, "Sudah terlalu banyak senjata tergeletak di server!");
    
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);
    
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    new intid = GetPlayerInterior(playerid);
    new vwid = GetPlayerVirtualWorld(playerid);
    
    DroppedGuns[slot][dg_Active] = true;
    DroppedGuns[slot][dg_WeaponID] = weaponid;
    DroppedGuns[slot][dg_Ammo] = ammo;
    DroppedGuns[slot][dg_X] = x;
    DroppedGuns[slot][dg_Y] = y;
    DroppedGuns[slot][dg_Z] = z - 1.0;
    DroppedGuns[slot][dg_Interior] = intid;
    DroppedGuns[slot][dg_VirtualWorld] = vwid;
    
    // Bypass fungsi GetWeaponObjectModel bawaan gamemode agar tidak eror
    new model_senjata = 1239;
    switch(weaponid) {
        case 1: model_senjata = 331; case 2: model_senjata = 333; case 3: model_senjata = 334;
        case 4: model_senjata = 335; case 5: model_senjata = 336; case 9: model_senjata = 341;
        case 22: model_senjata = 346; case 23: model_senjata = 347; case 24: model_senjata = 348;
        case 25: model_senjata = 349; case 26: model_senjata = 350; case 27: model_senjata = 351;
        case 28: model_senjata = 352; case 29: model_senjata = 353; case 30: model_senjata = 355;
        case 31: model_senjata = 356; case 32: model_senjata = 372; case 33: model_senjata = 357;
        case 34: model_senjata = 358;
    }
    
    DroppedGuns[slot][dg_ObjectID] = CreateDynamicObject(model_senjata, x, y, z - 1.0, 90.0, 0.0, 0.0, vwid, intid); 
    
    // Menggunakan array statis untuk nama senjata (Anti-Eror GetWeaponName)
    new nama_senjata[32];
    switch(weaponid) {
        case 1: nama_senjata = "Brass Knuckles"; case 2: nama_senjata = "Golf Club"; case 3: nama_senjata = "Nitestick";
        case 4: nama_senjata = "Knife"; case 5: nama_senjata = "Baseball Bat"; case 9: nama_senjata = "Chainsaw";
        case 22: nama_senjata = "Colt 45"; case 23: nama_senjata = "Silenced Pistol"; case 24: nama_senjata = "Desert Eagle";
        case 25: nama_senjata = "Shotgun"; case 26: nama_senjata = "Sawnoff Shotgun"; case 27: nama_senjata = "Combat Shotgun";
        case 28: nama_senjata = "Micro SMG (Uzi)"; case 29: nama_senjata = "MP5"; case 30: nama_senjata = "AK-47";
        case 31: nama_senjata = "M4"; case 32: nama_senjata = "Tec-9"; case 33: nama_senjata = "Country Rifle";
        case 34: nama_senjata = "Sniper Rifle"; default: nama_senjata = "Weapon";
    }
    
    new labelStr[128];
    format(labelStr, sizeof(labelStr), "Weapon (%s)\n{FFFF00}/pickupweapon", nama_senjata);
    DroppedGuns[slot][dg_TextID] = Text3D:CreateDynamic3DTextLabel(labelStr, 0xFFFFFFFF, x, y, z - 0.5, 15.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, vwid, intid);
    
    // Simpan ke file .ini
    new filename[64], File:file;
    format(filename, sizeof(filename), "dropgun/%d.ini", slot);
    file = fopen(filename, io_write);
    if(file) {
        new line[128];
        format(line, sizeof(line), "WeaponID=%d\r\n", weaponid); fwrite(file, line);
        format(line, sizeof(line), "Ammo=%d\r\n", ammo); fwrite(file, line);
        format(line, sizeof(line), "X=%f\r\n", x); fwrite(file, line);
        format(line, sizeof(line), "Y=%f\r\n", y); fwrite(file, line);
        format(line, sizeof(line), "Z=%f\r\n", z); fwrite(file, line);
        format(line, sizeof(line), "Interior=%d\r\n", intid); fwrite(file, line);
        format(line, sizeof(line), "VirtualWorld=%d\r\n", vwid); fwrite(file, line);
        fclose(file);
    }
    
    DroppedGuns[slot][dg_TimerID] = SetTimerEx("RemoveDroppedGun", DROP_TIMEOUT, false, "i", slot);
    
        // === GANTI BAGIAN YANG ERROR DENGAN INI ===
        // === PAKAI KODE INI (NAMA VARIABEL SUDAH DIGANTI AGAR TIDAK BENTROK) ===
    new panjul_wpn[13], panjul_ammo[13];
    for(new s = 0; s < 13; s++) {
        GetPlayerWeaponData(playerid, s, panjul_wpn[s], panjul_ammo[s]);
    }
    ResetPlayerWeapons(playerid);
    for(new s = 0; s < 13; s++) {
        if(panjul_wpn[s] != weaponid && panjul_wpn[s] != 0) {
            GivePlayerWeapon(playerid, panjul_wpn[s], panjul_ammo[s]);
        }
    }
    
    SendClientMessage(playerid, 0x2ECC71FF, " {FFFFFF}Kamu telah membuang senjatamu ke tanah.");
    return 1;
}

// ==================== COMMAND: PICKUP WEAPON ====================
CMD:pickupweapon(playerid, params[]) {
    new slot = -1;
    for(new i = 0; i < MAX_DROPPED_GUNS; i++) {
        if(DroppedGuns[i][dg_Active]) {
            if(IsPlayerInRangeOfPoint(playerid, 2.0, DroppedGuns[i][dg_X], DroppedGuns[i][dg_Y], DroppedGuns[i][dg_Z])) {
                slot = i;
                break;
            }
        }
    }
    
    if(slot == -1) return SendClientMessage(playerid, -1, "Tidak ada senjata di dekat Anda!");
    
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 0, 0, 0, 0);
    
    GivePlayerWeapon(playerid, DroppedGuns[slot][dg_WeaponID], DroppedGuns[slot][dg_Ammo]);
    KillTimer(DroppedGuns[slot][dg_TimerID]);
    
    // DISESUAIKAN: Menghapus object & text label versi dynamic streamer
    DestroyDynamicObject(DroppedGuns[slot][dg_ObjectID]);
    DestroyDynamic3DTextLabel(DroppedGuns[slot][dg_TextID]);
    
    new filename[64];
    format(filename, sizeof(filename), "dropgun/%d.ini", slot);
    if(fexist(filename)) fremove(filename);
    
    DroppedGuns[slot][dg_Active] = false;
    
    SendClientMessage(playerid, 0x2ECC71FF, " {FFFFFF}Kamu mengambil senjata dari tanah.");
    return 1;
}

CMD:tesbar(playerid, params[])
{
    if(PlayerProgressBarTimer[playerid] != -1)
    {
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
    }

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Memproses Data...");

    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Timer berjalan lambat sedikit (150ms) supaya kamu bisa menikmati transisi warnanya
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnTestBarUpdate", 150, true, "i", playerid);
    
    SendClientMessage(playerid, 0x00FF00FF, "[PROGRESS BAR] Memulai test bar transisi warna!");
    return 1;
}

// =============================================================================
// CUSTOM FUNCTIONS & CORE LOGIC
// =============================================================================

// Fungsi Inti untuk Memperbarui data TextDraw secara Real-time dengan Transisi Warna
public UpdatePlayerProgressBar(playerid, percent, const actionText[])
{
    if(percent < 0) percent = 0;
    if(percent > 100) percent = 100;

    // 1. HITUNG PANJANG BAR
    new Float:maxWidth = 198.0; 
    new Float:currentWidth = (maxWidth / 100.0) * percent;
    PlayerTextDrawTextSize(playerid, pProgressBarFill[playerid], currentWidth, 10.000000);
    
    // 2. LOGIKA TRANSISI WARNA SMOOTH (Lerp RGB)
    new r, g, b = 0, hexColor;
    
    if(percent < 50)
    {
        // FASE 1: Dari Merah (100%) ke Kuning (100% Merah + 100% Hijau)
        // Persen 0 -> Merah (255, 0, 0)
        // Persen 50 -> Kuning (255, 255, 0)
        r = 255;
        g = floatround((255.0 / 50.0) * percent);
    }
    else
    {
        // FASE 2: Dari Kuning ke Hijau (0% Merah + 100% Hijau)
        // Persen 50 -> Kuning (255, 255, 0)
        // Persen 100 -> Hijau (0, 255, 0)
        r = floatround(255.0 - ((255.0 / 50.0) * (percent - 50)));
        g = 255;
    }
    
    // Satukan komponen R, G, B, dan Alpha (FF untuk full solid) ke format Hex
    hexColor = (r << 24) | (g << 16) | (b << 8) | 0xFF;
    
    // Aplikasikan warna baru ke bar isi dan teks aktivitas agar serasi
    PlayerTextDrawColor(playerid, pProgressBarFill[playerid], hexColor);
    PlayerTextDrawColor(playerid, pProgressBarAction[playerid], hexColor);

    // 3. UPDATE STRING TEKS
    new strPercent[16];
    format(strPercent, sizeof(strPercent), "%d%%", percent);
    PlayerTextDrawSetString(playerid, pProgressBarText[playerid], strPercent);
    PlayerTextDrawSetString(playerid, pProgressBarAction[playerid], actionText);

    // 4. SHOW REFRESH
    PlayerTextDrawShow(playerid, pProgressBarBG[playerid]);
    PlayerTextDrawShow(playerid, pProgressBarFill[playerid]);
    PlayerTextDrawShow(playerid, pProgressBarText[playerid]);
    PlayerTextDrawShow(playerid, pProgressBarAction[playerid]);
    return 1;
}

// Callback Timer saat progress bar berjalan
public OnTestBarUpdate(playerid)
{
    PlayerProgressValue[playerid] += 2; // Naik 2% setiap 150 milidetik

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        SetTimerEx("HideBarAfterDone", 1500, false, "i", playerid);
        SendClientMessage(playerid, 0xFFFF00FF, "[PROGRESS BAR] Simulasi selesai.");
    }
    else
    {
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

// Callback untuk menyembunyikan TextDraw
public HideBarAfterDone(playerid)
{
    PlayerTextDrawHide(playerid, pProgressBarBG[playerid]);
    PlayerTextDrawHide(playerid, pProgressBarFill[playerid]);
    PlayerTextDrawHide(playerid, pProgressBarText[playerid]);
    PlayerTextDrawHide(playerid, pProgressBarAction[playerid]);
    return 1;
}

CMD:dweb1(playerid, params[])
{
	new fmt_msg[170 + 1];
    new ttext[30];
    if(PlayerInfo[playerid][pPrison] != 0) return Send(playerid, COLOR_GREY, "Tidak Bisa Digunakaan Saat Dipenjara");
	if(GetPVarInt(playerid,"pTimeDweb") > gettime()) return Send(playerid, COLOR_GREY, "Cool Down 5 Menit");
    PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
    SetPlayerChatBubble(playerid, "DARKWEB >>" ,COLOR_GREY,10.0,5000);
    ttext = "[DARKWEB]";
	format(fmt_msg, sizeof fmt_msg, "%s @unknown: %s",ttext, params);
	SendClientMessageToAll(COLOR_GREY,  fmt_msg);
	SendAdminMessage(COLOR_RED, format_string);
	SetPVarInt(playerid, "pTimeDweb", gettime() + 300);
	return 1;
}

CMD:createkanabis(playerid, params[])
{
    if(admin_level[playerid] < 6 || !admin_logged[playerid]) return 1;

    for(new i = 0; i < MAX_KANABIS; i++)
    {
        // Cari slot kanabis yang belum terpakai (koordinat X masih 0.0)
        if(KanabisData[i][kX] == 0.0)
        {
            new Float:x, Float:y, Float:z;
            GetPlayerPos(playerid, x, y, z);
            
            KanabisData[i][kX] = x;
            KanabisData[i][kY] = y;
            KanabisData[i][kZ] = z;
            KanabisData[i][kTaken] = false;
            
            // Spawn objek tanaman & text di titik admin berdiri
            KanabisData[i][kObject] = CreateDynamicObject(3409, x, y, z - 1.0, 0.0, 0.0, 0.0);
            KanabisData[i][kText] = CreateDynamic3DTextLabel("Tanaman Kanabis\n{FFFFFF}Gunakan {FFFF00}/ambilkanabis", 0x00FF00FF, x, y, z, 10.0);
            
            // SIMPAN DATA KE FILE .INI
            SaveKanabis(i);
            
            new msg[128];
            format(msg, sizeof(msg), "{5996FF}[ INFO ]{FFFFFF} Titik Kanabis ID: %d berhasil dibuat di koordinatmu!", i);
            SendClientMessage(playerid, -1, msg);
            return 1;
        }
    }
    return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Slot batas maksimal tanaman kanabis penuh!");
}

CMD:removekanabis(playerid, params[]) {
    if(admin_level[playerid] < 99 || !admin_logged[playerid]) return 1;
    new id;
    if(sscanf(params, "d", id)) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Gunakan: /removekanabis [id]");
    
    if(id < 0 || id >= MAX_KANABIS || !KanabisData[id][kX]) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} ID Kanabis tidak terdaftar!");

    // Menghapus objek fisik & teks di map dunia
    if(IsValidObject(KanabisData[id][kObject])) DestroyObject(KanabisData[id][kObject]);
    if(KanabisData[id][kText] != Text3D:INVALID_3DTEXT_ID) Delete3DTextLabel(KanabisData[id][kText]);
    
    // Menghapus file fisik di dalam folder scriptfiles/Kanabis/
    new path[64];
    format(path, sizeof(path), "Kanabis/%d.ini", id);
    if(fexist(path)) fremove(path);
    
    // Mengosongkan data di memori variabel
    KanabisData[id][kX] = 0.0;
    KanabisData[id][kY] = 0.0;
    KanabisData[id][kZ] = 0.0;
    KanabisData[id][kTaken] = false;
    
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Tanaman Kanabis dihapus permanen dari folder database.");
    return 1;
}

CMD:ambilkanabis(playerid, params[]) {
    if(PlayerInfo[playerid][pJobbm] == 0)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki pekerjaan Ilegal!");
    }
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    for(new i = 0; i < MAX_KANABIS; i++) {
        if(KanabisData[i][kX] != 0.0 && IsPlayerInRangeOfPoint(playerid, 3.0, KanabisData[i][kX], KanabisData[i][kY], KanabisData[i][kZ])) {
            if(KanabisData[i][kTaken]) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kanabis ini sudah diambil, tunggu cooldown!");
            if(PlayerInfo[playerid][pFamily] == -1) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda bukan anggota keluarga mana pun!");
            
            // LANGSUNG KUNCI STATUS DI AWAL BIAR GA DI-SPAM PLAYER LAIN
            KanabisData[i][kTaken] = true;
            SedangKerja[playerid] = true;

            // Mengubah teks label menjadi status diambil (merah)
            new str[128];
            format(str, sizeof(str), "[ID: %d]\nKanabis Sudah Di Ambil", i);
            Update3DTextLabelText(KanabisData[i][kText], 0xFF0000FF, str);

            // Pasang animasi merunduk/mengambil
            ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 0, 0);
            
            // SET PROGRESS BAR (10 Detik = 100ms x 100)
            PlayerProgressValue[playerid] = 0;
            format(PlayerActionText[playerid], 32, "TAKE KANABIS...");
            UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

            // Jalankan timer loop dengan membawa data playerid dan ID Kanabis (i)
            if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
            PlayerProgressBarTimer[playerid] = SetTimerEx("OnTakingCannabisUpdate", 100, true, "ii", playerid, i);
            return 1;
        }
    }
    SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu tidak berada dekat Tanaman Kanabis!");
    return 1;
}

forward FinishTakeKanabis(playerid, id);
public FinishTakeKanabis(playerid, id) 
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Bersihkan animasi, reset status kerja, dan hilangkan progress bar secara bersih
    ClearAnimations(playerid);
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid);

    // Menghitung jumlah acak hadiah kanabis (dapat 11 sampai 19 biji)
    new kanabisAmount = random(9) + 11; 

    // Memberikan item ke player
    PlayerInfo[playerid][pKanabis] += kanabisAmount;

    // Efek samping status tubuh setelah memanen
    PlayerInfo[playerid][pSatiety] -= 5.0;
    PlayerInfo[playerid][pThirst] -= 5.0;
    PlayerInfo[playerid][pStress] += 5.0;

    // Sinkronisasi data ke penyimpanan database akun player
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", _:PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", _:PlayerInfo[playerid][pStress]);
    OnPlayerUpdateAccountsPer(playerid, "pThirst", _:PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pKanabis", PlayerInfo[playerid][pKanabis]);

    // Jalankan timer hitung mundur cooldown otomatis (20 Menit)
    SetTimerEx("ResetKanabis", KANABIS_COLDOWN * 1000, false, "d", id);

    new str[128];
    format(str, sizeof(str), "{5996FF}[ INFO ]{FFFFFF} Kamu berhasil mengambil %d Kanabis!", kanabisAmount);
    SendClientMessage(playerid, -1, str);
    return 1;
}

forward OnTakingCannabisUpdate(playerid, cannabisid);
public OnTakingCannabisUpdate(playerid, cannabisid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil callback hadiah panen
        SetTimerEx("FinishTakeKanabis", 1000, false, "ii", playerid, cannabisid);
    }
    else
    {
        // Memaksa animasi mengambil tetap stabil berjalan looping selama bar berjalan
        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, 1, 0, 0, 0, 0);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

public ResetKanabis(id)
{
    if(id < 0 || id >= MAX_KANABIS) return 0;
    
    KanabisData[id][kTaken] = false;
    
    // Perbarui 3D Text Label atau Objek di sini jika diperlukan saat cooldown selesai
    if(IsValidDynamic3DTextLabel(KanabisData[id][kText]))
    {
        UpdateDynamic3DTextLabelText(KanabisData[id][kText], 0x00FF00FF, "Tanaman Kanabis\n{FFFFFF}Gunakan {FFFF00}/ambilkanabis");
    }
    return 1;
}

// =============================================================================
// FUNGSI UTAMA: SAVE & LOAD KANABIS (Ini yang membuat file tidak kosong)
// =============================================================================

stock SaveKanabis(id)
{
    new path[128];
    format(path, sizeof(path), "Kanabis/%d.ini", id); // Sesuai dengan struktur folder di panel kamu
    
    if(!fexist(path)) dini_Create(path);
    
    dini_FloatSet(path, "PosX", KanabisData[id][kX]);
    dini_FloatSet(path, "PosY", KanabisData[id][kY]);
    dini_FloatSet(path, "PosZ", KanabisData[id][kZ]);
    dini_IntSet(path, "Taken", _:KanabisData[id][kTaken]);
    return 1;
}

stock LoadKanabis()
{
    new path[128], loadedCount = 0;
    for(new i = 0; i < MAX_KANABIS; i++)
    {
        format(path, sizeof(path), "Kanabis/%d.ini", i);
        if(fexist(path))
        {
            KanabisData[i][kX] = dini_Float(path, "PosX");
            KanabisData[i][kY] = dini_Float(path, "PosY");
            KanabisData[i][kZ] = dini_Float(path, "PosZ");
            KanabisData[i][kTaken] = bool:dini_Int(path, "Taken");
            
            // SPAWN OBJEK & TEXT DI KOTA SAAT SERVER RESTART
            KanabisData[i][kObject] = CreateDynamicObject(3409, KanabisData[i][kX], KanabisData[i][kY], KanabisData[i][kZ] - 1.0, 0.0, 0.0, 0.0);
            
            if(KanabisData[i][kTaken])
            {
                KanabisData[i][kText] = CreateDynamic3DTextLabel("Tanaman Kanabis\n{FF0000}(Sedang Cooldown/Habis Dipanen)", 0xFF0000FF, KanabisData[i][kX], KanabisData[i][kY], KanabisData[i][kZ], 10.0);
                // Jika pas restart statusnya sedang diambil, jalankan sisa cooldown
                SetTimerEx("ResetKanabis", KANABIS_COLDOWN * 1000, false, "i", i);
            }
            else
            {
                KanabisData[i][kText] = CreateDynamic3DTextLabel("Tanaman Kanabis\n{FFFFFF}Gunakan {FFFF00}/ambilkanabis", 0x00FF00FF, KanabisData[i][kX], KanabisData[i][kY], KanabisData[i][kZ], 10.0);
            }
            
            loadedCount++;
        }
    }
    printf("[KANABIS]: Berhasil memuat %d titik tanaman Kanabis ke dalam kota.", loadedCount);
    return 1;
}

CMD:olahkanabis(playerid, params[])
{
    // 1. Cek apakah pemain berada di koordinat yang ditentukan
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 867.992370, -17.108974, 63.195312))
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak berada di lokasi pengolahan kanabis!");
    }
    
    if(PlayerInfo[playerid][pJobbm] == 0)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ ERROR ]{FFFFFF} Anda tidak memiliki pekerjaan Ilegal!");
    }

    // 2. Cek apakah pemain sedang dalam proses mengolah (Anti-Spam)
    if(PlayerMengolah[playerid] == 1 || SedangKerja[playerid] == true)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda sedang mengolah kanabis, harap tunggu!");
    }

    // 3. Cek apakah pemain memiliki minimal bahan
    if(PlayerInfo[playerid][pKanabis] < 17)
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda membutuhkan minimal 17 Kanabis untuk diolah!");
    }

    // 4. Mulai Proses Pengolahan
    PlayerMengolah[playerid] = 1;
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0); // Bekukan pemain
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 1, 1, 1, 0, 1); // Efek animasi

    // SET PROGRESS BAR
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENGOLAH KANABIS...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnProcessingCannabisUpdate", 250, true, "i", playerid);
    
    return 1;
}

forward OnProcessingCannabisUpdate(playerid);
public OnProcessingCannabisUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        SetTimerEx("SelesaiMengolah", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 1, 1, 1, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiMengolah(playerid);
public SelesaiMengolah(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    if(PlayerMengolah[playerid] == 1)
    {
        SedangKerja[playerid] = false;
        HideBarAfterDone(playerid);

        if(PlayerInfo[playerid][pKanabis] >= 17)
        {
            PlayerInfo[playerid][pKanabis] -= 17;

            new jumlahCrack = random(5) + 1; 
            PlayerInfo[playerid][pCrack] += jumlahCrack;

            PlayerMengolah[playerid] = 0;
            TogglePlayerControllable(playerid, 1);
            ClearAnimations(playerid);

            OnPlayerUpdateAccountsPer(playerid, "pKanabis", PlayerInfo[playerid][pKanabis]);
            OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pCrack]);

            new msg[128];
            format(msg, sizeof(msg), "{5996FF}[ INFO ]{FFFFFF} Anda berhasil mengolah 17 Kanabis menjadi %d Crack!", jumlahCrack);
            SendClientMessage(playerid, -1, msg);
        }
        else
        {
            PlayerMengolah[playerid] = 0;
            TogglePlayerControllable(playerid, 1);
            ClearAnimations(playerid);
            SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Pengolahan gagal karena Kanabis Anda tidak cukup.");
        }
    }
    return 1;
}

CMD:getjobtaxi(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, TAXI_JOB_X, TAXI_JOB_Y, TAXI_JOB_Z)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus berada di Kantor Taxi untuk mengambil pekerjaan!");

    if(PlayerData[playerid][pJobtaxi] == 1)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda sudah bekerja sebagai supir Taxi.");

    PlayerData[playerid][pJobtaxi] += 1; 
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda sekarang bekerja sebagai supir Taxi. Gunakan /dutytaxi di kendaraan taxi.");
    return 1;
}

CMD:keluartaxi(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, TAXI_JOB_X, TAXI_JOB_Y, TAXI_JOB_Z)) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus berada di Kantor Taxi untuk berhenti bekerja!");

    if(PlayerData[playerid][pJobtaxi] == 0)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda memang tidak bekerja sebagai supir Taxi.");

    if(DutyTaxi[playerid] == 1)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Off-duty dulu sebelum berhenti bekerja!");

    PlayerData[playerid][pJobtaxi] -= 1;
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda telah keluar dari pekerjaan supir Taxi.");
    return 1;
}

// --- [ COMMANDS: ON/OFF DUTY ] ---

CMD:dutytaxi(playerid, params[])
{
    if(PlayerInfo[playerid][pJobtaxi] < 1) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda bukan supir Taxi!");
    
    if(PlayerInfo[playerid][pProducts][0] == 0) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak memiliki handphone untuk menerima pesanan!");

    if(PlayerInfo[playerid][pNumber] == 0)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak memiliki nomor HP aktif!");

    new vehicleid = GetPlayerVehicleID(playerid);
    if(GetVehicleModel(vehicleid) != 420) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus berada di dalam Taxi!");

    DutyTaxi[playerid] = 1;
    SetPlayerColor(playerid, COLOR_YELLOW);

    new str[144], name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));
    
    // Pesan Global (Broadcast) tetap dipertahankan formatnya agar sesuai dengan UI server
    format(str, sizeof(str), "{FFFF00}[TAXI] %s {FFFFFF}Sedang On Duty Taxi Gunakan {33AA33}[/call %d]", name, PlayerInfo[playerid][pNumber]);
    SendClientMessageToAll(-1, str);
    return 1;
}

CMD:listtaxi(playerid, params[])
{
    new count = 0, str[144];
    
    SendClientMessage(playerid, COLOR_YELLOW, "============= [ TAXI NOCTIVE ] =============");

    foreach(new i : Player)
    {
        if(DutyTaxi[i] == 1)
        {
            format(str, sizeof(str), "{FFFFFF}%s {33AA33}[/call %d]", GetPlayerNameEx(i), PlayerInfo[i][pNumber]);
            SendClientMessage(playerid, -1, str);
            count++;
        }
    }

    if(count == 0) 
    {
        SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Maaf, saat ini tidak ada supir taxi yang On Duty.");
    }
    
    SendClientMessage(playerid, COLOR_YELLOW, "===========================================");
    return 1;
}

CMD:offdutytaxi(playerid, params[])
{
    if(DutyTaxi[playerid] == 0) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda tidak sedang duty.");
    
    DutyTaxi[playerid] = 0;
    ArgoStatus[playerid] = 0;
    SetPlayerColor(playerid, COLOR_WHITE);
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda sekarang Off Duty.");
    return 1;
}

// --- [ COMMANDS: ARGO SYSTEM ] ---

CMD:argo(playerid, params[])
{
    if(DutyTaxi[playerid] == 0) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus duty taxi dulu!");
    if(!IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Anda harus berada di dalam taxi.");
    
    ArgoStatus[playerid] = 1;
    ArgoDistance[playerid] = 0.0;
    GetPlayerPos(playerid, OldX[playerid], OldY[playerid], OldZ[playerid]);
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Argo dimulai.");
    return 1;
}

CMD:argostop(playerid, params[])
{
    if(ArgoStatus[playerid] == 0) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Argo tidak sedang berjalan.");
    
    new Float:totalHarga = ArgoDistance[playerid] * 0.4;
    new str[128];
    
    format(str, sizeof(str), "{5996FF}[ INFO ]{FFFFFF} Anda harus membayar $%s sesuai dengan Argo.", FormatMoney(floatround(totalHarga)));
    
    SendClientMessage(playerid, -1, str);
    new veh = GetPlayerVehicleID(playerid);
    for(new i = 0; i < MAX_PLAYERS; i++) {
        if(IsPlayerConnected(i) && IsPlayerInVehicle(i, veh) && i != playerid) {
            SendClientMessage(i, -1, str);
        }
    }
    
    ArgoStatus[playerid] = 0;
    return 1;
}
CMD:tambang(playerid, params[])
{
    if(PlayerInfo[playerid][pDutynambang] == 0) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Tidak Berkerja Di Tambang");
    if(pData[playerid][pBatuk] > 50) return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Sudah Membawa Batu Banyak");

    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 700.753112, 897.196960, -37.445045) &&
      !IsPlayerInRangeOfPoint(playerid, 3.0, 699.648498, 887.328857, -37.498165) &&
      !IsPlayerInRangeOfPoint(playerid, 3.0, 700.008117, 892.716003, -38.445304) &&
      !IsPlayerInRangeOfPoint(playerid, 3.0, 678.169799, 895.661376, -40.125831))
    {
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Tidak Berada Di Tambang Batu");
    }

    if(IsMining[playerid]) return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Menambang");

    IsMining[playerid] = 1;
    KlikBatu[playerid] = 0;

    new chance = random(100);
    new str[64];

    if(chance < 80)
    {
        JenisBatu[playerid] = 1;
        TargetKlik[playerid] = 5;
        PlayerTextDrawColor(playerid, MinerTD[playerid][1], 0x635453); // Batu Biasa (HITAM)
        format(str, sizeof(str), "~b~BATU BIASA: ~w~0/5");
    }
    else
    {
        JenisBatu[playerid] = 2;
        TargetKlik[playerid] = 20;
        PlayerTextDrawColor(playerid, MinerTD[playerid][1], 0x00FF00FF); // Batu GIOK
        format(str, sizeof(str), "~p~BATU GIOK: ~w~0/20");
    }

    PlayerTextDrawSetString(playerid, MinerTD[playerid][2], str);

    // Tampilkan UI Latar & Teks
    PlayerTextDrawShow(playerid, MinerTD[playerid][0]);
    PlayerTextDrawShow(playerid, MinerTD[playerid][2]);
    PlayerTextDrawShow(playerid, MinerTD[playerid][3]);
    PlayerTextDrawShow(playerid, MinerTD[playerid][4]);

    // Tampilkan batu dengan posisi acak aman pertama
    RefreshStonePosition(playerid);

    SelectTextDraw(playerid, 0xFFFFFFFF);
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BASEBALL", "Bat_4", 4.1, 1, 1, 1, 1, 1, 1);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Click Batu Yg Muncul");
    return 1;
}

stock RefreshStonePosition(playerid)
{
    // Koordinat acak disesuaikan agar batu SELALU berada di dalam kotak besar yang baru
    StoneX[playerid] = 190.0 + float(random(220)); // X aman antara 190 sampai 410
    StoneY[playerid] = 120.0 + float(random(100)); // Y aman antara 120 sampai 220

    PlayerTextDrawHide(playerid, MinerTD[playerid][1]);
    PlayerTextDrawSetPos(playerid, MinerTD[playerid][1], StoneX[playerid], StoneY[playerid]);
    PlayerTextDrawShow(playerid, MinerTD[playerid][1]);
    return 1;
}
CMD:bukagiok(playerid, params[])
{
    // Validasi lokasi koordinat tempat memotong/membuka giok
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 2151.3359, -2267.3532, 13.3069))
    {
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Harus Ada Di Tempat Pemotongan Giok");
    }

    // Anti-spam saat proses loading sedang berjalan
    if(IsMembukaGiok[playerid] || SedangKerja[playerid] == true) 
        return SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Membuka Batu Giok");

    // Cek apakah player punya bahan baku pGiok
    if(PlayerInfo[playerid][pGiok] < 1) 
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu Tidak Punya Batu Giok");

    // Kunci status proses kerja
    IsMembukaGiok[playerid] = true;
    SedangKerja[playerid] = true;
    
    // Potong bahan baku di awal proses
    PlayerInfo[playerid][pGiok] -= 1;
    OnPlayerUpdateAccountsPer(playerid, "pGiok", PlayerInfo[playerid][pGiok]);

    // Matikan pergerakan & pasang Animasi memahat/memotong
    TogglePlayerControllable(playerid, 0); 
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);

    // SET PROGRESS BAR (7 Detik = 70ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MEMBUKA GIOK...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Jalankan timer loop untuk memperbarui loading bar setiap 70ms
    if(PlayerProgressBarTimer[playerid] != -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnOpeningJadeUpdate", 70, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Membuka Lapisan Luar Giok");
    return 1;
}
forward OnOpeningJadeUpdate(playerid);
public OnOpeningJadeUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil fungsi gacha hadiah giok
        SetTimerEx("SelesaiBukaGiok", 1000, false, "i", playerid);
    }
    else
    {
        // Memaksa animasi tetap looping berjalan selama bar belum penuh
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward SelesaiBukaGiok(playerid);
public SelesaiBukaGiok(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Bersihkan animasi, buka freeze, hapus textdraw bar, dan buka kembali kunci cmd
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);
    IsMembukaGiok[playerid] = false;
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid);

    new chance = random(100);

    if(chance < 50) // 50% Giok Hijau
    {
        PlayerInfo[playerid][pGiokhijau] += 1;
        OnPlayerUpdateAccountsPer(playerid, "pGiokhijau", PlayerInfo[playerid][pGiokhijau]);
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Berhasil! Anda mendapatkan {00FF00}1x Giok Hijau{FFFFFF}.");
        PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    }
    else if(chance < 75) // 25% Giok Putih
    {
        PlayerInfo[playerid][pGiokputih] += 1;
        OnPlayerUpdateAccountsPer(playerid, "pGiokputih", PlayerInfo[playerid][pGiokputih]);
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Berhasil! Anda mendapatkan {FFFFFF}1x Giok Putih{FFFFFF}.");
        PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    }
    else if(chance < 80) // 5% Giok Bintang
    {
        PlayerInfo[playerid][pGiokbintang] += 1;
        OnPlayerUpdateAccountsPer(playerid, "pGiokbintang", PlayerInfo[playerid][pGiokbintang]);
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Langka! Anda mendapatkan {FFFF00}1x Giok Bintang{FFFFFF}!");
        PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
    }
    else if(chance < 83) // 3% Giok Rainbow
    {
        PlayerInfo[playerid][pGiokrainbow] += 1;
        OnPlayerUpdateAccountsPer(playerid, "pGiokrainbow", PlayerInfo[playerid][pGiokrainbow]);
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} SANGAT LANGKA! Anda mendapatkan {FF00FF}1x Giok Rainbow{FFFFFF}!");
        PlayerPlaySound(playerid, 1056, 0.0, 0.0, 0.0);
    }
    else // 17% Gagal
    {
        SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Gagal! Batu Giok retak dan hancur saat dibelah.");
        PlayerPlaySound(playerid, 1084, 0.0, 0.0, 0.0);
    }
    return 1;
}
CMD:cucibatu(playerid, params[])
{
    // 1. Cek koordinat tempat pencucian batu (Radius 3.0 meter)
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 540.118774, 592.301330, 0.322248))
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu tidak berada di tempat pencucian batu!");

    // 2. Anti spam saat progress bar sedang berjalan
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    // 3. Cek apakah player punya minimal 4 batu kotor (pBatuk)
    if(PlayerInfo[playerid][pBatuk] < 4)
        return SendClientMessage(playerid, -1, "{FF3838}[ INFO ]{FFFFFF} Kamu membutuhkan minimal 4 batu kotor untuk dicuci!");

    // 4. Mulai proses kunci & potong bahan di awal
    SedangKerja[playerid] = true;
    PlayerInfo[playerid][pBatuk] -= 4;
    OnPlayerUpdateAccountsPer(playerid, "pBatuk", PlayerInfo[playerid][pBatuk]);

    // Bekukan posisi player & mainkan animasi mencuci/merunduk
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);

    // SET PROGRESS BARU (15 Detik = 150ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENCUCI BATU...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // TIMER LOOP DIUBAH MENJADI 150ms AGAR PAS 15 DETIK
    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnWashingStoneUpdate", 150, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Mencuci Batu Kotor");
    return 1;
}

forward OnWashingStoneUpdate(playerid);
public OnWashingStoneUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil fungsi hadiah
        SetTimerEx("SelesaiCuciBatu", 1000, false, "i", playerid);
    }
    else
    {
        // Memaksa animasi mencuci tetap berjalan looping stabil selama bar belum penuh
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiCuciBatu(playerid);
public SelesaiCuciBatu(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Bersihkan animasi, unfreeze, reset status kerja, dan hapus progress bar dari layar
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1);
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid); // Menghilangkan TextDraw progress bar secara bersih dari layar

    // Berikan hadiah 2x Batu Bersih (pBatu)
    PlayerInfo[playerid][pBatu] += 2;
    OnPlayerUpdateAccountsPer(playerid, "pBatu", PlayerInfo[playerid][pBatu]);

    // Notifikasi Sukses & Suara Tugas Selesai
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Sukses! Anda berhasil mencuci 4 Batu Kotor menjadi 2x Batu Bersih.");
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0);
    return 1;
}

CMD:tuangbatu(playerid, params[])
{
    if(PlayerInfo[playerid][pBatu] < 1)
                return SendClientMessage(playerid, 0xB4B5B7FF, "Anda tidak memiliki Batu.");

    if(!IsPlayerInRangeOfPoint(playerid, 8.0, 2151.822998, -2262.609863, 13.297279))
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]{FFFFFF} Anda Tidak Berada Di tempat peleburan!");

    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Tunggu proses sebelumnya selesai!");

    // --- PROSES AWAL (LOADING) ---
    SedangKerja[playerid] = true;

    // Matikan pergerakan & Animasi
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);

    // SET PROGRESS BAR (10 Detik = 100ms x 100)
    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MELEBURKAN BATU...");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    // Jalankan timer loop untuk memperbarui loading bar setiap 100ms
    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnSmeltingStoneUpdate", 100, true, "i", playerid);

    SendClientMessage(playerid, -1, "{FFFF00}INFO: {FFFFFF}Sedang meleburkan batu, harap tunggu...");
    return 1;
}
forward OnSmeltingStoneUpdate(playerid);
public OnSmeltingStoneUpdate(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;
        
        // Jeda mulus 1 detik pas bar penuh hijau, baru panggil fungsi hadiah peleburan
        SetTimerEx("SelesaiMelebur", 1000, false, "i", playerid);
    }
    else
    {
        // Memaksa animasi melebur tetap berjalan looping stabil selama bar belum penuh
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.1, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
forward SelesaiMelebur(playerid);
public SelesaiMelebur(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    // Selesaikan status membawa batu, reset bar, & Bersihkan Animasi
    MembawaBatu[playerid] = false;
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid); // Menghilangkan TextDraw progress bar secara bersih dari layar
    
    RemovePlayerAttachedObject(playerid, 9);
    SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1); // Bisa bergerak lagi

    // Update Data Akun
    PlayerInfo[playerid][pBatu] -= 1;
    PlayerInfo[playerid][pEmas] += 3;
    OnPlayerUpdateAccountsPer(playerid, "pBatu", PlayerInfo[playerid][pBatu]);
    OnPlayerUpdateAccountsPer(playerid, "pEmas", PlayerInfo[playerid][pEmas]);

    // Berikan Info & Checkpoint Baru
    SendClientMessage(playerid, -1, "{00FF00}BERHASIL: {FFFFFF}Batu berhasil dilebur! Kamu mendapatkan emas 2g.");
   
    PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0); // Suara tugas selesai
    return 1;
}

CMD:sellpacket(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid)) return Error(playerid, "Turun dari kendaraan terlebih dahulu");
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(AmbilPacket[playerid] == 0) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Belum Mengambil Paket");
	if(!IsPlayerInRangeOfPoint(playerid, 5, 2244.5522,-2147.8166,13.5468)) return SendClientMessage(playerid, COLOR_GREY, "Anda Tidak Berada Ditempat Pengantaran Paket");
    {
        new YogGanteng[116];
        StatusPacket = 0;
        AmbilPacket[playerid] = 0;
        PosPacket[0] = 0;
	    PosPacket[1] = 0;
	    PosPacket[2] = 0;
        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
        RemovePlayerAttachedObject(playerid, 2);
        GivePlayerMoney(playerid, 2000);
	    PlayerInfo[playerid][pCash] += 2000;
    	PlayerInfo[playerid][pRm] += 10000;
   		PlayerInfo[playerid][pMetall] +=5;
		OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
	    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    	OnPlayerUpdateAccountsPer(playerid, "pRm", PlayerInfo[playerid][pRm]);
	    GameTextForPlayer(playerid, "~g~+10000$+5Metall", 2000, 1);
        format(YogGanteng, sizeof(YogGanteng), "%s[%d] {ffffff}Berhasil Mengirim Paket Ilegal", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_BLUE, YogGanteng);
    }
    return 1;
}
CMD:givelicgun(playerid, params[])
{
    // Pengecekan faksi (Hanya untuk Polisi)
    if(!IsACop(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    new targetid;
    
    // Mengecek parameter ID target
    if(sscanf(params, "u", targetid)) 
        return SCM(playerid, COLOR_GREY, "Penggunaan: /givelicgun [playerid]");
        
    if(!IsPlayerConnected(targetid)) 
        return SCM(playerid, COLOR_GREY, "Pemain tersebut tidak sedang online.");

    // Memberikan lisensi dan mengatur waktu expired (Waktu sekarang + 30 Hari dalam hitungan detik)
    pData[targetid][pFirearms] = 1;
    pData[targetid][pFirearmsExpire] = gettime() + 2592000; 

    // Notifikasi pesan
    new str[128];
    format(str, sizeof(str), "Kamu memberikan Lisensi Senjata kepada %s (Berlaku 30 Hari).", GetPlayerNameEx(targetid));
    SCM(playerid, -1, str);
    
    format(str, sizeof(str), "Police %s memberikanmu Lisensi Senjata yang berlaku selama 30 Hari.", GetPlayerNameEx(playerid));
    SCM(targetid, -1, str);

    return 1;
}
CMD:takelicarmy(playerid, params[])
{
    // Pengecekan faksi (Hanya untuk Militer/Army)
    // Catatan: Ganti 'IsAArmy' sesuai dengan fungsi pengecekan Tentara di script-mu jika berbeda
    if(!IsAArmy(playerid)) return SCM(playerid, COLOR_GREY, "Anda tidak dapat menggunakan perintah ini.");

    new targetid;
    
    // Mengecek parameter ID target
    if(sscanf(params, "u", targetid)) 
        return SCM(playerid, COLOR_GREY, "Penggunaan: /takelicarmy [playerid]");
        
    if(!IsPlayerConnected(targetid)) 
        return SCM(playerid, COLOR_GREY, "Pemain tersebut tidak sedang online.");

    // Cek apakah target memang punya lisensi atau tidak
    if(PlayerInfo[targetid][pFirearms] == 0)
        return SCM(playerid, COLOR_GREY, "Pemain tersebut memang tidak memiliki Lisensi Senjata.");

    // Mencabut lisensi dan mereset waktu expired menjadi 0
    pData[targetid][pFirearms] = 0;
    pData[targetid][pFirearmsExpire] = 0; 

    // Mengirim notifikasi pesan
    new str[128];
    format(str, sizeof(str), "Kamu telah mencabut Lisensi Senjata milik %s.", GetPlayerNameEx(targetid));
    SCM(playerid, -1, str);
    
    format(str, sizeof(str), "Anggota Police %s telah mencabut Lisensi Senjata milikmu.", GetPlayerNameEx(playerid));
    SCM(targetid, -1, str);

    return 1;
}
CMD:takepacket(playerid, params[])
{
	if(GetFractionMemberAmount(FRACTION_LSPD) < 2) return Send(playerid, COLOR_GREY, "Polisi kurang dari 2 orang.");
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(AmbilPacket[playerid] == 1) return SendClientMessage(playerid, COLOR_RED, "[ERROR] Anda Sudah Mengambil Paket");
    if(StatusPacket == 2) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Diambil Player Lain");
	if(IsPlayerInRangeOfPoint(playerid, 5, PosPacket[0], PosPacket[1], PosPacket[2]))
    {
        new YogGanteng[116];
        StatusPacket = 2;
        AmbilPacket[playerid] = 1;
        DestroyDynamicPickup(IDPacket);
        DestroyDynamic3DTextLabel(PacketLabel);
        ApplyAnimation(playerid,"CARRY","putdwn",4.0,0,1,1,0,0,1);
        SetPlayerAttachedObject(playerid, 2, 1575, 5,0.3,0.1,0.0,0.0,270.0,0.0, 1, 1, 1, 0xFF00FF00);
        SetPlayerCheckpoint(playerid, 2244.5522,-2147.8166,13.5468, 2.0);
        format(YogGanteng, sizeof(YogGanteng), "%s[%d] {FFFFFF}Telah Mengambil Paket Ilegal, Buru Dia Sekarang", Name(playerid), playerid);
	    SendClientMessageToAll(COLOR_YELLOW, YogGanteng);
        SendClientMessage(playerid, COLOR_YELLOW, "Cepat Antar Packet Ke Label Merah, Anda Diincar Banyak Orang");
    }
    return 1;
}
CMD:findpacket(playerid, params[])
{
	if(PlayerInfo[playerid][pLevel] < 5) return SCM(playerid, COLOR_GREY, "level anda belum cukup");
	if(GetFractionMemberAmount(FRACTION_LSPD) < 2) return Send(playerid, COLOR_GREY, "Polisi kurang dari 2 orang.");
    if(StatusPacket == 0) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Paket Tidak Ditemukan");
    if(StatusPacket == 2) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Diambil Player Lain");
    if(StatusPacket == 1)
    {
    SetPlayerCheckpoint(playerid, PosPacket[0], PosPacket[1], PosPacket[2], 2.0);
    SendClientMessage(playerid, COLOR_YELLOW, "Cepat Ambil Packet Dilabel Merah, Keburu Diambil Orang");
    }
	return 1;
}
CMD:startpacket(playerid, params[])
{
    if(StatusPacket != 0) return SCM(playerid, COLOR_RED, "[ PAKET ILEGAL ] {0080FF}Sudah Aktif");
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    KillTimer(TimePacket);
	TimePacket = SetTimer("TimePaket", 5000, 0);
	return 1;
}

