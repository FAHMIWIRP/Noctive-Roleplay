forward DestruirTextoDraw(playerid);
public DestruirTextoDraw(playerid)
{
    TextDrawHideForPlayer(playerid, GiveDamage);
    TextDrawHideForPlayer(playerid, TakeDamage);
    return 1;
}
public OnPlayerTakeDamage(playerid, issuerid, Float: amount, weaponid, bodypart)
{ 
    if(issuerid != INVALID_PLAYER_ID) // Pastikan ada penyerang
    {
        new iname[MAX_PLAYER_NAME], logEntry[128];
        GetPlayerName(issuerid, iname, sizeof(iname));
        format(logEntry, sizeof(logEntry), "%s Telah Melakukan Penembakan Dengan Damage %d", iname, floatround(amount));
        
        damageLogs[damageLogIndex] = logEntry;
        damageLogIndex++;
        
        if(damageLogIndex >= MAX_DAMAGE_LOGS)
        {
            damageLogIndex = 0; // Reset index jika penuh
        }
    }
     if(issuerid != INVALID_PLAYER_ID)
    {
        new name[MAX_PLAYER_NAME], str[128];
        GetPlayerName(issuerid, name, sizeof(name));
        
        format(str, sizeof(str), "~r~you take damage from %s ( -%.1f )", name, amount);
        
        PlayerTextDrawSetString(playerid, DmgNotifyTD[playerid], str);
        PlayerTextDrawShow(playerid, DmgNotifyTD[playerid]);

        // Mengatur ulang timer baru
        if(DmgNotifyTimer[playerid] != -1) KillTimer(DmgNotifyTimer[playerid]);
        DmgNotifyTimer[playerid] = SetTimerEx("HideDmgNotifyTD", 3000, false, "d", playerid);
    }
	killer_id[playerid] = issuerid;
	killer_weapon[playerid] = weaponid;
    new s[20];
    format(s, 20, "-Damage %.0f", amount);
    TextDrawSetString(TakeDamage, s);
    TextDrawShowForPlayer(playerid, TakeDamage);
    SetTimerEx("HideDamageTD", 1000, false, "i", playerid);
    new Text3D:bar3D, damageStr[HEALTH_LENGTH];
    valstr(damageStr, floatround(amount));
    bar3D = Create3DTextLabel(damageStr, COLOR_BAR, 0.0, 0.0, 0.0, HEALTH_DRAW, 0);
    Attach3DTextLabelToPlayer(bar3D, playerid, 0.0, 0.0, HEALTH_OFFSET);
    SetTimerEx("UpdateDamageBar", TIME_FIRST, 0, "iiffii", playerid, _:bar3D, amount, HEALTH_OFFSET, 16, COLOR_BAR);
    if(DamageTDShowing[playerid] == 1)
    {
        switch(bodypart)
        {
            case BODY_PART_HEAD:
            {
                PlayerTextDrawShow(playerid, DamageTD[Head][playerid]);
                Indicator[playerid][0] = 1;
            }
            case BODY_PART_TORSO:
            {
                PlayerTextDrawShow(playerid, DamageTD[Torso][playerid]);
                Indicator[playerid][1] = 1;
            }
            case BODY_PART_GROIN:
            {
                PlayerTextDrawShow(playerid, DamageTD[Groin][playerid]);
                Indicator[playerid][2] = 1;
            }
            case BODY_PART_RIGHT_ARM:
            {
                PlayerTextDrawShow(playerid, DamageTD[RArm][playerid]);
                Indicator[playerid][3] = 1;
            }
            case BODY_PART_LEFT_ARM:
            {
                PlayerTextDrawShow(playerid, DamageTD[LArm][playerid]);
                Indicator[playerid][4] = 1;
            }
            case BODY_PART_RIGHT_LEG:
            {
                PlayerTextDrawShow(playerid, DamageTD[RLeg][playerid]);
                Indicator[playerid][5] = 1;
                ApplyAnimation(playerid,"KNIFE","KILL_Knife_Ped_Die",4.0,0,1,1,1,0);
            }
            case BODY_PART_LEFT_LEG:
            {
                PlayerTextDrawShow(playerid, DamageTD[LLeg][playerid]);
                Indicator[playerid][6] = 1;
                ApplyAnimation(playerid,"KNIFE","KILL_Knife_Ped_Die",4.0,0,1,1,1,0);
            }

        }
        SetTimerEx("HideDamageIndicator", 5000, false, "i", playerid);
    }
    if(pData[playerid][pDM] == 1)
	{
	    if(issuerid != INVALID_PLAYER_ID && bodypart == 9) //Sniper you can change or add more weapon as like you
	    {
	     	new stringa[80];
		    new namesj[MAX_PLAYERS];
		    GetPlayerName(playerid, namesj, sizeof(namesj));
		    format(stringa, sizeof(stringa), "[ ! ]:[%s]Ia tewas dengan ditembak di kepala", namesj);
		    SendClientMessageToAll(0xFFFF00FF,stringa);
	        SetPlayerHealth(playerid, 0);
	    	SetPlayerArmour(playerid, 0);
		   	//GameTextForPlayer(playerid, "~r~Headshot!", 3000, 2);
		   	//GameTextForPlayer(issuerid, "~r~Headshot!", 3000, 2);
	   	}
   	}
    if (issuerid != INVALID_PLAYER_ID) // Pastikan yang menyerang adalah pemain lain
    {
        if (weaponid == 25) // Shotgun (Weapon ID 25)
        {
            new Float:armor, Float:health;
            GetPlayerArmour(playerid, armor);
            GetPlayerHealth(playerid, health);

            if (armor > 0.0) // Jika pemain masih punya armor
            {
                new Float:newArmor = armor - (100.0 / 4); // Butuh 4 hit untuk habis

                if (newArmor <= 0.0)
                {
                    SetPlayerArmour(playerid, 0.0); // Hapus armor jika sudah habis
                }
                else
                {
                    SetPlayerArmour(playerid, newArmor); // Kurangi armor sesuai damage
                }
            }
            else // Jika armor sudah habis, baru HP yang berkurang
            {
                new Float:newHealth = health - (100.0 / 4);

                if (newHealth <= 0.0)
                {
                    SetPlayerHealth(playerid, 0.0); // Bunuh pemain jika HP habis
                }
                else
                {
                    SetPlayerHealth(playerid, newHealth);
                }
			}
			return 1;
		}
	}
    if(issuerid != INVALID_PLAYER_ID)
	{
	    if(PlayerInfo[playerid][pLevel] < 5)
		{
		    new Float: health, Float: armour;

			GetPlayerHealth(issuerid, health);
			GetPlayerArmour(issuerid, armour);

            SetPlayerHealth(issuerid, health);
		    SetPlayerArmour(issuerid, armour);

		    SCM(playerid, COLOR_GREY, "Kamu warga baru , kebal dari tembakan player");
		    return 0;
		}

		killer_id[issuerid] = playerid;
		killer_weapon[issuerid] = weaponid;
		killer_clear[issuerid] = 10;
	}
    return 1;
}
epublic: OnPlayerTimer(playerid)
{
	if(GetPlayerData(playerid, pDelayDeath) > 0)
	{
			AddPlayerData(playerid, pDelayDeath, -, 1);
			update_int_mysql(playerid, "pDelayDeath", GetPlayerData(playerid, pDelayDeath));

			if(GetPlayerData(playerid, pDelayDeath) <= 0)
				Info(playerid, "Kamu Sudah Bisa Menggunakan /death, sekarang");
	}

	if(GetPlayerSpeed(playerid) > 190)
 	{
            SetTimerEx("DelayKick", 500, 0, "i", playerid);
            new fmt_msg[128];
            format(fmt_msg, sizeof fmt_msg, "BotCmd: %s has been kicked by BOT.", GetPlayerNameEx(playerid));
            SendClientMessageToAll(0xFF5533FF, fmt_msg);
            SendClientMessageToAll(0xFF5533FF, "Reason: Speed Hack!");
 	}
 	return 1;
}
epublic: KickFivem(playerid, status[])
{
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[2]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[3]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[4]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[5]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[6]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[7]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[8]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[9]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[10]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[11]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[12]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[13]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[14]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[15]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[16]);
    TextDrawShowForPlayer(playerid, KICKAGUSSAMP[17]);
    PlayerTextDrawShow(playerid, KICKAGUSSAMPTD[playerid][0]);
    PlayerTextDrawShow(playerid, KICKAGUSSAMPTD[playerid][1]);
    PlayerTextDrawShow(playerid, KICKAGUSSAMPTD[playerid][2]);
    PlayerTextDrawShow(playerid, KICKAGUSSAMPTD[playerid][3]);

    new AgusSamp[100];
    format(AgusSamp, sizeof(AgusSamp), "Reason : %s", status);
    PlayerTextDrawSetString(playerid, KICKAGUSSAMPTD[playerid][3], AgusSamp);
    SetTimerEx("KickPublic", 200, false, "d", playerid);
    return 1;
}
