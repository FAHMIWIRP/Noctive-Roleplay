        VehInfo[EMSVehicles[playerid]][vSost] = 0;

        VehInfo[EMSVehicles[playerid]][vFr] = FRACTION_LSMEDICS;

        VehInfo[EMSVehicles[playerid]][vStatus] = 0;

        Fuell[EMSVehicles[playerid]] = MAX_VEHICLE_FUEL;

        VehInfo[EMSVehicles[playerid]][vInt] = 0;

        VehInfo[EMSVehicles[playerid]][vWorld] = 0;

        VehInfo[EMSVehicles[playerid]][vRentCena] = 0;

        VehInfo[EMSVehicles[playerid]][vBuyCena] = 0;

        new Float: health;
        GetVehicleHealth(EMSVehicles[playerid], health);

        SetVehicleParamsEx(EMSVehicles[playerid],1,0,0,0,0,0,0);

        PutPlayerInVehicle(playerid, EMSVehicles[playerid], 0);

        DestroyVehicleLabel(EMSVehicles[playerid]);
    }

    if(dialogid == DIALOG_SHARELOC)
    {
        if(response)
        {
            new targetid = strval(inputtext);

            if(targetid == INVALID_PLAYER_ID || targetid == playerid)
                return SCM(playerid, COLOR_GREY, "ID pemain tidak valid.");

            if(!IsPlayerConnected(targetid))
                return SCM(playerid, COLOR_GREY, "Pemain tidak terhubung.");

            if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid) != 0)
                return Send(playerid, COLOR_GREY, "Kamu ada didalam interior!");

            SendPlayerOffer(playerid, targetid, OFFER_TYPE_SHARELOC);

            SCMF(playerid, 0x6BB3FFAA, "Anda telah menawarkan %s untuk share lokasi anda", GetPlayerNameEx(targetid));
            SCMF(targetid, 0x6BB3FFAA, "%s ingin membagikan lokasinya kepada Anda", GetPlayerNameEx(playerid));

            return SCM(targetid, -1, "Untuk persetujuan klik Y(/accept) atau untuk pengabaian N(/cancel)");
        }
        else
        {
            return SCM(playerid, -1, "Anda membatalkan pengiriman permintaan lokasi.");
        }
    }
    
