CMD:plantsubur(playerid, params[])
{
    if(admin_level[playerid] < 1 || !admin_logged[playerid]) return 1;

    new filename[64];
    for(new i = 0; i < MAX_PLANTS; i++)
    {
        if(ServerPlant[i][splActive] == 1)
        {
            ServerPlant[i][splTimeLeft] = 0;
            UpdatePlantText(i);

            format(filename, sizeof(filename), "plant/%d.ini", i);
            if(fexist(filename))
            {
                dini_IntSet(filename, "TimeLeft", 0);
            }
        }
    }

    SendClientMessageToAll(-1, "{00D9FF}[ADMIN]{FFFFFF} Admin Telah Membuat semua tanaman jadi subur");
    return 1;
}
