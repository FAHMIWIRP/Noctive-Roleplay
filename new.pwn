// Command untuk memutar musik ke semua warga
CMD:djmbg(playerid, params[])
{
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

    // Looping ke semua player yang sedang online di kota
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i))
        {
            // Memutar URL mp3
            PlayAudioStreamForPlayer(i, "http://c.top4top.io/m_38064cscb1.mp3");
        }
    }
    
    SendClientMessageToAll(0xFFD700FF, "[DJ NOCTIVE]: Musik sedang diputar untuk semua warga!");
    GameTextForAll("~b~DJ MBG", 5000, 3);
    return 1;
}

