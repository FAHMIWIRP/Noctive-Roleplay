CMD:buyseeds(playerid, params[])
{
    // Cek radius 3.0 meter dari koordinat Toko Benih
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, SEEDS_SHOP_X, SEEDS_SHOP_Y, SEEDS_SHOP_Z))
        return SendClientMessage(playerid, 0xFF0000FF, "[ERROR] Anda tidak berada di lokasi toko benih!");

    if(SeedStock <= 0)
        return SendClientMessage(playerid, 0xFF0000FF, "[ERROR] Stock benih saat ini sedang habis!");

    new infoStr[150];
    format(infoStr, sizeof(infoStr), "Harga Saat Ini: $%d / seed\nStock Tersedia: %d\n\nMasukkan jumlah benih (seeds) yang ingin Anda beli:", SeedPrice, SeedStock);
    ShowPlayerDialog(playerid, DIALOG_BUY_SEEDS, DIALOG_STYLE_INPUT, "Beli Seeds", infoStr, "Beli", "Batal");
    return 1;
}

CMD:stockseeds(playerid, params[])
{
    // Silakan batasi akses admin di sini sesuai variabel gamemode kamu, contoh:
    if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;

    new amount;
    if(sscanf(params, "d", amount)) 
        return SendClientMessage(playerid, 0xAFAFAFFF, "Gunakan: /stockseeds [jumlah]");

    if(amount <= 0) 
        return SendClientMessage(playerid, 0xFF0000FF, "[ERROR] Jumlah stock harus lebih dari 0!");

    SeedStock += amount;
    UpdateSeedShopLabel(); // Otomatis meng-update teks & menyimpan perubahan ke file .ini

    new msg[128];
    format(msg, sizeof(msg), "[ADMIN] Anda berhasil menambah stock benih sebanyak %d. (Total Stock: %d)", amount, SeedStock);
    SendClientMessage(playerid, 0x00FF00FF, msg);
    return 1;
}

stock LoadSeedStock()
{
    new iniFile = ini_openFile(PATH_SEEDS_INI);
    if(iniFile >= 0)
    {
        ini_getInteger(iniFile, "Stock", SeedStock);
        ini_closeFile(iniFile);
        printf("[SEED SYSTEM] Berhasil memuat stok benih dari file .ini: %d", SeedStock);
    }
    else
    {
        // Jika file belum ada, buat file baru dengan stok default 1000
        iniFile = ini_createFile(PATH_SEEDS_INI);
        if(iniFile >= 0)
        {
            ini_openFile(PATH_SEEDS_INI);
            ini_setInteger(iniFile, "Stock", 1000);
            ini_closeFile(iniFile);
            SeedStock = 1000;
            print("[SEED SYSTEM] File .ini tidak ditemukan. Membuat file baru dengan default stok 1000.");
        }
    }
    return 1;
}

stock SaveSeedStock()
{
    new iniFile = ini_openFile(PATH_SEEDS_INI);
    if(iniFile >= 0)
    {
        ini_setInteger(iniFile, "Stock", SeedStock);
        ini_closeFile(iniFile);
    }
    return 1;
}

public UpdateSeedShopLabel()
{
    new labelStr[200];
    format(labelStr, sizeof(labelStr), "{FFFFFF}Stock Seeds : {FFFF00}%d\n{FFFFFF}Price : {00FF00}$%d / seed\n{AFAFAF}Gunakan /buyseeds Untuk Membeli Seeds", SeedStock, SeedPrice);
    UpdateDynamic3DTextLabelText(SeedShopLabel, 0xFFFFFFFF, labelStr);
    
    // Setiap kali stok berubah, otomatis simpan ke file .ini
    SaveSeedStock();
    return 1;
}

public OnSeedPriceUpdate()
{
    // Mengacak harga baru dari rentang 250 sampai 550 setiap 1 jam
    SeedPrice = 250 + random(301); 
    UpdateSeedShopLabel();
    printf("[SEED SHOP] Harga benih diperbarui otomatis menjadi $%d/seed.", SeedPrice);
    return 1;
}
CMD:stockmetal(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;

    new amount;
    if(sscanf(params, "d", amount)) 
        return SendClientMessage(playerid, 0xFFFFFFFF, "Gunakan: /stockmetal [jumlah]");
        
    if(amount < 0) 
        return SendClientMessage(playerid, 0xFF0000AA, "Jumlah tidak boleh minus!");

    g_MetalStock = amount;
    SaveMetalStock();   // Simpan ke file
    UpdateMetalLabel();  // Perbarui text label

    new string[128];
    format(string, sizeof(string), "Admin telah mengubah stock metal menjadi: %d unit.", amount);
    SendClientMessageToAll(0x00FFFFAA, string);
    return 1;
}
stock UpdateMetalLabel()
{
    new string[128];
    format(string, sizeof(string), "{FFFFFF}Stock: {FFFF00}%d\n{FFFFFF}Price: {00FF00}$%d/1\n{FFFFFF}Gunakan {FF0000}/buymetal {FFFFFF}Untuk Membeli", g_MetalStock, g_MetalPrice);
    Update3DTextLabelText(g_MetalText, 0xFFFFFFFF, string);
}

// Fungsi untuk menyimpan stock ke scriptfiles
stock SaveMetalStock()
{
    new File:hFile = fopen("stockmetal/ini", io_write);
    if(hFile)
    {
        new string[32];
        format(string, sizeof(string), "%d", g_MetalStock);
        fwrite(hFile, string);
        fclose(hFile);
    }
}

// Fungsi untuk memuat stock dari scriptfiles
stock LoadMetalStock()
{
    if(fexist("stockmetal/ini"))
    {
        new File:hFile = fopen("stockmetal/ini", io_read);
        if(hFile)
        {
            new string[32];
            fread(hFile, string);
            g_MetalStock = strval(string);
            fclose(hFile);
        }
    }
    else
    {
        g_MetalStock = 100; // Stock default jika file belum ada
        SaveMetalStock();
    }
}

public UpdateMetalPrice()
{
    g_MetalPrice = 33 + random(68); // Acak harga $33 - $100
    UpdateMetalLabel();
    SendClientMessageToAll(0xFFFF00AA, "[INFO] Harga pasaran metal telah berubah! Silahkan cek di tempat penjualan.");
    return 1;
}
CMD:answer(playerid, params[])
{
    new tmp[256], string[256];
    
    if (quiz == 0)
        return Error(playerid, "Sayangnya tidak ada kuis dari admin server.");
        
    if (sscanf(params, "s[256]", tmp))
        return SendClientMessage(playerid, -1, "/answer [jawaban]");
    
    // Gunakan strcmp untuk membandingkan string
    if(strcmp(tmp, answers, true) == 0)
    {
        GivePlayerMoneyEx(playerid, qprs);
        
        format(string, sizeof(string), "[QUIZ]: %s telah memberikan jawaban yang benar '%s' dari kuis dan mendapatkan hadiah {00FF00}%d$.", ReturnName(playerid), answers, qprs);
        SendClientMessageToAll(0xFFFF00FF, string);
        
        // Reset state kuis
        answermade = 0;
        quiz = 0;
        qprs = 0;
        
        // Cara benar mengosongkan string di PAWN
        answers[0] = EOS; 
    }
    else
    {
        Error(playerid, "Jawaban yang salah, coba keberuntungan Anda lain kali.");
    }
    return 1;
}
CMD:kick(playerid, params[])
{
   	if(admin_level[playerid] < 2 || !admin_logged[playerid]) return 1;

	if(sscanf(params, "ds[128]",params[0], params[1])) return Send(playerid, -1, "Masuk: /kick [id] [alasan]");
	if(!IsPlayerConnected(params[0])) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan. / tidak resmi.");
	if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, COLOR_GREY, "Anda tidak dapat memblokir administrator atas/rekan.");

	format(format_string, sizeof(format_string), "Server: {ffffff}Administrator %s menendang pemain %s. Alasan: %s", Name(playerid), Name(params[0]), params[1]);
	SendClientMessageToAll(COLOR_BLUE, format_string);

	PlayerInfo[playerid][pAdmKick] ++;
	OnPlayerUpdateAdminPer(playerid, "pAdmKick", PlayerInfo[playerid][pAdmKick]);

	KickD(params[0], "");
	return true;
}
CMD:skick(playerid, params[])
{
    if(admin_level[playerid] < 5 || !admin_logged[playerid]) return 1;
    if(PlayerInfo[params[0]][pLogin] == 0) return Send(playerid, COLOR_GREY, "Pemain tidak memasuki permainan. / tidak resmi.");
    if(sscanf(params, "d",params[0],params[1])) return Send(playerid, -1, "Masuk: /skick [id]");
    if(admin_level[params[0]] >= admin_level[playerid]) return Send(playerid, COLOR_GREY, "Anda tidak dapat memblokir administrator atas/rekan.");

    PlayerInfo[playerid][pAdmKick] ++;
    OnPlayerUpdateAdminPer(playerid, "pAdmKick", PlayerInfo[playerid][pAdmKick]);

	SCMF(params[0], COLOR_GREY, "Anda ditendang oleh administrator %s untuk pelanggaran aturan server.", Name(playerid));
	KickD(params[0], "");
	//
	format(format_string, sizeof(format_string), "[A] Administrator %s[%d] menendang pemain %s[%d] tidak ada suara", Name(playerid), playerid, Name(params[0]), params[0]);
	SendAdminMessage(COLOR_GREY, format_string);
	return true;
}
