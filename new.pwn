// --- AMBIL PEKERJAAN ---
CMD:getjobpenebang(playerid, params[])
{
    if(PlayerInfo[playerid][pJobPenebang] == 1) 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu sudah bekerja sebagai penebang kayu!");
    }
    if(PlayerInfo[playerid][pSex] == 1)
    {
        SetPlayerSkin(playerid, 159); // Baju kerja laki-laki
    }
    else
    {
        SetPlayerSkin(playerid, 198); // Baju kerja perempuan
    }
    
    PlayerInfo[playerid][pJobPenebang] = 1;
    ShowPanjulNotif(playerid, "Berhasil Ambil Job");
    SendClientMessage(playerid, -1, "{00FF00}[INFO]: {FFFFFF}Kamu sekarang bekerja sebagai Penebang Kayu. Gunakan gergaji mesin untuk menebang!");
    return 1;
}

// --- KELUAR PEKERJAAN ---
CMD:selesaipenebang(playerid, params[])
{
    if(PlayerInfo[playerid][pJobPenebang] == 0) 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu tidak bekerja sebagai penebang kayu!");
    }
    SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]); 
    
    PlayerInfo[playerid][pJobPenebang] = 0;
    ShowPanjulNotif(playerid, "Selesai Nebang Kayu");
    SendClientMessage(playerid, -1, "{00FF00}[INFO]: {FFFFFF}Kamu telah keluar dari pekerjaan Penebang Kayu.");
    return 1;
}
CMD:buytools(playerid, params[])
{
    // Cek lokasi player, cuma bisa dipake di kordinat tools shop
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 291.664581, -83.417297, 1001.515625))
        return SendClientMessage(playerid, -1, "{E74C3C}[ERROR]{FFFFFF} Kamu tidak berada di Tools Shop!");

    // Memunculkan dialog dengan list tools shop
    ShowPlayerDialog(playerid, DIALOG_BUY_TOOLS, DIALOG_STYLE_LIST, 
        "{00D9FF}Tools Shop - Noctive Roleplay", 
        "{FFFFFF}Knife\t\t {00FF00}$500\n{FFFFFF}Chainsaw\t {00FF00}$1.000\n{FFFFFF}Bat\t\t {00FF00}$1.000\n{FFFFFF}Shovel\t\t {00FF00}$1.000", 
        "Beli", "Batal"
    );
    return 1;
}

// --- PROSES MENEBANG POHON ---
CMD:tebang(playerid, params[])
{
    // 1. Validasi pekerjaan
    if(PlayerInfo[playerid][pJobPenebang] == 0) 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu harus mengambil pekerjaan ini terlebih dahulu (/getjobpenebang)!");
    }
    
    // 2. Validasi senjata gergaji mesin (ID Senjata 9 = Chainsaw)
    if(GetPlayerWeapon(playerid) != 9)
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu harus memegang Gergaji Mesin (Chainsaw) untuk menebang!");
    }
    
    // 3. Validasi jarak dengan koordinat pohon
    new bool:diKoordinat = false;
    for(new i = 0; i < sizeof(KoordinatPohon); i++)
    {
        // Angka 3.0 adalah radius jarak deteksi player ke titik koordinat pohon
        if(IsPlayerInRangeOfPoint(playerid, 3.0, KoordinatPohon[i][0], KoordinatPohon[i][1], KoordinatPohon[i][2]))
        {
            diKoordinat = true;
            break;
        }
    }
    
    if(!diKoordinat) 
    {
        return SendClientMessage(playerid, -1, "{FF0000}[ERROR]: {FFFFFF}Kamu tidak berada di dekat pohon yang valid!");
    }

    // 4. Cek apakah pemain sedang dalam proses
    if(SedangKerja[playerid] == true)
        return SendClientMessage(playerid, -1, "{FF6347}[ INFO ]{FFFFFF} Tunggu proses sebelumnya selesai!");

    // 5. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "CHAINSAW", "WEAPON_csaw", 4.1, 1, 0, 0, 0, 0, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "Menebang Kayu..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnTebang", 250, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu sedang menebang kayu...");
    return 1;
}

forward OnTebang(playerid);
public OnTebang(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("SelesaiTebang", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "CHAINSAW", "WEAPON_csaw", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}

forward SelesaiTebang(playerid);
public SelesaiTebang(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);

    PlayerInfo[playerid][pKayu] += 10;
    PlayerInfo[playerid][pThirst] -= 2;
    PlayerInfo[playerid][pSatiety] -= 2;
    PlayerInfo[playerid][pStress] += 2;

    OnPlayerUpdateAccountsPer(playerid, "pThirst", PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pKayu", PlayerInfo[playerid][pKayu]);
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pStress", PlayerInfo[playerid][pStress]);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda berhasil menebang kayu dan mendapatkan 10 Kayu ", PlayerInfo[playerid]);
    return 1;
}
