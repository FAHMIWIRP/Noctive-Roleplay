	        // CEK HADIAH & AKSI BERDASARKAN JENIS BATU
	        if(JenisBatu[playerid] == 1)
	        {
	            // --- KHUSUS BATU BIASA ---
	            MembawaBatu[playerid] = false; 
	            
	            PlayerInfo[playerid][pBatuk] += 1;
	            OnPlayerUpdateAccountsPer(playerid, "pBatuk", PlayerInfo[playerid][pBatuk]);
	            callcmd::stopanim(playerid,"");
	            PlayerInfo[playerid][pHoe] -= 2;
                OnPlayerUpdateAccountsPer(playerid, "pHoe", PlayerInfo[playerid][pHoe]);
	            SendClientMessage(playerid, 0xFFFF00FF, "[MINER] Anda Mendapatkan! Batu biasa.");
	        }
	        else
	        {
	            // --- KHUSUS BATU GIOK ---
	            MembawaBatu[playerid] = false; 
	
	            PlayerInfo[playerid][pGiok] += 1;
	            OnPlayerUpdateAccountsPer(playerid, "pGiok", PlayerInfo[playerid][pGiok]);
	            PlayerInfo[playerid][pHoe] -= 3;
                OnPlayerUpdateAccountsPer(playerid, "pHoe", PlayerInfo[playerid][pHoe]);
	            SendClientMessage(playerid, 0x00FF00FF, "[MINER] Anda Mendapatkan! Batu Giok!");
	            callcmd::stopanim(playerid,"");
	            PlayerPlaySound(playerid, 1058, 0.0, 0.0, 0.0); 
	        }
	    }
	    return 1;
	}
    
