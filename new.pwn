    OnPlayerUpdateAccountsPer(playerid, "pMicin", PlayerInfo[playerid][pMicin]);
    OnPlayerUpdateAccountsPer(playerid, "pCrack", PlayerInfo[playerid][pMicin]);
    OnPlayerUpdateAccountsPer(playerid, "pMetall", PlayerInfo[playerid][pMetall]);
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pGun", PlayerInfo[playerid][pGun]);
        OnPlayerUpdateAccountsPer(playerid, "pAmmo", PlayerInfo[playerid][pAmmo]);

    // Feedback
    new name[MAX_PLAYER_NAME], tname[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));
    GetPlayerName(targetid, tname, sizeof(tname));

    new str[128];
    format(str, sizeof(str), "Admin %s Memberi Kamu Benefit Gang", name);
    SendClientMessage(targetid, 0xFFFF00, str);

    format(str, sizeof(str), "Kamu Memberi %s Benefit Gang", tname);
    SendClientMessage(playerid, 0xFFFF00, str);

    return 1;
}

CMD:setbenefitstremer(playerid, params[])
{
 if(admin_level[playerid] < 10 || !admin_logged[playerid]) return 1;
    new targetid;

    // Ambil parameter ID/Name player
    if (sscanf(params, "u", targetid))
        return SendClientMessage(playerid, 0xFF0000FF, "Gunakan: /setbenefitstremer [ID/Name Player]");

    // Cek koneksi
    if (!IsPlayerConnected(targetid))
        return SendClientMessage(playerid, 0xFF0000FF, "Player tidak terhubung.");

    // Beri benefit
    GivePlayerMoneyEx(targetid, 10000, "");
    PlayerInfo[playerid][pVipTime] = gettime() + (86400 * 7);
	PlayerInfo[playerid][pVip] = 3;
	OnPlayerUpdateAccountsPer(playerid, "pVipTime", PlayerInfo[targetid][pVip]);
	OnPlayerUpdateAccountsPer(playerid, "pVip", PlayerInfo[targetid][pVip]);
	new u_car = GetPlayerFreeCarSlot(playerid); 
    if(u_car == -0) 
    { 
        return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Anda tidak memiliki slot kosong"); 
    } 
    format(VehiclePlate[targetid][u_car], 16, "NoHave"); 
    CarInfo[playerid][cModel][u_car] = 451; 
    CarInfo[playerid][cColor1][u_car] = 0; 
    CarInfo[playerid][cColor2][u_car] = 0; 
    CarInfo[playerid][cFuel][u_car] = 100.0; 
