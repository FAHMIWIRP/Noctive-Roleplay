			new max_price = 40000000;

			if(price > max_price) return SCMF(playerid, COLOR_GREY, "Biaya maksimum: $%i", max_price);

			SCMF(playerid, 0x6BB3FFAA, "Anda menyarankan %s beli pompa bensin dari Anda %s. Harga: $%i", GetPlayerNameEx(to_player), BizzAInfo[a_id][aMessage], price);

			SCMF(to_player, 0x6BB3FFAA, "%s menyarankan (a) Anda membeli pompa bensin darinya %s. Harga: $%i", GetPlayerNameEx(playerid), BizzAInfo[a_id][aMessage], price);
		    SCM(to_player, -1, "Penawaran masuk. Gunakan otot Y untuk menerima atau menolak penawaran");

		    SendPlayerOffer(playerid, to_player, OFFER_TYPE_SELLFUEL, price);
