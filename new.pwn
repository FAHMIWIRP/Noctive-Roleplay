    {
        Delete3DTextLabel(StatusLabel[playerid]);
        StatusLabel[playerid] = Text3D:INVALID_3DTEXT_ID;
    }
    
    IsStreaming[playerid] = false;
    StreamPlatform[playerid][0] = '\0';
    StreamUsername[playerid][0] = '\0';

    GetPlayerHealth(playerid, LastHP[playerid]);
    GetPlayerArmour(playerid, LastArmour[playerid]);
    
    new string[128];
    format(string, sizeof(string), "%s {FFFF00} Masuk Ke Server Noctive Roleplay", GetPlayerNameEx(playerid));
    SendClientMessageToAll(-1, string);

    new labelStr[200];
    format(labelStr, sizeof(labelStr), "{FF0000}HP : %.0f {FFFFFF}|| AP : %.0f\n(%d)", LastHP[playerid], LastArmour[playerid], playerid);

    // Membuat label baru
    StatusLabel[playerid] = Create3DTextLabel(labelStr, 0xFFFFFFFF, 0.0, 0.0, 0.0, 50.0, 0, 0);
    Attach3DTextLabelToPlayer(StatusLabel[playerid], playerid, 0.0, 0.0, 1.0);
    for(new i = 0; i < 51; i++)
	{
        PlayerTextDrawShow(playerid, infop[playerid][i]);
    }
   for(new i = 0; i < 28; i++)
	{
        PlayerTextDrawHide(playerid, hbepanjulann[playerid][i]);
    }
    for(new i = 0; i < 17; i++)
	{
        PlayerTextDrawHide(playerid, PANJULINFOPLAYERNOCTIVE[playerid][i]);
    }
    if(PlayerInfo[playerid][pLevel] < 5) // kalau level di bawah 5
    {
       for(new i = 0; i < 20; i++)
    {
        PlayerTextDrawShow(playerid, wbaru[playerid][i]);
    }
    }
    else // kalau level diatas 5
    {
       for(new i = 0; i < 20; i++)
    {
        PlayerTextDrawHide(playerid, wbaru[playerid][i]);
    }
    }
  for(new i = 0; i < 16; i++)
    {
        PlayerTextDrawHide(playerid, onfraksi[playerid][i]);
    }
    //tdnoctivepanjul
  /* for(new i = 0; i < 6; i++)
    {
        PlayerTextDrawShow(playerid, TDNAMANOCTIVE[playerid][i]);
    }*/
   for(new i = 0; i < 12; i++)
    {
        PlayerTextDrawShow(playerid, tdmerdeka81[playerid][i]);
    }
   for(new i = 0; i < 15; i++)
    {
        PlayerTextDrawHide(playerid, panpanpan[playerid][i]);
    }

   for(new i = 0; i < 15; i++)
    {
        PlayerTextDrawHide(playerid, factiontdpanjul[playerid][i]);
    }

    for(new i = 0; i < 10; i++)
    {
        PlayerTextDrawHide(playerid, Hbebypanjullll[playerid][i]);
    }
    
    for(new i = 0; i < 12; i++)
	{
        PlayerTextDrawHide(playerid, panjuleweaw[playerid][i]);
    }
    
    for(new i = 0; i < 12; i++)
	{
        PlayerTextDrawHide(playerid, PANJULKECE[playerid][i]);
    }

    for(new i = 0; i < 12; i++)
	{
        PlayerTextDrawShow(playerid, hbenorp[playerid][i]);
    }
    
    for(new i = 0; i < 17; i++)
	{
        PlayerTextDrawHide(playerid, infopanjul[playerid][i]);
    }

	FpsDisplayUpdate[playerid] = SetTimerEx("FpsDisplayGame", 3000, true, "d", playerid);
	
//	ShowHbeBaru(playerid);
//	ShowHbeByPanjul(playerid);
//	ShowHbeByFahmi(playerid);
    ResetVariables(playerid);
    StopAudioStreamForPlayer(playerid);
    
    CheckAndAttachWeapon(playerid);

 //   TextDrawShowForPlayer(playerid,TextDate);
	//TextDrawShowForPlayer(playerid,TextTime);

 //   LaparPros[playerid] = SetTimerEx("ProcessPlayerLapar", 900000, true, "d", playerid);
  //  HausPros[playerid] = SetTimerEx("ProcessPlayerHaus", 900000, true, "d", playerid);
   // StresPros[playerid] = SetTimerEx("ProcessPlayerStres", 900000, true, "d", playerid);
	
  //  showhudbar(playerid);
    
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
