CMD:flisttutuphgh(playerid)
{
    new members[MAX_FRACTIONS];

    foreach(Player, i) members[ PlayerInfo[i][pMember] ]++;

    String = "";

    new str[64];

    for(new i = 1; i < MAX_FRACTIONS; i++)
    {
        format(str, 64, "%i. %s\t%i\n", i, GetFractionName(i), members[i]);
        strcat(String, str);
    }

    return SPD(playerid, 0, DIALOG_STYLE_TABLIST, "Fraksi online", String, "Tutup", "");
}
CMD:doorc1(playerid)
{
    new vehicleid = GetNearbyVehicle(playerid);
    if (vehicleid == INVALID_VEHICLE_ID)
    {
        return SCM(playerid, COLOR_SYNTAX, "You are not in range of any vehicle.");
    }
    if (!VehicleHasDoors(vehicleid))
    {
        return SCM(playerid, COLOR_SYNTAX, "This vehicle has no doors.");
    }
    
    if (!GetVehicleParams(vehicleid, VEHICLE_DOOR_LEFT_FRONT))
    {
        SetVehicleParams(vehicleid, VEHICLE_DOOR_LEFT_FRONT, true);
        format(String, 188, "%s Membuka pintu depan kiri mobil dengan bantuan kedua tangan", Name(playerid));
    }
    else
    {
        SetVehicleParams(vehicleid, VEHICLE_DOOR_LEFT_FRONT, false);
        format(String, 188, "%s Menutup pintu depan kiri mobil dengan bantuan kedua tangan", Name(playerid));
    }
    
    ProxDetector(20.0, playerid, String, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);
    SetPlayerChatBubble(playerid, "Mengoperasikan pintu depan kiri mobil", COLOR_PURPLE, 20.0, 10000);
    
    return 1;
}

