    if (PlayerInfo[targetid][pMinyakbersih] > 0) {
        format(szItem, sizeof(szItem), "Minyak Bersih\t%d\n", PlayerInfo[targetid][pMinyakbersih]);
        strcat(ilham, szItem);
    }
