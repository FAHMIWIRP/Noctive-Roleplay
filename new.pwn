CMD:pm(playerid, params[])
{
	if(!strlen(params))
		return SendClientMessage(playerid, 0xFFFFFFFF, "Gunakan: /pm [id pemain] [message]");

    extract params -> new to_player, string:message[1000]; else return SendClientMessage(playerid, 0xFFFFFFFF, "Gunakan: /pm [id pemain] [message]");

    if(pData[playerid][pTogPm])
        return Error(playerid, "You must enable private messaging first.");

    if(OnDuty[to_player] ==1)
		return Error(playerid, "You can't pm'ing admin duty now!");

	if(to_player == INVALID_PLAYER_ID)
        return Error(playerid, "You have specified an invalid player.");

    if(to_player == playerid)
        return Error(playerid, "You can't private message yourself.");
        
    if(PlayerInfo[to_player][pTogPm] == 0)
        return Error(playerid, "That player has disabled private messaging.");


    //GameTextForPlayer(to_player, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~New message!", 3000, 3);
    PlayerPlaySound(to_player, 1085, 0.0, 0.0, 0.0);
    new fmt_str[1000];
    new fmt_msg[1000];
	format(fmt_str, sizeof fmt_str, "(( Chat Ooc Dari %s (%d): %s ))", ReturnName(playerid), playerid, message);
	format(fmt_msg, sizeof fmt_msg, "(( Pesan Ooc Untuk %s (%d): %s ))", ReturnName(to_player), to_player, message);

    SendClientMessage(to_player, COLOR_YELLOW, fmt_str);
    SendClientMessage(playerid, COLOR_YELLOW, fmt_msg);
    Info(to_player, "/togpm for tog enable/disable PM");

    return 1;
}
CMD:tow(playerid, params[])
{
 	if(!IsAMech(playerid)) return SCM(playerid, COLOR_GREY, "Anda Bukan Seorang Penderek Mobil");
	if(IsPlayerInAnyVehicle(playerid))
	{
		new carid = GetPlayerVehicleID(playerid);
		if(IsATowTruck(carid))
		{
		new closestcar = GetClosestCarTow(playerid, carid);
		if(GetDistanceToCarTow(playerid,closestcar) <= 8 && !IsTrailerAttachedToVehicle(carid))
		{
		foreach(Player, i)
		{
		if(ProxDetectorS(30.0,playerid,i))
		arr_Towing[playerid] = closestcar;
		format(format_string, sizeof(format_string), "INFO: {ffff00}%s {ffffff}Kamu Telah Menderek Mobil ", Name(playerid));
		SendClientMessage(playerid, COLOR_BLUE, format_string);
      	return AttachTrailerToVehicle(closestcar,carid);
		}
		SendClientMessage(playerid, COLOR_BLUE, "This vehicle has no registration, it is available for impounding.");
		AttachTrailerToVehicle(closestcar,carid);
		arr_Towing[playerid] = closestcar;
     	}
		}
		else SendClientMessage(playerid, COLOR_BLUE, "ERROR: You are not authorized to tow with this vehicle.");
	}
	else SendClientMessage(playerid, COLOR_BLUE, "ERROR: You need to be inside a vehicle to use this command!");
  	return 1;
}
CMD:untow(playerid, params[])
{
    if(!IsAMech(playerid)) return SCM(playerid, COLOR_GREY, "Anda Bukan Seorang Penderek Mobil");
  	{
   	if(IsTrailerAttachedToVehicle(GetPlayerVehicleID(playerid)))
   	{
   		SendClientMessage(playerid, COLOR_GRAD1,"Kamu Telah Selesai Menderek");
		arr_Towing[playerid] = INVALID_VEHICLE_ID;
		DetachTrailerFromVehicle(GetPlayerVehicleID(playerid));
   	}
   	else
   	{
       	SendClientMessage(playerid, COLOR_GRAD1,"Kamu Belum Menderek");
    }
  	}
	return 1;
}
CMD:spike(playerid, params[])
{
    if(!IsACop(playerid)) return 1;
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return Error(playerid, "You are not driving a vehicle.");
    new Float:X, Float:Y, Float:Z, Float:A, Float:Ang;

    GetPlayerPos(playerid, X, Y, Z);
    GetPlayerFacingAngle(playerid, A);

    new currentveh = GetPlayerVehicleID(playerid);
    new Float:vehx, Float:vehy, Float:vehz, Float:angle, Float:x2, Float:y2;

    GetVehiclePos(currentveh, vehx, vehy, vehz);
    GetVehicleDistanceFromPoint(currentveh, vehx, vehy, vehz);
    GetVehicleZAngle(currentveh, angle);
    GetVehicleZAngle(currentveh, Ang);
    GetXYBehindPoint(vehx, vehy, x2, y2, angle, 5);

    CreateStrip(x2,y2,vehz+0.3,Ang);

    Info(playerid, "You have drop spike!");
    return 1;
}
stock CreateStrip(Float:x,Float:y,Float:z,Float:Angle)
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(SpikeInfo[i][sCreated] == 0)
  	    {
            SpikeInfo[i][sCreated]=1;
            SpikeInfo[i][sX]=x;
            SpikeInfo[i][sY]=y;
            SpikeInfo[i][sZ]=z-0.7;
            SpikeInfo[i][sObject] = CreateDynamicObject(2899, x, y, z-0.9, 0, 0, Angle-90);
	        return 1;
  	    }
  	}
  	return 0;
}

DeleteAllspike()
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
    {
        if(SpikeInfo[i][sCreated] == 1)
        {
            SpikeInfo[i][sCreated]=0;
            SpikeInfo[i][sX]=0.0;
            SpikeInfo[i][sY]=0.0;
            SpikeInfo[i][sZ]=0.0;
            DestroyDynamicObject(SpikeInfo[i][sObject]);
        }
    }
    return 1;
}

stock DeleteClosestSpike(playerid)
{
    for(new i = 0; i < sizeof(SpikeInfo); i++)
  	{
  	    if(IsPlayerInRangeOfPoint(playerid, 2.0, SpikeInfo[i][sX], SpikeInfo[i][sY], SpikeInfo[i][sZ]))
        {
  	        if(SpikeInfo[i][sCreated] == 1)
            {
			    SCM(playerid, COLOR_RED, "Spike Info: {ffffff}berhasil menghapus perangkap spike");
                SpikeInfo[i][sCreated]=0;
                SpikeInfo[i][sX]=0.0;
                SpikeInfo[i][sY]=0.0;
                SpikeInfo[i][sZ]=0.0;
                DestroyDynamicObject(SpikeInfo[i][sObject]);
                return 1;
  	        }
  	    }
  	}
    return 0;
}
encode_tires(tires1, tires2, tires3, tires4) {

	return tires1 | (tires2 << 1) | (tires3 << 2) | (tires4 << 3);
}
CMD:dspike(playerid, params[])
{
	if(!IsACop(playerid)) return SCM(playerid, COLOR_RED, "Spike Info: {ffffff} Anda bukan anggota lspd");
	DeleteClosestSpike(playerid);
	return 1;
}
CMD:destroyallspike(playerid, params[])
{
    if(!IsACop(playerid)) return 1;
    DeleteAllspike();
    Info(playerid, "You have destroy all road spike!");
    return 1;
}
