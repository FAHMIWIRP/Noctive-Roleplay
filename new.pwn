{
    if(!GetOwnedWorkshop(playerid)) return Error(playerid, "You don't have any Workshop.");
    new wid, _tmpstring[128], count = GetOwnedWorkshop(playerid), CMDSString[512];
    CMDSString = "";
    new lock[128];
    strcat(CMDSString,"No\tName(Status)\tLocation\n",sizeof(CMDSString));
    Loopp(itt, (count + 1), 1)
    {
        wid = ReturnPlayerWorkshopID(playerid, itt);
        if(wsData[wid][wStatus] == 1)
        {
            lock = "{7FFF00}Open{ffffff}";
        }
        else
        {
            lock = "{FF0000}Closed{ffffff}";
        }
        if(itt == count)
        {
            format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        }
        else format(_tmpstring, sizeof(_tmpstring), "%d\t%s{ffffff}(%s)\t%s{ffffff}\n", itt, wsData[wid][wName], lock, GetLocation(wsData[wid][wX], wsData[wid][wY], wsData[wid][wZ]));
        strcat(CMDSString, _tmpstring);
    }
    ShowPlayerDialog(playerid, DIALOG_MY_WS, DIALOG_STYLE_TABLIST_HEADERS, "My Workshop", CMDSString, "Track", "Cancel");
    return 1;
}

CMD:cgarkot(playerid, params[])
{
	if(admin_level[playerid] < 12) return 1;
	new Float: Gpos[4], string[254];
	new id = ValidGarkot();
	GetPlayerPos(playerid, Gpos[0], Gpos[1], Gpos[2]);
	GetPlayerFacingAngle(playerid, Gpos[3]);
	IdGarkot[id] = 1;
	GarkotInfo[id][GposX] = Gpos[0];
	GarkotInfo[id][GposY] = Gpos[1];
	GarkotInfo[id][GposZ] = Gpos[2];
	GarkotInfo[id][GposA] = Gpos[3];
	format(string, sizeof(string), "%d\n{FF7F00}[Garkot]\n{FFFFFF}Tekan Y", id);
	GarkotInfo[id][GLabel] = CreateDynamic3DTextLabel(string, -1, GarkotInfo[id][GposX], GarkotInfo[id][GposY], GarkotInfo[id][GposZ], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	GarkotInfo[id][GPickup] = CreateDynamicPickup(19134, 23, GarkotInfo[id][GposX], GarkotInfo[id][GposY], GarkotInfo[id][GposZ], 0, 0);
	SetPlayerPos(playerid, Gpos[0], Gpos[1], Gpos[2]+1);
	SaveGarkot();
	return 1;
}
CMD:eat(playerid, params[])
{
    new i = player_use_bizbar[playerid];
    new inter = GetPlayerInterior(playerid);

	if(PlayerToPoint(2, playerid,BizzInfo[i][bBarX], BizzInfo[i][bBarY], BizzInfo[i][bBarZ]) && BizzInfo[i][bType] == 2 && BizzInfo[i][bVirtualWorld] == GetPlayerVirtualWorld(playerid))
	{
		if(BizzInfo[i][bLocked] == 1) return Send(playerid,COLOR_GREY, "Restoran ditutup oleh pemilik!");

		if(inter == 10 || inter == 4)
		{
			format
			(
				String, 322,
				"{ffffff}0. Air Putih\t{32CD32}%d$\n\
				{ffffff}1. Es Teh\t{32CD32}%d$\n\
				{ffffff}2. Es Susu Perawan\t{32CD32}%d$\n\
				{ffffff}3. Bakso\t{32CD32}%d$\n\
				{ffffff}4. Soto Ayam\t{32CD32}%d$\n\
				{ffffff}5. Nasi Goreng\t{32CD32}%d$",

				BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,
				BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6);

			return SPD(playerid, 71, DIALOG_STYLE_LIST, "Menu Warung", String, "Pilih", "Keluar");
		}
		if(inter == 5 || inter == 9 || inter == 17 || inter == 1)
		{
			format
			(
				String, 322,
				"{ffffff}0. Air Putih\t{32CD32}%d$\n\
				{ffffff}1. Es Teh\t{32CD32}%d$\n\
				{ffffff}2. Es Susu Perawan\t{32CD32}%d$\n\
				{ffffff}3. Bakso\t{32CD32}%d$\n\
				{ffffff}4. Soto Ayam\t{32CD32}%d$\n\
				{ffffff}5. Nasi Goreng\t{32CD32}%d$",

				BizzInfo[i][bPrice],BizzInfo[i][bPrice]*2,BizzInfo[i][bPrice]*3,
				BizzInfo[i][bPrice]*4,BizzInfo[i][bPrice]*5,BizzInfo[i][bPrice]*6
			);

			return SPD(playerid, 71, DIALOG_STYLE_LIST, "Menu Makanan", String, "beli", "Keluar");
		}
	}
	return true;
}
CMD:setviptutup(playerid, params[])
{
    if(admin_level[playerid] < 12) return 1;
    if(sscanf(params, "u",params[0])) return Send(playerid, -1,"Masuk: /givevip [playerid]");
	SPD(playerid, 554, DIALOG_STYLE_LIST, "Menu GiveVIP", ""W"1. VIP Bronze\n2. VIP Silver\n3. VIP Gold", "Pilih", "Tutup");
	return 1;
}
CMD:vchat(playerid, params[]) {
    // Cek apakah player memiliki salah satu dari status VIP
    if(PlayerInfo[playerid][pVbasic] == 0 && PlayerInfo[playerid][pVsilver] == 0 && PlayerInfo[playerid][pVgold] == 0 && PlayerInfo[playerid][pVpro] == 0) {
        return SendClientMessage(playerid, -1, "Kamu bukan anggota VIP!");
    }

    // Cek apakah VIP-nya sudah expired (habis waktu) dan bukan lifetime (0)
    if(PlayerInfo[playerid][pPanvipExpire] != 0 && gettime() > PlayerInfo[playerid][pPanvipExpire]) {
        // Cabut semua status VIP
        PlayerInfo[playerid][pVbasic] = 0;
        PlayerInfo[playerid][pVsilver] = 0;
        PlayerInfo[playerid][pVgold] = 0;
        PlayerInfo[playerid][pVpro] = 0;
        PlayerInfo[playerid][pDonatur] = 0; // Cabut donatur

        // Simpan perubahan ke database secara permanen karena VIP dicabut
        OnPlayerUpdateAccountsPer(playerid, "pVbasic", 0);
        OnPlayerUpdateAccountsPer(playerid, "pVsilver", 0);
        OnPlayerUpdateAccountsPer(playerid, "pVgold", 0);
        OnPlayerUpdateAccountsPer(playerid, "pVpro", 0);
        OnPlayerUpdateAccountsPer(playerid, "pDonatur", 0);

        return SendClientMessage(playerid, -1, "Masa aktif VIP kamu telah habis!");
    }

    if(isnull(params)) {
        return SendClientMessage(playerid, -1, "GUNA: /vchat [teks chat]");
    }

    new nama[MAX_PLAYER_NAME], str[256], prefix[64], nameColor[16];
    GetPlayerName(playerid, nama, sizeof(nama));

    // Cek apakah dia Lifetime (bernilai 1 jika lifetime, 0 jika bulanan)
    new isLifetime = (PlayerInfo[playerid][pPanvipExpire] == 0) ? 1 : 0;

    // Tentukan Prefix dan Warna Nama berdasarkan Variabel VIP yang aktif
    if(PlayerInfo[playerid][pVpro] == 1) { // Profesional
        if(isLifetime) prefix = "{FF85F3}[VIP PROFESIONAL LIFETIME]";
        else prefix = "{FF85F3}[VIP PROFESIONAL]";
        nameColor = "{00FFB7}";
    }
    else if(PlayerInfo[playerid][pVgold] == 1) { // Gold
        if(isLifetime) prefix = "{FFFF00}[VIP GOLD LIFETIME]";
        else prefix = "{FFFF00}[VIP GOLD]";
        nameColor = "{0088FF}";
    }
    else if(PlayerInfo[playerid][pVsilver] == 1) { // Silver
        if(isLifetime) prefix = "{BF00FF}[VIP SILVER LIFETIME]";
        else prefix = "{BF00FF}[VIP SILVER]";
        nameColor = "{4D91FF}";
    }
    else if(PlayerInfo[playerid][pVbasic] == 1) { // Basic
        if(isLifetime) prefix = "{00C4FF}[VIP BASIC LIFETIME]";
        else prefix = "{00C4FF}[VIP BASIC]";
        nameColor = "{FFFF00}";
    }

    // Format Pesan Akhir
    format(str, sizeof(str), "%s%s%s :{FFFFFF} %s", prefix, nameColor, nama, params);

    // Kirim pesan hanya ke orang yang memiliki VIP
    for(new i = 0, j = GetPlayerPoolSize(); i <= j; i++) {
        if(IsPlayerConnected(i)) {
            // Cek jika player 'i' memiliki minimal satu status VIP
            if(PlayerInfo[i][pVbasic] > 0 || PlayerInfo[i][pVsilver] > 0 || PlayerInfo[i][pVgold] > 0 || PlayerInfo[i][pVpro] > 0) {
                SendClientMessage(i, -1, str);
            }
        }
    }

    return 1;
}

CMD:setvip(playerid, params[]) {
    // Tambahkan pengecekan Admin di sini
    if(admin_level[playerid] < 12) return 1;
    new targetid, type_str[16], duration_str[16];

    // Membaca parameter command
    if(sscanf(params, "uss", targetid, type_str, duration_str)) {
        return SendClientMessage(playerid, -1, "GUNAKAN: /setvip [playerid] [basic/silver/gold/profesional] [lifetime/1bulan]");
    }

    if(!IsPlayerConnected(targetid)) {
        return SendClientMessage(playerid, -1, "Player tersebut tidak online.");
    }

    new expireTime = 0;
    new vipName[24];

    // RESET semua status VIP player terlebih dahulu agar tidak dobel/tumpang tindih
    PlayerInfo[targetid][pVbasic] = 0;
    PlayerInfo[targetid][pVsilver] = 0;
    PlayerInfo[targetid][pVgold] = 0;
    PlayerInfo[targetid][pVpro] = 0;

    // Pengecekan Tipe VIP sekaligus mengaktifkan variabel yang sesuai
    if(!strcmp(type_str, "basic", true)) { PlayerInfo[targetid][pVbasic] = 1; vipName = "Basic"; }
    else if(!strcmp(type_str, "silver", true)) { PlayerInfo[targetid][pVsilver] = 1; vipName = "Silver"; }
    else if(!strcmp(type_str, "gold", true)) { PlayerInfo[targetid][pVgold] = 1; vipName = "Gold"; }
    else if(!strcmp(type_str, "profesional", true)) { PlayerInfo[targetid][pVpro] = 1; vipName = "Profesional"; }
    else return SendClientMessage(playerid, -1, "Tipe VIP tidak valid! (basic/silver/gold/profesional)");

    // Pengecekan Durasi Waktu
    if(!strcmp(duration_str, "lifetime", true)) {
        expireTime = 0; // 0 Kita jadikan patokan untuk Lifetime
    }
    else if(!strcmp(duration_str, "1bulan", true)) {
        // 1 Bulan = 30 Hari = 2592000 Detik
        expireTime = gettime() + 2592000;
    }
    else return SendClientMessage(playerid, -1, "Durasi tidak valid! (lifetime/1bulan)");

    // Set Expire Data Player
    PlayerInfo[targetid][pPanvipExpire] = expireTime;

    // Jika Gold atau Profesional, dapat pDonatur
    if(PlayerInfo[targetid][pVgold] == 1 || PlayerInfo[targetid][pVpro] == 1) {
        PlayerInfo[targetid][pDonatur] = 1;
    } else {
        // Reset pDonatur jika di-set ke Basic/Silver
        PlayerInfo[targetid][pDonatur] = 0;
    }

    // SIMPAN KE DATABASE SECARA PERMANEN SEMUA VARIABEL
    OnPlayerUpdateAccountsPer(targetid, "pVbasic", PlayerInfo[targetid][pVbasic]);
    OnPlayerUpdateAccountsPer(targetid, "pVsilver", PlayerInfo[targetid][pVsilver]);
    OnPlayerUpdateAccountsPer(targetid, "pVgold", PlayerInfo[targetid][pVgold]);
    OnPlayerUpdateAccountsPer(targetid, "pVpro", PlayerInfo[targetid][pVpro]);
    OnPlayerUpdateAccountsPer(targetid, "pPanvipExpire", PlayerInfo[targetid][pPanvipExpire]);
    OnPlayerUpdateAccountsPer(targetid, "pDonatur", PlayerInfo[targetid][pDonatur]);

    // Pesan Sukses
    new msg[128];
    format(msg, sizeof(msg), "SERVER: Anda telah memberikan VIP %s (%s) kepada ID: %d.", vipName, duration_str, targetid);
    SendClientMessage(playerid, -1, msg);

    format(msg, sizeof(msg), "SERVER: Admin telah meng-set VIP anda ke %s dengan durasi %s.", vipName, duration_str);
    SendClientMessage(targetid, 0x00FF00FF, msg);

    return 1;
}
CMD:tukaruang(playerid, params[])
{
    // Cek lokasi
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 490.906829, -2642.807373, 9.536420))
        return ShowPanjulNotif(playerid, "Tidak Berada Di Lokasi");

    // Cek uang cash
    if(PlayerInfo[playerid][pCash] < 5000)
        return ShowPanjulNotif(playerid, "Uang Tidak Cukup");

    // Kurangi Cash, Tambah Redmoney
    PlayerInfo[playerid][pCash] -= 5000;
    PlayerInfo[playerid][pRedmoney] += 2000;
    
    // Mengurangi visual uang di HUD kanan atas layar player
    GivePlayerMoney(playerid, -5000); 

    // Simpan ke database/file
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda menukar $5.000 uang tunai menjadi 2.000 Redmoney.");
    ShowPanjulNotif(playerid, "Berhasil Mencuci Uang");
    if(IsPlayerAndroid(playerid))
	{
		PlayerPlaySound(playerid, 1057, 0.0, 0.0, 0.0);
	}
	else
	{
		PlayerPlaySound(playerid, 5202, 0.0, 0.0, 0.0);
	}
    
    return 1;
}

CMD:cuciuang(playerid, params[])
{
    // Cek lokasi
    if(!IsPlayerInRangeOfPoint(playerid, 10.0, 499.729705, -2640.717041, 9.416419))
        return ShowPanjulNotif(playerid, "Tidak Berada Di Lokasi");

    // Cek Redmoney
    if(PlayerInfo[playerid][pRedmoney] < 5000)
        return ShowPanjulNotif(playerid, "Redmoney Tidak Cukup");

    // Tambah Cash, Kurangi Redmoney
    PlayerInfo[playerid][pCash] += 2590;
    PlayerInfo[playerid][pRedmoney] -= 5000;

    // Menambahkan visual uang di HUD kanan atas layar player (Sebelumnya terlewat di script asli)
    GivePlayerMoney(playerid, 2590);

    // Simpan ke database/file
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]);
    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    
    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Anda mencuci 5.000 Redmoney menjadi $2.590 uang bersih.");
    ShowPanjulNotif(playerid, "Berhasil Mencuci Uang");
    
    return 1;
}
public CheckDeerDistance()
{
    for(new i = 0; i < MAX_DEER; i++)
    {
        if(DeerData[i][deerActive] && DeerData[i][deerHits] < 1)
        {
            for(new p = 0; p < MAX_PLAYERS; p++)
            {
                if(IsPlayerConnected(p))
                {
                    // Jika player mendekat di bawah 40 meter, rusa menghilang (kabur)
                    if(IsPlayerInRangeOfPoint(p, 40.0, DeerData[i][deerX], DeerData[i][deerY], DeerData[i][deerZ]))
                    {
                        if(IsValidDynamicObject(DeerData[i][deerObjID])) // Ganti deerid jadi i
                        {
                            DestroyObject(DeerData[i][deerObjID]); // Pake ini kalau CreateDynamicObject
                        }

                        DeerData[i][deerActive] = false;
                        DeerData[i][deerObjID] = INVALID_OBJECT_ID;

                        // Respawn rusa lagi setelah 1 jam
                        SetTimerEx("RespawnDeer", 3600000, false, "d", i);
                        break;
                    }
                }
            }
        }
    }
    return 1;
}

forward OnCuttingDeerUpdate(playerid, deerid);
		public OnCuttingDeerUpdate(playerid, deerid)
		{
		    if(!IsPlayerConnected(playerid)) return 1;
		
		    PlayerProgressValue[playerid] += 1;
		
		    if(PlayerProgressValue[playerid] >= 100)
		    {
		        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
		        KillTimer(PlayerProgressBarTimer[playerid]);
		        PlayerProgressBarTimer[playerid] = -1;
		        
		        // Jeda halus 1 detik pas bar penuh hijau, baru panggil fungsi hadiah asli servermu
		        // Menggunakan "ii" untuk meneruskan playerid dan deerid (ID rusa)
		        SetTimerEx("OnFinishCutting", 1000, false, "ii", playerid, deerid);
		    }
		    else
		    {
		        // Menjaga animasi memotong tetap berjalan looping selama loading bar belum penuh
		        ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 0, 0, 1, 0); 
		        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
		    }
		    return 1;
		}

public OnFinishCutting(playerid, deerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    ClearAnimations(playerid);
    TogglePlayerControllable(playerid, 1); 
    SedangKerja[playerid] = false;
    HideBarAfterDone(playerid); // MENAPUS TEXTDRAW PROGRESS BAR SECARA BERSIH DARI LAYAR

    PlayerInfo[playerid][pCash] += 300;
    PlayerInfo[playerid][pSatiety] -= 3.0;
    PlayerInfo[playerid][pThirst] -= 3.0;
    PlayerInfo[playerid][pStress] += 2.0;
    PlayerInfo[playerid][pDagingrusa] += 1;
    
    SedangKerja[playerid] = false; // Pemain selesai bekerja
    DeerData[deerid][deerBeingCut] = false; // Buka kembali kunci rusa

    // Menambah visual uang di HUD kanan atas layar player secara real-time
    GivePlayerMoney(playerid, 300);

    // Update ke database dengan tag yang benar
    OnPlayerUpdateAccountsPer(playerid, "pSatiety", _:PlayerInfo[playerid][pSatiety]);
    OnPlayerUpdateAccountsPer(playerid, "pCash", PlayerInfo[playerid][pCash]); // Tag _: dihapus karena pCash adalah integer
    OnPlayerUpdateAccountsPer(playerid, "pStress", _:PlayerInfo[playerid][pStress]);
    OnPlayerUpdateAccountsPer(playerid, "pThirst", _:PlayerInfo[playerid][pThirst]);
    OnPlayerUpdateAccountsPer(playerid, "pDagingrusa", PlayerInfo[playerid][pDagingrusa]);

    if(DeerData[deerid][deerActive])
    {
        DestroyObject(DeerData[deerid][deerObjID]);
        Delete3DTextLabel(DeerData[deerid][deerLabel]);
        DeerData[deerid][deerActive] = false;
        
        // Munculkan rusa baru setelah 30 menit
        SetTimerEx("RespawnDeer", 1800000, false, "d", deerid);
    }

    SendClientMessage(playerid, 0x00FF00FF, "Berhasil mengambil daging rusa!");
    ShowPanjulNotif(playerid, "Berhasil Ambil Daging");
    return 1;
}

public RespawnDeer(deerid)
{
    SpawnSingleDeer(deerid);
    return 1;
}
CMD:listprice(playerid, params[])
{
    // Cek posisi di RS
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, 1345.861694, 1533.977294, 23223.095703))
        return SendClientMessage(playerid, COLOR_RED, "{FF0000}[ERROR]: {FFFFFF}Kamu harus berada di Rumah Sakit untuk melihat daftar harga!");

    new line[512];
    line[0] = '\0';

    format(line, sizeof(line), "{ffffff}_________[{FFB6C1}Price List Hospital Noctive{ffffff}]_________\n\n");

    strcat(line, "{FFB6C1}Layanan & Harga:{ffffff}\n");
    strcat(line, "{ffffff}- Treatment: {00FF00}$1,000{ffffff}\n");
    strcat(line, "{ffffff}- Heal: {00FF00}$500{ffffff}\n");
    strcat(line, "{ffffff}- Revive: {00FF00}$1,000{ffffff}\n");
    strcat(line, "{ffffff}- Bandage: {00FF00}$300{ffffff}\n");
    strcat(line, "{ffffff}- Medicine: {00FF00}$600{ffffff}\n\n");
    strcat(line, "{CCCCCC}Gunakan layanan ini di Hospital.");

    ShowPlayerDialog(playerid, 9989, DIALOG_STYLE_MSGBOX, "{ffffff}Noctive Roleplay | Hospital Price", line, "Tutup", "");
    return 1;
}
CMD:jualdagingrusa(playerid, params[])
{
    if(!IsPlayerInRangeOfPoint(playerid, 3.5, 2734.967041, -2550.335205, 13.648684))
        return SendClientMessage(playerid, COLOR_RED, "Anda tidak berada di tempat pengepul daging rusa!");

    new jumlahDaging = PlayerInfo[playerid][pDagingrusa];
    if(jumlahDaging <= 0) return SendClientMessage(playerid, COLOR_RED, "Anda tidak memiliki daging rusa.");

    new totalHarga = jumlahDaging * 2000;
    PlayerInfo[playerid][pRedmoney] += totalHarga;
    PlayerInfo[playerid][pDagingrusa] = 0;

    OnPlayerUpdateAccountsPer(playerid, "pRedmoney", PlayerInfo[playerid][pRedmoney]);
    OnPlayerUpdateAccountsPer(playerid, "pDagingrusa", PlayerInfo[playerid][pDagingrusa]);

    new str[128];
    format(str, sizeof(str), "Berhasil menjual %d daging rusa seharga $%d.", jumlahDaging, totalHarga);
    SendClientMessage(playerid, COLOR_YELLOW, str);
    return 1;
}
CMD:getjobsweeper(playerid, params[])
{
    if(IsPlayerInRangeOfPoint(playerid, 5.0, jobSweeperPos[0], jobSweeperPos[1], jobSweeperPos[2]))
    {
        new vehicleid = CreateVehicle(574, jobSweeperPos[0], jobSweeperPos[1], jobSweeperPos[2], jobSweeperPos[3], -1, -1, -1);
        if(vehicleid != INVALID_VEHICLE_ID)
        {
            new u_car = GetPlayerFreeCarSlot(playerid); 
            if(u_car == -1) 
             { 
             return SendClientMessage(playerid, COLOR_RED, "ERROR: {FFFFFF}Penyimpanan Kendaraan Anda Sudah Penuh Ands Tidak Bisa Mengikuti Job Ini"); 
            } 
            CarInfo[playerid][cFuel][u_car] = 100.0;
            CarInfo[playerid][cCost][u_car] = 1000;
            CarInfo[playerid][cHeal][u_car] = 1000.0;
            PutPlayerInVehicle(playerid, vehicleid, 0);
            SetPlayerCheckpoint(playerid, checkpointPos[0], checkpointPos[1], checkpointPos[2], 3.0);
            SendClientMessage(playerid, COLOR_WHITE, "Ikuti Checkpoint Itu");
        }
        else
        {
            SendClientMessage(playerid, COLOR_RED, "Gagal membuat kendaraan");
        }
    }
    else
    {
        SendClientMessage(playerid, COLOR_RED, "Anda tidak berada di lokasi yang tepat");
    }
    return 1;
}
