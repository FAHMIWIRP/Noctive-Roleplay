//ambiltv
CMD:ambiltv(playerid, params[]) {
    if(GetPVarInt(playerid, "IsRobbingDyn")) return SendClientMessage(playerid, -1, "Kamu sedang melakukan tindakan kriminal.");
    if(pData[playerid][pTelevisi] == 1) return SendClientMessage(playerid, -1, "Tanganmu sudah penuh membawa TV!");

    new currentVW = GetPlayerVirtualWorld(playerid);
    if(currentVW == 0) return SendClientMessage(playerid, -1, "Kamu harus berada di dalam interior rumah!");

    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));

    for(new i = 0; i < TotalDynHouse; i++) {
        if(DynHouseData[i][dhOwned] && currentVW == DynHouseData[i][dhID]) {
            // --- VALIDASI TAMBAHAN ---
            if(DynHouseData[i][dhLocked]) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Pintu masih terkunci! Bobol dulu.");
            if(!strcmp(DynHouseData[i][dhOwner], name, true)) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu tidak bisa mencuri di rumah sendiri!");
            // -------------------------

            if(DynHouseData[i][dhType] == 1) {
                if(!IsPlayerInRangeOfPoint(playerid, 2.0, 2191.320068, -1201.322509, 1049.023437)) return SendClientMessage(playerid, -1, "Kamu tidak berada dekat lokasi TV!");
            }
            else if(DynHouseData[i][dhType] == 2) {
                if(!IsPlayerInRangeOfPoint(playerid, 2.0, 485.304382, 1399.657226, 1080.257812)) return SendClientMessage(playerid, -1, "Kamu tidak berada dekat lokasi TV!");
            }
            else return SendClientMessage(playerid, -1, "Rumah tipe Large tidak memiliki TV untuk dicuri.");

// 4. Mulai proses kerja
    SedangKerja[playerid] = true;
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENGAMBIL TV..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("OnMalingTv", 300, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Mengambil Tv");
            return 1;
        }
    }
    return 1;
}
forward OnMalingTv(playerid);
public OnMalingTv(playerid)
{
    if(!IsPlayerConnected(playerid)) return 1;

    PlayerProgressValue[playerid] += 1;

    if(PlayerProgressValue[playerid] >= 100)
    {
        UpdatePlayerProgressBar(playerid, 100, "Selesai!");
        KillTimer(PlayerProgressBarTimer[playerid]);
        PlayerProgressBarTimer[playerid] = -1;

        SetTimerEx("selesaimalingtv", 1000, false, "i", playerid);
    }
    else
    {
        ApplyAnimation(playerid, "BD_FIRE", "wash_up", 4.0, 1, 0, 0, 0, 0, 1);
        UpdatePlayerProgressBar(playerid, PlayerProgressValue[playerid], PlayerActionText[playerid]);
    }
    return 1;
}
public selesaimalingtv(playerid, type, houseid) {
    if(!IsPlayerConnected(playerid)) return 1;

    SedangKerja[playerid] = false;
    TogglePlayerControllable(playerid, 1);
    ClearAnimations(playerid);
    RemovePlayerAttachedObject(playerid, 8);
    HideBarAfterDone(playerid);
    DeletePVar(playerid, "IsRobbingDyn");
    TogglePlayerControllable(playerid, 1); // <--- BUKA KUNCI GERAKAN
    
    PlayerInfo[playerid][pTelevisi] += 1;
    OnPlayerUpdateAccountsPer(playerid, "pTelevisi", PlayerInfo[playerid][pTelevisi]);
   SetPlayerAttachedObject(playerid, 9, 1518, 1,  0.212000, 0.453999, -0.052000,  -170.999923, 81.999969, -11.500000,  0.687999, 0.830000, 0.731999);
                    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1);
        SendClientMessage(playerid, -1, "{0033FF}Berhasil: {ffffff}Kamu berhasil mencuri TV! Bawa keluar rumah.");
        
    return 1;
}
//bobollemari
CMD:geledahlemari(playerid, params[]) {
    if(GetPVarInt(playerid, "IsRobbingDyn")) return SendClientMessage(playerid, -1, "Kamu sedang melakukan tindakan kriminal.");

    new currentVW = GetPlayerVirtualWorld(playerid);
    if(currentVW == 0) return SendClientMessage(playerid, -1, "Kamu harus berada di dalam interior rumah!");

    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, sizeof(name));

    for(new i = 0; i < TotalDynHouse; i++) {
        if(DynHouseData[i][dhOwned] && currentVW == DynHouseData[i][dhID]) {
            // --- VALIDASI TAMBAHAN ---
            if(DynHouseData[i][dhLocked]) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Pintu masih terkunci! Bobol dulu.");
            if(!strcmp(DynHouseData[i][dhOwner], name, true)) return SendClientMessage(playerid, -1, "{ff0000}ERROR: {ffffff}Kamu tidak bisa mencuri di rumah sendiri!");
            // -------------------------

            if(DynHouseData[i][dhType] != 3) return SendClientMessage(playerid, -1, "Hanya rumah tipe Large yang memiliki lemari.");
            if(!IsPlayerInRangeOfPoint(playerid, 2.0, 141.171966, 1381.600341, 1083.867187)) return SendClientMessage(playerid, -1, "Kamu tidak berada di dekat lemari emas!");

            // 4. Mulai proses kerja
    SedangKerja[playerid] = true;
     SetPVarInt(playerid, "IsRobbingDyn", 1);
    TogglePlayerControllable(playerid, 0);
    ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 1, 1, 1, 1, 1, 1);

    PlayerProgressValue[playerid] = 0;
    format(PlayerActionText[playerid], 32, "MENGGELEDAH LEMARI..");
    UpdatePlayerProgressBar(playerid, 0, PlayerActionText[playerid]);

    if(PlayerProgressBarTimer[playerid]!= -1) KillTimer(PlayerProgressBarTimer[playerid]);
    PlayerProgressBarTimer[playerid] = SetTimerEx("geledahlemari", 300, true, "i", playerid);

    SendClientMessage(playerid, -1, "{5996FF}[ INFO ]{FFFFFF} Kamu Sedang Menggeledah Lemari");
            return 1;
        }
    }
    return 1;
}
