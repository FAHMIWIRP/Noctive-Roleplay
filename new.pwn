    case 9784: // Action Senjata (Ambil / Taruh)
    {
        if(!response) return SPD(playerid, 9773, DIALOG_STYLE_LIST, "Isi Bagasi", "", "", ""); // Kembali ke trunk
        new car_id = GetPlayerUseListitem(playerid);
        new slot = SelectedWeaponSlot[playerid];

        if(listitem == 0) // AMBIL SENJATA
        {
            new gun = (slot == 1) ? CarInfo[playerid][cGun1][car_id] : (slot == 2) ? CarInfo[playerid][cGun2][car_id] : CarInfo[playerid][cGun3][car_id];
            new ammo = (slot == 1) ? CarInfo[playerid][cAmmo1][car_id] : (slot == 2) ? CarInfo[playerid][cAmmo2][car_id] : CarInfo[playerid][cAmmo3][car_id];

            if(gun == 0) return Error(playerid, "Slot ini kosong!");

            GivePlayerWeapon(playerid, gun, ammo);

            if(slot == 1) { CarInfo[playerid][cGun1][car_id] = 0; CarInfo[playerid][cAmmo1][car_id] = 0; }
            else if(slot == 2) { CarInfo[playerid][cGun2][car_id] = 0; CarInfo[playerid][cAmmo2][car_id] = 0; }
            else if(slot == 3) { CarInfo[playerid][cGun3][car_id] = 0; CarInfo[playerid][cAmmo3][car_id] = 0; }

            format(String, sizeof(String), "%s mengambil senjata dari bagasi slot %d", Name(playerid), slot);
            ProxDetector(20.0, playerid, String, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);
            SaveCars(playerid);
        }
        else if(listitem == 1) // TARUH SENJATA
        {
            new gun = (slot == 1) ? CarInfo[playerid][cGun1][car_id] : (slot == 2) ? CarInfo[playerid][cGun2][car_id] : CarInfo[playerid][cGun3][car_id];
            if(gun != 0) return Error(playerid, "Slot senjata ini sudah terisi!");

            new gunID = GetPlayerWeapon(playerid);
            new gunAmmo = GetPlayerAmmo(playerid);
            if(gunID == 0) return Error(playerid, "Anda tidak sedang memegang senjata!");

            if(slot == 1) { CarInfo[playerid][cGun1][car_id] = gunID; CarInfo[playerid][cAmmo1][car_id] = gunAmmo; }
            else if(slot == 2) { CarInfo[playerid][cGun2][car_id] = gunID; CarInfo[playerid][cAmmo2][car_id] = gunAmmo; }
            else if(slot == 3) { CarInfo[playerid][cGun3][car_id] = gunID; CarInfo[playerid][cAmmo3][car_id] = gunAmmo; }

            RemovePlayerWeapon(playerid, gunID);
            format(String, sizeof(String), "%s menyimpan senjata ke bagasi slot %d", Name(playerid), slot);
            ProxDetector(20.0, playerid, String, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE, COLOR_PURPLE);
            SaveCars(playerid);
        }
    }

